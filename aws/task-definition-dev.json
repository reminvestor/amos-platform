        },
        {
          "name": "AWS_REGION",
          "value": "us-east-1"
        },
        {
          "name": "S3_BUCKET",
          "value": "agent-marketing-storage-637423327454"
        },
        {
          "name": "AI_PROVIDER",
          "value": "bedrock"
        },
        {
          "name": "MAILER_SENDER",
          "value": "noreply@nuvola-networks.com"
        }
