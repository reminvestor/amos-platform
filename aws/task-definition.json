{
  "family": "agent-marketing",
  "taskRoleArn": "arn:aws:iam::637423327454:role/agent-marketing-ecs-task-role",
  "executionRoleArn": "arn:aws:iam::637423327454:role/agent-marketing-ecs-execution-role",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "2048",
  "memory": "4096",
  "containerDefinitions": [
    {
      "name": "agent-marketing",
      "image": "637423327454.dkr.ecr.us-east-1.amazonaws.com/agent-marketing:latest",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 3000,
          "protocol": "tcp"
        }
      ],
      "environment": [
        {
          "name": "RAILS_ENV",
          "value": "production"
        },
        {
          "name": "RAILS_LOG_TO_STDOUT",
          "value": "true"
        },
        {
          "name": "PORT",
          "value": "3000"
        },
        {
          "name": "AWS_REGION",
          "value": "us-east-1"
        },
        {
          "name": "S3_BUCKET",
          "value": "agent-marketing-storage-637423327454"
        },
        {
          "name": "RAILS_HOSTS",
          "value": ".amazonaws.com,.elb.amazonaws.com,cruxmarketing.ai"
        },
        {
          "name": "AI_PROVIDER",
          "value": "bedrock"
        },
        {
          "name": "MAILER_SENDER",
          "value": "noreply@nuvola-networks.com"
        }
      ],
      "secrets": [
        {
          "name": "DATABASE_URL",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:637423327454:secret:agent-marketing-database-url-g77ohU"
        },
        {
          "name": "RAILS_MASTER_KEY",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:637423327454:secret:agent-marketing-rails-master-key-2fQEHY"
        },
        {
          "name": "REDIS_URL",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:637423327454:secret:agent-marketing-redis-url-9HkkES"
        },
        {
          "name": "MAILGUN_API_KEY",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:637423327454:secret:agent-marketing-mailgun-api-key-8wkcDx"
        },
        {
          "name": "MAILGUN_DOMAIN",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:637423327454:secret:agent-marketing-mailgun-domain-nBv15L"
        },
        {
          "name": "PINECONE_API_KEY",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:637423327454:secret:agent-marketing-pinecone-api-key-XGOtSa"
        },
        {
          "name": "PINECONE_ENVIRONMENT",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:637423327454:secret:agent-marketing-pinecone-environment-FxYF7A"
        },
        {
          "name": "PINECONE_INDEX_NAME",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:637423327454:secret:agent-marketing-pinecone-index-name-0xhMHd"
        },
        {
          "name": "OPENAI_API_KEY",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:637423327454:secret:agent-marketing-openai-api-key-HgvFIx"
        },
        {
          "name": "ANTHROPIC_API_KEY",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:637423327454:secret:agent-marketing-anthropic-api-key-4ItdAq"
        },
        {
          "name": "DEEPGRAM_API_KEY",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:637423327454:secret:agent-marketing-deepgram-api-key-ccHoyY"
        },
        {
          "name": "DEEPGRAM_WEBHOOK_SECRET",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:637423327454:secret:agent-marketing-deepgram-webhook-secret-r8dFAM"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/agent-marketing",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "ecs"
        }
      },
      "linuxParameters": {
        "initProcessEnabled": true
      }
    },
    {
      "name": "solid-queue-worker",
      "image": "637423327454.dkr.ecr.us-east-1.amazonaws.com/agent-marketing:latest",
      "essential": true,
      "command": ["bundle", "exec", "rails", "solid_queue:start"],
      "environment": [
        {
          "name": "RAILS_ENV",
          "value": "production"
        },
        {
          "name": "RAILS_LOG_TO_STDOUT",
          "value": "true"
        },
        {
          "name": "AWS_REGION",
          "value": "us-east-1"
        },
        {
          "name": "S3_BUCKET",
          "value": "agent-marketing-storage-637423327454"
        },
        {
          "name": "AI_PROVIDER",
          "value": "bedrock"
        },
        {
          "name": "MAILER_SENDER",
          "value": "noreply@nuvola-networks.com"
        }
      ],
      "secrets": [
        {
          "name": "DATABASE_URL",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:637423327454:secret:agent-marketing-database-url-g77ohU"
