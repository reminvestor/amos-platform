# Agent Lightning Service Configuration

# Database
DATABASE_URL=postgresql://user:password@db:5432/agent_marketing_production

# Rails API
RAILS_API_URL=http://web:3000
RAILS_API_KEY=your_api_key_here

# Agent Lightning Configuration
AGENT_LIGHTNING_RUNNERS=4
AGENT_LIGHTNING_STRATEGY=cs

# Logging
LOG_LEVEL=INFO
DEBUG=false

# Service Ports (usually don't need to change)
API_PORT=4747
STORE_PORT=4748
