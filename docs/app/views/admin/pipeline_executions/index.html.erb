<div class="container-fluid py-4">
  <!-- Dashboard Header -->
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h2">
      <i class="fas fa-robot"></i>
      AI Development Pipeline
    </h1>
    <div>
      <%= link_to admin_pipeline_connections_path, class: "btn btn-outline-primary" do %>
        <i class="fas fa-plug"></i>
        Connections
      <% end %>
    </div>
  </div>

  <!-- Stats Dashboard -->
  <div class="row g-3 mb-4">
    <div class="col-md-4">
      <div class="card border-primary">
        <div class="card-body">
          <div class="d-flex justify-content-between align-items-center">
            <div>
              <h6 class="text-muted mb-1">Total Pipelines</h6>
              <h2 class="mb-0"><%= @stats[:total] %></h2>
            </div>
            <div class="text-primary">
              <i class="fas fa-stream fa-3x opacity-25"></i>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="col-md-4">
      <div class="card border-info">
        <div class="card-body">
          <div class="d-flex justify-content-between align-items-center">
            <div>
              <h6 class="text-muted mb-1">Active Now</h6>
              <h2 class="mb-0 text-info"><%= @stats[:active] %></h2>
            </div>
            <div class="text-info">
              <i class="fas fa-spinner fa-3x opacity-25"></i>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="col-md-4">
      <div class="card border-success">
        <div class="card-body">
          <div class="d-flex justify-content-between align-items-center">
            <div>
              <h6 class="text-muted mb-1">Completed</h6>
              <h2 class="mb-0 text-success"><%= @stats[:completed] %></h2>
            </div>
            <div class="text-success">
              <i class="fas fa-check-circle fa-3x opacity-25"></i>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="col-md-4">
      <div class="card border-danger">
        <div class="card-body">
          <div class="d-flex justify-content-between align-items-center">
            <div>
              <h6 class="text-muted mb-1">Failed</h6>
              <h2 class="mb-0 text-danger"><%= @stats[:failed] %></h2>
            </div>
            <div class="text-danger">
              <i class="fas fa-exclamation-circle fa-3x opacity-25"></i>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="col-md-4">
      <div class="card border-warning">
        <div class="card-body">
          <div class="d-flex justify-content-between align-items-center">
            <div>
              <h6 class="text-muted mb-1">Total Cost</h6>
              <h2 class="mb-0 text-warning">$<%= number_with_precision(@stats[:total_cost] || 0, precision: 2) %></h2>
            </div>
            <div class="text-warning">
              <i class="fas fa-dollar-sign fa-3x opacity-25"></i>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="col-md-4">
      <div class="card border-secondary">
        <div class="card-body">
          <div class="d-flex justify-content-between align-items-center">
            <div>
              <h6 class="text-muted mb-1">Total Tokens</h6>
              <h2 class="mb-0"><%= number_with_delimiter(@stats[:total_tokens] || 0) %></h2>
            </div>
            <div class="text-secondary">
              <i class="fas fa-coins fa-3x opacity-25"></i>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Filters -->
  <div class="card mb-4">
    <div class="card-body">
      <%= form_with url: admin_pipeline_executions_path, method: :get, local: true, class: "row g-3" do |f| %>
        <div class="col-md-3">
          <%= f.select :status,
                      options_for_select(
                        [['All Statuses', '']] + PipelineExecution.statuses.keys.map { |s| [s.titleize, s] },
                        params[:status]
                      ),
                      {},
                      class: "form-select" %>
        </div>

        <div class="col-md-3">
          <%= f.select :priority,
                      options_for_select(
                        [['All Priorities', '']] + PipelineExecution.priorities.keys.map { |p| [p.titleize, p] },
                        params[:priority]
                      ),
                      {},
                      class: "form-select" %>
        </div>

        <div class="col-md-3">
          <%= f.select :ticket_system,
                      options_for_select(
                        [['All Systems', ''], ['JIRA', 'jira'], ['Azure DevOps', 'azure_devops']],
                        params[:ticket_system]
                      ),
                      {},
                      class: "form-select" %>
        </div>

        <div class="col-md-3">
          <%= f.submit "Apply Filters", class: "btn btn-primary w-100" %>
        </div>
      <% end %>
    </div>
  </div>

  <!-- Pipelines Table -->
  <div class="card">
    <div class="card-header">
      <h5 class="mb-0">Pipeline Executions</h5>
    </div>
    <div class="card-body p-0">
      <div class="table-responsive">
        <table class="table table-hover mb-0">
          <thead class="table-light">
            <tr>
              <th>Ticket ID</th>
              <th>Title</th>
              <th>Status</th>
              <th>Priority</th>
              <th>Duration</th>
              <th>Cost</th>
              <th>Started</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            <% if @pipeline_executions.any? %>
              <% @pipeline_executions.each do |pipeline| %>
                <tr>
                  <td>
                    <% if pipeline.ticket_url.present? %>
                      <%= link_to pipeline.ticket_id, pipeline.ticket_url, target: "_blank", class: "text-decoration-none" %>
                      <i class="fas fa-external-link-alt fa-xs text-muted"></i>
                    <% else %>
                      <%= pipeline.ticket_id %>
                    <% end %>
                  </td>
                  <td class="text-truncate" style="max-width: 300px;">
                    <%= pipeline.ticket_title %>
                  </td>
                  <td>
                    <% color = AiAgents::Pipeline::StateMachine.state_color(pipeline.status) %>
                    <% icon = AiAgents::Pipeline::StateMachine.state_icon(pipeline.status) %>
                    <span class="badge bg-<%= color %>">
                      <i class="<%= icon %>"></i>
                      <%= pipeline.status.titleize %>
                    </span>
                  </td>
                  <td>
                    <% priority_colors = { 'critical' => 'danger', 'high' => 'warning', 'medium' => 'info', 'low' => 'secondary' } %>
                    <span class="badge bg-<%= priority_colors[pipeline.priority] || 'secondary' %>">
                      <%= pipeline.priority&.titleize || 'Medium' %>
                    </span>
                  </td>
                  <td>
                    <% if pipeline.completed_at && pipeline.started_at %>
                      <%= distance_of_time_in_words(pipeline.started_at, pipeline.completed_at) %>
                    <% elsif pipeline.started_at %>
                      <%= distance_of_time_in_words(pipeline.started_at, Time.current) %>
                      <span class="text-muted">(running)</span>
                    <% else %>
                      <span class="text-muted">Not started</span>
                    <% end %>
                  </td>
                  <td>
                    <% if pipeline.total_cost && pipeline.total_cost > 0 %>
                      $<%= number_with_precision(pipeline.total_cost, precision: 2) %>
                    <% else %>
                      <span class="text-muted">-</span>
                    <% end %>
                  </td>
                  <td>
                    <%= pipeline.created_at.strftime("%b %d, %I:%M %p") %>
                  </td>
                  <td>
                    <div class="btn-group btn-group-sm">
                      <%= link_to admin_pipeline_execution_path(pipeline), class: "btn btn-outline-primary" do %>
                        <i class="fas fa-eye"></i>
                      <% end %>

                      <% if pipeline.status_failed? || pipeline.status_rolled_back? %>
                        <%= button_to retry_admin_pipeline_execution_path(pipeline),
                                      method: :post,
                                      class: "btn btn-outline-success",
                                      title: "Retry",
                                      data: { confirm: "Retry this pipeline execution?" } do %>
                          <i class="fas fa-redo"></i>
                        <% end %>
                      <% end %>

                      <% unless pipeline.terminal_state? %>
                        <%= button_to cancel_admin_pipeline_execution_path(pipeline),
                                      method: :post,
                                      class: "btn btn-outline-danger",
                                      title: "Cancel",
                                      data: { confirm: "Cancel this pipeline execution?" } do %>
                          <i class="fas fa-times"></i>
                        <% end %>
                      <% end %>
                    </div>
                  </td>
                </tr>
              <% end %>
            <% else %>
              <tr>
                <td colspan="8" class="text-center text-muted py-5">
                  <i class="fas fa-inbox fa-3x mb-3 d-block opacity-25"></i>
                  <p class="mb-0">No pipeline executions found</p>
                  <p class="small">Configure a connection and run TicketWatcherJob to start</p>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>

    <% if @pipeline_executions.any? %>
      <div class="card-footer">
        <%= paginate @pipeline_executions %>
      </div>
    <% end %>
  </div>
</div>
