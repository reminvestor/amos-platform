# Container build ignore patterns (Podman/Buildah compatible)

# Ignore git directory.
/.git/
/.gitignore

# Ignore bundler config.
/.bundle

# Ignore all environment files.
/.env*

# Ignore all default key files.
/config/master.key
/config/credentials/*.key

# Ignore all logfiles and tempfiles.
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep

# Ignore pidfiles, but keep the directory.
/tmp/pids/*
!/tmp/pids/.keep

# Ignore storage (uploaded files in development and any SQLite databases).
/storage/*
!/storage/.keep
/tmp/storage/*
!/tmp/storage/.keep

# Ignore assets.
/node_modules/
/app/assets/builds/*
!/app/assets/builds/.keep
/public/assets

# Ignore CI service files.
/.github

# Ignore Kamal files.
/config/deploy*.yml
/.kamal

# Ignore development files
/.devcontainer

# Ignore container build files
/.containerignore
/Containerfile*

# Ignore documentation (not needed in production image)
/docs/
README.md
CHANGELOG.md
*.md
!docs/architecture/.keep

# Ignore tests (not needed in production image)
/test/
/spec/

# Ignore AI agent configs (not needed in production)
/.claude/

# Ignore Git files
/.git/
/.gitattributes
/.github/

# Ignore local helper scripts
/tmp/*.rb
/bin/setup
/bin/update

# Ignore coverage and analysis tools
/coverage/
/.simplecov

# Ignore IDE files
/.vscode/
/.idea/
*.swp
*.swo

# Ignore Terraform (infrastructure as code, not app code)
/aws/
/terraform/
