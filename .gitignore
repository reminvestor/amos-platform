# See https://help.github.com/articles/ignoring-files for more about ignoring files.
#
# Temporary files generated by your text editor or operating system
# belong in git's global ignore instead:
# `$XDG_CONFIG_HOME/git/ignore` or `~/.config/git/ignore`

# Ignore bundler config.
/.bundle

# Ignore all environment files.
/.env*

# Ignore all logfiles and tempfiles.
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep

# Ignore pidfiles, but keep the directory.
/tmp/pids/*
!/tmp/pids/
!/tmp/pids/.keep

# Ignore storage (uploaded files in development and any SQLite databases).
/storage/*
!/storage/.keep
/tmp/storage/*
!/tmp/storage/
!/tmp/storage/.keep

/public/assets

# Ignore master key for decrypting credentials and more.
/config/master.key

# Ignore sensitive config files
/config/solana_token.yml

# Docker local overrides
docker-compose.override.yml

# Ignore environment variables
.env
.env.*
!.env.example

# Ignore Redis dump files
dump.rdb

/app/assets/builds/*
!/app/assets/builds/.keep

# Ignore node modules
/node_modules

# Ignore yarn files
/yarn-error.log
yarn-debug.log*
.yarn-integrity
.yarn/install-state.gz

# Ignore coverage reports
/coverage

# Ignore system files
.DS_Store
Thumbs.db

# Ignore user-uploaded RAG source documents (keep structure only)
/rag_sources/system/amos/**/*
!/rag_sources/system/amos/**/.gitkeep
/rag_sources/system/integrations/**/*
!/rag_sources/system/integrations/**/.gitkeep

# Terraform (entire infrastructure directories - keep infra private)
/terraform/
/aws/terraform/
**/.terraform/*
*.tfstate
*.tfstate.*
terraform.tfvars
*.tfvars
*.auto.tfvars
override.tf
override.tf.json
*_override.tf
*_override.tf.json
*.plan

# AWS deployment scripts and configs (ignore all except task-definition.json for CI/CD)
/aws/*
!/aws/task-definition.json

# Production database scripts
copy-prod-db-to-dev.sh
restore-prod-snapshot-to-dev*.sh
ecs_diagnostics.sh
check_ecs_workers.sh
add-https-listener.sh
enable-pgvector-rds.sh

# Claude Code internal configs (keep workflows private)
/.claude/

# Collaboration AWS scripts
/scripts/collaboration/

# Mobile apps (React Native - keep separate)
/mobile/
tmp/create_admin.rb
tmp/reset_passwords.rb
tmp/reset_all_passwords.rb
tmp/*.rb
LOGIN_INFO.md
docs/AI_PIPELINE_SPEC.md

# IDE-specific files
.vscode/
.idea/
*.swp
*.swo
*~

# Personal notes and scratch files
docs/scratch/
docs/notes/
NOTES.md
TODO.md
.claude/settings.local.json
.claude/.hook-logs

# Security audit reports (generated output)
security_audit_report*.txt
security_report*.txt
.claude/.hook-logs

# Web page screenshots
/public/web_captures/

# Playwright
/e2e/test-results/
/e2e/playwright-report/
/e2e/.auth/

# Invoice config (contains secrets)
.claude/invoice-config.local.json
config/solana_token.yml
config/solana_token.yml
LOGIN_INFO.md
