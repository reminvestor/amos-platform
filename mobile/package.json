{
  "name": "amos-mobile",
  "version": "0.1.0",
  "description": "AMOS Platform Mobile App - React Native + Expo",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "eject": "expo eject",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:debug": "node --inspect-brk node_modules/.bin/jest --runInBand",
    "e2e:build:ios": "detox build-framework-cache && detox build-app-and-cache --configuration ios.sim.debug",
    "e2e:build:android": "detox build-app-and-cache --configuration android.emu.debug",
    "e2e:ios": "detox test --configuration ios.sim.debug",
    "e2e:ios:debug": "detox test --configuration ios.sim.debug --debug-synchronization=200",
    "e2e:android": "detox test --configuration android.emu.debug",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-native": "^0.73.0",
    "expo": "^50.0.0",
    "expo-av": "^13.10.0",
    "expo-notifications": "^0.27.0",
    "expo-splash-screen": "^0.26.0",
    "expo-status-bar": "^1.11.0",
    "axios": "^1.6.0",
    "@reduxjs/toolkit": "^1.9.7",
    "react-redux": "^8.1.3",
    "@react-navigation/native": "^6.1.9",
    "@react-navigation/bottom-tabs": "^6.5.11",
    "@react-navigation/native-stack": "^6.9.17",
    "@react-native-async-storage/async-storage": "^1.21.0",
    "@react-native-voice/voice": "^3.2.4",
    "realm": "^12.0.0",
    "firebase": "^10.7.0",
    "react-native-gesture-handler": "^2.14.0",
    "react-native-reanimated": "^3.6.0",
    "react-native-screens": "^3.27.0",
    "react-native-safe-area-context": "^4.7.4",
    "react-native-paper": "^5.11.0",
    "@react-native-community/datetimepicker": "^7.2.0",
    "react-native-swipe-list-view": "^3.2.10",
    "react-native-chart-kit": "^6.12.0",
    "date-fns": "^2.30.0",
    "lodash": "^4.17.21"
  },
  "devDependencies": {
    "@types/react": "^18.2.37",
    "@types/react-native": "^0.73.0",
    "@types/jest": "^29.5.8",
    "typescript": "^5.3.3",
    "jest": "^29.7.0",
    "jest-environment-node": "^29.7.0",
    "@testing-library/react-native": "^12.4.0",
    "@testing-library/jest-native": "^5.4.3",
    "detox": "^20.12.0",
    "detox-cli": "^20.12.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "eslint": "^8.55.0",
    "prettier": "^3.1.0",
    "babel-plugin-module-resolver": "^5.0.0",
    "babel-jest": "^29.7.0"
  },
  "private": true,
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
