 error: #{e.message}\"\n/Users/ryan/Documents/agent_marketing/app/controllers/scout_controller.rb:      Rails.logger.error e.backtrace.join(\"\\n\")\n/Users/ryan/Documents/agent_marketing/app/controllers/scout_controller.rb:    Rails.logger.info \"Scout interactive chat - Session: #{@session_id}, User: #{current_user.id}, Message: #{user_message}\"\n/Users/ryan/Documents/agent_marketing/app/controllers/scout_controller.rb:    Rails.logger.info \"Chat context: #{context.inspect}\" if context\n/Users/ryan/Documents/agent_marketing/app/controllers/scout_controller.rb:    Rails.logger.info \"File URLs: #{file_urls.inspect}\" if file_urls.any?\n/Users/ryan/Documents/agent_marketing/app/controllers/scout_controller.rb:        Rails.logger.info \"Workflow progress: #{progress_data.inspect}\"\n/Users/ryan/Documents/agent_marketing/app/controllers/scout_controller.rb:      Rails.logger.error \"Scout interactive chat error: #{e.message}\"\n/Users/ryan/Documents/agent_marketing/app/controllers/scout_controller.rb:      Rails.logger.error e.backtrace.join(\"\\n\")\n/Users/ryan/Documents/agent_marketing/app/controllers/scout_controller.rb:      Rails.logger.error \"Workflow approval error: #{e.message}\"\n/Users/ryan/Documents/agent_marketing/app/controllers/scout_controller.rb:    Rails.logger.error \"File upload error: #{e.message}\"\n/Users/ryan/Documents/agent_marketing/app/controllers/scout_controller.rb:    user_inputs = if params[:inputs].is_a?(ActionController::Parameters)\n/Users/ryan/Documents/agent_marketing/app/controllers/scout_controller.rb:      params[:inputs].to_unsafe_h","stderr":"","interrupted":false,"isImage":false}}
