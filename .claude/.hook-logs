{"session_id":"0db11a1d-cd10-4093-9d00-1acacdddb1e9","transcript_path":"/Users/ryan/.claude/projects/-Users-ryan-Documents-agent-marketing/0db11a1d-cd10-4093-9d00-1acacdddb1e9.jsonl","cwd":"/Users/ryan/Documents/agent_marketing","permission_mode":"acceptEdits","hook_event_name":"PostToolUse","tool_name":"Edit","tool_input":{"file_path":"/Users/ryan/Documents/agent_marketing/app/views/scout/canvas/_document_viewer.html.erb","old_string":"<script>\n// Initialize document viewer\ndocument.addEventListener('DOMContentLoaded', function() {\n  console.log('📄 Document viewer loaded');\n\n  // Handle PDF loading errors\n  const embed = document.querySelector('.document-frame embed');\n  if (embed) {\n    embed.addEventListener('error', function() {\n      console.error('Failed to load PDF');\n    });\n  }\n\n  // Poll document indexing status\n  const assetId = document.querySelector('.document-viewer-container')?.dataset?.assetId;\n  if (assetId) {\n    pollDocumentStatus(assetId);\n  }\n});","new_string":"<script>\n// Initialize document viewer - runs immediately since canvas is already loaded\nconsole.log('📄 Document viewer script loaded');\n\n// Handle PDF loading errors\nsetTimeout(function() {\n  const embed = document.querySelector('.document-frame embed');\n  if (embed) {\n    embed.addEventListener('error', function() {\n      console.error('Failed to load PDF');\n    });\n  }\n}, 100);\n\n// Poll document indexing status - runs immediately\nconst assetId = document.querySelector('.document-viewer-container')?.dataset?.assetId;\nconsole.log('Asset ID from data attribute:', assetId);\nif (assetId) {\n  console.log('Starting document status polling for asset:', assetId);\n  pollDocumentStatus(assetId);\n}"},"tool_response":{"filePath":"/Users/ryan/Documents/agent_marketing/app/views/scout/canvas/_document_viewer.html.erb","oldString":"<script>\n// Initialize document viewer\ndocument.addEventListener('DOMContentLoaded', function() {\n  console.log('📄 Document viewer loaded');\n\n  // Handle PDF loading errors\n  const embed = document.querySelector('.document-frame embed');\n  if (embed) {\n    embed.addEventListener('error', function() {\n      console.error('Failed to load PDF');\n    });\n  }\n\n  // Poll document indexing status\n  const assetId = document.querySelector('.document-viewer-container')?.dataset?.assetId;\n  if (assetId) {\n    pollDocumentStatus(assetId);\n  }\n});","newString":"<script>\n// Initialize document viewer - runs immediately since canvas is already loaded\nconsole.log('📄 Document viewer script loaded');\n\n// Handle PDF loading errors\nsetTimeout(function() {\n  const embed = document.querySelector('.document-frame embed');\n  if (embed) {\n    embed.addEventListener('error', function() {\n      console.error('Failed to load PDF');\n    });\n  }\n}, 100);\n\n// Poll document indexing status - runs immediately\nconst assetId = document.querySelector('.document-viewer-container')?.dataset?.assetId;\nconsole.log('Asset ID from data attribute:', assetId);\nif (assetId) {\n  console.log('Starting document status polling for asset:', assetId);\n  pollDocumentStatus(assetId);\n}","originalFile":"<!-- Document Viewer Canvas -->\n<div class=\"document-viewer-container\" data-asset-id=\"<%= canvas_data[:asset_id] %>\" data-url=\"<%= canvas_data[:url] %>\">\n  <div class=\"viewer-header mb-4\">\n    <div class=\"row align-items-center\">\n      <div class=\"col\">\n        <h5 class=\"mb-0\">\n          <i data-lucide=\"<%= canvas_data[:view_type] == 'library' ? 'folder-open' : 'file-text' %>\" class=\"<%= canvas_data[:view_type] == 'library' ? 'text-primary' : 'text-danger' %> me-2\" aria-hidden=\"true\"></i>\n          <%= canvas_data[:view_type] == 'library' ? 'My Documents' : (canvas_data[:filename] || 'Document') %>\n        </h5>\n        <% if canvas_data[:view_type] == 'single' && canvas_data[:size] %>\n          <small class=\"text-muted\">\n            <%= number_to_human_size(canvas_data[:size]) %> • <%= canvas_data[:content_type] %>\n          </small>\n        <% elsif canvas_data[:view_type] == 'library' && canvas_data[:documents] %>\n          <small class=\"text-muted\">\n            <%= pluralize(canvas_data[:documents].length, 'document') %>\n          </small>\n        <% end %>\n      </div>\n      <div class=\"col-auto\">\n        <% if canvas_data[:view_type] == 'single' && canvas_data[:download_url] %>\n          <a href=\"<%= canvas_data[:download_url] %>\" class=\"btn btn-sm btn-outline-primary\" download aria-label=\"Download document\">\n            <i data-lucide=\"download\" class=\"me-1\" aria-hidden=\"true\"></i> Download\n          </a>\n        <% end %>\n        <button class=\"btn btn-sm btn-outline-secondary\" onclick=\"window.scoutController.goToConversation()\" aria-label=\"Close document viewer\">\n          <i data-lucide=\"x\" class=\"me-1\" aria-hidden=\"true\"></i> Close\n        </button>\n      </div>\n    </div>\n  </div>\n\n  <!-- LIBRARY VIEW: Show list of documents -->\n  <% if canvas_data[:view_type] == 'library' %>\n    <% if canvas_data[:documents]&.any? %>\n      <div class=\"document-library\">\n        <div class=\"list-group\">\n          <% canvas_data[:documents].each do |doc| %>\n            <div class=\"list-group-item list-group-item-action d-flex align-items-center py-3\" style=\"cursor: pointer;\"\n                 data-asset-id=\"<%= doc[:id] %>\"\n                 onclick=\"window.scoutController?.loadCanvas('document_viewer', {asset_id: <%= doc[:id] %>})\">\n              <div class=\"flex-grow-1\">\n                <div class=\"d-flex align-items-center\">\n                  <i data-lucide=\"file\" class=\"text-secondary me-2\" style=\"width: 20px; height: 20px;\" aria-hidden=\"true\"></i>\n                  <div>\n                    <h6 class=\"mb-1\"><%= doc[:title] %></h6>\n                    <small class=\"text-muted\">\n                      <%= number_to_human_size(doc[:size]) %> • <%= Time.parse(doc[:created_at].to_s).strftime('%b %d, %Y') %>\n                    </small>\n                  </div>\n                </div>\n              </div>\n              <div class=\"flex-shrink-0\">\n                <a href=\"<%= doc[:download_url] %>\" class=\"btn btn-sm btn-outline-secondary ms-2\" download\n                   onclick=\"event.stopPropagation();\" aria-label=\"Download file\">\n                  <i data-lucide=\"download\" aria-hidden=\"true\"></i>\n                </a>\n              </div>\n            </div>\n          <% end %>\n        </div>\n      </div>\n    <% else %>\n      <div class=\"alert alert-info\">\n        <i data-lucide=\"info\" class=\"me-2\" aria-hidden=\"true\"></i>\n        No documents uploaded yet. Upload a document to get started!\n      </div>\n    <% end %>\n  <% end %>\n\n  <!-- SINGLE DOCUMENT VIEW: Show document content -->\n  <% if canvas_data[:view_type] == 'single' %>\n    <% if canvas_data[:extracted_text_preview] && canvas_data[:extracted_text_preview].include?(\"⚠️ Unable to extract text\") %>\n      <!-- Show OCR error message -->\n      <div class=\"alert alert-warning\">\n        <h5 class=\"alert-heading\">\n          <i data-lucide=\"alert-triangle\" class=\"me-2\" aria-hidden=\"true\"></i>Unable to Process Document\n        </h5>\n        <p class=\"mb-2\">This appears to be a scanned PDF that requires special tools to read.</p>\n\n        <div class=\"mt-3\">\n          <p class=\"mb-2\"><strong>To enable OCR processing:</strong></p>\n          <ol class=\"mb-3\">\n            <li>Install ImageMagick: <code>brew install imagemagick</code></li>\n            <li>Install Ghostscript: <code>brew install ghostscript</code></li>\n            <li>Restart your Rails server</li>\n          </ol>\n\n          <p class=\"mb-2\"><strong>Alternative options:</strong></p>\n          <ul class=\"mb-0\">\n            <li>Convert the PDF to text using an online tool</li>\n            <li>Upload a text-based PDF instead of a scanned image</li>\n            <li>Take a screenshot of the PDF and upload it as an image</li>\n          </ul>\n        </div>\n      </div>\n    <% end %>\n\n    <!-- Document Viewer -->\n    <div class=\"document-frame\" style=\"height: 600px;\">\n      <% case canvas_data[:content_type] %>\n      <% when 'application/pdf' %>\n        <embed src=\"<%= canvas_data[:url] %>\" type=\"application/pdf\" width=\"100%\" height=\"100%\" />\n      <% when /^image\\// %>\n        <div class=\"text-center p-4\">\n          <img src=\"<%= canvas_data[:url] %>\" class=\"img-fluid\" style=\"max-height: 100%;\" />\n        </div>\n      <% when /^text\\// %>\n        <div class=\"p-4 bg-light h-100 overflow-auto\">\n          <pre class=\"mb-0\"><%= canvas_data[:extracted_text_preview] || 'Loading...' %></pre>\n        </div>\n      <% else %>\n        <div class=\"text-center p-5\">\n          <i data-lucide=\"file\" class=\"icon-4x text-muted mb-3\" aria-hidden=\"true\"></i>\n          <p class=\"text-muted\">This file type cannot be displayed in the browser.</p>\n          <% if canvas_data[:download_url] %>\n            <a href=\"<%= canvas_data[:download_url] %>\" class=\"btn btn-primary\" download aria-label=\"Download file to view\">\n              <i data-lucide=\"download\" class=\"me-2\" aria-hidden=\"true\"></i>Download to View\n            </a>\n          <% end %>\n        </div>\n      <% end %>\n    </div>\n\n    <!-- Document Indexing Status (for recently uploaded documents) -->\n    <% if canvas_data[:asset_id] %>\n      <div class=\"mt-4\" id=\"indexing-status-container\"></div>\n    <% end %>\n\n    <% if canvas_data[:rag_store_id] %>\n      <div class=\"mt-3 text-muted text-center\">\n        <small>\n          <i data-lucide=\"database\" class=\"me-1\" aria-hidden=\"true\"></i>\n          Document stored in knowledge base (ID: <%= canvas_data[:rag_store_id] %>)\n        </small>\n      </div>\n    <% end %>\n  <% end %>\n</div>\n\n<style>\n.document-viewer-container {\n  height: 100%;\n  display: flex;\n  flex-direction: column;\n}\n\n.document-frame {\n  flex: 1;\n  border: 1px solid #dee2e6;\n  border-radius: 0.5rem;\n  overflow: hidden;\n  background: #f8f9fa;\n}\n\n.document-frame embed {\n  border: none;\n}\n</style>\n\n<script>\n// Initialize document viewer\ndocument.addEventListener('DOMContentLoaded', function() {\n  console.log('📄 Document viewer loaded');\n\n  // Handle PDF loading errors\n  const embed = document.querySelector('.document-frame embed');\n  if (embed) {\n    embed.addEventListener('error', function() {\n      console.error('Failed to load PDF');\n    });\n  }\n\n  // Poll document indexing status\n  const assetId = document.querySelector('.document-viewer-container')?.dataset?.assetId;\n  if (assetId) {\n    pollDocumentStatus(assetId);\n  }\n});\n\nfunction pollDocumentStatus(assetId) {\n  const statusContainer = document.getElementById('indexing-status-container');\n  if (!statusContainer) return;\n\n  // Poll every 5 seconds\n  const pollInterval = setInterval(async () => {\n    try {\n      const response = await fetch(`/scout/document-status/${assetId}`);\n      if (!response.ok) {\n        clearInterval(pollInterval);\n        return;\n      }\n\n      const status = await response.json();\n      displayStatusUI(status, statusContainer);\n\n      // Stop polling when complete or failed\n      if (status.ready_for_chat || status.status === 'embedding_failed' ||\n          status.status === 'extraction_failed' || status.status === 'chunking_failed' ||\n          status.status === 'upload_failed') {\n        clearInterval(pollInterval);\n      }\n    } catch (error) {\n      console.error('Error polling document status:', error);\n    }\n  }, 5000);\n\n  // Poll immediately on first load\n  (async () => {\n    try {\n      const response = await fetch(`/scout/document-status/${assetId}`);\n      if (response.ok) {\n        const status = await response.json();\n        displayStatusUI(status, statusContainer);\n      }\n    } catch (error) {\n      console.error('Error fetching initial status:', error);\n    }\n  })();\n}\n\nfunction displayStatusUI(status, container) {\n  if (!status) return;\n\n  let html = '';\n\n  // Hide status if document is ready or has no processing\n  if (status.ready_for_chat) {\n    container.innerHTML = '';\n    return;\n  }\n\n  if (status.status === 'pending') {\n    html = `\n      <div class=\"alert alert-info\" role=\"alert\">\n        <i data-lucide=\"clock\" class=\"me-2\" aria-hidden=\"true\"></i>\n        <strong>Preparing document...</strong><br>\n        <small>This document hasn't been indexed yet. It will be ready for chat once processing completes.</small>\n      </div>\n    `;\n  } else if (status.status.includes('failed')) {\n    const errorMsg = status.error ? ` ${status.error}` : '';\n    html = `\n      <div class=\"alert alert-danger\" role=\"alert\">\n        <i data-lucide=\"alert-circle\" class=\"me-2\" aria-hidden=\"true\"></i>\n        <strong>Processing Failed</strong><br>\n        <small>${status.message}.${errorMsg}</small>\n      </div>\n    `;\n  } else {\n    const progressPercent = status.progress_percent || Math.round((status.stage / status.total_stages) * 100);\n    const stageIcon = getStageIcon(status.stage);\n\n    html = `\n      <div class=\"card border-info\">\n        <div class=\"card-body\">\n          <div class=\"d-flex align-items-center mb-2\">\n            ${stageIcon}\n            <strong>${status.message}</strong>\n          </div>\n          <div class=\"progress\" style=\"height: 24px;\">\n            <div class=\"progress-bar progress-bar-striped progress-bar-animated\"\n                 role=\"progressbar\"\n                 style=\"width: ${progressPercent}%\"\n                 aria-valuenow=\"${progressPercent}\"\n                 aria-valuemin=\"0\"\n                 aria-valuemax=\"100\">\n              ${progressPercent}%\n            </div>\n          </div>\n          <small class=\"text-muted d-block mt-2\">\n            Stage ${status.stage} of ${status.total_stages}\n            ${status.embedded_chunks ? ` • ${status.embedded_chunks}/${status.total_chunks} chunks embedded` : ''}\n          </small>\n        </div>\n      </div>\n    `;\n  }\n\n  container.innerHTML = html;\n\n  // Reinitialize lucide icons if they were added\n  if (window.lucide) {\n    window.lucide.createIcons();\n  }\n}\n\nfunction getStageIcon(stage) {\n  const icons = {\n    0: '<i data-lucide=\"upload\" class=\"me-2 text-muted\" aria-hidden=\"true\"></i>',\n    1: '<i data-lucide=\"upload\" class=\"me-2 text-info\" aria-hidden=\"true\"></i>',\n    2: '<i data-lucide=\"file-text\" class=\"me-2 text-info\" aria-hidden=\"true\"></i>',\n    3: '<i data-lucide=\"layers\" class=\"me-2 text-info\" aria-hidden=\"true\"></i>',\n    4: '<i data-lucide=\"zap\" class=\"me-2 text-info\" aria-hidden=\"true\"></i>'\n  };\n  return icons[stage] || '';\n}\n</script>","structuredPatch":[{"oldStart":159,"oldLines":24,"newStart":159,"newLines":26,"lines":[" </style>"," "," <script>","-// Initialize document viewer","-document.addEventListener('DOMContentLoaded', function() {","-  console.log('📄 Document viewer loaded');","+// Initialize document viewer - runs immediately since canvas is already loaded","+console.log('📄 Document viewer script loaded');"," ","-  // Handle PDF loading errors","+// Handle PDF loading errors","+setTimeout(function() {","   const embed = document.querySelector('.document-frame embed');","   if (embed) {","     embed.addEventListener('error', function() {","       console.error('Failed to load PDF');","     });","   }","+}, 100);"," ","-  // Poll document indexing status","-  const assetId = document.querySelector('.document-viewer-container')?.dataset?.assetId;","-  if (assetId) {","-    pollDocumentStatus(assetId);","-  }","-});","+// Poll document indexing status - runs immediately","+const assetId = document.querySelector('.document-viewer-container')?.dataset?.assetId;","+console.log('Asset ID from data attribute:', assetId);","+if (assetId) {","+  console.log('Starting document status polling for asset:', assetId);","+  pollDocumentStatus(assetId);","+}"," "," function pollDocumentStatus(assetId) {","   const statusContainer = document.getElementById('indexing-status-container');"]}],"userModified":false,"replaceAll":false}}
