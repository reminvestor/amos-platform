ver' %></p>\n          <p><strong>Next Training:</strong> <code><%= @next_training_at.is_a?(String) ? @next_training_at : @next_training_at.strftime('%Y-%m-%d %H:%M:%S') %></code></p>\n        </div>\n      </div>\n    </div>\n  </div>\n\n  <!-- Training Readiness -->\n  <div class=\"card mb-4\">\n    <div class=\"card-header bg-light\">\n      <h5 class=\"mb-0\">✅ Training Readiness</h5>\n    </div>\n    <div class=\"card-body\">\n      <div class=\"row\">\n        <div class=\"col-md-4\">\n          <div class=\"alert <%= @training_checks[:enabled] ? 'alert-success' : 'alert-danger' %>\" role=\"alert\">\n            <strong>Enabled:</strong> <%= @training_checks[:enabled] ? '✅ Yes' : '❌ No' %>\n          </div>\n        </div>\n        <div class=\"col-md-4\">\n          <div class=\"alert <%= @training_checks[:enough_traces] ? 'alert-success' : 'alert-warning' %>\" role=\"alert\">\n            <strong>Traces Ready:</strong> <%= @training_checks[:enough_traces] ? \"✅ #{@traces_ready_for_training} traces\" : \"⏳ #{@traces_ready_for_training}/#{@config.min_traces_for_training}\" %>\n          </div>\n        </div>\n        <div class=\"col-md-4\">\n          <div class=\"alert <%= @training_checks[:retrain_due] ? 'alert-success' : 'alert-info' %>\" role=\"alert\">\n            <strong>Retrain Due:</strong> <%= @training_checks[:retrain_due] ? '✅ Yes' : '⏳ Not yet' %>\n          </div>\n        </div>\n      </div>\n    </div>\n  </div>\n\n  <!-- Key Metrics -->\n  <div class=\"row mb-4\">\n    <div class=\"col-md-3\">\n      <div class=\"card text-center\">\n        <div class=\"card-body\">\n          <h6 class=\"card-title text-muted\">Success Rate</h6>\n          <h3 class=\"card-text text-success\"><%= @success_rate %>%</h3>\n          <small class=\"text-muted\"><%= @recent_traces.count %> recent traces</small>\n        </div>\n      </div>\n    </div>\n    <div class=\"col-md-3\">\n      <div class=\"card text-center\">\n        <div class=\"card-body\">\n          <h6 class=\"card-title text-muted\">Avg Tokens</h6>\n          <h3 class=\"card-text text-info\"><%= @avg_tokens %></h3>\n          <small class=\"text-muted\">Per trace</small>\n        </div>\n      </div>\n    </div>\n    <div class=\"col-md-3\">\n      <div class=\"card text-center\">\n        <div class=\"card-body\">\n          <h6 class=\"card-title text-muted\">Avg Cost</h6>\n          <h3 class=\"card-text text-warning\">$<%= @avg_cost %></h3>\n          <small class=\"text-muted\">Per trace</small>\n        </div>\n      </div>\n    </div>\n    <div class=\"col-md-3\">\n      <div class=\"card text-center\">\n        <div class=\"card-body\">\n          <h6 class=\"card-title text-muted\">Avg Duration</h6>\n          <h3 class=\"card-text text-secondary\"><%= @avg_duration %>ms</h3>\n          <small class=\"text-muted\">Per trace</small>\n        </div>\n      </div>\n    </div>\n  </div>\n\n  <!-- Trace Statistics -->\n  <div class=\"card mb-4\">\n    <div class=\"card-header bg-light\">\n      <h5 class=\"mb-0\">📊 Trace Statistics</h5>\n    </div>\n    <div class=\"card-body\">\n      <div class=\"row\">\n        <div class=\"col-md-3\">\n          <p><strong>Total Traces:</strong> <code><%= @total_traces %></code></p>\n        </div>\n        <div class=\"col-md-3\">\n          <p><strong>Completed:</strong> <code><%= @completed_traces %></code></p>\n        </div>\n        <div class=\"col-md-3\">\n          <p><strong>Failed:</strong> <code><%= @failed_traces %></code></p>\n        </div>\n        <div class=\"col-md-3\">\n          <p><strong>With Rewards:</strong> <code><%= @traces_with_rewards %></code></p>\n        </div>\n      </div>\n      <div class=\"progress\" style=\"height: 25px;\">\n        <% if @total_traces > 0 %>\n          <div class=\"progress-bar bg-success\" style=\"width: <%= (@completed_traces.to_f / @total_traces * 100).round %>%\">\n            Completed <%= @completed_traces %>\n          </div>\n          <div class=\"progress-bar bg-danger\" style=\"width: <%= (@failed_traces.to_f / @total_traces * 100).round %>%\">\n            Failed <%= @failed_traces %>\n          </div>\n        <% else %>\n          <div class=\"progress-bar bg-secondary w-100\">No traces yet</div>\n        <% end %>\n      </div>\n    </div>\n  </div>\n\n  <!-- Cost Summary -->\n  <div class=\"card mb-4\">\n    <div class=\"card-header bg-light\">\n      <h5 class=\"mb-0\">💰 Cost Summary (Last 100 traces)</h5>\n    </div>\n    <div class=\"card-body\">\n      <div class=\"row\">\n        <div class=\"col-md-6\">\n          <h4 class=\"text-warning\">Total Cost: $<%= @total_cost %></h4>\n        </div>\n        <div class=\"col-md-6\">\n          <h4 class=\"text-info\">Average Cost: $<%= @avg_cost %> per trace</h4>\n        </div>\n      </div>\n    </div>\n  </div>\n\n  <!-- Last Training Job -->\n  <% if @last_training_job %>\n    <div class=\"card mb-4\">\n      <div class=\"card-header bg-light\">\n        <h5 class=\"mb-0\">🚀 Last Training Job</h5>\n      </div>\n      <div class=\"card-body\">\n        <div class=\"row\">\n          <div class=\"col-md-6\">\n            <p><strong>Date:</strong> <%= @last_training_job.completed_at.strftime('%Y-%m-%d %H:%M:%S') %></p>\n            <p><strong>Type:</strong> <code><%= @last_training_job.job_type %></code></p>\n            <p><strong>Traces Used:</strong> <%= @last_training_job.traces_used %></p>\n          </div>\n          <div class=\"col-md-6\">\n            <p><strong>Status:</strong> <span class=\"badge bg-success\"><%= @last_training_job.status %></span></p>\n            <p><strong>Improvement:</strong> <strong class=\"text-success\">+<%= @last_training_job.improvement_score %>%</strong></p>\n          </div>\n        </div>\n\n        <% if @recommendations.any? %>\n          <hr />\n          <h6>📌 Recommendations:</h6>\n          <ul>\n            <% @recommendations.each do |rec| %>\n              <li>\n                <strong><%= rec['category'] %></strong> (<span class=\"badge <%= rec['priority'] == 'high' ? 'bg-danger' : 'bg-warning' %>\"><%= rec['priority'] %></span>)\n                <br />\n                <em><%= rec['recommendation'] %></em>\n              </li>\n            <% end %>\n          </ul>\n        <% end %>\n      </div>\n    </div>\n  <% end %>\n\n  <!-- LLM Call Analysis -->\n  <% if @llm_calls && @llm_calls.any? %>\n    <div class=\"card mb-4\">\n      <div class=\"card-header bg-light\">\n        <h5 class=\"mb-0\">🤖 LLM Call Analysis (Last 500 calls)</h5>\n      </div>\n      <div class=\"card-body\">\n        <div class=\"row mb-3\">\n          <div class=\"col-md-6\">\n            <p><strong>Success Rate:</strong> <span class=\"badge bg-success\"><%= @llm_success_rate %>%</span></p>\n          </div>\n          <div class=\"col-md-6\">\n            <p><strong>Avg Latency:</strong> <code><%= @avg_latency %>ms</code></p>\n          </div>\n        </div>\n\n        <h6>By Agent Role:</h6>\n        <table class=\"table table-sm\">\n          <thead>\n            <tr>\n              <th>Role</th>\n              <th>Count</th>\n              <th>Success Rate</th>\n              <th>Avg Tokens</th>\n              <th>Total Cost</th>\n            </tr>\n          </thead>\n          <tbody>\n            <% @llm_by_role.each do |role_data| %>\n              <tr>\n                <td><code><%= role_data[:role] %></code></td>\n                <td><%= role_data[:count] %></td>\n                <td><span class=\"badge bg-success\"><%= role_data[:success_rate] %>%</span></td>\n                <td><%= role_data[:avg_tokens] %></td>\n                <td>$<%= role_data[:total_cost] %></td>\n              </tr>\n            <% end %>\n          </tbody>\n        </table>\n      </div>\n    </div>\n  <% end %>\n\n  <!-- Top Tools -->\n  <% if @top_tools && @top_tools.any? %>\n    <div class=\"card\">\n      <div class=\"card-header bg-light\">\n        <h5 class=\"mb-0\">🔧 Top Tools (Last 500 executions)</h5>\n      </div>\n      <div class=\"card-body\">\n        <p><strong>Overall Success Rate:</strong> <span class=\"badge bg-success\"><%= @tool_success_rate %>%</span></p>\n        <table class=\"table table-sm\">\n          <thead>\n            <tr>\n              <th>Tool</th>\n              <th>Executions</th>\n              <th>Success Rate</th>\n            </tr>\n          </thead>\n          <tbody>\n            <% @top_tools.each do |tool| %>\n              <tr>\n                <td><code><%= tool[:name] %></code></td>\n                <td><%= tool[:count] %></td>\n                <td><span class=\"badge bg-<%= tool[:success_rate] > 80 ? 'success' : 'warning' %>\"><%= tool[:success_rate] %>%</span></td>\n              </tr>\n            <% end %>\n          </tbody>\n        </table>\n      </div>\n    </div>\n  <% end %>\n\n  <!-- Training History -->\n  <div class=\"card mt-4\">\n    <div class=\"card-header bg-light\">\n      <h5 class=\"mb-0\">📜 Training History (Last 10)</h5>\n    </div>\n    <div class=\"card-body\">\n      <% if @training_history.any? %>\n        <table class=\"table table-sm\">\n          <thead>\n            <tr>\n              <th>Date</th>\n              <th>Strategy</th>\n              <th>Traces Used</th>\n              <th>Improvement</th>\n            </tr>\n          </thead>\n          <tbody>\n            <% @training_history.each do |job| %>\n              <tr>\n                <td><%= job.completed_at.strftime('%Y-%m-%d %H:%M') %></td>\n                <td><code><%= job.job_type %></code></td>\n                <td><%= job.traces_used %></td>\n                <td><strong class=\"text-success\">+<%= job.improvement_score %>%</strong></td>\n              </tr>\n            <% end %>\n          </tbody>\n        </table>\n      <% else %>\n        <p class=\"text-muted\">No training jobs yet</p>\n      <% end %>\n    </div>\n  </div>\n</div>\n\n<style>\n  .card {\n    box-shadow: 0 0.125rem 0.25rem rgba(0, 0, 