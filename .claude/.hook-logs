{"session_id":"f4a72df9-5dd6-4e2e-8b37-470046177ca8","transcript_path":"/Users/ryan/.claude/projects/-Users-ryan-Documents-agent-marketing/f4a72df9-5dd6-4e2e-8b37-470046177ca8.jsonl","cwd":"/Users/ryan/Documents/agent_marketing","permission_mode":"acceptEdits","hook_event_name":"PostToolUse","tool_name":"Bash","tool_input":{"command":"cat .env.example | grep -A5 -B2 \"RAG\\|AWS\\|BEDROCK\\|S3\\|OPENAI\" | head -100","description":"Show RAG and AWS configuration from .env.example"},"tool_response":{"stdout":"# AWS Bedrock Configuration (REQUIRED)\nAWS_REGION=us-east-1\nAWS_ACCESS_KEY_ID=your_access_key_id\nAWS_SECRET_ACCESS_KEY=your_secret_access_key\n\n# AWS Bedrock Model Configuration\n# Available models:\n#   - claude-sonnet-4-5     (Latest, most capable - recommended for complex tasks)\n#   - claude-opus-4-1       (Most powerful, expensive - for critical tasks)\n#   - claude-3-5-sonnet     (Previous generation Sonnet - good balance)\n#   - claude-3-haiku        (Fastest, cheapest - good for simple tasks)\nBEDROCK_DEFAULT_MODEL=claude-sonnet-4-5\nBEDROCK_VOICE_MODEL=claude-3-haiku\nBEDROCK_CHAT_MODEL=claude-sonnet-4-5\n\n# Prompt Caching: Enable 49% token cost savings by caching static prompt components\n# When enabled: Uses regional endpoints (us.anthropic.*) with Sonnet 3.5 v2\n# When disabled: Uses global endpoints (global.anthropic.*) with Sonnet 4.5\n# Trade-off: Latest model (4.5) vs Cost savings (49% reduction)\n# NOTE: Currently disabled due to AWS API limitations - will re-enable when supported\nBEDROCK_PROMPT_CACHING_ENABLED=false\n\n# AWS SES Configuration (Optional - for email sending)\nAWS_SES_SENDER=your_verified_email@example.com\n\n# AWS S3 Configuration (Required for RAG document storage)\nRAG_BUCKET=agent-marketing-rag-storage\n# S3 bucket structure: s3://your-rag-bucket/entities/{entity_id}/raw_documents/...\n# Optional: Set S3 endpoint for testing with LocalStack\nAWS_S3_ENDPOINT=http://localhost:4566\n\n# OCR Configuration (Dual-Mode: Textract + Docling)\n# OCR_PROVIDER options: textract, docling, auto (auto selects based on document type/size)\nOCR_PROVIDER=auto\nOCR_FALLBACK_ENABLED=true\n--\nOCR_SHADOW_MODE=false\n\n# AWS Textract Configuration (Required if OCR_PROVIDER includes textract)\nTEXTRACT_ENABLED=true\nTEXTRACT_SNS_TOPIC_ARN=\nTEXTRACT_ROLE_ARN=\n\n# AWS Comprehend Configuration (Optional - for NLP enhancement)\nCOMPREHEND_ENABLED=false\nCOMPREHEND_DETECT_PII=false\nCOMPREHEND_CLASSIFIER_ARN=\nCOMPREHEND_ROLE_ARN=\n\n# AWS Bedrock Knowledge Base Configuration (Optional - for managed RAG)\nBEDROCK_KB_ENABLED=false\nBEDROCK_KB_ID=\nBEDROCK_KB_ROLE_ARN=\nOPENSEARCH_COLLECTION_ARN=\nOPENSEARCH_ENDPOINT=\n\n# Document Processing Pipeline Configuration\nDOCUMENT_PROCESSING_MODE=async\nDOCUMENT_WORKFLOW_ARN=\n# For production, comment out AWS_S3_ENDPOINT to use real S3\n\n# Docling Configuration (Optional - auto-detected if installed)\n# No configuration needed - Docling is automatically used if Python dependencies are installed\n# To verify: rails docling:check\n# To disable: Set use_docling: false when initializing DocumentProcessorService\n\n# RAG Configuration\n# Chunking strategy: 'semantic' (Ottomator-style) or 'simple' (current paragraph-based)\nRAG_CHUNKING_STRATEGY=semantic\n# Chunk size (tokens for semantic, characters for simple)\nRAG_CHUNK_SIZE=1000\n# Chunk overlap (characters) - only for semantic strategy\nRAG_CHUNK_OVERLAP=200\n# Embedding cache enabled (requires Redis)\nRAG_EMBEDDING_CACHE_ENABLED=true\n# Embedding batch size (1-100, higher = faster but more memory)\nRAG_EMBEDDING_BATCH_SIZE=100\n\n# OpenAI Configuration (Required for RAG)\nOPENAI_API_KEY=sk-your-key-here\nOPENAI_EMBEDDING_MODEL=text-embedding-ada-002\n\n# Pinecone Configuration (OPTIONAL - only needed for massive scale)\n#\n# Vector Storage Strategy:\n#   - PRIMARY: pgvector (PostgreSQL) - Used for local and AWS deployments\n#   - OPTIONAL: Pinecone - Add later for extreme scale (millions of vectors)\n#\n# pgvector handles production workloads up to ~10M vectors efficiently\n# AWS RDS PostgreSQL with pgvector extension provides excellent performance\n#\n# When to add Pinecone:\n#   - You have >10 million document chunks across all entities\n#   - You need sub-10ms query latency at extreme scale\n#   - Your RDS database is hitting storage/performance limits\n--\n# PINECONE_ENVIRONMENT=us-east-1-aws\n\n# SolidQueue Configuration for RAG Processing (Rails 8 job processor)\n# Queue priorities (configured in config/queue.yml):","stderr":"","interrupted":false,"isImage":false}}
