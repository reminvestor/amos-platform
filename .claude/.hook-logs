iv class=\"row\">\n        <div class=\"col-md-6\">\n          <h6>Duration Metrics</h6>\n          <div class=\"list-group list-group-flush\">\n            <div class=\"list-group-item d-flex justify-content-between align-items-center\">\n              <span>Total Duration</span>\n              <strong><%= @total_duration_minutes %> min</strong>\n            </div>\n            <div class=\"list-group-item d-flex justify-content-between align-items-center\">\n              <span>Average Duration</span>\n              <strong><%= @avg_duration %>ms</strong>\n            </div>\n            <div class=\"list-group-item d-flex justify-content-between align-items-center\">\n              <span>Minimum Duration</span>\n              <strong><%= @min_duration %>ms</strong>\n            </div>\n            <div class=\"list-group-item d-flex justify-content-between align-items-center\">\n              <span>Maximum Duration</span>\n              <strong><%= @max_duration %>ms</strong>\n            </div>\n          </div>\n        </div>\n        <div class=\"col-md-6\">\n          <h6>Performance Distribution</h6>\n          <div class=\"progress mb-3\" style=\"height: 30px;\">\n            <div class=\"progress-bar bg-success\" style=\"width: <%= (@traces.where('duration_ms < 1000').count.to_f / @total_traces * 100).round %>%\">\n              <1s\n            </div>\n            <div class=\"progress-bar bg-info\" style=\"width: <%= (@traces.where('duration_ms >= 1000 AND duration_ms < 5000').count.to_f / @total_traces * 100).round %>%\">\n              1-5s\n            </div>\n            <div class=\"progress-bar bg-warning\" style=\"width: <%= (@traces.where('duration_ms >= 5000 AND duration_ms < 10000').count.to_f / @total_traces * 100).round %>%\">\n              5-10s\n            </div>\n            <div class=\"progress-bar bg-danger\" style=\"width: <%= (@traces.where('duration_ms >= 10000').count.to_f / @total_traces * 100).round %>%\">\n              >10s\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>\n  </div>\n\n  <!-- LLM Call Analysis -->\n  <% if @llm_calls && @llm_calls.any? %>\n    <div class=\"card mb-4\">\n      <div class=\"card-header bg-light\">\n        <h5 class=\"mb-0\">🤖 LLM Call Analysis</h5>\n      </div>\n      <div class=\"card-body\">\n        <div class=\"row mb-3\">\n          <div class=\"col-md-4\">\n            <div class=\"alert alert-success mb-0\">\n              <h6 class=\"mb-1\">Success Rate</h6>\n              <h3 class=\"mb-0\"><%= @llm_success_rate %>%</h3>\n            </div>\n          </div>\n          <div class=\"col-md-4\">\n            <div class=\"alert alert-info mb-0\">\n              <h6 class=\"mb-1\">Total Calls</h6>\n              <h3 class=\"mb-0\"><%= @llm_calls.count %></h3>\n            </div>\n          </div>\n          <div class=\"col-md-4\">\n            <div class=\"alert alert-warning mb-0\">\n              <h6 class=\"mb-1\">Avg Latency</h6>\n              <h3 class=\"mb-0\"><%= @avg_latency %>ms</h3>\n            </div>\n          </div>\n        </div>\n\n        <h6>By Agent Role:</h6>\n        <table class=\"table table-hover\">\n          <thead>\n            <tr>\n              <th>Role</th>\n              <th>Count</th>\n              <th>Success Rate</th>\n              <th>Avg Tokens</th>\n              <th>Total Cost</th>\n            </tr>\n          </thead>\n          <tbody>\n            <% @llm_by_role.each do |role_data| %>\n              <tr>\n                <td><span class=\"badge bg-secondary\"><%= role_data[:role] %></span></td>\n                <td><%= role_data[:count] %></td>\n                <td>\n                  <span class=\"badge bg-<%= role_data[:success_rate] > 85 ? 'success' : (role_data[:success_rate] > 70 ? 'warning' : 'danger') %>\">\n                    <%= role_data[:success_rate] %>%\n                  </span>\n                </td>\n                <td><code><%= role_data[:avg_tokens] %