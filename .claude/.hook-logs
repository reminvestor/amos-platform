rtions(+), 529 deletions(-)\n create mode 100644 .claude/commands/add-entity.md\n delete mode 100644 .claude/commands/build-feature.md\n create mode 100644 .claude/commands/check-deployment.md\n create mode 100644 .claude/commands/complete-feature.md\n create mode 100644 .claude/commands/db-snapshot.md\n create mode 100644 .claude/commands/docker.md\n delete mode 100644 .claude/commands/new-dev-setup.md\n create mode 100644 .claude/commands/prepare-dev-env.md\n delete mode 100644 .claude/commands/quick-commit.md\n create mode 100644 .claude/commands/reset-database.md\n delete mode 100644 .claude/commands/test-feature.md\n create mode 100644 .claude/commands/test-rag.md\n create mode 100644 .claude/commands/validate-skill.md","stderr":"","interrupted":false,"isImage":false}}
