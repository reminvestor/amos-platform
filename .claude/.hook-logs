in-btn admin-btn-outline' do %>\n          <i data-lucide=\"link\"></i>\n          <span>View Connections</span>\n        <% end %>\n        <%= link_to admin_users_path, class: 'admin-btn admin-btn-outline' do %>\n          <i data-lucide=\"users\"></i>\n          <span>Manage Users</span>\n        <% end %>\n        <%= link_to admin_observability_ai_usage_path, class: 'admin-btn admin-btn-outline' do %>\n          <i data-lucide=\"bar-chart-3\"></i>\n          <span>AI Usage Stats</span>\n        <% end %>\n      </div>\n    </div>"},"tool_response":{"filePath":"/home/user/agent_marketing/app/views/admin/dashboard/index.html.erb","oldString":"    <%# Quick Actions %>\n    <div class=\"admin-card\">\n      <h3 class=\"card-title\">Quick Actions</h3>\n      <div style=\"display: flex; gap: 0.75rem; flex-wrap: wrap;\">\n        <%= link_to admin_integrations_path, class: 'admin-btn admin-btn-outline' do %>\n          <i data-lucide=\"plug\"></i>\n          <span>Manage Integrations</span>\n        <% end %>\n        <%= link_to admin_connections_path, class: 'admin-btn admin-btn-outline' do %>\n          <i data-lucide=\"link\"></i>\n          <span>View Connections</span>\n        <% end %>\n        <%= link_to admin_users_path, class: 'admin-btn admin-btn-outline' do %>\n          <i data-lucide=\"users\"></i>\n          <span>Manage Users</span>\n        <% end %>\n        <%= link_to admin_observability_ai_usage_path, class: 'admin-btn admin-btn-outline' do %>\n          <i data-lucide=\"bar-chart-3\"></i>\n          <span>AI Usage Stats</span>\n        <% end %>\n      </div>\n    </div>","newString":"    <%# Quick Actions %>\n    <div class=\"admin-card\">\n      <h3 class=\"card-title\">Quick Actions</h3>\n      <div style=\"display: flex; gap: 0.75rem; flex-wrap: wrap;\">\n        <%= link_to admin_agent_lightning_dashboard_path, class: 'admin-btn admin-btn-outline' do %>\n          <i data-lucide=\"zap\"></i>\n          <span>Agent Lightning</span>\n        <% end %>\n        <%= link_to admin_integrations_path, class: 'admin-btn admin-btn-outline' do %>\n          <i data-lucide=\"plug\"></i>\n          <span>Manage Integrations</span>\n        <% end %>\n        <%= link_to admin_connections_path, class: 'admin-btn admin-btn-outline' do %>\n          <i data-lucide=\"link\"></i>\n          <span>View Connections</span>\n        <% end %>\n        <%= link_to admin_users_path, class: 'admin-btn admin-btn-outline' do %>\n          <i data-lucide=\"users\"></i>\n          <span>Manage Users</span>\n        <% end %>\n        <%= link_to admin_observability_ai_usage_path, class: 'admin-btn admin-btn-outline' do %>\n          <i data-lucide=\"bar-chart-3\"></i>\n          <span>AI Usage Stats</span>\n        <% end %>\n      </div>\n    </div>","originalFile":"<div class=\"admin-content\">\n  <div style=\"padding: 2rem;\">\n    <%# Page Header %>\n    <div class=\"admin-page-header\">\n      <div class=\"header-left\">\n        <div class=\"header-icon\">\n          <i data-lucide=\"layout-dashboard\"></i>\n        </div>\n        <div class=\"header-text\">\n          <h1>Admin Dashboard</h1>\n          <p>Monitor platform activity and system health</p>\n        </div>\n      </div>\n    </div>\n\n    <%# Stats Cards %>\n    <div style=\"display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1.5rem; margin-bottom: 2rem;\">\n      <%# Total Users %>\n      <div class=\"admin-card\">\n        <div style=\"display: flex; align-items: center; gap: 1rem;\">\n          <div style=\"width: 3rem; height: 3rem; border-radius: 0.75rem; background: linear-gradient(135deg, #7C3AED 0%, #A78BFA 100%); display: flex; align-items: center; justify-content: center;\">\n            <i data-lucide=\"users\" class=\"icon-xl text-white\"></i>\n          </div>\n          <div>\n            <p style=\"color: #94A3B8; font-size: 0.875rem; margin: 0;\">Total Users</p>\n            <h3 style=\"color: white; font-size: 1.875rem; font-weight: 600; margin: 0;\"><%= @stats[:total_users] %></h3>\n            <small style=\"color: #64748B; font-size: 0.75rem;\">Active accounts</small>\n          </div>\n        </div>\n      </div>\n\n      <%# Integrations %>\n      <div class=\"admin-card\">\n        <div style=\"display: flex; align-items: center; gap: 1rem;\">\n          <div style=\"width: 3rem; height: 3rem; border-radius: 0.75rem; background: rgba(34, 211, 238, 0.1); display: flex; align-items: center; justify-content: center; border: 1px solid rgba(34, 211, 238, 0.2);\">\n            <i data-lucide=\"plug\" class=\"icon-xl text-info\"></i>\n          </div>\n          <div>\n            <p style=\"color: #94A3B8; font-size: 0.875rem; margin: 0;\">Integrations</p>\n            <h3 style=\"color: white; font-size: 1.875rem; font-weight: 600; margin: 0;\"><%= @stats[:total_integrations] %></h3>\n            <small style=\"color: #64748B; font-size: 0.75rem;\">Available integrations</small>\n          </div>\n        </div>\n      </div>\n\n      <%# Active Connections %>\n      <div class=\"admin-card\">\n        <div style=\"display: flex; align-items: center; gap: 1rem;\">\n          <div style=\"width: 3rem; height: 3rem; border-radius: 0.75rem; background: rgba(34, 197, 94, 0.1); display: flex; align-items: center; justify-content: center; border: 1px solid rgba(34, 197, 94, 0.2);\">\n            <i data-lucide=\"link\" class=\"icon-xl text-success\"></i>\n          </div>\n          <div>\n            <p style=\"color: #94A3B8; font-size: 0.875rem; margin: 0;\">Active Connections</p>\n            <h3 style=\"color: white; font-size: 1.875rem; font-weight: 600; margin: 0;\"><%= @stats[:active_connections] %></h3>\n            <small style=\"<%= @stats[:failed_connections] > 0 ? 'color: rgb(248, 113, 113);' : 'color: #64748B;' %> font-size: 0.75rem;\">\n              <% if @stats[:failed_connections] > 0 %>\n                <%= @stats[:failed_connections] %> failing\n              <% else %>\n                All healthy\n              <% end %>\n            </small>\n          </div>\n        </div>\n      </div>\n\n      <%# API Calls Today %>\n      <div class=\"admin-card\">\n        <div style=\"display: flex; align-items: center; gap: 1rem;\">\n          <div style=\"width: 3rem; height: 3rem; border-radius: 0.75rem; background: rgba(251, 191, 36, 0.1); display: flex; align-items: center; justify-content: center; border: 1px solid rgba(251, 191, 36, 0.2);\">\n            <i data-lucide=\"activity\" style=\"width: 1.5rem; height: 1.5rem; color: rgb(252, 211, 77);\"></i>\n          </div>\n          <div>\n            <p style=\"color: #94A3B8; font-size: 0.875rem; margin: 0;\">API Calls Today</p>\n            <h3 style=\"color: white; font-size: 1.875rem; font-weight: 600; margin: 0;\"><%= number_with_delimiter(@stats[:api_calls_today]) %></h3>\n            <small style=\"color: #64748B; font-size: 0.75rem;\">External API calls</small>\n          </div>\n        </div>\n      </div>\n    </div>\n\n    <%# Two Column Layout %>\n    <div style=\"display: grid; grid-template-columns: repeat(auto-fit, minmax(400px, 1fr)); gap: 1.5rem; margin-bottom: 2rem;\">\n      <%# Integration Health %>\n      <div class=\"admin-card\">\n        <h3 class=\"card-title\">Integration Health</h3>\n        <% if @failing_connections.any? %>\n          <div style=\"display: flex; flex-direction: column; gap: 0.75rem;\">\n            <% @failing_connections.each do |connection| %>\n              <div style=\"padding: 0.75rem; background: #0F172A; border: 1px solid #1E293B; border-radius: 0.5rem; display: flex; justify-content: space-between; align-items: center;\">\n                <div>\n                  <h6 style=\"color: white; margin: 0 0 0.25rem 0; font-weight: 600;\"><%= connection.name %></h6>\n                  <small style=\"color: #94A3B8; font-size: 0.875rem;\">\n                    <%= connection.integration.name %> - <%= connection.entity.name %>\n                  </small>\n                </div>\n                <span class=\"admin-badge admin-badge-offline\">FAILING</span>\n              </div>\n            <% end %>\n          </div>\n        <% else %>\n          <div class=\"admin-empty-state\" style=\"padding: 2rem;\">\n            <div class=\"empty-icon\" style=\"width: 3rem; height: 3rem; margin: 0 auto 1rem;\">\n              <i data-lucide=\"check-circle\"></i>\n            </div>\n            <p class=\"empty-title\" style=\"margin-bottom: 0;\">All connections are healthy</p>\n          </div>\n        <% end %>\n      </div>\n\n      <%# Recent Activity %>\n      <div class=\"admin-card\">\n        <h3 class=\"card-title\">Recent Activity</h3>\n        <% if @recent_admin_activity.any? %>\n          <div style=\"display: flex; flex-direction: column; gap: 0.75rem;\">\n            <% @recent_admin_activity.each do |activity| %>\n              <div style=\"padding: 0.75rem; background: #0F172A; border: 1px solid #1E293B; border-radius: 0.5rem;\">\n                <div style=\"display: flex; justify-content: space-between; align-items-start; margin-bottom: 0.25rem;\">\n                  <h6 style=\"color: white; margin: 0; font-weight: 600;\"><%= activity.action.humanize %></h6>\n                  <small style=\"color: #94A3B8; font-size: 0.875rem;\"><%= time_ago_in_words(activity.created_at) %> ago</small>\n                </div>\n                <small style=\"color: #94A3B8; font-size: 0.875rem;\">\n                  by <%= activity.admin_user.full_name %>\n                </small>\n              </div>\n            <% end %>\n          </div>\n        <% else %>\n          <div class=\"admin-empty-state\" style=\"padding: 2rem;\">\n            <div class=\"empty-icon\" style=\"width: 3rem; height: 3rem; margin: 0 auto 1rem;\">\n              <i data-lucide=\"clock\"></i>\n            </div>\n            <p class=\"empty-title\" style=\"margin-bottom: 0;\">No recent activity</p>\n          </div>\n        <% end %>\n      </div>\n    </div>\n\n    <%# Quick Actions %>\n    <div class=\"admin-card\">\n      <h3 class=\"card-title\">Quick Actions</h3>\n      <div style=\"display: flex; gap: 0.75rem; flex-wrap: wrap;\">\n        <%= link_to admin_integrations_path, class: 'admin-btn admin-btn-outline' do %>\n          <i data-lucide=\"plug\"></i>\n          <span>Manage Integrations</span>\n        <% end %>\n        <%= link_to admin_connections_path, class: 'admin-btn admin-btn-outline' do %>\n          <i data-lucide=\"link\"></i>\n          <span>View Connections</span>\n        <% end %>\n        <%= link_to admin_users_path, class: 'admin-btn admin-btn-outline' do %>\n          <i data-lucide=\"users\"></i>\n          <span>Manage Users</span>\n        <% end %>\n        <%= link_to admin_observability_ai_usage_path, class: 'admin-btn admin-btn-outline' do %>\n          <i data-lucide=\"bar-chart-3\"></i>\n          <span>AI Usage Stats</span>\n        <% end %>\n      </div>\n    </div>\n  </div>\n</div>\n\n<script>\n  document.addEventListener('turbo:load', () => {\n    lucide.createIcons();\n  });\n\n  document.addEventListener('DOMContentLoaded', () => {\n    lucide.createIcons();\n  });\n</script>\n","structuredPatch":[{"oldStart":139,"oldLines":6,"newStart":139,"newLines":10,"lines":["     <div class=\"admin-card\">","       <h3 class=\"card-title\">Quick Actions</h3>","       <div style=\"display: flex; gap: 0.75rem; flex-wrap: wrap;\">","+        <%= link_to admin_agent_lightning_dashboard_path, class: 'admin-btn admin-btn-outline' do %>","+          <i data-lucide=\"zap\"></i>","+          <span>Agent Lightning</span>","+        <% end %>","         <%= link_to admin_integrations_path, class: 'admin-btn admin-btn-outline' do %>","           <i data-lucide=\"plug\"></i>","           <span>Manage Integrations</span>"]}],"userModified":false,"replaceAll":false}}
