;\\n\\n  // Poll immediately on first load\\n  (async () => {\\n    try {\\n      const response = await fetch(`/scout/document-status/${assetId}`);\\n      if (response.ok) {\\n        const status = await response.json();\\n        displayStatusUI(status, statusContainer);\\n      }\\n    } catch (error) {\\n      console.error('Error fetching initial status:', error);\\n    }\\n  })();\\n}\\n\\nfunction displayStatusUI(status, container) {\\n  if (!status) return;\\n\\n  let html = '';\\n\\n  // Hide status if document is ready or has no processing\\n  if (status.ready_for_chat) {\\n    container.innerHTML = '';\\n    return;\\n  }\\n\\n  if (status.status === 'pending') {\\n    html = `\\n      <div class=\\\"alert alert-info\\\" role=\\\"alert\\\">\\n        <i data-lucide=\\\"clock\\\" class=\\\"me-2\\\" aria-hidden=\\\"true\\\"></i>\\n        <strong>Preparing document...</strong><br>\\n        <small>This document hasn't been indexed yet. It will be ready for chat once processing completes.</small>\\n      </div>\\n    `;\\n  } else if (status.status.includes('failed')) {\\n    const errorMsg = status.error ? ` ${status.error}` : '';\\n    html = `\\n      <div class=\\\"alert alert-danger\\\" role=\\\"alert\\\">\\n        <i data-lucide=\\\"alert-circle\\\" class=\\\"me-2\\\" aria-hidden=\\\"true\\\"></i>\\n        <strong>Processing Failed</strong><br>\\n        <small>${status.message}.${errorMsg}</small>\\n      </div>\\n    `;\\n  } else {\\n    const progressPercent = status.progress_percent || Math.round((status.stage / status.total_stages) * 100);\\n    const stageIcon = getStageIcon(status.stage);\\n\\n    html = `\\n      <div class=\\\"card border-info\\\">\\n        <div class=\\\"card-body\\\">\\n          <div class=\\\"d-flex align-items-center mb-2\\\">\\n            ${stageIcon}\\n            <strong>${status.message}</strong>\\n          </div>\\n          <div class=\\\"progress\\\" style=\\\"height: 24px;\\\">\\n            <div class=\\\