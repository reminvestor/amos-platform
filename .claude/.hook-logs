tatus == 'failed'\n  end\n\n  def mark_success\n    update!(status: 'success', completed_at: Time.current)\n  end\n\n  def mark_failed(error_msg = nil)\n    update!(\n      status: 'failed',\n      completed_at: Time.current,\n      error_message: error_msg\n    )\n  end\nend\n","structuredPatch":[]}}
