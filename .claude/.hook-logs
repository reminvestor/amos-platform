] %>%\n                  </span>\n                </td>\n                <td><code><%= tool[:avg_time] %>ms</code></td>\n              </tr>\n            <% end %>\n          </tbody>\n        </table>\n      </div>\n    </div>\n  <% end %>\n</div>\n"},"tool_response":{"type":"create","filePath":"/home/user/agent_marketing/app/views/admin/agent_lightning/metrics.html.erb","content":"<div class=\"container-fluid py-4\">\n  <div class=\"row mb-4\">\n    <div class=\"col-md-8\">\n      <h1>📊 Agent Lightning Metrics</h1>\n      <p class=\"text-muted\"><%= @entity.name %> (Last <%= @days %> days)</p>\n    </div>\n    <div class=\"col-md-4 text-end\">\n      <% [7, 30, 60, 90].each do |days| %>\n        <% if days == @days %>\n          <span class=\"badge bg-primary\"><%= days %> days</span>\n        <% else %>\n          <%= link_to days.to_s + \" days\", admin_agent_lightning_metrics_path(days: days), class: \"btn btn-sm btn-outline-secondary\" %>\n        <% end %>\n      <% end %>\n      <%= link_to \"← Back\", admin_agent_lightning_dashboard_path, class: \"btn btn-outline-secondary\" %>\n    </div>\n  </div>\n\n  <!-- Overall Statistics -->\n  <div class=\"card mb-4\">\n    <div class=\"card-header bg-light\">\n      <h5 class=\"mb-0\">📈 Overall Statistics</h5>\n    </div>\n    <div class=\"card-body\">\n      <div class=\"row\">\n        <div class=\"col-md-3\">\n          <div class=\"alert alert-info mb-0\">\n            <h6 class=\"mb-1\">Total Traces</h6>\n            <h3 class=\"mb-0\"><%= @total_traces %></h3>\n          </div>\n        </div>\n        <div class=\"col-md-3\">\n          <div class=\"alert alert-success mb-0\">\n            <h6 class=\"mb-1\">Success Rate</h6>\n            <h3 class=\"mb-0\"><%= @success_rate %>%</h3>\n          </div>\n        </div>\n        <div class=\"col-md-3\">\n          <div class=\"alert alert-warning mb-0\">\n            <h6 class=\"mb-1\">Avg Reward</h6>\n            <h3 class=\"mb-0\"><%= @avg_reward %></h3>\n   