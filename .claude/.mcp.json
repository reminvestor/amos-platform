{
  "mcpServers": {
    "github": {
      "type": "http",
      "url": "https://api.githubcopilot.com/mcp/"
    },
    "playwright": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "@playwright/mcp@latest"
      ],
      "env": {}
    }
  },
  "approval-client": {
    "type": "stdio",
    "command": "node",
    "args": ["/Users/ryan/Documents/Prompt Monitor/approval-mcp-server/mcp-client.js"],
    "env": {
      "CLIENT_NAME": "SmileWise Approval Client",
      "APPROVAL_SERVICE_URL": "http://localhost:3000"
    }
  },
  "memory": {
    "type": "stdio",
    "command": "npx",
    "args": ["-y", "@modelcontextprotocol/server-memory"],
    "env": {}
  },
  "sequential-thinking": {
    "type": "stdio",
    "command": "npx",
    "args": ["-y", "@modelcontextprotocol/server-sequential-thinking"],
    "env": {}
  }
}
