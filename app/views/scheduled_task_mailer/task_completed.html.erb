<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <style>
    body {
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
      line-height: 1.6;
      color: #1a1a2e;
      background-color: #f8f9fa;
      margin: 0;
      padding: 0;
    }
    .container {
      max-width: 600px;
      margin: 0 auto;
      padding: 20px;
    }
    .card {
      background: #ffffff;
      border-radius: 12px;
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
      padding: 24px;
      margin-bottom: 20px;
    }
    .header {
      text-align: center;
      padding-bottom: 20px;
      border-bottom: 1px solid #eee;
      margin-bottom: 20px;
    }
    .header h1 {
      margin: 0;
      color: #10b981;
      font-size: 24px;
    }
    .task-name {
      font-size: 20px;
      font-weight: 600;
      color: #1a1a2e;
      margin: 8px 0;
    }
    .meta {
      color: #6b7280;
      font-size: 14px;
    }
    .content-section {
      background: #f8f9fa;
      border-radius: 8px;
      padding: 16px;
      margin: 16px 0;
    }
    .content-section h3 {
      margin: 0 0 12px 0;
      font-size: 14px;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      color: #6b7280;
    }
    .result-content {
      white-space: pre-wrap;
      font-size: 14px;
      line-height: 1.7;
      color: #374151;
    }
    .tools-used {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      margin-top: 8px;
    }
    .tool-badge {
      display: inline-block;
      background: #e0e7ff;
      color: #4f46e5;
      padding: 4px 10px;
      border-radius: 16px;
      font-size: 12px;
      font-weight: 500;
    }
    .stats {
      display: flex;
      justify-content: space-around;
      text-align: center;
      padding: 16px 0;
      border-top: 1px solid #eee;
      margin-top: 16px;
    }
    .stat-item {
      flex: 1;
    }
    .stat-value {
      font-size: 20px;
      font-weight: 600;
      color: #1a1a2e;
    }
    .stat-label {
      font-size: 12px;
      color: #6b7280;
      text-transform: uppercase;
    }
    .footer {
      text-align: center;
      padding: 20px;
      color: #9ca3af;
      font-size: 12px;
    }
    .btn {
      display: inline-block;
      background: #7c3aed;
      color: #ffffff !important;
      padding: 12px 24px;
      border-radius: 8px;
      text-decoration: none;
      font-weight: 500;
      margin-top: 16px;
    }
    .btn:hover {
      background: #6d28d9;
    }
  </style>
</head>
<body>
  <div class="container">
    <div class="card">
      <div class="header">
        <h1>✅ Task Completed</h1>
        <div class="task-name"><%= @task.name %></div>
        <div class="meta">
          <%= @task.task_type_info[:name] rescue @task.task_type.titleize %> • 
          Completed <%= time_ago_in_words(@run.completed_at) %> ago
        </div>
      </div>
      
      <div class="content-section">
        <h3>📋 Summary</h3>
        <div class="result-content"><%= @summary %></div>
      </div>
      
      <% if @content.present? %>
        <div class="content-section">
          <h3>📄 Full Result</h3>
          <div class="result-content"><%= truncate(@content, length: 2000) %></div>
        </div>
      <% end %>
      
      <% if @tools_used.any? %>
        <div class="content-section">
          <h3>🔧 Tools Used</h3>
          <div class="tools-used">
            <% @tools_used.each do |tool| %>
              <span class="tool-badge"><%= tool %></span>
            <% end %>
          </div>
        </div>
      <% end %>
      
      <div class="stats">
        <div class="stat-item">
          <div class="stat-value"><%= @task.run_count %></div>
          <div class="stat-label">Total Runs</div>
        </div>
        <div class="stat-item">
          <div class="stat-value"><%= @execution_time ? "#{@execution_time}ms" : '-' %></div>
          <div class="stat-label">Execution Time</div>
        </div>
        <div class="stat-item">
          <div class="stat-value"><%= @task.failure_count %></div>
          <div class="stat-label">Failures</div>
        </div>
      </div>
      
      <div style="text-align: center;">
        <a href="<%= root_url %>scout?view=scheduled_tasks" class="btn">View Task Details</a>
      </div>
    </div>
    
    <div class="footer">
      <p>This email was sent because you have a scheduled task configured to send results via email.</p>
      <p><%= @entity.name %> • Powered by AMOS</p>
    </div>
  </div>
</body>
</html>

