<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <style>
    body {
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
      line-height: 1.6;
      color: #1a1a2e;
      background-color: #f8f9fa;
      margin: 0;
      padding: 0;
    }
    .container {
      max-width: 600px;
      margin: 0 auto;
      padding: 20px;
    }
    .card {
      background: #ffffff;
      border-radius: 12px;
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
      padding: 24px;
      margin-bottom: 20px;
    }
    .header {
      text-align: center;
      padding-bottom: 20px;
      border-bottom: 1px solid #eee;
      margin-bottom: 20px;
    }
    .header h1 {
      margin: 0;
      color: #ef4444;
      font-size: 24px;
    }
    .task-name {
      font-size: 20px;
      font-weight: 600;
      color: #1a1a2e;
      margin: 8px 0;
    }
    .meta {
      color: #6b7280;
      font-size: 14px;
    }
    .alert-box {
      background: #fef2f2;
      border: 1px solid #fecaca;
      border-radius: 8px;
      padding: 16px;
      margin: 16px 0;
    }
    .alert-box.warning {
      background: #fffbeb;
      border-color: #fcd34d;
    }
    .alert-title {
      font-weight: 600;
      color: #991b1b;
      margin-bottom: 8px;
    }
    .alert-box.warning .alert-title {
      color: #92400e;
    }
    .error-message {
      font-family: 'SF Mono', Monaco, monospace;
      font-size: 13px;
      color: #7f1d1d;
      white-space: pre-wrap;
      word-break: break-word;
    }
    .stats {
      display: flex;
      justify-content: space-around;
      text-align: center;
      padding: 16px 0;
      border-top: 1px solid #eee;
      margin-top: 16px;
    }
    .stat-item {
      flex: 1;
    }
    .stat-value {
      font-size: 20px;
      font-weight: 600;
      color: #1a1a2e;
    }
    .stat-value.danger {
      color: #ef4444;
    }
    .stat-label {
      font-size: 12px;
      color: #6b7280;
      text-transform: uppercase;
    }
    .footer {
      text-align: center;
      padding: 20px;
      color: #9ca3af;
      font-size: 12px;
    }
    .btn {
      display: inline-block;
      background: #7c3aed;
      color: #ffffff !important;
      padding: 12px 24px;
      border-radius: 8px;
      text-decoration: none;
      font-weight: 500;
      margin: 8px;
    }
    .btn.secondary {
      background: #6b7280;
    }
  </style>
</head>
<body>
  <div class="container">
    <div class="card">
      <div class="header">
        <h1>❌ Task Failed</h1>
        <div class="task-name"><%= @task.name %></div>
        <div class="meta">
          <%= @task.task_type_info[:name] rescue @task.task_type.titleize %> • 
          Failed <%= time_ago_in_words(@run.completed_at || Time.current) %> ago
        </div>
      </div>
      
      <div class="alert-box">
        <div class="alert-title">⚠️ Error Details</div>
        <div class="error-message"><%= @error_message %></div>
      </div>
      
      <% if @is_paused %>
        <div class="alert-box warning">
          <div class="alert-title">⏸️ Task Auto-Paused</div>
          <p style="margin: 0; color: #92400e;">
            This task has been automatically paused after <%= @consecutive_failures %> consecutive failures.
            Please review the error and resume the task when ready.
          </p>
        </div>
      <% end %>
      
      <div class="stats">
        <div class="stat-item">
          <div class="stat-value"><%= @task.run_count %></div>
          <div class="stat-label">Total Runs</div>
        </div>
        <div class="stat-item">
          <div class="stat-value danger"><%= @consecutive_failures %></div>
          <div class="stat-label">Consecutive Failures</div>
        </div>
        <div class="stat-item">
          <div class="stat-value danger"><%= @task.failure_count %></div>
          <div class="stat-label">Total Failures</div>
        </div>
      </div>
      
      <div style="text-align: center;">
        <a href="<%= @base_url %>/scout?view=scheduled_tasks" class="btn">View Task Details</a>
        <% if @is_paused %>
          <a href="<%= @base_url %>/scout" class="btn secondary">Resume Task</a>
        <% end %>
      </div>
    </div>
    
    <div class="footer">
      <p>This email was sent because your scheduled task encountered an error.</p>
      <p><%= @entity.name %> • Powered by AMOS</p>
    </div>
  </div>
</body>
</html>

