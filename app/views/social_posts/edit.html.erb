<div class="admin-content" style="padding: 2rem;">
  <div class="container-fluid">
    <%# Page Header %>
    <div class="admin-page-header" style="margin-bottom: 2rem;">
      <div class="header-left">
        <div class="header-icon" style="background: linear-gradient(135deg, #A78BFA 0%, #7C3AED 100%);">
          <i data-lucide="share-2"></i>
        </div>
        <div class="header-text">
          <h1>Edit Social Media Post</h1>
          <p><%= @social_post.title.presence || "Untitled Post" %></p>
        </div>
      </div>
      <div class="header-actions">
        <%= link_to social_posts_path, class: "admin-btn admin-btn-outline" do %>
          <i data-lucide="arrow-left"></i>
          <span>Back</span>
        <% end %>
      </div>
    </div>

    <div class="row">
      <%# Main Form Column %>
      <div class="col-lg-8 col-xl-9">
        <div class="admin-card">
          <%= render 'form', social_post: @social_post %>
        </div>
      </div>

      <%# Info Sidebar %>
      <div class="col-lg-4 col-xl-3">
        <div class="admin-card">
          <h5 style="color: white; font-weight: 600; margin-bottom: 1.5rem; display: flex; align-items: center; gap: 0.5rem;">
            <i data-lucide="info" style="width: 1.25rem; height: 1.25rem; color: #A78BFA;"></i>
            <span>Post Info</span>
          </h5>

          <div style="margin-bottom: 1rem;">
            <p style="color: #94A3B8; font-size: 0.875rem; margin-bottom: 0.25rem;">Status</p>
            <% if @social_post.status == 'published' %>
              <span class="admin-badge admin-badge-online">Published</span>
            <% elsif @social_post.status == 'scheduled' %>
              <span class="admin-badge admin-badge-warning">Scheduled</span>
            <% else %>
              <span class="admin-badge admin-badge-default">Draft</span>
            <% end %>
          </div>

          <div style="margin-bottom: 1rem;">
            <p style="color: #94A3B8; font-size: 0.875rem; margin-bottom: 0.25rem;">Platform</p>
            <p style="color: white; font-size: 0.875rem; margin: 0;">
              <%= @social_post.platform.present? ? @social_post.platform.titleize : "Not selected" %>
            </p>
          </div>

          <% if @social_post.scheduled_at.present? %>
            <div style="margin-bottom: 1rem; padding-bottom: 1rem; border-bottom: 1px solid #334155;">
              <p style="color: #94A3B8; font-size: 0.875rem; margin-bottom: 0.25rem;">Scheduled For</p>
              <p style="color: white; font-size: 0.875rem; margin: 0;">
                <%= @social_post.scheduled_at.strftime("%B %d, %Y at %I:%M %p") %>
              </p>
            </div>
          <% end %>

          <div style="margin-bottom: 0;">
            <p style="color: #94A3B8; font-size: 0.875rem; margin-bottom: 0.25rem;">Last Updated</p>
            <p style="color: white; font-size: 0.875rem; margin: 0;">
              <%= @social_post.updated_at.strftime("%B %d, %Y at %I:%M %p") %>
            </p>
          </div>
        </div>

        <div class="admin-card" style="margin-top: 1.5rem;">
          <h5 style="color: white; font-weight: 600; margin-bottom: 1rem; display: flex; align-items: center; gap: 0.5rem;">
            <i data-lucide="lightbulb" style="width: 1.25rem; height: 1.25rem; color: #FACC15;"></i>
            <span>Platform Guidelines</span>
          </h5>
          <ul style="color: #94A3B8; font-size: 0.875rem; line-height: 1.8; padding-left: 1.25rem; margin: 0;">
            <li><strong style="color: white;">Twitter:</strong> 280 char max</li>
            <li><strong style="color: white;">Instagram:</strong> Image required</li>
            <li><strong style="color: white;">Facebook:</strong> 63,206 char max</li>
            <li><strong style="color: white;">LinkedIn:</strong> 3,000 char max</li>
          </ul>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  document.addEventListener('turbo:load', () => {
    if (typeof lucide !== 'undefined') {
      lucide.createIcons();
    }
  });

  document.addEventListener('DOMContentLoaded', () => {
    if (typeof lucide !== 'undefined') {
      lucide.createIcons();
    }
  });
</script>
