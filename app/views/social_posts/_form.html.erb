<%= form_with(model: social_post, local: true) do |f| %>
  <%# Error Messages %>
  <% if social_post.errors.any? %>
    <div class="alert alert-danger" style="background-color: var(--status-error-bg); border-color: var(--status-error-border); color: var(--status-error-text); margin-bottom: 1.5rem;">
      <h5 style="margin-bottom: 0.5rem;">
        <i data-lucide="alert-circle" class="icon-md"></i>
        <%= pluralize(social_post.errors.count, "error") %> prohibited this post from being saved:
      </h5>
      <ul style="margin-bottom: 0;">
        <% social_post.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%# Post Title %>
  <div style="margin-bottom: 1.5rem;">
    <%= f.label :title, "Post Title", style: "display: block; color: white; font-weight: 600; margin-bottom: 0.5rem;" %>
    <%= f.text_field :title, class: 'form-control', placeholder: "e.g., Summer Sale Announcement",
        style: "background-color: #1E293B; border: 1px solid #334155; color: white; padding: 0.75rem; border-radius: 0.5rem;" %>
    <small style="color: #64748B; font-size: 0.875rem; display: block; margin-top: 0.5rem;">
      Internal title for your reference (not posted publicly)
    </small>
  </div>

  <%# Platform Selection %>
  <div style="margin-bottom: 1.5rem;">
    <%= f.label :platform, "Social Media Platform", style: "display: block; color: white; font-weight: 600; margin-bottom: 0.5rem;" %>
    <%= f.select :platform,
                options_for_select([
                  ['Facebook', 'facebook'],
                  ['Instagram', 'instagram'],
                  ['LinkedIn', 'linkedin'],
                  ['Twitter', 'twitter']
                ], social_post.platform),
                { include_blank: 'Select a platform' },
                class: 'form-select',
                id: 'platform-select',
                data: { controller: 'social-post', action: 'change->social-post#toggleImageField' },
                style: "background-color: #1E293B; border: 1px solid #334155; color: white; padding: 0.75rem; border-radius: 0.5rem;" %>
  </div>

  <%# Post Content %>
  <div style="margin-bottom: 1.5rem;">
    <%= f.label :content, "Post Content", style: "display: block; color: white; font-weight: 600; margin-bottom: 0.5rem;" %>
    <div class="input-group">
      <%= f.text_area :content, class: 'form-control', rows: 5, id: 'content-textarea', placeholder: "Write your social media post content...",
          style: "background-color: #1E293B; border: 1px solid #334155; color: white; padding: 0.75rem; border-radius: 0.5rem 0 0 0.5rem;" %>
      <button type="button" class="admin-btn admin-btn-primary" id="generate-ai-content-btn" data-bs-toggle="modal" data-bs-target="#aiContentModal" style="border-radius: 0 0.5rem 0.5rem 0;">
        <i data-lucide="bot"></i>
        <span>Generate with AI</span>
      </button>
    </div>
  </div>

  <%# Image URL %>
  <div style="margin-bottom: 1.5rem;">
    <%= f.label :image_url, 'Image URL', style: "display: block; color: white; font-weight: 600; margin-bottom: 0.5rem;" %>
    <%= f.text_field :image_url, class: 'form-control', placeholder: 'Enter a URL to an image',
        style: "background-color: #1E293B; border: 1px solid #334155; color: white; padding: 0.75rem; border-radius: 0.5rem;" %>
    <small style="color: #64748B; font-size: 0.875rem; display: block; margin-top: 0.5rem;">
      Required for Instagram posts. Optional for other platforms.
    </small>
  </div>

  <%# Status Selection %>
  <div style="margin-bottom: 1.5rem;">
    <%= f.label :status, "Post Status", style: "display: block; color: white; font-weight: 600; margin-bottom: 0.5rem;" %>
    <%= f.select :status,
                options_for_select([
                  ['Draft', 'draft'],
                  ['Scheduled', 'scheduled']
                ], social_post.status),
                {},
                class: 'form-select',
                id: 'status-select',
                data: { controller: 'social-post', action: 'change->social-post#toggleScheduledAtField' },
                style: "background-color: #1E293B; border: 1px solid #334155; color: white; padding: 0.75rem; border-radius: 0.5rem;" %>
  </div>

  <%# Scheduled At (Conditional) %>
  <div class="scheduled-at-field" style="margin-bottom: 1.5rem; display: <%= social_post.status == 'scheduled' ? 'block' : 'none' %>;">
    <%= f.label :scheduled_at, "Scheduled Date & Time", style: "display: block; color: white; font-weight: 600; margin-bottom: 0.5rem;" %>
    <%= f.datetime_local_field :scheduled_at, class: 'form-control',
        style: "background-color: #1E293B; border: 1px solid #334155; color: white; padding: 0.75rem; border-radius: 0.5rem;" %>
  </div>

  <%# Posting Options %>
  <div style="margin-bottom: 1.5rem;">
    <label style="display: block; color: white; font-weight: 600; margin-bottom: 0.75rem;">Posting Options</label>
    <div style="background-color: #1E293B; border: 1px solid #334155; border-radius: 0.5rem; padding: 1.5rem;">
      <div style="margin-bottom: 1rem;">
        <div class="form-check">
          <%= check_box_tag :publish_now, true, false, class: 'form-check-input', id: 'publish-now-check', style: "background-color: #0F172A; border-color: #334155;" %>
          <%= label_tag :publish_now, 'Publish immediately after saving', class: 'form-check-label', style: "color: white; margin-left: 0.5rem;" %>
        </div>
      </div>

      <hr style="border-color: #334155; margin: 1rem 0;">

      <div>
        <label style="display: block; color: white; font-weight: 600; margin-bottom: 0.75rem;">Post directly to connected accounts:</label>

        <% if current_user.connected_social_accounts.any? %>
          <div class="row">
            <% current_user.connected_social_accounts.each do |account| %>
              <div class="col-md-6" style="margin-bottom: 0.75rem;">
                <div class="form-check">
                  <%= check_box_tag "post_to_accounts[]", account.id, false, class: 'form-check-input', id: "post-to-#{account.platform}-#{account.id}", style: "background-color: #0F172A; border-color: #334155;" %>
                  <label class="form-check-label" for="post-to-<%= account.platform %>-<%= account.id %>" style="color: white; margin-left: 0.5rem;">
                    <i data-lucide="<%= account.platform == 'twitter' ? 'twitter' : account.platform == 'facebook' ? 'facebook' : account.platform == 'instagram' ? 'instagram' : 'linkedin' %>" style="width: 1rem; height: 1rem; display: inline-block; vertical-align: middle; margin-right: 0.25rem;"></i>
                    <%= account.platform.titleize %> (<%= account.username %>)
                  </label>
                </div>
              </div>
            <% end %>
          </div>
        <% else %>
          <div style="padding: 0.75rem; background-color: rgba(34, 211, 238, 0.1); border: 1px solid rgba(34, 211, 238, 0.2); border-radius: 0.5rem;">
            <div style="display: flex; align-items-start; gap: 0.75rem;">
              <i data-lucide="info" style="width: 1.25rem; height: 1.25rem; color: #22D3EE; flex-shrink: 0; margin-top: 0.125rem;"></i>
              <p style="color: #94A3B8; font-size: 0.875rem; margin: 0;">
                No connected social media accounts found.
                <%= link_to "Connect accounts", social_media_accounts_path, style: "color: #22D3EE; text-decoration: underline;" %> to post directly.
              </p>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  </div>

  <%# Action Buttons %>
  <div style="display: flex; gap: 0.75rem; padding-top: 1rem; border-top: 1px solid #334155;">
    <%= f.submit "Save Post", class: 'admin-btn admin-btn-primary' %>
    <%= link_to social_posts_path, class: 'admin-btn admin-btn-outline' do %>
      <i data-lucide="x"></i>
      <span>Cancel</span>
    <% end %>
  </div>
<% end %>

<%# AI Content Generation Modal %>
<div class="modal fade" id="aiContentModal" tabindex="-1" aria-labelledby="aiContentModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-lg">
    <div class="modal-content" style="background-color: #1E293B; border: 1px solid #334155;">
      <div class="modal-header" style="border-bottom: 1px solid #334155;">
        <h5 class="modal-title" id="aiContentModalLabel" style="color: white;">
          <i data-lucide="bot" style="width: 1.25rem; height: 1.25rem; display: inline-block; vertical-align: middle; margin-right: 0.5rem;"></i>
          Generate AI Content
        </h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <div style="margin-bottom: 1.5rem;">
          <label for="content-purpose" style="display: block; color: white; font-weight: 600; margin-bottom: 0.5rem;">What is the purpose of this post?</label>
          <textarea class="form-control" id="content-purpose" rows="3" placeholder="E.g., Announce a new product, share a company milestone, promote an event..."
              style="background-color: #0F172A; border: 1px solid #334155; color: white; padding: 0.75rem; border-radius: 0.5rem;"></textarea>
          <small style="color: #64748B; font-size: 0.875rem; display: block; margin-top: 0.5rem;">
            Describe what you want to accomplish with this post to get better AI suggestions.
          </small>
        </div>

        <div style="margin-bottom: 1.5rem;">
          <a href="<%= chat_mode_path %>" target="_blank" style="color: #22D3EE; text-decoration: none; font-size: 0.875rem;">
            <i data-lucide="settings" style="width: 1rem; height: 1rem; display: inline-block; vertical-align: middle; margin-right: 0.25rem;"></i>
            Update your business profile to improve AI suggestions
          </a>
        </div>

        <div id="ai-content-loading" class="text-center d-none" style="padding: 3rem 0;">
          <div class="spinner-border text-primary" role="status" style="color: #A78BFA !important;">
            <span class="visually-hidden">Loading...</span>
          </div>
          <p style="color: #94A3B8; margin-top: 1rem;">Generating the perfect content for your business...</p>
        </div>

        <div id="ai-content-result" class="d-none">
          <div style="margin-bottom: 1rem;">
            <label style="display: block; color: white; font-weight: 600; margin-bottom: 0.5rem;">Generated Content</label>
            <div style="background-color: #0F172A; border: 1px solid #334155; border-radius: 0.5rem; padding: 1rem;" id="ai-content-preview"></div>
          </div>

          <div style="margin-bottom: 1rem;">
            <a href="#" style="color: #22D3EE; text-decoration: none; font-size: 0.875rem;" id="regenerate-content-btn">
              <i data-lucide="refresh-cw" style="width: 1rem; height: 1rem; display: inline-block; vertical-align: middle; margin-right: 0.25rem;"></i>
              Generate Another Version
            </a>
          </div>
        </div>

        <div id="ai-content-error" class="alert alert-danger d-none" style="background-color: var(--status-error-bg); border-color: var(--status-error-border); color: var(--status-error-text);">
          <p style="margin: 0;">An error occurred while generating content. Please try again.</p>
        </div>
      </div>
      <div class="modal-footer" style="border-top: 1px solid #334155;">
        <button type="button" class="admin-btn admin-btn-outline" data-bs-dismiss="modal">Cancel</button>
        <button type="button" class="admin-btn admin-btn-primary" id="use-ai-content-btn" disabled>Use This Content</button>
      </div>
    </div>
  </div>
</div>

<% content_for :javascript do %>
  <script>
    document.addEventListener('DOMContentLoaded', function() {
      // Initialize Lucide icons
      if (typeof lucide !== 'undefined') {
        lucide.createIcons();
      }

      // Original form functionality
      const statusSelect = document.querySelector('#status-select');
      const scheduledAtField = document.querySelector('.scheduled-at-field');
      const platformSelect = document.querySelector('#platform-select');
      const imageUrlField = document.querySelector('#social_post_image_url');
      const imageUrlContainer = imageUrlField ? imageUrlField.closest('div[style*="margin-bottom"]') : null;
      const publishCheck = document.querySelector('#publish-now-check');

      function toggleScheduledAtField() {
        if (statusSelect && scheduledAtField) {
          scheduledAtField.style.display = statusSelect.value === 'scheduled' ? 'block' : 'none';
          if (statusSelect.value === 'scheduled') {
            if (publishCheck) {
              publishCheck.checked = false;
              publishCheck.disabled = true;
            }
          } else {
            if (publishCheck) {
              publishCheck.disabled = false;
            }
          }
        }
      }

      function toggleImageField() {
        if (platformSelect && imageUrlField && imageUrlContainer) {
          const isInstagram = platformSelect.value === 'instagram';
          const helpText = imageUrlContainer.querySelector('small');
          if (helpText) {
            helpText.textContent = isInstagram ? 'Required for Instagram posts.' : 'Optional for this platform.';
          }
          imageUrlField.required = isInstagram;
        }
      }

      if (statusSelect) {
        statusSelect.addEventListener('change', toggleScheduledAtField);
      }
      if (platformSelect) {
        platformSelect.addEventListener('change', toggleImageField);
      }

      toggleScheduledAtField();
      toggleImageField();

      // AI Content Generation
      const generateBtn = document.querySelector('#generate-ai-content-btn');
      const contentTextarea = document.querySelector('#content-textarea');
      const purposeTextarea = document.querySelector('#content-purpose');
      const loadingSection = document.querySelector('#ai-content-loading');
      const resultSection = document.querySelector('#ai-content-result');
      const errorSection = document.querySelector('#ai-content-error');
      const previewDiv = document.querySelector('#ai-content-preview');
      const useContentBtn = document.querySelector('#use-ai-content-btn');
      const regenerateBtn = document.querySelector('#regenerate-content-btn');

      function generateContent() {
        // Show loading, hide results/error
        loadingSection.classList.remove('d-none');
        resultSection.classList.add('d-none');
        errorSection.classList.add('d-none');
        useContentBtn.disabled = true;

        // Get platform and purpose values
        const platform = platformSelect.value;
        const purpose = purposeTextarea.value;

        if (!platform) {
          errorSection.querySelector('p').textContent = "Please select a platform first.";
          loadingSection.classList.add('d-none');
          errorSection.classList.remove('d-none');
          return;
        }

        // Make API call to generate content
        fetch('<%= generate_content_social_posts_path %>', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]').content
          },
          body: JSON.stringify({ platform, purpose })
        })
        .then(response => response.json())
        .then(data => {
          loadingSection.classList.add('d-none');

          if (data.error) {
            errorSection.querySelector('p').textContent = data.error;
            errorSection.classList.remove('d-none');
          } else {
            previewDiv.textContent = data.content;
            resultSection.classList.remove('d-none');
            useContentBtn.disabled = false;

            // Re-initialize Lucide icons after content update
            if (typeof lucide !== 'undefined') {
              lucide.createIcons();
            }
          }
        })
        .catch(error => {
          loadingSection.classList.add('d-none');
          errorSection.querySelector('p').textContent = "An error occurred while generating content. Please try again.";
          errorSection.classList.remove('d-none');
          console.error('Error:', error);
        });
      }

      // Event listeners for AI content generation
      if (generateBtn) {
        generateBtn.addEventListener('click', function() {
          if (!platformSelect || !platformSelect.value) {
            alert('Please select a platform first.');
            return;
          }
        });
      }

      if (regenerateBtn) {
        regenerateBtn.addEventListener('click', function(e) {
          e.preventDefault();
          generateContent();
        });
      }

      if (useContentBtn) {
        useContentBtn.addEventListener('click', function() {
          if (contentTextarea && previewDiv) {
            contentTextarea.value = previewDiv.textContent;
            const modal = bootstrap.Modal.getInstance(document.querySelector('#aiContentModal'));
            if (modal) {
              modal.hide();
            }
          }
        });
      }

      // Initialize content generation when modal is shown
      const aiModal = document.querySelector('#aiContentModal');
      if (aiModal) {
        aiModal.addEventListener('shown.bs.modal', function() {
          generateContent();
          // Re-initialize Lucide icons in modal
          if (typeof lucide !== 'undefined') {
            lucide.createIcons();
          }
        });
      }
    });

    // Also initialize on Turbo load
    document.addEventListener('turbo:load', function() {
      if (typeof lucide !== 'undefined') {
        lucide.createIcons();
      }
    });
  </script>
<% end %>
