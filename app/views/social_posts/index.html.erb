<script src="https://unpkg.com/lucide@latest"></script>

<div class="container-fluid py-4">
  <%# Page Header %>
  <div class="admin-page-header">
    <div class="header-left">
      <div class="header-icon">
        <i data-lucide="share-2"></i>
      </div>
      <div class="header-text">
        <h1>Social Media Posts</h1>
        <p>Manage and schedule your social media content</p>
      </div>
    </div>

    <div class="header-actions">
      <%= link_to new_social_post_path, class: "admin-btn admin-btn-primary" do %>
        <i data-lucide="plus"></i>
        <span>New Post</span>
      <% end %>
    </div>
  </div>

  <% if @social_posts.any? %>
    <%# Stats Cards %>
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1.5rem; margin-bottom: 2rem;">
      <%# Total Posts - Purple Gradient %>
      <div class="admin-card">
        <div style="display: flex; align-items: center; gap: 1rem;">
          <div style="width: 3rem; height: 3rem; border-radius: 0.75rem; background: linear-gradient(135deg, #7C3AED 0%, #A78BFA 100%); display: flex; align-items: center; justify-content: center;">
            <i data-lucide="share-2" style="width: 1.5rem; height: 1.5rem; color: white;"></i>
          </div>
          <div>
            <p style="color: #94A3B8; font-size: 0.875rem; margin: 0;">Total Posts</p>
            <h3 style="color: white; font-size: 1.875rem; font-weight: 600; margin: 0;"><%= @social_posts.count %></h3>
          </div>
        </div>
      </div>

      <%# Published - Green %>
      <div class="admin-card">
        <div style="display: flex; align-items: center; gap: 1rem;">
          <div style="width: 3rem; height: 3rem; border-radius: 0.75rem; background: rgba(34, 197, 94, 0.1); display: flex; align-items: center; justify-content: center; border: 1px solid rgba(34, 197, 94, 0.2);">
            <i data-lucide="check-circle" style="width: 1.5rem; height: 1.5rem; color: rgb(74, 222, 128);"></i>
          </div>
          <div>
            <p style="color: #94A3B8; font-size: 0.875rem; margin: 0;">Published</p>
            <h3 style="color: white; font-size: 1.875rem; font-weight: 600; margin: 0;"><%= @social_posts.where(status: 'published').count %></h3>
          </div>
        </div>
      </div>

      <%# Scheduled - Cyan %>
      <div class="admin-card">
        <div style="display: flex; align-items: center; gap: 1rem;">
          <div style="width: 3rem; height: 3rem; border-radius: 0.75rem; background: rgba(34, 211, 238, 0.1); display: flex; align-items: center; justify-content: center; border: 1px solid rgba(34, 211, 238, 0.2);">
            <i data-lucide="calendar-clock" style="width: 1.5rem; height: 1.5rem; color: #22D3EE;"></i>
          </div>
          <div>
            <p style="color: #94A3B8; font-size: 0.875rem; margin: 0;">Scheduled</p>
            <h3 style="color: white; font-size: 1.875rem; font-weight: 600; margin: 0;"><%= @social_posts.where(status: 'scheduled').count %></h3>
          </div>
        </div>
      </div>

      <%# Drafts - Yellow %>
      <div class="admin-card">
        <div style="display: flex; align-items: center; gap: 1rem;">
          <div style="width: 3rem; height: 3rem; border-radius: 0.75rem; background: rgba(234, 179, 8, 0.1); display: flex; align-items: center; justify-content: center; border: 1px solid rgba(234, 179, 8, 0.2);">
            <i data-lucide="file-edit" style="width: 1.5rem; height: 1.5rem; color: rgb(250, 204, 21);"></i>
          </div>
          <div>
            <p style="color: #94A3B8; font-size: 0.875rem; margin: 0;">Drafts</p>
            <h3 style="color: white; font-size: 1.875rem; font-weight: 600; margin: 0;"><%= @social_posts.where(status: 'draft').count %></h3>
          </div>
        </div>
      </div>
    </div>

    <%# Posts Grid %>
    <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(360px, 1fr)); gap: 1.5rem;">
      <% @social_posts.each do |post| %>
        <div class="admin-card" style="display: flex; flex-direction: column; height: 100%;">
          <%# Post Image %>
          <% if post.image? %>
            <div style="width: 100%; height: 200px; overflow: hidden; border-radius: 0.5rem; margin-bottom: 1rem;">
              <%= image_tag post.image_url, style: 'width: 100%; height: 100%; object-fit: cover;' %>
            </div>
          <% end %>

          <%# Card Header %>
          <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
            <% if post.status == 'published' %>
              <span class="admin-badge admin-badge-online">Published</span>
            <% elsif post.status == 'draft' %>
              <span class="admin-badge admin-badge-default">Draft</span>
            <% elsif post.status == 'scheduled' %>
              <span class="admin-badge admin-badge-cyan">Scheduled</span>
            <% elsif post.status == 'failed' %>
              <span class="admin-badge admin-badge-offline">Failed</span>
            <% else %>
              <span class="admin-badge admin-badge-default"><%= post.status.titleize %></span>
            <% end %>

            <span class="admin-badge admin-badge-default">
              <% case post.platform %>
              <% when 'twitter', 'x' %>
                <i data-lucide="twitter" style="width: 0.75rem; height: 0.75rem; display: inline-block; vertical-align: middle;"></i>
              <% when 'facebook' %>
                <i data-lucide="facebook" style="width: 0.75rem; height: 0.75rem; display: inline-block; vertical-align: middle;"></i>
              <% when 'instagram' %>
                <i data-lucide="instagram" style="width: 0.75rem; height: 0.75rem; display: inline-block; vertical-align: middle;"></i>
              <% when 'linkedin' %>
                <i data-lucide="linkedin" style="width: 0.75rem; height: 0.75rem; display: inline-block; vertical-align: middle;"></i>
              <% else %>
                <i data-lucide="share-2" style="width: 0.75rem; height: 0.75rem; display: inline-block; vertical-align: middle;"></i>
              <% end %>
              <%= post.platform.titleize %>
            </span>
          </div>

          <%# Card Body %>
          <div style="flex: 1;">
            <h5 style="color: white; font-size: 1.125rem; font-weight: 600; margin: 0 0 0.75rem 0;"><%= post.title %></h5>
            <p style="color: #94A3B8; font-size: 0.875rem; margin: 0 0 1rem 0;">
              <%= truncate(post.content, length: 150) %>
            </p>

            <% if post.scheduled? && post.scheduled_at %>
              <div style="display: flex; align-items: center; gap: 0.5rem; color: #64748B; font-size: 0.875rem; margin-bottom: 1rem;">
                <i data-lucide="calendar-clock" style="width: 1rem; height: 1rem;"></i>
                Scheduled for <%= post.scheduled_at.strftime("%B %d, %Y at %I:%M %p") %>
              </div>
            <% end %>

            <% if post.published? && post.latest_analytics %>
              <div style="background: #0F172A; border: 1px solid #1E293B; border-radius: 0.5rem; padding: 0.75rem; margin-bottom: 1rem;">
                <div style="display: flex; gap: 1.5rem; justify-content: space-around;">
                  <div style="text-align: center;">
                    <div style="color: #94A3B8; font-size: 0.75rem;">Likes</div>
                    <div style="color: white; font-weight: 600;"><%= number_with_delimiter(post.latest_analytics.likes) %></div>
                  </div>
                  <div style="text-align: center;">
                    <div style="color: #94A3B8; font-size: 0.75rem;">Comments</div>
                    <div style="color: white; font-weight: 600;"><%= number_with_delimiter(post.latest_analytics.comments) %></div>
                  </div>
                  <div style="text-align: center;">
                    <div style="color: #94A3B8; font-size: 0.75rem;">Engagement</div>
                    <div style="color: #22D3EE; font-weight: 600;"><%= number_to_percentage(post.calculate_engagement_rate, precision: 1) %></div>
                  </div>
                </div>
              </div>
            <% end %>
          </div>

          <%# Card Footer %>
          <div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 0.5rem; padding-top: 1rem; border-top: 1px solid #1E293B;">
            <%= link_to social_post_path(post), class: "admin-btn admin-btn-sm admin-btn-outline" do %>
              <i data-lucide="eye"></i>
            <% end %>
            <%= link_to edit_social_post_path(post), class: "admin-btn admin-btn-sm admin-btn-outline" do %>
              <i data-lucide="pencil"></i>
            <% end %>
            <%= button_to social_post_path(post), method: :delete, class: "admin-btn admin-btn-sm admin-btn-outline",
                style: "border-color: rgb(248, 113, 113); color: rgb(248, 113, 113);",
                data: { turbo_confirm: 'Are you sure?' } do %>
              <i data-lucide="trash-2"></i>
            <% end %>
          </div>

          <% if post.draft? %>
            <%= button_to publish_social_post_path(post), method: :post, class: "admin-btn admin-btn-sm admin-btn-primary", style: "margin-top: 0.5rem; width: 100%;" do %>
              <i data-lucide="send"></i>
              <span>Publish Now</span>
            <% end %>
          <% end %>
        </div>
      <% end %>
    </div>
  <% else %>
    <%# Empty State %>
    <div class="admin-card">
      <div class="admin-empty-state">
        <div class="empty-icon">
          <i data-lucide="share-2"></i>
        </div>
        <h3>No Social Posts Yet</h3>
        <p>Create your first social media post and start engaging with your audience</p>
        <%= link_to new_social_post_path, class: "admin-btn admin-btn-primary", style: "margin-top: 1rem;" do %>
          <i data-lucide="plus"></i>
          <span>Create Your First Post</span>
        <% end %>
      </div>
    </div>
  <% end %>
</div>

<script>
  document.addEventListener('turbo:load', () => {
    if (typeof lucide !== 'undefined') {
      lucide.createIcons();
    }
  });

  document.addEventListener('DOMContentLoaded', () => {
    if (typeof lucide !== 'undefined') {
      lucide.createIcons();
    }
  });
</script>
