<div class="container mt-4">
  <div class="row">
    <div class="col-md-12">
      <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center">
          <h2><%= @contact.full_name %></h2>
          <div>
            <%= link_to "Back", contacts_path, class: "btn btn-outline-secondary me-2" %>
            <%= link_to "Edit", edit_contact_path(@contact), class: "btn btn-outline-primary" %>
          </div>
        </div>
        <div class="card-body">
          <div class="row mb-3">
            <div class="col-md-3">
              <strong>Email:</strong>
            </div>
            <div class="col-md-9">
              <%= @contact.email %>
            </div>
          </div>
          
          <div class="row mb-3">
            <div class="col-md-3">
              <strong>Status:</strong>
            </div>
            <div class="col-md-9">
              <% if @contact.status.present? %>
                <span class="badge bg-<%= @contact.status == 'active' ? 'success' : (@contact.status == 'inactive' ? 'warning' : 'danger') %>">
                  <%= @contact.status.humanize %>
                </span>
              <% else %>
                <span class="badge bg-secondary">Unknown</span>
              <% end %>
            </div>
          </div>
          
          <div class="row mb-3">
            <div class="col-md-3">
              <strong>Tags:</strong>
            </div>
            <div class="col-md-9">
              <% if @contact.tags.present? %>
                <% @contact.tags.split(',').each do |tag| %>
                  <span class="badge bg-info me-1"><%= tag.strip %></span>
                <% end %>
              <% else %>
                <em>No tags</em>
              <% end %>
            </div>
          </div>
          
          <div class="row mb-3">
            <div class="col-md-3">
              <strong>Groups:</strong>
            </div>
            <div class="col-md-9">
              <% if @contact.contact_groups.any? %>
                <% @contact.contact_groups.each do |group| %>
                  <span class="badge bg-primary me-1"><%= group.name %></span>
                <% end %>
              <% else %>
                <em>No groups</em>
              <% end %>
            </div>
          </div>
          
          <div class="row">
            <div class="col-md-3">
              <strong>Added:</strong>
            </div>
            <div class="col-md-9">
              <%= @contact.created_at.strftime("%B %d, %Y at %I:%M %p") %>
            </div>
          </div>
        </div>
        
        <div class="card-footer text-end">
          <%= button_to "Delete Contact", contact_path(@contact), method: :delete, data: { turbo_confirm: "Are you sure you want to delete this contact?" }, class: "btn btn-outline-danger" %>
        </div>
      </div>
    </div>
  </div>
</div>
