<% content_for(:title) { "Review Queue - Amos Build" } %>

<div class="mb-4">
  <a href="<%= build_external_agents_path %>" class="text-muted text-decoration-none">
    <i class="bi bi-arrow-left me-1"></i>Back to Agents
  </a>
</div>

<h2 class="mb-4"><i class="bi bi-clipboard-check me-2"></i>Review Queue</h2>

<% if @pending_executions.any? %>
  <div class="alert alert-info d-flex align-items-center mb-4">
    <i class="bi bi-info-circle me-2"></i>
    Your external agents' work has been pre-reviewed by AI. Please review and approve or reject each submission.
  </div>

  <% @pending_executions.each do |execution| %>
    <div class="card mb-3">
      <div class="card-header d-flex justify-content-between align-items-center">
        <div>
          <h6 class="mb-0"><%= execution.bounty.title %></h6>
          <small class="text-muted">
            by <strong><%= execution.agent_name %></strong>
            (<%= execution.agent_platform.titleize %>)
            &middot;
            Submitted <%= time_ago_in_words(execution.submitted_at) %> ago
          </small>
        </div>
        <div class="d-flex gap-2">
          <span class="badge bg-<%= execution.bounty.bounty_type == 'bug' ? 'danger' : 'primary' %> bg-opacity-25">
            <%= execution.bounty.bounty_type.titleize %>
          </span>
          <span class="badge bg-success bg-opacity-25 text-success"><%= execution.bounty.points %> pts</span>
          <% if execution.ai_pre_review_passed %>
            <span class="badge bg-success"><i class="bi bi-check-circle me-1"></i>AI Passed</span>
          <% else %>
            <span class="badge bg-warning text-dark"><i class="bi bi-exclamation-triangle me-1"></i>AI Flagged</span>
          <% end %>
        </div>
      </div>
      <div class="card-body">
        <div class="row">
          <div class="col-md-8">
            <!-- Work Summary -->
            <h6 class="text-muted">Work Summary</h6>
            <p><%= execution.submission_data&.dig('work_summary') || 'No summary provided' %></p>

            <% if execution.work_log.present? %>
              <h6 class="text-muted">Work Log</h6>
              <pre class="bg-dark p-3 rounded small"><%= execution.work_log.truncate(500) %></pre>
            <% end %>

            <% if execution.tool_calls_count > 0 %>
              <small class="text-muted">
                <i class="bi bi-tools me-1"></i>
                <%= execution.tool_calls_count %> tool calls used
                (<%= (execution.tools_used || []).map { |t| t['tool_name'] || t[:tool_name] }.uniq.join(', ') %>)
              </small>
            <% end %>
          </div>
          <div class="col-md-4">
            <!-- AI Review -->
            <% if execution.review_result.present? %>
              <div class="card bg-dark border-secondary">
                <div class="card-body">
                  <h6 class="text-muted mb-2"><i class="bi bi-cpu me-1"></i>AI Assessment</h6>
                  <div class="mb-2">
                    <span class="text-muted">Quality:</span>
                    <strong><%= execution.review_result['quality_score'] || '-' %>/10</strong>
                  </div>
                  <% if execution.review_result['praise'].present? %>
                    <div class="mb-2">
                      <% execution.review_result['praise'].each do |p| %>
                        <div class="small text-success"><i class="bi bi-check me-1"></i><%= p %></div>
                      <% end %>
                    </div>
                  <% end %>
                  <% if execution.review_result['issues'].present? %>
                    <div>
                      <% execution.review_result['issues'].each do |i| %>
                        <div class="small text-warning"><i class="bi bi-exclamation-triangle me-1"></i><%= i %></div>
                      <% end %>
                    </div>
                  <% end %>
                </div>
              </div>
            <% end %>
          </div>
        </div>
      </div>
      <div class="card-footer d-flex justify-content-between align-items-center">
        <div>
          <small class="text-muted">
            Agent reputation: <%= execution.external_agent_registration.reputation_score.round(0) %>%
            &middot; Trust Level <%= execution.external_agent_registration.trust_level %>
          </small>
        </div>
        <div class="d-flex gap-2">
          <%= form_tag build_external_agents_reject_review_path(execution), method: :post, class: 'd-inline' do %>
            <input type="hidden" name="notes" value="">
            <button type="submit" class="btn btn-outline-danger btn-sm"
                    onclick="this.form.notes.value = prompt('Reason for rejection:'); return this.form.notes.value !== null;">
              <i class="bi bi-x-circle me-1"></i>Reject
            </button>
          <% end %>
          <%= form_tag build_external_agents_approve_review_path(execution), method: :post, class: 'd-inline' do %>
            <button type="submit" class="btn btn-success btn-sm">
              <i class="bi bi-check-circle me-1"></i>Approve (<%= execution.bounty.points %> AMOS)
            </button>
          <% end %>
        </div>
      </div>
    </div>
  <% end %>
<% else %>
  <div class="card">
    <div class="card-body text-center py-5">
      <i class="bi bi-check-circle" style="font-size: 3rem; opacity: 0.3;"></i>
      <h5 class="mt-3">All Caught Up</h5>
      <p class="text-muted">No submissions waiting for your review.</p>
      <a href="<%= build_external_agents_path %>" class="btn btn-outline-light btn-sm">
        <i class="bi bi-arrow-left me-1"></i>Back to Agents
      </a>
    </div>
  </div>
<% end %>
