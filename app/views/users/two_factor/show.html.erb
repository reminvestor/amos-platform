<div class="container py-4">
  <div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
      <div class="card bg-dark text-light border-secondary">
        <div class="card-header d-flex align-items-center">
          <i data-lucide="shield-check" class="icon-lg me-2 text-primary"></i>
          <h4 class="mb-0">Two-Factor Authentication</h4>
        </div>
        <div class="card-body">
          <% if @mfa_enabled %>
            <!-- MFA Enabled Status -->
            <div class="alert alert-success d-flex align-items-center mb-4">
              <i data-lucide="check-circle" class="icon-md me-2"></i>
              <div>
                <strong>Two-factor authentication is enabled</strong>
                <p class="mb-0 small">Your account is protected with an authenticator app.</p>
              </div>
            </div>

            <!-- Backup Codes Status -->
            <div class="mb-4">
              <h6 class="d-flex align-items-center">
                <i data-lucide="key" class="icon-sm me-2 text-warning"></i>
                Backup Codes
              </h6>
              <p class="text-muted small">
                You have <strong><%= @backup_codes_remaining %></strong> backup codes remaining.
                <% if @backup_codes_remaining < 3 %>
                  <span class="text-warning">Consider regenerating your backup codes.</span>
                <% end %>
              </p>
              <button type="button" class="btn btn-sm btn-outline-warning" data-bs-toggle="modal" data-bs-target="#regenerateCodesModal">
                <i data-lucide="refresh-cw" class="icon-xs me-1"></i>
                Regenerate Backup Codes
              </button>
            </div>

            <!-- Email OTP Option -->
            <div class="mb-4">
              <h6 class="d-flex align-items-center">
                <i data-lucide="mail" class="icon-sm me-2 text-info"></i>
                Email Verification (Backup)
              </h6>
              <p class="text-muted small">
                Allow receiving verification codes via email when you can't use your authenticator app.
              </p>
              <%= form_with url: update_email_settings_users_two_factor_path, method: :patch, local: true do |f| %>
                <div class="form-check form-switch">
                  <%= f.check_box :otp_email_enabled, { checked: @user.otp_email_enabled?, class: "form-check-input", onchange: "this.form.submit()" }, "1", "0" %>
                  <label class="form-check-label">Enable email verification</label>
                </div>
              <% end %>
            </div>

            <hr class="border-secondary">

            <!-- Disable MFA -->
            <div class="mt-4">
              <button type="button" class="btn btn-outline-danger" data-bs-toggle="modal" data-bs-target="#disableMfaModal">
                <i data-lucide="shield-off" class="icon-sm me-1"></i>
                Disable Two-Factor Authentication
              </button>
            </div>

          <% else %>
            <!-- MFA Not Enabled -->
            <div class="text-center py-4">
              <i data-lucide="shield-alert" class="text-warning mb-3" style="width: 64px; height: 64px;"></i>
              <h5>Protect your account</h5>
              <p class="text-muted">
                Add an extra layer of security by requiring a verification code when you sign in.
              </p>

              <div class="mt-4">
                <%= link_to enable_users_two_factor_path, class: "btn btn-primary btn-lg" do %>
                  <i data-lucide="smartphone" class="icon-md me-2"></i>
                  Set Up Authenticator App
                <% end %>
              </div>

              <p class="text-muted small mt-4">
                Works with Google Authenticator, Authy, Microsoft Authenticator, and other TOTP apps.
              </p>
            </div>
          <% end %>
        </div>
      </div>

      <%= link_to edit_user_path(current_user), class: "btn btn-link text-secondary mt-3" do %>
        <i data-lucide="arrow-left" class="icon-xs me-1"></i>
        Back to Settings
      <% end %>
    </div>
  </div>
</div>

<!-- Disable MFA Modal -->
<div class="modal fade" id="disableMfaModal" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content bg-dark text-light">
      <div class="modal-header border-secondary">
        <h5 class="modal-title">Disable Two-Factor Authentication</h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
      </div>
      <%= form_with url: users_two_factor_path, method: :delete, local: true do |f| %>
        <div class="modal-body">
          <div class="alert alert-warning">
            <i data-lucide="alert-triangle" class="icon-sm me-1"></i>
            This will make your account less secure.
          </div>
          <p>Enter your password to confirm:</p>
          <div class="mb-3">
            <%= f.password_field :password, class: "form-control bg-secondary border-secondary text-light", placeholder: "Password", required: true %>
          </div>
        </div>
        <div class="modal-footer border-secondary">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-danger">Disable MFA</button>
        </div>
      <% end %>
    </div>
  </div>
</div>

<!-- Regenerate Codes Modal -->
<div class="modal fade" id="regenerateCodesModal" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content bg-dark text-light">
      <div class="modal-header border-secondary">
        <h5 class="modal-title">Regenerate Backup Codes</h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
      </div>
      <%= form_with url: regenerate_backup_codes_users_two_factor_path, method: :post, local: true do |f| %>
        <div class="modal-body">
          <div class="alert alert-warning">
            <i data-lucide="alert-triangle" class="icon-sm me-1"></i>
            Your current backup codes will be invalidated.
          </div>
          <p>Enter your password to generate new codes:</p>
          <div class="mb-3">
            <%= f.password_field :password, class: "form-control bg-secondary border-secondary text-light", placeholder: "Password", required: true %>
          </div>
        </div>
        <div class="modal-footer border-secondary">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-warning">Regenerate Codes</button>
        </div>
      <% end %>
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    if (typeof lucide !== 'undefined') {
      lucide.createIcons();
    }
  });
</script>
