<%# 2FA Setup Modal - Inline setup without leaving the page %>
<div class="modal fade" id="twoFactorSetupModal" tabindex="-1" aria-labelledby="twoFactorSetupModalLabel" aria-hidden="true" data-bs-backdrop="static">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content" style="background: var(--bg-secondary); border: 1px solid var(--border-color);">
      
      <%# Step 1: QR Code Setup %>
      <div id="mfaStep1" class="mfa-step">
        <div class="modal-header border-bottom" style="border-color: var(--border-color) !important;">
          <h5 class="modal-title d-flex align-items-center" id="twoFactorSetupModalLabel">
            <i data-lucide="shield-check" style="width: 22px; height: 22px; color: var(--primary);" class="me-2"></i>
            Set Up Two-Factor Authentication
          </h5>
          <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body p-4">
          <div id="mfaQrContent" class="text-center">
            <div class="spinner-border text-primary" role="status">
              <span class="visually-hidden">Loading...</span>
            </div>
            <p class="text-muted mt-2">Generating your secure code...</p>
          </div>
        </div>
      </div>

      <%# Step 2: Backup Codes %>
      <div id="mfaStep2" class="mfa-step d-none">
        <div class="modal-header border-bottom" style="border-color: var(--border-color) !important;">
          <h5 class="modal-title d-flex align-items-center">
            <i data-lucide="key" style="width: 22px; height: 22px; color: #10B981;" class="me-2"></i>
            Save Your Backup Codes
          </h5>
        </div>
        <div class="modal-body p-4">
          <div id="mfaBackupContent">
            <%# Filled dynamically %>
          </div>
        </div>
      </div>

    </div>
  </div>
</div>

<script>
(function() {
  // Initialize immediately or on DOMContentLoaded
  function initTwoFactorModal() {
    const modal = document.getElementById('twoFactorSetupModal');
    if (!modal) return;
    
    // IMPORTANT: Move modal to body level for proper z-index and positioning
    // This handles cases where the modal is rendered inside a container with overflow:hidden
    if (modal.parentElement !== document.body) {
      document.body.appendChild(modal);
    }

    // When modal opens, fetch QR code
    modal.addEventListener('show.bs.modal', function() {
      loadQrCode();
    });

  function loadQrCode() {
    fetch('<%= enable_users_two_factor_path %>', {
      headers: {
        'Accept': 'application/json',
        'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]')?.content
      }
    })
    .then(response => response.json())
    .then(data => {
      if (data.error) {
        document.getElementById('mfaQrContent').innerHTML = `
          <div class="alert alert-warning">${data.error}</div>
        `;
        return;
      }

      document.getElementById('mfaQrContent').innerHTML = `
        <p class="text-muted mb-3" style="font-size: 0.9rem;">
          Scan this QR code with your authenticator app<br>
          <span class="text-muted" style="font-size: 0.8rem;">(Google Authenticator, Authy, Microsoft Authenticator, etc.)</span>
        </p>
        
        <div class="bg-white p-3 d-inline-block rounded mb-3">
          ${data.qr_code_svg}
        </div>
        
        <div class="mb-3">
          <button type="button" class="btn btn-link btn-sm text-muted" onclick="toggleManualCode()">
            <i data-lucide="keyboard" style="width: 14px; height: 14px;" class="me-1"></i>
            Can't scan? Enter manually
          </button>
          <div id="manualCodeSection" class="d-none mt-2">
            <div class="p-2 rounded" style="background: var(--bg-tertiary);">
              <code style="color: var(--text-primary); word-break: break-all; letter-spacing: 2px; font-size: 0.85rem;">
                ${data.secret}
              </code>
            </div>
          </div>
        </div>
        
        <hr style="border-color: var(--border-color);">
        
        <div class="mt-3">
          <label class="form-label text-muted" style="font-size: 0.85rem;">Enter the 6-digit code from your app:</label>
          <form id="mfaVerifyForm" onsubmit="verifyCode(event)">
            <div class="d-flex gap-2 justify-content-center mb-3">
              <input type="text" id="mfaCodeInput" 
                     class="form-control text-center"
                     style="max-width: 180px; letter-spacing: 8px; font-size: 1.4rem; background: var(--bg-tertiary); border-color: var(--border-color); color: var(--text-primary);"
                     placeholder="000000"
                     pattern="[0-9]{6}"
                     maxlength="6"
                     inputmode="numeric"
                     autocomplete="one-time-code"
                     required>
            </div>
            <div id="mfaError" class="alert alert-danger d-none mb-3" style="font-size: 0.85rem;"></div>
            <button type="submit" class="btn btn-primary w-100" id="mfaVerifyBtn">
              <i data-lucide="check-circle" style="width: 16px; height: 16px;" class="me-1"></i>
              Verify & Enable
            </button>
          </form>
        </div>
      `;
      
      if (typeof lucide !== 'undefined') lucide.createIcons();
      document.getElementById('mfaCodeInput')?.focus();
    })
    .catch(err => {
      console.error('Failed to load 2FA setup:', err);
      document.getElementById('mfaQrContent').innerHTML = `
        <div class="alert alert-danger">Failed to load. Please try again.</div>
      `;
    });
  }

  window.toggleManualCode = function() {
    const section = document.getElementById('manualCodeSection');
    section.classList.toggle('d-none');
  };

  window.verifyCode = function(e) {
    e.preventDefault();
    const code = document.getElementById('mfaCodeInput').value;
    const btn = document.getElementById('mfaVerifyBtn');
    const errorDiv = document.getElementById('mfaError');
    
    btn.disabled = true;
    btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Verifying...';
    errorDiv.classList.add('d-none');

    fetch('<%= confirm_users_two_factor_path %>', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'Accept': 'application/json',
        'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]')?.content
      },
      body: JSON.stringify({ code: code })
    })
    .then(response => response.json())
    .then(data => {
      if (data.success) {
        // Show backup codes
        showBackupCodes(data.backup_codes);
      } else {
        errorDiv.textContent = data.error || 'Invalid code. Please try again.';
        errorDiv.classList.remove('d-none');
        btn.disabled = false;
        btn.innerHTML = '<i data-lucide="check-circle" style="width: 16px; height: 16px;" class="me-1"></i> Verify & Enable';
        if (typeof lucide !== 'undefined') lucide.createIcons();
        document.getElementById('mfaCodeInput').value = '';
        document.getElementById('mfaCodeInput').focus();
      }
    })
    .catch(err => {
      console.error('Verification failed:', err);
      errorDiv.textContent = 'Something went wrong. Please try again.';
      errorDiv.classList.remove('d-none');
      btn.disabled = false;
      btn.innerHTML = '<i data-lucide="check-circle" style="width: 16px; height: 16px;" class="me-1"></i> Verify & Enable';
      if (typeof lucide !== 'undefined') lucide.createIcons();
    });
  };

  function showBackupCodes(codes) {
    document.getElementById('mfaStep1').classList.add('d-none');
    document.getElementById('mfaStep2').classList.remove('d-none');
    
    const codesHtml = codes.map(code => `<div class="backup-code">${code}</div>`).join('');
    
    document.getElementById('mfaBackupContent').innerHTML = `
      <div class="alert alert-warning d-flex align-items-start mb-3" style="background: rgba(245, 158, 11, 0.1); border-color: rgba(245, 158, 11, 0.3);">
        <i data-lucide="alert-triangle" style="width: 20px; height: 20px; color: #F59E0B; flex-shrink: 0;" class="me-2 mt-1"></i>
        <div style="font-size: 0.85rem;">
          <strong>Save these codes somewhere safe!</strong><br>
          Each code can only be used once. You'll need these if you lose access to your authenticator app.
        </div>
      </div>
      
      <div class="backup-codes-grid mb-3">
        ${codesHtml}
      </div>
      
      <div class="d-flex gap-2 mb-3">
        <button type="button" class="btn btn-outline-secondary btn-sm flex-fill" onclick="copyBackupCodes()">
          <i data-lucide="copy" style="width: 14px; height: 14px;" class="me-1"></i>
          Copy
        </button>
        <button type="button" class="btn btn-outline-secondary btn-sm flex-fill" onclick="downloadBackupCodes()">
          <i data-lucide="download" style="width: 14px; height: 14px;" class="me-1"></i>
          Download
        </button>
      </div>
      
      <div class="form-check mb-3">
        <input type="checkbox" class="form-check-input" id="savedCodesCheckbox" onchange="toggleContinueBtn()">
        <label class="form-check-label text-muted" for="savedCodesCheckbox" style="font-size: 0.85rem;">
          I've saved my backup codes in a safe place
        </label>
      </div>
      
      <button type="button" class="btn btn-success w-100" id="mfaContinueBtn" disabled onclick="finishSetup()">
        <i data-lucide="check" style="width: 16px; height: 16px;" class="me-1"></i>
        Done - Continue to Amos
      </button>
    `;
    
    // Store codes for copy/download
    window.backupCodes = codes;
    
    if (typeof lucide !== 'undefined') lucide.createIcons();
  }

  window.toggleContinueBtn = function() {
    const checkbox = document.getElementById('savedCodesCheckbox');
    const btn = document.getElementById('mfaContinueBtn');
    btn.disabled = !checkbox.checked;
  };

  window.copyBackupCodes = function() {
    const text = window.backupCodes.join('\\n');
    navigator.clipboard.writeText(text).then(() => {
      const btn = event.target.closest('button');
      const originalText = btn.innerHTML;
      btn.innerHTML = '<i data-lucide="check" style="width: 14px; height: 14px;" class="me-1"></i> Copied!';
      if (typeof lucide !== 'undefined') lucide.createIcons();
      setTimeout(() => {
        btn.innerHTML = originalText;
        if (typeof lucide !== 'undefined') lucide.createIcons();
      }, 2000);
    });
  };

  window.downloadBackupCodes = function() {
    const text = 'AMOS Labs - Backup Codes\\n' +
                 '========================\\n\\n' +
                 'Keep these codes safe!\\n' +
                 'Each code can only be used once.\\n\\n' +
                 window.backupCodes.join('\\n');
    
    const blob = new Blob([text], { type: 'text/plain' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = 'amos-backup-codes.txt';
    a.click();
    URL.revokeObjectURL(url);
  };

  window.finishSetup = function() {
    const modal = bootstrap.Modal.getInstance(document.getElementById('twoFactorSetupModal'));
    modal.hide();
    
    // Remove the 2FA suggestion card if it exists
    const suggestionCard = document.querySelector('.security-suggestion');
    if (suggestionCard) {
      suggestionCard.remove();
    }
    
    // If there's a redirect target, go there
    const redirectTo = '<%= defined?(after_mfa_redirect) ? after_mfa_redirect : scout_path %>';
    if (redirectTo && redirectTo !== window.location.pathname) {
      window.location.href = redirectTo;
    }
  };
  } // end initTwoFactorModal
  
  // Initialize on DOMContentLoaded or immediately if already loaded
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initTwoFactorModal);
  } else {
    initTwoFactorModal();
  }
})();
</script>

<style>
  .backup-codes-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 8px;
  }
  
  .backup-code {
    font-family: monospace;
    font-size: 0.9rem;
    padding: 8px 12px;
    background: var(--bg-tertiary);
    border-radius: 6px;
    text-align: center;
    color: var(--text-primary);
    letter-spacing: 1px;
  }
</style>

