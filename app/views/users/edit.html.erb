<div class="container-fluid py-4">
  <%# Page Header %>
  <div class="admin-page-header">
    <div class="header-left">
      <div class="header-icon">
        <i data-lucide="user"></i>
      </div>
      <div class="header-text">
        <h1>Edit Profile</h1>
        <p>Update your personal information</p>
      </div>
    </div>

    <div class="header-actions">
      <%= link_to user_path(@user), class: "admin-btn admin-btn-outline" do %>
        <i data-lucide="arrow-left"></i>
        <span>Back to Profile</span>
      <% end %>
    </div>
  </div>

  <div class="row">
    <div class="col-md-8 mx-auto">
      <div class="admin-card">
        <%= form_with(model: @user, local: true) do |form| %>
          <% if @user.errors.any? %>
            <div class="alert alert-danger mb-4" style="background: rgba(239, 68, 68, 0.1); border: 1px solid rgba(239, 68, 68, 0.2); color: #EF4444; padding: 1rem; border-radius: 0.5rem;">
              <h5 style="margin-bottom: 0.75rem; display: flex; align-items: center; gap: 0.5rem;">
                <i data-lucide="alert-triangle" style="width: 1.25rem; height: 1.25rem;"></i>
                <%= pluralize(@user.errors.count, "error") %> prohibited this update:
              </h5>
              <ul style="margin-bottom: 0; padding-left: 1.5rem;">
                <% @user.errors.full_messages.each do |message| %>
                  <li><%= message %></li>
                <% end %>
              </ul>
            </div>
          <% end %>

          <div class="row mb-4">
            <div class="col-md-6">
              <div class="admin-form-group">
                <%= form.label :first_name, class: "admin-label" %>
                <%= form.text_field :first_name, class: "admin-input", placeholder: "Your first name" %>
              </div>
            </div>
            <div class="col-md-6">
              <div class="admin-form-group">
                <%= form.label :last_name, class: "admin-label" %>
                <%= form.text_field :last_name, class: "admin-input", placeholder: "Your last name" %>
              </div>
            </div>
          </div>

          <div class="admin-form-group mb-4">
            <%= form.label :email, class: "admin-label" %>
            <%= form.email_field :email, class: "admin-input", placeholder: "your.email@example.com" %>
            <small style="color: #64748B; display: block; margin-top: 0.25rem;">
              <i data-lucide="info" style="width: 0.875rem; height: 0.875rem; display: inline-block; margin-right: 0.25rem;"></i>
              Changing your email will require confirmation.
            </small>
          </div>
          
          <% if @user.respond_to?(:phone) %>
            <div class="admin-form-group mb-4">
              <%= form.label :phone, class: "admin-label" %>
              <%= form.text_field :phone, class: "admin-input", placeholder: "+1 (555) 123-4567" %>
            </div>
          <% end %>
          
          <% if @user.respond_to?(:timezone) %>
            <div class="admin-form-group mb-4">
              <%= form.label :timezone, class: "admin-label" %>
              <%= form.select :timezone, 
                  ActiveSupport::TimeZone.all.map { |tz| [tz.to_s, tz.name] },
                  { selected: @user.timezone || 'UTC' },
                  class: "admin-input" %>
            </div>
          <% end %>
          
          <% if @user.respond_to?(:bio) %>
            <div class="admin-form-group mb-4">
              <%= form.label :bio, class: "admin-label" %>
              <%= form.text_area :bio, class: "admin-input", rows: 4, placeholder: "Tell us about yourself..." %>
            </div>
          <% end %>

          <div class="d-flex justify-content-between align-items-center pt-4" style="border-top: 1px solid #1E293B;">
            <%= link_to user_path(@user), class: "admin-btn admin-btn-outline" do %>
              <i data-lucide="x"></i>
              <span>Cancel</span>
            <% end %>
            <%= form.submit "Update Profile", class: "admin-btn admin-btn-primary" %>
          </div>
        <% end %>
      </div>
      
      <%# Additional Settings Card %>
      <div class="admin-card mt-4">
        <h4 style="color: white; margin-bottom: 1.5rem;">Account Settings</h4>

        <div style="display: flex; flex-direction: column; gap: 1rem;">
          <%= link_to edit_user_registration_path, class: "admin-btn admin-btn-outline", style: "justify-content: flex-start;" do %>
            <i data-lucide="key"></i>
            <span>Change Password</span>
          <% end %>

          <%= link_to chat_mode_path, class: "admin-btn admin-btn-outline", style: "justify-content: flex-start;" do %>
            <i data-lucide="briefcase"></i>
            <span>Business Settings</span>
          <% end %>

          <% if @user.entity_admin? %>
            <%= link_to entity_users_path, class: "admin-btn admin-btn-outline", style: "justify-content: flex-start;" do %>
              <i data-lucide="users"></i>
              <span>Team Members</span>
            <% end %>
          <% end %>
        </div>
      </div>

      <%# Security Settings Card %>
      <div class="admin-card mt-4">
        <h4 style="color: white; margin-bottom: 1.5rem;">
          <i data-lucide="shield" style="width: 1.25rem; height: 1.25rem; display: inline-block; margin-right: 0.5rem;"></i>
          Security Settings
        </h4>

        <div style="display: flex; flex-direction: column; gap: 1rem;">
          <%= link_to users_two_factor_path, class: "admin-btn admin-btn-outline", style: "justify-content: flex-start;" do %>
            <i data-lucide="smartphone"></i>
            <span>Two-Factor Authentication</span>
            <% if @user.mfa_enabled? %>
              <span class="badge bg-success ms-auto" style="font-size: 0.75rem;">Enabled</span>
            <% else %>
              <span class="badge bg-secondary ms-auto" style="font-size: 0.75rem;">Not Set Up</span>
            <% end %>
          <% end %>
        </div>

        <% unless @user.mfa_enabled? %>
          <div class="mt-3" style="padding: 0.75rem; background: rgba(234, 179, 8, 0.1); border: 1px solid rgba(234, 179, 8, 0.2); border-radius: 0.5rem;">
            <p style="color: #EAB308; margin: 0; font-size: 0.875rem;">
              <i data-lucide="alert-triangle" style="width: 1rem; height: 1rem; display: inline-block; margin-right: 0.5rem;"></i>
              We recommend enabling two-factor authentication to protect your account.
            </p>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', () => {
  if (typeof lucide !== 'undefined') {
    lucide.createIcons();
  }
});

document.addEventListener('turbo:load', () => {
  if (typeof lucide !== 'undefined') {
    lucide.createIcons();
  }
});
</script>