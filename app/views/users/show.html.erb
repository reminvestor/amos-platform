<div class="container mx-auto px-4 py-8">
  <div class="max-w-4xl mx-auto">
    <div class="bg-white rounded-lg shadow-lg p-6">
      <h1 class="text-2xl font-bold mb-6">User Profile</h1>
      
      <div class="space-y-6">
        <div>
          <h2 class="text-lg font-semibold mb-2">Account Information</h2>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div>
              <p class="text-gray-600">Email</p>
              <p class="font-medium"><%= @user.email %></p>
            </div>
            <div>
              <p class="text-gray-600">Created At</p>
              <p class="font-medium"><%= @user.created_at.strftime("%B %d, %Y") %></p>
            </div>
          </div>
        </div>

        <div>
          <h2 class="text-lg font-semibold mb-2">API Access</h2>
          <div class="bg-gray-50 p-4 rounded-lg">
            <p class="text-gray-600 mb-2">Your API Key</p>
            <div class="flex items-center space-x-2">
              <code class="bg-gray-100 px-3 py-1 rounded text-sm font-mono"><%= @user.api_key %></code>
              <button onclick="copyApiKey()" class="text-blue-600 hover:text-blue-800">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 5H6a2 2 0 00-2 2v11a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2m0 0h2a2 2 0 012 2v3m2 4H10m0 0l3-3m-3 3l3 3"></path>
                </svg>
              </button>
            </div>
            <p class="text-sm text-gray-500 mt-2">Use this key in the Authorization header for API requests: <code>Bearer <%= @user.api_key %></code></p>
          </div>
        </div>

        <div>
          <h2 class="text-lg font-semibold mb-2">Actions</h2>
          <div class="space-x-4">
            <%= link_to "Edit Profile", edit_user_path(@user), class: "bg-blue-500 text-white px-4 py-2 rounded hover:bg-blue-600" %>
            <%= link_to "Change Password", edit_user_registration_path, class: "bg-gray-500 text-white px-4 py-2 rounded hover:bg-gray-600" %>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
function copyApiKey() {
  const apiKey = '<%= @user.api_key %>';
  navigator.clipboard.writeText(apiKey).then(() => {
    alert('API key copied to clipboard!');
  }).catch(err => {
    console.error('Failed to copy API key:', err);
  });
}
</script> 