<script src="https://unpkg.com/lucide@latest"></script>

<div class="container-fluid py-4" style="background-color: var(--bg-primary); min-height: 100vh; color: var(--text-primary);" data-controller="analytics-dashboard">
  <%# Page Header %>
  <div class="admin-page-header">
    <div class="header-left">
      <div class="header-icon">
        <i data-lucide="bar-chart-3"></i>
      </div>
      <div class="header-text">
        <h1>Real-Time Analytics</h1>
        <p>Live performance metrics and insights</p>
      </div>
    </div>

    <div class="header-actions">
      <span class="admin-badge admin-badge-online" data-analytics-dashboard-target="connectionStatus">
        <span class="spinner-grow spinner-grow-sm" role="status"></span>
        Connecting...
      </span>
    </div>
  </div>

  <%# Key Metrics Cards %>
  <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1.5rem; margin-bottom: 2rem;">
    <%# Active Campaigns %>
    <div class="admin-card">
      <div style="display: flex; align-items: center; gap: 1rem;">
        <div style="width: 3rem; height: 3rem; border-radius: 0.75rem; background: linear-gradient(135deg, #7C3AED 0%, #A78BFA 100%); display: flex; align-items: center; justify-content: center;">
          <i data-lucide="mail" style="width: 1.5rem; height: 1.5rem; color: white;"></i>
        </div>
        <div>
          <p style="color: #94A3B8; font-size: 0.875rem; margin: 0;">Active Campaigns</p>
          <h3 style="color: white; font-size: 1.875rem; font-weight: 600; margin: 0;" data-analytics-dashboard-target="campaignsActive"><%= @metrics[:campaigns_active] %></h3>
        </div>
      </div>
    </div>

    <%# Emails Sent Today %>
    <div class="admin-card">
      <div style="display: flex; align-items: center; gap: 1rem;">
        <div style="width: 3rem; height: 3rem; border-radius: 0.75rem; background: rgba(34, 197, 94, 0.1); display: flex; align-items: center; justify-content: center; border: 1px solid rgba(34, 197, 94, 0.2);">
          <i data-lucide="send" style="width: 1.5rem; height: 1.5rem; color: rgb(74, 222, 128);"></i>
        </div>
        <div>
          <p style="color: #94A3B8; font-size: 0.875rem; margin: 0;">Emails Sent Today</p>
          <h3 style="color: white; font-size: 1.875rem; font-weight: 600; margin: 0;" data-analytics-dashboard-target="emailsSentToday"><%= number_with_delimiter(@metrics[:emails_sent_today]) %></h3>
        </div>
      </div>
    </div>

    <%# Opens (Last Hour) %>
    <div class="admin-card">
      <div style="display: flex; align-items: center; gap: 1rem;">
        <div style="width: 3rem; height: 3rem; border-radius: 0.75rem; background: rgba(59, 130, 246, 0.1); display: flex; align-items: center; justify-content: center; border: 1px solid rgba(59, 130, 246, 0.2);">
          <i data-lucide="eye" style="width: 1.5rem; height: 1.5rem; color: rgb(96, 165, 250);"></i>
        </div>
        <div>
          <p style="color: #94A3B8; font-size: 0.875rem; margin: 0;">Opens (Last Hour)</p>
          <h3 style="color: white; font-size: 1.875rem; font-weight: 600; margin: 0;" data-analytics-dashboard-target="opensLastHour"><%= @metrics[:opens_last_hour] %></h3>
          <p style="color: #64748B; font-size: 0.75rem; margin: 0;"><%= @metrics[:open_rate_last_hour] %>% rate</p>
        </div>
      </div>
    </div>

    <%# Clicks (Last Hour) %>
    <div class="admin-card">
      <div style="display: flex; align-items: center; gap: 1rem;">
        <div style="width: 3rem; height: 3rem; border-radius: 0.75rem; background: rgba(234, 179, 8, 0.1); display: flex; align-items: center; justify-content: center; border: 1px solid rgba(234, 179, 8, 0.2);">
          <i data-lucide="mouse-pointer-click" style="width: 1.5rem; height: 1.5rem; color: rgb(250, 204, 21);"></i>
        </div>
        <div>
          <p style="color: #94A3B8; font-size: 0.875rem; margin: 0;">Clicks (Last Hour)</p>
          <h3 style="color: white; font-size: 1.875rem; font-weight: 600; margin: 0;" data-analytics-dashboard-target="clicksLastHour"><%= @metrics[:clicks_last_hour] %></h3>
          <p style="color: #64748B; font-size: 0.75rem; margin: 0;"><%= @metrics[:click_rate_last_hour] %>% rate</p>
        </div>
      </div>
    </div>
  </div>

  <%# Charts and Activity Row %>
  <div style="display: grid; grid-template-columns: 1fr 400px; gap: 1.5rem; margin-bottom: 2rem;">
    <%# Left Column: Charts %>
    <div>
      <%# Engagement Chart %>
      <div class="admin-card" style="margin-bottom: 1.5rem;">
        <h3 class="card-title">
          <i data-lucide="trending-up" style="width: 1.25rem; height: 1.25rem; display: inline-block; vertical-align: middle; margin-right: 0.5rem;"></i>
          Email Engagement (Last Hour)
        </h3>
        <canvas data-analytics-dashboard-target="engagementChart" style="height: 300px;"></canvas>
      </div>

      <%# Engagement Heatmap %>
      <div class="admin-card">
        <h3 class="card-title">
          <i data-lucide="activity" style="width: 1.25rem; height: 1.25rem; display: inline-block; vertical-align: middle; margin-right: 0.5rem;"></i>
          Engagement Heatmap (7 Days)
        </h3>
        <canvas data-analytics-dashboard-target="heatmapChart" style="height: 300px;"></canvas>
      </div>
    </div>

    <%# Right Column: Activity Feed & Top Performers %>
    <div>
      <%# Live Activity Feed %>
      <div class="admin-card" style="margin-bottom: 1.5rem;">
        <h3 class="card-title">
          <span style="display: inline-block; width: 0.5rem; height: 0.5rem; border-radius: 50%; background-color: #EF4444; margin-right: 0.5rem; animation: pulse 2s infinite;"></span>
          Live Activity
        </h3>
        <div data-analytics-dashboard-target="activityFeed" style="max-height: 300px; overflow-y: auto;">
          <div style="text-align: center; color: #94A3B8; padding: 2rem;">
            <small>Loading activities...</small>
          </div>
        </div>
      </div>

      <%# Top Performers %>
      <div class="admin-card">
        <h3 class="card-title">
          <i data-lucide="trophy" style="width: 1.25rem; height: 1.25rem; display: inline-block; vertical-align: middle; margin-right: 0.5rem;"></i>
          Top Performers
        </h3>
        <div data-analytics-dashboard-target="topPerformers">
          <div style="text-align: center; color: #94A3B8; padding: 2rem;">
            <small>Loading top performers...</small>
          </div>
        </div>
      </div>
    </div>
  </div>

  <%# Additional Stats Row %>
  <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 1.5rem;">
    <%# Landing Pages Stats %>
    <div class="admin-card">
      <h3 class="card-title">
        <i data-lucide="file-text" style="width: 1.25rem; height: 1.25rem; display: inline-block; vertical-align: middle; margin-right: 0.5rem;"></i>
        Landing Pages
      </h3>
      <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem;">
        <div>
          <p style="color: #94A3B8; font-size: 0.875rem; margin: 0;">Visits Today</p>
          <h4 style="color: white; font-size: 1.5rem; font-weight: 600; margin: 0.25rem 0 0 0;" data-analytics-dashboard-target="landingPageVisits"><%= @metrics[:landing_page_visits_today] %></h4>
        </div>
        <div>
          <p style="color: #94A3B8; font-size: 0.875rem; margin: 0;">Conversions</p>
          <h4 style="color: white; font-size: 1.5rem; font-weight: 600; margin: 0.25rem 0 0 0;" data-analytics-dashboard-target="landingPageConversions"><%= @metrics[:landing_page_conversions_today] %></h4>
        </div>
        <div>
          <p style="color: #94A3B8; font-size: 0.875rem; margin: 0;">Rate</p>
          <h4 style="color: #22D3EE; font-size: 1.5rem; font-weight: 600; margin: 0.25rem 0 0 0;" data-analytics-dashboard-target="conversionRate"><%= @metrics[:conversion_rate_today] %>%</h4>
        </div>
      </div>
    </div>

    <%# Contacts Stats %>
    <div class="admin-card">
      <h3 class="card-title">
        <i data-lucide="users" style="width: 1.25rem; height: 1.25rem; display: inline-block; vertical-align: middle; margin-right: 0.5rem;"></i>
        Contacts
      </h3>
      <div style="display: grid; grid-template-columns: repeat(2, 1fr); gap: 1rem;">
        <div>
          <p style="color: #94A3B8; font-size: 0.875rem; margin: 0;">Total</p>
          <h4 style="color: white; font-size: 1.5rem; font-weight: 600; margin: 0.25rem 0 0 0;" data-analytics-dashboard-target="totalContacts"><%= number_with_delimiter(@metrics[:total_contacts]) %></h4>
        </div>
        <div>
          <p style="color: #94A3B8; font-size: 0.875rem; margin: 0;">Active (7d)</p>
          <h4 style="color: white; font-size: 1.5rem; font-weight: 600; margin: 0.25rem 0 0 0;" data-analytics-dashboard-target="activeContacts"><%= number_with_delimiter(@metrics[:active_contacts]) %></h4>
        </div>
      </div>
    </div>

    <%# System Status %>
    <div class="admin-card">
      <h3 class="card-title">
        <i data-lucide="server" style="width: 1.25rem; height: 1.25rem; display: inline-block; vertical-align: middle; margin-right: 0.5rem;"></i>
        System Status
      </h3>
      <div>
        <span class="admin-badge admin-badge-online">All Systems Operational</span>
        <p style="color: #64748B; font-size: 0.875rem; margin: 0.75rem 0 0 0;">
          Last updated: <span data-analytics-dashboard-target="lastUpdate">Just now</span>
        </p>
      </div>
    </div>
  </div>
</div>

<script>
  document.addEventListener('turbo:load', () => {
    if (typeof lucide !== 'undefined') {
      lucide.createIcons();
    }
  });

  document.addEventListener('DOMContentLoaded', () => {
    if (typeof lucide !== 'undefined') {
      lucide.createIcons();
    }
  });
</script>

<style>
  @keyframes pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.5; }
  }
</style>
