<div class="container-fluid py-4" data-controller="analytics-dashboard">
  <div class="row mb-4">
    <div class="col">
      <h1 class="h2">📊 Real-Time Analytics</h1>
      <p class="text-muted">Live performance metrics and insights</p>
    </div>
    <div class="col-auto">
      <span class="badge bg-success" data-analytics-dashboard-target="connectionStatus">
        <span class="spinner-grow spinner-grow-sm" role="status"></span>
        Connecting...
      </span>
    </div>
  </div>

  <!-- Key Metrics Cards -->
  <div class="row g-3 mb-4">
    <div class="col-md-3">
      <div class="card">
        <div class="card-body">
          <div class="d-flex justify-content-between align-items-center">
            <div>
              <p class="text-muted mb-1">Active Campaigns</p>
              <h3 class="mb-0" data-analytics-dashboard-target="campaignsActive"><%= @metrics[:campaigns_active] %></h3>
            </div>
            <div class="text-primary fs-3">📧</div>
          </div>
        </div>
      </div>
    </div>

    <div class="col-md-3">
      <div class="card">
        <div class="card-body">
          <div class="d-flex justify-content-between align-items-center">
            <div>
              <p class="text-muted mb-1">Emails Sent Today</p>
              <h3 class="mb-0" data-analytics-dashboard-target="emailsSentToday"><%= number_with_delimiter(@metrics[:emails_sent_today]) %></h3>
            </div>
            <div class="text-success fs-3">✉️</div>
          </div>
        </div>
      </div>
    </div>

    <div class="col-md-3">
      <div class="card">
        <div class="card-body">
          <div class="d-flex justify-content-between align-items-center">
            <div>
              <p class="text-muted mb-1">Opens (Last Hour)</p>
              <h3 class="mb-0" data-analytics-dashboard-target="opensLastHour"><%= @metrics[:opens_last_hour] %></h3>
              <small class="text-muted"><%= @metrics[:open_rate_last_hour] %>% rate</small>
            </div>
            <div class="text-info fs-3">👁️</div>
          </div>
        </div>
      </div>
    </div>

    <div class="col-md-3">
      <div class="card">
        <div class="card-body">
          <div class="d-flex justify-content-between align-items-center">
            <div>
              <p class="text-muted mb-1">Clicks (Last Hour)</p>
              <h3 class="mb-0" data-analytics-dashboard-target="clicksLastHour"><%= @metrics[:clicks_last_hour] %></h3>
              <small class="text-muted"><%= @metrics[:click_rate_last_hour] %>% rate</small>
            </div>
            <div class="text-warning fs-3">🖱️</div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="row g-3">
    <!-- Engagement Chart -->
    <div class="col-lg-8">
      <div class="card">
        <div class="card-header">
          <h5 class="mb-0">Email Engagement (Last Hour)</h5>
        </div>
        <div class="card-body">
          <canvas data-analytics-dashboard-target="engagementChart" height="80"></canvas>
        </div>
      </div>

      <!-- Engagement Heatmap -->
      <div class="card mt-3">
        <div class="card-header">
          <h5 class="mb-0">Engagement Heatmap (7 Days)</h5>
        </div>
        <div class="card-body">
          <canvas data-analytics-dashboard-target="heatmapChart" height="80"></canvas>
        </div>
      </div>
    </div>

    <!-- Activity Feed & Top Performers -->
    <div class="col-lg-4">
      <!-- Live Activity Feed -->
      <div class="card mb-3">
        <div class="card-header">
          <h5 class="mb-0">🔴 Live Activity</h5>
        </div>
        <div class="card-body p-0">
          <div class="list-group list-group-flush" data-analytics-dashboard-target="activityFeed" style="max-height: 300px; overflow-y: auto;">
            <div class="list-group-item text-center text-muted">
              <small>Loading activities...</small>
            </div>
          </div>
        </div>
      </div>

      <!-- Top Performers -->
      <div class="card">
        <div class="card-header">
          <h5 class="mb-0">🏆 Top Performers</h5>
        </div>
        <div class="card-body p-0">
          <div class="list-group list-group-flush" data-analytics-dashboard-target="topPerformers">
            <div class="list-group-item text-center text-muted">
              <small>Loading top performers...</small>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Additional Stats Row -->
  <div class="row g-3 mt-3">
    <div class="col-md-4">
      <div class="card">
        <div class="card-body">
          <h6 class="text-muted">Landing Pages</h6>
          <div class="d-flex justify-content-between">
            <div>
              <p class="mb-0">Visits Today</p>
              <h4 data-analytics-dashboard-target="landingPageVisits"><%= @metrics[:landing_page_visits_today] %></h4>
            </div>
            <div>
              <p class="mb-0">Conversions</p>
              <h4 data-analytics-dashboard-target="landingPageConversions"><%= @metrics[:landing_page_conversions_today] %></h4>
            </div>
            <div>
              <p class="mb-0">Rate</p>
              <h4 data-analytics-dashboard-target="conversionRate"><%= @metrics[:conversion_rate_today] %>%</h4>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="col-md-4">
      <div class="card">
        <div class="card-body">
          <h6 class="text-muted">Contacts</h6>
          <div class="d-flex justify-content-between">
            <div>
              <p class="mb-0">Total</p>
              <h4 data-analytics-dashboard-target="totalContacts"><%= number_with_delimiter(@metrics[:total_contacts]) %></h4>
            </div>
            <div>
              <p class="mb-0">Active (7d)</p>
              <h4 data-analytics-dashboard-target="activeContacts"><%= number_with_delimiter(@metrics[:active_contacts]) %></h4>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="col-md-4">
      <div class="card">
        <div class="card-body">
          <h6 class="text-muted">System Status</h6>
          <p class="mb-1">
            <span class="badge bg-success">All Systems Operational</span>
          </p>
          <small class="text-muted">
            Last updated: <span data-analytics-dashboard-target="lastUpdate">Just now</span>
          </small>
        </div>
      </div>
    </div>
  </div>
</div>
