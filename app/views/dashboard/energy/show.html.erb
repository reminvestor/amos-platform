<% content_for :title, "#{@agent.name} - Energy Details" %>

<div class="container-fluid py-4">
  <!-- Header -->
  <div class="d-flex justify-content-between align-items-center mb-4">
    <div>
      <%= link_to dashboard_energy_index_path, class: 'text-decoration-none' do %>
        <i class="bi bi-arrow-left"></i> Back to Dashboard
      <% end %>
      <h1 class="h3 mb-1 mt-2">
        <i class="bi bi-robot text-primary"></i>
        <%= @agent.name %>
      </h1>
      <p class="text-muted mb-0">
        <%= @agent.role.titleize %> •
        <% case @agent.status %>
        <% when 'active' %>
          <span class="badge bg-success">Active</span>
        <% when 'in_school' %>
          <span class="badge bg-warning text-dark">In School</span>
        <% when 'probation' %>
          <span class="badge bg-danger">Probation</span>
        <% else %>
          <span class="badge bg-secondary"><%= @agent.status %></span>
        <% end %>
      </p>
    </div>
    <div class="d-flex gap-2">
      <% unless @agent.in_school? %>
        <%= link_to dashboard_energy_enroll_in_school_path(@agent), method: :post, class: "btn btn-outline-warning", data: { confirm: 'Send this agent to school?' } do %>
          <i class="bi bi-mortarboard"></i> Send to School
        <% end %>
      <% end %>
    </div>
  </div>

  <div class="row">
    <!-- Main Content -->
    <div class="col-lg-8">
      <!-- Energy State Card -->
      <div class="card mb-4">
        <div class="card-header">
          <h5 class="mb-0">⚡ Energy State</h5>
        </div>
        <div class="card-body">
          <% if @energy_state %>
            <div class="row g-4">
              <div class="col-md-6">
                <h6 class="text-muted mb-2">Current Energy</h6>
                <div class="d-flex align-items-center gap-3">
                  <div class="display-4 <%= @energy_state.current_energy < 20 ? 'text-danger' : @energy_state.current_energy < 50 ? 'text-warning' : 'text-success' %>">
                    <%= @energy_state.current_energy.round(1) %>
                  </div>
                  <div class="text-muted">/ <%= @energy_state.max_energy.round(0) %></div>
                </div>
                <div class="progress mt-2" style="height: 10px;">
                  <% energy_pct = [(@energy_state.current_energy / @energy_state.max_energy * 100), 0].max %>
                  <% bar_class = energy_pct > 50 ? 'bg-success' : energy_pct > 20 ? 'bg-warning' : 'bg-danger' %>
                  <div class="progress-bar <%= bar_class %>" style="width: <%= energy_pct %>%"></div>
                </div>
                <% if @energy_state.in_debt? %>
                  <div class="alert alert-danger mt-2 mb-0 py-2">
                    <i class="bi bi-exclamation-triangle"></i>
                    In debt since <%= @energy_state.debt_started_at&.strftime('%b %d, %H:%M') %>
                  </div>
                <% end %>
              </div>
              <div class="col-md-6">
                <div class="row g-3">
                  <div class="col-6">
                    <div class="border rounded p-3 text-center">
                      <div class="h4 mb-0 text-success"><%= @energy_state.total_earned.round(1) %></div>
                      <small class="text-muted">Total Earned</small>
                    </div>
                  </div>
                  <div class="col-6">
                    <div class="border rounded p-3 text-center">
                      <div class="h4 mb-0 text-danger"><%= @energy_state.total_spent.round(1) %></div>
                      <small class="text-muted">Total Spent</small>
                    </div>
                  </div>
                  <div class="col-6">
                    <div class="border rounded p-3 text-center">
                      <div class="h4 mb-0"><%= @energy_state.elo_rating.round(0) %></div>
                      <small class="text-muted">Elo Rating</small>
                    </div>
                  </div>
                  <div class="col-6">
                    <div class="border rounded p-3 text-center">
                      <div class="h4 mb-0"><%= @energy_state.regeneration_rate %>/hr</div>
                      <small class="text-muted">Regen Rate</small>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          <% else %>
            <div class="text-center text-muted py-4">
              No energy state initialized for this agent
            </div>
          <% end %>
        </div>
      </div>

      <!-- Performance Stats -->
      <div class="card mb-4">
        <div class="card-header">
          <h5 class="mb-0">📊 Performance</h5>
        </div>
        <div class="card-body">
          <% if @energy_state %>
            <div class="row g-4">
              <div class="col-md-4 text-center">
                <div class="display-6 text-success"><%= @energy_state.tasks_completed %></div>
                <div class="text-muted">Tasks Completed</div>
              </div>
              <div class="col-md-4 text-center">
                <div class="display-6 text-danger"><%= @energy_state.tasks_failed %></div>
                <div class="text-muted">Tasks Failed</div>
              </div>
              <div class="col-md-4 text-center">
                <div class="display-6"><%= (@energy_state.success_rate * 100).round(1) %>%</div>
                <div class="text-muted">Success Rate</div>
              </div>
            </div>
            <hr>
            <div class="row g-4">
              <div class="col-md-4 text-center">
                <div class="h4 text-info"><%= @energy_state.help_given %></div>
                <div class="text-muted">Help Given</div>
              </div>
              <div class="col-md-4 text-center">
                <div class="h4 text-info"><%= @energy_state.help_received %></div>
                <div class="text-muted">Help Received</div>
              </div>
              <div class="col-md-4 text-center">
                <div class="h4"><%= (@energy_state.avg_quality * 100).round(0) %>%</div>
                <div class="text-muted">Avg Quality</div>
              </div>
            </div>
          <% else %>
            <div class="text-center text-muted py-4">No stats available</div>
          <% end %>
        </div>
      </div>

      <!-- Capability Beliefs -->
      <div class="card mb-4">
        <div class="card-header">
          <h5 class="mb-0">🎯 Capability Beliefs</h5>
        </div>
        <div class="card-body p-0">
          <% if @capability_beliefs.any? %>
            <div class="table-responsive">
              <table class="table mb-0">
                <thead class="table-light">
                  <tr>
                    <th>Task Type</th>
                    <th>Attempts</th>
                    <th>Success Rate</th>
                    <th>Avg Quality</th>
                    <th>Status</th>
                  </tr>
                </thead>
                <tbody>
                  <% @capability_beliefs.each do |belief| %>
                    <tr>
                      <td><%= belief.task_type.titleize %></td>
                      <td><%= belief.attempts %></td>
                      <td><%= (belief.success_rate * 100).round(1) %>%</td>
                      <td>
                        <div class="progress" style="height: 20px; width: 100px;">
                          <div class="progress-bar" style="width: <%= belief.avg_quality * 100 %>%">
                            <%= (belief.avg_quality * 100).round(0) %>%
                          </div>
                        </div>
                      </td>
                      <td>
                        <% if belief.is_specialty %>
                          <span class="badge bg-success">⭐ Specialty</span>
                        <% elsif belief.is_weakness %>
                          <span class="badge bg-danger">⚠️ Weakness</span>
                        <% else %>
                          <span class="badge bg-secondary">Normal</span>
                        <% end %>
                      </td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            </div>
          <% else %>
            <div class="text-center text-muted py-4">No capability beliefs recorded yet</div>
          <% end %>
        </div>
      </div>

      <!-- Recent Transactions -->
      <div class="card">
        <div class="card-header">
          <h5 class="mb-0">💰 Recent Transactions</h5>
        </div>
        <div class="card-body p-0">
          <div class="table-responsive" style="max-height: 400px; overflow-y: auto;">
            <table class="table table-sm mb-0">
              <thead class="table-light sticky-top">
                <tr>
                  <th>Time</th>
                  <th>Type</th>
                  <th>Amount</th>
                  <th>Balance</th>
                  <th>Reason</th>
                </tr>
              </thead>
              <tbody>
                <% @transactions.each do |tx| %>
                  <tr>
                    <td><small><%= tx.created_at.strftime('%b %d, %H:%M') %></small></td>
                    <td>
                      <% case tx.transaction_type %>
                      <% when 'earned', 'task_completion', 'helped_agent' %>
                        <span class="badge bg-success"><%= tx.transaction_type %></span>
                      <% when 'spent' %>
                        <span class="badge bg-info"><%= tx.transaction_type %></span>
                      <% when 'penalty', 'task_failure' %>
                        <span class="badge bg-danger"><%= tx.transaction_type %></span>
                      <% when 'regenerated' %>
                        <span class="badge bg-primary"><%= tx.transaction_type %></span>
                      <% else %>
                        <span class="badge bg-secondary"><%= tx.transaction_type %></span>
                      <% end %>
                    </td>
                    <td class="<%= tx.amount > 0 ? 'text-success' : 'text-danger' %>">
                      <%= tx.amount > 0 ? '+' : '' %><%= tx.amount.round(2) %>
                    </td>
                    <td><%= tx.balance_after.round(1) %></td>
                    <td><small><%= tx.reason %></small></td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>

    <!-- Sidebar -->
    <div class="col-lg-4">
      <!-- Decision Boundary -->
      <div class="card mb-4">
        <div class="card-header">
          <h5 class="mb-0">🤔 Decision Boundary</h5>
        </div>
        <div class="card-body">
          <% if @decision_boundary %>
            <div class="mb-3">
              <label class="text-muted">Current Threshold</label>
              <div class="h3"><%= @decision_boundary.current_threshold.round(1) %>%</div>
              <small class="text-muted">Confidence below this = ask for help</small>
            </div>
            <div class="row g-2">
              <div class="col-6">
                <div class="border rounded p-2 text-center">
                  <div class="h5 mb-0"><%= (@decision_boundary.ask_tendency * 100).round(0) %>%</div>
                  <small class="text-muted">Ask Tendency</small>
                </div>
              </div>
              <div class="col-6">
                <div class="border rounded p-2 text-center">
                  <div class="h5 mb-0"><%= (@decision_boundary.solo_tendency * 100).round(0) %>%</div>
                  <small class="text-muted">Solo Tendency</small>
                </div>
              </div>
            </div>
            <div class="mt-3">
              <div class="d-flex justify-content-between">
                <span>Decision Accuracy</span>
                <span><%= (@decision_boundary.accuracy * 100).round(1) %>%</span>
              </div>
              <div class="progress mt-1" style="height: 8px;">
                <div class="progress-bar" style="width: <%= @decision_boundary.accuracy * 100 %>%"></div>
              </div>
            </div>
          <% else %>
            <div class="text-muted text-center py-3">No decision boundary data</div>
          <% end %>
        </div>
      </div>

      <!-- Relationships -->
      <div class="card mb-4">
        <div class="card-header">
          <h5 class="mb-0">🤝 Relationships</h5>
        </div>
        <div class="list-group list-group-flush">
          <% if @relationships.any? %>
            <% @relationships.first(10).each do |rel| %>
              <% other = rel.requester_id == @agent.id ? rel.helper : rel.requester %>
              <% direction = rel.requester_id == @agent.id ? 'Helps me' : 'I help' %>
              <div class="list-group-item">
                <div class="d-flex justify-content-between">
                  <div>
                    <strong><%= other.name %></strong>
                    <br><small class="text-muted"><%= direction %></small>
                  </div>
                  <div class="text-end">
                    <div class="h6 mb-0"><%= (rel.compatibility_score * 100).round(0) %>%</div>
                    <small class="text-muted">compatibility</small>
                  </div>
                </div>
              </div>
            <% end %>
          <% else %>
            <div class="list-group-item text-muted text-center py-3">
              No relationships yet
            </div>
          <% end %>
        </div>
      </div>

      <!-- School History -->
      <div class="card mb-4">
        <div class="card-header">
          <h5 class="mb-0">🎓 School History</h5>
        </div>
        <div class="list-group list-group-flush">
          <% if @school_history.any? %>
            <% @school_history.each do |enrollment| %>
              <div class="list-group-item">
                <div class="d-flex justify-content-between">
                  <div>
                    <strong>Attempt #<%= enrollment.attempt_number %></strong>
                    <br><small class="text-muted"><%= enrollment.enrollment_reason %></small>
                  </div>
                  <div>
                    <% case enrollment.outcome %>
                    <% when 'success' %>
                      <span class="badge bg-success">Graduated</span>
                    <% when 'failure' %>
                      <span class="badge bg-danger">Expelled</span>
                    <% when 'irreplaceable_failure' %>
                      <span class="badge bg-warning text-dark">Probation</span>
                    <% else %>
                      <span class="badge bg-info"><%= enrollment.status %></span>
                    <% end %>
                  </div>
                </div>
              </div>
            <% end %>
          <% else %>
            <div class="list-group-item text-muted text-center py-3">
              Never enrolled in school
            </div>
          <% end %>
        </div>
      </div>

      <!-- Recent Collaborations -->
      <div class="card">
        <div class="card-header">
          <h5 class="mb-0">💬 Recent Collaborations</h5>
        </div>
        <div class="list-group list-group-flush" style="max-height: 300px; overflow-y: auto;">
          <% collaborations = (@collaborations_made + @collaborations_received).sort_by(&:created_at).reverse.first(10) %>
          <% if collaborations.any? %>
            <% collaborations.each do |collab| %>
              <% is_requester = collab.requesting_agent_id == @agent.id %>
              <div class="list-group-item">
                <div class="d-flex justify-content-between align-items-start">
                  <div>
                    <% if is_requester %>
                      <small class="text-muted">Asked</small>
                      <strong><%= collab.helper_agent&.name || 'Unknown' %></strong>
                    <% else %>
                      <small class="text-muted">Helped</small>
                      <strong><%= collab.requesting_agent&.name || 'Unknown' %></strong>
                    <% end %>
                    <br>
                    <small><%= collab.request_type %> • <%= collab.description&.truncate(50) %></small>
                  </div>
                  <span class="badge bg-<%= collab.was_helpful ? 'success' : collab.was_helpful == false ? 'danger' : 'secondary' %>">
                    <%= collab.status %>
                  </span>
                </div>
              </div>
            <% end %>
          <% else %>
            <div class="list-group-item text-muted text-center py-3">
              No collaborations yet
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>

