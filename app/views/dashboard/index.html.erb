
<div class="container-fluid py-4">
  <%# Page Header %>
  <div class="admin-page-header">
    <div class="header-left">
      <div class="header-icon" style="background: linear-gradient(135deg, #7C3AED 0%, #A78BFA 100%);">
        <i data-lucide="layout-dashboard"></i>
      </div>
      <div class="header-text">
        <h1>Dashboard</h1>
        <p><%= current_user.sign_in_count > 1 ? "Welcome back" : "Welcome" %>, <%= current_user.first_name %>! Here's your business overview.</p>
      </div>
    </div>
  </div>

  <%# Quick Stats %>
  <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1.5rem; margin-bottom: 2rem;">
    <%# Campaigns %>
    <div class="admin-card" style="position: relative;">
      <div style="display: flex; align-items: center; gap: 1rem;">
        <div style="width: 3rem; height: 3rem; border-radius: 0.75rem; background: linear-gradient(135deg, #7C3AED 0%, #A78BFA 100%); display: flex; align-items: center; justify-content: center;">
          <i data-lucide="mail" class="icon-xl text-white"></i>
        </div>
        <div>
          <p style="color: #94A3B8; font-size: 0.875rem; margin: 0;">Campaigns</p>
          <h3 style="color: white; font-size: 1.875rem; font-weight: 600; margin: 0;"><%= @campaigns_count %></h3>
        </div>
      </div>
      <%= link_to campaigns_path, style: "position: absolute; bottom: 1rem; right: 1rem; color: #22D3EE; font-size: 0.875rem; text-decoration: none;" do %>
        <span>View All</span>
        <i data-lucide="chevron-right" class="icon-sm"></i>
      <% end %>
    </div>

    <%# Contacts %>
    <div class="admin-card" style="position: relative;">
      <div style="display: flex; align-items: center; gap: 1rem;">
        <div style="width: 3rem; height: 3rem; border-radius: 0.75rem; background: rgba(34, 197, 94, 0.1); display: flex; align-items: center; justify-content: center; border: 1px solid rgba(34, 197, 94, 0.2);">
          <i data-lucide="users" class="icon-xl text-success"></i>
        </div>
        <div>
          <p style="color: #94A3B8; font-size: 0.875rem; margin: 0;">Contacts</p>
          <h3 style="color: white; font-size: 1.875rem; font-weight: 600; margin: 0;"><%= @contacts_count %></h3>
        </div>
      </div>
      <%= link_to contacts_path, style: "position: absolute; bottom: 1rem; right: 1rem; color: #22D3EE; font-size: 0.875rem; text-decoration: none;" do %>
        <span>View All</span>
        <i data-lucide="chevron-right" class="icon-sm"></i>
      <% end %>
    </div>

    <%# Landing Pages %>
    <div class="admin-card" style="position: relative;">
      <div style="display: flex; align-items: center; gap: 1rem;">
        <div style="width: 3rem; height: 3rem; border-radius: 0.75rem; background: rgba(34, 211, 238, 0.1); display: flex; align-items: center; justify-content: center; border: 1px solid rgba(34, 211, 238, 0.2);">
          <i data-lucide="layout" class="icon-xl text-info"></i>
        </div>
        <div>
          <p style="color: #94A3B8; font-size: 0.875rem; margin: 0;">Landing Pages</p>
          <h3 style="color: white; font-size: 1.875rem; font-weight: 600; margin: 0;"><%= @landing_pages_count %></h3>
        </div>
      </div>
      <%= link_to landing_pages_path, style: "position: absolute; bottom: 1rem; right: 1rem; color: #22D3EE; font-size: 0.875rem; text-decoration: none;" do %>
        <span>View All</span>
        <i data-lucide="chevron-right" class="icon-sm"></i>
      <% end %>
    </div>

    <%# Email Templates %>
    <div class="admin-card" style="position: relative;">
      <div style="display: flex; align-items: center; gap: 1rem;">
        <div style="width: 3rem; height: 3rem; border-radius: 0.75rem; background: rgba(234, 179, 8, 0.1); display: flex; align-items: center; justify-content: center; border: 1px solid rgba(234, 179, 8, 0.2);">
          <i data-lucide="file-text" class="icon-xl text-warning"></i>
        </div>
        <div>
          <p style="color: #94A3B8; font-size: 0.875rem; margin: 0;">Email Templates</p>
          <h3 style="color: white; font-size: 1.875rem; font-weight: 600; margin: 0;"><%= @email_templates_count %></h3>
        </div>
      </div>
      <%= link_to email_templates_path, style: "position: absolute; bottom: 1rem; right: 1rem; color: #22D3EE; font-size: 0.875rem; text-decoration: none;" do %>
        <span>View All</span>
        <i data-lucide="chevron-right" class="icon-sm"></i>
      <% end %>
    </div>
  </div>

  <%# AI Usage Stats %>
  <div class="admin-card" style="margin-bottom: 2rem;">
    <div style="display: flex; justify-content: between; align-items: center; padding-bottom: 1rem; border-bottom: 1px solid #1E293B; margin-bottom: 1.5rem;">
      <div style="display: flex; align-items: center; gap: 0.75rem;">
        <div style="width: 2.5rem; height: 2.5rem; border-radius: 0.5rem; background: rgba(34, 211, 238, 0.1); display: flex; align-items: center; justify-content: center; border: 1px solid rgba(34, 211, 238, 0.2);">
          <i data-lucide="bot" class="icon-xl text-info"></i>
        </div>
        <div>
          <h4 style="color: white; font-size: 1.25rem; font-weight: 600; margin: 0;">Your AI Usage</h4>
          <p style="color: #64748B; font-size: 0.875rem; margin: 0;">Last 30 Days</p>
        </div>
      </div>
    </div>

    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 1.5rem; text-align: center;">
      <div>
        <div style="color: #A78BFA; font-size: 2rem; font-weight: 600; margin-bottom: 0.25rem;"><%= @ai_usage[:conversations_this_month] %></div>
        <div style="color: #94A3B8; font-size: 0.875rem;">Conversations</div>
      </div>
      <div>
        <div style="color: #22D3EE; font-size: 2rem; font-weight: 600; margin-bottom: 0.25rem;"><%= @ai_usage[:messages_this_month] %></div>
        <div style="color: #94A3B8; font-size: 0.875rem;">Messages</div>
      </div>
      <div>
        <div style="color: rgb(74, 222, 128); font-size: 2rem; font-weight: 600; margin-bottom: 0.25rem;"><%= @ai_usage[:workflows_this_month] %></div>
        <div style="color: #94A3B8; font-size: 0.875rem;">Workflows</div>
      </div>
      <div>
        <div style="color: rgb(250, 204, 21); font-size: 2rem; font-weight: 600; margin-bottom: 0.25rem;"><%= number_with_delimiter(@ai_usage[:estimated_tokens]) %></div>
        <div style="color: #94A3B8; font-size: 0.875rem;">Est. Tokens</div>
      </div>
      <div>
        <div style="color: rgb(74, 222, 128); font-size: 2rem; font-weight: 600; margin-bottom: 0.25rem;">$<%= @ai_usage[:estimated_cost] %></div>
        <div style="color: #94A3B8; font-size: 0.875rem;">Est. Cost</div>
      </div>
      <div>
        <div style="color: #A78BFA; font-size: 2rem; font-weight: 600; margin-bottom: 0.25rem;"><%= @ai_usage[:workflows_completed] %></div>
        <div style="color: #94A3B8; font-size: 0.875rem;">Completed</div>
      </div>
    </div>
  </div>

  <%# Active Integrations %>
  <% if @active_connections.any? %>
    <div class="admin-card" style="margin-bottom: 2rem;">
      <div style="display: flex; justify-content: space-between; align-items: center; padding-bottom: 1rem; border-bottom: 1px solid #1E293B; margin-bottom: 1.5rem;">
        <div style="display: flex; align-items: center; gap: 0.75rem;">
          <div style="width: 2.5rem; height: 2.5rem; border-radius: 0.5rem; background: rgba(34, 197, 94, 0.1); display: flex; align-items: center; justify-content: center; border: 1px solid rgba(34, 197, 94, 0.2);">
            <i data-lucide="plug" class="icon-xl text-success"></i>
          </div>
          <h4 style="color: white; font-size: 1.25rem; font-weight: 600; margin: 0;">Active Integrations</h4>
        </div>
        <%= link_to social_media_accounts_path, class: "admin-btn admin-btn-sm admin-btn-outline" do %>
          <span>Manage</span>
        <% end %>
      </div>

      <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 1rem;">
        <% @active_connections.each do |connection| %>
          <div style="display: flex; align-items: center; gap: 0.75rem;">
            <% if connection.integration.icon_url.present? %>
              <img src="<%= connection.integration.icon_url %>"
                   alt="<%= connection.integration.name %>"
                   style="width: 24px; height: 24px; border-radius: 0.25rem;">
            <% else %>
              <i data-lucide="box" style="width: 1.5rem; height: 1.5rem; color: #64748B;"></i>
            <% end %>
            <div>
              <div style="color: white; font-weight: 600; font-size: 0.875rem;"><%= connection.integration.name %></div>
              <div style="color: #64748B; font-size: 0.75rem;"><%= connection.name %></div>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>

  <%# Recent Activity %>
  <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(400px, 1fr)); gap: 1.5rem; margin-bottom: 2rem;">
    <%# Recent Campaigns %>
    <div class="admin-card">
      <div style="display: flex; justify-content: space-between; align-items: center; padding-bottom: 1rem; border-bottom: 1px solid #1E293B; margin-bottom: 1rem;">
        <div style="display: flex; align-items: center; gap: 0.5rem;">
          <i data-lucide="mail" style="width: 1.25rem; height: 1.25rem; color: #A78BFA;"></i>
          <h5 style="color: white; font-weight: 600; margin: 0;">Recent Campaigns</h5>
        </div>
        <%= link_to "View All", campaigns_path, style: "color: #22D3EE; font-size: 0.875rem; text-decoration: none;" %>
      </div>

      <% if @recent_campaigns.any? %>
        <div style="display: flex; flex-direction: column; gap: 0.75rem;">
          <% @recent_campaigns.each do |campaign| %>
            <div style="display: flex; justify-content: space-between; align-items: center; padding: 0.75rem; background: #0F172A; border-radius: 0.5rem;">
              <div style="flex: 1;">
                <%= link_to campaign.name, campaign_path(campaign), style: "color: #22D3EE; text-decoration: none; font-weight: 600;" %>
                <div style="color: #64748B; font-size: 0.875rem; margin-top: 0.25rem;">
                  <%= campaign.status.titleize %> • <%= time_ago_in_words(campaign.created_at) %> ago
                </div>
              </div>
              <% if campaign.status == 'sent' %>
                <span class="admin-badge admin-badge-online">Sent</span>
              <% else %>
                <span class="admin-badge admin-badge-default"><%= campaign.status.titleize %></span>
              <% end %>
            </div>
          <% end %>
        </div>
      <% else %>
        <p style="color: #64748B; text-align: center; padding: 2rem 0;">No campaigns yet</p>
      <% end %>
    </div>

    <%# Recent Landing Pages %>
    <div class="admin-card">
      <div style="display: flex; justify-content: space-between; align-items: center; padding-bottom: 1rem; border-bottom: 1px solid #1E293B; margin-bottom: 1rem;">
        <div style="display: flex; align-items: center; gap: 0.5rem;">
          <i data-lucide="layout" class="icon-lg text-info"></i>
          <h5 style="color: white; font-weight: 600; margin: 0;">Recent Landing Pages</h5>
        </div>
        <%= link_to "View All", landing_pages_path, style: "color: #22D3EE; font-size: 0.875rem; text-decoration: none;" %>
      </div>

      <% if @recent_landing_pages.any? %>
        <div style="display: flex; flex-direction: column; gap: 0.75rem;">
          <% @recent_landing_pages.each do |page| %>
            <div style="display: flex; justify-content: space-between; align-items: center; padding: 0.75rem; background: #0F172A; border-radius: 0.5rem;">
              <div style="flex: 1;">
                <%= link_to page.title, preview_landing_page_path(page), target: "_blank", style: "color: #22D3EE; text-decoration: none; font-weight: 600;" %>
                <div style="color: #64748B; font-size: 0.875rem; margin-top: 0.25rem;">
                  <%= page.slug %> • <%= time_ago_in_words(page.created_at) %> ago
                </div>
              </div>
              <% if page.status == 'published' %>
                <span class="admin-badge admin-badge-online">Published</span>
              <% else %>
                <span class="admin-badge admin-badge-warning">Draft</span>
              <% end %>
            </div>
          <% end %>
        </div>
      <% else %>
        <p style="color: #64748B; text-align: center; padding: 2rem 0;">No landing pages yet</p>
      <% end %>
    </div>
  </div>

  <%# Quick Actions & Referral Program %>
  <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(400px, 1fr)); gap: 1.5rem; margin-bottom: 2rem;">
    <%# Quick Actions %>
    <div class="admin-card">
      <div style="display: flex; align-items: center; gap: 0.75rem; padding-bottom: 1rem; border-bottom: 1px solid #1E293B; margin-bottom: 1.5rem;">
        <div style="width: 2.5rem; height: 2.5rem; border-radius: 0.5rem; background: rgba(234, 179, 8, 0.1); display: flex; align-items: center; justify-content: center; border: 1px solid rgba(234, 179, 8, 0.2);">
          <i data-lucide="zap" class="icon-xl text-warning"></i>
        </div>
        <h4 style="color: white; font-size: 1.25rem; font-weight: 600; margin: 0;">Quick Actions</h4>
      </div>

      <div style="display: grid; grid-template-columns: repeat(2, 1fr); gap: 1rem;">
        <%= link_to new_campaign_path, class: "admin-btn admin-btn-outline", style: "width: 100%;" do %>
          <i data-lucide="mail"></i>
          <span>New Campaign</span>
        <% end %>
        <%= link_to new_landing_page_path, class: "admin-btn admin-btn-outline", style: "width: 100%;" do %>
          <i data-lucide="layout"></i>
          <span>New Landing Page</span>
        <% end %>
        <%= link_to new_contact_path, class: "admin-btn admin-btn-outline", style: "width: 100%;" do %>
          <i data-lucide="user-plus"></i>
          <span>Add Contact</span>
        <% end %>
        <%= link_to chat_mode_path, class: "admin-btn admin-btn-outline", style: "width: 100%;" do %>
          <i data-lucide="message-circle"></i>
          <span>Chat with AMOS</span>
        <% end %>
      </div>
    </div>

    <%# Referral Program - Pool-Based Rewards %>
    <div class="admin-card" style="background: linear-gradient(135deg, rgba(59, 130, 246, 0.1) 0%, rgba(139, 92, 246, 0.1) 100%); border-color: rgba(99, 102, 241, 0.3);">
      <div style="display: flex; align-items: center; gap: 0.75rem; padding-bottom: 1rem; border-bottom: 1px solid rgba(99, 102, 241, 0.2); margin-bottom: 1.5rem;">
        <div style="width: 2.5rem; height: 2.5rem; border-radius: 0.5rem; background: linear-gradient(135deg, #3B82F6 0%, #8B5CF6 100%); display: flex; align-items: center; justify-content: center;">
          <i data-lucide="gift" class="icon-xl text-white"></i>
        </div>
        <div>
          <h4 style="color: white; font-size: 1.25rem; font-weight: 600; margin: 0;">Refer Friends & Earn AMOS</h4>
          <p style="color: #94A3B8; font-size: 0.875rem; margin: 0;">Earn your share of the daily token pool!</p>
        </div>
      </div>

      <div style="display: flex; flex-direction: column; gap: 1rem;">
        <div style="display: flex; align-items: start; gap: 0.75rem;">
          <div style="width: 1.5rem; height: 1.5rem; border-radius: 50%; background: #3B82F6; display: flex; align-items: center; justify-content: center; flex-shrink: 0; font-size: 0.75rem; color: white; font-weight: 600;">1</div>
          <div>
            <div style="color: white; font-weight: 500;">Send referral invitations</div>
            <div style="color: #94A3B8; font-size: 0.875rem;">Earn <span style="color: #FACC15; font-weight: 600;">1 point</span> per email sent</div>
          </div>
        </div>
        <div style="display: flex; align-items: start; gap: 0.75rem;">
          <div style="width: 1.5rem; height: 1.5rem; border-radius: 50%; background: #22C55E; display: flex; align-items: center; justify-content: center; flex-shrink: 0; font-size: 0.75rem; color: white; font-weight: 600;">2</div>
          <div>
            <div style="color: white; font-weight: 500;">When they sign up</div>
            <div style="color: #94A3B8; font-size: 0.875rem;">Earn <span style="color: #22C55E; font-weight: 600;">5 bonus points</span></div>
          </div>
        </div>
        <div style="display: flex; align-items: start; gap: 0.75rem;">
          <div style="width: 1.5rem; height: 1.5rem; border-radius: 50%; background: #8B5CF6; display: flex; align-items: center; justify-content: center; flex-shrink: 0; font-size: 0.75rem; color: white; font-weight: 600;">3</div>
          <div>
            <div style="color: white; font-weight: 500;">When they convert to paid</div>
            <div style="color: #94A3B8; font-size: 0.875rem;">Earn <span style="color: #8B5CF6; font-weight: 600;">10 bonus points</span></div>
          </div>
        </div>
      </div>

      <div style="margin-top: 1.5rem; padding: 0.75rem; background: rgba(255, 255, 255, 0.05); border-radius: 0.5rem;">
        <div style="display: flex; justify-content: space-between; align-items: center;">
          <span style="color: #94A3B8; font-size: 0.875rem;">Daily Token Pool:</span>
          <span style="color: white; font-weight: 600;"><%= number_with_delimiter(ContributionRewardCalculator.current_daily_emission.to_i) %> AMOS</span>
        </div>
        <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 0.25rem;">
          <span style="color: #94A3B8; font-size: 0.875rem;">Your share:</span>
          <span style="color: #22C55E; font-weight: 600;">Your Points ÷ Total Points</span>
        </div>
      </div>

      <div style="margin-top: 0.75rem; padding: 0.5rem; background: rgba(250, 204, 21, 0.1); border-radius: 0.375rem; border: 1px solid rgba(250, 204, 21, 0.2);">
        <p style="color: #FACC15; font-size: 0.75rem; margin: 0; text-align: center;">
          <i data-lucide="info" style="width: 12px; height: 12px; display: inline-block; vertical-align: middle;"></i>
          No fixed amounts – your tokens depend on your contribution relative to others!
        </p>
      </div>

      <div style="margin-top: 1rem; text-align: center;">
        <button type="button" class="admin-btn admin-btn-primary" data-bs-toggle="modal" data-bs-target="#referralModal" style="width: 100%;">
          <i data-lucide="share-2"></i>
          <span>Start Referring</span>
        </button>
      </div>
    </div>
  </div>
</div>

<%# Referral Modal - Theme Aware %>
<div class="modal fade" id="referralModal" tabindex="-1" aria-labelledby="referralModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="referralModalLabel">
          <i data-lucide="gift" style="width: 20px; height: 20px;" class="me-2 text-info"></i>
          Refer Friends & Earn Tokens
        </h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <div class="alert alert-info mb-4">
          <div class="d-flex align-items-center gap-2">
            <i data-lucide="info" style="width: 16px; height: 16px;"></i>
            <span>Earn <strong>1 point</strong> per invite, <strong>5 points</strong> when they sign up, <strong>10 points</strong> when they convert! Points earn you a share of the daily <strong><%= number_with_delimiter(ContributionRewardCalculator.current_daily_emission.to_i) %> AMOS</strong> pool.</span>
          </div>
        </div>

        <form id="referral-form">
          <div class="mb-3">
            <label class="form-label">Friend's Email #1</label>
            <input type="email" class="form-control" name="email_1" placeholder="friend@example.com">
          </div>
          <div class="mb-3">
            <label class="form-label">Friend's Email #2 <span class="text-muted">(optional)</span></label>
            <input type="email" class="form-control" name="email_2" placeholder="friend@example.com">
          </div>
          <div class="mb-3">
            <label class="form-label">Friend's Email #3 <span class="text-muted">(optional)</span></label>
            <input type="email" class="form-control" name="email_3" placeholder="friend@example.com">
          </div>
          <div class="mb-3">
            <label class="form-label">Friend's Email #4 <span class="text-muted">(optional)</span></label>
            <input type="email" class="form-control" name="email_4" placeholder="friend@example.com">
          </div>
          <div class="mb-3">
            <label class="form-label">Friend's Email #5 <span class="text-muted">(optional)</span></label>
            <input type="email" class="form-control" name="email_5" placeholder="friend@example.com">
          </div>
        </form>

        <div class="p-3 rounded mb-3" style="background: rgba(34, 197, 94, 0.1); border: 1px solid rgba(34, 197, 94, 0.2);">
          <div class="d-flex justify-content: space-between; align-items-center small">
            <span class="text-body-secondary">Points you'll earn:</span>
            <span class="text-success fw-bold" id="referral-token-count">0 points</span>
          </div>
          <div class="text-body-secondary small mt-1" style="font-size: 0.75rem;">
            Points convert to AMOS tokens based on your share of today's pool
          </div>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="button" class="btn btn-primary" id="submit-referrals" disabled>
          <i data-lucide="send" style="width: 14px; height: 14px;" class="me-1"></i>
          Send Invitations
        </button>
      </div>
    </div>
  </div>
</div>

<script>
  document.addEventListener('turbo:load', () => {
    if (typeof lucide !== 'undefined') {
      lucide.createIcons();
    }
    initReferralForm();
  });

  document.addEventListener('DOMContentLoaded', () => {
    if (typeof lucide !== 'undefined') {
      lucide.createIcons();
    }
  });

  // Referral form handling - use IIFE to avoid Turbo redeclaration errors
  (function() {
    if (window._dashboardReferralFormInitialized) {
      console.log('📧 Referral form already initialized, skipping');
      return;
    }
    
    function initReferralForm() {
      const form = document.getElementById('referral-form');
      const tokenCount = document.getElementById('referral-token-count');
      const submitBtn = document.getElementById('submit-referrals');
      
      if (!form || !tokenCount || !submitBtn) return;
      
      window._dashboardReferralFormInitialized = true;
      console.log('📧 Initializing referral form');
    
    const emailInputs = form.querySelectorAll('input[type="email"]');
    
    function updateTokenCount() {
      let validEmails = 0;
      emailInputs.forEach(input => {
        if (input.value && input.value.includes('@') && input.value.includes('.')) {
          validEmails++;
        }
      });
      
      // Pool-based: 1 point per email sent (signups/conversions earn more later)
      const points = validEmails * 1;
      tokenCount.textContent = points + ' points';
      submitBtn.disabled = validEmails === 0;
    }
    
    emailInputs.forEach(input => {
      input.addEventListener('input', updateTokenCount);
    });

    submitBtn.addEventListener('click', async function() {
      const emails = [];
      emailInputs.forEach(input => {
        if (input.value && input.value.includes('@')) {
          emails.push(input.value.trim());
        }
      });
      
      if (emails.length === 0) return;
      
      submitBtn.disabled = true;
      submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Sending...';
      
      try {
        console.log('📧 Submitting referrals:', emails);
        const csrfToken = document.querySelector('meta[name="csrf-token"]')?.content || 
                          document.querySelector('input[name="authenticity_token"]')?.value || '';
        const response = await fetch('/referrals', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'X-CSRF-Token': csrfToken
          },
          body: JSON.stringify({ emails: emails })
        });
        
        console.log('📧 Response status:', response.status);
        
        if (response.ok) {
          const data = await response.json();
          console.log('📧 Success:', data);
          const modal = bootstrap.Modal.getInstance(document.getElementById('referralModal'));
          modal.hide();
          
          // Show success message - pool-based rewards
          showSuccess('Invitations sent! You earned ' + emails.length + ' points. Your AMOS tokens will be calculated based on your share of the daily pool!');
          
          // Reset form
          emailInputs.forEach(input => input.value = '');
          updateTokenCount();
        } else {
          const text = await response.text();
          console.log('📧 Error response:', text);
          try {
            const data = JSON.parse(text);
            showError(data.error || 'Failed to send invitations. Please try again.');
          } catch (e) {
            showError('Server error: ' + response.status);
          }
        }
      } catch (error) {
        console.error('📧 Fetch error:', error);
        showError('Network error: ' + error.message);
      } finally {
        submitBtn.disabled = false;
        submitBtn.innerHTML = '<i data-lucide="send" style="width: 14px; height: 14px;" class="me-1"></i> Send Invitations';
        if (typeof lucide !== 'undefined') lucide.createIcons();
      }
    });
    }
    
    document.addEventListener('DOMContentLoaded', initReferralForm);
    document.addEventListener('turbo:load', initReferralForm);
  })();
</script>
