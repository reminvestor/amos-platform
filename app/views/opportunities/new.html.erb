<div class="container-fluid py-4">
  <div class="admin-page-header">
    <div class="header-left">
      <%= link_to opportunities_path, class: "admin-btn admin-btn-secondary", style: "margin-right: 1rem;" do %>
        <i data-lucide="arrow-left"></i>
      <% end %>
      <div class="header-icon" style="background: linear-gradient(135deg, #10B981 0%, #34D399 100%);">
        <i data-lucide="target"></i>
      </div>
      <div class="header-text">
        <h1>New Opportunity</h1>
        <p>Create a new sales opportunity</p>
      </div>
    </div>
  </div>

  <div class="admin-card">
  <div class="admin-card-body">
    <%= form_with model: @opportunity, local: true do |f| %>
      <% if @opportunity.errors.any? %>
        <div class="alert alert-danger mb-4">
          <h4><%= pluralize(@opportunity.errors.count, "error") %> prevented this opportunity from being saved:</h4>
          <ul class="mb-0">
            <% @opportunity.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem;">
        <div>
          <div class="mb-3">
            <%= f.label :name, "Opportunity Name", class: "form-label" %>
            <%= f.text_field :name, class: "form-control", placeholder: "e.g., Enterprise Deal - Acme Corp" %>
          </div>

          <div class="mb-3">
            <%= f.label :contact_id, "Contact", class: "form-label" %>
            <%= f.select :contact_id, @contacts.map { |c| ["#{c.full_name} (#{c.email})", c.id] }, 
                { prompt: "Select a contact..." }, class: "form-select" %>
          </div>

          <div class="mb-3">
            <%= f.label :value, "Deal Value", class: "form-label" %>
            <div class="input-group">
              <span class="input-group-text">$</span>
              <%= f.number_field :value, class: "form-control", step: "0.01", placeholder: "0.00" %>
            </div>
          </div>

          <div class="mb-3">
            <%= f.label :source, "Lead Source", class: "form-label" %>
            <%= f.select :source, Opportunity::SOURCES.map { |s| [s.titleize, s] },
                { prompt: "Select source..." }, class: "form-select" %>
          </div>
        </div>

        <div>
          <div class="mb-3">
            <%= f.label :stage, "Pipeline Stage", class: "form-label" %>
            <%= f.select :stage, Opportunity::STAGES.reject { |k,v| k.in?(['closed_won', 'closed_lost']) }.map { |k, v| [v[:label], k] },
                {}, class: "form-select" %>
          </div>

          <div class="mb-3">
            <%= f.label :probability, "Win Probability (%)", class: "form-label" %>
            <%= f.number_field :probability, class: "form-control", min: 0, max: 100, step: 5 %>
          </div>

          <div class="mb-3">
            <%= f.label :expected_close_date, "Expected Close Date", class: "form-label" %>
            <%= f.date_field :expected_close_date, class: "form-control" %>
          </div>

          <div class="mb-3">
            <%= f.label :user_id, "Assigned To", class: "form-label" %>
            <%= f.select :user_id, @users.map { |u| [u.full_name, u.id] },
                { prompt: "Select owner..." }, class: "form-select" %>
          </div>
        </div>
      </div>

      <div class="mb-3">
        <%= f.label :notes, "Notes", class: "form-label" %>
        <%= f.text_area :notes, class: "form-control", rows: 3, placeholder: "Additional details about this opportunity..." %>
      </div>

      <div class="d-flex gap-2">
        <%= f.submit "Create Opportunity", class: "admin-btn admin-btn-primary" %>
        <%= link_to "Cancel", opportunities_path, class: "admin-btn admin-btn-secondary" %>
      </div>
    <% end %>
  </div>
</div>

</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
  if (typeof lucide !== 'undefined') {
    lucide.createIcons();
  }
});
</script>
