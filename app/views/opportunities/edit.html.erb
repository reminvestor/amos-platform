<div class="page-header">
  <div class="header-left">
    <%= link_to opportunity_path(@opportunity), class: "admin-btn admin-btn-secondary", style: "margin-right: 1rem;" do %>
      <i data-lucide="arrow-left"></i>
    <% end %>
    <div class="header-icon" style="background: linear-gradient(135deg, #10B981 0%, #34D399 100%);">
      <i data-lucide="pencil"></i>
    </div>
    <div class="header-text">
      <h1>Edit Opportunity</h1>
      <p><%= @opportunity.name %></p>
    </div>
  </div>
</div>

<div class="admin-card">
  <div class="admin-card-body">
    <%= form_with model: @opportunity, local: true do |f| %>
      <% if @opportunity.errors.any? %>
        <div class="alert alert-danger mb-4">
          <h4><%= pluralize(@opportunity.errors.count, "error") %> prevented this opportunity from being saved:</h4>
          <ul class="mb-0">
            <% @opportunity.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem;">
        <div>
          <div class="mb-3">
            <%= f.label :name, "Opportunity Name", class: "form-label" %>
            <%= f.text_field :name, class: "form-control" %>
          </div>

          <div class="mb-3">
            <%= f.label :contact_id, "Contact", class: "form-label" %>
            <%= f.select :contact_id, @contacts.map { |c| ["#{c.full_name} (#{c.email})", c.id] }, 
                {}, class: "form-select" %>
          </div>

          <div class="mb-3">
            <%= f.label :value, "Deal Value", class: "form-label" %>
            <div class="input-group">
              <span class="input-group-text">$</span>
              <%= f.number_field :value, class: "form-control", step: "0.01" %>
            </div>
          </div>

          <div class="mb-3">
            <%= f.label :source, "Lead Source", class: "form-label" %>
            <%= f.select :source, Opportunity::SOURCES.map { |s| [s.titleize, s] },
                { include_blank: "Select source..." }, class: "form-select" %>
          </div>
        </div>

        <div>
          <div class="mb-3">
            <%= f.label :stage, "Pipeline Stage", class: "form-label" %>
            <%= f.select :stage, Opportunity::STAGES.map { |k, v| [v[:label], k] },
                {}, class: "form-select" %>
          </div>

          <div class="mb-3">
            <%= f.label :probability, "Win Probability (%)", class: "form-label" %>
            <%= f.number_field :probability, class: "form-control", min: 0, max: 100, step: 5 %>
          </div>

          <div class="mb-3">
            <%= f.label :expected_close_date, "Expected Close Date", class: "form-label" %>
            <%= f.date_field :expected_close_date, class: "form-control" %>
          </div>

          <div class="mb-3">
            <%= f.label :user_id, "Assigned To", class: "form-label" %>
            <%= f.select :user_id, @users.map { |u| [u.full_name, u.id] },
                { include_blank: "Select owner..." }, class: "form-select" %>
          </div>
        </div>
      </div>

      <div class="mb-3">
        <%= f.label :notes, "Notes", class: "form-label" %>
        <%= f.text_area :notes, class: "form-control", rows: 3 %>
      </div>

      <div class="d-flex gap-2">
        <%= f.submit "Update Opportunity", class: "admin-btn admin-btn-primary" %>
        <%= link_to "Cancel", opportunity_path(@opportunity), class: "admin-btn admin-btn-secondary" %>
        <%= link_to "Delete", opportunity_path(@opportunity), method: :delete, 
            data: { turbo_confirm: "Are you sure you want to delete this opportunity?" },
            class: "admin-btn admin-btn-danger ms-auto" %>
      </div>
    <% end %>
  </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
  if (typeof lucide !== 'undefined') {
    lucide.createIcons();
  }
});
</script>
