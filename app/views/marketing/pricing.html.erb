<% content_for :title, "Pricing - Agent Marketing" %>

<!-- Hero Section -->
<section class="py-5 bg-light">
  <div class="container text-center">
    <h1 class="display-4 fw-bold mb-3">Simple, Transparent Pricing</h1>
    <p class="lead mb-0">Choose the plan that's right for your business</p>
  </div>
</section>

<!-- Pricing Section -->
<section class="py-5">
  <div class="container">
    <div class="row justify-content-center">
      <div class="col-12 col-lg-10">
        <div class="d-flex justify-content-center mb-5">
          <div class="form-check form-switch form-check-inline">
            <label class="form-check-label">Monthly</label>
          </div>
          <div class="form-check form-switch form-check-inline">
            <input class="form-check-input" type="checkbox" id="pricingToggle">
            <label class="form-check-label" for="pricingToggle">Annual <span class="badge bg-primary">Save 20%</span></label>
          </div>
        </div>
        
        <div class="row">
          <!-- Starter Plan -->
          <div class="col-md-4 mb-4 mb-md-0">
            <div class="card h-100 pricing-card shadow-sm">
              <div class="card-header text-center bg-transparent pt-4 border-bottom-0">
                <h4 class="mb-1">Starter</h4>
                <p class="text-muted mb-4">For individuals and small businesses</p>
                <h2 class="card-price"><span class="price-value">$29</span><small class="text-muted">/month</small></h2>
              </div>
              <div class="card-body">
                <ul class="list-unstyled">
                  <li class="mb-3"><i class="fas fa-check text-success me-2"></i> <strong>1</strong> Entity</li>
                  <li class="mb-3"><i class="fas fa-check text-success me-2"></i> <strong>2,500</strong> Contacts</li>
                  <li class="mb-3"><i class="fas fa-check text-success me-2"></i> <strong>10,000</strong> Emails per month</li>
                  <li class="mb-3"><i class="fas fa-check text-success me-2"></i> <strong>100</strong> Social media posts</li>
                  <li class="mb-3"><i class="fas fa-check text-success me-2"></i> <strong>Basic</strong> AI content tools</li>
                  <li class="mb-3"><i class="fas fa-check text-success me-2"></i> <strong>3</strong> User accounts</li>
                  <li class="mb-3"><i class="fas fa-check text-success me-2"></i> Email support</li>
                  <li class="mb-3 text-muted"><i class="fas fa-times text-danger me-2"></i> Advanced analytics</li>
                  <li class="mb-3 text-muted"><i class="fas fa-times text-danger me-2"></i> API access</li>
                </ul>
              </div>
              <div class="card-footer bg-transparent text-center border-top-0 pb-4">
                <a href="<%= request.protocol %>app.<%= request.host_with_port.sub(/^www\./, '') %>/users/sign_up" class="btn btn-outline-primary btn-lg w-100">Start Free Trial</a>
              </div>
            </div>
          </div>
          
          <!-- Professional Plan -->
          <div class="col-md-4 mb-4 mb-md-0">
            <div class="card h-100 pricing-card shadow border-primary">
              <div class="card-header text-center bg-primary text-white pt-4 border-bottom-0">
                <span class="badge bg-white text-primary position-absolute top-0 start-50 translate-middle px-3 py-2">MOST POPULAR</span>
                <h4 class="mb-1">Professional</h4>
                <p class="text-white-50 mb-4">For growing businesses and teams</p>
                <h2 class="card-price text-white"><span class="price-value">$79</span><small class="text-white-50">/month</small></h2>
              </div>
              <div class="card-body">
                <ul class="list-unstyled">
                  <li class="mb-3"><i class="fas fa-check text-success me-2"></i> <strong>3</strong> Entities</li>
                  <li class="mb-3"><i class="fas fa-check text-success me-2"></i> <strong>10,000</strong> Contacts</li>
                  <li class="mb-3"><i class="fas fa-check text-success me-2"></i> <strong>50,000</strong> Emails per month</li>
                  <li class="mb-3"><i class="fas fa-check text-success me-2"></i> <strong>Unlimited</strong> Social media posts</li>
                  <li class="mb-3"><i class="fas fa-check text-success me-2"></i> <strong>Advanced</strong> AI content tools</li>
                  <li class="mb-3"><i class="fas fa-check text-success me-2"></i> <strong>10</strong> User accounts</li>
                  <li class="mb-3"><i class="fas fa-check text-success me-2"></i> Priority email & chat support</li>
                  <li class="mb-3"><i class="fas fa-check text-success me-2"></i> Advanced analytics</li>
                  <li class="mb-3 text-muted"><i class="fas fa-times text-danger me-2"></i> API access</li>
                </ul>
              </div>
              <div class="card-footer bg-transparent text-center border-top-0 pb-4">
                <a href="<%= request.protocol %>app.<%= request.host_with_port.sub(/^www\./, '') %>/users/sign_up" class="btn btn-primary btn-lg w-100">Start Free Trial</a>
              </div>
            </div>
          </div>
          
          <!-- Enterprise Plan -->
          <div class="col-md-4">
            <div class="card h-100 pricing-card shadow-sm">
              <div class="card-header text-center bg-transparent pt-4 border-bottom-0">
                <h4 class="mb-1">Enterprise</h4>
                <p class="text-muted mb-4">For agencies and large organizations</p>
                <h2 class="card-price"><span class="price-value">$199</span><small class="text-muted">/month</small></h2>
              </div>
              <div class="card-body">
                <ul class="list-unstyled">
                  <li class="mb-3"><i class="fas fa-check text-success me-2"></i> <strong>Unlimited</strong> Entities</li>
                  <li class="mb-3"><i class="fas fa-check text-success me-2"></i> <strong>100,000</strong> Contacts</li>
                  <li class="mb-3"><i class="fas fa-check text-success me-2"></i> <strong>500,000</strong> Emails per month</li>
                  <li class="mb-3"><i class="fas fa-check text-success me-2"></i> <strong>Unlimited</strong> Social media posts</li>
                  <li class="mb-3"><i class="fas fa-check text-success me-2"></i> <strong>Premium</strong> AI content tools</li>
                  <li class="mb-3"><i class="fas fa-check text-success me-2"></i> <strong>Unlimited</strong> User accounts</li>
                  <li class="mb-3"><i class="fas fa-check text-success me-2"></i> 24/7 priority support</li>
                  <li class="mb-3"><i class="fas fa-check text-success me-2"></i> Advanced analytics</li>
                  <li class="mb-3"><i class="fas fa-check text-success me-2"></i> API access</li>
                </ul>
              </div>
              <div class="card-footer bg-transparent text-center border-top-0 pb-4">
                <a href="<%= request.protocol %>app.<%= request.host_with_port.sub(/^www\./, '') %>/users/sign_up" class="btn btn-outline-primary btn-lg w-100">Start Free Trial</a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- FAQ Section -->
<section class="py-5 bg-light">
  <div class="container">
    <h2 class="text-center fw-bold mb-5">Frequently Asked Questions</h2>
    
    <div class="row justify-content-center">
      <div class="col-lg-10">
        <div class="accordion" id="pricingFAQ">
          <div class="accordion-item">
            <h2 class="accordion-header" id="headingOne">
              <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#collapseOne" aria-expanded="true" aria-controls="collapseOne">
                Can I change plans later?
              </button>
            </h2>
            <div id="collapseOne" class="accordion-collapse collapse show" aria-labelledby="headingOne" data-bs-parent="#pricingFAQ">
              <div class="accordion-body">
                <p>Yes, you can upgrade or downgrade your plan at any time. When you upgrade, you'll be charged the prorated difference for the remainder of your billing cycle. When you downgrade, the new plan takes effect at the start of your next billing cycle.</p>
              </div>
            </div>
          </div>
          
          <div class="accordion-item">
            <h2 class="accordion-header" id="headingTwo">
              <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseTwo" aria-expanded="false" aria-controls="collapseTwo">
                What happens when I reach my contact or email limit?
              </button>
            </h2>
            <div id="collapseTwo" class="accordion-collapse collapse" aria-labelledby="headingTwo" data-bs-parent="#pricingFAQ">
              <div class="accordion-body">
                <p>If you reach your contact limit, you'll need to upgrade to a higher plan or remove some contacts to add new ones. For email limits, you won't be able to send more emails once you reach your monthly limit until the next billing cycle, or you can upgrade your plan to increase your sending capacity.</p>
              </div>
            </div>
          </div>
          
          <div class="accordion-item">
            <h2 class="accordion-header" id="headingThree">
              <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseThree" aria-expanded="false" aria-controls="collapseThree">
                Do you offer a free trial?
              </button>
            </h2>
            <div id="collapseThree" class="accordion-collapse collapse" aria-labelledby="headingThree" data-bs-parent="#pricingFAQ">
              <div class="accordion-body">
                <p>Yes, we offer a 14-day free trial on all plans. No credit card is required to start your trial. You can explore all the features of your chosen plan during the trial period.</p>
              </div>
            </div>
          </div>
          
          <div class="accordion-item">
            <h2 class="accordion-header" id="headingFour">
              <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseFour" aria-expanded="false" aria-controls="collapseFour">
                What payment methods do you accept?
              </button>
            </h2>
            <div id="collapseFour" class="accordion-collapse collapse" aria-labelledby="headingFour" data-bs-parent="#pricingFAQ">
              <div class="accordion-body">
                <p>We accept all major credit cards including Visa, Mastercard, American Express, and Discover. We also support payment via PayPal and invoice payment for annual Enterprise plans.</p>
              </div>
            </div>
          </div>
          
          <div class="accordion-item">
            <h2 class="accordion-header" id="headingFive">
              <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseFive" aria-expanded="false" aria-controls="collapseFive">
                Do you offer custom plans for large organizations?
              </button>
            </h2>
            <div id="collapseFive" class="accordion-collapse collapse" aria-labelledby="headingFive" data-bs-parent="#pricingFAQ">
              <div class="accordion-body">
                <p>Yes, we offer custom enterprise solutions for organizations with specific needs beyond our standard plans. Please contact our sales team at <a href="mailto:sales@yourdomain.com">sales@yourdomain.com</a> to discuss your requirements.</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- CTA Section -->
<section class="py-5 hero-section">
  <div class="container text-center">
    <h2 class="display-5 fw-bold mb-3">Ready to Get Started?</h2>
    <p class="lead mb-4">Try Agent Marketing free for 14 days. No credit card required.</p>
                                                   <a href="<%= request.protocol %>app.<%= request.host_with_port.sub(/^www\./, '') %>/users/sign_up" class="btn btn-light btn-lg px-5">Start Your Free Trial</a>
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const toggle = document.getElementById('pricingToggle');
    const priceElements = document.querySelectorAll('.price-value');
    
    const monthlyPrices = ['$29', '$79', '$199'];
    const annualPrices = ['$23', '$63', '$159'];
    
    toggle.addEventListener('change', function() {
      priceElements.forEach((el, index) => {
        if (toggle.checked) {
          el.textContent = annualPrices[index];
        } else {
          el.textContent = monthlyPrices[index];
        }
      });
    });
  });
</script> 