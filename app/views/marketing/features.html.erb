<% content_for :title, "Features - Agent Marketing" %>

<!-- Hero Section -->
<section class="py-5 hero-section">
  <div class="container text-center">
    <h1 class="display-4 fw-bold mb-3">Powerful Marketing Features</h1>
    <p class="lead mb-0">Everything you need to create, manage, and optimize your marketing campaigns</p>
  </div>
</section>

<!-- Features Section -->
<section class="section-dark features-wrap">
  <div class="container">
    <style>
      /* simple reveal animations, leveraging global observer */
      .reveal { opacity: 0.001; transform: translateY(0); transition: opacity 650ms ease, transform 650ms ease; }
      .reveal-left { transform: translateX(-32px); }
      .reveal-right { transform: translateX(32px); }
      .reveal.visible { opacity: 1; transform: translateX(0); }
      .feature-block { background: rgba(255,255,255,0.10) !important; border: 1px solid rgba(255,255,255,0.18); border-radius: 16px; padding: 6rem 2rem; margin-bottom: 2rem; box-shadow: 0 20px 40px rgba(0,0,0,0.25); }
      .feature-block:last-of-type { margin-bottom: 0; }
      .features-wrap { padding-top: 8rem; padding-bottom: 8rem; overflow: hidden; }
      .feature-img-col { display: flex; align-items: center; justify-content: center; }
      @media (min-width: 992px) { .feature-block { padding-left: 4rem; padding-right: 4rem; } }
    </style>
    <div class="feature-block reveal reveal-left">
    <div class="row align-items-center">
      <div class="col-lg-6 order-lg-2 feature-img-col">
        <%= image_tag "icons/crux_email_campaign_icon.png", alt: "Email Marketing", class: "img-fluid rounded shadow-sm", style: "max-width: 360px;" %>
      </div>
      <div class="col-lg-6 order-lg-1">
        <h2 class="fw-bold mb-3">Email Marketing</h2>
        <p class="text-white-50 mb-4">Create beautiful email campaigns that convert with our powerful yet easy-to-use tools.</p>
        <ul class="list-unstyled">
          <li class="mb-2"><i class="fas fa-check text-primary me-2"></i> Drag-and-drop email editor</li>
          <li class="mb-2"><i class="fas fa-check text-primary me-2"></i> Professional templates library</li>
          <li class="mb-2"><i class="fas fa-check text-primary me-2"></i> Personalization and dynamic content</li>
          <li class="mb-2"><i class="fas fa-check text-primary me-2"></i> A/B testing capabilities</li>
          <li class="mb-2"><i class="fas fa-check text-primary me-2"></i> Detailed open and click tracking</li>
          <li class="mb-2"><i class="fas fa-check text-primary me-2"></i> Automated workflows and sequences</li>
        </ul>
      </div>
    </div>
    <script>
      // simple observer to reveal feature cards
      (function(){
        const items = document.querySelectorAll('.feature-block.reveal');
        if(items.length === 0) return;
        const obs = new IntersectionObserver((entries,o)=>{
          entries.forEach(e=>{ if(e.isIntersecting){ e.target.classList.add('visible'); o.unobserve(e.target);} });
        }, { threshold: 0.15 });
        items.forEach(el=>obs.observe(el));
      })();
    </script>
    </div>

