<% content_for :title, "Contact - Agent Marketing" %>

<!-- Hero Section -->
<section class="py-5 hero-section">
  <div class="container text-center">
    <h1 class="display-4 fw-bold mb-3">Contact Us</h1>
    <p class="lead mb-0">We usually reply within a business day</p>
  </div>
</section>

<!-- Contact Form Section -->
<section class="py-5">
  <div class="container">
    <div class="row justify-content-center">
      <div class="col-12 col-lg-8">
        <% if flash[:notice] %>
          <div class="alert alert-success"><%= flash[:notice] %></div>
        <% elsif flash[:alert] %>
          <div class="alert alert-danger"><%= flash[:alert] %></div>
        <% end %>

        <div class="card shadow-sm">
          <div class="card-body p-4">
            <h3 class="mb-4">Send us a message</h3>
            <%= form_with url: marketing_contact_submit_path, method: :post, local: true do |f| %>
              <div class="mb-3">
                <%= label_tag :name, 'Your name', class: 'form-label' %>
                <%= text_field_tag :name, params[:name], class: 'form-control', required: true %>
              </div>
              <div class="mb-3">
                <%= label_tag :email, 'Email address', class: 'form-label' %>
                <%= email_field_tag :email, params[:email], class: 'form-control', required: true %>
              </div>
              <div class="mb-3">
                <%= label_tag :subject, 'Subject', class: 'form-label' %>
                <%= text_field_tag :subject, params[:subject], class: 'form-control', required: true %>
              </div>
              <div class="mb-3">
                <%= label_tag :message, 'Message', class: 'form-label' %>
                <%= text_area_tag :message, params[:message], class: 'form-control', rows: 6, required: true %>
              </div>
              <div class="text-end">
                <button type="submit" class="btn btn-primary">Send Message</button>
              </div>
            <% end %>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>


