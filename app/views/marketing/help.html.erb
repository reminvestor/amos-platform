<% content_for :title, "Help Center - Agent Marketing" %>

<!-- Hero -->
<section class="py-5 bg-light">
  <div class="container text-center">
    <h1 class="display-5 fw-bold mb-2 text-dark">Help Center</h1>
    <p class="lead mb-0 text-dark">Find answers fast or contact support</p>
  </div>
</section>

<!-- FAQ -->
<section class="py-5 bg-white">
  <div class="container">
    <div class="row justify-content-center">
      <div class="col-lg-10">
        <div class="accordion" id="helpFAQ">
          <!-- General -->
          <div class="mb-4">
            <h2 class="fw-bold text-dark mb-3">General</h2>
            <div class="accordion-item">
              <h2 class="accordion-header" id="g1h"><button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#g1" aria-expanded="true" aria-controls="g1">What is AMOS Labs and how does it work?</button></h2>
              <div id="g1" class="accordion-collapse collapse show" data-bs-parent="#helpFAQ" aria-labelledby="g1h">
                <div class="accordion-body">
                  AMOS Labs is an AI-powered business automation platform that helps you run campaigns, create landing pages, automate workflows, and analyze results—all through a simple chat interface with AMOS, your AI assistant. No complex dashboards, just tell AMOS what you need.
                </div>
              </div>
            </div>
            <div class="accordion-item">
              <h2 class="accordion-header" id="g2h"><button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#g2" aria-expanded="false" aria-controls="g2">Who is AMOS Labs designed for?</button></h2>
              <div id="g2" class="accordion-collapse collapse" data-bs-parent="#helpFAQ" aria-labelledby="g2h">
                <div class="accordion-body">We built AMOS for indie founders, small businesses, and entrepreneurs who want powerful business automation and marketing tools without enterprise pricing or steep learning curves.</div>
              </div>
            </div>
            <div class="accordion-item">
              <h2 class="accordion-header" id="g3h"><button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#g3">What makes AMOS Labs different from tools like HubSpot?</button></h2>
              <div id="g3" class="accordion-collapse collapse" data-bs-parent="#helpFAQ" aria-labelledby="g3h"><div class="accordion-body">Unlike traditional platforms, AMOS is AI-first. Instead of clicking through complicated menus, you work directly with AMOS (your AI assistant) to plan, create, and launch campaigns instantly. AMOS can also automate workflows across multiple platforms and integrate with your existing tools. It's significantly more affordable and easier to use.</div></div>
            </div>
            <div class="accordion-item">
              <h2 class="accordion-header" id="g4h"><button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#g4">Does every plan include access to all features?</button></h2>
              <div id="g4" class="accordion-collapse collapse" data-bs-parent="#helpFAQ" aria-labelledby="g4h"><div class="accordion-body">Yes. All plans unlock the full suite of tools. The only difference is how much usage you need (contacts, emails, storage, etc.).</div></div>
            </div>
            <div class="accordion-item">
              <h2 class="accordion-header" id="g5h"><button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#g5">Is there a free trial or demo available?</button></h2>
              <div id="g5" class="accordion-collapse collapse" data-bs-parent="#helpFAQ" aria-labelledby="g5h"><div class="accordion-body">Yes. You can sign up and try AMOS free before committing to a paid plan.</div></div>
            </div>
          </div>

          <!-- Getting Started -->
          <div class="mb-4">
            <h2 class="fw-bold text-dark mb-3">Getting Started</h2>
            <div class="accordion-item">
              <h2 class="accordion-header" id="s1h"><button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#s1">How do I create my first campaign?</button></h2>
              <div id="s1" class="accordion-collapse collapse" data-bs-parent="#helpFAQ" aria-labelledby="s1h"><div class="accordion-body">Just open the chat and tell AMOS what you'd like to do (email campaign, blog post, landing page, workflow automation, etc.). AMOS will walk you through setup step by step.</div></div>
            </div>
            <div class="accordion-item">
              <h2 class="accordion-header" id="s2h"><button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#s2">How do I connect my email and social accounts?</button></h2>
              <div id="s2" class="accordion-collapse collapse" data-bs-parent="#helpFAQ" aria-labelledby="s2h"><div class="accordion-body">NEED TO ANSWER</div></div>
            </div>
            <div class="accordion-item">
              <h2 class="accordion-header" id="s3h"><button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#s3">Can I import my existing contacts?</button></h2>
              <div id="s3" class="accordion-collapse collapse" data-bs-parent="#helpFAQ" aria-labelledby="s3h"><div class="accordion-body">Yes. Upload your contact list as a CSV or connect your CRM to bring contacts into AMOS.</div></div>
            </div>
            <div class="accordion-item">
              <h2 class="accordion-header" id="s4h"><button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#s4">How do I set up my link hub page?</button></h2>
              <div id="s4" class="accordion-collapse collapse" data-bs-parent="#helpFAQ" aria-labelledby="s4h"><div class="accordion-body">In the chat, just say "Create my link hub." AMOS will generate a customizable page where you can add links, campaigns, and landing pages.</div></div>
            </div>
            <div class="accordion-item">
              <h2 class="accordion-header" id="s5h"><button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#s5">Do I need technical skills to use AMOS Labs?</button></h2>
              <div id="s5" class="accordion-collapse collapse" data-bs-parent="#helpFAQ" aria-labelledby="s5h"><div class="accordion-body">No. AMOS is designed to be as simple as chatting. The AI handles the setup and technical details for you—no coding or technical knowledge required.</div></div>
            </div>
          </div>

          <!-- Features -->
          <div class="mb-4">
            <h2 class="fw-bold text-dark mb-3">Features</h2>
            <div class="accordion-item">
              <h2 class="accordion-header" id="f1h"><button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#f1">How does the AI help me write blog posts?</button></h2>
              <div id="f1" class="accordion-collapse collapse" data-bs-parent="#helpFAQ" aria-labelledby="f1h"><div class="accordion-body">The AI helps you outline, refine, and polish blog posts so they fit your brand and audience. You stay in control, while the AI handles the heavy lifting.</div></div>
            </div>
            <div class="accordion-item">
              <h2 class="accordion-header" id="f2h"><button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#f2">What is the AI Campaign Builder and how do I use it?</button></h2>
              <div id="f2" class="accordion-collapse collapse" data-bs-parent="#helpFAQ" aria-labelledby="f2h"><div class="accordion-body">The Campaign Builder helps you plan and run email and social campaigns. It can refine copy, suggest improvements, and schedule posts across your channels.</div></div>
            </div>
            <div class="accordion-item">
              <h2 class="accordion-header" id="f3h"><button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#f3">How can I create and schedule social media posts?</button></h2>
              <div id="f3" class="accordion-collapse collapse" data-bs-parent="#helpFAQ" aria-labelledby="f3h"><div class="accordion-body">Ask the AI to draft a post, edit it until you’re happy, and then schedule it directly to your connected accounts. (Note: full scheduling is coming soon.)</div></div>
            </div>
            <div class="accordion-item">
              <h2 class="accordion-header" id="f4h"><button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#f4">What analytics can I track in AMOS Labs?</button></h2>
              <div id="f4" class="accordion-collapse collapse" data-bs-parent="#helpFAQ" aria-labelledby="f4h"><div class="accordion-body">You’ll see metrics like open rate, click-through rate, engagement rate, and conversion performance—displayed in easy-to-read visuals.</div></div>
            </div>
            <div class="accordion-item">
              <h2 class="accordion-header" id="f5h"><button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#f5">Can I build landing pages with AMOS Labs?</button></h2>
              <div id="f5" class="accordion-collapse collapse" data-bs-parent="#helpFAQ" aria-labelledby="f5h"><div class="accordion-body">Yes. Tell the AI what you need, and it will generate a landing page you can customize and publish instantly.</div></div>
            </div>
          </div>

          <!-- Account & Billing -->
          <div class="mb-4">
            <h2 class="fw-bold text-dark mb-3">Account & Billing</h2>
            <div class="accordion-item">
              <h2 class="accordion-header" id="b1h"><button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#b1">How do I upgrade or downgrade my plan?</button></h2>
              <div id="b1" class="accordion-collapse collapse" data-bs-parent="#helpFAQ" aria-labelledby="b1h"><div class="accordion-body">Go to Settings → Billing and choose the plan that fits your needs. Changes take effect immediately.</div></div>
            </div>
            <div class="accordion-item">
              <h2 class="accordion-header" id="b2h"><button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#b2">How does billing work?</button></h2>
              <div id="b2" class="accordion-collapse collapse" data-bs-parent="#helpFAQ" aria-labelledby="b2h"><div class="accordion-body">AMOS Labs bills monthly or annually, depending on your choice at checkout.</div></div>
            </div>
            <div class="accordion-item">
              <h2 class="accordion-header" id="b3h"><button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#b3">How do I update my payment method?</button></h2>
              <div id="b3" class="accordion-collapse collapse" data-bs-parent="#helpFAQ" aria-labelledby="b3h"><div class="accordion-body">You can update your card details anytime under Settings → Billing.</div></div>
            </div>
            <div class="accordion-item">
              <h2 class="accordion-header" id="b4h"><button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#b4">Can I cancel my subscription at any time?</button></h2>
              <div id="b4" class="accordion-collapse collapse" data-bs-parent="#helpFAQ" aria-labelledby="b4h"><div class="accordion-body">NEED TO ANSWER</div></div>
            </div>
          </div>

          <!-- Support -->
          <div class="mb-4">
            <h2 class="fw-bold text-dark mb-3">Support</h2>
            <div class="accordion-item">
              <h2 class="accordion-header" id="u1h"><button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#u1">How do I contact support if I need help?</button></h2>
              <div id="u1" class="accordion-collapse collapse" data-bs-parent="#helpFAQ" aria-labelledby="u1h"><div class="accordion-body">Use the contact form below and our team will get back within one business day.</div></div>
            </div>
            <div class="accordion-item">
              <h2 class="accordion-header" id="u2h"><button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#u2">Where can I find tutorials or guides?</button></h2>
              <div id="u2" class="accordion-collapse collapse" data-bs-parent="#helpFAQ" aria-labelledby="u2h"><div class="accordion-body">You’ll find quick guides and video walk-throughs in the Help Center.</div></div>
            </div>
            <div class="accordion-item">
              <h2 class="accordion-header" id="u3h"><button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#u3">How do I give feedback or request a feature?</button></h2>
              <div id="u3" class="accordion-collapse collapse" data-bs-parent="#helpFAQ" aria-labelledby="u3h"><div class="accordion-body">We love hearing from you. Send feedback directly through the Help Center or in the chat, and our team will review it.</div></div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Contact Support Form -->
<section class="py-5 bg-white">
  <div class="container">
    <div class="row justify-content-center">
      <div class="col-12 col-lg-8">
        <div class="card shadow-sm">
          <div class="card-body p-4">
            <h3 class="mb-3">Contact Support</h3>
            <p class="text-muted">Have a question that isn’t answered above? Send us a message.</p>
            <%= form_with url: marketing_contact_submit_path, method: :post, local: true do %>
              <%= hidden_field_tag :subject, 'Help Center Support Request' %>
              <%= hidden_field_tag :to, 'support@amoslabs.com' %>
              <div class="mb-3">
                <%= label_tag :name, 'Your name', class: 'form-label' %>
                <%= text_field_tag :name, params[:name], class: 'form-control', required: true %>
              </div>
              <div class="mb-3">
                <%= label_tag :email, 'Email', class: 'form-label' %>
                <%= email_field_tag :email, params[:email], class: 'form-control', required: true %>
              </div>
              <div class="mb-3">
                <%= label_tag :message, 'Message', class: 'form-label' %>
                <%= text_area_tag :message, params[:message], class: 'form-control', rows: 5, required: true %>
              </div>
              <button type="submit" class="btn btn-primary">Send to Support</button>
            <% end %>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>


