<style>
  /* Page-local styles: only affect this Marketing home page */
  body { background: var(--dark-bg); }
  .hero-section.marketing-hero { color: white; padding: 6rem 0; position: relative; overflow: hidden; background: transparent !important; --zigzag: 160px; }
  .hero-section.marketing-hero::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, #667eea 0%, #764ba2 50%, #8b5cf6 100%);
    z-index: 0;
    pointer-events: none;
    /* Irregular peaks only on the right 70vw (start zig-zag at ~30%) */
    -webkit-clip-path: polygon(
      0 0,
      100% 0,
      100% 12%,
      92% 73%,
      84% 34%,
      76% 82%,
      68% 65%,
      60% 98%,
      50% 85%,
      40% 100%,
      0 100%,
      0 0
    );
    clip-path: polygon(
      0 0,
      100% 0,
      100% 12%,
      92% 73%,
      84% 34%,
      76% 82%,
      68% 65%,
      60% 98%,
      50% 85%,
      40% 100%,
      0 100%,
      0 0
    );
    filter: drop-shadow(0 14px 20px rgba(0, 0, 0, 0.35)) drop-shadow(0 4px 10px rgba(0, 0, 0, 0.25));
    will-change: filter;
  }
  .hero-section.marketing-hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(45deg, rgba(255,255,255,0.1) 0%, transparent 50%, rgba(255,255,255,0.05) 100%);
    z-index: 1;
    pointer-events: none;
    -webkit-clip-path: polygon(
      0 0,
       100% 0,
      100% 12%,
      92% 73%,
      84% 34%,
      76% 82%,
      68% 65%,
      60% 98%,
      50% 85%,
      40% 100%,
      0 100%,
      0 0
    );
    clip-path: polygon(
      0 0,
      100% 0,
      100% 12%,
      92% 73%,
      84% 34%,
      76% 82%,
      68% 65%,
      60% 98%,
      50% 85%,
      40% 100%,
      0 100%,
      0 0
    );
    filter: drop-shadow(0 14px 20px rgba(0, 0, 0, 0.35)) drop-shadow(0 4px 10px rgba(0, 0, 0, 0.25));
    will-change: filter;
  }
  .hero-section.marketing-hero > * { position: relative; z-index: 3; }
  
  /* Prominent problem statement section */
  .problem-section { 
    background: linear-gradient(180deg, rgba(255,255,255,0.03) 0%, rgba(255,255,255,0.02) 100%);
    padding-top: 4.5rem; 
    padding-bottom: 4.5rem; 
  }
  .problem-box {
    background: rgba(255,255,255,0.06);
    border: 1px solid rgba(255,255,255,0.12);
    border-radius: 16px;
    padding: clamp(2rem, 1.25rem + 2.5vw, 3.5rem);
    box-shadow: 0 25px 50px rgba(0,0,0,0.25), 0 10px 20px rgba(0,0,0,0.2);
    max-width: 1100px;
    margin-left: auto;
    margin-right: auto;
  }
  .problem-text {
    font-weight: 700;
    font-size: clamp(1.25rem, 1rem + 1.4vw, 2.1rem);
    line-height: 1.35;
    letter-spacing: 0.2px;
  }
  .problem-title {
    font-weight: 800;
    font-size: clamp(1.6rem, 1.2rem + 2vw, 2.4rem);
    margin-bottom: 1.75rem;
  }
  .problem-title .accent { color: var(--accent-coral); font-style: italic; }
  .problem-sub {
    font-size: clamp(1rem, 0.9rem + 0.6vw, 1.4rem);
