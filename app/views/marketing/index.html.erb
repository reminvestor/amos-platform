            <h4 class="hiw-card-title">Launch your first campaign</h4>
            <p class="hiw-card-desc">Go live in minutes</p>
          </div>
        </div>
      </div>
      <div class="text-center mt-4">
        <a href="<%= request.protocol %>app.<%= request.host_with_port.sub(/^www\./, '') %>/users/sign_up" class="btn btn-primary btn-lg px-5">Launch a Campaign</a>
      </div>
    </div>
  </div>
</section>

<!-- Final CTA -->
<section class="dark-gradient-bg py-5">
  <div class="container">
    <div class="row align-items-center g-4">
      <div class="col-lg-6 text-white">
        <h2 class="display-4 fw-bold mb-4">Ready to simplify your marketing and save thousands?</h2>
        <p class="lead mb-4 opacity-90">Try Crux free—get your first campaign live in minutes.</p>
        <a href="<%= request.protocol %>app.<%= request.host_with_port.sub(/^www\./, '') %>/users/sign_up" class="btn btn-primary btn-lg px-5 py-3">Launch a Campaign</a>
      </div>
      <div class="col-lg-6">
        <div class="bg-white rounded-3 shadow-lg p-4 p-md-5">
          <h3 class="h4 fw-bold mb-3">Have any questions?</h3>
          <p class="text-muted mb-4">Send us a quick note and we’ll get back within one business day.</p>
          <%= form_with url: marketing_contact_submit_path, method: :post, local: true do %>
            <%= hidden_field_tag :subject, 'Homepage CTA question' %>
            <div class="mb-3">
              <%= label_tag :name, 'Your name', class: 'form-label' %>
              <%= text_field_tag :name, params[:name], class: 'form-control', required: true %>
            </div>
            <div class="mb-3">
              <%= label_tag :email, 'Email', class: 'form-label' %>
              <%= email_field_tag :email, params[:email], class: 'form-control', required: true %>
            </div>
            <div class="mb-3">
              <%= label_tag :message, 'Message', class: 'form-label' %>
              <%= text_area_tag :message, params[:message], class: 'form-control', rows: 4, required: true %>
            </div>
            <button type="submit" class="btn btn-outline-primary">Send</button>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</section>
