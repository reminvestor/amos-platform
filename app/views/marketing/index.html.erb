          <a href="<%= request.protocol %>app.<%= request.host_with_port.sub(/^www\./, '') %>/users/sign_up" class="btn btn-primary btn-lg px-5">Get Started in Minutes</a>
        </div>
      </div>
      <div class="col-lg-6 d-none d-lg-block">
        <div class="position-relative">
          <div class="feature-card mb-4">
            <h6 class="text-white mb-2"><i class="fas fa-chart-line me-2"></i>Screenshot of campaign analytics</h6>
            <div class="bg-dark bg-opacity-25 rounded p-3">
              <div class="d-flex justify-content-between mb-2">
                <span class="small">Campaign Performance</span>
                <span class="small text-success">+127% ROI</span>
              </div>
              <div class="progress mb-2" style="height: 8px;">
                <div class="progress-bar bg-info" style="width: 85%"></div>
              </div>
              <div class="small opacity-75">Email open rate: 45.2% | Click rate: 12.8%</div>
            </div>
          </div>
          <div class="feature-card">
            <h6 class="text-white mb-2"><i class="fas fa-magic me-2"></i>Screenshot of landing page creator</h6>
            <div class="bg-dark bg-opacity-25 rounded p-3">
              <div class="d-flex align-items-center mb-2">
                <div class="bg-primary rounded-circle me-2" style="width: 12px; height: 12px;"></div>
