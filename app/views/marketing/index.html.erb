    border-color: rgba(255,255,255,0.35);
    color: #fff;
  }

  /* Simple reveal animation */
  .reveal { opacity: 0.001; transform: translateY(24px); transition: opacity 600ms ease, transform 600ms ease; }
  .reveal.visible { opacity: 1; transform: translateY(0); }

  /* How it works timeline */
  .hiw-steps { list-style: none; padding: 0; margin: 0; max-width: 100%; position: relative; --hiw-col: 84px; }
  .hiw-steps::before { content: none; }
  /* no vertical line */
  .hiw-step { display: grid; grid-template-columns: var(--hiw-col) 1fr; align-items: center; gap: 24px; padding: 18px 0; }
  .hiw-badge {
    width: 56px; height: 56px; border-radius: 50%; display: flex; align-items: center; justify-content: center;
    font-weight: 800; font-size: 24px; background: var(--dark-bg); color: rgba(255,255,255,0.9);
    border: 4px solid rgba(255,255,255,0.35); transition: background 500ms ease, color 500ms ease, border-color 500ms ease, box-shadow 500ms ease;
    position: relative; z-index: 1; /* sits above the line to mask it */
  }
  .hiw-badge[data-color="pink"] { border-color: var(--accent-coral); color: var(--accent-coral); }
  .hiw-badge[data-color="purple"] { border-color: var(--primary-purple); color: var(--primary-purple); }
  .hiw-badge[data-color="indigo"] { border-color: #4c1d95; color: #8b5cf6; }
  .hiw-badge.filled[data-color="pink"] { background: linear-gradient(180deg, #ff8e8e, #ff6b6b); color: #fff; border-color: transparent; box-shadow: 0 10px 24px rgba(255,107,107,0.35); z-index: 3; }
  .hiw-badge.filled[data-color="purple"] { background: linear-gradient(180deg, #8da4ff, #6366f1); color: #fff; border-color: transparent; box-shadow: 0 10px 24px rgba(99,102,241,0.35); z-index: 3; }
  .hiw-badge.filled[data-color="indigo"] { background: linear-gradient(180deg, #6d28d9, #4c1d95); color: #fff; border-color: transparent; box-shadow: 0 10px 24px rgba(76,29,149,0.35); z-index: 3; }
  .hiw-steps { text-align: left; }
  .hiw-text {
    color: #fff;
    font-size: clamp(0.95rem, 0.75rem + 0.6vw, 1.35rem);
    font-weight: 400;
    text-align: left !important;
    line-height: 1.25;
  }
  .hiw-title { font-size: clamp(1.4rem, 1.05rem + 1vw, 2rem); }
  .hiw-header { margin-bottom: clamp(2rem, 1.5rem + 2vw, 4rem) !important; }
  .hiw-spacing { padding-top: 8rem !important; padding-bottom: 8rem !important; }

