<% content_for :title, "Configure OAuth App - #{@integration.name}" %>

<div class="container">
  <div class="row justify-content-center">
    <div class="col-lg-8">
      <div class="card">
        <div class="card-header bg-primary text-white">
          <div class="d-flex align-items-center">
            <% if @integration.icon_url.present? %>
              <img src="<%= @integration.icon_url %>" 
                   alt="<%= @integration.name %>" 
                   class="rounded me-2" style="width: 32px; height: 32px;">
            <% else %>
              <i class="fas fa-puzzle-piece me-2"></i>
            <% end %>
            <h5 class="mb-0">Configure OAuth App - <%= @integration.name %></h5>
          </div>
        </div>
        
        <div class="card-body">
          <% if @integration.description.present? %>
            <p class="text-muted mb-4"><%= @integration.description %></p>
          <% end %>

          <div class="alert alert-info">
            <i class="fas fa-info-circle me-2"></i>
            <strong>Setup Instructions:</strong>
            <ol class="mb-0 mt-2">
              <li>Create an OAuth app in your <%= @integration.name %> developer console</li>
              <li>Set the redirect URI to: <code><%= @oauth_configuration.redirect_uri %></code></li>
              <li>Copy the Client ID and Client Secret from your app</li>
              <li>Enter the details below</li>
            </ol>
          </div>
          
          <%= form_with model: @oauth_configuration, local: true, class: "needs-validation", novalidate: true do |form| %>
            <%= form.hidden_field :integration_id %>
            
            <div class="row">
              <div class="col-md-6 mb-3">
                <%= form.label :client_id, "Client ID", class: "form-label" %>
                <%= form.text_field :client_id, class: "form-control", required: true, 
                    placeholder: "Enter your OAuth app Client ID" %>
                <div class="form-text">The Client ID from your OAuth app</div>
              </div>
              
              <div class="col-md-6 mb-3">
                <%= form.label :client_secret, "Client Secret", class: "form-label" %>
                <%= form.password_field :client_secret, class: "form-control", required: true,
                    placeholder: "Enter your OAuth app Client Secret" %>
                <div class="form-text">The Client Secret from your OAuth app</div>
              </div>
            </div>

            <div class="mb-3">
              <%= form.label :redirect_uri, "Redirect URI", class: "form-label" %>
              <%= form.url_field :redirect_uri, class: "form-control", required: true,
                  placeholder: "https://yourdomain.com/callback" %>
              <div class="form-text">This should match the redirect URI in your OAuth app settings</div>
            </div>

            <div class="row">
              <div class="col-md-6 mb-3">
                <%= form.label :authorize_url, "Authorization URL", class: "form-label" %>
                <%= form.url_field :authorize_url, class: "form-control", required: true,
                    placeholder: "https://provider.com/oauth/authorize" %>
                <div class="form-text">The OAuth authorization endpoint</div>
              </div>
              
              <div class="col-md-6 mb-3">
                <%= form.label :token_url, "Token URL", class: "form-label" %>
                <%= form.url_field :token_url, class: "form-control", required: true,
                    placeholder: "https://provider.com/oauth/token" %>
                <div class="form-text">The OAuth token exchange endpoint</div>
              </div>
            </div>

            <div class="mb-3">
              <%= form.label :scopes, "OAuth Scopes", class: "form-label" %>
              <%= form.text_area :scopes, class: "form-control", rows: 3,
                  placeholder: "com.intuit.quickbooks.accounting,com.intuit.quickbooks.payment" %>
              <div class="form-text">Comma-separated list of OAuth scopes (optional)</div>
            </div>

            <div class="mb-3">
              <%= form.label :credentials, "Additional Credentials (JSON)", class: "form-label" %>
              <%= form.text_area :credentials, class: "form-control", rows: 3,
                  placeholder: '{"access_type": "offline", "prompt": "consent"}' %>
              <div class="form-text">Additional OAuth parameters as JSON (optional)</div>
            </div>
            
            <div class="d-grid gap-2 d-md-flex justify-content-md-end">
              <%= link_to "Cancel", oauth_configurations_path, class: "btn btn-outline-secondary me-md-2" %>
              <%= form.submit "Save OAuth Configuration", class: "btn btn-primary" %>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
