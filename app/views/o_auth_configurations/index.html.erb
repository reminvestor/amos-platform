<% content_for :title, "OAuth App Configurations" %>

<div class="container-fluid">
  <div class="row">
    <div class="col-12">
      <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h3 mb-0">OAuth App Configurations</h1>
        <% if @integrations_needing_config.any? %>
          <div class="dropdown">
            <button class="btn btn-primary dropdown-toggle" type="button" data-bs-toggle="dropdown">
              <i class="fas fa-plus me-2"></i>Configure OAuth App
            </button>
            <ul class="dropdown-menu">
              <% @integrations_needing_config.each do |integration| %>
                <li>
                  <%= link_to new_oauth_configuration_path(integration_id: integration.id), class: "dropdown-item" do %>
                    <i class="fas fa-puzzle-piece me-2"></i><%= integration.name %>
                  <% end %>
                </li>
              <% end %>
            </ul>
          </div>
        <% end %>
      </div>

      <% if @oauth_configurations.any? %>
        <div class="row">
          <% @oauth_configurations.each do |config| %>
            <div class="col-md-6 col-lg-4 mb-4">
              <div class="card h-100">
                <div class="card-header d-flex justify-content-between align-items-center">
                  <div class="d-flex align-items-center">
                    <% if config.integration.icon_url.present? %>
                      <img src="<%= config.integration.icon_url %>" 
                           alt="<%= config.integration.name %>" 
                           class="rounded me-2" style="width: 24px; height: 24px;">
                    <% else %>
                      <i class="fas fa-puzzle-piece me-2"></i>
                    <% end %>
                    <h6 class="mb-0"><%= config.integration.name %></h6>
                  </div>
                  <div class="dropdown">
                    <button class="btn btn-sm btn-outline-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown">
                      <i class="fas fa-ellipsis-v"></i>
                    </button>
                    <ul class="dropdown-menu">
                      <li><%= link_to "Edit", edit_oauth_configuration_path(config), class: "dropdown-item" %></li>
                      <li><%= link_to "Delete", oauth_configuration_path(config), method: :delete, 
                                     confirm: "Are you sure?", class: "dropdown-item text-danger" %></li>
                    </ul>
                  </div>
                </div>
                <div class="card-body">
                  <div class="mb-2">
                    <small class="text-muted">Client ID:</small>
                    <div class="font-monospace small"><%= config.client_id %></div>
                  </div>
                  <div class="mb-2">
                    <small class="text-muted">Client Secret:</small>
                    <div class="font-monospace small"><%= config.masked_client_secret %></div>
                  </div>
                  <div class="mb-2">
                    <small class="text-muted">Redirect URI:</small>
                    <div class="font-monospace small text-break"><%= config.redirect_uri %></div>
                  </div>
                  <% if config.scopes_array.any? %>
                    <div class="mb-2">
                      <small class="text-muted">Scopes:</small>
                      <div>
                        <% config.scopes_array.each do |scope| %>
                          <span class="badge bg-secondary me-1"><%= scope %></span>
                        <% end %>
                      </div>
                    </div>
                  <% end %>
                </div>
                <div class="card-footer">
                  <small class="text-muted">
                    Created <%= time_ago_in_words(config.created_at) %> ago
                  </small>
                </div>
              </div>
            </div>
          <% end %>
        </div>
      <% else %>
        <div class="text-center py-5">
          <i class="fas fa-cog fa-3x text-muted mb-3"></i>
          <h4 class="text-muted">No OAuth Configurations</h4>
          <p class="text-muted">Configure OAuth apps for integrations that require custom OAuth setup.</p>
          <% if @integrations_needing_config.any? %>
            <%= link_to "Configure Your First OAuth App", 
                        new_oauth_configuration_path(integration_id: @integrations_needing_config.first.id), 
                        class: "btn btn-primary" %>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
</div>
