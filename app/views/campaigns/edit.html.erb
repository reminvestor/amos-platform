<div class="admin-content" style="padding: 2rem;">
  <%# Page Header %>
  <div class="admin-page-header" style="margin-bottom: 2rem;">
    <div class="header-left">
      <div class="header-icon" style="background: linear-gradient(135deg, #7C3AED 0%, #A78BFA 100%);">
        <i data-lucide="pencil"></i>
      </div>
      <div class="header-text">
        <h1>Edit Campaign</h1>
        <p>Update campaign settings and configuration</p>
      </div>
    </div>
    <div class="header-actions">
      <%= link_to campaign_path(@campaign), class: "admin-btn admin-btn-outline" do %>
        <i data-lucide="arrow-left"></i>
        <span>Back to Campaign</span>
      <% end %>
    </div>
  </div>

  <%# Main Form Card %>
  <div class="admin-card">
    <%= form_with(model: @campaign, local: true) do |form| %>
      <%# Error Messages %>
      <% if @campaign.errors.any? %>
        <div class="alert alert-danger" style="background-color: rgba(239, 68, 68, 0.1); border-color: rgba(239, 68, 68, 0.2); color: #FCA5A5; margin-bottom: 1.5rem;">
          <h5 style="margin-bottom: 0.5rem;">
            <i data-lucide="alert-circle" class="icon-md" style="display: inline-block; vertical-align: middle; margin-right: 0.5rem;"></i>
            <%= pluralize(@campaign.errors.count, "error") %> prohibited this campaign from being saved:
          </h5>
          <ul style="margin-bottom: 0; padding-left: 1.5rem;">
            <% @campaign.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <%# Warning for Non-Draft Campaigns %>
      <% if @campaign.status != 'draft' %>
        <div style="background-color: rgba(251, 191, 36, 0.1); border: 1px solid rgba(251, 191, 36, 0.2); border-radius: 0.5rem; padding: 1rem; margin-bottom: 1.5rem;">
          <div style="display: flex; align-items: start; gap: 0.5rem; color: #FCD34D;">
            <i data-lucide="alert-triangle" class="icon-md" style="flex-shrink: 0;"></i>
            <div>
              <strong>Note:</strong> This campaign is already <%= @campaign.status %>.
              Some changes may not take effect until you reschedule or restart the campaign.
            </div>
          </div>
        </div>
      <% end %>

      <div class="row">
        <%# Left Column - Main Fields %>
        <div class="col-md-7">
          <%# Campaign Name %>
          <div style="margin-bottom: 1.5rem;">
            <%= form.label :name, "Campaign Name", style: "display: block; color: white; font-weight: 600; margin-bottom: 0.5rem;" %>
            <%= form.text_field :name, class: "form-control", required: true,
                style: "background-color: #1E293B; border: 1px solid #334155; color: white; padding: 0.75rem; border-radius: 0.5rem;" %>
          </div>

          <%# Description %>
          <div style="margin-bottom: 1.5rem;">
            <%= form.label :description, "Description", style: "display: block; color: white; font-weight: 600; margin-bottom: 0.5rem;" %>
            <%= form.text_area :description, class: "form-control", rows: 3,
                style: "background-color: #1E293B; border: 1px solid #334155; color: white; padding: 0.75rem; border-radius: 0.5rem;" %>
          </div>

          <%# Email Template Selection %>
          <div style="margin-bottom: 1.5rem;">
            <%= form.label :email_template_id, "Email Template", style: "display: block; color: white; font-weight: 600; margin-bottom: 0.5rem;" %>

            <% if @email_templates.any? %>
              <div class="template-select-container">
                <%= form.collection_select :email_template_id, @email_templates, :id, :name,
                    { include_blank: "-- Select an email template --" },
                    { class: "form-select", required: true,
                      style: "background-color: #1E293B; border: 1px solid #334155; color: white; padding: 0.75rem; border-radius: 0.5rem;" } %>

                <% if @campaign.email_template.present? %>
                  <div style="display: flex; gap: 0.75rem; margin-top: 1rem;">
                    <%= link_to email_template_path(@campaign.email_template), class: "admin-btn admin-btn-outline" do %>
                      <i data-lucide="eye"></i>
                      <span>View Template</span>
                    <% end %>
                    <%= link_to improve_ai_content_path(@campaign.email_template), class: "admin-btn admin-btn-outline" do %>
                      <i data-lucide="bot"></i>
                      <span>Improve with AI</span>
                    <% end %>
                  </div>
                <% end %>
              </div>
            <% else %>
              <div style="background-color: rgba(251, 191, 36, 0.1); border: 1px solid rgba(251, 191, 36, 0.2); border-radius: 0.5rem; padding: 1rem;">
                <div style="display: flex; align-items: center; gap: 0.5rem; color: #FCD34D; margin-bottom: 0.75rem;">
                  <i data-lucide="alert-triangle" class="icon-md"></i>
                  <span style="font-weight: 600;">No email templates yet</span>
                </div>
                <div style="display: flex; gap: 0.75rem;">
                  <%= link_to new_email_template_path, class: "admin-btn admin-btn-outline" do %>
                    <i data-lucide="plus"></i>
                    <span>Create template</span>
                  <% end %>
                  <%= link_to new_ai_content_path, class: "admin-btn admin-btn-outline" do %>
                    <i data-lucide="bot"></i>
                    <span>Generate with AI</span>
                  <% end %>
                </div>
              </div>
            <% end %>
          </div>
        </div>

        <%# Right Column - Settings %>
        <div class="col-md-5">
          <%# Contact Groups %>
          <div style="margin-bottom: 1.5rem;">
            <label style="display: block; color: white; font-weight: 600; margin-bottom: 0.5rem;">Contact Groups</label>

            <% if @contact_groups.any? %>
              <div style="background-color: #1E293B; border: 1px solid #334155; border-radius: 0.5rem; overflow: hidden;">
                <div class="contact-groups-container" style="max-height: 240px; overflow-y: auto;">
                  <%= form.collection_check_boxes :contact_group_ids, @contact_groups, :id, :name do |b| %>
                    <div style="border-bottom: 1px solid #334155; padding: 0.75rem;">
                      <div class="form-check">
                        <%= b.check_box class: "form-check-input", style: "margin-right: 0.5rem;" %>
                        <%= b.label class: "form-check-label", style: "color: white; cursor: pointer;" do %>
                          <div style="font-weight: 500;"><%= b.text %></div>
                          <% group_count = b.object.contacts.count %>
                          <div style="color: #94A3B8; font-size: 0.875rem;"><%= pluralize(group_count, 'contact') %></div>
                        <% end %>
                      </div>
                    </div>
                  <% end %>
                </div>
              </div>

              <div style="color: #94A3B8; font-size: 0.875rem; margin-top: 0.5rem;">
                <% if @campaign.status == 'draft' %>
                  Select one or more contact groups to receive this campaign
                <% else %>
                  <i data-lucide="info" class="icon-sm" style="display: inline-block; vertical-align: middle; margin-right: 0.25rem;"></i>
                  Changes to contact groups will affect all unsent emails
                <% end %>
              </div>
            <% else %>
              <div style="background-color: rgba(251, 191, 36, 0.1); border: 1px solid rgba(251, 191, 36, 0.2); border-radius: 0.5rem; padding: 1rem;">
                <div style="display: flex; align-items: center; gap: 0.5rem; color: #FCD34D; margin-bottom: 0.75rem;">
                  <i data-lucide="alert-triangle" class="icon-md"></i>
                  <span style="font-weight: 600;">No contact groups yet</span>
                </div>
                <%= link_to new_contact_group_path, class: "admin-btn admin-btn-outline" do %>
                  <i data-lucide="plus"></i>
                  <span>Create contact group</span>
                <% end %>
              </div>
            <% end %>
          </div>

          <%# Status Section %>
          <% if @campaign.status == 'draft' %>
            <%# Editable Status for Draft %>
            <div style="margin-bottom: 1.5rem;">
              <%= form.label :status, "Status", style: "display: block; color: white; font-weight: 600; margin-bottom: 0.5rem;" %>
              <%= form.select :status, [['Draft', 'draft'], ['Scheduled', 'scheduled']], {},
                  { class: "form-select", id: "campaign_status_select",
                    style: "background-color: #1E293B; border: 1px solid #334155; color: white; padding: 0.75rem; border-radius: 0.5rem;" } %>
            </div>

            <div id="scheduled_at_container" style="display: none; margin-bottom: 1.5rem;">
              <%= form.label :scheduled_at, "Schedule Date & Time", style: "display: block; color: white; font-weight: 600; margin-bottom: 0.5rem;" %>
              <%= form.datetime_field :scheduled_at, class: "form-control",
                  style: "background-color: #1E293B; border: 1px solid #334155; color: white; padding: 0.75rem; border-radius: 0.5rem;" %>
              <div style="color: #94A3B8; font-size: 0.875rem; margin-top: 0.5rem;">
                When should this campaign be sent?
              </div>
            </div>
          <% else %>
            <%# Read-Only Status Display %>
            <div style="margin-bottom: 1.5rem;">
              <label style="display: block; color: white; font-weight: 600; margin-bottom: 0.5rem;">Status</label>
              <div class="admin-badge admin-badge-<%= @campaign.status == 'scheduled' ? 'warning' : @campaign.status == 'sent' ? 'online' : 'info' %>" style="padding: 1rem; font-size: 1rem; display: block;">
                <%= @campaign.status.humanize %>

                <% if @campaign.scheduled_at.present? && @campaign.status == 'scheduled' %>
                  <div style="font-size: 0.875rem; margin-top: 0.5rem; opacity: 0.9;">
                    Scheduled for <%= @campaign.scheduled_at.strftime('%b %d, %Y at %I:%M %p') %>
                  </div>
                <% end %>
              </div>

              <% if @campaign.status == 'scheduled' %>
                <div style="margin-top: 0.75rem;">
                  <button type="button" class="admin-btn admin-btn-outline" data-bs-toggle="modal" data-bs-target="#rescheduleModal">
                    <i data-lucide="calendar"></i>
                    <span>Reschedule</span>
                  </button>
                </div>
              <% end %>

              <%= form.hidden_field :status %>
              <%= form.hidden_field :scheduled_at %>
            </div>
          <% end %>
        </div>
      </div>

      <%# Campaign Performance Stats %>
      <% if @campaign.email_template.present? && @campaign.sent_count > 0 %>
        <div style="border-top: 1px solid #334155; margin-top: 2rem; padding-top: 2rem;">
          <h5 style="color: white; font-weight: 600; margin-bottom: 1.5rem;">Campaign Performance</h5>

          <div class="row">
            <div class="col-md-3 mb-3">
              <div class="admin-stats">
                <div class="stat-value"><%= @campaign.contact_count %></div>
                <div class="stat-label">Total Recipients</div>
              </div>
            </div>
            <div class="col-md-3 mb-3">
              <div class="admin-stats">
                <div class="stat-value"><%= @campaign.sent_count %></div>
                <div class="stat-label">Emails Sent</div>
              </div>
            </div>
            <div class="col-md-3 mb-3">
              <div class="admin-stats">
                <div class="stat-value"><%= @campaign.open_rate %>%</div>
                <div class="stat-label">Open Rate</div>
              </div>
            </div>
            <div class="col-md-3 mb-3">
              <div class="admin-stats">
                <div class="stat-value"><%= @campaign.click_rate %>%</div>
                <div class="stat-label">Click Rate</div>
              </div>
            </div>
          </div>

          <div style="text-align: right; margin-top: 1rem;">
            <%= link_to ai_analyze_campaign_path(@campaign), class: "admin-btn admin-btn-primary" do %>
              <i data-lucide="bot"></i>
              <span>AI Analysis & Insights</span>
            <% end %>
          </div>
        </div>
      <% end %>

      <%# Action Buttons %>
      <div style="display: flex; justify-content: space-between; padding-top: 1.5rem; border-top: 1px solid #334155; margin-top: 1.5rem;">
        <%= link_to campaign_path(@campaign), class: "admin-btn admin-btn-outline" do %>
          <i data-lucide="x"></i>
          <span>Cancel</span>
        <% end %>
        <%= form.submit 'Update Campaign', class: "admin-btn admin-btn-primary" %>
      </div>
    <% end %>
  </div>
</div>

<%# Reschedule Modal %>
<% if @campaign.status == 'scheduled' %>
  <div class="modal fade" id="rescheduleModal" tabindex="-1" aria-labelledby="rescheduleModalLabel" aria-hidden="true">
    <div class="modal-dialog">
      <div class="modal-content" style="background-color: #1E293B; border: 1px solid #334155;">
        <div class="modal-header" style="border-bottom: 1px solid #334155;">
          <h5 class="modal-title" id="rescheduleModalLabel" style="color: white;">Reschedule Campaign</h5>
          <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <%= form_tag schedule_campaign_path(@campaign), method: :post do %>
          <div class="modal-body">
            <p style="color: #94A3B8;">
              Current schedule: <strong style="color: white;"><%= @campaign.scheduled_at.strftime('%b %d, %Y at %I:%M %p') %></strong>
            </p>

            <div style="margin-bottom: 1rem;">
              <label for="scheduled_at" style="display: block; color: white; font-weight: 600; margin-bottom: 0.5rem;">New Schedule Date and Time</label>
              <input type="datetime-local" class="form-control" id="scheduled_at" name="scheduled_at" required
                     style="background-color: #0F172A; border: 1px solid #334155; color: white; padding: 0.75rem; border-radius: 0.5rem;">
            </div>
          </div>
          <div class="modal-footer" style="border-top: 1px solid #334155;">
            <button type="button" class="admin-btn admin-btn-outline" data-bs-dismiss="modal">Cancel</button>
            <button type="submit" class="admin-btn admin-btn-primary">Reschedule</button>
          </div>
        <% end %>
      </div>
    </div>
  </div>
<% end %>

<script>
  document.addEventListener('turbo:load', () => {
    lucide.createIcons();
    initCampaignEdit();
  });

  document.addEventListener('DOMContentLoaded', () => {
    lucide.createIcons();
    initCampaignEdit();
  });

  function initCampaignEdit() {
    <% if @campaign.status == 'draft' %>
      const statusSelect = document.getElementById('campaign_status_select');
      const scheduledAtContainer = document.getElementById('scheduled_at_container');

      if (!statusSelect || !scheduledAtContainer) return;

      function toggleScheduledAt() {
        if (statusSelect.value === 'scheduled') {
          scheduledAtContainer.style.display = 'block';

          // Set default date time to tomorrow, same time
          const tomorrow = new Date();
          tomorrow.setDate(tomorrow.getDate() + 1);

          // Format for datetime-local
          const year = tomorrow.getFullYear();
          const month = String(tomorrow.getMonth() + 1).padStart(2, '0');
          const day = String(tomorrow.getDate()).padStart(2, '0');
          const hours = String(tomorrow.getHours()).padStart(2, '0');
          const minutes = String(tomorrow.getMinutes()).padStart(2, '0');

          const scheduledInput = document.getElementById('campaign_scheduled_at');
          if (scheduledInput && !scheduledInput.value) {
            scheduledInput.value = `${year}-${month}-${day}T${hours}:${minutes}`;
          }
        } else {
          scheduledAtContainer.style.display = 'none';
        }
      }

      // Initial check
      toggleScheduledAt();

      // Add event listener
      statusSelect.addEventListener('change', toggleScheduledAt);
    <% end %>

    <% if @campaign.status == 'scheduled' %>
      // Set default date time for reschedule modal
      const scheduledDate = new Date('<%= @campaign.scheduled_at.iso8601 %>');

      // Format for datetime-local
      const year = scheduledDate.getFullYear();
      const month = String(scheduledDate.getMonth() + 1).padStart(2, '0');
      const day = String(scheduledDate.getDate()).padStart(2, '0');
      const hours = String(scheduledDate.getHours()).padStart(2, '0');
      const minutes = String(scheduledDate.getMinutes()).padStart(2, '0');

      const modalInput = document.getElementById('scheduled_at');
      if (modalInput) {
        modalInput.value = `${year}-${month}-${day}T${hours}:${minutes}`;
      }
    <% end %>
  }
</script>
