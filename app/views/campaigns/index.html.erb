<div class="container mt-4">
  <div class="row">
    <div class="col-md-12">
      <div class="card shadow">
        <div class="card-header d-flex justify-content-between align-items-center bg-primary text-white">
          <h2><i class="fas fa-paper-plane me-2"></i> Campaigns</h2>
          <%= link_to new_campaign_path, class: "btn btn-light" do %>
            <i class="fas fa-plus me-1"></i> New Campaign
          <% end %>
        </div>
        <div class="card-body">
          <% if @campaigns.any? %>
            <div class="table-responsive">
              <table class="table table-hover">
                <thead>
                  <tr>
                    <th>Name</th>
                    <th>Status</th>
                    <th>Template</th>
                    <th>Contacts</th>
                    <th>Scheduled</th>
                    <th>Performance</th>
                    <th style="width: 200px;">Actions</th>
                  </tr>
                </thead>
                <tbody>
                  <% @campaigns.each do |campaign| %>
                    <tr>
                      <td>
                        <strong><%= link_to campaign.name, campaign_path(campaign), class: "text-decoration-none" %></strong>
                        <div class="small text-muted"><%= truncate(campaign.description, length: 50) if campaign.description.present? %></div>
                      </td>
                      <td>
                        <span class="badge bg-<%= campaign_status_color(campaign.status) %>"><%= campaign.status.humanize %></span>
                      </td>
                      <td><%= campaign.email_template&.name || "—" %></td>
                      <td><%= campaign.contact_count %></td>
                      <td>
                        <% if campaign.scheduled_at.present? %>
                          <%= campaign.scheduled_at.strftime('%b %d, %Y') %>
                          <div class="small text-muted"><%= campaign.scheduled_at.strftime('%I:%M %p') %></div>
                        <% else %>
                          —
                        <% end %>
                      </td>
                      <td>
                        <% if campaign.sent_count > 0 %>
                          <div class="d-flex align-items-center mb-1">
                            <div class="me-2" style="width: 75px;">Open Rate:</div>
                            <div class="progress flex-grow-1" style="height: 6px;">
                              <div class="progress-bar bg-success" role="progressbar" style="width: <%= [campaign.open_rate, 100].min %>%"></div>
                            </div>
                            <div class="ms-2 small"><%= campaign.open_rate %>%</div>
                          </div>
                          <div class="d-flex align-items-center">
                            <div class="me-2" style="width: 75px;">Click Rate:</div>
                            <div class="progress flex-grow-1" style="height: 6px;">
                              <div class="progress-bar bg-info" role="progressbar" style="width: <%= [campaign.click_rate, 100].min %>%"></div>
                            </div>
                            <div class="ms-2 small"><%= campaign.click_rate %>%</div>
                          </div>
                        <% else %>
                          <span class="text-muted">No data yet</span>
                        <% end %>
                      </td>
                      <td>
                        <div class="btn-group">
                          <%= link_to campaign_path(campaign), class: "btn btn-sm btn-outline-primary" do %>
                            <i class="fas fa-eye"></i>
                          <% end %>
                          <%= link_to edit_campaign_path(campaign), class: "btn btn-sm btn-outline-secondary" do %>
                            <i class="fas fa-edit"></i>
                          <% end %>
                          
                          <button type="button" class="btn btn-sm btn-outline-dark dropdown-toggle dropdown-toggle-split" data-bs-toggle="dropdown" aria-expanded="false">
                            <span class="visually-hidden">Toggle Dropdown</span>
                          </button>
                          <ul class="dropdown-menu dropdown-menu-end">
                            <% if campaign.status == 'draft' %>
                              <li>
                                <a href="#" class="dropdown-item" 
                                  onclick="showScheduleModal('<%= campaign.id %>')">
                                  <i class="fas fa-calendar-plus me-2"></i> Schedule
                                </a>
                              </li>
                              <li>
                                <%= button_to send_now_campaign_path(campaign), method: :post, 
                                    class: "dropdown-item",
                                    data: { turbo_confirm: "Are you sure you want to send this campaign immediately?" } do %>
                                  <i class="fas fa-paper-plane me-2"></i> Send Now
                                <% end %>
                              </li>
                            <% elsif campaign.status == 'scheduled' || campaign.status == 'in_progress' %>
                              <li>
                                <%= button_to pause_campaign_path(campaign), method: :post, class: "dropdown-item" do %>
                                  <i class="fas fa-pause me-2"></i> Pause
                                <% end %>
                              </li>
                            <% elsif campaign.status == 'paused' %>
                              <li>
                                <%= button_to resume_campaign_path(campaign), method: :post, class: "dropdown-item" do %>
                                  <i class="fas fa-play me-2"></i> Resume
                                <% end %>
                              </li>
                            <% end %>
                            
                            <% unless campaign.status == 'stopped' || campaign.status == 'completed' %>
                              <li>
                                <%= button_to stop_campaign_path(campaign), method: :post, 
                                    class: "dropdown-item text-danger",
                                    data: { turbo_confirm: "Are you sure you want to stop this campaign? This action cannot be undone." } do %>
                                  <i class="fas fa-stop-circle me-2"></i> Stop
                                <% end %>
                              </li>
                            <% end %>
                            
                            <% if campaign.status == 'stopped' || campaign.status == 'completed' %>
                              <li>
                                <%= button_to reactivate_campaign_path(campaign), method: :post, 
                                    class: "dropdown-item",
                                    data: { turbo_confirm: "This will reactivate the campaign and set it to draft status. Proceed?" } do %>
                                  <i class="fas fa-redo me-2"></i> Reactivate to Draft
                                <% end %>
                              </li>
                            <% end %>
                            
                            <% if campaign.sent_count > 0 %>
                              <li><hr class="dropdown-divider"></li>
                              <li>
                                <%= link_to ai_analyze_campaign_path(campaign), class: "dropdown-item" do %>
                                  <i class="fas fa-robot me-2"></i> AI Analysis
                                <% end %>
                              </li>
                            <% end %>
                            
                            <li><hr class="dropdown-divider"></li>
                            <li>
                              <%= button_to campaign_path(campaign), method: :delete, 
                                  class: "dropdown-item text-danger",
                                  data: { turbo_confirm: "Are you sure you want to delete this campaign?" } do %>
                                <i class="fas fa-trash me-2"></i> Delete
                              <% end %>
                            </li>
                          </ul>
                        </div>
                      </td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            </div>
          <% else %>
            <div class="text-center p-5">
              <div class="mb-4">
                <i class="fas fa-paper-plane fa-3x text-muted"></i>
              </div>
              <h4>No campaigns yet</h4>
              <p class="text-muted">Create your first email campaign to start connecting with your audience.</p>
              <%= link_to new_campaign_path, class: "btn btn-primary" do %>
                <i class="fas fa-plus me-1"></i> Create Campaign
              <% end %>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Schedule Modal -->
<div class="modal fade" id="scheduleModal" tabindex="-1" aria-labelledby="scheduleModalLabel" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="scheduleModalLabel">Schedule Campaign</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <%= form_tag '', method: :post, id: "scheduleForm" do %>
        <div class="modal-body">
          <div class="mb-3">
            <label for="scheduled_at" class="form-label">Schedule Date and Time</label>
            <input type="datetime-local" class="form-control" id="scheduled_at" name="scheduled_at" required>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-primary">Schedule</button>
        </div>
      <% end %>
    </div>
  </div>
</div>

<script>
  document.addEventListener('turbo:load', function() {
    // Setup for the schedule modal
    window.showScheduleModal = function(campaignId) {
      // Set the form action to the correct path
      const form = document.getElementById('scheduleForm');
      if (form) {
        form.action = `/campaigns/${campaignId}/schedule`;
        
        // Set default date time to tomorrow, same time
        const tomorrow = new Date();
        tomorrow.setDate(tomorrow.getDate() + 1);
        
        // Format for datetime-local
        const year = tomorrow.getFullYear();
        const month = String(tomorrow.getMonth() + 1).padStart(2, '0');
        const day = String(tomorrow.getDate()).padStart(2, '0');
        const hours = String(tomorrow.getHours()).padStart(2, '0');
        const minutes = String(tomorrow.getMinutes()).padStart(2, '0');
        
        document.getElementById('scheduled_at').value = `${year}-${month}-${day}T${hours}:${minutes}`;
        
        // Show the modal
        const modal = new bootstrap.Modal(document.getElementById('scheduleModal'));
        modal.show();
      } else {
        console.error("Schedule form not found!");
      }
    }
  });
  
  // Fallback for non-Turbo environments
  function showScheduleModal(campaignId) {
    // Set the form action to the correct path
    const form = document.getElementById('scheduleForm');
    if (form) {
      form.action = `/campaigns/${campaignId}/schedule`;
      
      // Set default date time to tomorrow, same time
      const tomorrow = new Date();
      tomorrow.setDate(tomorrow.getDate() + 1);
      
      // Format for datetime-local
      const year = tomorrow.getFullYear();
      const month = String(tomorrow.getMonth() + 1).padStart(2, '0');
      const day = String(tomorrow.getDate()).padStart(2, '0');
      const hours = String(tomorrow.getHours()).padStart(2, '0');
      const minutes = String(tomorrow.getMinutes()).padStart(2, '0');
      
      document.getElementById('scheduled_at').value = `${year}-${month}-${day}T${hours}:${minutes}`;
      
      // Show the modal
      const modal = new bootstrap.Modal(document.getElementById('scheduleModal'));
      modal.show();
    } else {
      console.error("Schedule form not found!");
    }
  }
</script>
