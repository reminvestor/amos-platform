<div class="container mt-4">
  <div class="row">
    <div class="col-md-12">
      <div class="card shadow">
        <div class="card-header d-flex justify-content-between align-items-center bg-primary text-white">
          <h2><i class="fas fa-paper-plane me-2"></i> Campaigns</h2>
          <%= link_to new_campaign_path, class: "btn btn-light" do %>
            <i class="fas fa-plus me-1"></i> New Campaign
          <% end %>
        </div>
        <div class="card-body">
          <% if @parent_campaigns.any? %>
            <%= render partial: 'campaign_table' %>
          <% else %>
            <div class="text-center p-5">
              <div class="mb-4">
                <i class="fas fa-paper-plane fa-3x text-muted"></i>
              </div>
              <h4>No campaigns yet</h4>
              <p class="text-muted">Create your first email campaign to start connecting with your audience.</p>
              <%= link_to new_campaign_path, class: "btn btn-primary" do %>
                <i class="fas fa-plus me-1"></i> Create Campaign
              <% end %>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Schedule Modal -->
<div class="modal fade" id="scheduleModal" tabindex="-1" aria-labelledby="scheduleModalLabel" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="scheduleModalLabel">Schedule Campaign</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <%= form_tag '', method: :post, id: "scheduleForm" do %>
        <div class="modal-body">
          <div class="mb-3">
            <label for="scheduled_at" class="form-label">Schedule Date and Time</label>
            <input type="datetime-local" class="form-control" id="scheduled_at" name="scheduled_at" required>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-primary">Schedule</button>
        </div>
      <% end %>
    </div>
  </div>
</div>

<script>
  document.addEventListener('turbo:load', function() {
    // Setup for the schedule modal
    window.showScheduleModal = function(campaignId) {
      // Set the form action to the correct path
      const form = document.getElementById('scheduleForm');
      if (form) {
        form.action = `/campaigns/${campaignId}/schedule`;
        
        // Set default date time to tomorrow, same time
        const tomorrow = new Date();
        tomorrow.setDate(tomorrow.getDate() + 1);
        
        // Format for datetime-local
        const year = tomorrow.getFullYear();
        const month = String(tomorrow.getMonth() + 1).padStart(2, '0');
        const day = String(tomorrow.getDate()).padStart(2, '0');
        const hours = String(tomorrow.getHours()).padStart(2, '0');
        const minutes = String(tomorrow.getMinutes()).padStart(2, '0');
        
        document.getElementById('scheduled_at').value = `${year}-${month}-${day}T${hours}:${minutes}`;
        
        // Show the modal
        const modal = new bootstrap.Modal(document.getElementById('scheduleModal'));
        modal.show();
      } else {
        console.error("Schedule form not found!");
      }
    }
  });
  
  // Fallback for non-Turbo environments
  function showScheduleModal(campaignId) {
    // Set the form action to the correct path
    const form = document.getElementById('scheduleForm');
    if (form) {
      form.action = `/campaigns/${campaignId}/schedule`;
      
      // Set default date time to tomorrow, same time
      const tomorrow = new Date();
      tomorrow.setDate(tomorrow.getDate() + 1);
      
      // Format for datetime-local
      const year = tomorrow.getFullYear();
      const month = String(tomorrow.getMonth() + 1).padStart(2, '0');
      const day = String(tomorrow.getDate()).padStart(2, '0');
      const hours = String(tomorrow.getHours()).padStart(2, '0');
      const minutes = String(tomorrow.getMinutes()).padStart(2, '0');
      
      document.getElementById('scheduled_at').value = `${year}-${month}-${day}T${hours}:${minutes}`;
      
      // Show the modal
      const modal = new bootstrap.Modal(document.getElementById('scheduleModal'));
      modal.show();
    } else {
      console.error("Schedule form not found!");
    }
  }
</script>

<script>
  // Direct toggle function for onclick attribute
  function toggleChildRows(parentId) {
    console.log('Toggle function called for parent:', parentId);
    
    // Find all child rows
    const childRows = document.querySelectorAll('.child-of-' + parentId);
    console.log('Found child rows:', childRows.length);
    
    if (childRows.length === 0) {
      console.error('No child rows found for parent ID:', parentId);
      return;
    }
    
    // Check current visibility of first row
    const firstRow = childRows[0];
    const isCurrentlyHidden = firstRow.style.display === 'none' || firstRow.style.display === '';
    
    // Toggle all rows
    childRows.forEach(function(row) {
      row.style.display = isCurrentlyHidden ? 'table-row' : 'none';
    });
    
    // Toggle icon
    const icon = document.getElementById('toggle-icon-' + parentId);
    if (icon) {
      if (isCurrentlyHidden) {
        icon.classList.remove('fa-plus');
        icon.classList.add('fa-minus');
      } else {
        icon.classList.remove('fa-minus');
        icon.classList.add('fa-plus');
      }
    } else {
      console.error('Icon element not found for parent ID:', parentId);
    }
  }
</script>
