
<div class="container-fluid py-4">
  <%# Page Header %>
  <div class="admin-page-header">
    <div class="header-left">
      <div class="header-icon">
        <i data-lucide="mail"></i>
      </div>
      <div class="header-text">
        <h1>Email Campaigns</h1>
        <p>Create and manage your email marketing campaigns</p>
      </div>
    </div>

    <div class="header-actions">
      <%= link_to new_campaign_path, class: "admin-btn admin-btn-primary" do %>
        <i data-lucide="plus"></i>
        <span>New Campaign</span>
      <% end %>
    </div>
  </div>

  <% if @parent_campaigns.any? %>
    <%= render partial: 'campaign_table' %>
  <% else %>
    <%# Empty State %>
    <div class="admin-card">
      <div class="admin-empty-state">
        <div class="empty-icon">
          <i data-lucide="mail"></i>
        </div>
        <h3>No Campaigns Yet</h3>
        <p>Create your first email campaign to start connecting with your audience</p>
        <%= link_to new_campaign_path, class: "admin-btn admin-btn-primary mt-3" do %>
          <i data-lucide="plus" aria-hidden="true"></i>
          <span>Create Campaign</span>
        <% end %>
      </div>
    </div>
  <% end %>
</div>

<%# Schedule Modal - Uses Theme CSS Variables %>
<div class="modal fade" id="scheduleModal" tabindex="-1" aria-labelledby="scheduleModalLabel" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="scheduleModalLabel">Schedule Campaign</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <%= form_tag '', method: :post, id: "scheduleForm", class: "needs-validation", novalidate: true do %>
        <div class="modal-body">
          <div class="mb-3">
            <label for="scheduled_at" class="form-label">Schedule Date and Time</label>
            <input type="datetime-local" class="form-control" id="scheduled_at" name="scheduled_at" required>
            <div class="invalid-feedback">
              Please select a future date and time.
            </div>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-primary">
            <i data-lucide="clock" class="icon-sm me-1" aria-hidden="true"></i>
            Schedule
          </button>
        </div>
      <% end %>
    </div>
  </div>
</div>

<script>
  document.addEventListener('turbo:load', function() {
    // Lucide icons
    if (typeof lucide !== 'undefined') {
      lucide.createIcons();
    }

    // Bootstrap form validation
    const forms = document.querySelectorAll('.needs-validation');
    Array.from(forms).forEach(form => {
      form.addEventListener('submit', event => {
        if (!form.checkValidity()) {
          event.preventDefault();
          event.stopPropagation();
        }
        form.classList.add('was-validated');
      }, false);
    });

    // Setup for the schedule modal
    window.showScheduleModal = function(campaignId) {
      const form = document.getElementById('scheduleForm');
      if (form) {
        form.action = `/campaigns/${campaignId}/schedule`;
        form.classList.remove('was-validated'); // Reset validation state

        // Set default date time to tomorrow, same time
        const tomorrow = new Date();
        tomorrow.setDate(tomorrow.getDate() + 1);

        // Format for datetime-local
        const year = tomorrow.getFullYear();
        const month = String(tomorrow.getMonth() + 1).padStart(2, '0');
        const day = String(tomorrow.getDate()).padStart(2, '0');
        const hours = String(tomorrow.getHours()).padStart(2, '0');
        const minutes = String(tomorrow.getMinutes()).padStart(2, '0');

        const scheduledInput = document.getElementById('scheduled_at');
        scheduledInput.value = `${year}-${month}-${day}T${hours}:${minutes}`;

        // Set minimum date to now (prevent scheduling in the past)
        const now = new Date();
        const minDateTime = `${now.getFullYear()}-${String(now.getMonth() + 1).padStart(2, '0')}-${String(now.getDate()).padStart(2, '0')}T${String(now.getHours()).padStart(2, '0')}:${String(now.getMinutes()).padStart(2, '0')}`;
        scheduledInput.min = minDateTime;

        // Show the modal
        const modal = new bootstrap.Modal(document.getElementById('scheduleModal'));
        modal.show();
      }
    }
  });

  document.addEventListener('DOMContentLoaded', function() {
    if (typeof lucide !== 'undefined') {
      lucide.createIcons();
    }
  });

  // Fallback for non-Turbo environments
  function showScheduleModal(campaignId) {
    const form = document.getElementById('scheduleForm');
    if (form) {
      form.action = `/campaigns/${campaignId}/schedule`;

      const tomorrow = new Date();
      tomorrow.setDate(tomorrow.getDate() + 1);

      const year = tomorrow.getFullYear();
      const month = String(tomorrow.getMonth() + 1).padStart(2, '0');
      const day = String(tomorrow.getDate()).padStart(2, '0');
      const hours = String(tomorrow.getHours()).padStart(2, '0');
      const minutes = String(tomorrow.getMinutes()).padStart(2, '0');

      document.getElementById('scheduled_at').value = `${year}-${month}-${day}T${hours}:${minutes}`;

      const modal = new bootstrap.Modal(document.getElementById('scheduleModal'));
      modal.show();
    }
  }

  // Direct toggle function for onclick attribute
  function toggleChildRows(parentId) {
    const childRows = document.querySelectorAll('.child-of-' + parentId);

    if (childRows.length === 0) return;

    // Check current visibility of first row
    const firstRow = childRows[0];
    const isCurrentlyHidden = firstRow.style.display === 'none' || firstRow.style.display === '';

    // Toggle all rows
    childRows.forEach(function(row) {
      row.style.display = isCurrentlyHidden ? 'table-row' : 'none';
    });

    // Toggle icon
    const icon = document.getElementById('toggle-icon-' + parentId);
    if (icon) {
      if (isCurrentlyHidden) {
        icon.setAttribute('data-lucide', 'chevron-down');
      } else {
        icon.setAttribute('data-lucide', 'chevron-right');
      }
      lucide.createIcons();
    }
  }
</script>
