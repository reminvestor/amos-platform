<div class="admin-card">
  <h3 class="card-title">
    <i data-lucide="list" class="icon-lg icon-with-spacing"></i>
    All Campaigns
  </h3>

  <div class="table-responsive">
    <table class="admin-table" id="campaignsTable">
      <thead>
        <tr>
          <th class="col-toggle"></th>
          <th>Name</th>
          <th>Status</th>
          <th>Template</th>
          <th>Contacts</th>
          <th>Scheduled</th>
          <th>Performance</th>
          <th class="col-actions text-end">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% @parent_campaigns.each do |campaign| %>
          <tr id="parent-campaign-<%= campaign.id %>" class="parent-row">
            <td>
              <% if @child_campaigns_by_parent[campaign.id].present? %>
                <button class="admin-btn admin-btn-sm admin-btn-outline toggle-children"
                        data-parent-id="<%= campaign.id %>"
                        onclick="toggleChildRows('<%= campaign.id %>')"
                        aria-label="Toggle child campaigns"
                        aria-expanded="false">
                  <i data-lucide="chevron-right" id="toggle-icon-<%= campaign.id %>" class="icon-md" aria-hidden="true"></i>
                </button>
              <% end %>
            </td>
            <td>
              <%= link_to campaign.name, campaign_path(campaign), class: "campaign-link fw-semibold" %>
              <% if campaign.description.present? %>
                <div class="campaign-desc"><%= truncate(campaign.description, length: 50) %></div>
              <% end %>
            </td>
            <td>
              <% if campaign.status == 'active' %>
                <span class="admin-badge admin-badge-online">Active</span>
              <% elsif campaign.status == 'draft' %>
                <span class="admin-badge admin-badge-default">Draft</span>
              <% elsif campaign.status == 'scheduled' %>
                <span class="admin-badge admin-badge-cyan">Scheduled</span>
              <% elsif campaign.status == 'in_progress' %>
                <span class="admin-badge admin-badge-cyan">In Progress</span>
              <% elsif campaign.status == 'paused' %>
                <span class="admin-badge admin-badge-warning">Paused</span>
              <% elsif campaign.status == 'stopped' %>
                <span class="admin-badge admin-badge-offline">Stopped</span>
              <% elsif campaign.status == 'completed' %>
                <span class="admin-badge admin-badge-online">Completed</span>
              <% else %>
                <span class="admin-badge admin-badge-default"><%= campaign.status.humanize %></span>
              <% end %>

              <% if campaign.stalled? %>
                <div class="mt-1">
                  <span class="admin-badge admin-badge-offline" title="Campaign appears to be stalled">
                    <i data-lucide="alert-triangle" class="icon-xs"></i> Stalled
                  </span>
                </div>
              <% end %>
            </td>
            <td class="campaign-secondary"><%= campaign.email_template&.name || "—" %></td>
            <td class="campaign-stat"><%= campaign.contact_count %></td>
            <td class="campaign-secondary">
              <% if campaign.scheduled_at.present? %>
                <%= campaign.scheduled_at.strftime('%b %d, %Y') %>
                <div class="campaign-desc"><%= campaign.scheduled_at.strftime('%I:%M %p') %></div>
              <% else %>
                —
              <% end %>
            </td>
            <td>
              <% if campaign.sent_count > 0 %>
                <%# Open Rate %>
                <div class="performance-row">
                  <div class="performance-label">Open Rate:</div>
                  <div class="performance-bar">
                    <div class="performance-fill performance-fill-success" data-width="<%= [campaign.open_rate, 100].min %>"></div>
                  </div>
                  <div class="performance-value"><%= campaign.open_rate %>%</div>
                </div>
                <%# Click Rate %>
                <div class="performance-row">
                  <div class="performance-label">Click Rate:</div>
                  <div class="performance-bar">
                    <div class="performance-fill performance-fill-info" data-width="<%= [campaign.click_rate, 100].min %>"></div>
                  </div>
                  <div class="performance-value"><%= campaign.click_rate %>%</div>
                </div>
              <% else %>
                <span class="campaign-muted">No data yet</span>
              <% end %>
            </td>
            <td style="text-align: right;">
              <div style="display: inline-flex; gap: 0.5rem;">
                <%= link_to campaign_path(campaign), class: "admin-btn admin-btn-sm admin-btn-outline", "aria-label": "View #{campaign.name}" do %>
                  <i data-lucide="eye" aria-hidden="true"></i>
                <% end %>
                <%= link_to edit_campaign_path(campaign), class: "admin-btn admin-btn-sm admin-btn-outline", "aria-label": "Edit #{campaign.name}" do %>
                  <i data-lucide="pencil" aria-hidden="true"></i>
                <% end %>

                <div class="dropdown" style="display: inline-block;">
                  <button type="button" class="admin-btn admin-btn-sm admin-btn-outline" data-bs-toggle="dropdown" aria-expanded="false" aria-label="More actions for #{campaign.name}">
                    <i data-lucide="more-vertical" aria-hidden="true"></i>
                  </button>
                  <ul class="dropdown-menu dropdown-menu-end">
                    <% if campaign.status == 'draft' %>
                      <li>
                        <a href="#" class="dropdown-item"
                          onclick="showScheduleModal('<%= campaign.id %>')">
                          <i data-lucide="calendar-plus" class="icon-md icon-with-spacing" aria-hidden="true"></i> Schedule
                        </a>
                      </li>
                      <li>
                        <%= button_to send_now_campaign_path(campaign), method: :post,
                            class: "dropdown-item",
                            data: { turbo_confirm: "Are you sure you want to send this campaign immediately?" } do %>
                          <i data-lucide="send" class="icon-md icon-with-spacing" aria-hidden="true"></i> Send Now
                        <% end %>
                      </li>
                    <% elsif campaign.status == 'scheduled' || campaign.status == 'in_progress' %>
                      <li>
                        <%= button_to pause_campaign_path(campaign), method: :post, class: "dropdown-item" do %>
                          <i data-lucide="pause" class="icon-md icon-with-spacing" aria-hidden="true"></i> Pause
                        <% end %>
                      </li>
                      <% if campaign.stalled? %>
                        <li>
                          <%= button_to force_resume_campaign_path(campaign), method: :post,
                              class: "dropdown-item text-danger",
                              data: {
                                turbo_confirm: "This will sync with Mailgun, retry failed emails, and resume sending. Continue?"
                              } do %>
                            <i data-lucide="alert-triangle" class="icon-md icon-with-spacing" aria-hidden="true"></i> Force Resume (Stalled)
                          <% end %>
                        </li>
                      <% end %>
                    <% elsif campaign.status == 'paused' %>
                      <li>
                        <%= button_to resume_campaign_path(campaign), method: :post, class: "dropdown-item" do %>
                          <i data-lucide="play" class="icon-md icon-with-spacing" aria-hidden="true"></i> Resume
                        <% end %>
                      </li>
                    <% end %>

                    <% unless campaign.status == 'stopped' || campaign.status == 'completed' %>
                      <li>
                        <%= button_to stop_campaign_path(campaign), method: :post,
                            class: "dropdown-item text-danger",
                            data: { turbo_confirm: "Are you sure you want to stop this campaign? This action cannot be undone." } do %>
                          <i data-lucide="stop-circle" class="icon-md icon-with-spacing" aria-hidden="true"></i> Stop
                        <% end %>
                      </li>
                    <% end %>

                    <% if campaign.status == 'stopped' || campaign.status == 'completed' %>
                      <li>
                        <%= button_to reactivate_campaign_path(campaign), method: :post,
                            class: "dropdown-item",
                            data: { turbo_confirm: "This will reactivate the campaign and set it to draft status. Proceed?" } do %>
                          <i data-lucide="rotate-ccw" class="icon-md icon-with-spacing" aria-hidden="true"></i> Reactivate to Draft
                        <% end %>
                      </li>
                    <% end %>

                    <% if campaign.sent_count > 0 %>
                      <li><hr class="dropdown-divider"></li>
                      <li>
                        <%= link_to ai_analyze_campaign_path(campaign), class: "dropdown-item" do %>
                          <i data-lucide="brain" class="icon-md icon-with-spacing" aria-hidden="true"></i> AI Analysis
                        <% end %>
                      </li>
                    <% end %>

                    <li><hr class="dropdown-divider"></li>
                    <li>
                      <%= button_to campaign_path(campaign), method: :delete,
                          class: "dropdown-item text-danger",
                          data: { turbo_confirm: "Are you sure you want to delete this campaign?" } do %>
                        <i data-lucide="trash-2" class="icon-md icon-with-spacing" aria-hidden="true"></i> Delete
                      <% end %>
                    </li>
                  </ul>
                </div>
              </div>
            </td>
          </tr>

          <%# Child Campaigns %>
          <% if @child_campaigns_by_parent[campaign.id].present? %>
            <% @child_campaigns_by_parent[campaign.id].each do |child_campaign| %>
              <tr id="child-of-<%= campaign.id %>-<%= child_campaign.id %>" class="child-row child-of-<%= campaign.id %>">
                <td></td>
                <td class="ps-4">
                  <i data-lucide="corner-down-right" class="child-icon"></i>
                  <%= link_to child_campaign.name, campaign_path(child_campaign), class: "campaign-link fw-semibold" %>
                  <% if child_campaign.description.present? %>
                    <div class="campaign-desc"><%= truncate(child_campaign.description, length: 50) %></div>
                  <% end %>
                </td>
                <td>
                  <% if child_campaign.status == 'active' %>
                    <span class="admin-badge admin-badge-online">Active</span>
                  <% elsif child_campaign.status == 'completed' %>
                    <span class="admin-badge admin-badge-online">Completed</span>
                  <% else %>
                    <span class="admin-badge admin-badge-default"><%= child_campaign.status.humanize %></span>
                  <% end %>
                </td>
                <td class="campaign-secondary"><%= child_campaign.email_template&.name || "—" %></td>
                <td class="campaign-stat"><%= child_campaign.contact_count %></td>
                <td class="campaign-secondary">
                  <% if child_campaign.scheduled_at.present? %>
                    <%= child_campaign.scheduled_at.strftime('%b %d, %Y') %>
                    <div class="campaign-desc"><%= child_campaign.scheduled_at.strftime('%I:%M %p') %></div>
                  <% else %>
                    —
                  <% end %>
                </td>
                <td>
                  <% if child_campaign.sent_count > 0 %>
                    <div class="performance-row">
                      <div class="performance-label">Open Rate:</div>
                      <div class="performance-bar">
                        <div class="performance-fill performance-fill-success" data-width="<%= [child_campaign.open_rate, 100].min %>"></div>
                      </div>
                      <div class="performance-value"><%= child_campaign.open_rate %>%</div>
                    </div>
                    <div class="performance-row">
                      <div class="performance-label">Click Rate:</div>
                      <div class="performance-bar">
                        <div class="performance-fill performance-fill-info" data-width="<%= [child_campaign.click_rate, 100].min %>"></div>
                      </div>
                      <div class="performance-value"><%= child_campaign.click_rate %>%</div>
                    </div>
                  <% else %>
                    <span class="campaign-muted">No data yet</span>
                  <% end %>
                </td>
                <td class="text-end">
                  <div class="d-inline-flex gap-2">
                    <%= link_to campaign_path(child_campaign), class: "admin-btn admin-btn-sm admin-btn-outline" do %>
                      <i data-lucide="eye"></i>
                    <% end %>
                    <%= link_to edit_campaign_path(child_campaign), class: "admin-btn admin-btn-sm admin-btn-outline" do %>
                      <i data-lucide="pencil"></i>
                    <% end %>
                  </div>
                </td>
              </tr>
            <% end %>
          <% end %>
        <% end %>
      </tbody>
    </table>
  </div>
</div>

<style>
  /* Campaign table theme-aware styles */
  .col-toggle {
    width: 30px;
  }
  
  .col-actions {
    width: 200px;
  }
  
  .campaign-link {
    color: var(--purple);
    text-decoration: none;
  }
  
  .campaign-link:hover {
    color: var(--purple-light);
    text-decoration: underline;
  }
  
  .campaign-desc {
    color: var(--text-muted);
    font-size: 0.75rem;
    margin-top: 0.25rem;
  }
  
  .campaign-secondary {
    color: var(--text-secondary);
  }
  
  .campaign-stat {
    color: var(--text-primary);
  }
  
  .campaign-muted {
    color: var(--text-muted);
  }
  
  .child-row {
    display: none;
    background: var(--bg-tertiary);
  }
  
  .child-icon {
    width: 1rem;
    height: 1rem;
    color: var(--text-muted);
    display: inline-block;
    vertical-align: middle;
    margin-right: 0.5rem;
  }
  
  /* Performance bars */
  .performance-row {
    display: flex;
    align-items: center;
    margin-bottom: 0.5rem;
  }
  
  .performance-row:last-child {
    margin-bottom: 0;
  }
  
  .performance-label {
    color: var(--text-secondary);
    font-size: 0.75rem;
    width: 75px;
  }
  
  .performance-bar {
    flex: 1;
    height: 6px;
    background-color: var(--bg-tertiary);
    border-radius: 3px;
    overflow: hidden;
  }
  
  .performance-fill {
    height: 100%;
    border-radius: 3px;
  }
  
  .performance-fill-success {
    background-color: #10B981;
  }
  
  .performance-fill-info {
    background-color: #22D3EE;
  }
  
  .performance-value {
    margin-left: 0.5rem;
    color: var(--text-primary);
    font-size: 0.75rem;
    min-width: 35px;
    text-align: right;
  }
  
  .toggle-children {
    padding: 0.25rem 0.5rem;
  }
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
  // Set performance bar widths
  document.querySelectorAll('.performance-fill').forEach(function(bar) {
    bar.style.width = bar.dataset.width + '%';
  });
});
</script>
