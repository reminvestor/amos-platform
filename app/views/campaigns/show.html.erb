
<div style="padding: 2rem; background-color: var(--bg-primary); min-height: 100vh;">
  <div class="container-fluid">
    <%# Page Header %>
    <div class="admin-page-header" style="margin-bottom: 2rem;">
      <div class="header-left">
        <div class="header-icon" style="background: linear-gradient(135deg, #7C3AED 0%, #A78BFA 100%);">
          <i data-lucide="mail"></i>
        </div>
        <div class="header-text">
          <h1><%= @campaign.name %></h1>
          <p><%= @campaign.description %></p>
        </div>
      </div>

      <div class="header-actions" style="display: flex; gap: 0.75rem;">
        <%= link_to campaigns_path, class: "admin-btn admin-btn-outline" do %>
          <i data-lucide="arrow-left"></i>
          <span>Back</span>
        <% end %>

        <%= link_to edit_campaign_path(@campaign), class: "admin-btn admin-btn-outline" do %>
          <i data-lucide="pencil"></i>
          <span>Edit</span>
        <% end %>

        <div class="dropdown d-inline-block">
          <button class="admin-btn admin-btn-primary dropdown-toggle" type="button" id="campaignActions" data-bs-toggle="dropdown" aria-expanded="false">
            <i data-lucide="more-vertical"></i>
            <span>Actions</span>
          </button>
          <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="campaignActions" style="background-color: var(--bg-card); border: 1px solid var(--border-primary);">
            <li>
              <a href="#" class="dropdown-item" data-bs-toggle="modal" data-bs-target="#testEmailModal" style="color: var(--text-primary);">
                <i data-lucide="send" class="icon-md icon-with-spacing"></i>
                Send Test Email
              </a>
            </li>
            <% if @campaign.status == 'draft' %>
              <li>
                <a href="#" class="dropdown-item" data-bs-toggle="modal" data-bs-target="#scheduleModal" style="color: var(--text-primary);">
                  <i data-lucide="calendar-clock" class="icon-md icon-with-spacing"></i>
                  Schedule Campaign
                </a>
              </li>
              <li>
                <%= button_to send_now_campaign_path(@campaign), method: :post,
                    class: "dropdown-item",
                    style: "color: var(--text-primary);",
                    data: { confirm: "Are you sure you want to send this campaign immediately?" } do %>
                  <i data-lucide="zap" class="icon-md icon-with-spacing"></i> Send Now
                <% end %>
              </li>
            <% elsif @campaign.status == 'scheduled' || @campaign.status == 'in_progress' %>
              <li>
                <%= button_to "Pause Campaign", pause_campaign_path(@campaign), method: :post, class: "dropdown-item", style: "color: var(--text-primary);" %>
              </li>
              <% if @campaign.stalled? %>
                <li><hr class="dropdown-divider" style="border-color: var(--border-primary);"></li>
                <li>
                  <%= button_to force_resume_campaign_path(@campaign), method: :post,
                      class: "dropdown-item",
                      style: "color: #F87171;",
                      data: { confirm: "This will sync with Mailgun, retry failed emails, and resume sending. Continue?" } do %>
                    <i data-lucide="alert-triangle" class="icon-md icon-with-spacing"></i> Force Resume (Stalled)
                  <% end %>
                </li>
              <% end %>
            <% elsif @campaign.status == 'paused' %>
              <li>
                <%= button_to "Resume Campaign", resume_campaign_path(@campaign), method: :post, class: "dropdown-item", style: "color: var(--text-primary);" %>
              </li>
            <% end %>
            <% unless @campaign.status == 'stopped' || @campaign.status == 'completed' %>
              <li>
                <%= button_to "Stop Campaign", stop_campaign_path(@campaign), method: :post, class: "dropdown-item", style: "color: var(--text-primary);", data: { confirm: "Are you sure you want to stop this campaign? This action cannot be undone." } %>
              </li>
            <% end %>
            <% if @campaign.status == 'completed' || @campaign.sent_count > 0 %>
              <li>
                <%= link_to "AI Analysis & Insights", ai_analyze_campaign_path(@campaign), class: "dropdown-item", style: "color: var(--text-primary);" %>
              </li>
            <% end %>
            <% if @campaign.status == 'stopped' || @campaign.status == 'completed' %>
              <li>
                <%= button_to reactivate_campaign_path(@campaign), method: :post,
                    class: "dropdown-item",
                    style: "color: var(--text-primary);",
                    data: { confirm: "This will reactivate the campaign and set it to draft status. Proceed?" } do %>
                  <i data-lucide="refresh-cw" class="icon-md icon-with-spacing"></i> Reactivate to Draft
                <% end %>
              </li>
            <% end %>
          </ul>
        </div>
      </div>
    </div>

    <div class="row">
      <%# Main Content Column %>
      <div class="col-md-8">
        <%# Alerts %>
        <% if @campaign.opted_out_contacts_count.to_i > 0 %>
          <div class="alert alert-warning" style="background-color: var(--status-warning-bg); border: 1px solid var(--status-warning-border); color: var(--status-warning-text); margin-bottom: 1.5rem;">
            <i data-lucide="alert-triangle" class="icon-md icon-with-spacing"></i>
            <strong>Warning:</strong> <%= @campaign.opted_out_contacts_count %> contact(s) in your selected groups have unsubscribed and will not receive emails.
          </div>
        <% end %>

        <% if @campaign.stalled? %>
          <% stall_info = @campaign.stall_info %>
          <div class="alert alert-danger" style="background-color: var(--status-error-bg); border: 1px solid var(--status-error-border); color: var(--status-error-text); margin-bottom: 1.5rem;">
            <div style="display: flex; justify-content: space-between; align-items-start; gap: 1rem;">
              <div>
                <div style="margin-bottom: 0.5rem;">
                  <i data-lucide="alert-circle" class="icon-md icon-with-spacing"></i>
                  <strong>Campaign Appears Stalled!</strong>
                </div>
                <p style="margin-bottom: 0.5rem;">
                  This campaign has been inactive for <%= time_ago_in_words(stall_info[:last_activity]) %>
                  with <%= stall_info[:pending_count] %> emails still pending.
                </p>
                <small style="color: var(--text-muted);">
                  Last activity: <%= stall_info[:last_activity]&.strftime('%b %d, %Y at %I:%M %p') %>
                  <% if stall_info[:last_sent] %>
                    | Last email sent: <%= stall_info[:last_sent]&.strftime('%b %d, %Y at %I:%M %p') %>
                  <% end %>
                </small>
              </div>
              <div>
                <%= button_to force_resume_campaign_path(@campaign), method: :post,
                    class: "admin-btn admin-btn-sm",
                    style: "background-color: #DC2626; border-color: #DC2626;",
                    data: { confirm: "This will sync with Mailgun, retry failed emails, and resume sending. Continue?" } do %>
                  <i data-lucide="play"></i> Force Resume
                <% end %>
              </div>
            </div>
          </div>
        <% end %>

        <%# Campaign Details Card %>
        <div class="admin-card" style="margin-bottom: 1.5rem;">
          <h4 style="color: white; margin-bottom: 1.5rem;">Campaign Details</h4>

          <dl style="margin-bottom: 0;">
            <dt style="color: var(--text-secondary); font-weight: 600; margin-bottom: 0.5rem;">Status:</dt>
            <dd style="margin-bottom: 1.5rem;">
              <span class="admin-badge admin-badge-<%= case @campaign.status
                when 'draft' then 'default'
                when 'scheduled' then 'warning'
                when 'in_progress' then 'cyan'
                when 'completed' then 'online'
                when 'stopped', 'paused' then 'offline'
                else 'default'
              end %>"><%= @campaign.status.humanize %></span>
            </dd>

            <% if @campaign.scheduled_at.present? %>
              <dt style="color: var(--text-secondary); font-weight: 600; margin-bottom: 0.5rem;">Scheduled for:</dt>
              <dd style="color: white; margin-bottom: 1.5rem;"><%= @campaign.scheduled_at.strftime('%b %d, %Y at %I:%M %p') %></dd>
            <% end %>

            <dt style="color: var(--text-secondary); font-weight: 600; margin-bottom: 0.5rem;">Email Template:</dt>
            <dd style="color: white; margin-bottom: 1.5rem;"><%= @campaign.email_template&.name || 'None' %></dd>

            <dt style="color: var(--text-secondary); font-weight: 600; margin-bottom: 0.5rem;">Contact Groups:</dt>
            <dd style="color: white; margin-bottom: 0;">
              <% if @campaign.contact_groups.any? %>
                <%= @campaign.contact_groups.map(&:name).join(', ') %>
              <% else %>
                None
              <% end %>
            </dd>
          </dl>

          <% if @campaign.mailgun_tag.present? %>
            <div style="margin-top: 1.5rem; padding: 1rem; background-color: var(--status-info-bg); border: 1px solid var(--status-info-border); border-radius: 0.5rem;">
              <h6 style="color: white; margin-bottom: 0.75rem;">
                <i data-lucide="refresh-cw" class="icon-md icon-with-spacing"></i>
                Mailgun Integration
              </h6>
              <p style="margin-bottom: 0.75rem; color: var(--text-secondary); font-size: 0.875rem;">
                <% if @campaign.last_synced_at.present? %>
                  Last synced: <%= begin
                                    @campaign.last_synced_at.strftime('%b %d, %Y at %I:%M %p')
                                  rescue
                                    @campaign.last_synced_at.to_s
                                  end %>
                <% else %>
                  <span style="color: var(--status-warning-text);">Not synced yet</span>
                <% end %>
              </p>
              <%= button_to sync_mailgun_campaign_path(@campaign), method: :post, class: "admin-btn admin-btn-sm admin-btn-outline" do %>
                <i data-lucide="refresh-cw"></i> Sync with Mailgun
              <% end %>
            </div>
          <% end %>
        </div>

        <%# Email Deliveries Card %>
        <div class="admin-card">
          <h4 style="color: white; margin-bottom: 1.5rem;">
            <i data-lucide="send" class="icon-lg icon-with-spacing"></i>
            Email Deliveries
          </h4>

          <div style="overflow-x: auto;">
            <table class="admin-table">
              <thead>
                <tr>
                  <th>Contact</th>
                  <th>Email</th>
                  <th>Status</th>
                  <th>Sent At</th>
                  <th>Opened At</th>
                  <th>Clicked At</th>
                </tr>
              </thead>
              <tbody>
                <% @email_deliveries.each do |delivery| %>
                  <tr>
                    <td style="color: white;"><%= delivery.contact.full_name %></td>
                    <td style="color: var(--text-secondary); font-size: 0.875rem;"><%= delivery.contact.email %></td>
                    <td>
                      <span class="admin-badge admin-badge-<%= case delivery.status
                        when 'sent', 'delivered' then 'online'
                        when 'failed', 'bounced' then 'offline'
                        when 'pending', 'queued' then 'warning'
                        else 'default'
                      end %>"><%= delivery.status.humanize %></span>
                    </td>
                    <td style="color: var(--text-secondary); font-size: 0.875rem;"><%= delivery.sent_at&.strftime('%b %d, %Y %I:%M %p') %></td>
                    <td style="color: var(--text-secondary); font-size: 0.875rem;"><%= delivery.opened_at&.strftime('%b %d, %Y %I:%M %p') %></td>
                    <td style="color: var(--text-secondary); font-size: 0.875rem;"><%= delivery.clicked_at&.strftime('%b %d, %Y %I:%M %p') %></td>
                  </tr>
                <% end %>
                <% if @email_deliveries.empty? %>
                  <tr>
                    <td colspan="6" style="text-align: center; color: var(--text-muted); padding: 2rem;">No email deliveries yet.</td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>

          <% if @email_deliveries.any? %>
            <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 1.5rem; padding-top: 1.5rem; border-top: 1px solid var(--border-primary);">
              <div style="color: var(--text-muted); font-size: 0.875rem;">
                <%= page_entries_info @email_deliveries %>
              </div>
              <div>
                <%= paginate @email_deliveries %>
              </div>
            </div>
          <% end %>
        </div>
      </div>

      <%# Stats Sidebar %>
      <div class="col-md-4">
        <div class="admin-card">
          <h4 style="color: white; margin-bottom: 1.5rem;">
            <i data-lucide="bar-chart-3" class="icon-lg icon-with-spacing"></i>
            Campaign Statistics
          </h4>

          <div style="margin-bottom: 1rem;">
            <dt style="color: var(--text-secondary); font-size: 0.875rem; margin-bottom: 0.25rem;">Total Contacts:</dt>
            <dd style="color: white; font-size: 1.5rem; font-weight: 600; margin-bottom: 1.5rem;"><%= @campaign.contact_count %></dd>

            <dt style="color: var(--text-secondary); font-size: 0.875rem; margin-bottom: 0.25rem;">Emails Sent:</dt>
            <dd style="color: white; font-size: 1.5rem; font-weight: 600; margin-bottom: 1.5rem;"><%= @campaign.sent_count %></dd>

            <dt style="color: var(--text-secondary); font-size: 0.875rem; margin-bottom: 0.25rem;">Open Rate:</dt>
            <dd style="color: rgb(74, 222, 128); font-size: 1.5rem; font-weight: 600; margin-bottom: 1.5rem;"><%= @campaign.open_rate %>%</dd>

            <dt style="color: var(--text-secondary); font-size: 0.875rem; margin-bottom: 0.25rem;">Click Rate:</dt>
            <dd style="color: #22D3EE; font-size: 1.5rem; font-weight: 600; margin-bottom: 0;"><%= @campaign.click_rate %>%</dd>
          </div>

          <% if @campaign.sent_count > 0 %>
            <hr style="border-color: var(--border-primary); margin: 1.5rem 0;">
            <%= link_to ai_analyze_campaign_path(@campaign), class: "admin-btn admin-btn-primary w-100" do %>
              <i data-lucide="sparkles"></i> AI Analysis & Insights
            <% end %>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>

<%# Test Email Modal %>
<div class="modal fade" id="testEmailModal" tabindex="-1" aria-labelledby="testEmailModalLabel" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content" style="background-color: var(--bg-card); border: 1px solid var(--border-primary);">
      <div class="modal-header" style="border-bottom: 1px solid var(--border-primary);">
        <h5 class="modal-title" id="testEmailModalLabel" style="color: white;">Send Test Email</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close" style="filter: invert(1);"></button>
      </div>
      <%= form_tag send_test_campaign_path(@campaign), method: :post do %>
        <div class="modal-body">
          <div class="mb-3">
            <label for="email" class="form-label" style="color: white;">Email Address</label>
            <input type="email" class="form-control" id="email" name="email" placeholder="Enter email address" required
                style="background-color: var(--bg-input); border: 1px solid var(--border-primary); color: var(--text-primary);">
          </div>
        </div>
        <div class="modal-footer" style="border-top: 1px solid var(--border-primary);">
          <button type="button" class="admin-btn admin-btn-outline" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="admin-btn admin-btn-primary">Send Test</button>
        </div>
      <% end %>
    </div>
  </div>
</div>

<%# Schedule Modal %>
<div class="modal fade" id="scheduleModal" tabindex="-1" aria-labelledby="scheduleModalLabel" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content" style="background-color: var(--bg-card); border: 1px solid var(--border-primary);">
      <div class="modal-header" style="border-bottom: 1px solid var(--border-primary);">
        <h5 class="modal-title" id="scheduleModalLabel" style="color: white;">Schedule Campaign</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close" style="filter: invert(1);"></button>
      </div>
      <%= form_with url: schedule_campaign_path(@campaign), method: :post, local: true do |f| %>
        <div class="modal-body">
          <div class="mb-3">
            <label for="scheduled_at" class="form-label" style="color: white;">Schedule Date and Time</label>
            <%= f.datetime_local_field :scheduled_at, class: "form-control", required: true,
                style: "background-color: var(--bg-input); border: 1px solid var(--border-primary); color: var(--text-primary);" %>
          </div>
        </div>
        <div class="modal-footer" style="border-top: 1px solid var(--border-primary);">
          <button type="button" class="admin-btn admin-btn-outline" data-bs-dismiss="modal">Cancel</button>
          <%= f.submit "Schedule", class: "admin-btn admin-btn-primary" %>
        </div>
      <% end %>
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    // Initialize Lucide icons
    if (typeof lucide !== 'undefined') {
      lucide.createIcons();
    }

    // Set default date time for the schedule modal to tomorrow, same time
    const scheduleDateField = document.querySelector('#scheduleModal input[type="datetime-local"]');
    if (scheduleDateField) {
      const tomorrow = new Date();
      tomorrow.setDate(tomorrow.getDate() + 1);

      // Format for datetime-local
      const year = tomorrow.getFullYear();
      const month = String(tomorrow.getMonth() + 1).padStart(2, '0');
      const day = String(tomorrow.getDate()).padStart(2, '0');
      const hours = String(tomorrow.getHours()).padStart(2, '0');
      const minutes = String(tomorrow.getMinutes()).padStart(2, '0');

      scheduleDateField.value = `${year}-${month}-${day}T${hours}:${minutes}`;
    }
  });

  document.addEventListener('turbo:load', () => {
    if (typeof lucide !== 'undefined') {
      lucide.createIcons();
    }
  });
</script>
