<%= form_with(model: contact_group) do |form| %>
  <% if contact_group.errors.any? %>
    <div class="alert alert-danger">
      <h4><%= pluralize(contact_group.errors.count, "error") %> prohibited this group from being saved:</h4>
      <ul>
        <% contact_group.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="mb-3">
    <%= form.label :name, class: "form-label" %>
    <%= form.text_field :name, class: "form-control", placeholder: "e.g. Newsletter Subscribers" %>
  </div>

  <div class="mb-3">
    <%= form.label :description, class: "form-label" %>
    <%= form.text_area :description, class: "form-control", rows: 3, placeholder: "Brief description of this group" %>
  </div>

  <div class="mb-3">
    <%= form.label :contact_ids, "Select Contacts", class: "form-label" %>
    <%= render "contacts_selection", contacts: @contacts, selected_contact_ids: @selected_contact_ids %>
  </div>

  <div class="mt-4">
    <%= form.submit class: "btn btn-primary" %>
    <%= link_to "Cancel", contact_groups_path, class: "btn btn-outline-secondary ms-2" %>
  </div>
<% end %> 