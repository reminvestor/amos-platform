<div class="container mx-auto px-4 py-8">
  <div class="flex justify-between items-center mb-6">
    <h1 class="text-2xl font-bold"><%= @contact_group.name %></h1>
    <div class="space-x-4">
      <%= link_to 'Edit', edit_contact_group_path(@contact_group), class: 'btn btn-primary' %>
      <%= link_to 'Back', contact_groups_path, class: 'btn btn-secondary' %>
    </div>
  </div>

  <% if @contact_group.description.present? %>
    <div class="bg-gray-50 p-4 rounded-lg mb-6">
      <p class="text-gray-700"><%= @contact_group.description %></p>
    </div>
  <% end %>

  <div class="bg-white rounded-lg shadow p-6 mb-6">
    <h2 class="text-xl font-semibold mb-4">Upload Contacts</h2>
    <p class="text-gray-600 mb-4">Upload a CSV file with the following columns: name, email, corporation_id, corporation_name</p>
    
    <%= form_tag upload_csv_contact_group_path(@contact_group), multipart: true, class: 'space-y-4' do %>
      <div class="flex items-center space-x-4">
        <%= file_field_tag :file, accept: '.csv', class: 'form-input' %>
        <%= submit_tag 'Upload CSV', class: 'btn btn-primary' %>
      </div>
    <% end %>
  </div>

  <% if !@contact_group || !@contacts %>
    <div class="alert alert-danger">
      Error loading contact group data. Please try again or contact support.
    </div>
  <% else %>
    <div class="bg-white rounded-lg shadow">
      <div class="p-6">
        <h2 class="text-xl font-semibold mb-4">Contacts</h2>
        
        <div class="overflow-x-auto">
          <table class="min-w-full divide-y divide-gray-200">
            <thead class="bg-gray-50">
              <tr>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Name</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Email</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Corporation ID</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Corporation Name</th>
              </tr>
            </thead>
            <tbody class="bg-white divide-y divide-gray-200">
              <% @contacts.each do |contact| %>
                <tr>
                  <td class="px-6 py-4 whitespace-nowrap">
                    <% if contact.respond_to?(:name) && contact.name.present? %>
                      <%= contact.name %>
                    <% elsif contact.respond_to?(:full_name) %>
                      <%= contact.full_name %>
                    <% else %>
                      <%= "#{contact.first_name} #{contact.last_name}" rescue "Name not available" %>
                    <% end %>
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap"><%= contact.email rescue "Email not available" %></td>
                  <td class="px-6 py-4 whitespace-nowrap"><%= contact.respond_to?(:corporation_id) ? contact.corporation_id : contact.metadata&.dig('corporation_id') rescue "Corp ID not available" %></td>
                  <td class="px-6 py-4 whitespace-nowrap"><%= contact.respond_to?(:corporation_name) ? contact.corporation_name : contact.metadata&.dig('corporation_name') rescue "Corp name not available" %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>

        <div class="mt-4">
          <%= paginate @contacts %>
        </div>
      </div>
    </div>
  <% end %>
</div>
