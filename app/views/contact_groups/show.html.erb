<div class="container mt-4">
  <div class="row">
    <div class="col-md-12">
      <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center">
          <h2><%= @contact_group.name %></h2>
          <div>
            <%= link_to "Back", contact_groups_path, class: "btn btn-outline-secondary me-2" %>
            <%= link_to "Edit", edit_contact_group_path(@contact_group), class: "btn btn-outline-primary" %>
          </div>
        </div>
        <div class="card-body">
          <% if @contact_group.description.present? %>
            <div class="row mb-4">
              <div class="col-md-12">
                <h4>Description</h4>
                <p><%= @contact_group.description %></p>
              </div>
            </div>
          <% end %>
          
          <div class="row">
            <div class="col-md-12">
              <div class="d-flex justify-content-between align-items-center mb-3">
                <h4>Contacts (<%= @contacts.count %>)</h4>
                <%= link_to "Add Contacts", edit_contact_group_path(@contact_group, anchor: "contacts"), class: "btn btn-sm btn-outline-primary" %>
              </div>
              
              <% if @contacts.any? %>
                <div class="table-responsive">
                  <table class="table table-striped">
                    <thead>
                      <tr>
                        <th>Name</th>
                        <th>Email</th>
                        <th>Status</th>
                        <th>Added</th>
                      </tr>
                    </thead>
                    <tbody>
                      <% @contacts.each do |contact| %>
                        <tr>
                          <td><%= link_to contact.full_name, contact_path(contact) %></td>
                          <td><%= contact.email %></td>
                          <td>
                            <% if contact.status.present? %>
                              <span class="badge bg-<%= contact.status == 'active' ? 'success' : (contact.status == 'inactive' ? 'warning' : 'danger') %>">
                                <%= contact.status.humanize %>
                              </span>
                            <% else %>
                              <span class="badge bg-secondary">Unknown</span>
                            <% end %>
                          </td>
                          <td><%= contact.created_at.strftime("%b %d, %Y") %></td>
                        </tr>
                      <% end %>
                    </tbody>
                  </table>
                </div>
              <% else %>
                <div class="alert alert-info">
                  This group has no contacts. <%= link_to "Add contacts to this group", edit_contact_group_path(@contact_group) %>.
                </div>
              <% end %>
            </div>
          </div>
        </div>
        
        <div class="card-footer text-end">
          <%= button_to "Delete Group", contact_group_path(@contact_group), method: :delete, data: { turbo_confirm: "Are you sure you want to delete this group?" }, class: "btn btn-outline-danger" %>
        </div>
      </div>
    </div>
  </div>
</div>
