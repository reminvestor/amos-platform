<turbo-frame id="contacts_results">
  <div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
      <span>Select Contacts (<%= contacts.total_count %> total)</span>
      <div>
        <%= paginate contacts, remote: true, params: { 
          controller: "contact_groups", 
          action: "search_contacts",
          search: params[:search],
          status: params[:status],
          selected_ids: selected_contact_ids
        } %>
      </div>
    </div>
    <div data-controller="contact-selection" class="card-body" style="max-height: 400px; overflow-y: auto;">
      <% if contacts.any? %>
        <div class="mb-3">
          <div class="form-check form-check-inline">
            <input class="form-check-input" type="checkbox" id="select-all-contacts" data-action="change->contact-selection#toggleAll">
            <label class="form-check-label" for="select-all-contacts">Select All on This Page</label>
          </div>
        </div>
        
        <div class="row">
          <% contacts.each do |contact| %>
            <div class="col-md-6 mb-2">
              <div class="form-check">
                <%= check_box_tag "contact_group[contact_ids][]", contact.id, 
                    selected_contact_ids.include?(contact.id.to_s) || selected_contact_ids.include?(contact.id), 
                    id: "contact_#{contact.id}", 
                    class: "form-check-input contact-checkbox", 
                    data: { contact_selection_target: "checkbox" } %>
                <label class="form-check-label" for="contact_<%= contact.id %>">
                  <strong><%= contact.full_name %></strong> <span class="text-muted"><%= contact.email %></span>
                </label>
              </div>
            </div>
          <% end %>
        </div>
      <% else %>
        <div class="alert alert-info">
          No contacts found matching your criteria.
        </div>
      <% end %>
    </div>
    <div class="card-footer">
      <div class="d-flex justify-content-between align-items-center">
        <span class="text-muted">Showing <%= contacts.count %> of <%= contacts.total_count %> contacts</span>
        <%= paginate contacts, remote: true, params: { 
          controller: "contact_groups", 
          action: "search_contacts",
          search: params[:search],
          status: params[:status],
          selected_ids: selected_contact_ids
        } %>
      </div>
    </div>
  </div>
</turbo-frame> 