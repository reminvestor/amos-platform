<script src="https://unpkg.com/lucide@latest"></script>

<div class="container-fluid py-4">
  <%# Page Header %>
  <div class="admin-page-header">
    <div class="header-left">
      <div class="header-icon" style="background: linear-gradient(135deg, #7C3AED 0%, #A78BFA 100%);">
        <i data-lucide="folder"></i>
      </div>
      <div class="header-text">
        <h1>Contact Groups</h1>
        <p>Organize your contacts into groups for targeted campaigns</p>
      </div>
    </div>

    <div class="header-actions">
      <%= link_to new_contact_group_path, class: "admin-btn admin-btn-primary" do %>
        <i data-lucide="plus"></i>
        <span>New Group</span>
      <% end %>
    </div>
  </div>

  <% if @contact_groups.any? %>
    <%# Stats Card %>
    <div style="margin-bottom: 2rem;">
      <div class="admin-card">
        <div style="display: flex; align-items: center; gap: 1rem;">
          <div style="width: 3rem; height: 3rem; border-radius: 0.75rem; background: linear-gradient(135deg, #7C3AED 0%, #A78BFA 100%); display: flex; align-items: center; justify-content: center;">
            <i data-lucide="folder" style="width: 1.5rem; height: 1.5rem; color: white;"></i>
          </div>
          <div>
            <p style="color: #94A3B8; font-size: 0.875rem; margin: 0;">Total Groups</p>
            <h3 style="color: white; font-size: 1.875rem; font-weight: 600; margin: 0;"><%= @contact_groups.total_count %></h3>
          </div>
          <div style="margin-left: auto; display: flex; align-items: center; gap: 2rem;">
            <div>
              <p style="color: #94A3B8; font-size: 0.875rem; margin: 0;">Total Contacts</p>
              <h3 style="color: #22D3EE; font-size: 1.5rem; font-weight: 600; margin: 0;">
                <%= @contact_groups.sum { |g| g.contacts.count } %>
              </h3>
            </div>
          </div>
        </div>
      </div>
    </div>

    <%# Groups Table %>
    <div class="admin-card">
      <div style="padding: 1.5rem 1.5rem 1rem 1.5rem; border-bottom: 1px solid #1E293B;">
        <h5 style="color: white; font-size: 1.125rem; font-weight: 600; margin: 0;">Your Groups</h5>
      </div>

      <div style="overflow-x: auto;">
        <table class="admin-table">
          <thead>
            <tr>
              <th>Name</th>
              <th>Contacts</th>
              <th>Description</th>
              <th>Created</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            <% @contact_groups.each do |group| %>
              <tr>
                <td>
                  <div style="display: flex; align-items: center; gap: 0.75rem;">
                    <div style="width: 2rem; height: 2rem; border-radius: 0.5rem; background: rgba(124, 58, 237, 0.1); display: flex; align-items: center; justify-content: center;">
                      <i data-lucide="folder" style="width: 1rem; height: 1rem; color: #A78BFA;"></i>
                    </div>
                    <strong style="color: white;"><%= group.name %></strong>
                  </div>
                </td>
                <td>
                  <span class="admin-badge admin-badge-info">
                    <i data-lucide="users" style="width: 0.875rem; height: 0.875rem;"></i>
                    <span><%= group.contacts.count %></span>
                  </span>
                </td>
                <td>
                  <% if group.description.present? %>
                    <span style="color: #94A3B8;"><%= truncate(group.description, length: 100) %></span>
                  <% else %>
                    <span style="color: #64748B;">No description</span>
                  <% end %>
                </td>
                <td>
                  <div style="color: #94A3B8; font-size: 0.875rem;">
                    <i data-lucide="calendar" style="width: 0.875rem; height: 0.875rem; display: inline; vertical-align: middle;"></i>
                    <%= group.created_at.strftime("%b %d, %Y") %>
                  </div>
                </td>
                <td>
                  <div style="display: flex; gap: 0.5rem;">
                    <%= link_to contact_group_path(group), class: "admin-btn admin-btn-sm admin-btn-outline" do %>
                      <i data-lucide="eye"></i>
                      <span>View</span>
                    <% end %>
                    <%= link_to edit_contact_group_path(group), class: "admin-btn admin-btn-sm admin-btn-outline" do %>
                      <i data-lucide="pencil"></i>
                      <span>Edit</span>
                    <% end %>
                    <%= button_to contact_group_path(group), method: :delete, data: { turbo_confirm: "Are you sure you want to delete this group?" }, class: "admin-btn admin-btn-sm admin-btn-outline", style: "border-color: #ef4444; color: #ef4444;" do %>
                      <i data-lucide="trash-2"></i>
                      <span>Delete</span>
                    <% end %>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>

      <%# Pagination %>
      <% if @contact_groups.total_pages > 1 %>
        <div style="padding: 1rem 1.5rem; border-top: 1px solid #1E293B; display: flex; justify-content: space-between; align-items: center;">
          <div style="color: #94A3B8; font-size: 0.875rem;">
            <%= page_entries_info @contact_groups %>
          </div>
          <div>
            <%= paginate @contact_groups, theme: 'twitter-bootstrap-4' %>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <%# Empty State %>
    <div class="admin-card">
      <div class="admin-empty-state">
        <div class="empty-icon">
          <i data-lucide="folder-plus"></i>
        </div>
        <h3>No Contact Groups Yet</h3>
        <p>Create groups to organize your contacts for targeted campaigns</p>
        <%= link_to new_contact_group_path, class: "admin-btn admin-btn-primary", style: "margin-top: 1rem;" do %>
          <i data-lucide="plus"></i>
          <span>Create Your First Group</span>
        <% end %>
      </div>
    </div>
  <% end %>
</div>

<script>
  document.addEventListener('turbo:load', () => {
    if (typeof lucide !== 'undefined') {
      lucide.createIcons();
    }
  });

  document.addEventListener('DOMContentLoaded', () => {
    if (typeof lucide !== 'undefined') {
      lucide.createIcons();
    }
  });
</script>
