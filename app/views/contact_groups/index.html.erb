<div class="container mt-4">
  <div class="row">
    <div class="col-md-12">
      <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center">
          <h2>Contact Groups</h2>
          <%= link_to "New Group", new_contact_group_path, class: "btn btn-primary" %>
        </div>
        <div class="card-body">
          <% if @contact_groups.any? %>
            <div class="table-responsive">
              <table class="table table-striped">
                <thead>
                  <tr>
                    <th>Name</th>
                    <th>Contacts</th>
                    <th>Description</th>
                    <th>Created</th>
                    <th width="200">Actions</th>
                  </tr>
                </thead>
                <tbody>
                  <% @contact_groups.each do |group| %>
                    <tr>
                      <td><%= group.name %></td>
                      <td><span class="badge bg-primary"><%= group.contacts.count %></span></td>
                      <td><%= truncate(group.description, length: 100) if group.description.present? %></td>
                      <td><%= group.created_at.strftime("%b %d, %Y") %></td>
                      <td>
                        <%= link_to "View", contact_group_path(group), class: "btn btn-sm btn-outline-primary" %>
                        <%= link_to "Edit", edit_contact_group_path(group), class: "btn btn-sm btn-outline-secondary" %>
                        <%= button_to "Delete", contact_group_path(group), method: :delete, data: { turbo_confirm: "Are you sure?" }, class: "btn btn-sm btn-outline-danger", form_class: "d-inline" %>
                      </td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            </div>
          <% else %>
            <div class="alert alert-info">
              <p class="mb-0">You don't have any contact groups yet. <%= link_to "Create your first group", new_contact_group_path %>.</p>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
