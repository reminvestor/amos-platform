<div class="container">
  <div class="row justify-content-center">
    <div class="col-md-8">
      <div class="card bg-dark border-secondary">
        <div class="card-header border-secondary">
          <h5 class="mb-0 text-white">Edit Email Sequence</h5>
        </div>
        <div class="card-body">
          <%= form_with model: @sequence, local: true do |f| %>
            <% if @sequence.errors.any? %>
              <div class="alert alert-danger">
                <h6><%= pluralize(@sequence.errors.count, "error") %> prohibited this sequence from being saved:</h6>
                <ul>
                  <% @sequence.errors.full_messages.each do |message| %>
                    <li><%= message %></li>
                  <% end %>
                </ul>
              </div>
            <% end %>

            <div class="mb-3">
              <%= f.label :name, class: "form-label text-white" %>
              <%= f.text_field :name, class: "form-control bg-dark text-white border-secondary" %>
            </div>

            <div class="mb-3">
              <%= f.label :goal, class: "form-label text-white" %>
              <%= f.text_area :goal, rows: 3, class: "form-control bg-dark text-white border-secondary" %>
            </div>

            <div class="mb-3">
              <%= f.label :contact_group_id, "Target Audience", class: "form-label text-white" %>
              <%= f.collection_select :contact_group_id, @contact_groups, :id, :name, { prompt: "Select a contact group" }, { class: "form-select bg-dark text-white border-secondary" } %>
            </div>

            <div class="mb-3">
              <%= f.label :status, class: "form-label text-white" %>
              <%= f.select :status, ['draft', 'active', 'paused', 'completed'], {}, { class: "form-select bg-dark text-white border-secondary" } %>
            </div>

            <div class="d-flex justify-content-end gap-2">
              <%= link_to "Cancel", email_sequence_path(@sequence), class: "btn btn-outline-secondary" %>
              <%= f.submit "Update Sequence", class: "btn btn-primary" %>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>

