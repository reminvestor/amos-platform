<div class="container py-4">
  <div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0">Image Library</h2>
    <%= link_to 'Upload Image', new_image_asset_path, class: 'btn btn-primary' %>
  </div>

  <% if @image_assets.any? %>
    <div class="row g-3">
      <% @image_assets.each do |asset| %>
        <div class="col-6 col-md-4 col-lg-3">
          <div class="card h-100 shadow-sm">
            <% if asset.file.attached? %>
              <% if asset.file.content_type.start_with?('image/') %>
                <% begin %>
                  <%= image_tag asset.file.variant(resize_to_fill: [400, 250]).processed, class: 'card-img-top', alt: asset.display_title %>
                <% rescue ActiveStorage::FileNotFoundError => e %>
                  <div class="card-img-top bg-warning bg-opacity-10 d-flex align-items-center justify-content-center" style="height: 250px;">
                    <i class="fas fa-exclamation-triangle text-warning" style="font-size: 2rem;"></i>
                    <small class="text-muted ms-2">File not found</small>
                  </div>
                <% end %>
              <% elsif asset.file.content_type == 'application/pdf' %>
                <div class="card-img-top bg-danger bg-opacity-10 d-flex align-items-center justify-content-center" style="height: 250px;">
                  <i class="fas fa-file-pdf text-danger" style="font-size: 4rem;"></i>
                </div>
              <% else %>
                <div class="card-img-top bg-secondary bg-opacity-10 d-flex align-items-center justify-content-center" style="height: 250px;">
                  <i class="fas fa-file text-secondary" style="font-size: 4rem;"></i>
                </div>
              <% end %>
            <% end %>
            <div class="card-body">
              <h6 class="card-title text-truncate" title="<%= asset.display_title %>"><%= asset.display_title %></h6>
              <div class="d-flex gap-2">
                <%= link_to 'View', image_asset_path(asset), class: 'btn btn-sm btn-outline-secondary' %>
                <%= button_to 'Delete', image_asset_path(asset), method: :delete, data: { confirm: 'Delete this image?' }, class: 'btn btn-sm btn-outline-danger' %>
              </div>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="text-center text-muted py-5">No images yet. Upload your first image.</div>
  <% end %>
</div>



