<div class="container py-4">
  <div class="row">
    <div class="col-md-7">
      <% if @image_asset.file.attached? %>
        <%= image_tag @image_asset.file, class: 'img-fluid rounded shadow-sm' %>
      <% end %>
    </div>
    <div class="col-md-5">
      <h3><%= @image_asset.display_title %></h3>
      <p class="text-muted"><%= @image_asset.description %></p>
      <div class="mb-3">
        <strong>Source:</strong> <%= @image_asset.source %>
      </div>
      <div class="d-flex gap-2">
        <%= link_to 'Back to Library', image_assets_path, class: 'btn btn-outline-secondary' %>
        <%= button_to 'Delete', image_asset_path(@image_asset), method: :delete, data: { confirm: 'Delete this image?' }, class: 'btn btn-outline-danger' %>
      </div>
    </div>
  </div>
</div>



