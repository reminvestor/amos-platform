<nav class="navbar navbar-expand-lg navbar-dark bg-primary mb-4">
  <div class="container">
    <a class="navbar-brand" href="<%= root_path %>">
      <i class="fas fa-envelope-open-text me-2"></i>
      Agent Marketing
    </a>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="navbarNav">
      <ul class="navbar-nav me-auto">
        <li class="nav-item">
          <a class="nav-link <%= current_page?(root_path) ? 'active' : '' %>" href="<%= root_path %>">Dashboard</a>
        </li>
        <li class="nav-item">
          <a class="nav-link <%= current_page?(campaigns_path) ? 'active' : '' %>" href="<%= campaigns_path %>">Campaigns</a>
        </li>
        <li class="nav-item">
          <a class="nav-link <%= current_page?(contacts_path) ? 'active' : '' %>" href="<%= contacts_path %>">Contacts</a>
        </li>
        <li class="nav-item">
          <a class="nav-link <%= current_page?(contact_groups_path) ? 'active' : '' %>" href="<%= contact_groups_path %>">Groups</a>
        </li>
        <li class="nav-item">
          <a class="nav-link <%= current_page?(email_templates_path) ? 'active' : '' %>" href="<%= email_templates_path %>">Templates</a>
        </li>
        <li class="nav-item dropdown">
          <a class="nav-link dropdown-toggle <%= current_page?(new_ai_content_path) || request.path.include?('ai_content') ? 'active' : '' %>" href="#" id="aiDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
            <i class="fas fa-robot me-1"></i> AI Tools
          </a>
          <ul class="dropdown-menu" aria-labelledby="aiDropdown">
            <li><a class="dropdown-item" href="<%= new_ai_content_path %>">Generate Email Content</a></li>
            <li><hr class="dropdown-divider"></li>
            <li><h6 class="dropdown-header">Template Improvement</h6></li>
            <% if current_user && current_user.email_templates.any? %>
              <% current_user.email_templates.order(created_at: :desc).limit(3).each do |template| %>
                <li>
                  <a class="dropdown-item" href="<%= improve_ai_content_path(template) %>">
                    Improve: <%= truncate(template.name, length: 20) %>
                  </a>
                </li>
              <% end %>
              <% if current_user.email_templates.count > 3 %>
                <li><a class="dropdown-item" href="<%= email_templates_path %>">View all templates...</a></li>
              <% end %>
            <% else %>
              <li><a class="dropdown-item disabled" href="#">No templates available</a></li>
            <% end %>
          </ul>
        </li>
      </ul>
      
      <% if user_signed_in? %>
        <ul class="navbar-nav">
          <li class="nav-item dropdown">
            <a class="nav-link dropdown-toggle" href="#" id="userDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
              <i class="fas fa-user-circle me-1"></i> <%= current_user.email %>
            </a>
            <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="userDropdown">
              <li><a class="dropdown-item" href="<%= edit_user_registration_path %>">Account Settings</a></li>
              <% if current_user.admin? %>
                <li><a class="dropdown-item" href="<%= admin_imports_path %>">Data Imports</a></li>
              <% end %>
              <li><hr class="dropdown-divider"></li>
              <li>
                <%= button_to "Sign Out", destroy_user_session_path, method: :delete, class: "dropdown-item" %>
              </li>
            </ul>
          </li>
        </ul>
      <% else %>
        <div class="d-flex">
          <%= link_to "Sign In", new_user_session_path, class: "btn btn-outline-light me-2" %>
          <%= link_to "Sign Up", new_user_registration_path, class: "btn btn-light" %>
        </div>
      <% end %>
    </div>
  </div>
</nav> 