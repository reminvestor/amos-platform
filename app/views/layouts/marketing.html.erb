<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Crux Marketing - AI Marketing Agent That Actually Grows Your Business" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="description" content="<%= content_for(:description) || "Scout, your AI marketing agent, learns your business and creates campaigns that convert. Skip the $1000 tools - get results in minutes, not months." %>">
    
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">
    
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Font Awesome for icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" integrity="sha512-DTOQO9RWCH3ppGqcWaEA1BIZOC6xxalwEsw9c2QQeAIftl+Vegovlnee1c9QX4TctnWMn13TZye+giMm8e2LwA==" crossorigin="anonymous" referrerpolicy="no-referrer" />

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_include_tag "application", "data-turbo-track": "reload", defer: true %>
    
    <style>
      :root {
        --primary-purple: #6366f1;
        --secondary-purple: #8b5cf6;
        --accent-coral: #ff6b6b;
        --dark-bg: #1e1b4b;
        --darker-bg: #0f0e27;
        --light-text: rgba(255, 255, 255, 0.9);
        --muted-text: rgba(255, 255, 255, 0.7);
      }
      
      body {
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        color: #333;
        margin: 0;
        padding: 0;
      }
      
      .gradient-bg {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 50%, #8b5cf6 100%);
      }
      
      .dark-gradient-bg {
        background: linear-gradient(135deg, #1e1b4b 0%, #312e81 50%, #4c1d95 100%);
      }
      
      .hero-section {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 50%, #8b5cf6 100%);
        color: white;
        padding: 6rem 0;
        position: relative;
        overflow: hidden;
      }
      
      .hero-section::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: linear-gradient(45deg, rgba(255,255,255,0.1) 0%, transparent 50%, rgba(255,255,255,0.05) 100%);
        pointer-events: none;
        z-index: 1;
      }
      
      .feature-card {
        background: rgba(255, 255, 255, 0.1);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(255, 255, 255, 0.2);
        border-radius: 1rem;
        padding: 2rem;
        height: 100%;
        transition: all 0.3s ease;
      }
      
      .feature-card:hover {
        transform: translateY(-5px);
        background: rgba(255, 255, 255, 0.15);
      }

      /* Gradient variants for feature cards */
      .feature-card.gradient-purple {
        background: linear-gradient(180deg, rgba(99,102,241,0.12) 0%, rgba(99,102,241,0.06) 55%, rgba(99,102,241,0.35) 100%);
        border-color: rgba(99, 102, 241, 0.35);
        box-shadow: 0 10px 30px rgba(99, 102, 241, 0.25);
        border-bottom: 4px solid #8b5cf6;
      }

      .feature-card.gradient-pink {
        background: linear-gradient(180deg, rgba(236,72,153,0.12) 0%, rgba(244,63,94,0.06) 55%, rgba(236,72,153,0.35) 100%);
        border-color: rgba(236, 72, 153, 0.35);
        box-shadow: 0 10px 30px rgba(236, 72, 153, 0.25);
        border-bottom: 4px solid #f472b6;
      }

      .feature-card.gradient-green {
        background: linear-gradient(180deg, rgba(16,185,129,0.12) 0%, rgba(34,197,94,0.06) 55%, rgba(16,185,129,0.35) 100%);
        border-color: rgba(16, 185, 129, 0.35);
        box-shadow: 0 10px 30px rgba(16, 185, 129, 0.25);
        border-bottom: 4px solid #10b981;
      }
      
      .feature-icon {
        width: 4rem;
        height: 4rem;
        border-radius: 1rem;
        background: rgba(255, 255, 255, 0.2);
        color: white;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 1.5rem;
        backdrop-filter: blur(10px);
      }
      
      .feature-icon i {
        font-size: 2rem;
      }
      
      .btn-primary {
        background: linear-gradient(45deg, #ff6b6b, #ff8e8e);
        border: none;
        padding: 0.75rem 2rem;
        border-radius: 0.75rem;
        font-weight: 600;
        text-decoration: none;
        transition: all 0.3s ease;
      }
      
      .btn-primary:hover {
        background: linear-gradient(45deg, #ff5252, #ff7979);
        transform: translateY(-2px);
        box-shadow: 0 10px 25px rgba(255, 107, 107, 0.3);
      }
      
      .btn-outline-light {
        border: 2px solid rgba(255, 255, 255, 0.3);
        color: white;
        padding: 0.75rem 2rem;
        border-radius: 0.75rem;
        font-weight: 600;
        text-decoration: none;
        backdrop-filter: blur(10px);
        transition: all 0.3s ease;
      }
      
      .btn-outline-light:hover {
        background: rgba(255, 255, 255, 0.1);
        border-color: rgba(255, 255, 255, 0.5);
        color: white;
        transform: translateY(-2px);
      }
      
      .comparison-table {
        background: rgba(255, 255, 255, 0.95);
        backdrop-filter: blur(10px);
        border-radius: 1rem;
        overflow: hidden;
        box-shadow: 0 20px 40px rgba(0, 0, 0, 0.1);
      }
      
      .table-header {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        padding: 1.5rem;
        font-weight: 700;
        font-size: 1.1rem;
      }
      
      .check-icon {
        color: #10b981;
        font-size: 1.2rem;
      }
      
      .x-icon {
        color: #ef4444;
        font-size: 1.2rem;
      }
      
      .navbar-brand {
        font-weight: 700;
        font-size: 1.5rem;
      }
      
      .navbar-dark {
        background: rgba(12, 10, 35, 0.98) !important; /* darker nav */
        backdrop-filter: blur(10px);
      }
      
      .footer {
        background: var(--darker-bg);
        color: var(--muted-text);
      }
      
      .section-dark {
        background: var(--dark-bg);
        color: var(--light-text);
      }
      
      .section-darker {
        background: var(--darker-bg);
        color: var(--light-text);
      }
      
      
      
      .benefit-card {
        background: rgba(255, 255, 255, 0.05);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 1rem;
        padding: 2rem;
        height: 100%;
        transition: all 0.3s ease;
      }
      
      .benefit-card:hover {
        background: rgba(255, 255, 255, 0.1);
        transform: translateY(-5px);
      }
      
      .display-1 {
        font-weight: 800;
        line-height: 1.1;
      }
      
      .display-4 {
        font-weight: 700;
        line-height: 1.2;
      }
      
      .lead {
        font-size: 1.25rem;
        font-weight: 400;
        opacity: 0.9;
      }
    </style>
  </head>

  <body>
    <!-- Navigation -->
    <nav class="navbar navbar-expand-lg navbar-dark fixed-top">
      <div class="container">
        <a class="navbar-brand d-flex align-items-center" href="<%= marketing_root_path %>">
          <%= image_tag "crux_logo_white_long.png", alt: "Crux Marketing", style: "height: 40px;" %>
        </a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
          <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarNav">
          <ul class="navbar-nav me-auto">
            <li class="nav-item">
              <a class="nav-link <%= current_page?(marketing_root_path) ? 'active' : '' %>" href="<%= marketing_root_path %>">Home</a>
            </li>
            <li class="nav-item">
              <a class="nav-link <%= current_page?(marketing_features_path) ? 'active' : '' %>" href="<%= marketing_features_path %>">Features</a>
            </li>
            <li class="nav-item">
              <a class="nav-link <%= current_page?(marketing_pricing_path) ? 'active' : '' %>" href="<%= marketing_pricing_path %>">Pricing</a>
            </li>
          </ul>
          <div class="d-flex">
            <a href="<%= request.protocol %>app.<%= request.host_with_port.sub(/^www\./, '') %>/users/sign_in" class="btn btn-outline-light me-2">Log In</a>
            <a href="<%= request.protocol %>app.<%= request.host_with_port.sub(/^www\./, '') %>/users/sign_up" class="btn btn-primary">Sign Up!</a>
          </div>
        </div>
      </div>
    </nav>

    <!-- Main content -->
    <main style="padding-top: 80px;">
      <%= yield %>
    </main>

    <!-- Footer -->
    <footer class="footer pt-5 pb-3">
      <div class="container">
        <div class="row">
          <div class="col-md-4 mb-4">
            <h5 class="text-white d-flex align-items-center">
              <%= image_tag "crux_logo_white_long.png", alt: "Crux Marketing", style: "height: 30px;" %>
            </h5>
            <p class="mb-3">AI-powered marketing that actually grows your business. Scout learns, adapts, and delivers results while you focus on what matters.</p>
            <div class="d-flex gap-3">
              <a href="#" class="text-white"><i class="fab fa-twitter"></i></a>
              <a href="#" class="text-white"><i class="fab fa-facebook"></i></a>
              <a href="#" class="text-white"><i class="fab fa-linkedin"></i></a>
              <a href="#" class="text-white"><i class="fab fa-instagram"></i></a>
            </div>
          </div>
          <div class="col-md-2 mb-4">
            <h5 class="text-white">Product</h5>
            <ul class="nav flex-column">
              <li class="nav-item"><a href="<%= marketing_features_path %>" class="nav-link p-0 text-white-50">Features</a></li>
              <li class="nav-item"><a href="<%= marketing_pricing_path %>" class="nav-link p-0 text-white-50">Pricing</a></li>
              <li class="nav-item"><a href="<%= marketing_contact_path %>" class="nav-link p-0 text-white-50">Contact</a></li>
            </ul>
          </div>
          <div class="col-md-2 mb-4">
            <h5 class="text-white">Resources</h5>
            <ul class="nav flex-column">
              <li class="nav-item"><a href="#" class="nav-link p-0 text-white-50">Help Center</a></li>
              <li class="nav-item"><a href="#" class="nav-link p-0 text-white-50">Blog</a></li>
              <li class="nav-item"><a href="#" class="nav-link p-0 text-white-50">Case Studies</a></li>
              <li class="nav-item"><a href="<%= marketing_contact_path %>" class="nav-link p-0 text-white-50">Contact</a></li>
            </ul>
          </div>
          <div class="col-md-4 mb-4">
            <h5 class="text-white">Ready to Grow?</h5>
            <p>Get started with Scout in minutes. No complex setup, no learning curve.</p>
            <a href="<%= request.protocol %>app.<%= request.host_with_port.sub(/^www\./, '') %>/users/sign_up" class="btn btn-primary">Launch a Campaign</a>
          </div>
        </div>
        <div class="border-top pt-3 mt-3">
          <p class="text-center text-white-50 mb-0">&copy; <%= Date.today.year %> Crux Marketing. All rights reserved.</p>
        </div>
      </div>
    </footer>

    <!-- Bootstrap Bundle with Popper -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js"></script>
  </body>
</html> 