<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Agent Marketing - AI-Powered Marketing Automation" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="description" content="<%= content_for(:description) || "AI-powered marketing automation platform for small businesses and agencies" %>">
    
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">
    
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Font Awesome for icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" integrity="sha512-DTOQO9RWCH3ppGqcWaEA1BIZOC6xxalwEsw9c2QQeAIftl+Vegovlnee1c9QX4TctnWMn13TZye+giMm8e2LwA==" crossorigin="anonymous" referrerpolicy="no-referrer" />

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_include_tag "application", "data-turbo-track": "reload", defer: true %>
    
    <style>
      :root {
        --primary-color: #4a90e2;
        --secondary-color: #6c757d;
        --accent-color: #ff9800;
        --light-bg: #f9f9f9;
      }
      
      body {
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        color: #333;
      }
      
      .hero-section {
        background: linear-gradient(135deg, #4a90e2 0%, #8e44ad 100%);
        color: white;
        padding: 5rem 0;
      }
      
      .feature-icon {
        width: 4rem;
        height: 4rem;
        border-radius: 0.5rem;
        background-color: var(--primary-color);
        color: white;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 1rem;
      }
      
      .feature-icon i {
        font-size: 2rem;
      }
      
      .btn-primary {
        background-color: var(--primary-color);
        border-color: var(--primary-color);
      }
      
      .btn-outline-primary {
        color: var(--primary-color);
        border-color: var(--primary-color);
      }
      
      .pricing-card {
        transition: transform 0.3s ease;
      }
      
      .pricing-card:hover {
        transform: translateY(-5px);
      }
      
      .footer {
        background-color: #343a40;
        color: rgba(255, 255, 255, 0.7);
      }
    </style>
  </head>

  <body>
    <!-- Navigation -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
      <div class="container">
        <a class="navbar-brand" href="<%= marketing_root_path %>">
          <i class="fas fa-envelope-open-text me-2"></i>
          Agent Marketing
        </a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
          <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarNav">
          <ul class="navbar-nav me-auto">
            <li class="nav-item">
              <a class="nav-link <%= current_page?(marketing_root_path) ? 'active' : '' %>" href="<%= marketing_root_path %>">Home</a>
            </li>
            <li class="nav-item">
              <a class="nav-link <%= current_page?(marketing_features_path) ? 'active' : '' %>" href="<%= marketing_features_path %>">Features</a>
            </li>
            <li class="nav-item">
              <a class="nav-link <%= current_page?(marketing_pricing_path) ? 'active' : '' %>" href="<%= marketing_pricing_path %>">Pricing</a>
            </li>
            <li class="nav-item">
              <a class="nav-link <%= current_page?(marketing_about_path) ? 'active' : '' %>" href="<%= marketing_about_path %>">About</a>
            </li>
            <li class="nav-item">
              <a class="nav-link <%= current_page?(marketing_contact_path) ? 'active' : '' %>" href="<%= marketing_contact_path %>">Contact</a>
            </li>
          </ul>
          <div class="d-flex">
            <a href="<%= "https://app.#{ENV['APPLICATION_HOST'] || 'yourdomain.com'}" %>" class="btn btn-outline-light me-2">Log In</a>
            <a href="<%= "https://app.#{ENV['APPLICATION_HOST'] || 'yourdomain.com'}/users/sign_up" %>" class="btn btn-primary">Sign Up Free</a>
          </div>
        </div>
      </div>
    </nav>

    <!-- Main content -->
    <%= yield %>

    <!-- Footer -->
    <footer class="footer pt-5 pb-3">
      <div class="container">
        <div class="row">
          <div class="col-md-4 mb-4">
            <h5 class="text-white">Agent Marketing</h5>
            <p class="mb-3">AI-powered marketing automation platform for small businesses and agencies.</p>
            <div class="d-flex gap-3">
              <a href="#" class="text-white"><i class="fab fa-twitter"></i></a>
              <a href="#" class="text-white"><i class="fab fa-facebook"></i></a>
              <a href="#" class="text-white"><i class="fab fa-linkedin"></i></a>
              <a href="#" class="text-white"><i class="fab fa-instagram"></i></a>
            </div>
          </div>
          <div class="col-md-2 mb-4">
            <h5 class="text-white">Product</h5>
            <ul class="nav flex-column">
              <li class="nav-item"><a href="<%= marketing_features_path %>" class="nav-link p-0 text-white-50">Features</a></li>
              <li class="nav-item"><a href="<%= marketing_pricing_path %>" class="nav-link p-0 text-white-50">Pricing</a></li>
              <li class="nav-item"><a href="#" class="nav-link p-0 text-white-50">API</a></li>
              <li class="nav-item"><a href="#" class="nav-link p-0 text-white-50">Integrations</a></li>
            </ul>
          </div>
          <div class="col-md-2 mb-4">
            <h5 class="text-white">Company</h5>
            <ul class="nav flex-column">
              <li class="nav-item"><a href="<%= marketing_about_path %>" class="nav-link p-0 text-white-50">About</a></li>
              <li class="nav-item"><a href="#" class="nav-link p-0 text-white-50">Blog</a></li>
              <li class="nav-item"><a href="#" class="nav-link p-0 text-white-50">Careers</a></li>
              <li class="nav-item"><a href="<%= marketing_contact_path %>" class="nav-link p-0 text-white-50">Contact</a></li>
            </ul>
          </div>
          <div class="col-md-4 mb-4">
            <h5 class="text-white">Stay in touch</h5>
            <p>Get updates on new features and announcements.</p>
            <form class="d-flex">
              <input type="email" class="form-control me-2" placeholder="Email address">
              <button class="btn btn-primary" type="submit">Subscribe</button>
            </form>
          </div>
        </div>
        <div class="border-top pt-3 mt-3">
          <p class="text-center text-white-50 mb-0">&copy; <%= Date.today.year %> Agent Marketing. All rights reserved.</p>
        </div>
      </div>
    </footer>

    <!-- Bootstrap Bundle with Popper -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js"></script>
  </body>
</html> 