<!DOCTYPE html>
<html>
  <head>
    <title>AMOS - <%= @entity&.name || 'Marketing Platform' %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <link rel="stylesheet" href="/assets/admin_dark.css" data-turbo-track="reload">
    <%= javascript_include_tag "application", "data-turbo-track": "reload", type: "module" %>

    <!-- Lucide Icons -->
    <script src="https://unpkg.com/lucide@latest"></script>

    <style>
      /* User dropdown styling */
      .user-dropdown-btn:hover {
        background: rgba(255, 255, 255, 0.05) !important;
      }
      
      .user-dropdown-btn:focus {
        outline: none;
        box-shadow: none;
      }
      
      .admin-sidebar .dropdown-menu {
        background: #0F172A;
        border: 1px solid #1E293B;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.3);
        min-width: 220px;
        margin-bottom: 0.5rem;
      }
      
      .admin-sidebar .dropdown-item {
        color: #94A3B8;
        padding: 0.5rem 1rem;
        display: flex;
        align-items: center;
        transition: all 0.2s ease;
      }
      
      .admin-sidebar .dropdown-item:hover {
        background: rgba(255, 255, 255, 0.05);
        color: white;
        text-decoration: none;
      }
      
      .admin-sidebar .dropdown-item.text-danger {
        color: #EF4444;
      }
      
      .admin-sidebar .dropdown-item.text-danger:hover {
        background: rgba(239, 68, 68, 0.1);
        color: #EF4444;
      }
      
      .admin-sidebar .dropdown-divider {
        border-color: #1E293B;
        margin: 0.5rem 0;
      }
      
      /* Collapsed state adjustments */
      .admin-sidebar.collapsed .user-dropdown-btn span,
      .admin-sidebar.collapsed .user-dropdown-btn > div > div {
        display: none;
      }
      
      .admin-sidebar.collapsed .user-dropdown-btn {
        justify-content: center;
        padding: 0.75rem 0;
      }
      
      .admin-sidebar.collapsed .dropdown-menu {
        position: absolute;
        left: 100%;
        bottom: 0;
        margin-left: 0.5rem;
        margin-bottom: 0;
      }
      
      /* Ensure hamburger button is styled correctly */
      .hamburger-toggle {
        background: transparent;
        border: none;
        color: #94A3B8;
        padding: 0.5rem;
        cursor: pointer;
        transition: all 0.2s ease;
      }
      
      .hamburger-toggle:hover {
        background: rgba(255, 255, 255, 0.05);
        color: white;
        border-radius: 0.375rem;
      }
    </style>
  </head>

  <body class="admin-dark">
    <% if current_user %>
      <%# Left Sidebar Navigation %>
      <aside class="admin-sidebar" id="customerSidebar">
        <%# Logo with Hamburger %>
        <div class="sidebar-logo">
          <div class="logo-icon">
            <div style="width: 2rem; height: 2rem; border-radius: 0.5rem; background: linear-gradient(135deg, #7C3AED 0%, #A78BFA 100%); display: flex; align-items: center; justify-content: center;">
              <i data-lucide="sparkles" class="icon-lg" style="color: white;"></i>
            </div>
          </div>
          <span class="logo-text">AMOS</span>
          <button class="hamburger-toggle" id="sidebarToggle" aria-label="Toggle sidebar">
            <i data-lucide="menu"></i>
          </button>
        </div>

        <%# Main Navigation %>
        <nav>
          <%# Dashboard %>
          <%= link_to advanced_mode_path, class: "nav-item #{'active' if request.path == advanced_mode_path}" do %>
            <i data-lucide="layout-dashboard"></i>
            <span>Dashboard</span>
          <% end %>

          <%# Marketing Section %>
          <div class="nav-section-header nav-toggle" data-section="marketingMenu" data-expanded="true">
            <span>Marketing</span>
            <i data-lucide="chevron-down" class="toggle-icon"></i>
          </div>
          <div class="nav-section-content" id="marketingMenu">
            <%= link_to campaigns_path, class: "nav-item nav-sub-item #{'active' if controller_name == 'campaigns'}" do %>
              <i data-lucide="mail"></i>
              <span>Campaigns</span>
            <% end %>

            <%= link_to email_templates_path, class: "nav-item nav-sub-item #{'active' if controller_name == 'email_templates'}" do %>
              <i data-lucide="file-text"></i>
              <span>Email Templates</span>
            <% end %>

            <%= link_to landing_pages_path, class: "nav-item nav-sub-item #{'active' if controller_name == 'landing_pages'}" do %>
              <i data-lucide="layout"></i>
              <span>Landing Pages</span>
            <% end %>
          </div>

          <%# Contacts Section %>
          <div class="nav-section-header nav-toggle" data-section="contactsMenu" data-expanded="true">
            <span>Contacts</span>
            <i data-lucide="chevron-down" class="toggle-icon"></i>
          </div>
          <div class="nav-section-content" id="contactsMenu">
            <%= link_to contacts_path, class: "nav-item nav-sub-item #{'active' if controller_name == 'contacts'}" do %>
              <i data-lucide="users"></i>
              <span>All Contacts</span>
            <% end %>

            <%= link_to contact_groups_path, class: "nav-item nav-sub-item #{'active' if controller_name == 'contact_groups'}" do %>
              <i data-lucide="users-2"></i>
              <span>Contact Groups</span>
            <% end %>
          </div>

          <%# Media Assets Section %>
          <div class="nav-section-header">
            <span>Media Assets</span>
          </div>
          <%= link_to image_assets_path, class: "nav-item nav-sub-item #{'active' if controller_name == 'image_assets'}" do %>
            <i data-lucide="image"></i>
            <span>Image Library</span>
          <% end %>

          <%# Integrations Section %>
          <div class="nav-section-header nav-toggle" data-section="integrationsMenu" data-expanded="false">
            <span>Integrations</span>
            <i data-lucide="chevron-down" class="toggle-icon"></i>
          </div>
          <div class="nav-section-content" id="integrationsMenu" style="display: none;">
            <%= link_to customer_integrations_path, class: "nav-item nav-sub-item #{'active' if controller_name == 'social_media_accounts' || request.path == customer_integrations_path}" do %>
              <i data-lucide="plug"></i>
              <span>All Integrations</span>
            <% end %>
          </div>

          <%# Entity Settings - Only for Entity Admins %>
          <% if current_user.entity_admin? %>
            <div class="nav-section-header nav-toggle" data-section="settingsMenu" data-expanded="false">
              <span>Settings</span>
              <i data-lucide="chevron-down" class="toggle-icon"></i>
            </div>
            <div class="nav-section-content" id="settingsMenu" style="display: none;">
              <%= link_to entity_users_path, class: "nav-item nav-sub-item #{'active' if request.path.start_with?('/entity/users')}" do %>
                <i data-lucide="user-cog"></i>
                <span>Team Members</span>
              <% end %>

              <%= link_to entity_policies_path, class: "nav-item nav-sub-item #{'active' if controller_name == 'policies'}" do %>
                <i data-lucide="shield"></i>
                <span>Policies</span>
              <% end %>

              <%= link_to entity_privacy_path, class: "nav-item nav-sub-item #{'active' if controller_name == 'privacy'}" do %>
                <i data-lucide="lock"></i>
                <span>Privacy Settings</span>
              <% end %>

              <%= link_to entity_observability_path, class: "nav-item nav-sub-item #{'active' if request.path == '/entity/observability'}" do %>
                <i data-lucide="bar-chart-3"></i>
                <span>Usage & Billing</span>
              <% end %>
            </div>
          <% end %>
        </nav>

        <%# Bottom Actions %>
        <div class="sidebar-bottom">
          <button data-theme-toggle class="nav-item w-100 text-start border-0 bg-transparent" aria-label="Toggle light/dark theme">
            <i data-theme-icon data-lucide="moon" aria-hidden="true"></i>
            <span>Theme</span>
          </button>

          <%= link_to chat_mode_path, class: "nav-item" do %>
            <i data-lucide="message-circle"></i>
            <span>Chat Mode</span>
          <% end %>

          <div class="dropdown dropup">
            <button class="nav-item user-dropdown-btn" type="button" data-bs-toggle="dropdown" aria-expanded="false" style="width: 100%; border: none; background: transparent; text-align: left;">
              <div style="display: flex; align-items: center; gap: 0.75rem;">
                <div style="width: 2rem; height: 2rem; border-radius: 50%; background: #2D3548; display: flex; align-items: center; justify-content: center;">
                  <i data-lucide="user" style="width: 1rem; height: 1rem; color: #94A3B8;"></i>
                </div>
                <div style="flex: 1; min-width: 0;">
                  <div style="font-size: 0.875rem; color: white; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                    <%= current_user.first_name %>
                  </div>
                  <div style="color: #64748B; font-size: 0.75rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                    <%= current_user.entity&.name %>
                  </div>
                </div>
                <i data-lucide="chevron-up" style="width: 1rem; height: 1rem; color: #94A3B8;"></i>
              </div>
            </button>
            
            <ul class="dropdown-menu">
              <%= link_to edit_user_path(current_user), class: "dropdown-item" do %>
                <i data-lucide="user" style="width: 1rem; height: 1rem; margin-right: 0.5rem;"></i>
                View Profile
              <% end %>
              
              <%= link_to edit_business_profile_path, class: "dropdown-item" do %>
                <i data-lucide="briefcase" style="width: 1rem; height: 1rem; margin-right: 0.5rem;"></i>
                Business Settings
              <% end %>
              
              <% if current_user.entity_admin? %>
                <%= link_to entity_observability_path, class: "dropdown-item" do %>
                  <i data-lucide="info" style="width: 1rem; height: 1rem; margin-right: 0.5rem;"></i>
                  Entity Info & Usage
                <% end %>
              <% end %>
              
              <% if current_user.admin? %>
                <li><hr class="dropdown-divider"></li>
                <%= link_to admin_dashboard_path, class: "dropdown-item" do %>
                  <i data-lucide="shield" style="width: 1rem; height: 1rem; margin-right: 0.5rem;"></i>
                  Admin Portal
                <% end %>
              <% end %>
              
              <li><hr class="dropdown-divider"></li>
              
              <%= button_to destroy_user_session_path, method: :delete, class: "dropdown-item text-danger", form: { data: { turbo: false } } do %>
                <i data-lucide="log-out" style="width: 1rem; height: 1rem; margin-right: 0.5rem;"></i>
                Sign Out
              <% end %>
            </ul>
          </div>
        </div>
      </aside>

      <%# Main Content Area %>
      <div class="admin-content">
        <%= yield %>
      </div>

    <% else %>
      <!-- Not logged in -->
      <%= yield %>
    <% end %>

    <!-- Initialize Lucide Icons and Sidebar Toggle -->
    <script>
      document.addEventListener('DOMContentLoaded', () => {
        lucide.createIcons();
        initSidebarToggle();
        initThemeToggle();
      });

      document.addEventListener('turbo:load', () => {
        lucide.createIcons();
        initSidebarToggle();
        initThemeToggle();
      });

      function initSidebarToggle() {
        const sidebar = document.getElementById('customerSidebar');
        const toggle = document.getElementById('sidebarToggle');

        if (!sidebar || !toggle) {
          console.error('Sidebar or toggle not found:', { sidebar, toggle });
          return;
        }

        // Remove any existing event listeners to prevent duplicates
        const newToggle = toggle.cloneNode(true);
        toggle.parentNode.replaceChild(newToggle, toggle);

        // Check saved state
        const isCollapsed = localStorage.getItem('customerSidebarCollapsed') === 'true';
        if (isCollapsed) {
          sidebar.classList.add('collapsed');
        }

        // Toggle on click
        newToggle.addEventListener('click', (e) => {
          e.preventDefault();
          sidebar.classList.toggle('collapsed');
          localStorage.setItem('customerSidebarCollapsed', sidebar.classList.contains('collapsed'));

          // Re-initialize icons after DOM changes
          setTimeout(() => lucide.createIcons(), 100);
        });
        
        // Handle custom dropdown functionality
        const navToggles = document.querySelectorAll('.nav-toggle');
        navToggles.forEach(toggle => {
          const sectionId = toggle.getAttribute('data-section');
          const content = document.getElementById(sectionId);
          const icon = toggle.querySelector('.toggle-icon');
          
          // Load saved state
          const savedState = localStorage.getItem(`navCollapse_${sectionId}`);
          let isExpanded = toggle.getAttribute('data-expanded') === 'true';
          
          if (savedState !== null) {
            isExpanded = savedState === 'true';
          }
          
          // Set initial state
          if (isExpanded) {
            content.style.display = 'block';
            toggle.setAttribute('data-expanded', 'true');
          } else {
            content.style.display = 'none';
            toggle.setAttribute('data-expanded', 'false');
          }
          
          // Handle click
          toggle.addEventListener('click', (e) => {
            e.preventDefault();
            const currentlyExpanded = toggle.getAttribute('data-expanded') === 'true';
            const newExpanded = !currentlyExpanded;
            
            // Toggle display
            content.style.display = newExpanded ? 'block' : 'none';
            toggle.setAttribute('data-expanded', newExpanded);
            
            // Save state
            localStorage.setItem(`navCollapse_${sectionId}`, newExpanded);
          });
        });
      }

      function initThemeToggle() {
        const themeToggle = document.querySelector('[data-theme-toggle]');
        const themeIcon = document.querySelector('[data-theme-icon]');
        
        if (!themeToggle || !themeIcon) return;

        // For admin dark theme, we'll just show the moon icon
        // Theme switching could be implemented later if needed
        themeIcon.setAttribute('data-lucide', 'moon');
        lucide.createIcons();
      }
    </script>
  </body>
</html>
