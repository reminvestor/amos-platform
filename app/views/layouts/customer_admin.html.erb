<!DOCTYPE html>
<html>
  <head>
    <title>AMOS - <%= @entity&.name || 'Marketing Platform' %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <!-- Load admin_dark.css first so application styles can override it -->
    <link rel="stylesheet" href="/assets/admin_dark.css" data-turbo-track="reload">
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_include_tag "application", "data-turbo-track": "reload", type: "module" %>

    <!-- Lucide Icons -->
        <script src="https://unpkg.com/lucide@latest"></script>

        <style>
          /* User dropdown styling */
          .user-dropdown-btn:hover {
            background: rgba(255, 255, 255, 0.05) !important;
          }
          
          .user-dropdown-btn:focus {
            outline: none;
            box-shadow: none;
          }
          
          .admin-sidebar .dropdown-menu {
            background: #0F172A;
            border: 1px solid #1E293B;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.3);
            min-width: 220px;
            margin-bottom: 0.5rem;
          }
          
          .admin-sidebar .dropdown-item {
            color: #94A3B8;
            padding: 0.5rem 1rem;
            display: flex;
            align-items: center;
            transition: all 0.2s ease;
          }
          
          .admin-sidebar .dropdown-item:hover {
            background: rgba(255, 255, 255, 0.05);
            color: white;
            text-decoration: none;
          }
          
          .admin-sidebar .dropdown-item.text-danger {
            color: #EF4444;
          }
          
          .admin-sidebar .dropdown-item.text-danger:hover {
            background: rgba(239, 68, 68, 0.1);
            color: #EF4444;
          }
          
          .admin-sidebar .dropdown-divider {
            border-color: #1E293B;
            margin: 0.5rem 0;
          }
          
          /* Collapsed state adjustments */
          .admin-sidebar.collapsed .user-dropdown-btn span,
          .admin-sidebar.collapsed .user-dropdown-btn > div > div {
            display: none;
          }
          
          .admin-sidebar.collapsed .user-dropdown-btn {
            justify-content: center;
            padding: 0.75rem 0;
          }
          
          .admin-sidebar.collapsed .dropdown-menu {
            position: absolute;
            left: 100%;
            bottom: 0;
            margin-left: 0.5rem;
            margin-bottom: 0;
          }
          
          /* Ensure hamburger button is styled correctly */
          .hamburger-toggle {
            background: transparent;
            border: none;
            color: #94A3B8;
            padding: 0.5rem;
            cursor: pointer;
            transition: all 0.2s ease;
          }
          
          .hamburger-toggle:hover {
            background: rgba(255, 255, 255, 0.05);
            color: white;
            border-radius: 0.375rem;
          }

          /* Collapsible Menu Styling */
          .nav-section-toggle {
            width: 100%;
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0.75rem 1rem;
            color: #94A3B8;
            border: none;
            background: transparent;
            border-radius: 0.5rem;
            transition: all 0.2s ease;
            cursor: pointer;
          }

          .nav-section-toggle:hover {
            background: rgba(255, 255, 255, 0.05);
            color: white;
          }

          .nav-section-toggle .collapse-icon {
            width: 1rem;
            height: 1rem;
            transition: transform 0.2s;
          }

          .nav-section-toggle[aria-expanded="true"] .collapse-icon {
            transform: rotate(180deg);
          }

          .nav-section-toggle[aria-expanded="true"] {
            color: white;
          }

          .nav-section-content {
            padding-left: 0;
            margin-top: 0.25rem;
            overflow: hidden;
          }

          .nav-section-content .nav-item {
            padding-left: 2.75rem; /* Indent sub-items */
            font-size: 0.9rem;
          }
          
          /* Remove old headers */
          .nav-section-header {
            display: none;
          }
        </style>
  </head>

  <body class="admin-dark">
    <% if current_user %>
      <%# Left Sidebar Navigation %>
      <aside class="admin-sidebar" id="customerSidebar">
        <%# Logo with Hamburger %>
        <div class="sidebar-logo">
          <div class="logo-icon">
            <div style="width: 2rem; height: 2rem; border-radius: 0.5rem; background: linear-gradient(135deg, #7C3AED 0%, #A78BFA 100%); display: flex; align-items: center; justify-content: center;">
              <i data-lucide="sparkles" class="icon-lg" style="color: white;"></i>
            </div>
          </div>
          <span class="logo-text">AMOS</span>
          <button class="hamburger-toggle" id="sidebarToggle" aria-label="Toggle sidebar">
            <i data-lucide="menu"></i>
          </button>
        </div>

        <%# Main Navigation %>
        <nav>
          <%# Dashboard %>
          <%= link_to advanced_mode_path, class: "nav-item #{'active' if request.path == advanced_mode_path}" do %>
            <i data-lucide="layout-dashboard"></i>
            <span>Dashboard</span>
          <% end %>

          <%# Marketing Section %>
          <div class="nav-section-collapsible">
            <button class="nav-section-toggle" type="button" data-bs-toggle="collapse" data-bs-target="#marketingCollapse" aria-expanded="<%= ['campaigns', 'email_templates', 'landing_pages', 'email_sequences'].include?(controller_name) %>">
              <div class="d-flex align-items-center gap-3">
                <i data-lucide="megaphone"></i>
                <span>Marketing</span>
              </div>
              <i data-lucide="chevron-down" class="collapse-icon"></i>
            </button>
            <div class="collapse <%= 'show' if ['campaigns', 'email_templates', 'landing_pages', 'email_sequences'].include?(controller_name) %>" id="marketingCollapse">
              <div class="nav-section-content">
                <%= link_to campaigns_path, class: "nav-item #{'active' if controller_name == 'campaigns'}" do %>
                  <span>Campaigns</span>
                <% end %>
                <%= link_to email_sequences_path, class: "nav-item #{'active' if controller_name == 'email_sequences'}" do %>
                  <span>Email Sequences</span>
                <% end %>
                <%= link_to email_templates_path, class: "nav-item #{'active' if controller_name == 'email_templates'}" do %>
                  <span>Email Templates</span>
                <% end %>
                <%= link_to landing_pages_path, class: "nav-item #{'active' if controller_name == 'landing_pages'}" do %>
                  <span>Landing Pages</span>
                <% end %>
              </div>
            </div>
          </div>

          <%# Contacts Section %>
          <div class="nav-section-collapsible">
            <button class="nav-section-toggle" type="button" data-bs-toggle="collapse" data-bs-target="#contactsCollapse" aria-expanded="<%= ['contacts', 'contact_groups'].include?(controller_name) %>">
              <div class="d-flex align-items-center gap-3">
                <i data-lucide="users"></i>
                <span>Contacts</span>
              </div>
              <i data-lucide="chevron-down" class="collapse-icon"></i>
            </button>
            <div class="collapse <%= 'show' if ['contacts', 'contact_groups'].include?(controller_name) %>" id="contactsCollapse">
              <div class="nav-section-content">
                <%= link_to contacts_path, class: "nav-item #{'active' if controller_name == 'contacts'}" do %>
                  <span>All Contacts</span>
                <% end %>
                <%= link_to contact_groups_path, class: "nav-item #{'active' if controller_name == 'contact_groups'}" do %>
                  <span>Contact Groups</span>
                <% end %>
              </div>
            </div>
          </div>

          <%# Media Assets Section %>
          <div class="nav-section-collapsible">
            <button class="nav-section-toggle" type="button" data-bs-toggle="collapse" data-bs-target="#mediaCollapse" aria-expanded="<%= ['image_assets', 'documents'].include?(controller_name) %>">
              <div class="d-flex align-items-center gap-3">
                <i data-lucide="image"></i>
                <span>Media Assets</span>
              </div>
              <i data-lucide="chevron-down" class="collapse-icon"></i>
            </button>
            <div class="collapse <%= 'show' if ['image_assets', 'documents'].include?(controller_name) %>" id="mediaCollapse">
              <div class="nav-section-content">
                <%= link_to image_assets_path, class: "nav-item #{'active' if controller_name == 'image_assets'}" do %>
                  <span>Image Library</span>
                <% end %>
                <%= link_to documents_path, class: "nav-item #{'active' if controller_name == 'documents'}" do %>
                  <span>Document Store</span>
                <% end %>
              </div>
            </div>
          </div>

          <%# AI Section - Agents, Tools, and Settings %>
          <div class="nav-section-collapsible">
            <button class="nav-section-toggle" type="button" data-bs-toggle="collapse" data-bs-target="#aiCollapse" aria-expanded="<%= ['agent_plugins', 'tools', 'scout', 'voice', 'scheduled_tasks'].include?(controller_name) || controller_path.start_with?('ai_settings') %>">
              <div class="d-flex align-items-center gap-3">
                <i data-lucide="sparkles"></i>
                <span>AI</span>
              </div>
              <i data-lucide="chevron-down" class="collapse-icon"></i>
            </button>
            <div class="collapse <%= 'show' if ['agent_plugins', 'tools', 'scout', 'voice', 'scheduled_tasks'].include?(controller_name) || controller_path.start_with?('ai_settings') %>" id="aiCollapse">
              <div class="nav-section-content">
                <%= link_to agent_plugins_path, class: "nav-item #{'active' if controller_name == 'agent_plugins'}" do %>
                  <span>My Agents</span>
                <% end %>
                <%= link_to tools_path, class: "nav-item #{'active' if controller_name == 'tools'}" do %>
                  <span>My Tools</span>
                <% end %>
                <%= link_to scheduled_tasks_path, class: "nav-item #{'active' if controller_name == 'scheduled_tasks'}" do %>
                  <span>Scheduled Tasks</span>
                <% end %>
                <% if current_user.entity_admin? %>
                  <%= link_to ai_settings_scout_path, class: "nav-item #{'active' if controller_path == 'ai_settings/scout'}" do %>
                    <span>Scout Settings</span>
                  <% end %>
                <% end %>
                <%= link_to ai_settings_voice_path, class: "nav-item #{'active' if controller_path == 'ai_settings/voice'}" do %>
                  <span>Voice Settings</span>
                <% end %>
                <%= link_to dashboard_energy_index_path, class: "nav-item #{'active' if controller_name == 'energy'}" do %>
                  <span>Agent Energy</span>
                <% end %>
                <%= link_to billing_path, class: "nav-item #{'active' if controller_name == 'billing'}" do %>
                  <i data-lucide="coins" style="width: 16px; height: 16px;" class="me-1 text-warning"></i>
                  <span>Work Tokens</span>
                <% end %>
              </div>
            </div>
          </div>

          <%# Entity Settings - Only for Entity Admins %>
          <% if current_user.entity_admin? %>
            <div class="nav-section-collapsible">
              <button class="nav-section-toggle" type="button" data-bs-toggle="collapse" data-bs-target="#settingsCollapse" aria-expanded="<%= ['social_media_accounts', 'users', 'policies', 'privacy', 'observability'].include?(controller_name) %>">
                <div class="d-flex align-items-center gap-3">
                  <i data-lucide="settings"></i>
                  <span>Settings</span>
                </div>
                <i data-lucide="chevron-down" class="collapse-icon"></i>
              </button>
              <div class="collapse <%= 'show' if ['social_media_accounts', 'users', 'policies', 'privacy', 'observability'].include?(controller_name) || request.path.start_with?('/entity') %>" id="settingsCollapse">
                <div class="nav-section-content">
                  <%= link_to customer_integrations_path, class: "nav-item #{'active' if controller_name == 'social_media_accounts' || request.path == customer_integrations_path}" do %>
                    <span>Integrations</span>
                  <% end %>
                  <%= link_to entity_users_path, class: "nav-item #{'active' if request.path.start_with?('/entity/users')}" do %>
                    <span>Team Members</span>
                  <% end %>
                  <%= link_to entity_policies_path, class: "nav-item #{'active' if controller_name == 'policies'}" do %>
                    <span>Policies</span>
                  <% end %>
                  <%= link_to entity_privacy_path, class: "nav-item #{'active' if controller_name == 'privacy'}" do %>
                    <span>Privacy Settings</span>
                  <% end %>
                  <%= link_to entity_observability_path, class: "nav-item #{'active' if request.path == '/entity/observability'}" do %>
                    <span>Usage & Billing</span>
                  <% end %>
                </div>
              </div>
            </div>
          <% end %>
        </nav>

        <%# Bottom Actions %>
        <div class="sidebar-bottom">
          <button data-theme-toggle class="nav-item w-100 text-start border-0 bg-transparent" aria-label="Toggle light/dark theme">
            <i data-theme-icon data-lucide="moon" aria-hidden="true"></i>
            <span>Theme</span>
          </button>

          <%= link_to chat_mode_path, class: "nav-item" do %>
            <i data-lucide="message-circle"></i>
            <span>Chat Mode</span>
          <% end %>

          <div class="dropdown dropup">
            <button class="nav-item user-dropdown-btn" type="button" data-bs-toggle="dropdown" aria-expanded="false" style="width: 100%; border: none; background: transparent; text-align: left;">
              <div style="display: flex; align-items: center; gap: 0.75rem;">
                <div style="width: 2rem; height: 2rem; border-radius: 50%; background: #2D3548; display: flex; align-items: center; justify-content: center;">
                  <i data-lucide="user" style="width: 1rem; height: 1rem; color: #94A3B8;"></i>
                </div>
                <div style="flex: 1; min-width: 0;">
                  <div style="font-size: 0.875rem; color: white; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                    <%= current_user.first_name %>
                  </div>
                  <div style="color: #64748B; font-size: 0.75rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                    <%= current_user.entity&.name %>
                  </div>
                </div>
                <i data-lucide="chevron-up" style="width: 1rem; height: 1rem; color: #94A3B8;"></i>
              </div>
            </button>
            
            <ul class="dropdown-menu">
              <%= link_to edit_user_path(current_user), class: "dropdown-item" do %>
                <i data-lucide="user" style="width: 1rem; height: 1rem; margin-right: 0.5rem;"></i>
                View Profile
              <% end %>
              
              <%= link_to edit_business_profile_path, class: "dropdown-item" do %>
                <i data-lucide="briefcase" style="width: 1rem; height: 1rem; margin-right: 0.5rem;"></i>
                Business Settings
              <% end %>
              
              <% if current_user.entity_admin? %>
                <%= link_to entity_observability_path, class: "dropdown-item" do %>
                  <i data-lucide="info" style="width: 1rem; height: 1rem; margin-right: 0.5rem;"></i>
                  Entity Info & Usage
                <% end %>
              <% end %>
              
              <% if current_user.admin? %>
                <li><hr class="dropdown-divider"></li>
                <%= link_to admin_dashboard_path, class: "dropdown-item" do %>
                  <i data-lucide="shield" style="width: 1rem; height: 1rem; margin-right: 0.5rem;"></i>
                  Admin Portal
                <% end %>
              <% end %>
              
              <li><hr class="dropdown-divider"></li>
              
              <%= button_to destroy_user_session_path, method: :delete, class: "dropdown-item text-danger", form: { data: { turbo: false } } do %>
                <i data-lucide="log-out" style="width: 1rem; height: 1rem; margin-right: 0.5rem;"></i>
                Sign Out
              <% end %>
            </ul>
          </div>
        </div>
      </aside>

      <%# Main Content Area %>
      <div class="admin-content">
        <%= yield %>
      </div>

    <% else %>
      <!-- Not logged in -->
      <%= yield %>
    <% end %>

    <!-- Initialize Lucide Icons and Sidebar Toggle -->
    <script>
      document.addEventListener('DOMContentLoaded', () => {
        lucide.createIcons();
        initSidebarToggle();
        initThemeToggle();
      });

      document.addEventListener('turbo:load', () => {
        lucide.createIcons();
        initSidebarToggle();
        initThemeToggle();
      });

      function initSidebarToggle() {
        const sidebar = document.getElementById('customerSidebar');
        const toggle = document.getElementById('sidebarToggle');

        if (!sidebar || !toggle) {
          console.error('Sidebar or toggle not found:', { sidebar, toggle });
          return;
        }

        // Remove any existing event listeners to prevent duplicates
        const newToggle = toggle.cloneNode(true);
        toggle.parentNode.replaceChild(newToggle, toggle);

        // Check saved state
        const isCollapsed = localStorage.getItem('customerSidebarCollapsed') === 'true';
        if (isCollapsed) {
          sidebar.classList.add('collapsed');
        }

        // Toggle on click
        newToggle.addEventListener('click', (e) => {
          e.preventDefault();
          sidebar.classList.toggle('collapsed');
          localStorage.setItem('customerSidebarCollapsed', sidebar.classList.contains('collapsed'));

          // Re-initialize icons after DOM changes
          setTimeout(() => lucide.createIcons(), 100);
        });
      }

      function initThemeToggle() {
        const themeToggle = document.querySelector('[data-theme-toggle]');
        const themeIcon = document.querySelector('[data-theme-icon]');
        
        if (!themeToggle || !themeIcon) return;

        // For admin dark theme, we'll just show the moon icon
        // Theme switching could be implemented later if needed
        themeIcon.setAttribute('data-lucide', 'moon');
        lucide.createIcons();
      }
    </script>
  </body>
</html>
