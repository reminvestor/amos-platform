<!DOCTYPE html>
<html>
  <head>
    <title>AMOS - <%= @entity&.name || 'Marketing Platform' %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <% if current_user %>
      <meta name="current-user-id" content="<%= current_user.id %>">
    <% end %>

    <!-- Apply theme immediately to prevent flash -->
    <script>
      (function() {
        var theme = localStorage.getItem('amos_theme_preference');
        if (!theme) {
          theme = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        }
        document.documentElement.setAttribute('data-theme', theme);
        document.documentElement.setAttribute('data-bs-theme', theme);
      })();
    </script>

    <!-- Load admin_dark.css first so application styles can override it -->
    <link rel="stylesheet" href="/assets/admin_dark.css" data-turbo-track="reload">
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_include_tag "application", "data-turbo-track": "reload", type: "module" %>

    <!-- Lucide Icons -->
        <script src="https://unpkg.com/lucide@latest"></script>

        <!-- SECURITY: Clear user-specific localStorage on logout (available globally) -->
        <script>
          window.clearScoutLocalStorage = function() {
            try {
              var keysToRemove = [];
              for (var i = 0; i < localStorage.length; i++) {
                var key = localStorage.key(i);
                if (key && (key.startsWith('scout_') || key.startsWith('amos_') || key.startsWith('hub_'))) {
                  keysToRemove.push(key);
                }
              }
              keysToRemove.forEach(function(key) { localStorage.removeItem(key); });
              console.log('🗑️ Cleared ' + keysToRemove.length + ' scout localStorage items');
            } catch (e) {
              console.warn('Could not clear localStorage:', e);
            }
          };
        </script>

        <style>
          /* User dropdown styling */
          .user-dropdown-btn:hover {
            background: var(--bg-hover) !important;
          }

          .user-dropdown-btn:focus {
            outline: none;
            box-shadow: none;
          }

          .admin-sidebar .dropdown-menu {
            background: var(--bg-secondary);
            border: 1px solid var(--border-primary);
            box-shadow: var(--shadow-md);
            min-width: 220px;
            margin-bottom: 0.5rem;
          }

          .admin-sidebar .dropdown-item {
            color: var(--text-secondary);
            padding: 0.5rem 1rem;
            display: flex;
            align-items: center;
            transition: all 0.2s ease;
          }

          .admin-sidebar .dropdown-item:hover {
            background: var(--bg-hover);
            color: var(--text-primary);
            text-decoration: none;
          }

          .admin-sidebar .dropdown-item.text-danger {
            color: #EF4444;
          }

          .admin-sidebar .dropdown-item.text-danger:hover {
            background: rgba(239, 68, 68, 0.1);
            color: #EF4444;
          }

          .admin-sidebar .dropdown-divider {
            border-color: var(--border-primary);
            margin: 0.5rem 0;
          }

          /* Collapsed state adjustments */
          .admin-sidebar.collapsed .user-dropdown-btn span,
          .admin-sidebar.collapsed .user-dropdown-btn > div > div {
            display: none;
          }

          .admin-sidebar.collapsed .user-dropdown-btn {
            justify-content: center;
            padding: 0.75rem 0;
          }

          .admin-sidebar.collapsed .dropdown-menu {
            position: absolute;
            left: 100%;
            bottom: 0;
            margin-left: 0.5rem;
            margin-bottom: 0;
          }

          /* Ensure hamburger button is styled correctly */
          .hamburger-toggle {
            background: transparent;
            border: none;
            color: var(--text-secondary);
            padding: 0.5rem;
            cursor: pointer;
            transition: all 0.2s ease;
          }

          .hamburger-toggle:hover {
            background: var(--bg-hover);
            color: var(--text-primary);
            border-radius: 0.375rem;
          }

          /* Collapsible Menu Styling */
          .nav-section-toggle {
            width: 100%;
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0.75rem 1rem;
            color: var(--text-secondary);
            border: none;
            background: transparent;
            border-radius: 0.5rem;
            transition: all 0.2s ease;
            cursor: pointer;
          }

          .nav-section-toggle:hover {
            background: var(--bg-hover);
            color: var(--text-primary);
          }

          .nav-section-toggle .collapse-icon {
            width: 1rem;
            height: 1rem;
            transition: transform 0.2s;
          }

          .nav-section-toggle[aria-expanded="true"] .collapse-icon {
            transform: rotate(180deg);
          }

          .nav-section-toggle[aria-expanded="true"] {
            color: var(--text-primary);
          }

          .nav-section-content {
            padding-left: 0;
            margin-top: 0.25rem;
            overflow: hidden;
          }

          .nav-section-content .nav-item {
            padding-left: 2.75rem; /* Indent sub-items */
            font-size: 0.9rem;
          }

          /* Remove old headers */
          .nav-section-header {
            display: none;
          }
        </style>
  </head>

  <body class="admin-layout">
    <% if current_user %>
      <%# Left Sidebar Navigation %>
      <aside class="admin-sidebar" id="customerSidebar">
        <%# Logo with Hamburger %>
        <div class="sidebar-logo">
          <div class="logo-icon" style="background: linear-gradient(135deg, #7C3AED, #A78BFA); border-radius: 8px; padding: 6px; display: flex; align-items: center; justify-content: center;">
            <%= image_tag "Logo_mark.png", style: "height: 2rem; width: auto;", alt: "AMOS" %>
          </div>
          <button class="hamburger-toggle" id="sidebarToggle" aria-label="Toggle sidebar">
            <i data-lucide="menu"></i>
          </button>
        </div>

        <%# Main Navigation %>
        <nav>
          <%# Dashboard - Work/Team spaces only %>
          <% if sidebar_section_visible?('dashboard') %>
            <%= link_to advanced_mode_path, class: "nav-item #{'active' if request.path == advanced_mode_path}" do %>
              <i data-lucide="layout-dashboard"></i>
              <span>Dashboard</span>
            <% end %>
          <% end %>

          <%# 
              Personal Space Items - Notes, Bookmarks, Reminders 
              DISABLED: These are now canvas-only features accessible via Amos chat.
              Users can say "show my notes", "show bookmarks", "show reminders" in chat.
              Set SHOW_PERSONAL_SIDEBAR_ITEMS to true to restore these sidebar items.
          %>
          <% if false # DISABLED - Notes/Bookmarks/Reminders are canvas-only now %>
            <% if sidebar_section_visible?('notes') %>
              <%= link_to notes_path, class: "nav-item #{'active' if controller_name == 'notes'}" do %>
                <i data-lucide="edit-3"></i>
                <span>Notes</span>
              <% end %>
            <% end %>

            <% if sidebar_section_visible?('bookmarks') %>
              <%= link_to bookmarks_path, class: "nav-item #{'active' if controller_name == 'bookmarks'}" do %>
                <i data-lucide="bookmark"></i>
                <span>Bookmarks</span>
              <% end %>
            <% end %>

            <% if sidebar_section_visible?('reminders') %>
              <%= link_to reminders_path, class: "nav-item #{'active' if controller_name == 'reminders'}" do %>
                <i data-lucide="bell"></i>
                <span>Reminders</span>
              <% end %>
            <% end %>
          <% end %>

          <%# Team Space - Channels %>
          <% if sidebar_section_visible?('channels') %>
            <p class="nav-category">Communication</p>
            <%= link_to channels_path, class: "nav-item #{'active' if controller_name == 'channels'}" do %>
              <i data-lucide="hash"></i>
              <span>Channels</span>
            <% end %>
          <% end %>

          <%# Marketing Section - MOVED TO CHAT ONLY
              Marketing features (Campaigns, Email Sequences, Email Templates, Landing Pages)
              are now accessible only through Scout chat.
              Users can say "show my campaigns" or "show email templates" to access these features.
              Available canvases: campaign_viewer, email_template_viewer, landing_page_viewer
          %>

          <%# Contacts Section - MOVED TO CHAT ONLY
              Contact management is now accessible only through Scout chat.
              Users can say "show my contacts" or "show contact groups" to access these features.
              Available canvases: contact_viewer, contact_detail
          %>

          <%# CRM / Sales Section - REMOVED from sidebar
              Sales pipeline and activities are now accessible only through Scout chat.
              Users can say "show me the sales pipeline" or "show my opportunities" to access these features.
              The pipeline_viewer canvas handles this functionality.
          %>

          <%# Media Assets Section %>
          <% if sidebar_section_visible?('media') %>
          <div class="nav-section-collapsible">
            <button class="nav-section-toggle" type="button" data-bs-toggle="collapse" data-bs-target="#mediaCollapse" aria-expanded="<%= ['image_assets', 'documents'].include?(controller_name) %>">
              <div class="d-flex align-items-center gap-3">
                <i data-lucide="image"></i>
                <span>Media Assets</span>
              </div>
              <i data-lucide="chevron-down" class="collapse-icon"></i>
            </button>
            <div class="collapse <%= 'show' if ['image_assets', 'documents'].include?(controller_name) %>" id="mediaCollapse">
              <div class="nav-section-content">
                <%= link_to image_assets_path, class: "nav-item #{'active' if controller_name == 'image_assets'}" do %>
                  <span>Image Library</span>
                <% end %>
                <%= link_to documents_path, class: "nav-item #{'active' if controller_name == 'documents'}" do %>
                  <span>Document Store</span>
                <% end %>
              </div>
            </div>
          </div>
          <% end %>

          <%# AI Section - Agents, Tools, and Settings %>
          <% if sidebar_section_visible?('ai') %>
          <div class="nav-section-collapsible">
            <button class="nav-section-toggle" type="button" data-bs-toggle="collapse" data-bs-target="#aiCollapse" aria-expanded="<%= ['agent_plugins', 'tools', 'scout', 'voice', 'scheduled_tasks'].include?(controller_name) || controller_path.start_with?('ai_settings') %>">
              <div class="d-flex align-items-center gap-3">
                <i data-lucide="sparkles"></i>
                <span>AI</span>
              </div>
              <i data-lucide="chevron-down" class="collapse-icon"></i>
            </button>
            <div class="collapse <%= 'show' if ['agent_plugins', 'tools', 'scout', 'voice', 'scheduled_tasks'].include?(controller_name) || controller_path.start_with?('ai_settings') %>" id="aiCollapse">
              <div class="nav-section-content">
                <% if sidebar_section_visible?('agents') %>
                  <%= link_to agent_plugins_path, class: "nav-item #{'active' if controller_name == 'agent_plugins'}" do %>
                    <span>My Agents</span>
                  <% end %>
                <% end %>
                <%= link_to tools_path, class: "nav-item #{'active' if controller_name == 'tools'}" do %>
                  <span>My Tools</span>
                <% end %>
                <%= link_to scheduled_tasks_path, class: "nav-item #{'active' if controller_name == 'scheduled_tasks'}" do %>
                  <span>Scheduled Tasks</span>
                <% end %>
                <%# HIDDEN: Tool configuration is now handled by RAG-based discovery
                    The EXCLUDED_TOOLS constant still prevents specialist tools from being used by Amos.
                    If we need to re-enable this, uncomment below: %>
                <%# if current_user.entity_admin? %>
                  <%#= link_to ai_settings_scout_path, class: "nav-item #{'active' if controller_path == 'ai_settings/scout'}" do %>
                    <%# <span>Amos Settings</span> %>
                  <%# end %>
                <%# end %>
                <%= link_to ai_settings_menu_path, class: "nav-item #{'active' if controller_path == 'ai_settings/menu'}" do %>
                  <span>Menu Config</span>
                <% end %>
                <%= link_to ai_settings_voice_path, class: "nav-item #{'active' if controller_path == 'ai_settings/voice'}" do %>
                  <span>Voice Settings</span>
                <% end %>
                <%= link_to dashboard_energy_index_path, class: "nav-item #{'active' if controller_name == 'energy'}" do %>
                  <span>Agent Energy</span>
                <% end %>
              </div>
            </div>
          </div>
          <% end %>

          <%# Entity Settings - Only for Entity Admins (and Work/Team spaces) %>
          <% if current_user.entity_admin? && sidebar_section_visible?('settings') %>
            <div class="nav-section-collapsible">
              <button class="nav-section-toggle" type="button" data-bs-toggle="collapse" data-bs-target="#settingsCollapse" aria-expanded="<%= ['social_media_accounts', 'users', 'policies', 'privacy', 'billing'].include?(controller_name) %>">
                <div class="d-flex align-items-center gap-3">
                  <i data-lucide="settings"></i>
                  <span>Settings</span>
                </div>
                <i data-lucide="chevron-down" class="collapse-icon"></i>
              </button>
              <div class="collapse <%= 'show' if ['social_media_accounts', 'users', 'policies', 'privacy', 'billing'].include?(controller_name) || request.path.start_with?('/entity') %>" id="settingsCollapse">
                <div class="nav-section-content">
                  <%= link_to customer_integrations_path, class: "nav-item #{'active' if controller_name == 'social_media_accounts' || request.path == customer_integrations_path}" do %>
                    <span>Integrations</span>
                  <% end %>
                  <%= link_to entity_users_path, class: "nav-item #{'active' if request.path.start_with?('/entity/users')}" do %>
                    <span>Team Members</span>
                  <% end %>
                  <%= link_to entity_policies_path, class: "nav-item #{'active' if controller_name == 'policies'}" do %>
                    <span>Policies</span>
                  <% end %>
                  <%= link_to entity_privacy_path, class: "nav-item #{'active' if controller_name == 'privacy'}" do %>
                    <span>Privacy Settings</span>
                  <% end %>
                  <%= link_to billing_path, class: "nav-item #{'active' if controller_name == 'billing'}" do %>
                    <span>Usage & Billing</span>
                  <% end %>
                </div>
              </div>
            </div>
          <% end %>
        </nav>

        <%# Bottom Actions %>
        <div class="sidebar-bottom">
          <button data-theme-toggle class="nav-item w-100 text-start border-0 bg-transparent" aria-label="Toggle light/dark theme">
            <i data-theme-icon data-lucide="moon" aria-hidden="true"></i>
            <span>Theme</span>
          </button>

          <%= link_to chat_mode_path, class: "nav-item" do %>
            <i data-lucide="message-circle"></i>
            <span>Chat Mode</span>
          <% end %>

          <div class="dropdown dropup">
            <button class="nav-item user-dropdown-btn" type="button" data-bs-toggle="dropdown" aria-expanded="false" style="width: 100%; border: none; background: transparent; text-align: left;">
              <div style="display: flex; align-items: center; gap: 0.75rem;">
                <div style="width: 2rem; height: 2rem; border-radius: 50%; background: #2D3548; display: flex; align-items: center; justify-content: center;">
                  <i data-lucide="user" style="width: 1rem; height: 1rem; color: #94A3B8;"></i>
                </div>
                <div style="flex: 1; min-width: 0;">
                  <div style="font-size: 0.875rem; color: var(--text-primary); white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                    <%= current_user.first_name %>
                  </div>
                  <div style="color: var(--text-tertiary); font-size: 0.75rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                    <%= current_user.entity&.name %>
                  </div>
                </div>
                <i data-lucide="chevron-up" style="width: 1rem; height: 1rem; color: #94A3B8;"></i>
              </div>
            </button>
            
            <ul class="dropdown-menu">
              <%= link_to edit_user_path(current_user), class: "dropdown-item" do %>
                <i data-lucide="user" style="width: 1rem; height: 1rem; margin-right: 0.5rem;"></i>
                View Profile
              <% end %>
              
              <%= link_to edit_business_profile_path, class: "dropdown-item" do %>
                <i data-lucide="briefcase" style="width: 1rem; height: 1rem; margin-right: 0.5rem;"></i>
                Business Settings
              <% end %>
              
              <% if current_user.entity_admin? %>
                <%= link_to billing_path, class: "dropdown-item" do %>
                  <i data-lucide="coins" style="width: 1rem; height: 1rem; margin-right: 0.5rem;"></i>
                  Usage & Billing
                <% end %>
              <% end %>
              
              <% if current_user.admin? %>
                <li><hr class="dropdown-divider"></li>
                <%= link_to admin_dashboard_path, class: "dropdown-item" do %>
                  <i data-lucide="shield" style="width: 1rem; height: 1rem; margin-right: 0.5rem;"></i>
                  Admin Portal
                <% end %>
              <% end %>
              
              <li><hr class="dropdown-divider"></li>
              
              <%= button_to destroy_user_session_path, method: :delete, class: "dropdown-item text-danger", form: { data: { turbo: false }, onclick: "window.clearScoutLocalStorage && window.clearScoutLocalStorage()" } do %>
                <i data-lucide="log-out" style="width: 1rem; height: 1rem; margin-right: 0.5rem;"></i>
                Sign Out
              <% end %>
            </ul>
          </div>
        </div>
      </aside>

      <%# Main Content Area %>
      <div class="admin-content">
        <%= yield %>
      </div>

    <% else %>
      <!-- Not logged in -->
      <%= yield %>
    <% end %>

    <!-- Initialize Lucide Icons and Sidebar Toggle -->
    <script>
      document.addEventListener('DOMContentLoaded', () => {
        lucide.createIcons();
        initSidebarToggle();
        initThemeToggle();
      });

      document.addEventListener('turbo:load', () => {
        lucide.createIcons();
        initSidebarToggle();
        initThemeToggle();
      });

      function initSidebarToggle() {
        const sidebar = document.getElementById('customerSidebar');
        const toggle = document.getElementById('sidebarToggle');

        if (!sidebar || !toggle) {
          console.error('Sidebar or toggle not found:', { sidebar, toggle });
          return;
        }

        // Remove any existing event listeners to prevent duplicates
        const newToggle = toggle.cloneNode(true);
        toggle.parentNode.replaceChild(newToggle, toggle);

        // Check saved state
        const isCollapsed = localStorage.getItem('customerSidebarCollapsed') === 'true';
        if (isCollapsed) {
          sidebar.classList.add('collapsed');
        }

        // Toggle on click
        newToggle.addEventListener('click', (e) => {
          e.preventDefault();
          sidebar.classList.toggle('collapsed');
          localStorage.setItem('customerSidebarCollapsed', sidebar.classList.contains('collapsed'));

          // Re-initialize icons after DOM changes
          setTimeout(() => lucide.createIcons(), 100);
        });
      }

      function initThemeToggle() {
        const currentTheme = document.documentElement.getAttribute('data-theme') ||
                           localStorage.getItem('amos_theme_preference') ||
                           (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');

        // Apply theme if not already set
        if (!document.documentElement.getAttribute('data-theme')) {
          document.documentElement.setAttribute('data-theme', currentTheme);
        }

        // Update theme toggle icon
        const themeIcon = document.querySelector('[data-theme-icon]');
        if (themeIcon) {
          themeIcon.setAttribute('data-lucide', currentTheme === 'dark' ? 'sun' : 'moon');
          if (typeof lucide !== 'undefined') {
            lucide.createIcons();
          }
        }

        // Add click handler for theme toggle
        const themeToggle = document.querySelector('[data-theme-toggle]');
        if (themeToggle && !themeToggle.hasAttribute('data-theme-initialized')) {
          themeToggle.setAttribute('data-theme-initialized', 'true');
          themeToggle.addEventListener('click', function() {
            const current = document.documentElement.getAttribute('data-theme') || 'light';
            const newTheme = current === 'light' ? 'dark' : 'light';
            document.documentElement.setAttribute('data-theme', newTheme);
            localStorage.setItem('amos_theme_preference', newTheme);

            // Update icon
            const icon = document.querySelector('[data-theme-icon]');
            if (icon) {
              icon.setAttribute('data-lucide', newTheme === 'dark' ? 'sun' : 'moon');
              if (typeof lucide !== 'undefined') {
                lucide.createIcons();
              }
            }
          });
        }
      }
    </script>
  </body>
</html>
