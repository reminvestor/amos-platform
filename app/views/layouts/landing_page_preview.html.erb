<!DOCTYPE html>
<html>
  <head>
    <title>Preview: <%= @landing_page.title %></title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Lucide Icons -->
    <script src="https://unpkg.com/lucide@latest"></script>
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Open+Sans:wght@400;600;700&family=Roboto:wght@400;500;700&family=Montserrat:wght@400;500;700&display=swap" rel="stylesheet">
    
    <style>
      :root {
        --primary-color: <%= @landing_page.primary_color || '#0d6efd' %>;
        --secondary-color: <%= @landing_page.secondary_color || '#6c757d' %>;
        --font-family: <%= @landing_page.font_family || 'Arial, sans-serif' %>;
      }
      
      body {
        font-family: var(--font-family);
        line-height: 1.6;
        color: #333;
        overflow-x: hidden;
        padding-top: 56px; /* For the preview toolbar */
      }
      
      .btn-primary {
        background-color: var(--primary-color);
        border-color: var(--primary-color);
      }
      
      .btn-primary:hover {
        background-color: var(--primary-color);
        filter: brightness(90%);
        border-color: var(--primary-color);
      }
      
      .text-primary {
        color: var(--primary-color) !important;
      }
      
      .bg-primary {
        background-color: var(--primary-color) !important;
      }
      
      .border-primary {
        border-color: var(--primary-color) !important;
      }
      
      .text-secondary {
        color: var(--secondary-color) !important;
      }
      
      .hero-section {
        background-size: cover;
        background-position: center;
        min-height: 500px;
        display: flex;
        align-items: center;
      }
      
      .feature-card {
        height: 100%;
        transition: transform 0.3s;
        border: 1px solid #eee;
      }
      
      .feature-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 10px 20px rgba(0,0,0,0.1);
      }
      
      .testimonial {
        border-left: 4px solid var(--primary-color);
      }
      
      .cta-section {
        background-color: var(--primary-color);
        color: white;
      }
      
      .cta-btn {
        background-color: white;
        color: var(--primary-color);
        font-weight: bold;
        padding: 12px 30px;
        border-radius: 30px;
        font-size: 1.1rem;
        transition: all 0.3s;
      }
      
      .cta-btn:hover {
        transform: scale(1.05);
        box-shadow: 0 5px 15px rgba(0,0,0,0.1);
      }
      
      /* Preview toolbar - Dark theme */
      .preview-toolbar {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        z-index: 1000;
        background: linear-gradient(135deg, #1A1F35 0%, #0F172A 100%);
        color: white;
        padding: 12px 24px;
        border-bottom: 1px solid #1E293B;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.3);
      }

      .preview-badge {
        background: linear-gradient(135deg, #FACC15 0%, #EAB308 100%);
        color: #0F172A;
        padding: 4px 12px;
        border-radius: 6px;
        font-weight: 600;
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 0.05em;
      }

      .preview-title {
        color: #FFFFFF;
        font-weight: 500;
        margin-left: 12px;
      }

      .device-selector {
        background-color: rgba(255,255,255,0.05);
        border-radius: 8px;
        padding: 4px;
        display: inline-flex;
        gap: 4px;
        border: 1px solid rgba(255,255,255,0.1);
      }

      .device-btn {
        color: #94A3B8;
        background: none;
        border: none;
        border-radius: 6px;
        padding: 6px 12px;
        cursor: pointer;
        transition: all 0.2s;
        display: flex;
        align-items: center;
        gap: 6px;
        font-size: 0.875rem;
      }

      .device-btn:hover {
        color: #FFFFFF;
        background-color: rgba(255,255,255,0.1);
      }

      .device-btn.active {
        background-color: #22D3EE;
        color: #0F172A;
        font-weight: 600;
      }

      .toolbar-btn {
        background-color: rgba(255,255,255,0.1);
        border: 1px solid rgba(255,255,255,0.2);
        color: #FFFFFF;
        padding: 8px 16px;
        border-radius: 6px;
        text-decoration: none;
        font-size: 0.875rem;
        transition: all 0.2s;
        display: inline-flex;
        align-items: center;
        gap: 6px;
      }

      .toolbar-btn:hover {
        background-color: rgba(255,255,255,0.15);
        color: #FFFFFF;
        transform: translateY(-1px);
      }

      .toolbar-btn-success {
        background: linear-gradient(135deg, #4ADE80 0%, #22C55E 100%);
        border-color: transparent;
        color: #0F172A;
        font-weight: 600;
      }

      .toolbar-btn-success:hover {
        filter: brightness(1.1);
        color: #0F172A;
      }
    </style>
  </head>

  <body>
    <!-- Preview Toolbar -->
    <div class="preview-toolbar d-flex justify-content-between align-items-center">
      <div class="d-flex align-items-center">
        <span class="preview-badge">PREVIEW</span>
        <span class="preview-title"><%= @landing_page.title %></span>
      </div>
      <div class="device-selector d-none d-md-inline-flex">
        <button type="button" class="device-btn active" data-device="desktop">
          <i data-lucide="monitor"></i>
          <span>Desktop</span>
        </button>
        <button type="button" class="device-btn" data-device="tablet">
          <i data-lucide="tablet"></i>
          <span>Tablet</span>
        </button>
        <button type="button" class="device-btn" data-device="mobile">
          <i data-lucide="smartphone"></i>
          <span>Mobile</span>
        </button>
      </div>
      <div class="d-flex align-items-center gap-2">
        <%= link_to chat_landing_page_path(@landing_page), class: "toolbar-btn" do %>
          <i data-lucide="arrow-left" style="width: 16px; height: 16px;"></i>
          <span>Back to Chat</span>
        <% end %>
        <% if @landing_page.published? %>
          <%= link_to landing_page_public_path(@landing_page.slug), class: "toolbar-btn toolbar-btn-success", target: "_blank" do %>
            <i data-lucide="external-link" style="width: 16px; height: 16px;"></i>
            <span>View Live</span>
          <% end %>
        <% else %>
          <%= button_to publish_landing_page_path(@landing_page), method: :post, class: "toolbar-btn toolbar-btn-success" do %>
            <i data-lucide="rocket" style="width: 16px; height: 16px;"></i>
            <span>Publish</span>
          <% end %>
        <% end %>
      </div>
    </div>
    
    <div id="preview-container" class="w-100 mx-auto">
      <!-- Hero Section -->
      <section class="hero-section" style="background-image: linear-gradient(rgba(0,0,0,0.5), rgba(0,0,0,0.5)), url('<%= @landing_page.hero_image_url %>');">
        <div class="container">
          <div class="row">
            <div class="col-md-8">
              <div class="bg-white p-4 p-md-5 rounded shadow-lg">
                <h1 class="fw-bold mb-3"><%= @landing_page.headline %></h1>
                <p class="lead mb-4"><%= @landing_page.subheadline %></p>
                <a href="#" class="btn btn-primary btn-lg px-4 py-2 fw-bold">
                  <%= @landing_page.cta_text %>
                </a>
              </div>
            </div>
          </div>
        </div>
      </section>
      
      <!-- Content Sections -->
      <% if @landing_page.content.present? %>
        <% @landing_page.content.each_with_index do |section, index| %>
          <section class="py-5 <%= index.odd? ? 'bg-light' : '' %>">
            <div class="container">
              <% if section['title'].present? %>
                <h2 class="text-center mb-4"><%= section['title'] %></h2>
              <% end %>
              
              <% case section['type'] %>
              <% when 'feature' %>
                <div class="row row-cols-1 row-cols-md-3 g-4">
                  <div class="col">
                    <div class="card h-100 feature-card">
                      <div class="card-body text-center">
                        <i class="fas fa-check-circle fa-3x text-primary mb-3"></i>
                        <div><%=
                          if section['content'].is_a?(String)
                            section['content'].html_safe
                          else
                            section['content'].to_s
                          end
                        %></div>
                      </div>
                    </div>
                  </div>
                </div>
              <% when 'testimonial' %>
                <div class="row justify-content-center">
                  <div class="col-md-8">
                    <div class="p-4 bg-white shadow rounded testimonial">
                      <%= 
                        if section['content'].is_a?(String)
                          section['content'].html_safe
                        else
                          section['content'].to_s
                        end
                      %>
                    </div>
                  </div>
                </div>
              <% when 'pricing' %>
                <div class="row row-cols-1 row-cols-md-3 g-4">
                  <div class="col">
                    <div class="card h-100 shadow">
                      <div class="card-body">
                        <%= 
                          if section['content'].is_a?(String)
                            section['content'].html_safe
                          else
                            section['content'].to_s
                          end
                        %>
                      </div>
                    </div>
                  </div>
                </div>
              <% when 'faq' %>
                <div class="row justify-content-center">
                  <div class="col-md-8">
                    <div class="accordion" id="faqAccordion">
                      <%= 
                        if section['content'].is_a?(String)
                          section['content'].html_safe
                        else
                          section['content'].to_s
                        end
                      %>
                    </div>
                  </div>
                </div>
              <% else %>
                <div class="row justify-content-center">
                  <div class="col-md-8">
                    <%= 
                      if section['content'].is_a?(String)
                        section['content'].html_safe
                      else
                        section['content'].to_s
                      end
                    %>
                  </div>
                </div>
              <% end %>
            </div>
          </section>
        <% end %>
      <% end %>
      
      <!-- CTA Section -->
      <section class="cta-section py-5">
        <div class="container text-center py-4">
          <h2 class="fw-bold mb-3"><%= @landing_page.headline %></h2>
          <p class="lead mb-4"><%= @landing_page.subheadline %></p>
          <a href="#" class="btn cta-btn">
            <%= @landing_page.cta_text %>
          </a>
        </div>
      </section>
      
      <!-- Footer -->
      <footer class="bg-dark text-white py-4">
        <div class="container">
          <div class="row">
            <div class="col-md-6">
              <p>&copy; <%= Date.current.year %> <%= @landing_page.entity.name %> | All Rights Reserved</p>
            </div>
            <div class="col-md-6 text-md-end">
              <p>
                <small>Created with Agent Marketing</small>
              </p>
            </div>
          </div>
        </div>
      </footer>
    </div>
    
    <!-- Bootstrap JS Bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js"></script>
    
    <script>
      document.addEventListener('DOMContentLoaded', function() {
        // Initialize Lucide icons
        if (typeof lucide !== 'undefined') {
          lucide.createIcons();
        }

        const previewContainer = document.getElementById('preview-container');
        const deviceButtons = document.querySelectorAll('.device-btn');

        // Device preview functionality
        deviceButtons.forEach(button => {
          button.addEventListener('click', function() {
            const device = this.getAttribute('data-device');

            // Remove active class from all buttons
            deviceButtons.forEach(btn => btn.classList.remove('active'));

            // Add active class to clicked button
            this.classList.add('active');

            // Update preview container width
            switch(device) {
              case 'mobile':
                previewContainer.style.maxWidth = '375px';
                break;
              case 'tablet':
                previewContainer.style.maxWidth = '768px';
                break;
              case 'desktop':
              default:
                previewContainer.style.maxWidth = '100%';
                break;
            }
          });
        });
      });
    </script>
  </body>
</html> 