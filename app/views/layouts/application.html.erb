<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "AMOS Labs" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="icon" href="/favicon.ico">

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <!-- Font Awesome for icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" integrity="sha512-DTOQO9RWCH3ppGqcWaEA1BIZOC6xxalwEsw9c2QQeAIftl+Vegovlnee1c9QX4TctnWMn13TZye+giMm8e2LwA==" crossorigin="anonymous" referrerpolicy="no-referrer" />
    <!-- Lucide Icons for modern icon system -->
    <script src="https://unpkg.com/lucide@latest"></script>

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "trix", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "actiontext", "data-turbo-track": "reload" %>
    <%= javascript_include_tag "application", "data-turbo-track": "reload", type: "module" %>
    
    <style>
      body {
        padding-top: 56px;
        display: flex;
        min-height: 100vh;
        background-color: var(--bg-primary);
        color: var(--text-primary);
        transition: background-color 0.3s ease, color 0.3s ease;
      }

      /* Theme-aware Navbar */
      .navbar.bg-primary {
        background-color: var(--bg-card) !important;
        border-bottom: 1px solid var(--border-primary);
        transition: background-color 0.3s ease, border-color 0.3s ease;
      }

      /* Theme-aware Sidebar */
      .sidebar {
        width: 280px;
        position: fixed;
        top: 56px;
        bottom: 0;
        left: 0;
        z-index: 100;
        padding: 0;
        background-color: var(--bg-secondary);
        border-right: 1px solid var(--border-primary);
        transition: all 0.3s ease;
        overflow-y: auto;
      }

      .sidebar-collapsed {
        width: 60px;
      }

      .sidebar-header {
        padding: 1rem;
        background-color: var(--bg-card);
      }

      .sidebar .sidebar-link {
        display: flex;
        align-items: center;
        padding: 0.75rem 1rem;
        color: var(--text-secondary);
        font-weight: 500;
        border-left: 3px solid transparent;
        text-decoration: none;
        transition: all 0.3s ease;
      }

      .sidebar .sidebar-link.active {
        color: var(--accent-cyan);
        border-left: 3px solid var(--accent-cyan);
        background-color: var(--status-info-bg);
        font-weight: 600;
      }

      .sidebar .sidebar-link:hover {
        color: var(--text-primary);
        background-color: var(--bg-hover);
      }

      .sidebar .sidebar-link.small {
        padding: 0.5rem 1rem 0.5rem 2.5rem;
        color: var(--text-secondary);
        font-weight: 400;
        font-size: 0.875rem;
      }

      .sidebar .sidebar-toggle {
        display: flex;
        align-items: center;
        padding: 0.75rem 1rem;
        color: var(--text-secondary);
        font-weight: 500;
        cursor: pointer;
        text-decoration: none;
        transition: all 0.3s ease;
      }

      .sidebar .sidebar-toggle:hover {
        color: var(--text-primary);
        background-color: var(--bg-hover);
      }

      /* Section headers in sidebar */
      .sidebar .px-3 {
        padding-left: 1rem !important;
        padding-right: 1rem !important;
      }

      .sidebar .text-muted {
        color: var(--text-muted) !important;
        font-size: 0.75rem;
        letter-spacing: 0.05em;
      }

      .sidebar-collapsed .nav-link-text,
      .sidebar-collapsed .sidebar-heading {
        display: none;
      }

      .main-content {
        margin-left: 280px;
        width: calc(100% - 280px);
        padding: 1.5rem;
        transition: all 0.3s ease;
        background-color: var(--bg-primary);
        min-height: calc(100vh - 56px);
      }

      .main-content-expanded {
        margin-left: 60px;
        width: calc(100% - 60px);
      }

      /* Theme-aware Flash messages */
      .alert-success {
        background-color: var(--status-success-bg);
        border-color: var(--status-success-border);
        color: var(--status-success-text);
      }

      .alert-danger {
        background-color: var(--status-error-bg);
        border-color: var(--status-error-border);
        color: var(--status-error-text);
      }

      /* Theme-aware User Dropdown */
      .dropdown-menu {
        background-color: var(--bg-card);
        border: 1px solid var(--border-primary);
        box-shadow: var(--shadow-lg);
        padding: 0.5rem 0;
        min-width: 280px;
        transition: all 0.3s ease;
      }

      .dropdown-item {
        color: var(--text-secondary);
        padding: 0.625rem 1rem;
        transition: all 0.3s ease;
        display: flex;
        align-items: center;
      }

      .dropdown-item:hover,
      .dropdown-item:focus {
        background-color: var(--bg-hover);
        color: var(--text-primary);
      }

      .dropdown-item i {
        width: 1.25rem;
        opacity: 0.7;
      }

      .dropdown-header {
        color: var(--text-muted);
        font-size: 0.75rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        padding: 0.75rem 1rem 0.5rem 1rem;
      }

      .dropdown-header.text-danger {
        color: var(--accent-red) !important;
      }

      .dropdown-divider {
        border-color: var(--border-primary);
        margin: 0.5rem 0;
      }

      .dropdown-item.active {
        background-color: var(--status-info-bg);
        color: var(--accent-cyan);
      }

      .dropdown-item.text-danger {
        color: var(--accent-red);
      }

      .dropdown-item.text-danger i {
        color: var(--accent-red);
      }

      /* User dropdown toggle */
      .nav-link.dropdown-toggle {
        display: flex;
        align-items: center;
        padding: 0.5rem 1rem;
        border-radius: 0.5rem;
        transition: all 0.3s ease;
      }

      .nav-link.dropdown-toggle:hover {
        background-color: var(--bg-hover);
      }

      @media (max-width: 768px) {
        .sidebar {
          margin-left: -280px;
        }

        .sidebar-collapsed {
          margin-left: 0;
          width: 280px;
        }

        .sidebar-collapsed .nav-link-text,
        .sidebar-collapsed .sidebar-heading {
          display: block;
        }

        .main-content {
          margin-left: 0;
          width: 100%;
        }

        .main-content-expanded {
          margin-left: 0;
          width: 100%;
        }
      }
    </style>
  </head>

  <body>
    <!-- Top navigation -->
    <nav class="navbar navbar-expand navbar-dark bg-primary fixed-top">
      <div class="container-fluid">
        <a class="navbar-brand d-flex align-items-center" href="<%= advanced_mode_path %>">
          <i class="fas fa-envelope-open-text me-2"></i>
          AMOS Labs
        </a>
        <button class="btn btn-link text-light" id="sidebarToggle">
          <i class="fas fa-bars"></i>
        </button>
        
        <div class="ms-auto d-flex align-items-center gap-2">
          <!-- Mode Toggle Button -->
          <%= link_to chat_mode_path, class: "btn btn-sm btn-light" do %>
            <i data-lucide="message-circle" class="me-1" style="width: 16px; height: 16px; display: inline-block; vertical-align: middle;"></i> Chat Mode
          <% end %>
          
          <% if user_signed_in? %>
            <div class="dropdown">
              <a class="nav-link dropdown-toggle text-white" href="#" id="userDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                <i class="fas fa-user-circle fa-lg me-2"></i>
                <%= current_user.full_name %>
              </a>
              <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="userDropdown">
                <li><a class="dropdown-item" href="<%= user_path(current_user) %>"><i class="fas fa-id-card me-2"></i>My Profile</a></li>
                
                <% if current_user.admin? %>
                  <li><hr class="dropdown-divider"></li>
                  <li><h6 class="dropdown-header text-danger">Platform Admin</h6></li>
                  <li><a class="dropdown-item" href="/admin"><i class="fas fa-shield-alt me-2 text-danger"></i>Admin Portal</a></li>
                <% end %>
                
                <% if current_user.entity %>
                  <li><hr class="dropdown-divider"></li>
                  <li><h6 class="dropdown-header">Your Entity</h6></li>
                  <li>
                    <%= link_to current_user.entity.name, entities_path, class: "dropdown-item active" %>
                  </li>
                  <li><%= link_to "Edit Entity", edit_entity_path(current_user.entity), class: "dropdown-item" %></li>
                <% end %>
                
                <li><hr class="dropdown-divider"></li>
                <li>
                  <%= button_to "Sign Out", destroy_user_session_path, method: :delete, class: "dropdown-item" %>
                </li>
              </ul>
            </div>
          <% else %>
            <div class="d-flex">
              <%= link_to "Sign In", new_user_session_path, class: "btn btn-outline-light me-2" %>
              <%= link_to "Sign Up", new_user_registration_path, class: "btn btn-light" %>
            </div>
          <% end %>
        </div>
      </div>
    </nav>

    <!-- Sidebar navigation -->
    <div class="sidebar" id="sidebar">
      <ul class="nav flex-column">
        <!-- Dashboard -->
        <li class="nav-item2">
          <a class="sidebar-link <%= current_page?(advanced_mode_path) ? 'active' : '' %>" href="<%= advanced_mode_path %>">
            <i class="fas fa-tachometer-alt fa-fw me-2"></i>
            <span class="nav-link-text">Dashboard</span>
          </a>
        </li>
        
        <!-- Marketing Dropdown -->
        <li class="nav-item2">
          <a class="sidebar-toggle" data-bs-toggle="collapse" href="#marketingMenu" role="button" aria-expanded="false">
            <i class="fas fa-bullhorn fa-fw me-2"></i>
            <span class="nav-link-text">Marketing</span>
            <i class="fas fa-chevron-down ms-auto small"></i>
          </a>
          <div class="collapse" id="marketingMenu">
            <ul class="nav flex-column ms-3">
              <li class="nav-item2">
                <a class="sidebar-link small <%= current_page?(campaigns_path) ? 'active' : '' %>" href="<%= campaigns_path %>">
                  <i class="fas fa-envelope fa-fw me-2"></i>
                  <span class="nav-link-text">Campaigns</span>
                </a>
              </li>
              <li class="nav-item2">
                <a class="sidebar-link small <%= current_page?(landing_pages_path) ? 'active' : '' %>" href="<%= landing_pages_path %>">
                  <i class="fas fa-globe fa-fw me-2"></i>
                  <span class="nav-link-text">Landing Pages</span>
                </a>
              </li>
              <li class="nav-item2">
                <a class="sidebar-link small <%= current_page?(contacts_path) ? 'active' : '' %>" href="<%= contacts_path %>">
                  <i class="fas fa-address-book fa-fw me-2"></i>
                  <span class="nav-link-text">Contacts</span>
                </a>
              </li>
              <li class="nav-item2">
                <a class="sidebar-link small <%= current_page?(contact_groups_path) ? 'active' : '' %>" href="<%= contact_groups_path %>">
                  <i class="fas fa-folder fa-fw me-2"></i>
                  <span class="nav-link-text">Groups</span>
                </a>
              </li>
              <li class="nav-item2">
                <a class="sidebar-link small <%= current_page?(email_templates_path) ? 'active' : '' %>" href="<%= email_templates_path %>">
                  <i class="fas fa-file-alt fa-fw me-2"></i>
                  <span class="nav-link-text">Templates</span>
                </a>
              </li>
            </ul>
          </div>
        </li>
        
        <!-- Content -->
        <li class="nav-item2">
          <a class="sidebar-link <%= current_page?(image_assets_path) ? 'active' : '' %>" href="<%= image_assets_path %>">
            <i class="fas fa-images fa-fw me-2"></i>
            <span class="nav-link-text">Images</span>
          </a>
        </li>

        <li class="nav-item2">
          <a class="sidebar-link <%= current_page?(social_posts_path) ? 'active' : '' %>" href="<%= social_posts_path %>">
            <i class="fas fa-share-alt fa-fw me-2"></i>
            <span class="nav-link-text">Social Media</span>
          </a>
        </li>

        <!-- Affiliate Program -->
        <% if user_signed_in? %>
          <li class="nav-item2 mt-3">
            <div class="px-3 py-2">
              <small class="text-muted text-uppercase fw-bold">Earn Money</small>
            </div>
          </li>
          <li class="nav-item2">
            <% if current_user.affiliate.present? %>
              <a class="sidebar-link <%= request.path.start_with?('/affiliate') ? 'active' : '' %>" href="<%= affiliate_dashboard_path %>">
                <i class="fas fa-users fa-fw me-2"></i>
                <span class="nav-link-text">Affiliate Program</span>
              </a>
            <% else %>
              <a class="sidebar-link <%= request.path.start_with?('/affiliate') ? 'active' : '' %>" href="<%= affiliate_apply_path %>">
                <i class="fas fa-user-plus fa-fw me-2"></i>
                <span class="nav-link-text">Join Affiliates</span>
              </a>
            <% end %>
          </li>
        <% end %>
        
        <!-- Settings Dropdown -->
        <li class="nav-item2">
          <a class="sidebar-toggle" data-bs-toggle="collapse" href="#settingsMenu" role="button" aria-expanded="false">
            <i class="fas fa-cog fa-fw me-2"></i>
            <span class="nav-link-text">Settings</span>
            <i class="fas fa-chevron-down ms-auto small"></i>
          </a>
          <div class="collapse" id="settingsMenu">
            <ul class="nav flex-column ms-3">
              <li class="nav-item2">
                <a class="sidebar-link small <%= current_page?(social_media_accounts_path) ? 'active' : '' %>" href="<%= social_media_accounts_path %>">
                  <i class="fas fa-plug fa-fw me-2"></i>
                  <span class="nav-link-text">Integrations</span>
                </a>
              </li>
              <li class="nav-item2">
                <a class="sidebar-link small <%= current_page?(edit_business_profile_path) ? 'active' : '' %>" href="<%= edit_business_profile_path %>">
                  <i class="fas fa-building fa-fw me-2"></i>
                  <span class="nav-link-text">Business Profile</span>
                </a>
              </li>
              <li class="nav-item2">
                <a class="sidebar-link small <%= current_page?(entities_path) ? 'active' : '' %>" href="<%= entities_path %>">
                  <i class="fas fa-briefcase fa-fw me-2"></i>
                  <span class="nav-link-text">Entity Info</span>
                </a>
              </li>
            </ul>
          </div>
        </li>
        
        <% if current_user.entity_admin? %>
          <li class="nav-item2 mt-3">
            <div class="px-3 py-2">
              <small class="text-muted text-uppercase fw-bold">Management</small>
            </div>
          </li>
          <li class="nav-item2">
            <a class="sidebar-link <%= request.path.start_with?('/entity/users') ? 'active' : '' %>" href="<%= entity_users_path %>">
              <i class="fas fa-user-friends fa-fw me-2"></i>
              <span class="nav-link-text">Team Members</span>
            </a>
          </li>
          <li class="nav-item2">
            <a class="sidebar-link <%= request.path.start_with?('/entity/observability') ? 'active' : '' %>" href="<%= entity_observability_path %>">
              <i class="fas fa-chart-bar fa-fw me-2"></i>
              <span class="nav-link-text">Analytics</span>
            </a>
          </li>
          <li class="nav-item2">
            <a class="sidebar-link <%= request.path.start_with?('/entity/policies') ? 'active' : '' %>" href="<%= entity_policies_path %>">
              <i class="fas fa-shield-alt fa-fw me-2"></i>
              <span class="nav-link-text">AI Policies</span>
            </a>
          </li>
          <li class="nav-item2">
            <a class="sidebar-link <%= request.path.start_with?('/entity/privacy') ? 'active' : '' %>" href="<%= entity_privacy_path %>">
              <i class="fas fa-user-shield fa-fw me-2"></i>
              <span class="nav-link-text">Privacy Controls</span>
            </a>
          </li>
        <% end %>

        <!-- Theme Toggle -->
        <li class="nav-item2 mt-3">
          <div class="px-3 py-2">
            <small class="text-muted text-uppercase fw-bold">Appearance</small>
          </div>
        </li>
        <li class="nav-item2">
          <button data-theme-toggle class="sidebar-link w-100 text-start border-0" style="background: transparent;">
            <i data-theme-icon data-lucide="moon" class="fa-fw me-2"></i>
            <span class="nav-link-text">Theme</span>
          </button>
        </li>

      </ul>
    </div>

    <!-- Flash messages - outside main-content to avoid layout issues -->
    <% if notice %>
      <div style="position: fixed; top: 70px; left: 50%; transform: translateX(-50%); z-index: 1050; max-width: 600px; width: 90%;">
        <div class="alert alert-success alert-dismissible fade show shadow" role="alert">
          <i class="fas fa-check-circle me-2"></i>
          <%= notice %>
          <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
      </div>
    <% end %>
    
    <% if alert %>
      <div style="position: fixed; top: 70px; left: 50%; transform: translateX(-50%); z-index: 1050; max-width: 600px; width: 90%;">
        <div class="alert alert-danger alert-dismissible fade show shadow" role="alert">
          <i class="fas fa-exclamation-circle me-2"></i>
          <%= alert %>
          <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
      </div>
    <% end %>

    <!-- Main content area -->
    <div class="main-content" id="mainContent">
      <%= yield %>
    </div>

    <script>
      document.addEventListener('DOMContentLoaded', function() {
        const sidebar = document.getElementById('sidebar');
        const mainContent = document.getElementById('mainContent');
        const sidebarToggle = document.getElementById('sidebarToggle');
        
        // Check if sidebar state is saved in localStorage
        const sidebarCollapsed = localStorage.getItem('sidebarCollapsed') === 'true';
        
        // Initialize sidebar state
        if (sidebarCollapsed) {
          sidebar.classList.add('sidebar-collapsed');
          mainContent.classList.add('main-content-expanded');
        }
        
        // Toggle sidebar on button click
        sidebarToggle.addEventListener('click', function() {
          sidebar.classList.toggle('sidebar-collapsed');
          mainContent.classList.toggle('main-content-expanded');
          
          // Save sidebar state to localStorage
          localStorage.setItem('sidebarCollapsed', sidebar.classList.contains('sidebar-collapsed'));
        });
      });
    </script>

    <% if Rails.env.development? %>
      <script>
        // Debug mode toggle for development
        document.addEventListener('DOMContentLoaded', () => {
          const debugButton = document.createElement('button');
          debugButton.textContent = "Debug";
          debugButton.classList.add('btn', 'btn-sm', 'btn-info', 'position-fixed');
          debugButton.style.bottom = '10px';
          debugButton.style.right = '10px';
          debugButton.style.zIndex = '9999';
          
          debugButton.addEventListener('click', () => {
            const debugInfos = document.querySelectorAll('#debug-info');
            debugInfos.forEach(info => {
              info.parentElement.classList.toggle('d-none');
            });
            
            // Log active controllers info
            console.log("Debug button clicked");
            
            // Display all controllers and their elements
            console.log("🔍 Looking for Stimulus controller data");
            document.querySelectorAll('[data-controller]').forEach(el => {
              console.log(`Found element with controller: ${el.dataset.controller}`, el);
            });
            
            // Test form event listeners
            const searchInput = document.getElementById('contact-search-input');
            if (searchInput) {
              console.log("📝 Testing search input:", searchInput);
              searchInput.dispatchEvent(new Event('input', { bubbles: true }));
            }
            
            // Log all event listeners (requires opening devtools)
            console.log("👉 Open Chrome DevTools Elements panel and select an element to see its event listeners");
          });
          
          document.body.appendChild(debugButton);
        });
      </script>
    <% end %>
  </body>
</html>
