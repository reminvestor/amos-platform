<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "AMOS Labs" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="icon" href="/favicon.ico">

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <!-- Lucide Icons -->
    <script src="https://unpkg.com/lucide@latest"></script>

    <!-- SECURITY: Clear user-specific localStorage on logout (available globally) -->
    <script>
      window.clearScoutLocalStorage = function() {
        try {
          var keysToRemove = [];
          for (var i = 0; i < localStorage.length; i++) {
            var key = localStorage.key(i);
            if (key && (key.startsWith('scout_') || key.startsWith('amos_') || key.startsWith('hub_'))) {
              keysToRemove.push(key);
            }
          }
          keysToRemove.forEach(function(key) { localStorage.removeItem(key); });
          console.log('🗑️ Cleared ' + keysToRemove.length + ' scout localStorage items');
        } catch (e) {
          console.warn('Could not clear localStorage:', e);
        }
      };
    </script>

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_include_tag "application", "data-turbo-track": "reload", type: "module" %>
    
    <style>
      body {
        padding-top: 56px;
        display: flex;
        min-height: 100vh;
        background-color: var(--bg-primary);
        color: var(--text-primary);
        transition: background-color 0.3s ease, color 0.3s ease;
      }

      /* Theme-aware Navbar */
      .navbar.bg-primary {
        background-color: var(--bg-card) !important;
        border-bottom: 1px solid var(--border-primary);
        transition: background-color 0.3s ease, border-color 0.3s ease;
      }

      /* Theme-aware Sidebar */
      .sidebar {
        width: 280px;
        position: fixed;
        top: 56px;
        bottom: 0;
        left: 0;
        z-index: 100;
        padding: 0;
        background-color: var(--bg-secondary);
        border-right: 1px solid var(--border-primary);
        transition: all 0.3s ease;
        overflow-y: auto;
      }

      .sidebar-collapsed {
        width: 60px;
        overflow-x: hidden;
      }
      
      .sidebar-collapsed .sidebar-link,
      .sidebar-collapsed .sidebar-toggle {
        white-space: nowrap;
        overflow: hidden;
      }

      .sidebar-header {
        padding: 1rem;
        background-color: var(--bg-card);
      }

      .sidebar .sidebar-link {
        display: flex;
        align-items: center;
        padding: 0.75rem 1rem;
        color: var(--text-secondary);
        font-weight: 500;
        border-left: 3px solid transparent;
        text-decoration: none;
        transition: all 0.3s ease;
      }

      .sidebar .sidebar-link.active {
        color: var(--accent-cyan);
        border-left: 3px solid var(--accent-cyan);
        background-color: var(--status-info-bg);
        font-weight: 600;
      }

      .sidebar .sidebar-link:hover {
        color: var(--text-primary);
        background-color: var(--bg-hover);
      }

      .sidebar .sidebar-link.small {
        padding: 0.5rem 1rem 0.5rem 2.5rem;
        color: var(--text-secondary);
        font-weight: 400;
        font-size: 0.875rem;
      }

      .sidebar .sidebar-toggle {
        display: flex;
        align-items: center;
        padding: 0.75rem 1rem;
        color: var(--text-secondary);
        font-weight: 500;
        cursor: pointer;
        text-decoration: none;
        transition: all 0.3s ease;
      }

      .sidebar .sidebar-toggle:hover {
        color: var(--text-primary);
        background-color: var(--bg-hover);
      }

      /* Section headers in sidebar */
      .sidebar .px-3 {
        padding-left: 1rem !important;
        padding-right: 1rem !important;
      }

      .sidebar .text-muted {
        color: var(--text-muted) !important;
        font-size: 0.75rem;
        letter-spacing: 0.05em;
      }

      .sidebar-collapsed .nav-link-text,
      .sidebar-collapsed .sidebar-heading {
        display: none;
      }

      .main-content {
        margin-left: 280px;
        width: calc(100% - 280px);
        padding: 1.5rem;
        transition: all 0.3s ease;
        background-color: var(--bg-primary);
        min-height: calc(100vh - 56px);
      }

      .main-content-expanded {
        margin-left: 60px;
        width: calc(100% - 60px);
      }

      /* Theme-aware Flash messages / Toast notifications */
      .flash-message-container {
        position: fixed;
        top: 80px;
        right: 1.5rem;
        z-index: 999999; /* Ensure flash messages appear above everything including admin sidebar */
        max-width: 400px;
        animation: slideInRight 0.3s ease-out;
      }

      @keyframes slideInRight {
        from {
          transform: translateX(100%);
          opacity: 0;
        }
        to {
          transform: translateX(0);
          opacity: 1;
        }
      }

      @keyframes slideOutRight {
        from {
          transform: translateX(0);
          opacity: 1;
        }
        to {
          transform: translateX(100%);
          opacity: 0;
        }
      }

      .flash-message-container.dismissing {
        animation: slideOutRight 0.3s ease-in forwards;
      }

      .alert-success {
        background-color: var(--status-success-bg);
        border-color: var(--status-success-border);
        color: var(--status-success-text);
      }

      .alert-danger {
        background-color: var(--status-error-bg);
        border-color: var(--status-error-border);
        color: var(--status-error-text);
      }

      /* Theme-aware User Dropdown */
      .dropdown-menu {
        background-color: var(--bg-card);
        border: 1px solid var(--border-primary);
        box-shadow: var(--shadow-lg);
        padding: 0.5rem 0;
        min-width: 280px;
        transition: all 0.3s ease;
      }

      .dropdown-item {
        color: var(--text-secondary);
        padding: 0.625rem 1rem;
        transition: all 0.3s ease;
        display: flex;
        align-items: center;
      }

      .dropdown-item:hover,
      .dropdown-item:focus {
        background-color: var(--bg-hover);
        color: var(--text-primary);
      }

      .dropdown-item i {
        width: 1.25rem;
        opacity: 0.7;
      }

      .dropdown-header {
        color: var(--text-muted);
        font-size: 0.75rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        padding: 0.75rem 1rem 0.5rem 1rem;
      }

      .dropdown-header.text-danger {
        color: var(--accent-red) !important;
      }

      .dropdown-divider {
        border-color: var(--border-primary);
        margin: 0.5rem 0;
      }

      .dropdown-item.active {
        background-color: var(--status-info-bg);
        color: var(--accent-cyan);
      }

      .dropdown-item.text-danger {
        color: var(--accent-red);
      }

      .dropdown-item.text-danger i {
        color: var(--accent-red);
      }

      /* User dropdown toggle */
      .nav-link.dropdown-toggle {
        display: flex;
        align-items: center;
        padding: 0.5rem 1rem;
        border-radius: 0.5rem;
        transition: all 0.3s ease;
      }

      .nav-link.dropdown-toggle:hover {
        background-color: var(--bg-hover);
      }

      @media (max-width: 768px) {
        .sidebar {
          margin-left: -280px;
        }

        .sidebar-collapsed {
          margin-left: 0;
          width: 280px;
        }

        .sidebar-collapsed .nav-link-text,
        .sidebar-collapsed .sidebar-heading {
          display: block;
        }

        .main-content {
          margin-left: 0;
          width: 100%;
        }

        .main-content-expanded {
          margin-left: 0;
          width: 100%;
        }
      }
    </style>
