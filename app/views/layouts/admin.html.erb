<!DOCTYPE html>
<html>
  <head>
    <title>Admin Portal - AMOS Labs</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <!-- Apply theme immediately to prevent flash -->
    <script>
      (function() {
        var theme = localStorage.getItem('amos_theme_preference');
        if (!theme) {
          theme = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        }
        document.documentElement.setAttribute('data-theme', theme);
      })();
    </script>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_include_tag "application", "data-turbo-track": "reload", type: "module" %>

    <!-- Lucide Icons -->
    <script src="https://unpkg.com/lucide@latest"></script>

    <!-- SECURITY: Clear user-specific localStorage on logout (available globally) -->
    <script>
      window.clearScoutLocalStorage = function() {
        try {
          var keysToRemove = [];
          for (var i = 0; i < localStorage.length; i++) {
            var key = localStorage.key(i);
            if (key && (key.startsWith('scout_') || key.startsWith('amos_') || key.startsWith('hub_'))) {
              keysToRemove.push(key);
            }
          }
          keysToRemove.forEach(function(key) { localStorage.removeItem(key); });
          console.log('🗑️ Cleared ' + keysToRemove.length + ' scout localStorage items');
        } catch (e) {
          console.warn('Could not clear localStorage:', e);
        }
      };
    </script>
  </head>

  <body class="admin-layout">
    <% if @current_admin %>
      <%# Left Sidebar Navigation %>
      <aside class="admin-sidebar" id="adminSidebar">
        <%# Logo with Hamburger %>
        <div class="sidebar-logo">
          <div class="logo-icon" style="background: linear-gradient(135deg, #7C3AED, #A78BFA); border-radius: 8px; padding: 6px; display: flex; align-items: center; justify-content: center;">
            <%= image_tag "Logo_mark.png", style: "height: 2rem; width: auto;", alt: "AMOS" %>
          </div>
          <span class="logo-text">Admin</span>
          <button class="hamburger-toggle" id="sidebarToggle" aria-label="Toggle sidebar">
            <i data-lucide="menu"></i>
          </button>
        </div>

        <%# Main Navigation - Categorized with Dropdowns %>
        <nav>
          <%= link_to admin_dashboard_path, class: "nav-item #{'active' if current_page?(admin_dashboard_path)}" do %>
            <i data-lucide="layout-dashboard"></i>
            <span>Dashboard</span>
          <% end %>

          <%= link_to admin_services_path, class: "nav-item #{'active' if current_page?(admin_services_path)}" do %>
            <i data-lucide="activity"></i>
            <span>Services Health</span>
          <% end %>

          <%# AI & Agents Category %>
          <div class="nav-group #{'active' if request.path.start_with?('/admin/agent') || request.path.start_with?('/admin/living_platform') || request.path.start_with?('/admin/context_graph') || request.path.start_with?('/admin/ai_rulesets')}">
            <div class="nav-item nav-group-header" style="cursor: pointer;">
              <i data-lucide="brain"></i>
              <span>AI & Agents</span>
              <i data-lucide="chevron-down" class="chevron-icon"></i>
            </div>
            <div class="nav-submenu">
              <%= link_to admin_agent_plugins_path, class: "nav-subitem #{'active' if controller_name == 'agent_plugins'}" do %>
                <span>Agent Plugins</span>
              <% end %>
              <%= link_to dashboard_admin_agent_collaboration_index_path, class: "nav-subitem #{'active' if request.path.start_with?('/admin/agent_collaboration')}" do %>
                <span>Collaboration</span>
              <% end %>
              <%= link_to admin_agent_lightning_path, class: "nav-subitem deprecated #{'active' if controller_name == 'agent_lightning'}", title: "Deprecated - Use Operations Dashboard instead" do %>
                <span>Agent Lightning</span>
                <span class="badge bg-warning text-dark" style="font-size: 0.6rem; margin-left: 4px;">DEPRECATED</span>
              <% end %>
              <%= link_to admin_living_platform_index_path, class: "nav-subitem #{'active' if controller_name == 'living_platform'}" do %>
                <span>Living Platform</span>
              <% end %>
              <%= link_to admin_context_graph_path, class: "nav-subitem #{'active' if controller_name == 'context_graph'}" do %>
                <span>Context Graph</span>
              <% end %>
              <%= link_to admin_platform_evolution_path, class: "nav-subitem #{'active' if controller_name == 'platform_evolution'}" do %>
                <span>Evolution Engine</span>
              <% end %>
              <%= link_to admin_tools_path, class: "nav-subitem #{'active' if controller_name == 'tools'}" do %>
                <span>Tools</span>
              <% end %>
              <%= link_to admin_ai_rulesets_path, class: "nav-subitem #{'active' if controller_name == 'ai_rulesets'}" do %>
                <span>AI Rulesets</span>
              <% end %>
            </div>
          </div>

          <%# Operations Category %>
          <div class="nav-group #{'active' if request.path.start_with?('/admin/scheduled') || request.path.start_with?('/admin/parallel') || request.path.start_with?('/admin/pipeline')}">
            <div class="nav-item nav-group-header" style="cursor: pointer;">
              <i data-lucide="settings"></i>
              <span>Operations</span>
              <i data-lucide="chevron-down" class="chevron-icon"></i>
            </div>
            <div class="nav-submenu">
              <%= link_to admin_scheduled_tasks_path, class: "nav-subitem #{'active' if controller_name == 'scheduled_tasks'}" do %>
                <span>Scheduled Tasks</span>
              <% end %>
              <%= link_to admin_parallel_tasks_path, class: "nav-subitem #{'active' if controller_name == 'parallel_tasks'}" do %>
                <span>Parallel Tasks</span>
              <% end %>
              <%= link_to admin_pipeline_connections_path, class: "nav-subitem #{'active' if request.path.start_with?('/admin/pipeline')}" do %>
                <span>AI Pipeline</span>
              <% end %>
            </div>
          </div>

          <%# Observability Category %>
          <div class="nav-group #{'active' if request.path.start_with?('/admin/observability') || request.path.start_with?('/admin/benchmarks')}">
            <div class="nav-item nav-group-header" style="cursor: pointer;">
              <i data-lucide="bar-chart-3"></i>
              <span>Observability</span>
              <i data-lucide="chevron-down" class="chevron-icon"></i>
            </div>
            <div class="nav-submenu">
              <%= link_to admin_observability_ai_usage_path, class: "nav-subitem #{'active' if current_page?(admin_observability_ai_usage_path)}" do %>
                <span>AI Usage</span>
              <% end %>
              <%= link_to admin_observability_workflows_path, class: "nav-subitem #{'active' if current_page?(admin_observability_workflows_path)}" do %>
                <span>Workflows</span>
              <% end %>
              <%= link_to admin_observability_performance_path, class: "nav-subitem #{'active' if current_page?(admin_observability_performance_path)}" do %>
                <span>Performance</span>
              <% end %>
              <%= link_to admin_observability_errors_path, class: "nav-subitem #{'active' if current_page?(admin_observability_errors_path)}" do %>
                <span>Errors</span>
              <% end %>
              <%= link_to admin_benchmarks_path, class: "nav-subitem #{'active' if controller_name == 'benchmarks'}" do %>
                <span>Benchmarks</span>
              <% end %>
            </div>
          </div>

          <%# System Category %>
          <div class="nav-group #{'active' if controller_name.in?(%w[integrations connections users billing])}">
            <div class="nav-item nav-group-header" style="cursor: pointer;">
              <i data-lucide="cog"></i>
              <span>System</span>
              <i data-lucide="chevron-down" class="chevron-icon"></i>
            </div>
            <div class="nav-submenu">
              <%= link_to admin_users_path, class: "nav-subitem #{'active' if controller_name == 'users'}" do %>
                <span>Users</span>
              <% end %>
              <%= link_to admin_integrations_path, class: "nav-subitem #{'active' if controller_name == 'integrations'}" do %>
                <span>Integrations</span>
              <% end %>
              <%= link_to admin_connections_path, class: "nav-subitem #{'active' if controller_name == 'connections'}" do %>
                <span>Connections</span>
              <% end %>
              <%= link_to admin_billing_index_path, class: "nav-subitem #{'active' if controller_name == 'billing'}" do %>
                <span>Billing & Tokens</span>
              <% end %>
            </div>
          </div>
        </nav>

        <%# Bottom Actions %>
        <div class="sidebar-bottom">
          <button data-theme-toggle class="nav-item w-100 text-start border-0 bg-transparent" aria-label="Toggle light/dark theme">
            <i data-theme-icon data-lucide="moon" aria-hidden="true"></i>
            <span>Theme</span>
          </button>

          <%= link_to chat_mode_path, class: "nav-item" do %>
            <i data-lucide="home"></i>
            <span>Return to App</span>
          <% end %>

          <%= button_to admin_destroy_session_path, method: :delete, class: "nav-item", form: { data: { turbo: false }, onclick: "window.clearScoutLocalStorage && window.clearScoutLocalStorage()" } do %>
            <i data-lucide="log-out"></i>
            <span>Sign Out</span>
          <% end %>
        </div>
      </aside>

      <%# Flash Messages / Toast Notifications %>
      <% if notice.present? %>
        <div class="admin-toast-container" data-auto-dismiss="true">
          <div class="admin-alert admin-alert-success" style="margin-bottom: 1rem; box-shadow: 0 10px 25px rgba(0, 0, 0, 0.3);">
            <div class="alert-content">
              <i data-lucide="check-circle"></i>
              <span><%= notice %></span>
            </div>
            <button class="alert-close" data-dismiss-alert>×</button>
          </div>
        </div>
      <% end %>
      <% if alert.present? %>
        <div class="admin-toast-container" data-auto-dismiss="true">
          <div class="admin-alert admin-alert-error" style="margin-bottom: 1rem; box-shadow: 0 10px 25px rgba(0, 0, 0, 0.3);">
            <div class="alert-content">
              <i data-lucide="alert-circle"></i>
              <span><%= alert %></span>
            </div>
            <button class="alert-close" data-dismiss-alert>×</button>
          </div>
        </div>
      <% end %>

      <%# Main Content Area %>
      <div class="admin-content">
        <%= yield %>
      </div>

    <% else %>
      <!-- Login page content -->
      <%= yield %>
    <% end %>

    <!-- Initialize Lucide Icons -->
    <script>
      document.addEventListener('DOMContentLoaded', () => {
        lucide.createIcons();
        initSidebarToggle();
        initNavGroups();
        initToastNotifications();
        initThemeToggle();
      });

      document.addEventListener('turbo:load', () => {
        lucide.createIcons();
        initSidebarToggle();
        initNavGroups();
        initToastNotifications();
        initThemeToggle();
      });

      function initToastNotifications() {
        // Auto-dismiss toasts after 5 seconds
        const toastContainers = document.querySelectorAll('.admin-toast-container[data-auto-dismiss="true"]');
        toastContainers.forEach(container => {
          setTimeout(() => {
            container.style.animation = 'slideOutRight 0.3s ease-in forwards';
            setTimeout(() => {
              container.remove();
            }, 300);
          }, 5000);
        });

        // Manual dismiss buttons
        document.querySelectorAll('[data-dismiss-alert]').forEach(button => {
          button.addEventListener('click', (e) => {
            const container = e.target.closest('.admin-toast-container');
            if (container) {
              container.style.animation = 'slideOutRight 0.3s ease-in forwards';
              setTimeout(() => {
                container.remove();
              }, 300);
            }
          });
        });
      }

      function initSidebarToggle() {
        const sidebar = document.getElementById('adminSidebar');
        const toggle = document.getElementById('sidebarToggle');

        if (!sidebar || !toggle) return;

        // Check saved state
        const isCollapsed = localStorage.getItem('adminSidebarCollapsed') === 'true';
        if (isCollapsed) {
          sidebar.classList.add('collapsed');
        }

        // Toggle on click
        toggle.addEventListener('click', () => {
          sidebar.classList.toggle('collapsed');
          localStorage.setItem('adminSidebarCollapsed', sidebar.classList.contains('collapsed'));

          // Re-initialize icons after DOM changes
          setTimeout(() => lucide.createIcons(), 100);
        });
      }

      function initNavGroups() {
        // Handle nav group dropdowns
        document.querySelectorAll('.nav-group-header').forEach(header => {
          // Remove any existing listeners by cloning
          const newHeader = header.cloneNode(true);
          header.parentNode.replaceChild(newHeader, header);

          newHeader.addEventListener('click', (e) => {
            e.preventDefault();
            e.stopPropagation();

            const navGroup = newHeader.parentElement;
            const groupName = newHeader.querySelector('span')?.textContent?.trim() || 'unknown';

            navGroup.classList.toggle('expanded');

            // Save expanded state to localStorage
            const isExpanded = navGroup.classList.contains('expanded');
            localStorage.setItem(`navGroup_${groupName}_expanded`, isExpanded);

            console.log('Nav group toggled:', groupName, isExpanded);

            // Re-initialize icons after DOM changes
            setTimeout(() => {
              if (typeof lucide !== 'undefined') {
                lucide.createIcons();
              }
            }, 100);
          });
        });

        // Restore expanded state from localStorage or auto-expand active groups
        document.querySelectorAll('.nav-group').forEach(group => {
          const header = group.querySelector('.nav-group-header');
          const groupName = header?.querySelector('span')?.textContent?.trim() || 'unknown';
          const savedState = localStorage.getItem(`navGroup_${groupName}_expanded`);

          // If we have a saved state, use it; otherwise expand if active
          if (savedState !== null) {
            if (savedState === 'true') {
              group.classList.add('expanded');
            }
          } else if (group.classList.contains('active')) {
            group.classList.add('expanded');
            localStorage.setItem(`navGroup_${groupName}_expanded`, 'true');
          }
        });
      }

      function initThemeToggle() {
        const currentTheme = document.documentElement.getAttribute('data-theme') ||
                           localStorage.getItem('amos_theme_preference') ||
                           (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');

        // Apply theme if not already set
        if (!document.documentElement.getAttribute('data-theme')) {
          document.documentElement.setAttribute('data-theme', currentTheme);
        }

        // Update theme toggle icon
        const themeIcon = document.querySelector('[data-theme-icon]');
        if (themeIcon) {
          themeIcon.setAttribute('data-lucide', currentTheme === 'dark' ? 'sun' : 'moon');
          if (typeof lucide !== 'undefined') {
            lucide.createIcons();
          }
        }

        // Add click handler for theme toggle
        const themeToggle = document.querySelector('[data-theme-toggle]');
        if (themeToggle && !themeToggle.hasAttribute('data-theme-initialized')) {
          themeToggle.setAttribute('data-theme-initialized', 'true');
          themeToggle.addEventListener('click', function() {
            const current = document.documentElement.getAttribute('data-theme') || 'light';
            const newTheme = current === 'light' ? 'dark' : 'light';
            document.documentElement.setAttribute('data-theme', newTheme);
            localStorage.setItem('amos_theme_preference', newTheme);

            // Update icon
            const icon = document.querySelector('[data-theme-icon]');
            if (icon) {
              icon.setAttribute('data-lucide', newTheme === 'dark' ? 'sun' : 'moon');
              if (typeof lucide !== 'undefined') {
                lucide.createIcons();
              }
            }
          });
        }
      }
    </script>
  </body>
</html>
