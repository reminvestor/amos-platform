<!DOCTYPE html>
<html>
  <head>
    <title>Admin Portal - AMOS Labs</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <link rel="stylesheet" href="/assets/admin_dark.css" data-turbo-track="reload">
    <%= javascript_include_tag "application", "data-turbo-track": "reload", type: "module" %>

    <!-- Lucide Icons -->
    <script src="https://unpkg.com/lucide@latest"></script>
  </head>

  <body class="admin-dark">
    <% if @current_admin %>
      <%# Left Sidebar Navigation %>
      <aside class="admin-sidebar" id="adminSidebar">
        <%# Logo with Hamburger %>
        <div class="sidebar-logo">
          <div class="logo-icon">
            <i data-lucide="box" class="icon-xl"></i>
          </div>
          <span class="logo-text">AMOS Admin</span>
          <button class="hamburger-toggle" id="sidebarToggle" aria-label="Toggle sidebar">
            <i data-lucide="menu"></i>
          </button>
        </div>

        <%# Main Navigation %>
        <nav>
          <%= link_to admin_dashboard_path, class: "nav-item #{'active' if current_page?(admin_dashboard_path)}" do %>
            <i data-lucide="layout-dashboard"></i>
            <span>Dashboard</span>
          <% end %>

          <%= link_to admin_services_path, class: "nav-item #{'active' if current_page?(admin_services_path)}" do %>
            <i data-lucide="activity"></i>
            <span>Services Health</span>
          <% end %>

          <%= link_to admin_users_path, class: "nav-item #{'active' if controller_name == 'users'}" do %>
            <i data-lucide="users"></i>
            <span>Users</span>
          <% end %>

          <%= link_to admin_integrations_path, class: "nav-item #{'active' if controller_name == 'integrations'}" do %>
            <i data-lucide="plug"></i>
            <span>Integrations</span>
          <% end %>

          <%= link_to admin_connections_path, class: "nav-item #{'active' if controller_name == 'connections'}" do %>
            <i data-lucide="link"></i>
            <span>Connections</span>
          <% end %>

          <%= link_to admin_pipeline_connections_path, class: "nav-item #{'active' if request.path.start_with?('/admin/pipeline')}" do %>
            <i data-lucide="git-branch"></i>
            <span>AI Pipeline</span>
          <% end %>

          <%= link_to admin_parallel_tasks_path, class: "nav-item #{'active' if controller_name == 'parallel_tasks'}" do %>
            <i data-lucide="layers"></i>
            <span>Parallel Tasks</span>
          <% end %>

          <%= link_to admin_observability_ai_usage_path, class: "nav-item #{'active' if request.path.start_with?('/admin/observability')}" do %>
            <i data-lucide="bar-chart-3"></i>
            <span>Observability</span>
          <% end %>
        </nav>

        <%# Bottom Actions %>
        <div class="sidebar-bottom">
          <button data-theme-toggle class="nav-item w-100 text-start border-0 bg-transparent" aria-label="Toggle light/dark theme">
            <i data-theme-icon data-lucide="moon" aria-hidden="true"></i>
            <span>Theme</span>
          </button>

          <%= link_to chat_mode_path, class: "nav-item" do %>
            <i data-lucide="home"></i>
            <span>Return to App</span>
          <% end %>

          <%= button_to admin_destroy_session_path, method: :delete, class: "nav-item", form: { data: { turbo: false } } do %>
            <i data-lucide="log-out"></i>
            <span>Sign Out</span>
          <% end %>
        </div>
      </aside>

      <%# Main Content Area %>
      <%= yield %>

    <% else %>
      <!-- Login page content -->
      <%= yield %>
    <% end %>

    <!-- Initialize Lucide Icons -->
    <script>
      document.addEventListener('DOMContentLoaded', () => {
        lucide.createIcons();
        initSidebarToggle();
      });

      document.addEventListener('turbo:load', () => {
        lucide.createIcons();
        initSidebarToggle();
      });

      function initSidebarToggle() {
        const sidebar = document.getElementById('adminSidebar');
        const toggle = document.getElementById('sidebarToggle');

        if (!sidebar || !toggle) return;

        // Check saved state
        const isCollapsed = localStorage.getItem('adminSidebarCollapsed') === 'true';
        if (isCollapsed) {
          sidebar.classList.add('collapsed');
        }

        // Toggle on click
        toggle.addEventListener('click', () => {
          sidebar.classList.toggle('collapsed');
          localStorage.setItem('adminSidebarCollapsed', sidebar.classList.contains('collapsed'));

          // Re-initialize icons after DOM changes
          setTimeout(() => lucide.createIcons(), 100);
        });
      }
    </script>
  </body>
</html>
