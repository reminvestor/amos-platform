<!DOCTYPE html>
<html>
  <head>
    <title>Preview: <%= @landing_page.title %></title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <!-- Consolidated Bootstrap & Google Fonts -->
    <%= render 'landing_pages/head_libs' %>
    
    <style>
      :root {
        --primary-color: <%= @landing_page.primary_color || '#0d6efd' %>;
        --secondary-color: <%= @landing_page.secondary_color || '#6c757d' %>;
        --font-family: <%= @landing_page.font_family || 'Arial, sans-serif' %>;
      }
      
      body {
        font-family: var(--font-family);
        line-height: 1.6;
        color: #333;
        overflow-x: hidden;
        margin: 0;
        padding: 0;
      }
      
      .btn-primary {
        background-color: var(--primary-color);
        border-color: var(--primary-color);
      }
      
      .btn-primary:hover {
        background-color: var(--primary-color);
        filter: brightness(90%);
        border-color: var(--primary-color);
      }
      
      .text-primary {
        color: var(--primary-color) !important;
      }
      
      .bg-primary {
        background-color: var(--primary-color) !important;
      }
      
      .border-primary {
        border-color: var(--primary-color) !important;
      }
      
      .text-secondary {
        color: var(--secondary-color) !important;
      }
      
      .hero-section {
        background-size: cover;
        background-position: center;
        min-height: 500px;
        display: flex;
        align-items: center;
      }
      
      .feature-card {
        height: 100%;
        transition: transform 0.3s;
        border: 1px solid #eee;
      }
      
      .feature-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 10px 20px rgba(0,0,0,0.1);
      }
      
      .testimonial {
        border-left: 4px solid var(--primary-color);
      }
      
      .cta-section {
        background-color: var(--primary-color);
        color: white;
      }
      
      .cta-btn {
        background-color: white;
        color: var(--primary-color);
        font-weight: bold;
        padding: 12px 30px;
        border-radius: 30px;
        font-size: 1.1rem;
        transition: all 0.3s;
      }
      
      .cta-btn:hover {
        transform: scale(1.05);
        box-shadow: 0 5px 15px rgba(0,0,0,0.1);
      }
    </style>
  </head>

  <body>
    <div id="preview-container" class="w-100 mx-auto">
      <!-- Hero Section -->
      <section class="hero-section" style="background-image: linear-gradient(rgba(0,0,0,0.5), rgba(0,0,0,0.5)), url('<%= @landing_page.hero_image_url %>');">
        <div class="container">
          <div class="row">
            <div class="col-md-8">
              <div class="bg-white p-4 p-md-5 rounded shadow-lg">
                <h1 class="fw-bold mb-3"><%= @landing_page.headline %></h1>
                <p class="lead mb-4"><%= @landing_page.subheadline %></p>
                <a href="#" class="btn btn-primary btn-lg px-4 py-2 fw-bold">
                  <%= @landing_page.cta_text %>
                </a>
              </div>
            </div>
          </div>
        </div>
      </section>
      
      <!-- Content Sections -->
      <% if @landing_page.content.present? %>
        <% @landing_page.content.each_with_index do |section, index| %>
          <section class="py-5 <%= index.odd? ? 'bg-light' : '' %>">
            <div class="container">
              <% if section['title'].present? %>
                <h2 class="text-center mb-4"><%= section['title'] %></h2>
              <% end %>
              
              <% case section['type'] %>
              <% when 'feature' %>
                <div class="row row-cols-1 row-cols-md-3 g-4">
                  <div class="col">
                    <div class="card h-100 feature-card">
                      <div class="card-body text-center">
                        <i data-lucide="check-circle" class="icon-3x text-primary mb-3"></i>
                        <div><%=
                          if section['content'].is_a?(String)
                            section['content'].html_safe
                          else
                            section['content'].to_s
                          end
                        %></div>
                      </div>
                    </div>
                  </div>
                </div>
              <% when 'testimonial' %>
                <div class="row justify-content-center">
                  <div class="col-md-8">
                    <div class="p-4 bg-white shadow rounded testimonial">
                      <%= 
                        if section['content'].is_a?(String)
                          section['content'].html_safe
                        else
                          section['content'].to_s
                        end
                      %>
                    </div>
                  </div>
                </div>
              <% when 'pricing' %>
                <div class="row row-cols-1 row-cols-md-3 g-4">
                  <div class="col">
                    <div class="card h-100 shadow">
                      <div class="card-body">
                        <%= 
                          if section['content'].is_a?(String)
                            section['content'].html_safe
                          else
                            section['content'].to_s
                          end
                        %>
                      </div>
                    </div>
                  </div>
                </div>
              <% when 'faq' %>
                <div class="row justify-content-center">
                  <div class="col-md-8">
                    <div class="accordion" id="faqAccordion">
                      <%= 
                        if section['content'].is_a?(String)
                          section['content'].html_safe
                        else
                          section['content'].to_s
                        end
                      %>
                    </div>
                  </div>
                </div>
              <% else %>
                <div class="row justify-content-center">
                  <div class="col-md-8">
                    <%= 
                      if section['content'].is_a?(String)
                        section['content'].html_safe
                      else
                        section['content'].to_s
                      end
                    %>
                  </div>
                </div>
              <% end %>
            </div>
          </section>
        <% end %>
      <% end %>
      
      <!-- CTA Section -->
      <section class="cta-section py-5">
        <div class="container text-center py-4">
          <h2 class="fw-bold mb-3"><%= @landing_page.headline %></h2>
          <p class="lead mb-4"><%= @landing_page.subheadline %></p>
          <a href="#" class="btn cta-btn">
            <%= @landing_page.cta_text %>
          </a>
        </div>
      </section>
      
      <!-- Footer -->
      <footer class="bg-dark text-white py-4">
        <div class="container">
          <div class="row">
            <div class="col-md-6">
              <p>&copy; <%= Date.current.year %> <%= @landing_page.entity.name %> | All Rights Reserved</p>
            </div>
            <div class="col-md-6 text-md-end">
              <p>
                <small>Created with Agent Marketing</small>
              </p>
            </div>
          </div>
        </div>
      </footer>
    </div>

    <!-- Consolidated Bootstrap JS -->
    <%= render 'landing_pages/bootstrap_js' %>
  </body>
</html> 