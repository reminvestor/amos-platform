<%# Scout/Amos Chat Mode Sidebar - Space Aware %>
<nav class="side-nav collapsed" data-scout-target="sideNav">
  <div class="side-nav-header">
    <div class="brand" style="background: linear-gradient(135deg, #7C3AED, #A78BFA); border-radius: 8px; padding: 6px; display: flex; align-items: center; justify-content: center;">
      <%= image_tag "Logo_mark.png", style: "height: 2rem; width: auto;", alt: "AMOS" %>
    </div>
    <button class="nav-toggle" data-action="click->scout#toggleSideNav" data-scout-target="navToggle" aria-label="Toggle navigation menu">
      <i data-lucide="menu" aria-hidden="true"></i>
    </button>
  </div>

  <div class="nav-items">
    <div class="nav-section">
      <%# Always visible: Home - returns to default chat view (no canvas) %>
      <div class="nav-item active" data-action="click->scout#goToConversation">
        <i data-lucide="home"></i>
        <span class="nav-text">Home</span>
      </div>

      <%# Dashboard - Work space only %>
      <% if @current_space&.slug == 'work' || (!@current_space && sidebar_section_visible?('dashboard')) %>
        <div class="nav-item" data-action="click->scout#loadDashboardCanvas">
          <i data-lucide="layout-dashboard"></i>
          <span class="nav-text">Dashboard</span>
        </div>
      <% end %>

      <%# Personal Space Items - Notes, Bookmarks, Reminders %>
      <% if sidebar_section_visible?('notes') %>
        <div class="nav-item" data-action="click->scout#loadNotesCanvas" title="Personal notes">
          <i data-lucide="edit-3"></i>
          <span class="nav-text">Notes</span>
        </div>
      <% end %>
      <% if sidebar_section_visible?('bookmarks') %>
        <div class="nav-item" data-action="click->scout#loadBookmarksCanvas" title="Saved items">
          <i data-lucide="bookmark"></i>
          <span class="nav-text">Bookmarks</span>
        </div>
      <% end %>
      <% if sidebar_section_visible?('reminders') %>
        <div class="nav-item" data-action="click->scout#loadRemindersCanvas" title="Personal reminders">
          <i data-lucide="bell"></i>
          <span class="nav-text">Reminders</span>
        </div>
      <% end %>

      <%# Tasks - visible in all spaces %>
      <% if sidebar_section_visible?('tasks') %>
        <div class="nav-item" data-action="click->scout#loadScheduledTasksCanvas" title="View all running and scheduled tasks">
          <i data-lucide="list-checks"></i>
          <span class="nav-text">Tasks</span>
          <span id="active-task-count" class="task-badge" style="display: none;">0</span>
        </div>
      <% end %>

      <%# Work Inbox - visible in all spaces %>
      <div class="nav-item" data-action="click->scout#loadWorkInboxCanvas" title="View agent work inbox">
        <i data-lucide="inbox"></i>
        <span class="nav-text">Work Inbox</span>
        <span id="work-inbox-badge" class="nav-badge" style="display: none;">0</span>
      </div>

      <%# Team Space - Channels %>
      <% if sidebar_section_visible?('channels') %>
        <div class="nav-item" data-action="click->scout#loadChannelsCanvas" title="Team channels">
          <i data-lucide="hash"></i>
          <span class="nav-text">Channels</span>
        </div>
      <% end %>


      <%# Marketing Items - Check each individually %>
      <% if sidebar_item_visible?('landing_pages') %>
        <div class="nav-item" data-template-type="landing_page" data-action="click->scout#loadLandingPagesCanvas">
          <i data-lucide="globe"></i>
          <span class="nav-text">Landing Pages</span>
        </div>
      <% end %>
      <% if sidebar_item_visible?('campaigns') %>
        <div class="nav-item" data-template-type="campaign" data-action="click->scout#loadCampaignsCanvas">
          <i data-lucide="mail"></i>
          <span class="nav-text">Campaigns</span>
        </div>
      <% end %>
      <% if sidebar_item_visible?('email_templates') %>
        <div class="nav-item" data-template-type="email_template" data-action="click->scout#loadEmailTemplatesCanvas">
          <i data-lucide="file-text"></i>
          <span class="nav-text">Email Templates</span>
        </div>
      <% end %>

      <%# Contacts - Check individual items %>
      <% if sidebar_item_visible?('contacts') %>
        <div class="nav-item" data-template-type="contact" data-action="click->scout#loadContactsCanvas">
          <i data-lucide="users"></i>
          <span class="nav-text">Contacts</span>
        </div>
      <% end %>

      <%# Analytics %>
      <% if sidebar_item_visible?('analytics') %>
        <div class="nav-item" data-template-type="analytics" data-action="click->scout#loadAnalyticsCanvas">
          <i data-lucide="bar-chart-2"></i>
          <span class="nav-text">Analytics</span>
        </div>
      <% end %>

      <%# Integrations %>
      <% if sidebar_item_visible?('integrations') %>
        <div class="nav-item" data-template-type="integration" data-action="click->scout#loadIntegrationsCanvas">
          <i data-lucide="plug"></i>
          <span class="nav-text">Integrations</span>
        </div>
      <% end %>

      <%# Agent Marketplace - Team space only (Amos can load it on demand in other spaces) %>
      <% if @current_space&.slug == 'team' && sidebar_section_visible?('agents') %>
        <div class="nav-item" data-action="click->scout#loadAgentMarketplaceCanvas" title="Browse and discover AI agents">
          <i data-lucide="store"></i>
          <span class="nav-text">Agent Marketplace</span>
        </div>
      <% end %>
    </div>

    <%# Templates section - Only show if any marketing items are visible %>
    <% if sidebar_item_visible?('landing_pages') || sidebar_item_visible?('campaigns') || sidebar_item_visible?('email_templates') %>
      <div class="nav-section">
        <div class="nav-section-title">Templates</div>
        <div id="template-list" data-scout-target="templateList">
          <!-- Templates will be loaded here -->
        </div>
      </div>
    <% end %>
  </div>

  <div class="nav-footer">
    <div class="nav-item" data-action="click->scout#openSettings">
      <i data-lucide="settings"></i>
      <span class="nav-text">Settings</span>
    </div>
    <div class="nav-item" data-action="click->scout#openProfile">
      <i data-lucide="user"></i>
      <span class="nav-text">My Profile</span>
    </div>
    <div class="nav-item" data-theme-toggle title="Toggle light/dark mode">
      <i data-lucide="moon" data-theme-icon></i>
      <span class="nav-text">Theme</span>
    </div>
    <div class="nav-item" data-action="click->scout#logout">
      <i data-lucide="log-out"></i>
      <span class="nav-text">Logout</span>
    </div>
  </div>
</nav>
