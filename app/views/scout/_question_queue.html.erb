<%# 
  Question Queue Component
  Floating badge + overlay for agent questions
  Non-blocking - user can continue chatting while agents ask questions
%>

<%# Wrap everything in a single controller element so all targets are accessible %>
<div id="questionQueueContainer" 
     class="question-queue-container"
     data-controller="question-queue"
     data-question-queue-session-id-value="<%= @session_id %>">

  <%# Floating Question Badge %>
  <div id="questionQueueBadge" class="question-queue-badge hidden" data-question-queue-target="badge">
    <button class="badge-button" data-action="question-queue#toggleOverlay" title="Agent questions waiting">
      <i data-lucide="message-circle-question" class="badge-icon"></i>
      <span class="badge-count" data-question-queue-target="count"><%= @pending_questions_count || 0 %></span>
    </button>
  </div>

  <%# Question Overlay - Split Panel Layout %>
  <div id="questionQueueOverlay" class="question-overlay hidden" data-question-queue-target="overlay">
    <div class="overlay-backdrop" data-action="click->question-queue#closeOverlay"></div>
    
    <div class="overlay-split-container" data-question-queue-target="splitContainer">
      <%# Left Panel: Questions & Answers %>
      <div class="overlay-panel overlay-panel-left">
        <div class="overlay-header">
          <h5>
            <i data-lucide="message-circle-question" style="width: 20px; height: 20px;"></i>
            Agent Questions
          </h5>
          <button class="btn btn-sm btn-link text-muted" data-action="question-queue#closeOverlay">
            <i data-lucide="x" style="width: 18px; height: 18px;"></i>
          </button>
        </div>

        <%# Question List (when multiple) %>
        <div class="question-list" data-question-queue-target="list">
          <!-- Populated by JS -->
        </div>

        <%# Active Question View %>
        <div class="active-question" data-question-queue-target="activeQuestion">
          <div class="question-agent">
            <span class="agent-icon" data-question-queue-target="agentIcon">🤖</span>
            <span class="agent-name" data-question-queue-target="agentName">Agent</span>
            <span class="question-time" data-question-queue-target="questionTime"></span>
          </div>
          
          <div class="question-content" data-question-queue-target="questionContent">
            <!-- Question text here -->
          </div>

          <div class="question-context" data-question-queue-target="questionContext">
            <!-- Optional context info -->
          </div>

          <div class="answer-form">
            <%# Attachment preview area %>
            <div class="attachment-preview hidden" data-question-queue-target="attachmentPreview">
              <div class="attachment-item">
                <img src="" alt="Attachment preview" data-question-queue-target="attachmentImage">
                <button type="button" class="btn-remove-attachment" data-action="question-queue#removeAttachment">
                  <i data-lucide="x" style="width: 14px; height: 14px;"></i>
                </button>
              </div>
            </div>
            
            <div class="answer-input-wrapper">
              <textarea 
                class="form-control answer-input" 
                data-question-queue-target="answerInput"
                placeholder="Type your answer... (paste images with Ctrl/Cmd+V)"
                rows="4"
                data-action="keydown->question-queue#handleKeydown paste->question-queue#handlePaste"
              ></textarea>
              
              <%# Hidden file input %>
              <input type="file" 
                     class="d-none" 
                     data-question-queue-target="fileInput"
                     data-action="change->question-queue#handleFileSelect"
                     accept="image/*,.pdf,.doc,.docx,.txt,.csv,.xlsx">
            </div>
            
            <div class="answer-actions">
              <div class="action-group-left">
                <button class="btn btn-outline-secondary btn-sm skip-btn" 
                        data-action="question-queue#skipQuestion"
                        title="Skip this question">
                  <i data-lucide="skip-forward" style="width: 14px; height: 14px;"></i>
                  Skip
                </button>
                <button class="btn btn-outline-secondary btn-sm upload-btn"
                        data-action="question-queue#triggerFileUpload"
                        title="Attach a file or screenshot">
                  <i data-lucide="paperclip" style="width: 14px; height: 14px;"></i>
                  Attach
                </button>
              </div>
              <button class="btn btn-primary btn-sm answer-btn" 
                      data-action="question-queue#submitAnswer">
                <i data-lucide="send" style="width: 14px; height: 14px;"></i>
                Send Answer
              </button>
            </div>
          </div>
        </div>

        <%# Empty State %>
        <div class="empty-state hidden" data-question-queue-target="emptyState">
          <i data-lucide="check-circle" style="width: 32px; height: 32px;"></i>
          <p>No questions waiting!</p>
        </div>
      </div>

      <%# Right Panel: Agent Canvas/Preview %>
      <div class="overlay-panel overlay-panel-canvas" data-question-queue-target="canvasPanel">
        <div class="overlay-header">
          <h5>
            <i data-lucide="layout" style="width: 20px; height: 20px;"></i>
            <span data-question-queue-target="canvasTitle">Design Preview</span>
          </h5>
        </div>
        <div class="agent-canvas-content" data-question-queue-target="canvasContent">
          <%# Agent-provided content renders here %>
          <div class="canvas-placeholder">
            <i data-lucide="eye" style="width: 48px; height: 48px;"></i>
            <h6>Agent Preview</h6>
            <p>When the agent has something to show you, it will appear here.</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  /* Container wrapper - minimal footprint, just for Stimulus scope */
  .question-queue-container {
    /* Don't cover the screen - just a logical grouping */
    position: relative;
    z-index: 999;
  }

  /* ============================================
     QUESTION QUEUE BADGE
     Positioned on the LEFT side near the chat input
     ============================================ */
  .question-queue-badge {
    position: fixed;
    bottom: 90px; /* Just above the chat input area */
    left: 80px; /* After the sidebar, on the chat side */
    z-index: 1000;
    animation: slideInLeft 0.3s ease-out;
    pointer-events: auto; /* Re-enable clicks for the badge */
  }

  .question-queue-badge.hidden {
    display: none;
  }

  .question-queue-badge.has-questions {
    animation: pulse 2s infinite;
  }

  @keyframes slideInLeft {
    from {
      transform: translateX(-50px);
      opacity: 0;
    }
    to {
      transform: translateX(0);
      opacity: 1;
    }
  }

  @keyframes pulse {
    0%, 100% {
      transform: scale(1);
    }
    50% {
      transform: scale(1.05);
    }
  }
  
  /* Quick attention-grabbing pulse for new completions */
  @keyframes pulseAttention {
    0% { transform: scale(1); box-shadow: 0 4px 20px rgba(99, 102, 241, 0.4); }
    25% { transform: scale(1.15); box-shadow: 0 4px 30px rgba(99, 102, 241, 0.8); }
    50% { transform: scale(1); box-shadow: 0 4px 20px rgba(99, 102, 241, 0.4); }
    75% { transform: scale(1.15); box-shadow: 0 4px 30px rgba(99, 102, 241, 0.8); }
    100% { transform: scale(1); box-shadow: 0 4px 20px rgba(99, 102, 241, 0.4); }
  }
  
  .question-queue-badge.pulse-attention .badge-button {
    animation: pulseAttention 0.8s ease-out;
  }

  .badge-button {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 12px 16px;
    background: linear-gradient(135deg, #6366f1 0%, #8b5cf6 100%);
    border: none;
    border-radius: 50px;
    color: white;
    font-weight: 600;
    cursor: pointer;
    box-shadow: 0 4px 20px rgba(99, 102, 241, 0.4);
    transition: all 0.2s ease;
  }

  .badge-button:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 25px rgba(99, 102, 241, 0.5);
  }

  .badge-icon {
    width: 20px;
    height: 20px;
  }

  .badge-count {
    background: #fff;
    color: #6366f1;
    padding: 2px 8px;
    border-radius: 12px;
    font-size: 0.85rem;
    min-width: 24px;
    text-align: center;
  }

  /* ============================================
     QUESTION OVERLAY - Full Screen Split Layout
     ============================================ */
  .question-overlay {
    position: fixed;
    top: 0;
    left: 70px; /* After sidebar */
    right: 0;
    bottom: 0;
    z-index: 1001;
    display: flex;
    align-items: stretch;
    justify-content: center;
    padding: 20px;
    pointer-events: auto;
  }

  .question-overlay.hidden {
    display: none;
  }

  /* Blocking backdrop when overlay is open */
  .overlay-backdrop {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.6);
    backdrop-filter: blur(4px);
    z-index: -1;
  }

  /* Split container for side-by-side panels */
  .overlay-split-container {
    display: flex;
    gap: 16px;
    width: 100%;
    max-width: 1400px;
    height: 100%;
    max-height: calc(100vh - 40px);
    animation: slideUp 0.2s ease-out;
  }

  .overlay-panel {
    position: relative;
    background: var(--bg-primary, #1a1b2e);
    border: 1px solid rgba(99, 102, 241, 0.3);
    border-radius: 16px;
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.5), 0 0 0 1px rgba(99, 102, 241, 0.2);
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  /* Left panel: Questions - takes ~40% */
  .overlay-panel-left {
    flex: 0 0 420px;
    min-width: 380px;
  }

  /* Right panel: Canvas - takes remaining space */
  .overlay-panel-canvas {
    flex: 1;
    min-width: 400px;
  }

  /* Agent Canvas Content Area */
  .agent-canvas-content {
    flex: 1;
    overflow-y: auto;
    padding: 24px;
    background: rgba(0, 0, 0, 0.2);
  }

  .canvas-placeholder {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    height: 100%;
    text-align: center;
    color: rgba(255, 255, 255, 0.4);
  }

  .canvas-placeholder i {
    margin-bottom: 16px;
    opacity: 0.5;
  }

  .canvas-placeholder h6 {
    font-size: 1.1rem;
    margin-bottom: 8px;
    color: rgba(255, 255, 255, 0.6);
  }

  .canvas-placeholder p {
    font-size: 0.9rem;
    max-width: 300px;
  }

  /* Canvas content when populated */
  .agent-canvas-content .design-preview {
    background: rgba(255, 255, 255, 0.05);
    border-radius: 12px;
    padding: 20px;
  }

  .agent-canvas-content .schema-preview {
    font-family: 'SF Mono', Monaco, Consolas, monospace;
    font-size: 0.85rem;
    background: rgba(0, 0, 0, 0.3);
    border-radius: 8px;
    padding: 16px;
    overflow-x: auto;
  }

  .agent-canvas-content .field-list {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .agent-canvas-content .field-item {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 16px;
    background: rgba(99, 102, 241, 0.1);
    border: 1px solid rgba(99, 102, 241, 0.2);
    border-radius: 8px;
  }

  .agent-canvas-content .field-item .field-name {
    font-weight: 600;
    color: #a5b4fc;
  }

  .agent-canvas-content .field-item .field-type {
    font-size: 0.8rem;
    padding: 2px 8px;
    background: rgba(255, 255, 255, 0.1);
    border-radius: 4px;
    color: rgba(255, 255, 255, 0.7);
  }

  @keyframes slideUp {
    from {
      transform: translateY(10px);
      opacity: 0;
    }
    to {
      transform: translateY(0);
      opacity: 1;
    }
  }

  .overlay-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 16px 24px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    background: rgba(99, 102, 241, 0.1);
  }

  .overlay-header h5 {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 0;
    color: #fff;
    font-size: 1.1rem;
    font-weight: 600;
  }
  
  .overlay-header .btn-link {
    padding: 4px 8px;
    border-radius: 6px;
    transition: background 0.2s;
  }
  
  .overlay-header .btn-link:hover {
    background: rgba(255, 255, 255, 0.1);
  }

  /* Question List (for multiple questions) */
  .question-list {
    max-height: 150px;
    overflow-y: auto;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }

  .question-list:empty {
    display: none;
  }

  .question-list-item {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 20px;
    cursor: pointer;
    transition: background 0.2s;
  }

  .question-list-item:hover,
  .question-list-item.active {
    background: rgba(255, 255, 255, 0.05);
  }

  .question-list-item .item-icon {
    font-size: 1.25rem;
  }

  .question-list-item .item-info {
    flex: 1;
    min-width: 0;
  }

  .question-list-item .item-agent {
    font-weight: 500;
    color: #fff;
  }

  .question-list-item .item-preview {
    font-size: 0.8rem;
    color: rgba(255, 255, 255, 0.6);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* Active Question */
  .active-question {
    padding: 24px 32px;
    flex: 1;
    overflow-y: auto;
  }

  .question-agent {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 16px;
  }

  .agent-icon {
    font-size: 1.5rem;
  }

  .agent-name {
    font-weight: 600;
    color: #fff;
  }

  .question-time {
    margin-left: auto;
    font-size: 0.75rem;
    color: rgba(255, 255, 255, 0.5);
  }

  .question-content {
    background: rgba(99, 102, 241, 0.1);
    border: 1px solid rgba(99, 102, 241, 0.3);
    border-radius: 12px;
    padding: 24px;
    color: #fff;
    line-height: 1.7;
    margin-bottom: 20px;
    font-size: 1rem;
    flex: 1;
    overflow-y: auto;
  }
  
  /* Markdown formatting in question content */
  .question-content strong {
    font-weight: 700;
    color: #a5b4fc;
  }
  
  .question-content em {
    font-style: italic;
    color: #c4b5fd;
  }
  
  .question-content p {
    margin: 0 0 12px 0;
  }
  
  .question-content p:last-child {
    margin-bottom: 0;
  }
  
  .question-content .list-item {
    padding: 4px 0;
    padding-left: 8px;
  }
  
  .question-content .list-number {
    font-weight: 600;
    color: #a5b4fc;
    margin-right: 4px;
  }

  .question-context {
    font-size: 0.85rem;
    color: rgba(255, 255, 255, 0.6);
    margin-bottom: 16px;
    padding: 12px;
    background: rgba(255, 255, 255, 0.03);
    border-radius: 8px;
  }

  .question-context:empty {
    display: none;
  }

  .answer-form {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .answer-input-wrapper {
    position: relative;
  }

  .answer-input {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 8px;
    color: #fff;
    resize: none;
    width: 100%;
  }

  .answer-input:focus {
    background: rgba(255, 255, 255, 0.08);
    border-color: rgba(99, 102, 241, 0.5);
    outline: none;
    box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.2);
  }

  /* Attachment Preview */
  .attachment-preview {
    margin-bottom: 8px;
  }

  .attachment-preview.hidden {
    display: none;
  }

  .attachment-item {
    position: relative;
    display: inline-block;
    border-radius: 8px;
    overflow: hidden;
    border: 1px solid rgba(99, 102, 241, 0.3);
  }

  .attachment-item img {
    max-width: 150px;
    max-height: 100px;
    object-fit: cover;
    display: block;
  }

  .btn-remove-attachment {
    position: absolute;
    top: 4px;
    right: 4px;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: rgba(0, 0, 0, 0.7);
    border: none;
    color: #fff;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.2s;
  }

  .btn-remove-attachment:hover {
    background: #ef4444;
  }

  .answer-actions {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .action-group-left {
    display: flex;
    gap: 8px;
  }

  .skip-btn, .upload-btn {
    color: rgba(255, 255, 255, 0.6);
    border-color: rgba(255, 255, 255, 0.2);
  }

  .skip-btn:hover, .upload-btn:hover {
    color: #fff;
    background: rgba(255, 255, 255, 0.1);
  }

  /* File attachment styles */
  .file-attachment {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 8px 12px;
    background: rgba(99, 102, 241, 0.1);
    border: 1px solid rgba(99, 102, 241, 0.3);
    border-radius: 8px;
  }

  .file-attachment .file-name {
    flex: 1;
    font-size: 0.85rem;
    color: #fff;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* Empty State */
  .empty-state {
    padding: 40px 20px;
    text-align: center;
    color: rgba(255, 255, 255, 0.5);
  }

  .empty-state i {
    margin-bottom: 12px;
    color: #22c55e;
  }

  .empty-state.hidden {
    display: none;
  }

  /* ============================================
     LIGHT MODE OVERRIDES
     ============================================ */
  html[data-theme="light"] .overlay-backdrop {
    background: rgba(0, 0, 0, 0.4);
  }

  html[data-theme="light"] .overlay-panel {
    background: #ffffff;
    border-color: rgba(99, 102, 241, 0.4);
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.15), 0 0 0 1px rgba(99, 102, 241, 0.2);
  }

  html[data-theme="light"] .agent-canvas-content {
    background: #f8fafc;
  }

  html[data-theme="light"] .canvas-placeholder {
    color: #94a3b8;
  }

  html[data-theme="light"] .canvas-placeholder h6 {
    color: #64748b;
  }

  html[data-theme="light"] .agent-canvas-content .design-preview {
    background: #f1f5f9;
  }

  html[data-theme="light"] .agent-canvas-content .schema-preview {
    background: #e2e8f0;
  }

  html[data-theme="light"] .agent-canvas-content .field-item {
    background: rgba(99, 102, 241, 0.08);
    border-color: rgba(99, 102, 241, 0.2);
  }

  html[data-theme="light"] .agent-canvas-content .field-item .field-name {
    color: #4f46e5;
  }

  html[data-theme="light"] .agent-canvas-content .field-item .field-type {
    background: #e2e8f0;
    color: #475569;
  }

  html[data-theme="light"] .overlay-header {
    border-bottom-color: rgba(0, 0, 0, 0.1);
    background: rgba(99, 102, 241, 0.08);
  }

  html[data-theme="light"] .overlay-header h5 {
    color: #1e293b;
  }

  html[data-theme="light"] .question-list {
    border-bottom-color: rgba(0, 0, 0, 0.1);
  }

  html[data-theme="light"] .question-list-item:hover,
  html[data-theme="light"] .question-list-item.active {
    background: rgba(0, 0, 0, 0.05);
  }

  html[data-theme="light"] .question-list-item .item-agent {
    color: #1e293b;
  }

  html[data-theme="light"] .question-list-item .item-preview {
    color: #64748b;
  }

  html[data-theme="light"] .agent-name {
    color: #1e293b;
  }

  html[data-theme="light"] .question-time {
    color: #94a3b8;
  }

  html[data-theme="light"] .question-content {
    background: rgba(99, 102, 241, 0.08);
    border-color: rgba(99, 102, 241, 0.3);
    color: #1e293b;
  }
  
  html[data-theme="light"] .question-content strong {
    color: #4f46e5;
  }
  
  html[data-theme="light"] .question-content em {
    color: #6366f1;
  }
  
  html[data-theme="light"] .question-content .list-number {
    color: #4f46e5;
  }

  html[data-theme="light"] .question-context {
    color: #64748b;
    background: rgba(0, 0, 0, 0.03);
  }

  html[data-theme="light"] .answer-input {
    background: #f8fafc;
    border-color: #e2e8f0;
    color: #1e293b;
  }

  html[data-theme="light"] .answer-input::placeholder {
    color: #94a3b8;
  }

  html[data-theme="light"] .answer-input:focus {
    background: #ffffff;
    border-color: rgba(99, 102, 241, 0.5);
    box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.15);
  }

  html[data-theme="light"] .skip-btn,
  html[data-theme="light"] .upload-btn {
    color: #64748b;
    border-color: #e2e8f0;
  }

  html[data-theme="light"] .skip-btn:hover,
  html[data-theme="light"] .upload-btn:hover {
    color: #1e293b;
    background: #f1f5f9;
  }

  html[data-theme="light"] .empty-state {
    color: #64748b;
  }

  html[data-theme="light"] .file-attachment {
    background: rgba(99, 102, 241, 0.08);
    border-color: rgba(99, 102, 241, 0.3);
  }

  html[data-theme="light"] .file-attachment .file-name {
    color: #1e293b;
  }

  /* ============================================
     COMPLETION STATE STYLES
     ============================================ */
  .completion-content {
    text-align: center;
    padding: 16px 8px;
  }

  .completion-icon {
    font-size: 3rem;
    margin-bottom: 12px;
  }

  .completion-title {
    font-size: 1.1rem;
    font-weight: 600;
    margin-bottom: 8px;
    color: #4ade80;
  }

  .completion-message {
    font-size: 0.95rem;
    color: rgba(255, 255, 255, 0.9);
    line-height: 1.5;
  }

  .completion-context {
    text-align: center;
    font-size: 0.9rem;
    color: rgba(255, 255, 255, 0.7);
    padding: 8px;
  }

  .completion-actions {
    display: flex;
    justify-content: center;
    gap: 12px;
    padding: 16px 0;
  }

  .completion-actions .btn {
    padding: 8px 20px;
  }

  .completion-actions .dismiss-btn {
    color: rgba(255, 255, 255, 0.7);
    border-color: rgba(255, 255, 255, 0.3);
  }

  .completion-actions .dismiss-btn:hover {
    color: #fff;
    background: rgba(255, 255, 255, 0.1);
  }

  /* Light mode completion styles */
  html[data-theme="light"] .completion-message {
    color: #374151;
  }

  html[data-theme="light"] .completion-context {
