<%# Work Inbox Badge - Shows count of unread work items with notification animation %>
<%
  unread_count = AgentWorkItem.unread_count_for(current_user, current_entity) rescue 0
%>

<div id="workInboxBadge" 
     class="work-inbox-badge <%= 'hidden' if unread_count == 0 %>"
     data-controller="work-inbox-badge"
     data-work-inbox-badge-user-id-value="<%= current_user.id %>"
     data-work-inbox-badge-initial-count-value="<%= unread_count %>">
  
  <button class="badge-button" 
          data-action="click->work-inbox-badge#openWorkInbox" 
          title="Work Inbox - <%= unread_count %> unread items">
    <i data-lucide="inbox" class="badge-icon"></i>
    <span class="badge-count" data-work-inbox-badge-target="count"><%= unread_count %></span>
  </button>
</div>

<style>
  /* ============================================
     WORK INBOX BADGE
     Positioned above the question queue badge
     ============================================ */
  .work-inbox-badge {
    position: fixed;
    bottom: 140px; /* Above the question queue badge */
    left: 80px; /* Aligned with question queue */
    z-index: 1000;
    animation: slideInWorkBadge 0.3s ease-out;
    pointer-events: auto;
  }

  .work-inbox-badge.hidden {
    display: none;
  }

  .work-inbox-badge.has-new-items {
    animation: pulseWorkBadge 0.5s ease-out;
  }

  @keyframes slideInWorkBadge {
    from {
      transform: translateX(-50px);
      opacity: 0;
    }
    to {
      transform: translateX(0);
      opacity: 1;
    }
  }

  @keyframes pulseWorkBadge {
    0% {
      transform: scale(1);
    }
    50% {
      transform: scale(1.2);
    }
    100% {
      transform: scale(1);
    }
  }

  .work-inbox-badge .badge-button {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    padding: 10px 16px;
    background: linear-gradient(135deg, #10b981 0%, #059669 100%);
    border: none;
    border-radius: 24px;
    color: white;
    font-weight: 600;
    font-size: 0.875rem;
    cursor: pointer;
    box-shadow: 0 4px 15px rgba(16, 185, 129, 0.4);
    transition: all 0.2s ease;
  }

  .work-inbox-badge .badge-button:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(16, 185, 129, 0.5);
  }

  .work-inbox-badge .badge-icon {
    width: 18px;
    height: 18px;
  }

  .work-inbox-badge .badge-count {
    background: rgba(255, 255, 255, 0.25);
    padding: 2px 8px;
    border-radius: 12px;
    font-size: 0.8rem;
    min-width: 24px;
    text-align: center;
  }

  /* Animation when count increases */
  .work-inbox-badge .badge-count.bump {
    animation: bumpCount 0.3s ease-out;
  }

  @keyframes bumpCount {
    0% {
      transform: scale(1);
    }
    50% {
      transform: scale(1.3);
      background: rgba(255, 255, 255, 0.5);
    }
    100% {
      transform: scale(1);
    }
  }
</style>

