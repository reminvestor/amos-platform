<%# Work Inbox Badge Controller - Updates the nav-item badge in the sidebar %>
<%
  unread_count = AgentWorkItem.unread_count_for(current_user, current_entity) rescue 0
%>

<div id="workInboxBadgeController" 
     class="work-inbox-badge-controller"
     data-controller="work-inbox-badge"
     data-work-inbox-badge-user-id-value="<%= current_user.id %>"
     data-work-inbox-badge-initial-count-value="<%= unread_count %>"
     style="display: none;">
  <%# This is just a controller element - the actual badge is in the nav-item %>
</div>

<style>
  /* iOS-style notification badge for nav items */
  .nav-badge {
    position: absolute;
    top: 8px;
    right: 8px;
    min-width: 18px;
    height: 18px;
    padding: 0 5px;
    background: #ef4444;
    color: white;
    font-size: 11px;
    font-weight: 600;
    border-radius: 9px;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 2px 4px rgba(239, 68, 68, 0.4);
    animation: badgeAppear 0.3s ease-out;
  }

  .nav-item {
    position: relative;
  }

  /* Pulse animation when count increases */
  .nav-badge.pulse {
    animation: badgePulse 0.4s ease-out;
  }

  @keyframes badgeAppear {
    from {
      transform: scale(0);
      opacity: 0;
    }
    to {
      transform: scale(1);
      opacity: 1;
    }
  }

  @keyframes badgePulse {
    0% {
      transform: scale(1);
    }
    50% {
      transform: scale(1.3);
      box-shadow: 0 2px 8px rgba(239, 68, 68, 0.6);
    }
    100% {
      transform: scale(1);
    }
  }
</style>

<script>
  // Initialize badge on page load
  document.addEventListener('DOMContentLoaded', function() {
    const badge = document.getElementById('work-inbox-badge');
    const initialCount = <%= unread_count %>;
    
    if (badge && initialCount > 0) {
      badge.textContent = initialCount > 99 ? '99+' : initialCount;
      badge.style.display = 'flex';
    }
  });
</script>
