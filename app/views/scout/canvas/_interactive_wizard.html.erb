<div class="interactive-wizard-canvas h-100">
  <!-- Wizard Header -->
  <div class="wizard-header bg-light border-bottom p-3 rounded-top">
    <div class="d-flex justify-content-between align-items-center">
      <div>
        <h4 class="mb-1 text-dark fw-bold">
          <%= step&.dig('config', 'title') || 'Interactive Wizard' %>
        </h4>
        <% if step&.dig('config', 'description') %>
          <p class="text-secondary mb-0 small fw-medium">
            <%= step['config']['description'] %>
          </p>
        <% end %>
      </div>
      
      <!-- Progress Indicator -->
      <% if progress %>
        <div class="wizard-progress">
          <div class="d-flex align-items-center">
            <small class="text-muted me-2">
              Step <%= progress['completed_steps'] + 1 %> of <%= progress['total_steps'] %>
            </small>
            <div class="progress" style="width: 100px; height: 8px;">
              <div class="progress-bar" 
                   style="width: <%= progress['progress_percentage'] %>%"
                   role="progressbar"></div>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  </div>
  
  <!-- Wizard Content -->
  <div class="wizard-content p-4 flex-grow-1 overflow-auto">
    <% if step && step['config'] && step['config']['fields'] %>
      <!-- Render Form Fields -->
      <form id="wizard-form" class="needs-validation" novalidate>
        <% step['config']['fields'].each do |field| %>
          <div class="mb-3">
            <%= render partial: 'scout/canvas/wizard_steps/form_field', 
                       locals: { field: field } %>
          </div>
        <% end %>
        
      </form>
      
    <% elsif step && step['type'] == 'tool_call' %>
      <!-- Tool Execution in Progress -->
      <div class="text-center py-5">
        <div class="spinner-border text-primary mb-3" role="status">
          <span class="visually-hidden">Loading...</span>
        </div>
        <h5><%= step.dig('config', 'description') || 'Processing...' %></h5>
        <p class="text-muted">
          Amos is working on your request. This may take a moment.
        </p>
      </div>
      
    <% else %>
      <!-- Default State -->
      <div class="text-center py-5">
        <i data-lucide="wand-2" class="text-primary mb-3 icon-4x" aria-hidden="true"></i>
        <h5>Interactive Wizard</h5>
        <p class="text-muted">
          Amos will guide you through this process step by step.
        </p>
      </div>
    <% end %>
  </div>
  
  <!-- Wizard Footer -->
  <div class="wizard-footer bg-light border-top p-3">
    <div class="d-flex justify-content-between align-items-center">
      <div class="wizard-info">
        <% if progress %>
          <small class="text-muted">
            <i data-lucide="clock" class="me-1" aria-hidden="true"></i>
            Started <%= time_ago_in_words(Time.current - 5.minutes) %> ago
          </small>
        <% end %>
      </div>
      
      <div class="wizard-controls d-flex justify-content-end align-items-center">
        <button type="button" class="btn btn-outline-danger me-3" id="cancel-workflow-btn" aria-label="Cancel workflow">
          <i data-lucide="x" class="me-1" aria-hidden="true"></i>
          Cancel Workflow
        </button>
        <button type="submit" class="btn btn-primary" id="continue-btn" form="wizard-form" aria-label="Continue to next step">
          <i data-lucide="arrow-right" class="me-1" aria-hidden="true"></i>
          <%= step&.dig('config', 'submit_label') || 'Continue' %>
        </button>
      </div>
    </div>
  </div>
</div>

<!-- JavaScript for Wizard Interaction -->
<script>
(function() {
  // Initialize wizard immediately when this partial is loaded
  const initializeWizard = function() {
    const wizardForm = document.getElementById('wizard-form');
    const skipBtn = document.getElementById('skip-step-btn');
    const cancelBtn = document.getElementById('cancel-workflow-btn');
  
  // Handle form submission
  if (wizardForm) {
    wizardForm.addEventListener('submit', function(e) {
      e.preventDefault();
      
      // Validate form
      if (!wizardForm.checkValidity()) {
        e.stopPropagation();
        wizardForm.classList.add('was-validated');
        return;
      }
      
      // Collect form data
      const formData = new FormData(wizardForm);
      const inputs = {};
      
      for (let [key, value] of formData.entries()) {
        inputs[key] = value;
      }
      
      // Submit to continue workflow
      continueWorkflow(inputs);
    });
  }
  
  // Handle skip step
  if (skipBtn) {
    skipBtn.addEventListener('click', async function() {
      if (await showConfirm('Are you sure you want to skip this step?', { title: 'Skip Step' })) {
        continueWorkflow({}, true);
      }
    });
  }
  
  // Handle cancel workflow
  if (cancelBtn) {
    cancelBtn.addEventListener('click', async function() {
      if (await showConfirm('Are you sure you want to cancel this workflow? All progress will be lost.', { title: 'Cancel Workflow', dangerous: true })) {
        cancelWorkflow();
      }
    });
  }
  
  function continueWorkflow(inputs, skip = false) {
    const submitBtn = wizardForm?.querySelector('button[type="submit"]');
    const originalText = submitBtn?.textContent;
    
    // Show loading state
    if (submitBtn) {
      submitBtn.disabled = true;
      submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Processing...';
    }
    
    // Fallback overlay if canvas doesn't switch quickly
    let overlayTimeout = setTimeout(() => {
      showBlockingOverlay('Continuing to next step...');
    }, 600);
    
    // Send request
    fetch('/scout/continue_workflow', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]')?.content
      },
      body: JSON.stringify({
        inputs: inputs,
        skip: skip
      })
    })
    .then(response => response.json())
    .then(data => {
      clearTimeout(overlayTimeout);
      hideBlockingOverlay();
      if (data.success) {
        // Handle successful workflow continuation
        if (data.workflow_completed) {
          // Load final canvas
          if (window.scoutController && window.scoutController.loadScoutCanvas) {
            window.scoutController.loadScoutCanvas(data.canvas, data.canvas_data);
          } else {
            // Dispatch custom event as fallback
            const event = new CustomEvent('scout:load-canvas', {
              detail: { canvas: data.canvas, data: data.canvas_data }
            });
            document.dispatchEvent(event);
          }
          showMessage(data.message, 'success');
        } else if (data.awaiting_input) {
          // Update wizard with next step
          if (window.scoutController && window.scoutController.loadScoutCanvas) {
            window.scoutController.loadScoutCanvas('interactive_wizard', data.canvas_data);
          } else {
            const event = new CustomEvent('scout:load-canvas', {
              detail: { canvas: 'interactive_wizard', data: data.canvas_data }
            });
            document.dispatchEvent(event);
          }
        } else {
          // Workflow is processing - show task progress
          console.log('🔄 Workflow processing, loading task progress canvas');
          console.log('Response data:', data);
          const canvasType = data.canvas || 'task_progress';
          const canvasData = data.canvas_data || {};
          
          // Check what type of canvas the server wants us to load
          console.log('Server wants canvas:', data.canvas, 'awaiting_input:', data.awaiting_input);
          
          if (data.canvas === 'interactive_wizard' || data.awaiting_input) {
            console.log('Loading interactive wizard for next form');
            if (window.scoutController && window.scoutController.loadScoutCanvas) {
              window.scoutController.loadScoutCanvas('interactive_wizard', canvasData);
            } else {
              const event = new CustomEvent('scout:load-canvas', {
                detail: { canvas: 'interactive_wizard', data: canvasData }
              });
              document.dispatchEvent(event);
            }
          } else {
            console.log('Loading task progress for tool execution');
            if (window.scoutController && window.scoutController.loadScoutCanvas) {
              window.scoutController.loadScoutCanvas('task_progress', canvasData);
            } else {
              const event = new CustomEvent('scout:load-canvas', {
                detail: { canvas: 'task_progress', data: canvasData }
              });
              document.dispatchEvent(event);
            }
          }
        }
      } else {
        showMessage(data.message || 'An error occurred', 'error');
        
        // Reset button state
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.textContent = originalText;
        }
      }
    })
    .catch(error => {
      console.error('Workflow continuation error:', error);
      showMessage('An error occurred while processing your request', 'error');
      
      // Reset button state
      if (submitBtn) {
        submitBtn.disabled = false;
        submitBtn.textContent = originalText;
      }
      clearTimeout(overlayTimeout);
      hideBlockingOverlay();
    });
  }
  
  function cancelWorkflow() {
    // Navigate back to conversation
    if (window.scoutController && window.scoutController.loadScoutCanvas) {
      window.scoutController.loadScoutCanvas('conversation', {});
    } else {
      const event = new CustomEvent('scout:load-canvas', {
        detail: { canvas: 'conversation', data: {} }
      });
      document.dispatchEvent(event);
    }
    showMessage('Workflow cancelled', 'info');
  }
  
  function showMessage(message, type = 'info') {
    // This would integrate with the existing Scout message system
    console.log(`${type.toUpperCase()}: ${message}`);
  }
  
  // Make functions available globally for integration
  window.continueWorkflow = continueWorkflow;
  window.cancelWorkflow = cancelWorkflow;
  };
  
  // Initialize immediately
  initializeWizard();
  
  // Also initialize on turbo:load for full page navigations
  document.addEventListener('turbo:load', initializeWizard);
})();

// Simple blocking overlay helpers (Bootstrap-friendly)
function showBlockingOverlay(message) {
  if (document.getElementById('wizard-blocking-overlay')) return;
  const overlay = document.createElement('div');
  overlay.id = 'wizard-blocking-overlay';
  overlay.style.position = 'fixed';
  overlay.style.inset = '0';
  overlay.style.background = 'rgba(0,0,0,0.35)';
  overlay.style.zIndex = '1055';
  overlay.innerHTML = `
    <div class="d-flex align-items-center justify-content-center h-100">
      <div class="bg-white border rounded shadow p-3 d-flex align-items-center">
        <div class="spinner-border text-primary me-2" role="status"></div>
        <div>${message || 'Processing...'}</div>
      </div>
    </div>`;
  document.body.appendChild(overlay);
}

function hideBlockingOverlay() {
  const overlay = document.getElementById('wizard-blocking-overlay');
  if (overlay) overlay.remove();
}
</script>

<style>
.interactive-wizard-canvas {
  display: flex;
  flex-direction: column;
  height: 100%;
}

.wizard-content {
  flex: 1;
  overflow-y: auto;
}

.wizard-progress .progress {
  border-radius: 10px;
}

.wizard-actions {
  position: sticky;
  bottom: 0;
  background: white;
  z-index: 10;
}

.form-field-description {
  font-size: 0.875rem;
  color: #6c757d;
  margin-top: 0.25rem;
}

.wizard-header {
  flex-shrink: 0;
}

.wizard-footer {
  flex-shrink: 0;
}

/* Theme-specific styling */
.theme-clean .wizard-header {
  background: #f8f9fa;
}

.theme-modern .wizard-header {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: white;
}

.theme-professional .wizard-header {
  background: #343a40;
  color: white;
}
</style>
