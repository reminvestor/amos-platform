<div class="canvas-container" style="min-height: 100vh; padding: 2rem;">
  <!-- Page Header -->
  <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 2rem; flex-wrap: wrap; gap: 1rem;">
    <div style="display: flex; align-items: center; gap: 1rem; flex: 1;">
      <% if canvas_data[:integration][:icon_url].present? %>
        <img src="<%= canvas_data[:integration][:icon_url] %>"
             alt="<%= canvas_data[:integration][:name] %>"
             style="width: 3rem; height: 3rem; border-radius: 0.375rem; object-fit: contain;">
      <% else %>
        <div style="width: 3rem; height: 3rem; background: var(--accent-glow); border-radius: 0.375rem; display: flex; align-items: center; justify-content: center;">
          <i data-lucide="puzzle" class="canvas-icon-md canvas-icon-purple"></i>
        </div>
      <% end %>
      <div>
        <h1 class="canvas-page-title" style="display: flex; align-items: center; gap: 0.5rem;">
          Connect to <%= canvas_data[:integration][:name] %>
        </h1>
        <% if canvas_data[:integration][:description].present? %>
          <p class="canvas-page-subtitle" style="margin: 0.25rem 0 0 0;">
            <%= canvas_data[:integration][:description] %>
          </p>
        <% end %>
      </div>
    </div>
    <button onclick="goBackToIntegrations()"
            aria-label="Back to integrations"
            class="canvas-btn secondary">
      <i data-lucide="arrow-left" class="canvas-icon-sm"></i>
      Back to Integrations
    </button>
  </div>

  <!-- Connection Form -->
  <div style="max-width: 600px; margin: 0 auto;">
    <div class="canvas-card" style="padding: 2rem;">
      <form id="integrationConnectForm" onsubmit="submitConnection(event)">
        <%= hidden_field_tag :authenticity_token, form_authenticity_token %>

        <!-- Connection Name -->
        <div style="margin-bottom: 1.5rem;">
          <label for="connection_name" style="color: var(--text-primary); font-weight: 600; display: block; margin-bottom: 0.5rem;">
            Connection Name
          </label>
          <input type="text"
                 id="connection_name"
                 name="connection_name"
                 value="<%= canvas_data[:integration][:name] %> - <%= canvas_data[:user_email] %>"
                 required
                 class="canvas-input" style="width: 100%; padding: 0.75rem; font-size: 0.875rem;">
          <p style="color: var(--text-muted); font-size: 0.875rem; margin: 0.25rem 0 0 0;">A friendly name to identify this connection</p>
        </div>

        <!-- Auth Fields -->
        <% if canvas_data[:integration][:auth_configs]&.any? %>
          <%# Database-configured dynamic auth fields %>
          <% canvas_data[:integration][:auth_configs].sort_by { |ac| ac[:position] }.each do |auth_config| %>
            <%
              # Extract ALL placeholder names from auth_value like {api_key}, {api_secret}, etc.
              placeholders = auth_config[:auth_value].to_s.scan(/\{(\w+)\}/).flatten
              # If no placeholders, use auth_key as the single field
              placeholders = [auth_config[:auth_key]] if placeholders.empty?
            %>
            <% placeholders.each do |field_name| %>
              <div style="margin-bottom: 1.5rem;">
                <label for="<%= field_name %>" style="color: var(--text-primary); font-weight: 600; display: block; margin-bottom: 0.5rem;">
                  <%= field_name.gsub('_', ' ').titleize %>
                </label>
                <input type="password"
                       id="<%= field_name %>"
                       name="<%= field_name %>"
                       placeholder="Enter your <%= field_name.gsub('_', ' ').downcase %>"
                       required
                       class="canvas-input" style="width: 100%; padding: 0.75rem; font-size: 0.875rem;">
                <% if placeholders.length > 1 && field_name == placeholders.last %>
                  <p style="color: var(--text-muted); font-size: 0.875rem; margin: 0.25rem 0 0 0;">
                    Will be sent as: <code style="background: var(--accent-glow); color: var(--accent-purple-end); padding: 0.25rem 0.5rem; border-radius: 0.25rem; font-size: 0.75rem;"><%= auth_config[:auth_key] %>: <%= auth_config[:auth_value].gsub(/\{(\w+)\}/, '[your value]') %></code>
                    via <%= auth_config[:auth_placement].humanize %>
                  </p>
                <% elsif placeholders.length == 1 %>
                  <p style="color: var(--text-muted); font-size: 0.875rem; margin: 0.25rem 0 0 0;">
                    <% if auth_config[:auth_value].present? && auth_config[:auth_value] != "{#{field_name}}" %>
                      Will be sent as: <code style="background: var(--accent-glow); color: var(--accent-purple-end); padding: 0.25rem 0.5rem; border-radius: 0.25rem; font-size: 0.75rem;"><%= auth_config[:auth_key] %>: <%= auth_config[:auth_value].gsub(/\{(\w+)\}/, '[your value]') %></code>
                      via <%= auth_config[:auth_placement].humanize %>
                    <% else %>
                      Sent as <%= auth_config[:auth_key] %> via <%= auth_config[:auth_placement].humanize %>
                    <% end %>
                  </p>
                <% end %>
              </div>
            <% end %>
          <% end %>
        <% else %>
          <%# No auth config found - needs admin setup %>
          <div style="background: var(--status-warning-bg); border: 1px solid var(--status-warning-border); border-radius: 0.375rem; padding: 1.5rem; margin-bottom: 1.5rem;">
            <div style="display: flex; align-items: flex-start; gap: 1rem;">
              <i data-lucide="alert-triangle" class="canvas-icon-md canvas-icon-warning" style="flex-shrink: 0; margin-top: 0.125rem;"></i>
              <div>
                <h5 style="color: var(--text-primary); margin: 0 0 0.5rem 0; font-weight: 600;">Authentication not configured</h5>
                <p style="color: var(--text-muted); margin: 0; font-size: 0.875rem;">
                  This integration hasn't been set up yet. Please contact an administrator to configure the authentication settings for <%= canvas_data[:integration][:name] %>.
                </p>
              </div>
            </div>
          </div>
        <% end %>

        <!-- Action Buttons -->
        <div style="display: flex; gap: 1rem; margin-top: 2rem; flex-wrap: wrap;">
          <button type="button"
                  onclick="goBackToIntegrations()"
                  class="canvas-btn secondary" style="flex: 1; min-width: 150px;">
            Cancel
          </button>
          <button type="submit"
                  id="connectBtn"
                  aria-label="Connect to <%= canvas_data[:integration][:name] %>"
                  class="canvas-btn primary" style="flex: 1; min-width: 150px;">
            <i data-lucide="link" class="canvas-icon-sm"></i>
            Connect to <%= canvas_data[:integration][:name] %>
          </button>
        </div>
      </form>
    </div>

    <!-- Help Section -->
    <div class="canvas-card" style="padding: 1.5rem; margin-top: 1.5rem;">
      <h6 style="color: var(--text-primary); margin: 0 0 1rem 0; font-weight: 600; display: flex; align-items: center; gap: 0.5rem;">
        <i data-lucide="help-circle" class="canvas-icon-sm canvas-icon-cyan"></i>
        Need Help?
      </h6>
      <p style="color: var(--text-muted); margin: 0; font-size: 0.875rem;">
        Having trouble connecting?
        <% if canvas_data[:integration][:documentation_url].present? %>
          Check the <a href="<%= canvas_data[:integration][:documentation_url] %>" target="_blank" class="canvas-link"><%= canvas_data[:integration][:name] %> documentation</a>
        <% else %>
          Check the <%= canvas_data[:integration][:name] %> documentation
        <% end %>
        for setup instructions, or contact our support team.
      </p>
    </div>
  </div>
</div>

<script>
function goBackToIntegrations() {
  // Load integrations canvas without page reload
  if (window.scoutLoadCanvas) {
    window.scoutLoadCanvas('integrations_manager', {});
  } else {
    // Fallback - navigate to chat
    window.location.href = '/chat';
  }
}

function submitConnection(event) {
  event.preventDefault();

  const form = event.target;
  const formData = new FormData(form);
  const connectBtn = document.getElementById('connectBtn');
  const originalText = connectBtn.innerHTML;

  // Show loading state
  connectBtn.disabled = true;
  connectBtn.innerHTML = '<i data-lucide="loader-circle" style="width: 1rem; height: 1rem;"></i> Connecting...';
  if (typeof lucide !== 'undefined') {
    lucide.createIcons();
  }

  // Convert FormData to JSON object
  const jsonData = {};
  for (let [key, value] of formData.entries()) {
    jsonData[key] = value;
  }

  console.log('Submitting connection data:', jsonData);

  // Get CSRF token
  const csrfToken = document.querySelector('meta[name="csrf-token"]')?.getAttribute('content') ||
                   document.querySelector('input[name="authenticity_token"]')?.value ||
                   '<%= form_authenticity_token %>';

  // Submit via fetch
  fetch(`/integrations/connect/<%= canvas_data[:integration][:slug] %>`, {
    method: 'POST',
    body: JSON.stringify(jsonData),
    headers: {
      'Content-Type': 'application/json',
      'X-CSRF-Token': csrfToken,
      'Accept': 'application/json'
    }
  })
  .then(response => response.json())
  .then(data => {
    if (data.success) {
      // Show success and go back to integrations
      showNotification('success', data.message || 'Successfully connected!');
      setTimeout(() => {
        goBackToIntegrations();
      }, 1500);
    } else {
      // Show error
      showNotification('error', data.error || 'Connection failed');
      connectBtn.disabled = false;
      connectBtn.innerHTML = originalText;
    }
  })
  .catch(error => {
    console.error('Connection error:', error);
    showNotification('error', 'An error occurred while connecting');
    connectBtn.disabled = false;
    connectBtn.innerHTML = originalText;
  });
}

function showNotification(type, message) {
  // Use global toast system if available, otherwise fallback
  if (type === 'success' && window.showSuccess) {
    window.showSuccess(message);
  } else if (type === 'error' && window.showError) {
    window.showError(message);
  } else if (window.showToast) {
    window.showToast(message, { type: type === 'success' ? 'success' : 'error' });
  } else {
    // Fallback inline notification
    const notification = document.createElement('div');
    notification.style.cssText = `
      position: fixed; top: 20px; right: 20px; z-index: 9999; min-width: 300px;
      background: ${type === 'success' ? 'rgba(74, 222, 128, 0.2)' : 'rgba(248, 113, 113, 0.2)'};
      border: 1px solid ${type === 'success' ? 'rgb(74, 222, 128)' : 'rgb(248, 113, 113)'};
      border-radius: 0.375rem; color: ${type === 'success' ? 'rgb(74, 222, 128)' : 'rgb(248, 113, 113)'};
      padding: 1rem; display: flex; align-items: center; gap: 0.75rem;
    `;
    notification.innerHTML = `<i data-lucide="${type === 'success' ? 'check-circle' : 'alert-circle'}" style="width: 1rem; height: 1rem;"></i><span>${message}</span>`;
    document.body.appendChild(notification);
    if (typeof lucide !== 'undefined') lucide.createIcons();
    setTimeout(() => { if (notification.parentNode) notification.parentNode.removeChild(notification); }, 5000);
  }
}

// Lucide icon initialization
document.addEventListener('turbo:load', () => {
  if (typeof lucide !== 'undefined') {
    lucide.createIcons();
  }
});

document.addEventListener('DOMContentLoaded', () => {
  if (typeof lucide !== 'undefined') {
    lucide.createIcons();
  }
});
</script>
