<div style="background-color: #0A0E1A; color: #FFFFFF; min-height: 100vh; padding: 2rem;">
  <!-- Page Header -->
  <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 2rem; flex-wrap: wrap; gap: 1rem;">
    <div style="display: flex; align-items: center; gap: 1rem; flex: 1;">
      <% if canvas_data[:integration][:icon_url].present? %>
        <img src="<%= canvas_data[:integration][:icon_url] %>"
             alt="<%= canvas_data[:integration][:name] %>"
             style="width: 3rem; height: 3rem; border-radius: 0.375rem; object-fit: contain;">
      <% else %>
        <div style="width: 3rem; height: 3rem; background: rgba(124, 58, 237, 0.2); border-radius: 0.375rem; display: flex; align-items: center; justify-content: center;">
          <i data-lucide="puzzle" style="width: 1.5rem; height: 1.5rem; color: #A78BFA;"></i>
        </div>
      <% end %>
      <div>
        <h1 style="color: #FFFFFF; font-size: 1.75rem; font-weight: 700; margin: 0; display: flex; align-items: center; gap: 0.5rem;">
          Connect to <%= canvas_data[:integration][:name] %>
        </h1>
        <% if canvas_data[:integration][:description].present? %>
          <p style="color: #94A3B8; margin: 0.25rem 0 0 0;">
            <%= canvas_data[:integration][:description] %>
          </p>
        <% end %>
      </div>
    </div>
    <button onclick="goBackToIntegrations()"
            aria-label="Back to integrations"
            style="background: transparent; color: #22D3EE; border: 1px solid #22D3EE; padding: 0.5rem 1rem; border-radius: 0.375rem; cursor: pointer; display: inline-flex; align-items: center; gap: 0.5rem; font-weight: 500; flex-shrink: 0;">
      <i data-lucide="arrow-left" style="width: 1rem; height: 1rem;"></i>
      Back to Integrations
    </button>
  </div>

  <!-- Connection Form -->
  <div style="max-width: 600px; margin: 0 auto;">
    <div style="background: #1A1F35; border: 1px solid #1E293B; border-radius: 0.75rem; padding: 2rem;">
      <form id="integrationConnectForm" onsubmit="submitConnection(event)">
        <%= hidden_field_tag :authenticity_token, form_authenticity_token %>

        <!-- Connection Name -->
        <div style="margin-bottom: 1.5rem;">
          <label for="connection_name" style="color: #FFFFFF; font-weight: 600; display: block; margin-bottom: 0.5rem;">
            Connection Name
          </label>
          <input type="text"
                 id="connection_name"
                 name="connection_name"
                 value="<%= canvas_data[:integration][:name] %> - <%= canvas_data[:user_email] %>"
                 required
                 style="width: 100%; background: #0F172A; border: 1px solid #1E293B; border-radius: 0.375rem; padding: 0.75rem; color: #FFFFFF; font-size: 0.875rem;">
          <p style="color: #64748B; font-size: 0.875rem; margin: 0.25rem 0 0 0;">A friendly name to identify this connection</p>
        </div>

        <!-- Auth Fields -->
        <% if canvas_data[:integration][:auth_configs]&.any? %>
          <%# Database-configured dynamic auth fields %>
          <% canvas_data[:integration][:auth_configs].sort_by { |ac| ac[:position] }.each do |auth_config| %>
            <%
              # Extract placeholder names from auth_value like {api_key}, {token}, etc.
              placeholders = auth_config[:auth_value].to_s.scan(/\{(\w+)\}/).flatten
              # Use first placeholder as field name, or fall back to auth_key
              field_name = placeholders.first || auth_config[:auth_key]
            %>
            <div style="margin-bottom: 1.5rem;">
              <label for="<%= field_name %>" style="color: #FFFFFF; font-weight: 600; display: block; margin-bottom: 0.5rem;">
                <%= field_name.gsub('_', ' ').titleize %>
              </label>
              <input type="password"
                     id="<%= field_name %>"
                     name="<%= field_name %>"
                     placeholder="Enter your <%= field_name.gsub('_', ' ').downcase %>"
                     required
                     style="width: 100%; background: #0F172A; border: 1px solid #1E293B; border-radius: 0.375rem; padding: 0.75rem; color: #FFFFFF; font-size: 0.875rem;">
              <p style="color: #64748B; font-size: 0.875rem; margin: 0.25rem 0 0 0;">
                <% if auth_config[:auth_value].present? && auth_config[:auth_value] != "{#{field_name}}" %>
                  Will be sent as: <code style="background: rgba(124, 58, 237, 0.2); color: #A78BFA; padding: 0.25rem 0.5rem; border-radius: 0.25rem; font-size: 0.75rem;"><%= auth_config[:auth_key] %>: <%= auth_config[:auth_value].gsub(/\{(\w+)\}/, '[your value]') %></code>
                  via <%= auth_config[:auth_placement].humanize %>
                <% else %>
                  Sent as <%= auth_config[:auth_key] %> via <%= auth_config[:auth_placement].humanize %>
                <% end %>
              </p>
            </div>
          <% end %>
        <% else %>
          <%# No auth config found - needs admin setup %>
          <div style="background: rgba(250, 204, 21, 0.1); border: 1px solid rgba(250, 204, 21, 0.3); border-radius: 0.375rem; padding: 1.5rem; margin-bottom: 1.5rem;">
            <div style="display: flex; align-items: flex-start; gap: 1rem;">
              <i data-lucide="alert-triangle" style="width: 1.5rem; height: 1.5rem; color: rgb(250, 204, 21); flex-shrink: 0; margin-top: 0.125rem;"></i>
              <div>
                <h5 style="color: #FFFFFF; margin: 0 0 0.5rem 0; font-weight: 600;">Authentication not configured</h5>
                <p style="color: #94A3B8; margin: 0; font-size: 0.875rem;">
                  This integration hasn't been set up yet. Please contact an administrator to configure the authentication settings for <%= canvas_data[:integration][:name] %>.
                </p>
              </div>
            </div>
          </div>
        <% end %>

        <!-- Action Buttons -->
        <div style="display: flex; gap: 1rem; margin-top: 2rem; flex-wrap: wrap;">
          <button type="button"
                  onclick="goBackToIntegrations()"
                  style="background: transparent; color: #94A3B8; border: 1px solid #1E293B; padding: 0.5rem 1.5rem; border-radius: 0.375rem; cursor: pointer; font-weight: 500; flex: 1; min-width: 150px;">
            Cancel
          </button>
          <button type="submit"
                  id="connectBtn"
                  aria-label="Connect to <%= canvas_data[:integration][:name] %>"
                  style="background: linear-gradient(135deg, #7C3AED 0%, #A78BFA 100%); color: white; border: none; padding: 0.5rem 1.5rem; border-radius: 0.375rem; cursor: pointer; display: inline-flex; align-items: center; justify-content: center; gap: 0.5rem; font-weight: 500; flex: 1; min-width: 150px;">
            <i data-lucide="link" style="width: 1rem; height: 1rem;"></i>
            Connect to <%= canvas_data[:integration][:name] %>
          </button>
        </div>
      </form>
    </div>

    <!-- Help Section -->
    <div style="background: #1A1F35; border: 1px solid #1E293B; border-radius: 0.75rem; padding: 1.5rem; margin-top: 1.5rem;">
      <h6 style="color: #FFFFFF; margin: 0 0 1rem 0; font-weight: 600; display: flex; align-items: center; gap: 0.5rem;">
        <i data-lucide="help-circle" style="width: 1rem; height: 1rem; color: #22D3EE;"></i>
        Need Help?
      </h6>
      <p style="color: #94A3B8; margin: 0; font-size: 0.875rem;">
        Having trouble connecting?
        <% if canvas_data[:integration][:documentation_url].present? %>
          Check the <a href="<%= canvas_data[:integration][:documentation_url] %>" target="_blank" style="color: #22D3EE; text-decoration: none; border-bottom: 1px solid #22D3EE;"><%= canvas_data[:integration][:name] %> documentation</a>
        <% else %>
          Check the <%= canvas_data[:integration][:name] %> documentation
        <% end %>
        for setup instructions, or contact our support team.
      </p>
    </div>
  </div>
</div>

<script>
function goBackToIntegrations() {
  // Redirect to Scout with integrations parameter
  window.location.href = '/scout?load=integrations';
}

function submitConnection(event) {
  event.preventDefault();

  const form = event.target;
  const formData = new FormData(form);
  const connectBtn = document.getElementById('connectBtn');
  const originalText = connectBtn.innerHTML;

  // Show loading state
  connectBtn.disabled = true;
  connectBtn.innerHTML = '<i data-lucide="loader-circle" style="width: 1rem; height: 1rem;"></i> Connecting...';
  if (typeof lucide !== 'undefined') {
    lucide.createIcons();
  }

  // Convert FormData to JSON object
  const jsonData = {};
  for (let [key, value] of formData.entries()) {
    jsonData[key] = value;
  }

  console.log('Submitting connection data:', jsonData);

  // Get CSRF token
  const csrfToken = document.querySelector('meta[name="csrf-token"]')?.getAttribute('content') ||
                   document.querySelector('input[name="authenticity_token"]')?.value ||
                   '<%= form_authenticity_token %>';

  // Submit via fetch
  fetch(`/integrations/connect/<%= canvas_data[:integration][:slug] %>`, {
    method: 'POST',
    body: JSON.stringify(jsonData),
    headers: {
      'Content-Type': 'application/json',
      'X-CSRF-Token': csrfToken,
      'Accept': 'application/json'
    }
  })
  .then(response => response.json())
  .then(data => {
    if (data.success) {
      // Show success and go back to integrations
      showNotification('success', data.message || 'Successfully connected!');
      setTimeout(() => {
        goBackToIntegrations();
      }, 1500);
    } else {
      // Show error
      showNotification('error', data.error || 'Connection failed');
      connectBtn.disabled = false;
      connectBtn.innerHTML = originalText;
    }
  })
  .catch(error => {
    console.error('Connection error:', error);
    showNotification('error', 'An error occurred while connecting');
    connectBtn.disabled = false;
    connectBtn.innerHTML = originalText;
  });
}

function showNotification(type, message) {
  // Create a simple notification
  const notification = document.createElement('div');
  notification.style.cssText = `
    position: fixed;
    top: 20px;
    right: 20px;
    z-index: 9999;
    min-width: 300px;
    background: ${type === 'success' ? 'rgba(74, 222, 128, 0.2)' : 'rgba(248, 113, 113, 0.2)'};
    border: 1px solid ${type === 'success' ? 'rgb(74, 222, 128)' : 'rgb(248, 113, 113)'};
    border-radius: 0.375rem;
    color: ${type === 'success' ? 'rgb(74, 222, 128)' : 'rgb(248, 113, 113)'};
    padding: 1rem;
    display: flex;
    align-items: center;
    gap: 0.75rem;
  `;

  notification.innerHTML = `
    <i data-lucide="${type === 'success' ? 'check-circle' : 'alert-circle'}" style="width: 1rem; height: 1rem;"></i>
    <span>${message}</span>
  `;

  document.body.appendChild(notification);

  // Initialize Lucide icon
  if (typeof lucide !== 'undefined') {
    lucide.createIcons();
  }

  // Remove after 5 seconds
  setTimeout(() => {
    if (notification.parentNode) {
      notification.parentNode.removeChild(notification);
    }
  }, 5000);
}

// Lucide icon initialization
document.addEventListener('turbo:load', () => {
  if (typeof lucide !== 'undefined') {
    lucide.createIcons();
  }
});

document.addEventListener('DOMContentLoaded', () => {
  if (typeof lucide !== 'undefined') {
    lucide.createIcons();
  }
});
</script>
