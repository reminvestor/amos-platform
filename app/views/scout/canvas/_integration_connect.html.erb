<div class="canvas-container bg-dark text-white p-4">
  <div class="canvas-header mb-4">
    <div class="d-flex align-items-center justify-content-between">
      <div class="d-flex align-items-center">
        <% if canvas_data[:integration][:icon_url].present? %>
          <img src="<%= canvas_data[:integration][:icon_url] %>" 
               alt="<%= canvas_data[:integration][:name] %>" 
               class="rounded me-3" style="width: 48px; height: 48px;">
        <% else %>
          <i data-lucide="puzzle" class="icon-3x text-muted me-3" aria-hidden="true"></i>
        <% end %>
        <div>
          <h3 class="text-white mb-1">Connect to <%= canvas_data[:integration][:name] %></h3>
          <% if canvas_data[:integration][:description].present? %>
            <p class="text-muted mb-0"><%= canvas_data[:integration][:description] %></p>
          <% end %>
        </div>
      </div>
      <button class="btn btn-outline-secondary" onclick="goBackToIntegrations()" aria-label="Back to integrations">
        <i data-lucide="arrow-left" aria-hidden="true"></i> Back to Integrations
      </button>
    </div>
  </div>

  <div class="row justify-content-center">
    <div class="col-lg-8">
      <div class="card bg-white text-dark">
        <div class="card-body">
          <form id="integrationConnectForm" onsubmit="submitConnection(event)">
            <%= hidden_field_tag :authenticity_token, form_authenticity_token %>
            
            <div class="mb-3">
              <label for="connection_name" class="form-label">Connection Name</label>
              <input type="text" 
                     class="form-control" 
                     id="connection_name" 
                     name="connection_name"
                     value="<%= canvas_data[:integration][:name] %> - <%= canvas_data[:user_email] %>"
                     required>
              <div class="form-text">A friendly name to identify this connection</div>
            </div>
            
            <% if canvas_data[:integration][:auth_configs]&.any? %>
              <%# Database-configured dynamic auth fields %>
              <% canvas_data[:integration][:auth_configs].sort_by { |ac| ac[:position] }.each do |auth_config| %>
                <% 
                  # Extract placeholder names from auth_value like {api_key}, {token}, etc.
                  placeholders = auth_config[:auth_value].to_s.scan(/\{(\w+)\}/).flatten
                  # Use first placeholder as field name, or fall back to auth_key
                  field_name = placeholders.first || auth_config[:auth_key]
                %>
                <div class="mb-3">
                  <label for="<%= field_name %>" class="form-label">
                    <%= field_name.gsub('_', ' ').titleize %>
                  </label>
                  <input type="password" 
                         class="form-control" 
                         id="<%= field_name %>" 
                         name="<%= field_name %>"
                         placeholder="Enter your <%= field_name.gsub('_', ' ').downcase %>"
                         required>
                  <div class="form-text">
                    <% if auth_config[:auth_value].present? && auth_config[:auth_value] != "{#{field_name}}" %>
                      Will be sent as: <code><%= auth_config[:auth_key] %>: <%= auth_config[:auth_value].gsub(/\{(\w+)\}/, '[your value]') %></code>
                      via <%= auth_config[:auth_placement].humanize %>
                    <% else %>
                      Sent as <%= auth_config[:auth_key] %> via <%= auth_config[:auth_placement].humanize %>
                    <% end %>
                  </div>
                </div>
              <% end %>
            <% else %>
              <%# No auth config found - needs admin setup %>
              <div class="alert alert-warning">
                <i data-lucide="alert-triangle" aria-hidden="true"></i>
                <strong>Authentication not configured</strong><br>
                This integration hasn't been set up yet. Please contact an administrator to configure the authentication settings for <%= canvas_data[:integration][:name] %>.
              </div>
            <% end %>
            
            <div class="d-grid gap-2 d-md-flex justify-content-md-end mt-4">
              <button type="button" class="btn btn-secondary me-md-2" onclick="goBackToIntegrations()">
                Cancel
              </button>
              <button type="submit" class="btn btn-primary" id="connectBtn" aria-label="Connect to <%= canvas_data[:integration][:name] %>">
                <i data-lucide="link" aria-hidden="true"></i> Connect to <%= canvas_data[:integration][:name] %>
              </button>
            </div>
            
          </form>
        </div>
      </div>
      
      <!-- Help Section -->
      <div class="card bg-secondary mt-3">
        <div class="card-body">
          <h6 class="card-title text-white">
            <i data-lucide="help-circle" class="text-info" aria-hidden="true"></i> Need Help?
          </h6>
          <p class="card-text small text-muted">
            Having trouble connecting? 
            <% if canvas_data[:integration][:documentation_url].present? %>
              Check the <a href="<%= canvas_data[:integration][:documentation_url] %>" target="_blank" class="text-info"><%= canvas_data[:integration][:name] %> documentation</a>
            <% else %>
              Check the <%= canvas_data[:integration][:name] %> documentation
            <% end %>
            for setup instructions, or contact our support team.
          </p>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
function goBackToIntegrations() {
  // Redirect to Scout with integrations parameter
  window.location.href = '/scout?load=integrations';
}

function submitConnection(event) {
  event.preventDefault();
  
  const form = event.target;
  const formData = new FormData(form);
  const connectBtn = document.getElementById('connectBtn');
  const originalText = connectBtn.innerHTML;
  
  // Show loading state
  connectBtn.disabled = true;
  connectBtn.innerHTML = '<i data-lucide="loader-circle" class="icon-spin" aria-hidden="true"></i> Connecting...';
  if (typeof lucide !== 'undefined') {
    lucide.createIcons();
  }
  
  // Convert FormData to JSON object
  const jsonData = {};
  for (let [key, value] of formData.entries()) {
    jsonData[key] = value;
  }
  
  console.log('Submitting connection data:', jsonData);
  
  // Get CSRF token
  const csrfToken = document.querySelector('meta[name="csrf-token"]')?.getAttribute('content') || 
                   document.querySelector('input[name="authenticity_token"]')?.value || 
                   '<%= form_authenticity_token %>';
  
  // Submit via fetch
  fetch(`/integrations/connect/<%= canvas_data[:integration][:slug] %>`, {
    method: 'POST',
    body: JSON.stringify(jsonData),
    headers: {
      'Content-Type': 'application/json',
      'X-CSRF-Token': csrfToken,
      'Accept': 'application/json'
    }
  })
  .then(response => response.json())
  .then(data => {
    if (data.success) {
      // Show success and go back to integrations
      showNotification('success', data.message || 'Successfully connected!');
      setTimeout(() => {
        goBackToIntegrations();
      }, 1500);
    } else {
      // Show error
      showNotification('error', data.error || 'Connection failed');
      connectBtn.disabled = false;
      connectBtn.innerHTML = originalText;
    }
  })
  .catch(error => {
    console.error('Connection error:', error);
    showNotification('error', 'An error occurred while connecting');
    connectBtn.disabled = false;
    connectBtn.innerHTML = originalText;
  });
}

function showNotification(type, message) {
  // Create a simple notification
  const notification = document.createElement('div');
  notification.className = `alert alert-${type === 'success' ? 'success' : 'danger'} position-fixed`;
  notification.style.cssText = 'top: 20px; right: 20px; z-index: 9999; min-width: 300px;';
  notification.innerHTML = `
    <i data-lucide="${type === 'success' ? 'check-circle' : 'alert-circle'}" aria-hidden="true"></i>
    ${message}
  `;

  document.body.appendChild(notification);

  // Initialize Lucide icon
  if (typeof lucide !== 'undefined') {
    lucide.createIcons();
  }
  
  // Remove after 5 seconds
  setTimeout(() => {
    if (notification.parentNode) {
      notification.parentNode.removeChild(notification);
    }
  }, 5000);
}
</script>
