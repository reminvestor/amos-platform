<div class="saved-visualizations-canvas">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <div>
      <h4 class="mb-1">
        <i data-lucide="bookmark" class="me-2"></i>
        Saved Visualizations
      </h4>
      <p class="text-muted mb-0 small">Your saved reports, dashboards, and analyses</p>
    </div>
    <div class="btn-group btn-group-sm" role="group">
      <button type="button" class="btn btn-outline-light active" data-filter="all">All</button>
      <button type="button" class="btn btn-outline-light" data-filter="pinned">Pinned</button>
      <button type="button" class="btn btn-outline-light" data-filter="shared">Shared</button>
    </div>
  </div>

  <% visualizations = SavedVisualization.where(entity: current_entity, user: current_user)
                                        .not_archived
                                        .order(pinned: :desc, created_at: :desc)
                                        .limit(30) %>

  <% if visualizations.any? %>
    <div class="visualizations-grid">
      <% visualizations.each do |viz| %>
        <div class="viz-card <%= 'pinned' if viz.pinned? %>" data-viz-id="<%= viz.id %>">
          <div class="viz-header">
            <div class="d-flex align-items-center">
              <span class="viz-type-icon me-2">
                <% case viz.visualization_type %>
                <% when 'dashboard' %>
                  <i data-lucide="layout-dashboard" style="width: 18px; height: 18px;"></i>
                <% when 'report' %>
                  <i data-lucide="file-text" style="width: 18px; height: 18px;"></i>
                <% when 'chart' %>
                  <i data-lucide="bar-chart-2" style="width: 18px; height: 18px;"></i>
                <% when 'comparison' %>
                  <i data-lucide="git-compare" style="width: 18px; height: 18px;"></i>
                <% when 'table' %>
                  <i data-lucide="table" style="width: 18px; height: 18px;"></i>
                <% else %>
                  <i data-lucide="pie-chart" style="width: 18px; height: 18px;"></i>
                <% end %>
              </span>
              <div class="flex-grow-1">
                <h6 class="mb-0 viz-name"><%= viz.name %></h6>
                <% if viz.category.present? %>
                  <span class="badge bg-secondary small"><%= viz.category.capitalize %></span>
                <% end %>
              </div>
              <div class="viz-actions">
                <% if viz.pinned? %>
                  <i data-lucide="pin" class="text-warning" style="width: 14px; height: 14px;"></i>
                <% end %>
                <% if viz.shared? %>
                  <i data-lucide="users" class="text-info ms-1" style="width: 14px; height: 14px;"></i>
                <% end %>
              </div>
            </div>
          </div>
          <div class="viz-body">
            <% if viz.description.present? %>
              <p class="viz-description small text-muted mb-2"><%= truncate(viz.description, length: 100) %></p>
            <% end %>
            <div class="viz-meta small text-muted">
              <span><i data-lucide="clock" style="width: 12px; height: 12px;"></i> <%= time_ago_in_words(viz.created_at) %> ago</span>
              <% if viz.auto_refresh? %>
                <span class="ms-2"><i data-lucide="refresh-cw" style="width: 12px; height: 12px;"></i> Auto-refresh</span>
              <% end %>
            </div>
          </div>
          <div class="viz-footer">
            <button class="btn btn-sm btn-primary view-btn" data-viz-id="<%= viz.id %>">
              <i data-lucide="eye" style="width: 14px; height: 14px;"></i> View
            </button>
            <button class="btn btn-sm btn-outline-light pin-btn" data-viz-id="<%= viz.id %>" title="<%= viz.pinned? ? 'Unpin' : 'Pin' %>">
              <i data-lucide="pin" style="width: 14px; height: 14px;"></i>
            </button>
            <button class="btn btn-sm btn-outline-light share-btn" data-viz-id="<%= viz.id %>" title="<%= viz.shared? ? 'Unshare' : 'Share' %>">
              <i data-lucide="share-2" style="width: 14px; height: 14px;"></i>
            </button>
            <button class="btn btn-sm btn-outline-danger archive-btn" data-viz-id="<%= viz.id %>" title="Archive">
              <i data-lucide="archive" style="width: 14px; height: 14px;"></i>
            </button>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="empty-state text-center py-5">
      <i data-lucide="bookmark-plus" class="mb-3" style="width: 48px; height: 48px; color: rgba(255,255,255,0.5);"></i>
      <h5>No Saved Visualizations</h5>
      <p class="text-muted">
        When Scout creates a visualization, you can save it for later.<br>
        Try saying: "Save this visualization" after creating a report.
      </p>
    </div>
  <% end %>
</div>

<style>
  .saved-visualizations-canvas {
    height: 100%;
    overflow-y: auto;
    padding: 20px;
  }

  .visualizations-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 16px;
  }

  .viz-card {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 8px;
    overflow: hidden;
    transition: all 0.2s ease;
  }

  .viz-card:hover {
    background: rgba(255, 255, 255, 0.1);
    border-color: rgba(255, 255, 255, 0.2);
    transform: translateY(-2px);
  }

  .viz-card.pinned {
    border-color: rgba(255, 193, 7, 0.5);
  }

  .viz-header {
    padding: 12px 16px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }

  .viz-name {
    color: #fff;
    font-weight: 500;
  }

  .viz-type-icon {
    color: rgba(255, 255, 255, 0.7);
  }

  .viz-body {
    padding: 12px 16px;
  }

  .viz-description {
    color: rgba(255, 255, 255, 0.6);
  }

  .viz-meta {
    color: rgba(255, 255, 255, 0.5);
  }

  .viz-footer {
    padding: 12px 16px;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    display: flex;
    gap: 8px;
  }

  .empty-state {
    color: rgba(255, 255, 255, 0.7);
  }

  .btn-group .btn.active {
    background: rgba(255, 255, 255, 0.2);
  }
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
  // View button - load the visualization
  document.querySelectorAll('.view-btn').forEach(btn => {
    btn.addEventListener('click', function() {
      const vizId = this.dataset.vizId;
      const event = new CustomEvent('scout:send-message', {
        detail: { message: `Show me saved visualization #${vizId}` }
      });
      window.dispatchEvent(event);
    });
  });

  // Pin button
  document.querySelectorAll('.pin-btn').forEach(btn => {
    btn.addEventListener('click', function() {
      const vizId = this.dataset.vizId;
      const card = this.closest('.viz-card');
      card.classList.toggle('pinned');
      // TODO: Toggle pin via AJAX
    });
  });

  // Share button
  document.querySelectorAll('.share-btn').forEach(btn => {
    btn.addEventListener('click', function() {
      const vizId = this.dataset.vizId;
      // TODO: Toggle share via AJAX
    });
  });

  // Archive button
  document.querySelectorAll('.archive-btn').forEach(btn => {
    btn.addEventListener('click', function() {
      const vizId = this.dataset.vizId;
      const card = this.closest('.viz-card');
      card.style.opacity = '0.5';
      setTimeout(() => card.remove(), 300);
      // TODO: Archive via AJAX
    });
  });

  // Filter buttons
  document.querySelectorAll('[data-filter]').forEach(btn => {
    btn.addEventListener('click', function() {
      document.querySelectorAll('[data-filter]').forEach(b => b.classList.remove('active'));
      this.classList.add('active');
      
      const filter = this.dataset.filter;
      const cards = document.querySelectorAll('.viz-card');
      
      cards.forEach(card => {
        if (filter === 'all') {
          card.style.display = 'block';
        } else if (filter === 'pinned') {
          card.style.display = card.classList.contains('pinned') ? 'block' : 'none';
        } else if (filter === 'shared') {
          // TODO: Check shared status
          card.style.display = 'block';
        }
      });
    });
  });
});
</script>

