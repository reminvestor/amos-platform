<div class="scout-canvas campaign-viewer">
  <div class="canvas-header d-flex justify-content-between align-items-center mb-4">
    <div>
      <h4 class="mb-1">
        <i class="fas fa-envelope text-primary me-2"></i>
        Email Campaigns
      </h4>
      <p class="text-muted mb-0">Manage your email marketing campaigns</p>
    </div>
    <div class="d-flex gap-2">
      <button class="btn btn-outline-secondary" onclick="scoutViewTemplates()">
        <i class="fas fa-file-alt me-1"></i>
        Templates
      </button>
      <button class="btn btn-primary" onclick="scoutCreateCampaign()">
        <i class="fas fa-plus me-1"></i>
        Create Campaign
      </button>
    </div>
  </div>
  
  <!-- Campaign Stats -->
  <div class="row mb-4">
    <div class="col-md-3">
      <div class="stat-card bg-light border-0 h-100">
        <div class="stat-card-body p-3">
          <div class="d-flex align-items-center">
            <div class="stat-icon bg-primary bg-opacity-10 rounded-circle p-2 me-3">
              <i class="fas fa-envelope text-primary"></i>
            </div>
            <div>
              <div class="stat-number h5 mb-0"><%= number_with_delimiter(stats[:total_campaigns]) %></div>
              <div class="stat-label text-muted small">Total Campaigns</div>
            </div>
          </div>
        </div>
      </div>
    </div>
    <div class="col-md-3">
      <div class="stat-card bg-light border-0 h-100">
        <div class="stat-card-body p-3">
          <div class="d-flex align-items-center">
            <div class="stat-icon bg-success bg-opacity-10 rounded-circle p-2 me-3">
              <i class="fas fa-paper-plane text-success"></i>
            </div>
            <div>
              <div class="stat-number h5 mb-0"><%= number_with_delimiter(stats[:sent_campaigns]) %></div>
              <div class="stat-label text-muted small">Sent</div>
            </div>
          </div>
        </div>
      </div>
    </div>
    <div class="col-md-3">
      <div class="stat-card bg-light border-0 h-100">
        <div class="stat-card-body p-3">
          <div class="d-flex align-items-center">
            <div class="stat-icon bg-warning bg-opacity-10 rounded-circle p-2 me-3">
              <i class="fas fa-edit text-warning"></i>
            </div>
            <div>
              <div class="stat-number h5 mb-0"><%= number_with_delimiter(stats[:draft_campaigns]) %></div>
              <div class="stat-label text-muted small">Drafts</div>
            </div>
          </div>
        </div>
      </div>
    </div>
    <div class="col-md-3">
      <div class="stat-card bg-light border-0 h-100">
        <div class="stat-card-body p-3">
          <div class="d-flex align-items-center">
            <div class="stat-icon bg-info bg-opacity-10 rounded-circle p-2 me-3">
              <i class="fas fa-chart-line text-info"></i>
            </div>
            <div>
              <% avg_open_rate = campaigns.select { |c| c.mailgun_stats.present? }
                                         .map { |c| 
                                           sent = c.mailgun_stats['sent'] || 0
                                           opened = c.mailgun_stats['opened'] || 0
                                           sent > 0 ? (opened.to_f / sent * 100) : 0
                                         }
                                         .then { |rates| rates.any? ? rates.sum / rates.size : 0 } %>
              <div class="stat-number h5 mb-0"><%= number_with_precision(avg_open_rate, precision: 1) %>%</div>
              <div class="stat-label text-muted small">Avg Open Rate</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
  
  <!-- Filters -->
  <div class="row mb-4">
    <div class="col-md-4">
      <div class="input-group">
        <span class="input-group-text"><i class="fas fa-search"></i></span>
        <input type="text" class="form-control" id="campaignSearch" 
               placeholder="Search campaigns by name or subject">
      </div>
    </div>
    <div class="col-md-3">
      <select class="form-select" id="campaignStatusFilter">
        <option value="">All Statuses</option>
        <option value="draft">Draft</option>
        <option value="sent">Sent</option>
        <option value="scheduled">Scheduled</option>
      </select>
    </div>
    <div class="col-md-3">
      <select class="form-select" id="campaignGroupFilter">
        <option value="">All Groups</option>
        <% entity.contact_groups.each do |group| %>
          <option value="<%= group.id %>"><%= group.name %></option>
        <% end %>
      </select>
    </div>
    <div class="col-md-2">
      <select class="form-select" id="campaignSortFilter">
        <option value="recent">Most Recent</option>
        <option value="performance">Best Performance</option>
        <option value="name">Alphabetical</option>
      </select>
    </div>
  </div>
  
  <% if campaigns.any? %>
    <!-- Campaigns Table -->
    <div class="card border-0 shadow-sm">
      <div class="card-header bg-light d-flex justify-content-between align-items-center">
        <h6 class="mb-0">
          <i class="fas fa-list me-2"></i>
          Campaigns
        </h6>
        <div class="d-flex gap-2">
          <button class="btn btn-sm btn-outline-secondary" onclick="scoutExportCampaigns()">
            <i class="fas fa-download me-1"></i>
            Export
          </button>
          <button class="btn btn-sm btn-outline-primary" onclick="scoutAnalyzeCampaigns()">
            <i class="fas fa-chart-bar me-1"></i>
            Analyze
          </button>
        </div>
      </div>
      <div class="table-responsive">
        <table class="table table-hover mb-0" id="campaignsTable">
          <thead class="table-light">
            <tr>
              <th>Campaign</th>
              <th>Status</th>
              <th>Target Group</th>
              <th>Performance</th>
              <th>Sent Date</th>
              <th width="120">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% campaigns.each do |campaign| %>
              <tr data-campaign-id="<%= campaign.id %>">
                <td>
                  <div class="campaign-info">
                    <div class="fw-medium mb-1">
                      <%= campaign.name.present? ? campaign.name : "Untitled Campaign" %>
                    </div>
                    <small class="text-muted">
                      <%= campaign.email_template&.subject.present? ? truncate(campaign.email_template.subject, length: 50) : (campaign.description.present? ? truncate(campaign.description, length: 50) : "No subject") %>
                    </small>
                  </div>
                </td>
                <td>
                  <span class="badge <%= 
                    case campaign.status
                    when 'sent' then 'bg-success'
                    when 'draft' then 'bg-warning'
                    when 'scheduled' then 'bg-info'
                    else 'bg-secondary'
                    end
                  %>">
                    <%= campaign.status.titleize %>
                  </span>
                </td>
                <td>
                  <% if campaign.contact_groups.any? %>
                    <% campaign.contact_groups.each do |group| %>
                      <span class="badge bg-light text-dark">
                        <%= group.name %>
                      </span>
                    <% end %>
                    <br>
                    <small class="text-muted">
                      <%= pluralize(campaign.contacts.count, 'contact') %>
                    </small>
                  <% else %>
                    <span class="text-muted">No group</span>
                  <% end %>
                </td>
                <td>
                  <% if campaign.mailgun_stats.present? %>
                    <% 
                      sent = campaign.mailgun_stats['sent'] || 0
                      delivered = campaign.mailgun_stats['delivered'] || 0
                      opened = campaign.mailgun_stats['opened'] || 0
                      clicked = campaign.mailgun_stats['clicked'] || 0
                      
                      open_rate = sent > 0 ? (opened.to_f / sent * 100) : 0
                      click_rate = sent > 0 ? (clicked.to_f / sent * 100) : 0
                    %>
                    <div class="performance-metrics">
                      <div class="d-flex justify-content-between small">
                        <span>Sent:</span>
                        <strong><%= number_with_delimiter(sent) %></strong>
                      </div>
                      <div class="d-flex justify-content-between small">
                        <span>Open Rate:</span>
                        <strong class="<%= open_rate > 20 ? 'text-success' : open_rate > 10 ? 'text-warning' : 'text-danger' %>">
                          <%= number_with_precision(open_rate, precision: 1) %>%
                        </strong>
                      </div>
                      <div class="d-flex justify-content-between small">
                        <span>Click Rate:</span>
                        <strong class="<%= click_rate > 3 ? 'text-success' : click_rate > 1 ? 'text-warning' : 'text-danger' %>">
                          <%= number_with_precision(click_rate, precision: 1) %>%
                        </strong>
                      </div>
                    </div>
                  <% else %>
                    <span class="text-muted small">No data</span>
                  <% end %>
                </td>
                <td>
                  <% if campaign.sent_at.present? %>
                    <small class="text-muted">
                      <%= campaign.sent_at.strftime("%b %d, %Y") %><br>
                      <%= time_ago_in_words(campaign.sent_at) %> ago
                    </small>
                  <% elsif campaign.scheduled_at.present? %>
                    <small class="text-info">
                      Scheduled for<br>
                      <%= campaign.scheduled_at.strftime("%b %d, %Y at %l:%M %p") %>
                    </small>
                  <% else %>
                    <small class="text-muted">
                      Created <%= time_ago_in_words(campaign.created_at) %> ago
                    </small>
                  <% end %>
                </td>
                <td>
                  <div class="btn-group" role="group">
                    <button class="btn btn-sm btn-outline-secondary" 
                            onclick="scoutViewCampaign(<%= campaign.id %>)" 
                            title="View Details">
                      <i class="fas fa-eye"></i>
                    </button>
                    <% if campaign.status == 'draft' %>
                      <button class="btn btn-sm btn-outline-primary" 
                              onclick="scoutEditCampaign(<%= campaign.id %>)" 
                              title="Edit">
                        <i class="fas fa-edit"></i>
                      </button>
                    <% end %>
                    <div class="dropdown">
                      <button class="btn btn-sm btn-outline-secondary dropdown-toggle" 
                              data-bs-toggle="dropdown" title="More Actions">
                        <i class="fas fa-ellipsis-h"></i>
                      </button>
                      <ul class="dropdown-menu">
                        <% if campaign.status == 'sent' %>
                          <li><a class="dropdown-item" href="#" onclick="scoutAnalyzeCampaign(<%= campaign.id %>)">
                            <i class="fas fa-chart-line me-2"></i>View Analytics
                          </a></li>
                          <li><a class="dropdown-item" href="#" onclick="scoutDuplicateCampaign(<%= campaign.id %>)">
                            <i class="fas fa-copy me-2"></i>Duplicate
                          </a></li>
                        <% end %>
                        <% if campaign.status == 'draft' %>
                          <li><a class="dropdown-item" href="#" onclick="scoutSendCampaign(<%= campaign.id %>)">
                            <i class="fas fa-paper-plane me-2"></i>Send Campaign
                          </a></li>
                          <li><a class="dropdown-item" href="#" onclick="scoutScheduleCampaign(<%= campaign.id %>)">
                            <i class="fas fa-clock me-2"></i>Schedule
                          </a></li>
                        <% end %>
                        <li><hr class="dropdown-divider"></li>
                        <li><a class="dropdown-item text-danger" href="#" onclick="scoutDeleteCampaign(<%= campaign.id %>)">
                          <i class="fas fa-trash me-2"></i>Delete
                        </a></li>
                      </ul>
                    </div>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
      <div class="card-footer bg-light">
        <div class="d-flex justify-content-between align-items-center">
          <small class="text-muted">
            Showing <%= campaigns.count %> of <%= stats[:total_campaigns] %> campaigns
          </small>
          <div class="d-flex gap-2">
            <button class="btn btn-sm btn-outline-secondary" onclick="scoutLoadMoreCampaigns()">
              Load More
            </button>
            <button class="btn btn-sm btn-primary" onclick="scoutCreateCampaign()">
              <i class="fas fa-plus me-1"></i>
              Create Campaign
            </button>
          </div>
        </div>
      </div>
    </div>
  <% else %>
    <!-- Empty State -->
    <div class="empty-state text-center py-5">
      <div class="empty-icon mb-3">
        <i class="fas fa-envelope text-muted" style="font-size: 4rem;"></i>
      </div>
      <h5 class="text-muted">No campaigns yet</h5>
      <p class="text-muted mb-4">
        Start reaching your audience by creating your first email campaign.<br>
        Email campaigns are a powerful way to engage customers and drive conversions.
      </p>
      <div class="d-flex gap-2 justify-content-center">
        <button class="btn btn-primary" onclick="scoutCreateCampaign()">
          <i class="fas fa-plus me-2"></i>
          Create Your First Campaign
        </button>
        <button class="btn btn-outline-secondary" onclick="scoutViewTemplates()">
          <i class="fas fa-file-alt me-2"></i>
          Browse Templates
        </button>
      </div>
    </div>
  <% end %>
</div>

<script>
// Campaign viewer functionality
function scoutCreateCampaign() {
  window.scoutSendMessage?.("Create a new email campaign");
}

function scoutViewCampaign(campaignId) {
  window.scoutSendMessage?.(`Load the campaign editor for campaign ID ${campaignId}`);
}

function scoutEditCampaign(campaignId) {
  window.scoutSendMessage?.(`Load the campaign editor for campaign ID ${campaignId}`);
}

function scoutDeleteCampaign(campaignId) {
  if (confirm('Are you sure you want to delete this campaign?')) {
    window.scoutSendMessage?.(`Delete campaign ${campaignId}`);
  }
}

function scoutAnalyzeCampaign(campaignId) {
  window.scoutSendMessage?.(`Analyze performance for campaign ${campaignId}`);
}

function scoutDuplicateCampaign(campaignId) {
  window.scoutSendMessage?.(`Duplicate campaign ${campaignId}`);
}

function scoutSendCampaign(campaignId) {
  if (confirm('Are you ready to send this campaign?')) {
    window.scoutSendMessage?.(`Send campaign ${campaignId} now`);
  }
}

function scoutScheduleCampaign(campaignId) {
  window.scoutSendMessage?.(`Schedule campaign ${campaignId} for later`);
}

function scoutAnalyzeCampaigns() {
  window.scoutLoadCanvas?.('analytics_dashboard');
}

function scoutExportCampaigns() {
  window.scoutSendMessage?.("Export campaign performance data");
}

function scoutViewTemplates() {
  window.scoutSendMessage?.("Show me email templates");
}

function scoutLoadMoreCampaigns() {
  window.scoutSendMessage?.("Load more campaigns");
}

// Search and filter functionality
document.addEventListener('DOMContentLoaded', function() {
  const searchInput = document.getElementById('campaignSearch');
  const statusFilter = document.getElementById('campaignStatusFilter');
  const groupFilter = document.getElementById('campaignGroupFilter');
  const sortFilter = document.getElementById('campaignSortFilter');
  
  if (searchInput) {
    searchInput.addEventListener('input', debounce(filterCampaigns, 300));
  }
  
  if (statusFilter) {
    statusFilter.addEventListener('change', filterCampaigns);
  }
  
  if (groupFilter) {
    groupFilter.addEventListener('change', filterCampaigns);
  }
  
  if (sortFilter) {
    sortFilter.addEventListener('change', sortCampaigns);
  }
});

function filterCampaigns() {
  const searchTerm = document.getElementById('campaignSearch')?.value.toLowerCase() || '';
  const statusFilter = document.getElementById('campaignStatusFilter')?.value || '';
  const groupFilter = document.getElementById('campaignGroupFilter')?.value || '';
  const rows = document.querySelectorAll('#campaignsTable tbody tr');
  
  rows.forEach(row => {
    const campaignName = row.querySelector('td:nth-child(1)')?.textContent.toLowerCase() || '';
    const status = row.querySelector('td:nth-child(2)')?.textContent.toLowerCase() || '';
    
    const matchesSearch = !searchTerm || campaignName.includes(searchTerm);
    const matchesStatus = !statusFilter || status.includes(statusFilter.toLowerCase());
    
    // For group filter, we'd need more complex logic to check campaign group
    const matchesGroup = !groupFilter; // Simplified for now
    
    if (matchesSearch && matchesStatus && matchesGroup) {
      row.style.display = '';
    } else {
      row.style.display = 'none';
    }
  });
}

function sortCampaigns() {
  // Simplified sorting - in real implementation would need server-side sorting
  const sortValue = document.getElementById('campaignSortFilter')?.value;
  if (sortValue && sortValue !== 'recent') {
    window.scoutSendMessage?.(`Sort campaigns by ${sortValue}`);
  }
}

function debounce(func, wait) {
  let timeout;
  return function executedFunction(...args) {
    const later = () => {
      clearTimeout(timeout);
      func(...args);
    };
    clearTimeout(timeout);
    timeout = setTimeout(later, wait);
  };
}
</script>

<style>
.campaign-info {
  min-width: 200px;
}

.performance-metrics {
  min-width: 120px;
  font-size: 0.875rem;
}

.stat-card {
  transition: transform 0.2s ease;
  cursor: pointer;
}

.stat-card:hover {
  transform: translateY(-2px);
}

.table tbody tr {
  transition: background-color 0.2s ease;
}

.table tbody tr:hover {
  background-color: rgba(0, 0, 0, 0.02);
}

.empty-state {
  max-width: 600px;
  margin: 0 auto;
}

.badge {
  font-size: 0.75rem;
}

.performance-metrics .text-success {
  color: #198754 !important;
}

.performance-metrics .text-warning {
  color: #ffc107 !important;
}

.performance-metrics .text-danger {
  color: #dc3545 !important;
}
</style> 