<div class="scout-canvas canvas-container campaign-viewer">
  <!-- Page Header -->
  <div class="canvas-page-header">
    <h1 class="canvas-page-title">
      <i data-lucide="mail"></i>
      Email Campaigns
    </h1>
    <p class="canvas-page-subtitle">Manage your email marketing campaigns</p>
  </div>

  <div class="canvas-actions-bar">
    <div></div>
    <div class="canvas-actions">
      <button onclick="scoutViewTemplates()" 
              aria-label="View email templates"
              class="canvas-btn secondary">
        <i data-lucide="file-text"></i>
        Templates
      </button>
      <button onclick="scoutCreateCampaign()" 
              aria-label="Create new campaign"
              class="canvas-btn primary">
        <i data-lucide="plus"></i>
        Create Campaign
      </button>
    </div>
  </div>
  
  <!-- Campaign Stats -->
  <div class="canvas-stats-grid">
    <div class="canvas-stat-card purple">
      <div>
        <p class="canvas-stat-label">Total Campaigns</p>
        <p class="canvas-stat-value"><%= number_with_delimiter(stats[:total_campaigns]) %></p>
      </div>
      <div class="canvas-stat-icon purple">
        <i data-lucide="mail"></i>
      </div>
    </div>

    <div class="canvas-stat-card green">
      <div>
        <p class="canvas-stat-label">Sent</p>
        <p class="canvas-stat-value"><%= number_with_delimiter(stats[:sent_campaigns]) %></p>
      </div>
      <div class="canvas-stat-icon green">
        <i data-lucide="send"></i>
      </div>
    </div>

    <div class="canvas-stat-card yellow">
      <div>
        <p class="canvas-stat-label">Drafts</p>
        <p class="canvas-stat-value"><%= number_with_delimiter(stats[:draft_campaigns]) %></p>
      </div>
      <div class="canvas-stat-icon yellow">
        <i data-lucide="file-edit"></i>
      </div>
    </div>

    <div class="canvas-stat-card cyan">
      <div>
        <p class="canvas-stat-label">Avg Open Rate</p>
        <% avg_open_rate = campaigns.select { |c| c.mailgun_stats.present? }
                                   .map { |c| 
                                     sent = c.mailgun_stats['sent'] || 0
                                     opened = c.mailgun_stats['opened'] || 0
                                     sent > 0 ? (opened.to_f / sent * 100) : 0
                                   }
                                   .then { |rates| rates.any? ? rates.sum / rates.size : 0 } %>
        <p class="canvas-stat-value"><%= number_with_precision(avg_open_rate, precision: 1) %>%</p>
      </div>
      <div class="canvas-stat-icon cyan">
        <i data-lucide="trending-up"></i>
      </div>
    </div>
  </div>
  
  <!-- Filters -->
  <div class="canvas-filters-grid">
    <div class="canvas-search-wrapper">
      <i data-lucide="search"></i>
      <input type="text" 
             id="campaignSearch"
             placeholder="Search campaigns..."
             class="canvas-search-input"
             aria-label="Search campaigns">
    </div>
    <select id="campaignStatusFilter" class="canvas-select">
      <option value="">All Statuses</option>
      <option value="draft">Draft</option>
      <option value="sent">Sent</option>
      <option value="scheduled">Scheduled</option>
    </select>
    <select id="campaignGroupFilter" class="canvas-select">
      <option value="">All Groups</option>
      <% entity.contact_groups.each do |group| %>
        <option value="<%= group.id %>"><%= group.name %></option>
      <% end %>
    </select>
    <select id="campaignSortFilter" class="canvas-select">
      <option value="recent">Most Recent</option>
      <option value="performance">Best Performance</option>
      <option value="name">Alphabetical</option>
    </select>
  </div>
  
  <% if campaigns.any? %>
    <!-- Campaigns Table -->
    <div class="canvas-card">
      <div class="canvas-card-header">
        <h6>
          <i data-lucide="list"></i>
          Campaigns
        </h6>
        <div class="canvas-actions">
          <button onclick="scoutExportCampaigns()" 
                  aria-label="Export campaigns"
                  class="canvas-btn secondary sm">
            <i data-lucide="download"></i>
            Export
          </button>
          <button onclick="scoutAnalyzeCampaigns()" 
                  aria-label="Analyze campaigns"
                  class="canvas-btn outline-cyan sm">
            <i data-lucide="bar-chart"></i>
            Analyze
          </button>
        </div>
      </div>
      <div class="canvas-table-wrapper">
        <table class="canvas-table">
          <thead>
            <tr>
              <th>Campaign</th>
              <th>Status</th>
              <th>Target Group</th>
              <th>Performance</th>
              <th>Sent Date</th>
              <th style="width: 120px;">Actions</th>
            </tr>
          </thead>
          <tbody id="campaignsTable">
            <% campaigns.each do |campaign| %>
              <tr data-campaign-id="<%= campaign.id %>">
                <td>
                  <div>
                    <div class="fw-semibold">
                      <%= campaign.name.present? ? campaign.name : "Untitled Campaign" %>
                    </div>
                    <small class="text-muted">
                      <%= campaign.email_template&.subject.present? ? truncate(campaign.email_template.subject, length: 50) : (campaign.description.present? ? truncate(campaign.description, length: 50) : "No subject") %>
                    </small>
                  </div>
                </td>
                <td>
                  <% 
                    status_class = case campaign.status
                    when 'sent' then 'green'
                    when 'draft' then 'yellow'
                    when 'scheduled' then 'cyan'
                    else 'gray'
                    end
                  %>
                  <span class="canvas-badge <%= status_class %>">
                    <%= campaign.status.titleize %>
                  </span>
                </td>
                <td>
                  <% if campaign.contact_groups.any? %>
                    <div class="d-flex flex-wrap gap-1 mb-1">
                      <% campaign.contact_groups.each do |group| %>
                        <span class="canvas-badge purple"><%= group.name %></span>
                      <% end %>
                    </div>
                    <small class="text-muted">
                      <%= pluralize(campaign.contacts.count, 'contact') %>
                    </small>
                  <% else %>
                    <span class="text-muted">No group</span>
                  <% end %>
                </td>
                <td>
                  <% if campaign.mailgun_stats.present? %>
                    <% 
                      sent = campaign.mailgun_stats['sent'] || 0
                      delivered = campaign.mailgun_stats['delivered'] || 0
                      opened = campaign.mailgun_stats['opened'] || 0
                      clicked = campaign.mailgun_stats['clicked'] || 0
                      
                      open_rate = sent > 0 ? (opened.to_f / sent * 100) : 0
                      click_rate = sent > 0 ? (clicked.to_f / sent * 100) : 0
                    %>
                    <div class="campaign-performance">
                      <div class="d-flex justify-content-between mb-1">
                        <span class="text-muted">Sent:</span>
                        <strong><%= number_with_delimiter(sent) %></strong>
                      </div>
                      <div class="d-flex justify-content-between mb-1">
                        <span class="text-muted">Open Rate:</span>
                        <strong class="<%= open_rate > 20 ? 'text-success' : open_rate > 10 ? 'text-warning' : 'text-danger' %>">
                          <%= number_with_precision(open_rate, precision: 1) %>%
                        </strong>
                      </div>
                      <div class="d-flex justify-content-between">
                        <span class="text-muted">Click Rate:</span>
                        <strong class="<%= click_rate > 3 ? 'text-success' : click_rate > 1 ? 'text-warning' : 'text-danger' %>">
                          <%= number_with_precision(click_rate, precision: 1) %>%
                        </strong>
                      </div>
                    </div>
                  <% else %>
                    <span class="text-muted">No data</span>
                  <% end %>
                </td>
                <td>
                  <% if campaign.sent_at.present? %>
                    <small class="text-muted">
                      <%= campaign.sent_at.strftime("%b %d, %Y") %><br>
                      <%= time_ago_in_words(campaign.sent_at) %> ago
                    </small>
                  <% elsif campaign.scheduled_at.present? %>
                    <small class="text-cyan">
                      Scheduled for<br>
                      <%= campaign.scheduled_at.strftime("%b %d, %Y at %l:%M %p") %>
                    </small>
                  <% else %>
                    <small class="text-muted">
                      Created <%= time_ago_in_words(campaign.created_at) %> ago
                    </small>
                  <% end %>
                </td>
                <td>
                  <div class="d-flex gap-1">
                    <button onclick="scoutViewCampaign(<%= campaign.id %>)"
                            aria-label="View <%= campaign.name %> details"
                            class="canvas-btn outline-cyan sm">
                      <i data-lucide="eye"></i>
                    </button>
                    <% if campaign.status == 'draft' %>
                      <button onclick="scoutEditCampaign(<%= campaign.id %>)"
                              aria-label="Edit <%= campaign.name %>"
                              class="canvas-btn outline-purple sm">
                        <i data-lucide="pencil"></i>
                      </button>
                    <% end %>
                    <div class="dropdown">
                      <button class="canvas-btn secondary sm"
                              data-bs-toggle="dropdown"
                              aria-label="More actions for <%= campaign.name %>">
                        <i data-lucide="more-horizontal"></i>
                      </button>
                      <ul class="dropdown-menu canvas-dropdown-menu">
                        <% if campaign.status == 'sent' %>
                          <li><a class="dropdown-item" href="#" onclick="scoutAnalyzeCampaign(<%= campaign.id %>)">
                            <i data-lucide="trending-up" class="me-2"></i>View Analytics
                          </a></li>
                          <li><a class="dropdown-item" href="#" onclick="scoutDuplicateCampaign(<%= campaign.id %>)">
                            <i data-lucide="copy" class="me-2"></i>Duplicate
                          </a></li>
                        <% end %>
                        <% if campaign.status == 'draft' %>
                          <li><a class="dropdown-item" href="#" onclick="scoutSendCampaign(<%= campaign.id %>)">
                            <i data-lucide="send" class="me-2"></i>Send Campaign
                          </a></li>
                          <li><a class="dropdown-item" href="#" onclick="scoutScheduleCampaign(<%= campaign.id %>)">
                            <i data-lucide="clock" class="me-2"></i>Schedule
                          </a></li>
                        <% end %>
                        <li><hr class="dropdown-divider"></li>
                        <li><a class="dropdown-item danger" href="#" onclick="scoutDeleteCampaign(<%= campaign.id %>)">
                          <i data-lucide="trash-2" class="me-2"></i>Delete
                        </a></li>
                      </ul>
                    </div>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
      <div class="canvas-card-footer">
        <small>
          Showing <%= campaigns.count %> of <%= stats[:total_campaigns] %> campaigns
        </small>
        <div class="canvas-actions">
          <button onclick="scoutLoadMoreCampaigns()" 
                  aria-label="Load more campaigns"
                  class="canvas-btn secondary sm">
            Load More
          </button>
          <button onclick="scoutCreateCampaign()" 
                  aria-label="Create new campaign"
                  class="canvas-btn primary sm">
            <i data-lucide="plus"></i>
            Create Campaign
          </button>
        </div>
      </div>
    </div>
  <% else %>
    <!-- Empty State -->
    <div class="canvas-empty-state">
      <i data-lucide="mail"></i>
      <h5>No campaigns yet</h5>
      <p>
        Start reaching your audience by creating your first email campaign.<br>
        Email campaigns are a powerful way to engage customers and drive conversions.
      </p>
      <div class="canvas-empty-actions">
        <button onclick="scoutCreateCampaign()" 
                aria-label="Create your first campaign"
                class="canvas-btn primary">
          <i data-lucide="plus"></i>
          Create Your First Campaign
        </button>
        <button onclick="scoutViewTemplates()" 
                aria-label="Browse email templates"
                class="canvas-btn secondary">
          <i data-lucide="file-text"></i>
          Browse Templates
        </button>
      </div>
    </div>
  <% end %>
</div>

<!-- Delete Campaign Confirmation Modal -->
<div id="deleteCampaignModal" class="canvas-modal" style="display: none;">
  <div class="canvas-modal-backdrop" onclick="closeCampaignDeleteModal()"></div>
  <div class="canvas-modal-content" style="max-width: 420px;">
    <div class="canvas-modal-header">
      <h3><i data-lucide="trash-2"></i> Delete Campaign</h3>
      <button class="canvas-modal-close" onclick="closeCampaignDeleteModal()"><i data-lucide="x"></i></button>
    </div>
    <div class="canvas-modal-body">
      <p>Are you sure you want to delete <strong id="deleteCampaignName"></strong>?</p>
      <p class="text-muted small">This action cannot be undone.</p>
    </div>
    <div class="canvas-modal-footer">
      <button onclick="closeCampaignDeleteModal()" class="canvas-btn secondary">Cancel</button>
      <button onclick="confirmDeleteCampaign()" id="deleteCampaignBtn" class="canvas-btn" style="background: #ef4444; color: white;">
        <i data-lucide="trash-2"></i> Delete
      </button>
    </div>
  </div>
</div>

<!-- Send Campaign Confirmation Modal -->
<div id="sendCampaignModal" class="canvas-modal" style="display: none;">
  <div class="canvas-modal-backdrop" onclick="closeSendModal()"></div>
  <div class="canvas-modal-content" style="max-width: 420px;">
    <div class="canvas-modal-header">
      <h3><i data-lucide="send"></i> Send Campaign</h3>
      <button class="canvas-modal-close" onclick="closeSendModal()"><i data-lucide="x"></i></button>
    </div>
    <div class="canvas-modal-body">
      <p>Send <strong id="sendCampaignName"></strong> now?</p>
      <p class="text-muted small">This will deliver the campaign to all recipients immediately.</p>
    </div>
    <div class="canvas-modal-footer">
      <button onclick="closeSendModal()" class="canvas-btn secondary">Cancel</button>
      <button onclick="confirmSendCampaign()" id="sendCampaignBtn" class="canvas-btn primary">
        <i data-lucide="send"></i> Send Now
      </button>
    </div>
  </div>
</div>

<!-- Schedule Campaign Modal -->
<div id="scheduleCampaignModal" class="canvas-modal" style="display: none;">
  <div class="canvas-modal-backdrop" onclick="closeScheduleModal()"></div>
  <div class="canvas-modal-content" style="max-width: 420px;">
    <div class="canvas-modal-header">
      <h3><i data-lucide="clock"></i> Schedule Campaign</h3>
      <button class="canvas-modal-close" onclick="closeScheduleModal()"><i data-lucide="x"></i></button>
    </div>
    <div class="canvas-modal-body">
      <p class="mb-3">Schedule <strong id="scheduleCampaignName"></strong></p>
      <label class="form-label small fw-semibold">Send Date & Time</label>
      <input type="datetime-local" id="scheduleDateTime" class="form-control form-control-sm">
    </div>
    <div class="canvas-modal-footer">
      <button onclick="closeScheduleModal()" class="canvas-btn secondary">Cancel</button>
      <button onclick="confirmScheduleCampaign()" id="scheduleCampaignBtn" class="canvas-btn primary">
        <i data-lucide="clock"></i> Schedule
      </button>
    </div>
  </div>
</div>

<script>
const csrfToken = document.querySelector('meta[name="csrf-token"]')?.getAttribute('content');
const apiHeaders = { 'Content-Type': 'application/json', 'X-CSRF-Token': csrfToken };

// ── Navigation ──
function scoutCreateCampaign() {
  window.scoutLoadCanvas?.('campaign_editor', {});
}

function scoutViewCampaign(campaignId) {
  window.scoutLoadCanvas?.('campaign_editor', { campaign_id: campaignId });
}

function scoutEditCampaign(campaignId) {
  window.scoutLoadCanvas?.('campaign_editor', { campaign_id: campaignId });
}

function scoutAnalyzeCampaign(campaignId) {
  window.scoutLoadCanvas?.('analytics_dashboard', { campaign_id: campaignId });
}

function scoutAnalyzeCampaigns() {
  window.scoutLoadCanvas?.('analytics_dashboard');
}

function scoutViewTemplates() {
  window.scoutLoadCanvas?.('email_template_viewer');
}

function scoutLoadMoreCampaigns() {
  window.scoutLoadCanvas?.('campaign_viewer', { page: 2 }, true);
}

// ── Delete Campaign — modal + API ──
let pendingDeleteCampaignId = null;

function scoutDeleteCampaign(campaignId) {
  pendingDeleteCampaignId = campaignId;
  const row = document.querySelector(`tr[data-campaign-id="${campaignId}"]`);
  const name = row?.querySelector('td:first-child .fw-semibold')?.textContent?.trim() || 'this campaign';
  document.getElementById('deleteCampaignName').textContent = name;
  document.getElementById('deleteCampaignModal').style.display = 'flex';
  if (typeof lucide !== 'undefined') lucide.createIcons();
}

function closeCampaignDeleteModal() {
  document.getElementById('deleteCampaignModal').style.display = 'none';
  pendingDeleteCampaignId = null;
}

async function confirmDeleteCampaign() {
  if (!pendingDeleteCampaignId) return;
  const btn = document.getElementById('deleteCampaignBtn');
  btn.disabled = true;
  try {
    const resp = await fetch(`/api/v1/campaigns/${pendingDeleteCampaignId}`, {
      method: 'DELETE', headers: apiHeaders
    });
    if (resp.ok || resp.status === 204) {
      const row = document.querySelector(`tr[data-campaign-id="${pendingDeleteCampaignId}"]`);
      if (row) { row.style.transition = 'opacity 0.3s'; row.style.opacity = '0'; setTimeout(() => row.remove(), 300); }
      closeCampaignDeleteModal();
    } else {
      const data = await resp.json().catch(() => ({}));
      alert(data.message || data.error || 'Failed to delete campaign');
    }
  } catch (e) { alert('Error: ' + e.message); }
  finally { btn.disabled = false; }
}

// ── Duplicate Campaign — API call ──
async function scoutDuplicateCampaign(campaignId) {
  try {
    const resp = await fetch(`/api/v1/campaigns`, {
      method: 'POST', headers: apiHeaders,
      body: JSON.stringify({ duplicate_from: campaignId })
    });
    const data = await resp.json();
    if (resp.ok || data.success) {
      // Refresh campaign list to show the new copy
      window.scoutLoadCanvas?.('campaign_viewer', {}, true);
    } else {
      alert(data.message || data.errors?.join(', ') || 'Failed to duplicate');
    }
  } catch (e) { alert('Error: ' + e.message); }
}

// ── Send Campaign — modal + API ──
let pendingSendCampaignId = null;

function scoutSendCampaign(campaignId) {
  pendingSendCampaignId = campaignId;
  const row = document.querySelector(`tr[data-campaign-id="${campaignId}"]`);
  const name = row?.querySelector('td:first-child .fw-semibold')?.textContent?.trim() || 'this campaign';
  document.getElementById('sendCampaignName').textContent = name;
  document.getElementById('sendCampaignModal').style.display = 'flex';
  if (typeof lucide !== 'undefined') lucide.createIcons();
}

function closeSendModal() {
  document.getElementById('sendCampaignModal').style.display = 'none';
  pendingSendCampaignId = null;
}

async function confirmSendCampaign() {
  if (!pendingSendCampaignId) return;
  const btn = document.getElementById('sendCampaignBtn');
  btn.disabled = true;
  try {
    const resp = await fetch(`/api/v1/campaigns/${pendingSendCampaignId}/send_now`, {
      method: 'POST', headers: apiHeaders
    });
    const data = await resp.json();
    if (data.success || resp.ok) {
      closeSendModal();
      window.scoutLoadCanvas?.('campaign_viewer', {}, true);
    } else {
      alert(data.message || data.error || 'Failed to send campaign');
    }
  } catch (e) { alert('Error: ' + e.message); }
  finally { btn.disabled = false; }
}

// ── Schedule Campaign — modal + API ──
let pendingScheduleCampaignId = null;

function scoutScheduleCampaign(campaignId) {
  pendingScheduleCampaignId = campaignId;
  const row = document.querySelector(`tr[data-campaign-id="${campaignId}"]`);
  const name = row?.querySelector('td:first-child .fw-semibold')?.textContent?.trim() || 'this campaign';
  document.getElementById('scheduleCampaignName').textContent = name;
  // Default to tomorrow 9am
  const tomorrow = new Date(); tomorrow.setDate(tomorrow.getDate() + 1); tomorrow.setHours(9, 0, 0, 0);
  document.getElementById('scheduleDateTime').value = tomorrow.toISOString().slice(0, 16);
  document.getElementById('scheduleCampaignModal').style.display = 'flex';
  if (typeof lucide !== 'undefined') lucide.createIcons();
}

function closeScheduleModal() {
  document.getElementById('scheduleCampaignModal').style.display = 'none';
  pendingScheduleCampaignId = null;
}

async function confirmScheduleCampaign() {
  if (!pendingScheduleCampaignId) return;
  const scheduledAt = document.getElementById('scheduleDateTime').value;
  if (!scheduledAt) { alert('Please select a date and time'); return; }
  const btn = document.getElementById('scheduleCampaignBtn');
  btn.disabled = true;
  try {
    const resp = await fetch(`/api/v1/campaigns/${pendingScheduleCampaignId}/schedule`, {
      method: 'POST', headers: apiHeaders,
      body: JSON.stringify({ scheduled_at: scheduledAt })
    });
    const data = await resp.json();
    if (data.success || resp.ok) {
      closeScheduleModal();
      window.scoutLoadCanvas?.('campaign_viewer', {}, true);
    } else {
      alert(data.message || data.error || 'Failed to schedule campaign');
    }
  } catch (e) { alert('Error: ' + e.message); }
  finally { btn.disabled = false; }
}

// ── Export — client-side CSV download ──
function scoutExportCampaigns() {
  const rows = document.querySelectorAll('#campaignsTable tr');
  const csv = [['Campaign', 'Status', 'Sent', 'Opens', 'Clicks', 'Date'].join(',')];
  rows.forEach(row => {
    if (row.style.display === 'none') return;
    const cells = row.querySelectorAll('td');
    if (cells.length < 4) return;
    const name = cells[0]?.querySelector('.fw-semibold')?.textContent?.trim() || '';
    const status = cells[1]?.textContent?.trim() || '';
    const sent = cells[2]?.textContent?.trim() || '';
    const date = cells[cells.length - 2]?.textContent?.trim() || '';
    csv.push([name, status, sent, '', '', date].map(v => '"' + (v||'').replace(/"/g,'""') + '"').join(','));
  });
  const blob = new Blob([csv.join('\n')], { type: 'text/csv;charset=utf-8;' });
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a'); a.href = url;
  a.download = `campaigns_export_${new Date().toISOString().slice(0,10)}.csv`;
  a.click(); URL.revokeObjectURL(url);
}

// Search and filter functionality
document.addEventListener('DOMContentLoaded', function() {
  const searchInput = document.getElementById('campaignSearch');
  const statusFilter = document.getElementById('campaignStatusFilter');
  const groupFilter = document.getElementById('campaignGroupFilter');
  const sortFilter = document.getElementById('campaignSortFilter');
  
  if (searchInput) {
    searchInput.addEventListener('input', debounce(filterCampaigns, 300));
  }
  
  if (statusFilter) {
    statusFilter.addEventListener('change', filterCampaigns);
  }
  
  if (groupFilter) {
    groupFilter.addEventListener('change', filterCampaigns);
  }
  
  if (sortFilter) {
    sortFilter.addEventListener('change', sortCampaigns);
  }
  
  if (typeof lucide !== 'undefined') {
    lucide.createIcons();
  }
});

function filterCampaigns() {
  const searchTerm = document.getElementById('campaignSearch')?.value.toLowerCase() || '';
  const statusFilter = document.getElementById('campaignStatusFilter')?.value || '';
  const groupFilter = document.getElementById('campaignGroupFilter')?.value || '';
  const rows = document.querySelectorAll('#campaignsTable tr');
  
  rows.forEach(row => {
    const campaignName = row.querySelector('td:nth-child(1)')?.textContent.toLowerCase() || '';
    const status = row.querySelector('td:nth-child(2)')?.textContent.toLowerCase() || '';
    
    const matchesSearch = !searchTerm || campaignName.includes(searchTerm);
    const matchesStatus = !statusFilter || status.includes(statusFilter.toLowerCase());
    
    // For group filter, we'd need more complex logic to check campaign group
    const matchesGroup = !groupFilter; // Simplified for now
    
    if (matchesSearch && matchesStatus && matchesGroup) {
      row.style.display = '';
    } else {
      row.style.display = 'none';
    }
  });
}

function sortCampaigns() {
  const sortValue = document.getElementById('campaignSortFilter')?.value;
  if (sortValue && sortValue !== 'recent') {
    // Reload canvas with sort parameter
    window.scoutLoadCanvas?.('campaign_viewer', { sort: sortValue }, true);
  }
}

function debounce(func, wait) {
  let timeout;
  return function executedFunction(...args) {
    const later = () => {
      clearTimeout(timeout);
      func(...args);
    };
    clearTimeout(timeout);
    timeout = setTimeout(later, wait);
  };
}

document.addEventListener('turbo:load', () => {
  if (typeof lucide !== 'undefined') {
    lucide.createIcons();
  }
});
</script>
