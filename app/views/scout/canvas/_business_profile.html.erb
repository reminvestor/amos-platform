<div class="scout-canvas business-profile">

  <!-- Top-level tabs: Business Profile / Style Guidelines / Members -->
  <div class="settings-bar d-flex align-items-center justify-content-between mb-3">
    <ul class="nav nav-tabs settings-tabs mb-0" role="tablist">
      <li class="nav-item" role="presentation">
        <button class="nav-link active" id="profile-tab" data-bs-toggle="tab" data-bs-target="#tab-profile" type="button" role="tab" aria-label="Business profile">
          <i data-lucide="briefcase" class="me-1" aria-hidden="true"></i> Business Profile
        </button>
      </li>
      <li class="nav-item" role="presentation">
        <button class="nav-link" id="style-tab" data-bs-toggle="tab" data-bs-target="#tab-style" type="button" role="tab" aria-label="Style guidelines">
          <i data-lucide="palette" class="me-1" aria-hidden="true"></i> Style Guidelines
        </button>
      </li>
      <li class="nav-item" role="presentation">
        <button class="nav-link" id="members-tab" data-bs-toggle="tab" data-bs-target="#tab-members" type="button" role="tab" aria-label="Team members">
          <i data-lucide="users" class="me-1" aria-hidden="true"></i> Members
        </button>
      </li>
    </ul>
  </div>

  <div class="profile-content tab-content">
    <div class="tab-pane fade show active" id="tab-profile" role="tabpanel" aria-labelledby="profile-tab">

  <% business_profile ||= current_user.ensure_business_profile %>

  <div class="profile-card border-0 shadow-sm">
    <!-- Basic Info -->
    <div class="section">
      <h5 class="section-title">Basic Info</h5>
      <%= form_with model: business_profile, url: business_profile_path, method: :patch, local: false, id: "basic-info-form", class: "row g-3", data: { turbo: false } do |f| %>
        <div class="row g-3">
          <div class="col-md-6">
            <%= f.label :name, "Business Name", class: "form-label" %>
            <%= f.text_field :name, class: "form-control", placeholder: "Cool Company Inc", required: true %>
          </div>
          <div class="col-md-6">
            <%= f.label :industry, "Industry", class: "form-label" %>
            <%= f.text_field :industry, class: "form-control", placeholder: "Technology" %>
          </div>
        </div>

        <div class="row g-3 mt-0">
          <div class="col-md-6">
            <%= f.label :website, "Website URL", class: "form-label" %>
            <%= f.url_field :website, class: "form-control", placeholder: "https://www.example.com" %>
          </div>
          <div class="col-md-6">
            <%= f.label :founded_year, "Year Founded", class: "form-label" %>
            <%= f.number_field :founded_year, class: "form-control", placeholder: "2010", min: 1800, max: Date.current.year %>
          </div>
        </div>

        <div class="mt-3">
          <%= f.label :description, "Business Description", class: "form-label" %>
          <%= f.text_area :description, class: "form-control", rows: 4, placeholder: "A business focused on growth and creating the future." %>
        </div>

        <div class="text-end mt-3">
          <button type="submit" class="btn btn-primary" aria-label="Save basic business information">
            <i data-lucide="save" aria-hidden="true"></i> Save Basic Info
          </button>
        </div>
      <% end %>
    </div>

    <!-- Brand & Voice -->
    <div class="section">
      <h5 class="section-title">Brand & Voice</h5>
      <%= form_with model: business_profile, url: business_profile_path, method: :patch, local: false, id: "brand-form", class: "row g-3", data: { turbo: false } do |f| %>
        <div class="mb-3">
          <%= f.label :values, "Core Values & Mission", class: "form-label" %>
          <%= f.text_area :values, class: "form-control", rows: 4, placeholder: "Describe your business core values and mission" %>
        </div>

        <div class="mb-3">
          <%= f.label :target_audience, "Target Audience", class: "form-label" %>
          <%= f.text_area :target_audience, class: "form-control", rows: 4, placeholder: "Describe your ideal customer - demographics, interests, pain points, etc." %>
        </div>

        <div class="mb-3">
          <%= f.label :tone_of_voice, "Brand Voice", class: "form-label" %>
          <%= f.text_area :tone_of_voice, class: "form-control", rows: 3, placeholder: "How should your brand communicate? Friendly, Authoritative, etc." %>
        </div>

        <div class="text-end mt-1">
          <button type="submit" class="btn btn-primary" aria-label="Save brand information">
            <i data-lucide="save" aria-hidden="true"></i> Save Brand Info
          </button>
        </div>
      <% end %>
    </div>

    <!-- Knowledge Base -->
    <div class="section">
      <h5 class="section-title">Knowledge Base</h5>

      <% if business_profile.knowledge_base.present? %>
        <div class="kb-saved mb-3">
          <% business_profile.knowledge_base.each do |section, content| %>
            <div class="kb-saved-row">
              <div class="kb-saved-label"><%= section.humanize %></div>
              <div class="kb-saved-content">
                <div class="kb-saved-box d-flex justify-content-between align-items-center">
                  <div class="me-3" style="white-space: pre-wrap;"><%= content %></div>
                  <div>
                    <button type="button" class="btn btn-outline-primary btn-sm kb-edit-btn" aria-label="Edit <%= section.humanize %> section">
                      <i data-lucide="pencil" aria-hidden="true"></i>
                    </button>
                  </div>
                </div>

                <%= form_with url: add_knowledge_business_profile_path, method: :post, local: true, class: "kb-inline-form d-none mt-2" do %>
                  <div class="kb-row">
                    <div class="kb-label">Section</div>
                    <div class="kb-input">
                      <%= text_field_tag :section_name, section, class: "form-control", required: true %>
                    </div>
                  </div>
                  <div class="kb-row mt-2">
                    <div class="kb-label">Content</div>
                    <div class="kb-input">
                      <%= text_area_tag :content, content, class: "form-control", rows: 3, required: true %>
                    </div>
                  </div>
                  <div class="d-flex justify-content-end gap-2 mt-2">
                    <button type="button" class="btn btn-outline-secondary btn-sm kb-cancel-edit" aria-label="Cancel editing">Cancel</button>
                    <button type="submit" class="btn btn-primary btn-sm" aria-label="Save knowledge base section">
                      <i data-lucide="save" aria-hidden="true"></i> Save
                    </button>
                  </div>
                <% end %>
              </div>
            </div>
          <% end %>
        </div>
      <% end %>

      <div class="d-flex justify-content-end mb-2">
        <button type="button" class="btn btn-add-section" id="kb-add-launch" aria-label="Add new knowledge base section">
          <i data-lucide="plus" aria-hidden="true"></i> Add Section
        </button>
      </div>

      <div class="kb-grid kb-add-form d-none" id="kb-add-form">
        <%= form_with url: add_knowledge_business_profile_path, method: :post, local: false, id: "kb-form", data: { turbo: false } do %>
          <div class="kb-row">
            <div class="kb-label">Section</div>
            <div class="kb-input">
              <%= text_field_tag :section_name, "", class: "form-control", id: "kb_section_name", placeholder: "Section name (e.g. Products, Services)", required: true %>
            </div>
          </div>
          <div class="kb-row">
            <div class="kb-label">Content</div>
            <div class="kb-input">
              <%= text_area_tag :content, "", class: "form-control", id: "kb_content", rows: 3, placeholder: "Knowledge content...", required: true %>
            </div>
          </div>
          <div class="d-flex justify-content-end gap-2 mt-2">
            <button type="button" class="btn btn-outline-secondary kb-add-cancel" aria-label="Cancel adding section">Cancel</button>
            <button type="submit" class="btn btn-add-section" aria-label="Save new knowledge base section">
              <i data-lucide="save" aria-hidden="true"></i> Save
            </button>
          </div>
        <% end %>
      </div>
    </div>
  </div>
    </div>

    <!-- Style Guidelines Tab -->
    <div class="tab-pane fade" id="tab-style" role="tabpanel" aria-labelledby="style-tab">
      <div class="profile-card border-0 shadow-sm">
        <h5 class="section-title">Visual Style Guidelines</h5>
        <p class="text-muted small mb-3">Define your brand's visual identity for AI-generated content like landing pages and emails.</p>

        <%= form_with model: business_profile, url: business_profile_path, method: :patch, local: false, id: "style-form", data: { turbo: false } do |f| %>
          <div class="mb-3">
            <label class="form-label" for="business_profile_style_colors">Brand Colors</label>
            <textarea name="business_profile[style_colors]" id="business_profile_style_colors"
                      class="form-control" rows="3"
                      placeholder="#7C3AED&#10;#A78BFA&#10;#22C55E"><%= business_profile.style_guidelines&.dig('colors')&.join("\n") %></textarea>
            <div class="form-text">Enter one hex color per line</div>
            <div id="bp-color-preview" class="d-flex flex-wrap gap-2 mt-2">
              <% if business_profile.style_guidelines&.dig('colors').present? %>
                <% business_profile.style_guidelines['colors'].each do |color| %>
                  <div class="bp-color-swatch" style="background-color: <%= color %>;" title="<%= color %>"></div>
                <% end %>
              <% end %>
            </div>
          </div>

          <div class="mb-3">
            <label class="form-label" for="business_profile_style_typography">Typography Style</label>
            <input type="text" name="business_profile[style_typography]" id="business_profile_style_typography"
                   class="form-control"
                   value="<%= business_profile.style_guidelines&.dig('typography') %>"
                   placeholder="e.g. Modern sans-serif, Classic serif, Clean and minimal">
            <div class="form-text">Describe your preferred typography style</div>
          </div>

          <div class="mb-3">
            <label class="form-label" for="business_profile_style_aesthetic">Overall Aesthetic</label>
            <input type="text" name="business_profile[style_aesthetic]" id="business_profile_style_aesthetic"
                   class="form-control"
                   value="<%= business_profile.style_guidelines&.dig('aesthetic') %>"
                   placeholder="e.g. Professional and trustworthy, Bold and energetic, Calm and reassuring">
            <div class="form-text">Describe the mood and feel of your brand</div>
          </div>

          <div class="mb-3">
            <label class="form-label" for="business_profile_style_logo_url">Logo URL (optional)</label>
            <input type="text" name="business_profile[style_logo_url]" id="business_profile_style_logo_url"
                   class="form-control"
                   value="<%= business_profile.style_guidelines&.dig('logo_url') %>"
                   placeholder="/assets/your-logo.png or https://...">
            <div class="form-text">URL to your logo image</div>
          </div>

          <div class="alert alert-info small py-2 mb-3">
            <i data-lucide="lightbulb" aria-hidden="true" style="width: 14px; height: 14px;" class="me-1"></i>
            These guidelines are automatically used when generating landing pages, emails, and other content.
          </div>

          <div class="text-end">
            <button type="submit" class="btn btn-primary" aria-label="Save style guidelines">
              <i data-lucide="save" aria-hidden="true"></i> Save Style Guidelines
            </button>
          </div>
        <% end %>
      </div>
    </div>

    <div class="tab-pane fade" id="tab-members" role="tabpanel" aria-labelledby="members-tab">
      <div class="profile-card border-0 shadow-sm">
        <h5 class="section-title">Team Members</h5>
        <% entity_users = current_entity&.entity_users&.includes(:user) || [] %>
        <% pending_invites = current_entity ? TeamInvite.pending.where(entity: current_entity) : [] %>
        
        <div class="table-responsive">
          <table class="table align-middle">
            <thead>
              <tr>
                <th>Name</th>
                <th>Email</th>
                <th>Role</th>
                <th>Status</th>
                <th>Joined</th>
              </tr>
            </thead>
            <tbody>
              <% entity_users.each do |eu| %>
                <tr>
                  <td>
                    <%= eu.user.full_name %>
                    <% if eu.user == current_user %>
                      <span class="badge bg-info ms-1">You</span>
                    <% end %>
                  </td>
                  <td class="text-muted"><%= eu.user.email %></td>
                  <td>
                    <% case eu.role %>
                    <% when 'owner' %>
                      <span class="badge bg-primary"><%= eu.role.capitalize %></span>
                    <% when 'admin' %>
                      <span class="badge bg-info"><%= eu.role.capitalize %></span>
                    <% else %>
                      <span class="badge bg-secondary"><%= eu.role.capitalize %></span>
                    <% end %>
                  </td>
                  <td>
                    <% if eu.user.onboarded? %>
                      <span class="badge bg-success">Active</span>
                    <% else %>
                      <span class="badge bg-warning">Pending Setup</span>
                    <% end %>
                  </td>
                  <td class="text-muted"><%= eu.created_at&.strftime('%b %d, %Y') %></td>
                </tr>
              <% end %>
              <% pending_invites.each do |invite| %>
                <tr class="table-secondary" style="opacity: 0.7;">
                  <td><em>Pending invite</em></td>
                  <td class="text-muted"><%= invite.email %></td>
                  <td><span class="badge bg-secondary"><%= invite.role.capitalize %></span></td>
                  <td><span class="badge bg-warning">Invited</span></td>
                  <td class="text-muted">Expires <%= invite.expires_at.strftime('%b %d') %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>

        <% if current_user.entity_admin?(current_entity) %>
          <div class="mt-4" id="invite-member-section">
            <button class="btn btn-outline-primary" id="show-invite-form" aria-label="Invite team member">
              <i data-lucide="user-plus" aria-hidden="true"></i> Invite Member
            </button>
            
            <div id="invite-member-form" class="d-none mt-3 p-3 rounded invite-form-card">
              <h6 class="mb-3">Invite a Team Member</h6>
              <%= form_with url: create_invite_entity_users_path, method: :post, local: false, id: "canvas-invite-form", data: { turbo: false } do %>
                <div class="row g-3">
                  <div class="col-md-6">
                    <label class="form-label">Email Address</label>
                    <input type="email" name="team_invite[email]" class="form-control" placeholder="colleague@company.com" required>
                  </div>
                  <div class="col-md-6">
                    <label class="form-label">Role</label>
                    <select name="team_invite[role]" class="form-select" required>
                      <option value="member">Member - Can use the platform</option>
                      <option value="admin">Admin - Can manage team & settings</option>
                    </select>
                  </div>
                </div>
                <div class="d-flex gap-2 mt-3">
                  <button type="submit" class="btn btn-primary">
                    <i data-lucide="send" aria-hidden="true"></i> Send Invitation
                  </button>
                  <button type="button" class="btn btn-outline-secondary" id="cancel-invite-form">Cancel</button>
                </div>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>

<style>
/* Theme-aware styling for business profile canvas */
.business-profile {
  height: 100%;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  padding: 0 1rem 1rem;
  background: var(--scout-bg);
}

.profile-content {
  flex: 1 1 auto;
  min-height: 0;
  overflow-y: auto;
  padding-top: .5rem;
}

.profile-card {
  background: var(--scout-chat-bg);
  border-radius: 0.75rem;
  padding: 1.25rem;
  border: 1px solid var(--scout-border);
}

.section { margin-bottom: 1.5rem; }
.section-title {
  color: var(--scout-text);
  margin-bottom: 0.75rem;
  border-bottom: 1px solid var(--scout-border);
  padding-bottom: 0.5rem;
}

/* Form styling - theme aware */
.business-profile .form-label { color: var(--scout-text-muted); }

/* Use Bootstrap's default form styling which is theme-aware */
.business-profile .form-control,
.business-profile textarea,
.business-profile .form-select {
  color: var(--bs-body-color);
  background-color: var(--bs-body-bg);
  border-color: var(--bs-border-color);
}

.business-profile .form-control:focus,
.business-profile .form-select:focus,
.business-profile textarea:focus {
  border-color: var(--scout-primary);
  box-shadow: 0 0 0 .15rem rgba(99, 102, 241, 0.15);
}

/* Dark theme overrides */
[data-bs-theme="dark"] .business-profile .form-control,
[data-bs-theme="dark"] .business-profile textarea,
[data-bs-theme="dark"] .business-profile .form-select {
  color: var(--scout-text);
  background-color: var(--scout-tertiary, #27244B);
  border-color: var(--scout-border);
}

[data-bs-theme="dark"] .business-profile .form-control:focus,
[data-bs-theme="dark"] .business-profile .form-select:focus,
[data-bs-theme="dark"] .business-profile textarea:focus {
  background-color: var(--scout-tertiary, #27244B);
}

/* Tame browser autofill styles (WebKit) - dark mode only */
[data-bs-theme="dark"] .business-profile input.form-control:-webkit-autofill,
[data-bs-theme="dark"] .business-profile input.form-control:-webkit-autofill:hover,
[data-bs-theme="dark"] .business-profile input.form-control:-webkit-autofill:focus {
  -webkit-box-shadow: 0 0 0px 1000px var(--scout-tertiary, #27244B) inset;
  -webkit-text-fill-color: var(--scout-text);
}

.business-profile .form-control::placeholder,
.business-profile textarea::placeholder { color: var(--scout-text-muted); }

.business-profile .btn-primary { background: var(--scout-primary); border-color: var(--scout-primary); }
.business-profile .btn-outline-primary { color: var(--scout-primary); border-color: var(--scout-primary); }
.business-profile .btn-outline-primary:hover { background: var(--scout-primary); color: #fff; }

.existing-knowledge .existing-item {
  background: var(--bs-tertiary-bg);
  border: 1px solid var(--bs-border-color);
  padding: 0.5rem 0.75rem;
  border-radius: 0.5rem;
  color: var(--bs-body-color);
  margin-bottom: 0.5rem;
}

.kb-grid { display: grid; gap: 1rem; }
.kb-row { display: grid; grid-template-columns: 140px 1fr; gap: 1rem; align-items: start; }
.kb-label { color: var(--bs-secondary-color); padding-top: 0.5rem; }
.kb-input textarea { min-height: 60px; }

/* Saved knowledge layout (label left, content right) */
.kb-saved { display: grid; gap: 1rem; }
.kb-saved-row { display: grid; grid-template-columns: 140px 1fr; gap: 1rem; align-items: start; }
.kb-saved-label { color: var(--bs-body-color); font-weight: 600; padding-top: 0.6rem; }
.kb-saved-content { }
.kb-saved-box { background: var(--bs-tertiary-bg); border: 1px solid var(--bs-border-color); border-radius: .5rem; padding: .75rem 1rem; color: var(--bs-body-color); }

/* Dark theme overrides for knowledge base */
[data-bs-theme="dark"] .existing-knowledge .existing-item { background: var(--scout-chat-bg); border-color: var(--scout-border); color: var(--scout-text); }
[data-bs-theme="dark"] .kb-label { color: var(--scout-text-muted); }
[data-bs-theme="dark"] .kb-saved-label { color: var(--scout-text); }
[data-bs-theme="dark"] .kb-saved-box { background: var(--scout-chat-bg); border-color: var(--scout-border); color: var(--scout-text); }
.kb-saved-box p { margin: 0; }
/* Hide left label and collapse column while editing */
.kb-saved-row.kb-editing { grid-template-columns: 1fr; }
.kb-saved-row.kb-editing .kb-saved-label { display: none; }

/* Style Guidelines color swatches */
.bp-color-swatch {
  width: 32px; height: 32px; border-radius: 6px;
  border: 2px solid var(--bs-border-color);
  transition: transform 0.15s;
}
.bp-color-swatch:hover { transform: scale(1.15); }

/* Add Section button variant */
.btn-add-section { color: var(--scout-primary); border: 1px solid var(--scout-primary); background: transparent; }
.btn-add-section:hover { background: var(--scout-primary); color: #fff; }

/* Inline KB editor trigger */
.kb-edit-btn { color: var(--scout-primary); border-color: var(--scout-primary); }
.kb-edit-btn:hover { background: var(--scout-primary); color: #fff; }

/* Small helper: when editing, highlight the form */
.kb-editing #kb_section_name, .kb-editing #kb_content { border-color: var(--scout-primary); box-shadow: 0 0 0 .2rem rgba(99,102,241,.15); }

/* Inline form visibility */
.kb-inline-form.d-none { display: none; }

 /* Match app scrollbar styling (scoped to scroll area) */
 .profile-content {
   scrollbar-width: thin; /* Firefox */
   scrollbar-color: var(--scout-primary) var(--scout-chat-bg);
 }

 .profile-content::-webkit-scrollbar {
  width: 10px;
}
 .profile-content::-webkit-scrollbar-track {
  background: var(--scout-chat-bg);
  border-left: 1px solid var(--scout-border);
}
 .profile-content::-webkit-scrollbar-thumb {
  background-color: var(--scout-primary);
  border-radius: 8px;
  border: 2px solid var(--scout-chat-bg);
}
 .profile-content::-webkit-scrollbar-thumb:hover {
  background-color: var(--scout-primary-hover);
}

/* Top-level settings tabs color tuning */
.settings-tabs { border-bottom: 0; gap: .75rem; }
.settings-tabs .nav-item { flex: 0 0 auto; background: transparent; }
.settings-tabs .nav-link {
  display: inline-flex; align-items: center; gap: .5rem;
  color: var(--scout-primary) !important; /* neon purple accent */
  background: transparent;
  border: 1px solid var(--scout-border);
  border-radius: .75rem;
  padding: .55rem 1rem;
  box-shadow: none;
}
.settings-tabs .nav-link:hover {
  background: var(--scout-primary);
  color: #fff !important;
  border-color: var(--scout-primary);
}
.settings-tabs .nav-link:focus, .settings-tabs .nav-link:focus-visible { outline: none; box-shadow: none; }
.settings-tabs .nav-link.active {
  color: var(--scout-text) !important;
  background: var(--scout-chat-bg);
  border-color: var(--scout-border);
}

/* Theme-aware table styling */
.business-profile .table { color: var(--bs-body-color); }

/* Dark theme table overrides */
[data-bs-theme="dark"] .business-profile .table { color: var(--scout-text); }
[data-bs-theme="dark"] .business-profile .table > :not(caption) > * > * {
  background: var(--scout-chat-bg) !important;
  border-color: var(--scout-border) !important;
  color: var(--scout-text) !important;
}
[data-bs-theme="dark"] .business-profile .table thead th {
  background: var(--scout-chat-bg) !important;
  color: var(--scout-text) !important;
}
[data-bs-theme="dark"] .business-profile .table tbody tr:hover > * {
  background: var(--scout-nav-hover) !important;
}

/* Settings bar divider */
.settings-bar { position: sticky; top: 0; z-index: 10; border-bottom: 1px solid var(--bs-border-color); padding-bottom: .5rem; background: var(--bs-body-bg); margin-top: -0.25rem; }
[data-bs-theme="dark"] .settings-bar { border-color: var(--scout-border); background: var(--scout-bg); }

/* Invite form card */
.invite-form-card {
  background: var(--bs-tertiary-bg);
  border: 1px solid var(--bs-border-color);
}
.invite-form-card h6 { color: var(--bs-body-color); }
[data-bs-theme="dark"] .invite-form-card { background: var(--scout-tertiary, #27244B); border-color: var(--scout-border); }
[data-bs-theme="dark"] .invite-form-card h6 { color: var(--scout-text); }
</style>

<script>
  // Invite member form toggle
  document.addEventListener('click', function(e) {
    const showBtn = e.target.closest('#show-invite-form');
    if (showBtn) {
      const form = document.getElementById('invite-member-form');
      if (form) {
        form.classList.remove('d-none');
        showBtn.classList.add('d-none');
        form.querySelector('input[type="email"]')?.focus();
      }
      return;
    }
    
    const cancelBtn = e.target.closest('#cancel-invite-form');
    if (cancelBtn) {
      const form = document.getElementById('invite-member-form');
      const showBtn = document.getElementById('show-invite-form');
      if (form) form.classList.add('d-none');
      if (showBtn) showBtn.classList.remove('d-none');
      return;
    }
  });

  // Basic inline edit handler for Knowledge Base saved items
  document.addEventListener('click', function (e) {
    const btn = e.target.closest('.kb-edit-btn');
    if (btn) {
      const container = btn.closest('.kb-saved-content');
      if (!container) return;
      const displayBox = container.querySelector('.kb-saved-box');
      const inlineForm = container.querySelector('.kb-inline-form');
      const row = btn.closest('.kb-saved-row');
      if (!inlineForm || !displayBox) return;
      displayBox.classList.add('d-none');
      inlineForm.classList.remove('d-none');
      if (row) row.classList.add('kb-editing');
      inlineForm.scrollIntoView({ behavior: 'smooth', block: 'center' });
      return;
    }

    const cancel = e.target.closest('.kb-cancel-edit');
    if (cancel) {
      const container = cancel.closest('.kb-saved-content');
      const displayBox = container.querySelector('.kb-saved-box');
      const inlineForm = container.querySelector('.kb-inline-form');
      const row = cancel.closest('.kb-saved-row');
      inlineForm.classList.add('d-none');
      displayBox.classList.remove('d-none');
      if (row) row.classList.remove('kb-editing');
    }

    const launchAdd = e.target.closest('#kb-add-launch');
    if (launchAdd) {
      const formWrap = document.getElementById('kb-add-form');
      if (formWrap) {
        formWrap.classList.remove('d-none');
        const name = document.getElementById('kb_section_name');
        if (name) name.focus();
      }
      // hide the Add Section button while editing a new section
      const addBtn = document.getElementById('kb-add-launch');
      if (addBtn) addBtn.classList.add('d-none');
      return;
    }

    const cancelAdd = e.target.closest('.kb-add-cancel');
    if (cancelAdd) {
      const formWrap = document.getElementById('kb-add-form');
      if (formWrap) formWrap.classList.add('d-none');
      // show the Add Section button again
      const addBtn = document.getElementById('kb-add-launch');
      if (addBtn) addBtn.classList.remove('d-none');
      return;
    }
  });

  // Live color preview for Style Guidelines
  (function() {
    const colorInput = document.getElementById('business_profile_style_colors');
    const colorPreview = document.getElementById('bp-color-preview');
    if (colorInput && colorPreview) {
      colorInput.addEventListener('input', function() {
        const colors = this.value.split('\n').map(c => c.trim()).filter(c => c.startsWith('#') && c.length >= 4);
        colorPreview.innerHTML = colors.map(color =>
          '<div class="bp-color-swatch" style="background-color: ' + color + ';" title="' + color + '"></div>'
        ).join('');
      });
    }
  })();
</script>