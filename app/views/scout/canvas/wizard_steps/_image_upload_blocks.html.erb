<div class="image-upload-section">
  <p class="text-white mb-3">
    Add up to 3 images for your landing page. You can upload your own images, describe images for AI to create, or leave blank for AI to choose automatically.
  </p>
  
  <div class="row g-3">
    <!-- Image Block 1 -->
    <div class="col-md-4">
      <div class="image-upload-block">
        <div class="image-preview" id="image-preview-1">
          <div class="upload-placeholder">
            <i data-lucide="image" class="text-secondary mb-2"></i>
            <p class="text-dark small mb-0 fw-medium">Image 1</p>
          </div>
        </div>
        
        <div class="image-options mt-2">
          <div class="btn-group-vertical w-100" role="group">
            <input type="file" id="image-file-1" name="image_file_1" accept="image/*" class="d-none">
            <button type="button" class="btn btn-outline-primary btn-sm" onclick="console.log('🔘 Upload button 1 clicked'); document.getElementById('image-file-1').click()">
              <i data-lucide="upload" class="me-1"></i> Upload Image
            </button>
            <button type="button" class="btn btn-outline-secondary btn-sm mt-1" onclick="openMediaLibrary(1)">
              <i data-lucide="camera" class="me-1"></i> Choose from Library
            </button>
            <input type="text" 
                   id="image-prompt-1" 
                   name="image_prompt_1" 
                   class="form-control form-control-sm mt-1" 
                   placeholder="Or describe image for AI to create...">
          </div>
        </div>
      </div>
    </div>
    
    <!-- Image Block 2 -->
    <div class="col-md-4">
      <div class="image-upload-block">
        <div class="image-preview" id="image-preview-2">
          <div class="upload-placeholder">
            <i data-lucide="image" class="text-secondary mb-2"></i>
            <p class="text-dark small mb-0 fw-medium">Image 2</p>
          </div>
        </div>
        
        <div class="image-options mt-2">
          <div class="btn-group-vertical w-100" role="group">
            <input type="file" id="image-file-2" name="image_file_2" accept="image/*" class="d-none">
            <button type="button" class="btn btn-outline-primary btn-sm" onclick="console.log('🔘 Upload button 2 clicked'); document.getElementById('image-file-2').click()">
              <i data-lucide="upload" class="me-1"></i> Upload Image
            </button>
            <button type="button" class="btn btn-outline-secondary btn-sm mt-1" onclick="openMediaLibrary(2)">
              <i data-lucide="camera" class="me-1"></i> Choose from Library
            </button>
            <input type="text" 
                   id="image-prompt-2" 
                   name="image_prompt_2" 
                   class="form-control form-control-sm mt-1" 
                   placeholder="Or describe image for AI to create...">
          </div>
        </div>
      </div>
    </div>
    
    <!-- Image Block 3 -->
    <div class="col-md-4">
      <div class="image-upload-block">
        <div class="image-preview" id="image-preview-3">
          <div class="upload-placeholder">
            <i data-lucide="image" class="text-secondary mb-2"></i>
            <p class="text-dark small mb-0 fw-medium">Image 3</p>
          </div>
        </div>
        
        <div class="image-options mt-2">
          <div class="btn-group-vertical w-100" role="group">
            <input type="file" id="image-file-3" name="image_file_3" accept="image/*" class="d-none">
            <button type="button" class="btn btn-outline-primary btn-sm" onclick="console.log('🔘 Upload button 3 clicked'); document.getElementById('image-file-3').click()">
              <i data-lucide="upload" class="me-1"></i> Upload Image
            </button>
            <button type="button" class="btn btn-outline-secondary btn-sm mt-1" onclick="openMediaLibrary(3)">
              <i data-lucide="camera" class="me-1"></i> Choose from Library
            </button>
            <input type="text" 
                   id="image-prompt-3" 
                   name="image_prompt_3" 
                   class="form-control form-control-sm mt-1" 
                   placeholder="Or describe image for AI to create...">
          </div>
        </div>
      </div>
    </div>
  </div>
  
  <!-- Design Reference Upload - Below Images -->
  <div class="design-reference-section mt-4">
    <h6 class="mb-2 text-white">
      <i data-lucide="palette" class="me-2"></i>
      Design Reference (Optional)
    </h6>
    <p class="text-light small mb-3">
      Upload a design, theme, or website you like as inspiration. AI will analyze it and incorporate the style into your landing page.
    </p>
    
    <div class="design-upload-block">
      <div class="upload-area" id="design-upload-area">
        <div class="upload-placeholder text-center p-3">
          <i data-lucide="cloud-upload" class="text-primary mb-2 icon-2x"></i>
          <p class="text-dark mb-2">Drop design reference here or click to browse</p>
          <p class="text-muted small mb-0">Supports: Images (JPG, PNG), Documents (PDF, DOC), or website screenshots</p>
        </div>
        <input type="file" 
               id="design-reference-file" 
               name="design_reference_file" 
               accept="image/*,.pdf,.doc,.docx" 
               class="d-none">
      </div>
      
      <div class="design-notes mt-2">
        <input type="text" 
               id="design-notes" 
               name="design_notes" 
               class="form-control form-control-sm" 
               placeholder="Describe what you like about this design (optional)">
      </div>
    </div>
  </div>
  
  <!-- Hidden fields to store image data for form submission -->
  <input type="hidden" id="images-data" name="images_data" value="">
  <div class="d-flex justify-content-end mt-2">
    <a href="/image_assets/new" target="_blank" class="small text-decoration-underline"><i data-lucide="plus" class="me-1"></i>Add images to library</a>
  </div>
</div>

<style>
.image-upload-block {
  border: 2px dashed #dee2e6;
  border-radius: 0.5rem;
  padding: 1rem;
  transition: all 0.2s ease;
  background: #f8f9fa;
}

.image-upload-block:hover {
  border-color: #6366f1;
  background: #f0f0ff;
}

.image-preview {
  aspect-ratio: 16/9;
  background: white;
  border-radius: 0.375rem;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1px solid #dee2e6;
  overflow: hidden;
}

.upload-placeholder {
  text-align: center;
}

.upload-placeholder i {
  font-size: 2rem;
}

.image-preview img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.uploaded-image {
  width: 100%;
  height: 100%;
  object-fit: cover;
  border-radius: 0.375rem;
}

.image-preview.has-image {
  border-color: #28a745;
  background: #f8fff8;
}

.image-upload-block.has-upload {
  border-color: #28a745;
  border-style: solid;
  background: #f8fff8;
}

.image-upload-block.has-prompt {
  border-color: #6366f1;
  border-style: solid;
  background: #f0f0ff;
}

.design-upload-block {
  border: 2px dashed #6366f1;
  border-radius: 0.5rem;
  background: #f8f9ff;
  transition: all 0.2s ease;
}

.design-upload-block:hover {
  border-color: #5855eb;
  background: #f0f0ff;
}

.design-upload-block.has-file {
  border-color: #28a745;
  border-style: solid;
  background: #f8fff8;
}

.upload-area {
  cursor: pointer;
  border-radius: 0.375rem;
}

.design-file-preview {
  display: none;
  padding: 1rem;
  background: white;
  border-radius: 0.375rem;
  border: 1px solid #dee2e6;
}

.design-file-preview.show {
  display: block;
}
</style>

<script>
// Prevent multiple script execution
if (!window.imageUploadBlocksInitialized) {
  console.log('🚀 Image upload blocks script loading...');

  function initializeImageUploadBlocks() {
    console.log('🖼️ Initializing image upload blocks');
    
    // Check if elements exist
    const imageFile1 = document.getElementById('image-file-1');
    const imagePreview1 = document.getElementById('image-preview-1');
    const designUploadArea = document.getElementById('design-upload-area');
    
    console.log('🔍 Element check:', {
      imageFile1: !!imageFile1,
      imagePreview1: !!imagePreview1,
      designUploadArea: !!designUploadArea
    });
    
    if (!imageFile1 || !imagePreview1) {
      console.error('❌ Critical elements missing for image upload');
      return;
    }
    
    // Handle design reference upload
    const designFileInput = document.getElementById('design-reference-file');
  
  if (designUploadArea && designFileInput) {
    console.log('🎨 Design reference upload initialized');
    
    // Click to upload
    designUploadArea.addEventListener('click', function() {
      console.log('🎨 Design upload area clicked');
      designFileInput.click();
    });
    
    // File input change
    designFileInput.addEventListener('change', function(e) {
      const file = e.target.files[0];
      console.log('🎨 Design file selected:', file);
      if (file) {
        handleDesignFileUpload(file);
      }
    });
  }
  
  function handleDesignFileUpload(file) {
    console.log('🎨 Processing design file:', file.name);
    const uploadArea = document.getElementById('design-upload-area');
    const block = uploadArea?.closest('.design-upload-block');
    
    if (uploadArea && block) {
      // Show file info
      uploadArea.innerHTML = `
        <div class="design-file-preview show">
          <div class="d-flex align-items-center">
            <i data-lucide="file-text" class="text-primary me-3 icon-2x"></i>
            <div>
              <p class="text-dark mb-1 fw-medium">${file.name}</p>
              <p class="text-muted small mb-0">${formatFileSize(file.size)} • ${file.type}</p>
            </div>
            <button type="button" class="btn btn-outline-danger btn-sm ms-auto" onclick="clearDesignReference()">
              <i data-lucide="x"></i>
            </button>
          </div>
        </div>
      `;

      block.classList.add('has-file');
      // Re-initialize Lucide icons after dynamic content insertion
      if (typeof lucide !== 'undefined') lucide.createIcons();
      updateImagesData();
    }
  }
  
  function getFileIcon(mimeType) {
    if (mimeType.startsWith('image/')) return 'image';
    if (mimeType.includes('pdf')) return 'pdf';
    if (mimeType.includes('doc')) return 'word';
    return 'file';
  }
  
  function formatFileSize(bytes) {
    if (bytes === 0) return '0 Bytes';
    const k = 1024;
    const sizes = ['Bytes', 'KB', 'MB'];
    const i = Math.floor(Math.log(bytes) / Math.log(k));
    return parseFloat((bytes / Math.pow(k, i)).toFixed(1)) + ' ' + sizes[i];
  }
  
  window.clearDesignReference = function() {
    console.log('🎨 Clearing design reference');
    const uploadArea = document.getElementById('design-upload-area');
    const fileInput = document.getElementById('design-reference-file');
    const block = uploadArea?.closest('.design-upload-block');
    
    if (uploadArea && fileInput && block) {
      uploadArea.innerHTML = `
        <div class="upload-placeholder text-center p-3">
          <i data-lucide="cloud-upload" class="text-primary mb-2 icon-2x"></i>
          <p class="text-dark mb-2">Drop design reference here or click to browse</p>
          <p class="text-muted small mb-0">Supports: Images (JPG, PNG), Documents (PDF, DOC), or website screenshots</p>
        </div>
      `;
      fileInput.value = '';
      block.classList.remove('has-file');
      // Re-initialize Lucide icons after dynamic content insertion
      if (typeof lucide !== 'undefined') lucide.createIcons();
      updateImagesData();
    }
  };

  // Handle image uploads with enhanced debugging
  for (let i = 1; i <= 3; i++) {
    const fileInput = document.getElementById(`image-file-${i}`);
    const preview = document.getElementById(`image-preview-${i}`);
    const block = fileInput?.closest('.image-upload-block');
    
    console.log(`🖼️ Setting up image ${i}:`, {
      fileInput: !!fileInput,
      preview: !!preview,
      block: !!block
    });
    
    if (fileInput && preview) {
      fileInput.addEventListener('change', async function(e) {
        console.log(`📸 Image ${i} file selected:`, e.target.files[0]);
        const file = e.target.files[0];
        if (file) {
          console.log(`📸 Reading file for preview: ${file.name}, size: ${file.size}`);
          const reader = new FileReader();
          reader.onload = function(e) {
            console.log(`📸 File loaded successfully, updating preview for image ${i}`);
            preview.innerHTML = `<img src="${e.target.result}" alt="Uploaded image ${i}" class="uploaded-image">`;
            preview.classList.add('has-image');
            block?.classList.add('has-upload');
            console.log(`📸 Preview updated for image ${i}`);
            updateImagesData();
          };
          reader.onerror = function(e) {
            console.error(`❌ Error reading file for image ${i}:`, e);
          };
          reader.readAsDataURL(file);

          // Immediately upload to media library so this upload is reusable and has a real URL
          try {
            const formData = new FormData();
            formData.append('image_asset[file]', file);
            formData.append('image_asset[title]', file.name);
            formData.append('image_asset[source]', 'upload');

            const csrf = document.querySelector('meta[name="csrf-token"]')?.content;
            const res = await fetch('/image_assets.json', {
              method: 'POST',
              headers: csrf ? { 'X-CSRF-Token': csrf } : {},
              body: formData
            });
            const data = await res.json();
            if (data && data.image && data.image.id) {
              console.log(`📥 Uploaded image ${file.name} -> asset ${data.image.id}`);
              // Save as library selection for this slot so downstream uses real asset
              librarySelections[i] = { id: data.image.id, url: data.image.url, title: data.image.title };
              updateImagesData();
            } else {
              console.warn('⚠️ Upload returned unexpected payload', data);
            }
          } catch (err) {
            console.error('❌ Failed to upload image to library', err);
          }
        }
      });
    } else {
      console.warn(`⚠️ Missing elements for image ${i}:`, {
        fileInput: !!fileInput,
        preview: !!preview,
        block: !!block
      });
    }
    
    // Handle AI prompt changes
    const promptInput = document.getElementById(`image-prompt-${i}`);
    if (promptInput) {
      promptInput.addEventListener('input', function() {
        const block = this.closest('.image-upload-block');
        if (this.value.trim()) {
          block?.classList.add('has-prompt');
          console.log(`🤖 AI prompt added for image ${i}: ${this.value}`);
        } else {
          block?.classList.remove('has-prompt');
        }
        updateImagesData();
      });
    }
  }
  
  function updateImagesData() {
    const data = {
      images: [],
      design_reference: null
    };
    
    // Collect image data
    for (let i = 1; i <= 3; i++) {
      const fileInput = document.getElementById(`image-file-${i}`);
      const promptInput = document.getElementById(`image-prompt-${i}`);
      
      const imageData = {
        slot: i,
        type: 'none'
      };
      
      if (fileInput?.files[0]) {
        imageData.type = 'upload';
        imageData.filename = fileInput.files[0].name;
        imageData.size = fileInput.files[0].size;
      } else if (promptInput?.value.trim()) {
        imageData.type = 'ai_generate';
        imageData.prompt = promptInput.value.trim();
      }
      if (librarySelections[i]) {
        imageData.type = 'library';
        imageData.asset_id = librarySelections[i].id;
        imageData.url = librarySelections[i].url;
        imageData.filename = librarySelections[i].title || imageData.filename;
      }
      
      if (imageData.type !== 'none') {
        data.images.push(imageData);
      }
    }
    
    // Collect design reference data
    const designFileInput = document.getElementById('design-reference-file');
    const designNotes = document.getElementById('design-notes');
    
    if (designFileInput?.files[0]) {
      data.design_reference = {
        filename: designFileInput.files[0].name,
        size: designFileInput.files[0].size,
        type: designFileInput.files[0].type,
        notes: designNotes?.value.trim() || ''
      };
    }
    
    document.getElementById('images-data').value = JSON.stringify(data);
    console.log('📸 Updated complete data:', data);
  }
  
  // Track library selections per slot
  const librarySelections = {};

  // Media Library Modal logic
  window.openMediaLibrary = function(slot) {
    ensureMediaLibraryModal();
    const modalEl = document.getElementById('mediaLibraryModal');
    const listEl = modalEl.querySelector('.media-library-grid');
    listEl.innerHTML = '<div class="text-center p-3"><div class="spinner-border text-primary" role="status"></div></div>';
    fetch('/image_assets.json')
      .then(r => r.json())
      .then(json => {
        const images = json.images || [];
        if (images.length === 0) {
          listEl.innerHTML = '<div class="text-center p-3 text-muted">No images in your library yet.</div>';
          return;
        }
        listEl.innerHTML = images.map(img => (
          `<div class="media-card" data-id="${img.id}" data-url="${img.url}" data-title="${img.title}">
            <img src="${img.url}" alt="${img.title}" />
            <div class="media-title">${img.title || ''}</div>
          </div>`
        )).join('');
        listEl.querySelectorAll('.media-card').forEach(card => {
          card.addEventListener('click', () => {
            const id = parseInt(card.getAttribute('data-id'));
            const url = card.getAttribute('data-url');
            const title = card.getAttribute('data-title');
            librarySelections[slot] = { id, url, title };
            const preview = document.getElementById(`image-preview-${slot}`);
            const block = preview?.closest('.image-upload-block');
            if (preview) {
              preview.innerHTML = `<img src="${url}" alt="Selected image ${slot}" class="uploaded-image">`;
              preview.classList.add('has-image');
            }
            block?.classList.add('has-upload');
            updateImagesData();
            closeMediaLibrary();
          });
        });
      })
      .catch(() => {
        listEl.innerHTML = '<div class="text-danger p-3">Failed to load media library.</div>';
      });
    const modal = new bootstrap.Modal(modalEl);
    modal.show();
  }

  function ensureMediaLibraryModal() {
    if (document.getElementById('mediaLibraryModal')) return;
    const modalHtml = `
    <div class="modal fade" id="mediaLibraryModal" tabindex="-1" aria-hidden="true">
      <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
          <div class="modal-header">
            <h5 class="modal-title"><i data-lucide="camera" class="me-2"></i>Media Library</h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
          </div>
          <div class="modal-body">
            <div class="media-library-grid"></div>
          </div>
          <div class="modal-footer">
            <a href="/image_assets/new" target="_blank" class="btn btn-outline-secondary">Add Images</a>
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
          </div>
        </div>
      </div>
    </div>`;
    document.body.insertAdjacentHTML('beforeend', modalHtml);
    const style = document.createElement('style');
    style.textContent = `
      .media-library-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(140px, 1fr)); gap: 12px; }
      .media-card { cursor: pointer; border: 1px solid #e5e7eb; border-radius: 8px; overflow: hidden; background: #fff; }
      .media-card img { width: 100%; height: 100px; object-fit: cover; display: block; }
      .media-card .media-title { font-size: 12px; padding: 6px 8px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    `;
    document.head.appendChild(style);
  }

  function closeMediaLibrary() {
    const modalEl = document.getElementById('mediaLibraryModal');
    if (!modalEl) return;
    const modal = bootstrap.Modal.getInstance(modalEl);
    modal?.hide();
  }

  } // End initializeImageUploadBlocks function
  
  // Initialize when DOM is ready or immediately if already ready
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initializeImageUploadBlocks);
  } else {
    initializeImageUploadBlocks();
  }
  
  window.imageUploadBlocksInitialized = true;
}
</script>