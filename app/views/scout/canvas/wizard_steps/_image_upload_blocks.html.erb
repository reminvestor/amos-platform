<div class="image-upload-section">
  <p class="text-muted mb-3">
    Add up to 3 images for your landing page. You can upload your own images, describe images for AI to create, or leave blank for AI to choose automatically.
  </p>
  
  <div class="row g-3">
    <!-- Image Block 1 -->
    <div class="col-md-4">
      <div class="image-upload-block">
        <div class="image-preview" id="image-preview-1">
          <div class="upload-placeholder">
            <i class="fas fa-image text-muted mb-2"></i>
            <p class="text-muted small mb-0">Image 1</p>
          </div>
        </div>
        
        <div class="image-options mt-2">
          <div class="btn-group-vertical w-100" role="group">
            <input type="file" id="image-file-1" name="image_file_1" accept="image/*" class="d-none">
            <button type="button" class="btn btn-outline-primary btn-sm" onclick="document.getElementById('image-file-1').click()">
              <i class="fas fa-upload me-1"></i> Upload Image
            </button>
            <input type="text" 
                   id="image-prompt-1" 
                   name="image_prompt_1" 
                   class="form-control form-control-sm mt-1" 
                   placeholder="Or describe image for AI to create...">
          </div>
        </div>
      </div>
    </div>
    
    <!-- Image Block 2 -->
    <div class="col-md-4">
      <div class="image-upload-block">
        <div class="image-preview" id="image-preview-2">
          <div class="upload-placeholder">
            <i class="fas fa-image text-muted mb-2"></i>
            <p class="text-muted small mb-0">Image 2</p>
          </div>
        </div>
        
        <div class="image-options mt-2">
          <div class="btn-group-vertical w-100" role="group">
            <input type="file" id="image-file-2" name="image_file_2" accept="image/*" class="d-none">
            <button type="button" class="btn btn-outline-primary btn-sm" onclick="document.getElementById('image-file-2').click()">
              <i class="fas fa-upload me-1"></i> Upload Image
            </button>
            <input type="text" 
                   id="image-prompt-2" 
                   name="image_prompt_2" 
                   class="form-control form-control-sm mt-1" 
                   placeholder="Or describe image for AI to create...">
          </div>
        </div>
      </div>
    </div>
    
    <!-- Image Block 3 -->
    <div class="col-md-4">
      <div class="image-upload-block">
        <div class="image-preview" id="image-preview-3">
          <div class="upload-placeholder">
            <i class="fas fa-image text-muted mb-2"></i>
            <p class="text-muted small mb-0">Image 3</p>
          </div>
        </div>
        
        <div class="image-options mt-2">
          <div class="btn-group-vertical w-100" role="group">
            <input type="file" id="image-file-3" name="image_file_3" accept="image/*" class="d-none">
            <button type="button" class="btn btn-outline-primary btn-sm" onclick="document.getElementById('image-file-3').click()">
              <i class="fas fa-upload me-1"></i> Upload Image
            </button>
            <input type="text" 
                   id="image-prompt-3" 
                   name="image_prompt_3" 
                   class="form-control form-control-sm mt-1" 
                   placeholder="Or describe image for AI to create...">
          </div>
        </div>
      </div>
    </div>
  </div>
  
  <!-- Hidden fields to store image data for form submission -->
  <input type="hidden" id="images-data" name="images_data" value="">
</div>

<style>
.image-upload-block {
  border: 2px dashed #dee2e6;
  border-radius: 0.5rem;
  padding: 1rem;
  transition: all 0.2s ease;
  background: #f8f9fa;
}

.image-upload-block:hover {
  border-color: #6366f1;
  background: #f0f0ff;
}

.image-preview {
  aspect-ratio: 16/9;
  background: white;
  border-radius: 0.375rem;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1px solid #dee2e6;
  overflow: hidden;
}

.upload-placeholder {
  text-align: center;
}

.upload-placeholder i {
  font-size: 2rem;
}

.image-preview img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.image-preview.has-image {
  border-color: #28a745;
  background: #f8fff8;
}

.image-upload-block.has-upload {
  border-color: #28a745;
  border-style: solid;
  background: #f8fff8;
}

.image-upload-block.has-prompt {
  border-color: #6366f1;
  border-style: solid;
  background: #f0f0ff;
}
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
  // Handle file uploads
  for (let i = 1; i <= 3; i++) {
    const fileInput = document.getElementById(`image-file-${i}`);
    const preview = document.getElementById(`image-preview-${i}`);
    const block = fileInput?.closest('.image-upload-block');
    
    if (fileInput && preview) {
      fileInput.addEventListener('change', function(e) {
        const file = e.target.files[0];
        if (file) {
          const reader = new FileReader();
          reader.onload = function(e) {
            preview.innerHTML = `<img src="${e.target.result}" alt="Uploaded image ${i}">`;
            preview.classList.add('has-image');
            block?.classList.add('has-upload');
            updateImagesData();
          };
          reader.readAsDataURL(file);
        }
      });
    }
    
    // Handle AI prompt changes
    const promptInput = document.getElementById(`image-prompt-${i}`);
    if (promptInput) {
      promptInput.addEventListener('input', function() {
        const block = this.closest('.image-upload-block');
        if (this.value.trim()) {
          block?.classList.add('has-prompt');
        } else {
          block?.classList.remove('has-prompt');
        }
        updateImagesData();
      });
    }
  }
  
  function updateImagesData() {
    const imagesData = [];
    
    for (let i = 1; i <= 3; i++) {
      const fileInput = document.getElementById(`image-file-${i}`);
      const promptInput = document.getElementById(`image-prompt-${i}`);
      
      const imageData = {
        slot: i,
        type: 'none'
      };
      
      if (fileInput?.files[0]) {
        imageData.type = 'upload';
        imageData.filename = fileInput.files[0].name;
        imageData.size = fileInput.files[0].size;
      } else if (promptInput?.value.trim()) {
        imageData.type = 'ai_generate';
        imageData.prompt = promptInput.value.trim();
      }
      
      if (imageData.type !== 'none') {
        imagesData.push(imageData);
      }
    }
    
    document.getElementById('images-data').value = JSON.stringify(imagesData);
    console.log('📸 Updated images data:', imagesData);
  }
});
</script>
