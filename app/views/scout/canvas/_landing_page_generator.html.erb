<div class="scout-canvas landing-page-generator">
  <div class="canvas-header d-flex justify-content-between align-items-center mb-4">
    <div>
      <h4 class="mb-1" style="color: var(--scout-text);">
        <i class="fas fa-magic me-2" style="color: var(--scout-primary);"></i>
        Landing Page Wizard
      </h4>
      <p class="mb-0" style="color: var(--scout-text-muted);">
        Create a professional landing page in 2 simple steps
      </p>
    </div>
    <div class="d-flex gap-2">
      <button class="btn btn-outline-secondary" onclick="scoutBackToLandingPages()" 
              style="color: var(--scout-text); border-color: var(--scout-border);">
        <i class="fas fa-arrow-left me-1"></i>
        Back to Pages
      </button>
    </div>
  </div>

  <!-- Progress Steps -->
  <div class="wizard-progress mb-4">
    <div class="d-flex justify-content-center">
      <div class="step-indicator">
        <div class="step active" id="step-indicator-1">
          <div class="step-number">1</div>
          <div class="step-label">Page Details</div>
        </div>
        <div class="step-connector"></div>
        <div class="step" id="step-indicator-2">
          <div class="step-number">2</div>
          <div class="step-label">Pictures</div>
        </div>
        <div class="step-connector"></div>
        <div class="step" id="step-indicator-3">
          <div class="step-number">3</div>
          <div class="step-label">Choose Form</div>
        </div>
        <div class="step-connector"></div>
        <div class="step" id="step-indicator-4">
          <div class="step-number">4</div>
          <div class="step-label">Create Page</div>
        </div>
      </div>
    </div>
  </div>

  <!-- Step 1: Page Details -->
  <div class="wizard-step" id="wizard-step-1">
    <div class="row justify-content-center">
      <div class="col-lg-6">
        <div class="card border-0 shadow-sm" style="background: var(--scout-secondary); border: 1px solid var(--scout-border) !important;">
          <div class="card-header text-white text-center" style="background: var(--scout-primary); border-bottom: 1px solid var(--scout-border);">
            <h5 class="mb-0">
              <i class="fas fa-edit me-2"></i>
              Step 1: Page Details
            </h5>
          </div>
          <div class="card-body p-4" style="background: var(--scout-secondary); color: var(--scout-text);">
            <form id="step1Form">
              <div class="mb-4">
                <label class="form-label h6" style="color: var(--scout-text);">Page Title *</label>
                <input type="text" class="form-control form-control-lg" id="pageTitle" 
                       style="background: var(--scout-bg); border: 1px solid var(--scout-border); color: var(--scout-text);"
                       placeholder="e.g., Free Marketing Consultation, Download Our Guide..." 
                       required>
                <small class="text-muted" style="color: var(--scout-text-muted);">This will be the main headline of your landing page</small>
              </div>
              
              <div class="mb-4">
                <label class="form-label h6" style="color: var(--scout-text);">
                  Page Description * 
                  <span class="text-muted fw-normal" style="color: var(--scout-text-muted);">(for AI understanding)</span>
                </label>
                <textarea class="form-control" id="pageDescription" rows="4" 
                          style="background: var(--scout-bg); border: 1px solid var(--scout-border); color: var(--scout-text);"
                          placeholder="Describe what this landing page should accomplish. For example: 'Generate leads for our marketing consultation service by highlighting our expertise and offering a free 30-minute strategy session. Target small business owners who need help with digital marketing.'"
                          required></textarea>
                <small class="text-muted" style="color: var(--scout-text-muted);">
                  <i class="fas fa-robot me-1"></i>
                  This helps our AI understand your goals and create better content. Be specific about your target audience and desired outcomes.
                </small>
              </div>

              <div class="d-grid">
                <button type="button" class="btn btn-primary btn-lg" onclick="goToStep2()">
                  Continue to Form Selection
                  <i class="fas fa-arrow-right ms-2"></i>
                </button>
              </div>
            </form>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Step 2: Pictures -->
  <div class="wizard-step d-none" id="wizard-step-2">
    <div class="row justify-content-center">
      <div class="col-lg-10">
        <div class="card border-0 shadow-sm" style="background: var(--scout-secondary); border: 1px solid var(--scout-border) !important;">
          <div class="card-header text-white text-center" style="background: #0d6efd; border-bottom: 1px solid var(--scout-border);">
            <h5 class="mb-0">
              <i class="fas fa-image me-2"></i>
              Step 2: Pictures
            </h5>
          </div>
          <div class="card-body p-4" style="background: var(--scout-secondary); color: var(--scout-text);">
            <div class="row g-4">
              <div class="col-md-6">
                <h6 class="mb-2">Hero Image</h6>
                <div class="input-group mb-2">
                  <input id="heroPrompt" type="text" class="form-control" placeholder="Describe a hero image to generate (optional)"/>
                  <button class="btn btn-outline-primary" type="button" onclick="generateAiImage('heroPrompt','heroPreview','1200x600')">
                    <i class="fas fa-wand-magic-sparkles"></i>
                  </button>
                </div>
                <div class="mb-2 d-flex gap-2">
                  <button class="btn btn-sm btn-outline-secondary" type="button" onclick="loadImageLibrary('heroPreview')">
                    <i class="fas fa-photo-video me-1"></i>Select from Library
                  </button>
                  <button class="btn btn-sm btn-outline-secondary" type="button" onclick="openImageFilePicker('heroPreview','heroFileInput')">
                    <i class="fas fa-upload me-1"></i>Upload
                  </button>
                  <input id="heroFileInput" type="file" accept="image/*" class="d-none" />
                </div>
                <div class="border rounded p-2 bg-light" style="min-height:140px">
                  <img id="heroPreview" src="https://placehold.co/1200x600?text=Hero" class="img-fluid rounded" alt="Hero preview"/>
                </div>
              </div>
              <div class="col-md-6">
                <h6 class="mb-2">Feature Images</h6>
                <div class="row g-2">
                  <div class="col-6">
                    <div class="input-group input-group-sm mb-1">
                      <input id="feature1Prompt" type="text" class="form-control" placeholder="Feature 1 prompt (optional)"/>
                      <button class="btn btn-outline-primary" type="button" onclick="generateAiImage('feature1Prompt','feature1Preview','100x100')"><i class="fas fa-wand-magic-sparkles"></i></button>
                    </div>
                    <div class="mb-1 d-flex gap-2">
                      <button class="btn btn-sm btn-outline-secondary" type="button" onclick="loadImageLibrary('feature1Preview')">Library</button>
                      <button class="btn btn-sm btn-outline-secondary" type="button" onclick="openImageFilePicker('feature1Preview','feature1FileInput')">Upload</button>
                      <input id="feature1FileInput" type="file" accept="image/*" class="d-none" />
                    </div>
                    <img id="feature1Preview" src="https://placehold.co/100x100?text=1" class="img-fluid rounded border bg-light" alt="Feature 1"/>
                  </div>
                  <div class="col-6">
                    <div class="input-group input-group-sm mb-1">
                      <input id="feature2Prompt" type="text" class="form-control" placeholder="Feature 2 prompt (optional)"/>
                      <button class="btn btn-outline-primary" type="button" onclick="generateAiImage('feature2Prompt','feature2Preview','100x100')"><i class="fas fa-wand-magic-sparkles"></i></button>
                    </div>
                    <div class="mb-1 d-flex gap-2">
                      <button class="btn btn-sm btn-outline-secondary" type="button" onclick="loadImageLibrary('feature2Preview')">Library</button>
                      <button class="btn btn-sm btn-outline-secondary" type="button" onclick="openImageFilePicker('feature2Preview','feature2FileInput')">Upload</button>
                      <input id="feature2FileInput" type="file" accept="image/*" class="d-none" />
                    </div>
                    <img id="feature2Preview" src="https://placehold.co/100x100?text=2" class="img-fluid rounded border bg-light" alt="Feature 2"/>
                  </div>
                </div>
              </div>
            </div>

            <div class="mt-4">
              <div class="d-flex gap-2">
                <button type="button" class="btn btn-outline-secondary" onclick="goToStep1()"
                        style="color: var(--scout-text); border-color: var(--scout-border);">
                  <i class="fas fa-arrow-left me-1"></i>
                  Back
                </button>
                <button type="button" class="btn btn-primary" onclick="goToStep3()">
                  Continue to Form Selection
                  <i class="fas fa-arrow-right ms-2"></i>
                </button>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Step 3: Form Selection -->
  <div class="wizard-step d-none" id="wizard-step-3">
    <div class="row justify-content-center">
      <div class="col-lg-8">
        <div class="card border-0 shadow-sm" style="background: var(--scout-secondary); border: 1px solid var(--scout-border) !important;">
          <div class="card-header text-white text-center" style="background: #198754; border-bottom: 1px solid var(--scout-border);">
            <h5 class="mb-0">
              <i class="fas fa-wpforms me-2"></i>
              Step 2: Choose a Contact Form
            </h5>
          </div>
          <div class="card-body p-4" style="background: var(--scout-secondary); color: var(--scout-text);">
            <p class="text-center mb-4" style="color: var(--scout-text-muted);">
              Select a form template to collect visitor information, or choose no form if you prefer.
            </p>

            <div class="form-selection-grid">
              <!-- No Form Option -->
              <div class="form-option" data-form-type="none">
                <div class="form-option-card">
                  <div class="form-option-icon">
                    <i class="fas fa-times-circle"></i>
                  </div>
                  <h6>No Form</h6>
                  <small style="color: var(--scout-text-muted);">Just content, no contact collection</small>
                </div>
              </div>

              <!-- Custom Form Option -->
              <div class="form-option" data-form-type="custom">
                <div class="form-option-card">
                  <div class="form-option-icon">
                    <i class="fas fa-paint-brush"></i>
                  </div>
                  <h6>Custom Form</h6>
                  <small style="color: var(--scout-text-muted);">I'll describe what I need</small>
                </div>
              </div>

              <!-- Template Forms -->
              <% form_templates.each do |template_key, template_desc| %>
                <div class="form-option" data-form-type="<%= template_key %>">
                  <div class="form-option-card">
                    <div class="form-option-icon">
                      <i class="fas fa-<%= template_key == 'contact_form' ? 'envelope' : 
                                       template_key == 'newsletter_signup' ? 'newspaper' :
                                       template_key == 'lead_magnet' ? 'download' :
                                       template_key == 'demo_request' ? 'play-circle' :
                                       template_key == 'event_registration' ? 'calendar' :
                                       template_key == 'free_trial' ? 'gift' :
                                       template_key == 'quote_request' ? 'calculator' :
                                       template_key == 'consultation_booking' ? 'handshake' : 'wpforms' %>"></i>
                    </div>
                    <h6><%= template_desc.split(' with ').first.split(' for ').first %></h6>
                    <small style="color: var(--scout-text-muted);"><%= template_desc %></small>
                  </div>
                </div>
              <% end %>
            </div>

            <div class="mt-4">
              <div class="d-flex gap-2">
                <button type="button" class="btn btn-outline-secondary" onclick="goToStep1()"
                        style="color: var(--scout-text); border-color: var(--scout-border);">
                  <i class="fas fa-arrow-left me-1"></i>
                  Back
                </button>
                <button type="button" class="btn btn-success flex-fill" id="createPageBtn" onclick="createLandingPage()" disabled>
                  <i class="fas fa-magic me-1"></i>
                  Create My Landing Page
                </button>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Step 4: Creating Page -->
  <div class="wizard-step d-none" id="wizard-step-4">
    <div class="row justify-content-center">
      <div class="col-lg-6">
        <div class="card border-0 shadow-sm" style="background: var(--scout-secondary); border: 1px solid var(--scout-border) !important;">
          <div class="card-body text-center p-5" style="background: var(--scout-secondary); color: var(--scout-text);">
            <div class="spinner-border mb-3" role="status" style="width: 3rem; height: 3rem; color: var(--scout-primary);">
              <span class="visually-hidden">Loading...</span>
            </div>
            <h5 class="mb-3" style="color: var(--scout-text);">Creating Your Landing Page...</h5>
            <p class="mb-0" id="creationStatus" style="color: var(--scout-text-muted);">
              Our AI is analyzing your requirements and generating professional content
            </p>
            <div class="progress mt-3" style="height: 8px; background: var(--scout-border);">
              <div class="progress-bar progress-bar-striped progress-bar-animated" 
                   role="progressbar" style="width: 100%; background: var(--scout-primary);"></div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
function scoutBackToLandingPages() {
  window.scoutLoadCanvas?.('landing_page_viewer');
}

// Initialize wizard when canvas loads
console.log('Landing page wizard loaded');
console.log('Wizard functions available:', {
  goToStep1: typeof window.goToStep1,
  goToStep2: typeof window.goToStep2,
  createLandingPage: typeof window.createLandingPage,
  landingPageWizard: typeof window.landingPageWizard
});

// Initialize form selection when DOM is ready
setTimeout(() => {
  if (window.landingPageWizard) {
    window.landingPageWizard.init();
  }
}, 100);
</script>

<style>
.landing-page-generator {
  min-height: 100%;
  background: var(--scout-bg);
  padding: 20px;
  color: var(--scout-text);
}

/* Wizard Progress Styles */
.wizard-progress {
  background: var(--scout-secondary);
  border-radius: 15px;
  padding: 20px;
  box-shadow: 0 2px 10px var(--scout-shadow);
  border: 1px solid var(--scout-border);
}

.step-indicator {
  display: flex;
  align-items: center;
  max-width: 600px;
}

.step {
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
}

.step-number {
  width: 40px;
  height: 40px;
  border-radius: 50%;
  background: var(--scout-border);
  color: var(--scout-text-muted);
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: bold;
  transition: all 0.3s ease;
  margin-bottom: 8px;
}

.step.active .step-number {
  background: var(--scout-primary);
  color: white;
}

.step.completed .step-number {
  background: #198754;
  color: white;
}

.step-label {
  font-size: 12px;
  font-weight: 500;
  color: var(--scout-text-muted);
  text-align: center;
}

.step.active .step-label {
  color: var(--scout-primary);
  font-weight: 600;
}

.step.completed .step-label {
  color: #198754;
}

.step-connector {
  width: 100px;
  height: 2px;
  background: var(--scout-border);
  margin: 0 20px;
  margin-bottom: 20px;
}

/* Form Selection Grid */
.form-selection-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
  gap: 15px;
  margin-bottom: 20px;
}

.form-option {
  cursor: pointer;
  transition: transform 0.2s ease;
}

.form-option:hover {
  transform: translateY(-2px);
}

.form-option-card {
  background: var(--scout-secondary);
  border: 2px solid var(--scout-border);
  border-radius: 12px;
  padding: 20px;
  text-align: center;
  height: 120px;
  display: flex;
  flex-direction: column;
  justify-content: center;
  transition: all 0.3s ease;
}

.form-option:hover .form-option-card {
  border-color: var(--scout-primary);
  box-shadow: 0 4px 15px rgba(99, 102, 241, 0.15);
}

.form-option.selected .form-option-card {
  border-color: #198754;
  background: var(--scout-bg);
  box-shadow: 0 4px 15px rgba(25, 135, 84, 0.15);
}

.form-option-icon {
  font-size: 24px;
  color: var(--scout-text-muted);
  margin-bottom: 8px;
}

.form-option.selected .form-option-icon {
  color: #198754;
}

.form-option-card h6 {
  margin-bottom: 4px;
  color: var(--scout-text);
}

.form-option.selected .form-option-card h6 {
  color: #198754;
  font-weight: 600;
}

/* Card Enhancements */
.card {
  border-radius: 15px !important;
  overflow: hidden;
}

.card-header {
  border-radius: 15px 15px 0 0 !important;
}

/* Dark theme form inputs */
.landing-page-generator .form-control {
  background: var(--scout-bg) !important;
  border: 1px solid var(--scout-border) !important;
  color: var(--scout-text) !important;
}

.landing-page-generator .form-control:focus {
  background: var(--scout-bg) !important;
  border-color: var(--scout-primary) !important;
  box-shadow: 0 0 0 0.2rem rgba(99, 102, 241, 0.25) !important;
  color: var(--scout-text) !important;
}

.landing-page-generator .form-control::placeholder {
  color: var(--scout-text-muted) !important;
  opacity: 0.7;
}

/* Dark theme button styles */
.landing-page-generator .btn-outline-secondary {
  color: var(--scout-text) !important;
  border-color: var(--scout-border) !important;
}

.landing-page-generator .btn-outline-secondary:hover {
  background: var(--scout-secondary) !important;
  border-color: var(--scout-border) !important;
  color: var(--scout-text) !important;
}

/* Override Bootstrap text utilities */
.landing-page-generator .text-muted {
  color: var(--scout-text-muted) !important;
}

.landing-page-generator h6, 
.landing-page-generator h5, 
.landing-page-generator h4 {
  color: var(--scout-text) !important;
}

/* Animation for step transitions */
.wizard-step {
  animation: fadeIn 0.5s ease-in-out;
}

@keyframes fadeIn {
  from {
    opacity: 0;
    transform: translateY(20px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* Responsive adjustments */
@media (max-width: 768px) {
  .form-selection-grid {
    grid-template-columns: repeat(2, 1fr);
  }
  
  .step-connector {
    width: 60px;
    margin: 0 10px;
  }
  
  .step-indicator {
    font-size: 14px;
  }
  
  .step-number {
    width: 35px;
    height: 35px;
  }
}
</style> 

<!-- Image Library Modal -->
<div class="modal fade" id="imageLibraryModal" tabindex="-1" aria-labelledby="imageLibraryLabel" aria-hidden="true">
  <div class="modal-dialog modal-lg modal-dialog-scrollable">
    <div class="modal-content" style="background: var(--scout-secondary); color: var(--scout-text); border: 1px solid var(--scout-border)">
      <div class="modal-header" style="border-bottom: 1px solid var(--scout-border)">
        <h5 class="modal-title" id="imageLibraryLabel"><i class="fas fa-photo-video me-2"></i>Select Image</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <div class="row g-3" id="imageLibraryGrid">
          <!-- thumbnails injected here -->
        </div>
        <div class="d-flex justify-content-between align-items-center mt-3">
          <small class="text-muted" id="imageLibraryCount"></small>
          <div class="btn-group">
            <button class="btn btn-sm btn-outline-secondary" id="libPrevBtn">Prev</button>
            <button class="btn btn-sm btn-outline-secondary" id="libNextBtn">Next</button>
          </div>
        </div>
      </div>
      <div class="modal-footer" style="border-top: 1px solid var(--scout-border)">
        <button type="button" class="btn btn-primary" id="libSelectBtn" disabled>Select</button>
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
      </div>
    </div>
  </div>
  <script>
    (function(){
      let libState = { page: 1, perPage: 12, images: [], targetImgId: null, selectedUrl: null };
      const grid = () => document.getElementById('imageLibraryGrid');
      const count = () => document.getElementById('imageLibraryCount');
      const prevBtn = () => document.getElementById('libPrevBtn');
      const nextBtn = () => document.getElementById('libNextBtn');
      const selectBtn = () => document.getElementById('libSelectBtn');
      let modalInstance = null;

      window.openImageLibraryModal = async function(targetId){
        libState.targetImgId = targetId;
        await loadLibraryPage();
        const modalEl = document.getElementById('imageLibraryModal');
        // Use global bootstrap if available, otherwise fallback to window.bootstrap
        const bs = window.bootstrap || bootstrap;
        // Ensure modal is attached directly to <body> for proper stacking context
        if (modalEl.parentNode !== document.body) {
          document.body.appendChild(modalEl)
        }
        modalInstance = bs.Modal.getOrCreateInstance(modalEl);
        modalEl.classList.add('show-on-top')
        // Reset selection each time
        libState.selectedUrl = null;
        updateSelectState();
        modalEl.addEventListener('hidden.bs.modal', () => {
          libState.selectedUrl = null;
          updateSelectState();
        }, { once: true })
        modalInstance.show();
      }

      async function loadLibraryPage(){
        const res = await fetch('/image_assets.json');
        const data = await res.json();
        libState.images = data.images || [];
        renderPage();
      }

      function renderPage(){
        const start = (libState.page - 1) * libState.perPage;
        const slice = libState.images.slice(start, start + libState.perPage);
        const html = slice.map(img => `
          <div class="col-6 col-md-4 col-lg-3">
            <div class="card h-100 border-0 shadow-sm lib-thumb ${libState.selectedUrl===img.url?'selected':''}" style="background: var(--scout-bg); border: 1px solid var(--scout-border) !important; cursor: pointer; user-select: none;" data-url="${img.url}">
              <div class="ratio ratio-1x1">
                <img src="${img.url}" class="card-img-top" alt="${img.title}" style="object-fit: cover;">
              </div>
              <div class="card-body p-2">
                <div class="small text-truncate" title="${img.title}">${img.title}</div>
              </div>
            </div>
          </div>`).join('');
        grid().innerHTML = html || '<div class="text-center text-muted">No images yet</div>';
        count().textContent = `${libState.images.length} images`;
        wireThumbClicks();
        wirePager();
        updateSelectState();
      }

      function wireThumbClicks(){
        grid().querySelectorAll('[data-url]').forEach(card => {
          card.addEventListener('click', () => {
            libState.selectedUrl = card.getAttribute('data-url');
            grid().querySelectorAll('.lib-thumb').forEach(el => el.classList.remove('selected'))
            card.classList.add('selected')
            updateSelectState();
          });
        });
        // Footer Select button
        selectBtn().onclick = (e) => {
          e.preventDefault();
          if (!libState.selectedUrl) return;
          const imgEl = document.getElementById(libState.targetImgId);
          if (imgEl) imgEl.src = libState.selectedUrl;
          if (window.rememberSelectedImage) window.rememberSelectedImage(libState.targetImgId, libState.selectedUrl);
          if (modalInstance) modalInstance.hide();
        }
      }

      function updateSelectState(){
        if (!selectBtn()) return;
        selectBtn().disabled = !libState.selectedUrl;
      }

      function wirePager(){
        prevBtn().onclick = () => { if (libState.page > 1) { libState.page--; renderPage(); } };
        const maxPage = Math.max(1, Math.ceil(libState.images.length / libState.perPage));
        nextBtn().onclick = () => { if (libState.page < maxPage) { libState.page++; renderPage(); } };
      }

      // Expose a nicer entry point used by the wizard buttons
      window.loadImageLibrary = function(targetImgId){
        openImageLibraryModal(targetImgId);
      }
    })();
  </script>
</div>

