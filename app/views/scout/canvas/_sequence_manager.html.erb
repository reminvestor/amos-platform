  opacity: 0.4;
}

.sequence-more-steps {
  font-size: 0.75rem;
  color: var(--sm-text-muted);
  margin-left: 0.5rem;
}

/* Metrics */
.sequence-metrics {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 0.5rem;
  margin-bottom: 1rem;
}

.sequence-metric {
  text-align: center;
}

.sequence-metric-value {
  display: block;
  font-size: 1.125rem;
  font-weight: 700;
  color: var(--sm-text);
}

.sequence-metric-label {
  font-size: 0.625rem;
  color: var(--sm-text-muted);
  text-transform: uppercase;
  letter-spacing: 0.05em;
}

/* Contact Group */
.sequence-contact-group {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  font-size: 0.75rem;
  color: var(--sm-text-muted);
}

.sequence-contact-group svg {
  width: 14px;
  height: 14px;
}

/* Card Footer */
.sequence-card-footer {
  padding: 1rem 1.25rem;
  border-top: 1px solid var(--sm-border);
  display: flex;
  gap: 0.5rem;
}

.sequence-card-footer .canvas-btn {
  flex: 1;
}

/* Sequence Detail Panel */
.sequence-detail-panel {
  background: var(--sm-card-bg);
  border: 1px solid var(--sm-border);
  border-radius: 16px;
  padding: 1.5rem;
}

.detail-panel-top-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 0.5rem;
}

.detail-panel-title-row {
  display: flex;
  align-items: center;
  gap: 0.75rem;
}

.sequence-detail-panel h2 {
  color: var(--sm-text);
  margin: 0;
