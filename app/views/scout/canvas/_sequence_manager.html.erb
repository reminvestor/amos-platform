}

.step-body-editor {
  width: 100%;
  min-height: 120px;
  max-height: 400px;
  overflow-y: auto;
  background: var(--sm-card-bg);
  border: 1px solid var(--sm-border);
  border-radius: 6px;
  padding: 0.75rem;
  font-size: 0.85rem;
  color: var(--sm-text);
  line-height: 1.6;
  outline: none;
  transition: border-color 0.2s;
}

.step-body-editor:focus {
  border-color: #3B82F6;
}

.step-body-editor h1, .step-body-editor h2, .step-body-editor h3 { color: var(--sm-text); }
.step-body-editor p { margin: 0.5em 0; }
.step-body-editor a { color: #3B82F6; }
.step-body-editor strong { font-weight: 700; }

/* Variable Insert Pills */
.step-variable-pills {
  display: flex;
  align-items: center;
  gap: 0.35rem;
  flex-wrap: wrap;
  margin-top: 0.5rem;
  padding-top: 0.5rem;
