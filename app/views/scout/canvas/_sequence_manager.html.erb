/* Metrics Grid */
.detail-metrics-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(100px, 1fr));
  gap: 0.75rem;
  margin-bottom: 1.5rem;
}

.detail-metric-card {
  text-align: center;
  padding: 0.75rem 0.5rem;
  background: var(--sm-timeline-bg);
  border-radius: 10px;
}

.detail-metric-value {
  font-size: 1.25rem;
  font-weight: 700;
  color: var(--sm-text);
}

.detail-metric-label {
  font-size: 0.65rem;
  color: var(--sm-text-muted);
  text-transform: uppercase;
  letter-spacing: 0.05em;
