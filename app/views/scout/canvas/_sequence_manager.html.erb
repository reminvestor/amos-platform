}

.seq-text-toolbar.visible {
  display: flex;
}

[data-theme="dark"] .seq-text-toolbar,
[data-bs-theme="dark"] .seq-text-toolbar {
  background: #1a1a2e;
  border-color: #2d2d44;
  box-shadow: 0 4px 16px rgba(0,0,0,0.4);
}

.seq-toolbar-btn {
  width: 30px;
  height: 30px;
  display: flex;
