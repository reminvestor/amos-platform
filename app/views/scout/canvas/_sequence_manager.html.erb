.sequence-step-detail:last-child .step-connector {
  display: none;
}

.step-detail-content {
  flex: 1;
  margin-left: 0.75rem;
  background: var(--sm-timeline-bg);
  border: 1px solid var(--sm-border);
  border-radius: 10px;
  padding: 0.75rem 1rem;
  margin-bottom: 0.75rem;
}

.step-detail-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 0.5rem;
  margin-bottom: 0.35rem;
}

.step-detail-content .step-subject {
  font-weight: 600;
  color: var(--sm-text);
  font-size: 0.9rem;
}

.step-delay-badge {
  display: inline-flex;
  align-items: center;
  gap: 0.25rem;
  font-size: 0.7rem;
  color: var(--sm-text-muted);
  background: rgba(59, 130, 246, 0.1);
  padding: 0.2rem 0.5rem;
  border-radius: 999px;
  white-space: nowrap;
  flex-shrink: 0;
}

.step-body-preview {
  font-size: 0.8rem;
  color: var(--sm-text-muted);
  line-height: 1.4;
  margin-bottom: 0.5rem;
  padding: 0.5rem 0.75rem;
  background: rgba(0,0,0,0.03);
  border-radius: 6px;
  border-left: 3px solid var(--sm-border);
}

[data-theme="dark"] .step-body-preview,
[data-bs-theme="dark"] .step-body-preview {
  background: rgba(255,255,255,0.03);
}

.step-detail-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 0.5rem;
  flex-wrap: wrap;
}

.step-template-badge {
  display: inline-flex;
  align-items: center;
  gap: 0.25rem;
  font-size: 0.7rem;
  color: #10B981;
  background: rgba(16, 185, 129, 0.1);
  padding: 0.2rem 0.5rem;
  border-radius: 999px;
}

.step-template-badge.inline-content {
  color: var(--sm-text-muted);
  background: rgba(107, 114, 128, 0.1);
}

.step-metrics-row {
  display: flex;
  gap: 0.75rem;
  align-items: center;
}

.step-metric {
  font-size: 0.7rem;
  color: var(--sm-text-muted);
}

.step-metric strong {
  color: var(--sm-text);
}

.step-metric.muted {
  font-style: italic;
}

.step-empty-state {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  color: var(--sm-text-muted);
  font-size: 0.85rem;
  padding: 1.5rem;
  text-align: center;
  justify-content: center;
}

/* Contact count on cards */
.sequence-contact-count {
  color: var(--sm-text-muted);
  font-size: 0.7rem;
}

.detail-actions-row {
  display: flex;
  gap: 0.5rem;
  margin-top: 1.5rem;
  flex-wrap: wrap;
}
</style>

<script>
// Sequence Manager JavaScript

// Full sequence data from server
const SEQUENCE_DATA = <%= raw sequences_json.to_json %>;

// Helper: send a chat message via the scout controller
function sendToAmos(message) {
  if (window.scoutController && typeof window.scoutController.sendScoutMessage === 'function') {
    window.scoutController.sendScoutMessage(message);
  } else {
    console.warn('Scout controller not available for message:', message);
  }
}

// Helper: load a canvas via the scout controller
function loadCanvas(canvasType, canvasData) {
  document.dispatchEvent(new CustomEvent('scout:load-canvas', {
    detail: { canvas: canvasType, data: canvasData || {} }
  }));
}

function sequenceRefresh() {
  loadCanvas('sequence_manager', {});
}

function sequenceCreate() {
  sendToAmos('Create a new email sequence for me');
}

function formatDelay(hours) {
  if (hours === 0) return 'Immediately';
  if (hours < 24) return hours + 'h after previous';
  const days = Math.round(hours / 24);
  return days === 1 ? '1 day after previous' : days + ' days after previous';
}

function sequenceView(id) {
  // Find sequence data from server-rendered JSON
  const seq = SEQUENCE_DATA.find(s => s.id === id);
  if (!seq) return;

  // If already showing detail, collapse
  const existingDetail = document.getElementById('sequence-detail-panel');
  if (existingDetail) {
    const previousId = existingDetail.dataset.sequenceId;
    existingDetail.remove();
    if (previousId == id) return;
  }

  // Build steps HTML with full detail
  let stepsHtml = '';
  if (seq.steps && seq.steps.length > 0) {
    seq.steps.forEach((step, idx) => {
      const templateBadge = step.has_template
        ? `<span class="step-template-badge"><i data-lucide="file-text" style="width:12px;height:12px;"></i> ${step.template_name || 'Template #' + step.template_id}</span>`
        : `<span class="step-template-badge inline-content"><i data-lucide="pen-line" style="width:12px;height:12px;"></i> Inline content</span>`;

      const delayLabel = idx === 0 ? 'Starts immediately' : formatDelay(step.delay_hours);

      const stepMetrics = (step.sent_count > 0)
        ? `<div class="step-metrics-row">
             <span class="step-metric"><strong>${step.sent_count}</strong> sent</span>
             <span class="step-metric"><strong>${step.opened_count}</strong> opened (${step.open_rate}%)</span>
             <span class="step-metric"><strong>${step.clicked_count}</strong> clicked (${step.click_rate}%)</span>
           </div>`
        : `<div class="step-metrics-row"><span class="step-metric muted">Not sent yet</span></div>`;

      const bodyPreview = step.body_preview
        ? `<div class="step-body-preview">${step.body_preview}</div>`
        : '';

      stepsHtml += `
        <div class="sequence-step-detail">
          <div class="step-number">${step.step_number}</div>
          <div class="step-connector"></div>
          <div class="step-detail-content">
            <div class="step-detail-header">
              <div class="step-subject">${step.subject || 'No subject'}</div>
              <div class="step-delay-badge"><i data-lucide="clock" style="width:12px;height:12px;"></i> ${delayLabel}</div>
            </div>
            ${bodyPreview}
            <div class="step-detail-footer">
              ${templateBadge}
              ${stepMetrics}
            </div>
          </div>
        </div>
      `;
    });
  } else {
    stepsHtml = '<div class="step-empty-state"><i data-lucide="mail-plus" style="width:20px;height:20px;"></i> No steps defined yet. Ask AMOS to add steps to this sequence.</div>';
  }

  // Overall metrics row
  const overallMetrics = `
    <div class="detail-metrics-grid">
      <div class="detail-metric-card">
        <div class="detail-metric-value">${seq.step_count}</div>
        <div class="detail-metric-label">Steps</div>
      </div>
      <div class="detail-metric-card">
        <div class="detail-metric-value">${seq.enrolled_count}</div>
        <div class="detail-metric-label">Enrolled</div>
      </div>
      <div class="detail-metric-card">
        <div class="detail-metric-value">${seq.total_sent}</div>
        <div class="detail-metric-label">Emails Sent</div>
      </div>
      <div class="detail-metric-card">
        <div class="detail-metric-value">${seq.open_rate}%</div>
        <div class="detail-metric-label">Open Rate</div>
      </div>
      <div class="detail-metric-card">
        <div class="detail-metric-value">${seq.click_rate}%</div>
        <div class="detail-metric-label">Click Rate</div>
      </div>
      <div class="detail-metric-card">
        <div class="detail-metric-value">${seq.completion_rate}%</div>
        <div class="detail-metric-label">Completion</div>
      </div>
    </div>
  `;

  // Contact group section
  const contactGroupHtml = `
    <div class="detail-contact-group-section">
      <div class="detail-contact-icon"><i data-lucide="users" style="width:18px;height:18px;"></i></div>
      <div class="detail-contact-info">
        <strong>${seq.contact_group_name}</strong>
        ${seq.contact_group_count > 0 ? `<span class="detail-contact-count">${seq.contact_group_count} contacts</span>` : ''}
      </div>
    </div>
  `;

  // Build detail panel
  const panel = document.createElement('div');
  panel.id = 'sequence-detail-panel';
  panel.dataset.sequenceId = id;
  panel.className = 'sequence-detail-panel';
  panel.style.marginBottom = '1.5rem';
  panel.innerHTML = `
    <div class="detail-panel-top-row" onclick="document.getElementById('sequence-detail-panel')?.remove()" style="cursor:pointer;">
      <div class="detail-panel-title-row">
        <h2>${seq.name}</h2>
        <span class="sequence-status-badge ${seq.status}">
          ${seq.status.charAt(0).toUpperCase() + seq.status.slice(1)}
        </span>
      </div>
      <button class="canvas-btn outline sm" style="flex-shrink: 0;">
        <i data-lucide="x" style="width:14px;height:14px;"></i> Close
      </button>
    </div>
    ${seq.goal ? `<p class="detail-goal">${seq.goal}</p>` : ''}
    <div class="detail-created-date">Created ${seq.created_at}</div>

    ${contactGroupHtml}
    ${overallMetrics}

    <h5 class="detail-section-title">Email Steps</h5>
    <div class="sequence-steps-detail-list">
      ${stepsHtml}
    </div>

    <div class="detail-actions-row">
      <button onclick="event.stopPropagation(); sendToAmos('Show me the complete email content for sequence \\'${seq.name}\\'')" class="canvas-btn primary sm">
        <i data-lucide="mail-open" style="width:14px;height:14px;"></i> View Full Emails
      </button>
      <button onclick="event.stopPropagation(); sendToAmos('Edit email sequence #${id} - ${seq.name}')" class="canvas-btn outline sm">
        <i data-lucide="pencil" style="width:14px;height:14px;"></i> Edit
      </button>
      <button onclick="event.stopPropagation(); sendToAmos('Modify the email templates in sequence \\'${seq.name}\\'')" class="canvas-btn outline sm">
        <i data-lucide="file-edit" style="width:14px;height:14px;"></i> Edit Templates
      </button>
      <button onclick="event.stopPropagation(); if(confirm('Delete this sequence?')) sendToAmos('Delete email sequence #${id}')" class="canvas-btn outline sm" style="color: #EF4444; border-color: #EF4444;">
        <i data-lucide="trash-2" style="width:14px;height:14px;"></i> Delete
      </button>
    </div>
  `;

  // Insert before the grid
  const grid = document.getElementById('sequence-grid');
  grid.parentNode.insertBefore(panel, grid);

  // Scroll into view
  panel.scrollIntoView({ behavior: 'smooth', block: 'start' });

  // Re-init icons
  if (typeof lucide !== 'undefined') lucide.createIcons();
}

async function sequenceActivate(id) {
  if (!confirm('Activate this sequence? Enrolled contacts will start receiving emails.')) return;
  
  try {
    const response = await fetch(`/api/v1/email_sequences/${id}/activate`, {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]')?.content
      }
    });
    
    const data = await response.json();
    if (data.success) {
      showSequenceNotification('Sequence activated! Emails will start sending.', 'success');
      sequenceRefresh();
    } else {
      showSequenceNotification(data.message || 'Failed to activate', 'error');
    }
  } catch (error) {
    console.error('Activate error:', error);
    showSequenceNotification('Failed to activate sequence', 'error');
  }
}

async function sequencePause(id) {
  try {
    const response = await fetch(`/api/v1/email_sequences/${id}/pause`, {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]')?.content
      }
    });
    
    const data = await response.json();
    if (data.success) {
      showSequenceNotification('Sequence paused', 'success');
      sequenceRefresh();
    } else {
      showSequenceNotification(data.message || 'Failed to pause', 'error');
    }
  } catch (error) {
    showSequenceNotification('Failed to pause sequence', 'error');
  }
}

async function sequenceResume(id) {
  try {
    const response = await fetch(`/api/v1/email_sequences/${id}/resume`, {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]')?.content
      }
    });
    
    const data = await response.json();
    if (data.success) {
      showSequenceNotification('Sequence resumed!', 'success');
      sequenceRefresh();
    } else {
      showSequenceNotification(data.message || 'Failed to resume', 'error');
    }
  } catch (error) {
    showSequenceNotification('Failed to resume sequence', 'error');
  }
}

function sequenceMenu(event, id) {
  event.stopPropagation();
  sequenceView(id);
}

function sequenceShowTab(tab) {
  // Update tab buttons
  document.querySelectorAll('.sequence-tab').forEach(btn => {
    btn.classList.remove('active');
  });
  event.target.classList.add('active');
  
  // Remove any open detail panel
  document.getElementById('sequence-detail-panel')?.remove();
  
  // Filter cards
  document.querySelectorAll('.sequence-card').forEach(card => {
    const status = card.dataset.status;
    if (tab === 'all' || status === tab) {
      card.style.display = 'block';
    } else {
      card.style.display = 'none';
    }
  });
}

function showSequenceNotification(message, type) {
  const notification = document.createElement('div');
  notification.className = `sequence-notification ${type}`;
  notification.innerHTML = `
    <span>${message}</span>
    <button onclick="this.parentElement.remove()">&times;</button>
  `;
  
  if (!document.getElementById('sequence-notification-styles')) {
    const style = document.createElement('style');
    style.id = 'sequence-notification-styles';
    style.textContent = `
      .sequence-notification {
        position: fixed;
        top: 20px;
        right: 20px;
        padding: 1rem 1.5rem;
        border-radius: 8px;
        display: flex;
        align-items: center;
        gap: 1rem;
        z-index: 9999;
        animation: slideIn 0.3s ease;
      }
      .sequence-notification.success { background: #10B981; color: white; }
      .sequence-notification.error { background: #EF4444; color: white; }
      .sequence-notification button {
        background: none;
        border: none;
        color: white;
        font-size: 1.5rem;
        cursor: pointer;
        line-height: 1;
      }
      @keyframes slideIn {
        from { transform: translateX(100%); opacity: 0; }
        to { transform: translateX(0); opacity: 1; }
      }
    `;
    document.head.appendChild(style);
  }
  
  document.body.appendChild(notification);
  setTimeout(() => notification.remove(), 5000);
}

// Initialize icons
if (typeof lucide !== 'undefined') {
  lucide.createIcons();
}
</script>
