}

[data-theme="dark"] .seq-toolbar-divider,
[data-bs-theme="dark"] .seq-toolbar-divider {
  background: #2d2d44;
}

.seq-toolbar-link-input {
  display: none;
  padding: 5px 8px;
  background: var(--sm-card-bg, #f8fafc);
  border: 1px solid var(--sm-border, #e2e8f0);
  border-radius: 4px;
  color: var(--sm-text, #1e293b);
  font-size: 12px;
  width: 200px;
  margin-left: 4px;
  outline: none;
}

.seq-toolbar-link-input:focus {
  border-color: #3B82F6;
}

[data-theme="dark"] .seq-toolbar-link-input,
[data-bs-theme="dark"] .seq-toolbar-link-input {
  background: #252536;
  border-color: #2d2d44;
  color: #f1f5f9;
}

.seq-text-toolbar.link-mode .seq-toolbar-link-input {
  display: block;
}

.seq-color-btn { position: relative; }

.seq-color-indicator {
  font-weight: 700;
  font-size: 13px;
  border-bottom: 3px solid #3B82F6;
  line-height: 1;
  padding-bottom: 1px;
}

.seq-color-picker-input {
  position: absolute;
  opacity: 0;
  width: 0;
  height: 0;
  pointer-events: none;
}
</style>

<script>
// Sequence Manager JavaScript

// Full sequence data from server
const SEQUENCE_DATA = <%= raw sequences_json.to_json %>;

// Helper: send a chat message via the scout controller
function sendToAmos(message) {
  if (window.scoutController && typeof window.scoutController.sendScoutMessage === 'function') {
    window.scoutController.sendScoutMessage(message);
  } else {
    console.warn('Scout controller not available for message:', message);
  }
}

// Helper: load a canvas via the scout controller
function loadCanvas(canvasType, canvasData) {
  document.dispatchEvent(new CustomEvent('scout:load-canvas', {
    detail: { canvas: canvasType, data: canvasData || {} }
  }));
}

function sequenceRefresh() {
  document.dispatchEvent(new CustomEvent('scout:load-canvas', {
    detail: { canvas: 'sequence_manager', data: {}, forceRefresh: true }
  }));
}

function sequenceCreate() {
  sendToAmos('Create a new email sequence for me');
}

function formatDelay(hours) {
  if (hours === 0) return 'Immediately';
  if (hours < 24) return hours + 'h after previous';
  const days = Math.round(hours / 24);
  return days === 1 ? '1 day after previous' : days + ' days after previous';
}

function formatDayLabel(hours) {
  if (hours === 0) return 'Day 0';
  const days = Math.round(hours / 24);
  return 'Day ' + days;
}

// Compute cumulative day for each step
function getCumulativeDay(steps, idx) {
  let total = 0;
  for (let i = 0; i <= idx; i++) {
    total += steps[i].delay_hours;
  }
  return Math.round(total / 24);
}

// Describe the sending logic for a step based on its position and metadata
function describeStepLogic(step, idx, totalSteps) {
  const meta = step.metadata || {};
  // Check for explicit condition in metadata
  if (meta.condition) return meta.condition;
  if (meta.send_condition) return meta.send_condition;
  if (meta.description) return meta.description;

  // Auto-generate a human-readable description
  if (idx === 0) {
    return 'Sends to all contacts in the group when the sequence is activated.';
  }
  // For follow-ups, describe the re-engagement logic
  const prevSteps = [];
  for (let i = 0; i < idx; i++) prevSteps.push('Step ' + (i + 1));
  return `Automatically sends to contacts who have not opened ${prevSteps.join(' or ')}.`;
}

// Auto-save step content
let saveTimers = {};
async function autoSaveStep(sequenceId, stepId, field, value) {
  // Debounce - wait 1.5s after last keystroke
  const key = `${stepId}-${field}`;
  if (saveTimers[key]) clearTimeout(saveTimers[key]);
  
  saveTimers[key] = setTimeout(async () => {
    const indicator = document.getElementById(`save-indicator-${stepId}`);
    if (indicator) {
      indicator.textContent = 'Saving...';
      indicator.className = 'step-save-indicator saving';
    }
    
    try {
      const response = await fetch(`/email_sequences/${sequenceId}/sequence_steps/${stepId}.json`, {
        method: 'PATCH',
        headers: {
          'Content-Type': 'application/json',
          'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]')?.content
        },
        body: JSON.stringify({ sequence_step: { [field]: value } })
      });
      
      const data = await response.json();
      if (indicator) {
        if (data.success) {
          indicator.textContent = 'Saved';
          indicator.className = 'step-save-indicator saved';
          setTimeout(() => {
            if (indicator.textContent === 'Saved') {
              indicator.textContent = '';
              indicator.className = 'step-save-indicator';
            }
          }, 2000);
        } else {
          indicator.textContent = 'Error saving';
          indicator.className = 'step-save-indicator error';
        }
      }
    } catch (err) {
      console.error('Auto-save error:', err);
      if (indicator) {
        indicator.textContent = 'Error saving';
        indicator.className = 'step-save-indicator error';
      }
    }
  }, 1500);
}

// Toggle expanded email content
function toggleStepEmail(stepId, sequenceId) {
  const expandable = document.getElementById(`step-email-expand-${stepId}`);
  const chevron = document.getElementById(`step-chevron-${stepId}`);
  if (!expandable) return;
  
  const isExpanded = expandable.classList.contains('expanded');
  if (isExpanded) {
    expandable.classList.remove('expanded');
    if (chevron) chevron.style.transform = 'rotate(0deg)';
  } else {
    expandable.classList.add('expanded');
    if (chevron) chevron.style.transform = 'rotate(90deg)';
  }
}

// Insert a template variable into the body editor at cursor position
function insertSeqVariable(stepId, variable) {
  const editor = document.getElementById(`step-body-editor-${stepId}`);
  if (!editor) return;

  editor.focus();

  // Try to insert at cursor position
  const sel = window.getSelection();
  if (sel.rangeCount > 0 && editor.contains(sel.anchorNode)) {
    // Insert at cursor
    document.execCommand('insertText', false, variable);
  } else {
    // No cursor in editor — append at end
    editor.focus();
    const range = document.createRange();
    range.selectNodeContents(editor);
    range.collapse(false); // collapse to end
    sel.removeAllRanges();
    sel.addRange(range);
    document.execCommand('insertText', false, variable);
  }

  // Trigger auto-save
  editor.dispatchEvent(new Event('input', { bubbles: true }));
}

function sequenceView(id) {
  // Find sequence data from server-rendered JSON
  const seq = SEQUENCE_DATA.find(s => s.id === id);
  if (!seq) return;

  // If already showing detail, collapse
  const existingDetail = document.getElementById('sequence-detail-panel');
  if (existingDetail) {
    const previousId = existingDetail.dataset.sequenceId;
    existingDetail.remove();
    if (previousId == id) return;
  }

  // Build steps HTML with full detail
  let stepsHtml = '';
  if (seq.steps && seq.steps.length > 0) {
    seq.steps.forEach((step, idx) => {
      const templateBadge = step.has_template
        ? `<span class="step-template-badge"><i data-lucide="file-text" style="width:12px;height:12px;"></i> ${step.template_name || 'Template #' + step.template_id}</span>`
        : `<span class="step-template-badge inline-content"><i data-lucide="pen-line" style="width:12px;height:12px;"></i> Inline content</span>`;

      const delayLabel = idx === 0 ? 'Starts immediately' : formatDelay(step.delay_hours);
      const dayLabel = formatDayLabel(getCumulativeDay(seq.steps, idx) === 0 ? 0 : getCumulativeDay(seq.steps, idx) * 24);
      const cumulativeDay = getCumulativeDay(seq.steps, idx);

      // Sending logic description
      const logicDesc = describeStepLogic(step, idx, seq.steps.length);

      const stepMetrics = (step.sent_count > 0)
        ? `<div class="step-metrics-row">
             <span class="step-metric"><strong>${step.sent_count}</strong> sent</span>
             <span class="step-metric"><strong>${step.opened_count}</strong> opened (${step.open_rate}%)</span>
             <span class="step-metric"><strong>${step.clicked_count}</strong> clicked (${step.click_rate}%)</span>
           </div>`
        : `<div class="step-metrics-row"><span class="step-metric muted">Not sent yet</span></div>`;

      // Sanitize body HTML for safe display in contenteditable
      const bodyHtml = step.body_html || '';
      const safeBodyHtml = bodyHtml.replace(/`/g, '&#96;').replace(/\$/g, '&#36;');

      stepsHtml += `
        <div class="sequence-step-detail">
          <div class="step-timeline-col">
            <div class="step-number">${step.step_number}</div>
            <div class="step-connector"></div>
          </div>
          <div class="step-detail-content">
            <div class="step-detail-header">
              <div class="step-subject-row">
                <div class="step-subject">${step.subject || 'No subject'}</div>
                <div class="step-timing-badges">
                  <span class="step-day-badge">Day ${cumulativeDay}</span>
                  <span class="step-delay-badge"><i data-lucide="clock" style="width:12px;height:12px;"></i> ${delayLabel}</span>
                </div>
              </div>
            </div>
            
            <div class="step-logic-row">
              <i data-lucide="filter" style="width:13px;height:13px;flex-shrink:0;"></i>
              <span>${logicDesc}</span>
            </div>
            
            <div class="step-email-toggle" onclick="toggleStepEmail(${step.id}, ${seq.id})">
              <i data-lucide="chevron-right" style="width:14px;height:14px;transition:transform 0.2s;" id="step-chevron-${step.id}"></i>
              <span>View / Edit Email Content</span>
              <span id="save-indicator-${step.id}" class="step-save-indicator"></span>
            </div>
            
            <div class="step-email-expandable" id="step-email-expand-${step.id}">
              <div class="step-email-subject-edit">
                <label>Subject:</label>
                <input type="text" value="${(step.subject || '').replace(/"/g, '&quot;')}" 
                       class="step-subject-input"
                       oninput="autoSaveStep(${seq.id}, ${step.id}, 'subject', this.value)" />
              </div>
              <div class="step-email-body-edit">
                <label>Email Body: ${step.has_template ? '<span class="step-template-edit-hint">Edits here override the linked template</span>' : ''}</label>
                <div class="step-body-editor" 
                     contenteditable="true"
                     id="step-body-editor-${step.id}"
                     oninput="autoSaveStep(${seq.id}, ${step.id}, 'body', this.innerHTML)">${safeBodyHtml}</div>
              </div>
              <div class="step-variable-pills">
                <span class="variable-pills-label"><i data-lucide="variable" style="width:12px;height:12px;"></i> Insert variable:</span>
                <button type="button" class="variable-pill" onclick="insertSeqVariable(${step.id}, '{{first_name}}')">{{first_name}}</button>
                <button type="button" class="variable-pill" onclick="insertSeqVariable(${step.id}, '{{last_name}}')">{{last_name}}</button>
                <button type="button" class="variable-pill" onclick="insertSeqVariable(${step.id}, '{{full_name}}')">{{full_name}}</button>
                <button type="button" class="variable-pill" onclick="insertSeqVariable(${step.id}, '{{email}}')">{{email}}</button>
                <button type="button" class="variable-pill" onclick="insertSeqVariable(${step.id}, '{{company}}')">{{company}}</button>
              </div>
            </div>
            
            <div class="step-detail-footer">
              ${templateBadge}
              ${stepMetrics}
            </div>
          </div>
        </div>
      `;
    });
  } else {
    stepsHtml = '<div class="step-empty-state"><i data-lucide="mail-plus" style="width:20px;height:20px;"></i> No steps defined yet. Ask AMOS to add steps to this sequence.</div>';
  }

  // Overall metrics row
  const overallMetrics = `
    <div class="detail-metrics-grid">
      <div class="detail-metric-card">
        <div class="detail-metric-value">${seq.step_count}</div>
        <div class="detail-metric-label">Steps</div>
      </div>
      <div class="detail-metric-card">
        <div class="detail-metric-value">${seq.enrolled_count}</div>
        <div class="detail-metric-label">Enrolled</div>
      </div>
      <div class="detail-metric-card">
        <div class="detail-metric-value">${seq.total_sent}</div>
        <div class="detail-metric-label">Emails Sent</div>
      </div>
      <div class="detail-metric-card">
        <div class="detail-metric-value">${seq.open_rate}%</div>
        <div class="detail-metric-label">Open Rate</div>
      </div>
      <div class="detail-metric-card">
        <div class="detail-metric-value">${seq.click_rate}%</div>
        <div class="detail-metric-label">Click Rate</div>
      </div>
      <div class="detail-metric-card">
        <div class="detail-metric-value">${seq.completion_rate}%</div>
        <div class="detail-metric-label">Completion</div>
      </div>
    </div>
  `;

  // Contact group section
  const contactGroupHtml = `
    <div class="detail-contact-group-section">
      <div class="detail-contact-icon"><i data-lucide="users" style="width:18px;height:18px;"></i></div>
      <div class="detail-contact-info">
        <strong>${seq.contact_group_name}</strong>
        ${seq.contact_group_count > 0 ? `<span class="detail-contact-count">${seq.contact_group_count} contacts</span>` : ''}
      </div>
    </div>
  `;

  // Build detail panel
  const panel = document.createElement('div');
  panel.id = 'sequence-detail-panel';
  panel.dataset.sequenceId = id;
  panel.className = 'sequence-detail-panel';
  panel.style.marginBottom = '1.5rem';
  panel.innerHTML = `
    <div class="detail-panel-top-row" onclick="document.getElementById('sequence-detail-panel')?.remove()" style="cursor:pointer;">
      <div class="detail-panel-title-row">
        <h2>${seq.name}</h2>
        <span class="sequence-status-badge ${seq.status}">
          ${seq.status.charAt(0).toUpperCase() + seq.status.slice(1)}
        </span>
      </div>
      <button class="canvas-btn outline sm" style="flex-shrink: 0;">
        <i data-lucide="x" style="width:14px;height:14px;"></i> Close
      </button>
    </div>
    ${seq.goal ? `<p class="detail-goal">${seq.goal}</p>` : ''}
    <div class="detail-created-date">Created ${seq.created_at}</div>

    ${contactGroupHtml}
    ${overallMetrics}

    <h5 class="detail-section-title">Email Steps</h5>
    <div class="sequence-steps-detail-list">
      ${stepsHtml}
    </div>

    <div class="detail-actions-row">
      <button onclick="event.stopPropagation(); sendToAmos('Show me the complete email content for sequence \\'${seq.name}\\'')" class="canvas-btn primary sm">
        <i data-lucide="mail-open" style="width:14px;height:14px;"></i> View Full Emails
      </button>
      <button onclick="event.stopPropagation(); sendToAmos('Edit email sequence #${id} - ${seq.name}')" class="canvas-btn outline sm">
        <i data-lucide="pencil" style="width:14px;height:14px;"></i> Edit
      </button>
      <button onclick="event.stopPropagation(); sendToAmos('Modify the email templates in sequence \\'${seq.name}\\'')" class="canvas-btn outline sm">
        <i data-lucide="file-edit" style="width:14px;height:14px;"></i> Edit Templates
      </button>
      <button onclick="event.stopPropagation(); (window.showConfirm ? window.showConfirm('Delete this sequence? This cannot be undone.', { title: 'Delete Sequence', dangerous: true, confirmText: 'Delete' }) : Promise.resolve(confirm('Delete this sequence?'))).then(ok => { if(ok) sendToAmos('Delete email sequence #${id}') })" class="canvas-btn outline sm" style="color: #EF4444; border-color: #EF4444;">
        <i data-lucide="trash-2" style="width:14px;height:14px;"></i> Delete
      </button>
    </div>
  `;

  // Insert before the grid
  const grid = document.getElementById('sequence-grid');
  grid.parentNode.insertBefore(panel, grid);

  // Scroll into view
  panel.scrollIntoView({ behavior: 'smooth', block: 'start' });

  // Re-init icons
  if (typeof lucide !== 'undefined') lucide.createIcons();
}

// ═══════════════════════════════════════════════
// Floating Text Toolbar for contenteditable editors
// ═══════════════════════════════════════════════
(function setupSeqTextToolbar() {
  const toolbar = document.getElementById('seqTextToolbar');
  const linkInput = document.getElementById('seqLinkInput');
  const colorPicker = document.getElementById('seqColorPicker');
  const colorIndicator = document.getElementById('seqColorIndicator');
  if (!toolbar) return;

  let savedSelection = null;

  // Show toolbar on text selection within step-body-editor elements
  document.addEventListener('selectionchange', () => {
    const selection = window.getSelection();

    if (!selection || selection.isCollapsed || selection.toString().trim() === '') {
      if (!toolbar.classList.contains('link-mode')) {
        toolbar.classList.remove('visible');
      }
      return;
    }

    // Check if selection is within a step-body-editor
    const anchorNode = selection.anchorNode;
    const editableParent = anchorNode?.parentElement?.closest('.step-body-editor[contenteditable="true"]') ||
                          (anchorNode?.nodeType === 1 && anchorNode.closest('.step-body-editor[contenteditable="true"]'));

    if (!editableParent) {
      if (!toolbar.classList.contains('link-mode')) {
        toolbar.classList.remove('visible');
      }
      return;
    }

    // Make toolbar visible first so offsetWidth/offsetHeight are available
    toolbar.classList.add('visible');
    toolbar.classList.remove('link-mode');

    // Position toolbar above selection
    const range = selection.getRangeAt(0);
    const rect = range.getBoundingClientRect();
    const tw = toolbar.offsetWidth;
    const th = toolbar.offsetHeight;

    let left = rect.left + rect.width / 2 - tw / 2;
    let top = rect.top - th - 8;

    // Keep on screen horizontally
    if (left < 10) left = 10;
    if (left + tw > window.innerWidth - 10) left = window.innerWidth - tw - 10;
    // If above goes off top, show below selection instead
    if (top < 10) top = rect.bottom + 8;

    toolbar.style.left = left + 'px';
    toolbar.style.top = top + 'px';
    updateToolbarStates();
  });

  function updateToolbarStates() {
    toolbar.querySelectorAll('.seq-toolbar-btn[data-command]').forEach(btn => {
      const cmd = btn.dataset.command;
      if (cmd === 'link' || cmd === 'removeFormat' || cmd === 'foreColor') return;
      try {
        btn.classList.toggle('active', document.queryCommandState(cmd));
      } catch(e) {}
    });
  }

  function saveSelection() {
    const sel = window.getSelection();
    if (sel.rangeCount > 0) savedSelection = sel.getRangeAt(0).cloneRange();
  }

  function restoreSelection() {
    if (savedSelection) {
      const sel = window.getSelection();
      sel.removeAllRanges();
      sel.addRange(savedSelection);
    }
  }

  // Find the parent editor to trigger auto-save after formatting
  function triggerAutoSave() {
    const sel = window.getSelection();
    if (!sel.anchorNode) return;
    const editor = sel.anchorNode.parentElement?.closest('.step-body-editor') ||
                   (sel.anchorNode.nodeType === 1 && sel.anchorNode.closest('.step-body-editor'));
    if (editor) {
      // Dispatch an input event to trigger the oninput handler
      editor.dispatchEvent(new Event('input', { bubbles: true }));
    }
  }

  // Button clicks
  toolbar.querySelectorAll('.seq-toolbar-btn').forEach(btn => {
    btn.addEventListener('mousedown', (e) => e.preventDefault());

    btn.addEventListener('click', (e) => {
      e.preventDefault();
      e.stopPropagation();
      const cmd = btn.dataset.command;

      if (cmd === 'link') {
        saveSelection();
        toolbar.classList.add('link-mode');
        linkInput.value = '';
        linkInput.focus();
        // Pre-fill with existing link
        const sel = window.getSelection();
        if (sel.anchorNode) {
          const link = sel.anchorNode.parentElement?.closest('a');
          if (link) linkInput.value = link.href;
        }
      } else if (cmd === 'foreColor') {
        saveSelection();
        colorPicker.click();
      } else if (cmd === 'removeFormat') {
        document.execCommand('removeFormat', false, null);
        document.execCommand('unlink', false, null);
        triggerAutoSave();
      } else {
        document.execCommand(cmd, false, null);
        updateToolbarStates();
        triggerAutoSave();
      }
    });
  });

  // Link input
  linkInput.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') {
      e.preventDefault();
      const url = linkInput.value.trim();
      restoreSelection();
      if (url) {
        const finalUrl = url.match(/^https?:\/\//) ? url : 'https://' + url;
        document.execCommand('createLink', false, finalUrl);
        // Make links open in new tab
        const sel = window.getSelection();
        if (sel.anchorNode) {
          const newLink = sel.anchorNode.parentElement?.closest('a') ||
                         (sel.anchorNode.nodeType === 1 && sel.anchorNode.querySelector('a'));
          if (newLink) newLink.setAttribute('target', '_blank');
        }
      } else {
        document.execCommand('unlink', false, null);
      }
      toolbar.classList.remove('link-mode');
      triggerAutoSave();
    } else if (e.key === 'Escape') {
      toolbar.classList.remove('link-mode');
      restoreSelection();
    }
  });

  linkInput.addEventListener('blur', () => {
    setTimeout(() => {
      if (!toolbar.contains(document.activeElement)) {
        toolbar.classList.remove('link-mode');
      }
    }, 150);
  });

  // Color picker
  colorPicker.addEventListener('input', (e) => {
    const color = e.target.value;
    colorIndicator.style.borderBottomColor = color;
    restoreSelection();
    document.execCommand('foreColor', false, color);
    triggerAutoSave();
  });
})();

async function sequenceActivate(id) {
  const confirmed = window.showConfirm
    ? await window.showConfirm('Activate this sequence? Enrolled contacts will start receiving emails.', { title: 'Activate Sequence', confirmText: 'Activate', confirmClass: 'btn-success' })
    : confirm('Activate this sequence? Enrolled contacts will start receiving emails.');
  if (!confirmed) return;
  
  try {
    const response = await fetch(`/api/v1/email_sequences/${id}/activate`, {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]')?.content
      }
    });
    
    const data = await response.json();
    if (data.success) {
      showSequenceNotification('Sequence activated! Emails will start sending.', 'success');
      sequenceRefresh();
    } else {
      showSequenceNotification(data.message || 'Failed to activate', 'error');
    }
  } catch (error) {
    console.error('Activate error:', error);
    showSequenceNotification('Failed to activate sequence', 'error');
  }
}

async function sequencePause(id) {
  try {
    const response = await fetch(`/api/v1/email_sequences/${id}/pause`, {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]')?.content
      }
    });
    
    const data = await response.json();
    if (data.success) {
      showSequenceNotification('Sequence paused', 'success');
      sequenceRefresh();
    } else {
      showSequenceNotification(data.message || 'Failed to pause', 'error');
    }
  } catch (error) {
    showSequenceNotification('Failed to pause sequence', 'error');
  }
}

async function sequenceResume(id) {
  try {
    const response = await fetch(`/api/v1/email_sequences/${id}/resume`, {
