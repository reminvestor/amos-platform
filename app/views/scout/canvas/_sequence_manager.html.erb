  font-weight: 600;
  margin-right: 0.25rem;
  white-space: nowrap;
}

.variable-pill {
  display: inline-flex;
  align-items: center;
  padding: 0.2rem 0.5rem;
  font-size: 0.68rem;
  font-family: monospace;
  color: #8B5CF6;
  background: rgba(139, 92, 246, 0.08);
  border: 1px solid rgba(139, 92, 246, 0.2);
  border-radius: 999px;
  cursor: pointer;
  transition: all 0.15s;
  white-space: nowrap;
}

.variable-pill:hover {
  background: rgba(139, 92, 246, 0.18);
  border-color: rgba(139, 92, 246, 0.4);
  color: #7C3AED;
}

[data-theme="dark"] .variable-pill,
[data-bs-theme="dark"] .variable-pill {
  color: #A78BFA;
  background: rgba(139, 92, 246, 0.12);
  border-color: rgba(139, 92, 246, 0.25);
}

[data-theme="dark"] .variable-pill:hover,
[data-bs-theme="dark"] .variable-pill:hover {
  background: rgba(139, 92, 246, 0.25);
  border-color: rgba(139, 92, 246, 0.5);
}

.step-detail-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 0.5rem;
  flex-wrap: wrap;
  margin-top: 0.35rem;
}

.step-template-badge {
  display: inline-flex;
  align-items: center;
  gap: 0.25rem;
  font-size: 0.7rem;
  color: #10B981;
  background: rgba(16, 185, 129, 0.1);
  padding: 0.2rem 0.5rem;
  border-radius: 999px;
}

.step-template-badge.inline-content {
  color: var(--sm-text-muted);
  background: rgba(107, 114, 128, 0.1);
}

.step-metrics-row {
  display: flex;
  gap: 0.75rem;
  align-items: center;
}

.step-metric {
  font-size: 0.7rem;
  color: var(--sm-text-muted);
}

.step-metric strong {
  color: var(--sm-text);
}

.step-metric.muted {
  font-style: italic;
}

.step-empty-state {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  color: var(--sm-text-muted);
  font-size: 0.85rem;
  padding: 1.5rem;
  text-align: center;
  justify-content: center;
}

/* Contact count on cards */
.sequence-contact-count {
  color: var(--sm-text-muted);
  font-size: 0.7rem;
}

.detail-actions-row {
  display: flex;
  gap: 0.5rem;
  margin-top: 1.5rem;
  flex-wrap: wrap;
}

/* ═══════════════════════════════ */
/* Floating Text Toolbar           */
/* ═══════════════════════════════ */
.seq-text-toolbar {
  position: fixed;
  display: none;
  background: var(--sm-card-bg, #fff);
  border: 1px solid var(--sm-border, #e2e8f0);
  border-radius: 8px;
  padding: 4px;
  gap: 2px;
  z-index: 10001;
  box-shadow: 0 4px 16px var(--sm-shadow, rgba(0,0,0,0.12));
