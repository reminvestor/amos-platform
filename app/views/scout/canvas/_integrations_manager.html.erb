<div style="background-color: #0A0E1A; color: #FFFFFF; min-height: 100vh; padding: 2rem;">
  <!-- Page Header -->
  <div style="margin-bottom: 2rem;">
    <h1 style="color: #FFFFFF; font-size: 2rem; font-weight: 700; margin-bottom: 0.5rem; display: flex; align-items: center; gap: 1rem;">
      <i data-lucide="plug" style="width: 2rem; height: 2rem;"></i>
      Integration Connections
    </h1>
    <p style="color: #94A3B8; margin-bottom: 0;">Manage your external application connections</p>
  </div>

  <!-- Search Bar -->
  <div style="margin-bottom: 2rem;">
    <div style="position: relative;">
      <i data-lucide="search" style="position: absolute; left: 1rem; top: 50%; transform: translateY(-50%); width: 1.25rem; height: 1.25rem; color: #64748B;"></i>
      <input type="text"
             id="integrationSearch"
             placeholder="Search integrations..."
             style="width: 100%; padding: 0.75rem 1rem 0.75rem 2.75rem; background-color: #1A1F35; border: 1px solid #1E293B; border-radius: 0.5rem; color: #FFFFFF; font-size: 0.875rem;"
             oninput="filterIntegrations()">
    </div>
  </div>

  <!-- Stats Cards -->
  <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1rem; margin-bottom: 2rem;">
    <div style="background: linear-gradient(135deg, rgba(124, 58, 237, 0.2) 0%, rgba(167, 139, 250, 0.05) 100%); border: 1px solid rgba(124, 58, 237, 0.3); border-radius: 0.75rem; padding: 1.5rem;">
      <div style="display: flex; align-items: center; justify-content: space-between;">
        <div>
          <p style="color: #94A3B8; font-size: 0.875rem; margin: 0 0 0.5rem 0;">Total Integrations</p>
          <p style="color: #FFFFFF; font-size: 1.75rem; font-weight: 700; margin: 0;"><%= canvas_data[:integrations]&.length || 0 %></p>
        </div>
        <div style="width: 2.5rem; height: 2.5rem; border-radius: 0.5rem; background: rgba(124, 58, 237, 0.2); display: flex; align-items: center; justify-content: center;">
          <i data-lucide="plug" style="width: 1.25rem; height: 1.25rem; color: #A78BFA;"></i>
        </div>
      </div>
    </div>

    <div style="background: linear-gradient(135deg, rgba(74, 222, 128, 0.2) 0%, rgba(74, 222, 128, 0.05) 100%); border: 1px solid rgba(74, 222, 128, 0.3); border-radius: 0.75rem; padding: 1.5rem;">
      <div style="display: flex; align-items: center; justify-content: space-between;">
        <div>
          <p style="color: #94A3B8; font-size: 0.875rem; margin: 0 0 0.5rem 0;">Connected</p>
          <p style="color: #FFFFFF; font-size: 1.75rem; font-weight: 700; margin: 0;"><%= canvas_data[:connections]&.length || 0 %></p>
        </div>
        <div style="width: 2.5rem; height: 2.5rem; border-radius: 0.5rem; background: rgba(74, 222, 128, 0.2); display: flex; align-items: center; justify-content: center;">
          <i data-lucide="check-circle" style="width: 1.25rem; height: 1.25rem; color: #4ade80;"></i>
        </div>
      </div>
    </div>

    <div style="background: linear-gradient(135deg, rgba(250, 204, 21, 0.2) 0%, rgba(250, 204, 21, 0.05) 100%); border: 1px solid rgba(250, 204, 21, 0.3); border-radius: 0.75rem; padding: 1.5rem;">
      <div style="display: flex; align-items: center; justify-content: space-between;">
        <div>
          <p style="color: #94A3B8; font-size: 0.875rem; margin: 0 0 0.5rem 0;">Available</p>
          <p style="color: #FFFFFF; font-size: 1.75rem; font-weight: 700; margin: 0;"><%= (canvas_data[:integrations]&.length || 0) - (canvas_data[:connections]&.length || 0) %></p>
        </div>
        <div style="width: 2.5rem; height: 2.5rem; border-radius: 0.5rem; background: rgba(250, 204, 21, 0.2); display: flex; align-items: center; justify-content: center;">
          <i data-lucide="star" style="width: 1.25rem; height: 1.25rem; color: #facc15;"></i>
        </div>
      </div>
    </div>
  </div>

  <!-- Category Filters -->
  <% categories = canvas_data[:integrations]&.group_by { |i| i[:category] }&.keys&.sort || [] %>
  <% if categories.any? %>
    <div style="margin-bottom: 2rem;">
      <div style="display: flex; gap: 0.5rem; flex-wrap: wrap;">
        <button onclick="filterByCategory('all')"
                class="category-filter-btn"
                data-category="all"
                style="background: #7C3AED; color: white; border: 1px solid #7C3AED; padding: 0.5rem 1rem; border-radius: 0.375rem; cursor: pointer; font-size: 0.875rem; font-weight: 500;">
          All Categories
        </button>
        <% categories.each do |category| %>
          <% count = canvas_data[:integrations].select { |i| i[:category] == category }.length %>
          <button onclick="filterByCategory('<%= category %>')"
                  class="category-filter-btn"
                  data-category="<%= category %>"
                  style="background: transparent; color: #94A3B8; border: 1px solid #1E293B; padding: 0.5rem 1rem; border-radius: 0.375rem; cursor: pointer; font-size: 0.875rem; font-weight: 500;">
            <%= category&.humanize %> (<%= count %>)
          </button>
        <% end %>
      </div>
    </div>
  <% end %>

  <!-- Active Connections -->
  <% if canvas_data[:connections].present? && canvas_data[:connections].any? %>
    <div style="margin-bottom: 2.5rem;">
      <h3 style="color: #FFFFFF; margin-bottom: 1.5rem; font-size: 1.25rem; font-weight: 600;">Your Active Connections</h3>
      <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 1.5rem;">
        <% canvas_data[:connections].each do |connection| %>
          <div style="background: #1A1F35; border: 1px solid #1E293B; border-radius: 0.75rem; padding: 1.5rem; overflow: hidden;">
            <!-- Connection Header -->
            <div style="display: flex; align-items: center; gap: 1rem; margin-bottom: 1rem;">
              <% if connection[:integration][:icon_url].present? %>
                <img src="<%= connection[:integration][:icon_url] %>"
                     alt="<%= connection[:integration][:name] %>"
                     style="width: 2.5rem; height: 2.5rem; border-radius: 0.375rem; object-fit: contain;">
              <% else %>
                <div style="width: 2.5rem; height: 2.5rem; background: rgba(124, 58, 237, 0.2); border-radius: 0.375rem; display: flex; align-items: center; justify-content: center;">
                  <i data-lucide="box" style="width: 1.5rem; height: 1.5rem; color: #A78BFA;"></i>
                </div>
              <% end %>
              <div style="flex: 1;">
                <h6 style="color: #FFFFFF; margin: 0; font-weight: 600;"><%= connection[:integration][:name] %></h6>
                <p style="color: #94A3B8; margin: 0; font-size: 0.875rem;"><%= connection[:name] %></p>
              </div>
            </div>

            <!-- Status Badges -->
            <div style="display: flex; gap: 0.5rem; margin-bottom: 1rem; flex-wrap: wrap;">
              <span style="background: <%= connection[:status] == 'connected' ? 'rgba(74, 222, 128, 0.2)' : 'rgba(250, 204, 21, 0.2)' %>; color: <%= connection[:status] == 'connected' ? 'rgb(74, 222, 128)' : 'rgb(250, 204, 21)' %>; padding: 0.25rem 0.75rem; border-radius: 0.375rem; font-size: 0.75rem; font-weight: 600;">
                <%= connection[:status].humanize %>
              </span>
              <% if connection[:has_active_credentials] %>
                <span style="background: rgba(34, 211, 238, 0.2); color: #22D3EE; padding: 0.25rem 0.75rem; border-radius: 0.375rem; font-size: 0.75rem; font-weight: 600;">
                  Authenticated
                </span>
              <% end %>
            </div>

            <!-- Connection Info -->
            <p style="color: #94A3B8; font-size: 0.875rem; margin: 1rem 0;">
              <i data-lucide="zap" style="width: 0.875rem; height: 0.875rem; display: inline; margin-right: 0.25rem;"></i>
              <%= connection[:operations_count] %> operations available
              <% if connection[:last_used] %>
                <br>
                <i data-lucide="clock" style="width: 0.875rem; height: 0.875rem; display: inline; margin-right: 0.25rem;"></i>
                Last used <%= time_ago_in_words(connection[:last_used]) %> ago
              <% end %>
            </p>

            <!-- Action Buttons -->
            <div style="display: flex; gap: 0.5rem; flex-wrap: wrap;">
              <button onclick="testConnection(<%= connection[:id] %>, '<%= connection[:integration][:name] %>')"
                      aria-label="Test <%= connection[:integration][:name] %> connection"
                      style="background: transparent; color: #22D3EE; border: 1px solid #22D3EE; padding: 0.375rem 0.75rem; border-radius: 0.375rem; cursor: pointer; display: inline-flex; align-items: center; gap: 0.25rem; font-size: 0.875rem; font-weight: 500;">
                <i data-lucide="check" style="width: 0.875rem; height: 0.875rem;"></i>
                Test
              </button>
              <button onclick="loadOperationsCanvas(<%= connection[:id] %>, '<%= connection[:integration][:name] %>', '<%= connection[:name] %>')"
                      aria-label="View <%= connection[:integration][:name] %> operations"
                      style="background: transparent; color: #22D3EE; border: 1px solid #22D3EE; padding: 0.375rem 0.75rem; border-radius: 0.375rem; cursor: pointer; display: inline-flex; align-items: center; gap: 0.25rem; font-size: 0.875rem; font-weight: 500;">
                <i data-lucide="settings" style="width: 0.875rem; height: 0.875rem;"></i>
                Operations
              </button>
              <button onclick="disconnectIntegration(<%= connection[:id] %>, '<%= connection[:integration][:name] %>')"
                      aria-label="Disconnect <%= connection[:integration][:name] %>"
                      style="background: transparent; color: rgb(248, 113, 113); border: 1px solid rgb(248, 113, 113); padding: 0.375rem 0.75rem; border-radius: 0.375rem; cursor: pointer; display: inline-flex; align-items: center; gap: 0.25rem; font-size: 0.875rem; font-weight: 500;">
                <i data-lucide="unplug" style="width: 0.875rem; height: 0.875rem;"></i>
                Disconnect
              </button>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>

  <!-- Available Integrations -->
  <div>
    <h3 style="color: #FFFFFF; margin-bottom: 1.5rem; font-size: 1.25rem; font-weight: 600;">Available Integrations</h3>
    <% if canvas_data[:integrations].present? && canvas_data[:integrations].any? %>
      <% canvas_data[:integrations].group_by { |i| i[:category] }.each do |category, integrations| %>
        <div style="margin-bottom: 2.5rem;">
          <h4 style="color: #FFFFFF; margin-bottom: 1rem; font-size: 1rem; font-weight: 600; display: flex; align-items: center; gap: 0.5rem;">
            <i data-lucide="folder" style="width: 1rem; height: 1rem; color: rgb(250, 204, 21);"></i>
            <%= category&.humanize || 'Other' %>
          </h4>
          <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 1.5rem;">
            <% integrations.each do |integration| %>
              <div data-integration-name="<%= integration[:name] %>"
                   data-integration-category="<%= category %>"
                   data-integration-description="<%= integration[:description] %>"
                   style="background: #1A1F35; border: <%= integration[:is_connected] ? '1px solid rgb(74, 222, 128)' : '1px solid #1E293B' %>; border-radius: 0.75rem; padding: 1.5rem; height: 100%; display: flex; flex-direction: column;">
                <!-- Integration Header -->
                <div style="display: flex; align-items: flex-start; gap: 1rem; margin-bottom: 1rem;">
                  <% if integration[:icon_url].present? %>
                    <img src="<%= integration[:icon_url] %>"
                         alt="<%= integration[:name] %>"
                         style="width: 2.5rem; height: 2.5rem; border-radius: 0.375rem; object-fit: contain; flex-shrink: 0;">
                  <% else %>
                    <div style="width: 2.5rem; height: 2.5rem; background: rgba(124, 58, 237, 0.2); border-radius: 0.375rem; display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
                      <i data-lucide="puzzle" style="width: 1.5rem; height: 1.5rem; color: #A78BFA;"></i>
                    </div>
                  <% end %>
                  <div style="flex: 1;">
                    <div style="display: flex; align-items: center; gap: 0.5rem;">
                      <h6 style="color: #FFFFFF; margin: 0; font-weight: 600;">
                        <%= integration[:name] %>
                      </h6>
                      <% if integration[:is_verified] %>
                        <i data-lucide="check-circle" style="width: 1rem; height: 1rem; color: rgb(74, 222, 128);" title="Verified"></i>
                      <% end %>
                    </div>
                    <p style="color: #94A3B8; margin: 0.25rem 0 0 0; font-size: 0.75rem;"><%= integration[:auth_type]&.humanize %></p>
                  </div>
                </div>

                <!-- Description -->
                <% if integration[:description].present? %>
                  <p style="color: #94A3B8; font-size: 0.875rem; margin: 0 0 1rem 0;">
                    <%= integration[:description] %>
                  </p>
                <% end %>

                <!-- Footer: Operations Count and Action -->
                <div style="display: flex; align-items: center; justify-content: space-between; margin-top: auto; padding-top: 1rem; border-top: 1px solid #1E293B;">
                  <span style="color: #64748B; font-size: 0.875rem;">
                    <i data-lucide="zap" style="width: 0.875rem; height: 0.875rem; display: inline; margin-right: 0.25rem;"></i>
                    <%= integration[:operations_count] %> operations
                  </span>

                  <% if integration[:is_connected] %>
                    <span style="background: rgba(74, 222, 128, 0.2); color: rgb(74, 222, 128); padding: 0.25rem 0.75rem; border-radius: 0.375rem; font-size: 0.75rem; font-weight: 600;">
                      <i data-lucide="check" style="width: 0.75rem; height: 0.75rem; display: inline; margin-right: 0.25rem;"></i>
                      Connected
                    </span>
                  <% else %>
                    <button onclick="connectIntegration('<%= integration[:slug] %>', '<%= integration[:name] %>', '<%= integration[:auth_type] %>')"
                            aria-label="Connect <%= integration[:name] %> integration"
                            style="background: linear-gradient(135deg, #7C3AED 0%, #A78BFA 100%); color: white; border: none; padding: 0.375rem 0.75rem; border-radius: 0.375rem; cursor: pointer; display: inline-flex; align-items: center; gap: 0.25rem; font-size: 0.875rem; font-weight: 500;">
                      <i data-lucide="link" style="width: 0.875rem; height: 0.875rem;"></i>
                      Connect
                    </button>
                  <% end %>
                </div>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>
    <% else %>
      <div style="background: rgba(34, 211, 238, 0.1); border: 1px solid #1E293B; border-radius: 0.75rem; padding: 1.5rem;">
        <div style="display: flex; align-items: center; gap: 1rem;">
          <i data-lucide="info" style="width: 1.5rem; height: 1.5rem; color: #22D3EE;"></i>
          <p style="color: #FFFFFF; margin: 0;">No integrations available. Contact your administrator to add integrations.</p>
        </div>
      </div>
    <% end %>
  </div>

  <!-- Quick Actions -->
  <div style="background: #1A1F35; border: 1px solid #1E293B; border-radius: 0.75rem; padding: 1.5rem; margin-top: 2.5rem;">
    <h6 style="color: #FFFFFF; margin-bottom: 1rem; font-weight: 600; display: flex; align-items: center; gap: 0.5rem;">
      <i data-lucide="lightning" style="width: 1rem; height: 1rem; color: rgb(250, 204, 21);"></i>
      Quick Actions
    </h6>
    <div style="display: flex; gap: 0.5rem; flex-wrap: wrap;">
      <button onclick="sendMessageToAI('Test all my connections')"
              aria-label="Test all connections"
              style="background: linear-gradient(135deg, #7C3AED 0%, #A78BFA 100%); color: white; border: none; padding: 0.5rem 1rem; border-radius: 0.375rem; cursor: pointer; display: inline-flex; align-items: center; gap: 0.5rem; font-weight: 500;">
        <i data-lucide="check-check" style="width: 1rem; height: 1rem;"></i>
        Test All
      </button>
      <button onclick="sendMessageToAI('Show me integration documentation')"
              aria-label="View integration documentation"
              style="background: transparent; color: #22D3EE; border: 1px solid #22D3EE; padding: 0.5rem 1rem; border-radius: 0.375rem; cursor: pointer; display: inline-flex; align-items: center; gap: 0.5rem; font-weight: 500;">
        <i data-lucide="book-open" style="width: 1rem; height: 1rem;"></i>
        Documentation
      </button>
      <button onclick="sendMessageToAI('Help me choose an integration')"
              aria-label="Get help choosing an integration"
              style="background: transparent; color: rgb(250, 204, 21); border: 1px solid rgb(250, 204, 21); padding: 0.5rem 1rem; border-radius: 0.375rem; cursor: pointer; display: inline-flex; align-items: center; gap: 0.5rem; font-weight: 500;">
        <i data-lucide="help-circle" style="width: 1rem; height: 1rem;"></i>
        Get Help
      </button>
    </div>
  </div>
</div>

<script>
function connectIntegration(slug, name, authType) {
  console.log('Connecting to integration:', slug, name, authType);

  if (authType === 'oauth2' || authType === 'oauth2_custom') {
    // OAuth flow - redirect to authorization URL
    window.location.href = `/integrations/${slug}/auth`;
  } else {
    // Load the connection canvas for API key, bearer token, etc.
    loadConnectionCanvas(slug);
  }
}

function loadConnectionCanvas(slug) {
  // Find the integration data from the current canvas
  const integrations = <%= raw canvas_data[:integrations].to_json %>;
  const integration = integrations.find(i => i.slug === slug);

  if (!integration) {
    console.error('Integration not found:', slug);
    return;
  }

  console.log('🔍 Loading connection canvas for:', integration.name);
  console.log('🔍 Auth configs:', integration.auth_configs);

  const canvasData = {
    integration: integration,
    user_email: '<%= current_user.email %>'
  };

  // Load the integration connect canvas
  if (window.scoutController && window.scoutController.loadScoutCanvas) {
    window.scoutController.loadScoutCanvas('integration_connect', canvasData);
  } else {
    const event = new CustomEvent('scout:load-canvas', {
      detail: { canvas: 'integration_connect', data: canvasData }
    });
    document.dispatchEvent(event);
  }
}

function testConnection(connectionId, integrationName) {
  // Call server endpoint directly first
  fetch(`/connections/${connectionId}/test`, {
    method: 'POST',
    headers: {
      'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]')?.getAttribute('content') || '<%= form_authenticity_token %>',
      'Accept': 'application/json'
    }
  })
    .then(r => r.json())
    .then(data => {
      if (data.success) {
        showNotification('success', `${integrationName} connection test successful`)
        sendMessageToAI(`✅ ${integrationName} connection test passed successfully!`)
      } else {
        // Test failed - let AI try to diagnose and fix
        const errorMsg = data.error || 'Unknown error'
        showNotification('error', `${integrationName} test failed - asking AI to investigate...`)

        const aiMessage = `My ${integrationName} connection (ID: ${connectionId}) test failed with error: "${errorMsg}". Please diagnose the issue and try to fix the authentication configuration automatically. The error suggests there might be an issue with how the API key is being formatted or sent.`
        sendMessageToAI(aiMessage)
      }
    })
    .catch(err => {
      console.error('Test connection error:', err)
      showNotification('error', `Failed to test ${integrationName} connection`)
      sendMessageToAI(`❌ Failed to test ${integrationName} connection (ID: ${connectionId}) - there was a network or server error. Please check the connection setup.`)
    })
}

function disconnectIntegration(connectionId, integrationName) {
  if (!confirm(`Disconnect from ${integrationName}? You can reconnect anytime.`)) {
    return;
  }

  fetch(`/connections/${connectionId}`, {
    method: 'DELETE',
    headers: {
      'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]')?.getAttribute('content') || '<%= form_authenticity_token %>',
      'Accept': 'application/json'
    }
  })
    .then(r => r.json())
    .then(data => {
      if (data.success) {
        showNotification('success', `Disconnected from ${integrationName}`)
        sendMessageToAI(`✅ Disconnected from ${integrationName}. Refreshing integrations list...`)
        // Reload the integrations canvas
        setTimeout(() => {
          window.location.href = '/scout?load=integrations';
        }, 1000);
      } else {
        showNotification('error', data.error || 'Failed to disconnect')
        sendMessageToAI(`❌ Failed to disconnect from ${integrationName}: ${data.error || 'Unknown error'}`)
      }
    })
    .catch(err => {
      console.error('Disconnect error:', err)
      showNotification('error', `Failed to disconnect from ${integrationName}`)
      sendMessageToAI(`❌ Error disconnecting from ${integrationName}: ${err.message}`)
    })
}

function loadOperationsCanvas(connectionId, integrationName, connectionName) {
  // Fetch operations then load canvas
  fetch(`/connections/${connectionId}/operations`, { headers: { 'Accept': 'application/json' }})
    .then(r => r.json())
    .then(data => {
      console.log('Operations API response:', data);

      if (!data.success) {
        showNotification('error', data.error || 'Failed to load operations');
        return;
      }
      const canvasData = {
        connection_id: connectionId,
        integration_name: integrationName,
        connection_name: connectionName,
        integration: data.integration,
        operations: data.operations
      };

      console.log('Canvas data being passed:', canvasData);
      if (window.scoutController && window.scoutController.loadScoutCanvas) {
        window.scoutController.loadScoutCanvas('integration_operations', canvasData);
      } else {
        const event = new CustomEvent('scout:load-canvas', { detail: { canvas: 'integration_operations', data: canvasData }});
        document.dispatchEvent(event);
      }
    })
    .catch(err => {
      console.error('Load operations error:', err);
      showNotification('error', 'Failed to load operations');
    });
}

function sendMessageToAI(message) {
  // Use the global sendScoutMessage function
  if (window.scoutSendMessage) {
    window.scoutSendMessage(message);
  } else if (window.scoutController && window.scoutController.sendScoutMessage) {
    window.scoutController.sendScoutMessage(message);
  } else {
    console.error('Scout message sending not available');
  }
}

function showNotification(type, message) {
  // Create a simple notification
  const notification = document.createElement('div');
  notification.style.cssText = `
    position: fixed;
    top: 20px;
    right: 20px;
    z-index: 9999;
    min-width: 300px;
    background: ${type === 'success' ? 'rgba(74, 222, 128, 0.2)' : 'rgba(248, 113, 113, 0.2)'};
    border: 1px solid ${type === 'success' ? 'rgb(74, 222, 128)' : 'rgb(248, 113, 113)'};
    border-radius: 0.375rem;
    color: ${type === 'success' ? 'rgb(74, 222, 128)' : 'rgb(248, 113, 113)'};
    padding: 1rem;
    display: flex;
    align-items: center;
    gap: 0.75rem;
  `;

  notification.innerHTML = `
    <i data-lucide="${type === 'success' ? 'check-circle' : 'alert-circle'}" style="width: 1rem; height: 1rem;"></i>
    <span>${message}</span>
  `;

  document.body.appendChild(notification);

  // Initialize Lucide icon
  if (typeof lucide !== 'undefined') {
    lucide.createIcons();
  }

  // Remove after 5 seconds
  setTimeout(() => {
    if (notification.parentNode) {
      notification.parentNode.removeChild(notification);
    }
  }, 5000);
}

// Search and filter functions
let currentCategory = 'all';

function filterIntegrations() {
  const searchQuery = document.getElementById('integrationSearch')?.value.toLowerCase() || '';
  const integrationCards = document.querySelectorAll('[data-integration-name]');

  integrationCards.forEach(card => {
    const name = card.getAttribute('data-integration-name')?.toLowerCase() || '';
    const category = card.getAttribute('data-integration-category') || '';
    const description = card.getAttribute('data-integration-description')?.toLowerCase() || '';

    const matchesSearch = name.includes(searchQuery) || description.includes(searchQuery);
    const matchesCategory = currentCategory === 'all' || category === currentCategory;

    card.style.display = (matchesSearch && matchesCategory) ? 'flex' : 'none';
  });
}

function filterByCategory(category) {
  currentCategory = category;

  // Update button styles
  document.querySelectorAll('.category-filter-btn').forEach(btn => {
    if (btn.getAttribute('data-category') === category) {
      btn.style.background = '#7C3AED';
      btn.style.color = 'white';
      btn.style.borderColor = '#7C3AED';
    } else {
      btn.style.background = 'transparent';
      btn.style.color = '#94A3B8';
      btn.style.borderColor = '#1E293B';
    }
  });

  // Filter integrations
  filterIntegrations();
}

// Lucide icon initialization
document.addEventListener('turbo:load', () => {
  if (typeof lucide !== 'undefined') {
    lucide.createIcons();
  }
});

document.addEventListener('DOMContentLoaded', () => {
  if (typeof lucide !== 'undefined') {
    lucide.createIcons();
  }
});
</script>
