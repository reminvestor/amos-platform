<!-- Document Viewer Canvas -->
<div class="document-viewer-container" data-asset-id="<%= canvas_data[:asset_id] %>" data-url="<%= canvas_data[:url] %>">
  <div class="viewer-header mb-4">
    <div class="row align-items-center">
      <div class="col">
        <h5 class="mb-0">
          <i data-lucide="file-text" class="text-danger me-2" aria-hidden="true"></i>
          <%= canvas_data[:filename] || 'Document' %>
        </h5>
        <% if canvas_data[:size] %>
                        <small class="text-muted">
            <%= number_to_human_size(canvas_data[:size]) %> • <%= canvas_data[:content_type] %>
                        </small>
          <% end %>
      </div>
      <div class="col-auto">
        <% if canvas_data[:download_url] %>
          <a href="<%= canvas_data[:download_url] %>" class="btn btn-sm btn-outline-primary" download aria-label="Download document">
            <i data-lucide="download" class="me-1" aria-hidden="true"></i> Download
          </a>
        <% end %>
        <button class="btn btn-sm btn-outline-secondary" onclick="window.scoutController.goToConversation()" aria-label="Close document viewer">
          <i data-lucide="x" class="me-1" aria-hidden="true"></i> Close
        </button>
    </div>
  </div>
</div>

  <% if canvas_data[:extracted_text_preview] && canvas_data[:extracted_text_preview].include?("⚠️ Unable to extract text") %>
    <!-- Show OCR error message -->
    <div class="alert alert-warning">
      <h5 class="alert-heading">
        <i data-lucide="alert-triangle" class="me-2" aria-hidden="true"></i>Unable to Process Document
      </h5>
      <p class="mb-2">This appears to be a scanned PDF that requires special tools to read.</p>
      
      <div class="mt-3">
        <p class="mb-2"><strong>To enable OCR processing:</strong></p>
        <ol class="mb-3">
          <li>Install ImageMagick: <code>brew install imagemagick</code></li>
          <li>Install Ghostscript: <code>brew install ghostscript</code></li>
          <li>Restart your Rails server</li>
        </ol>
        
        <p class="mb-2"><strong>Alternative options:</strong></p>
        <ul class="mb-0">
          <li>Convert the PDF to text using an online tool</li>
          <li>Upload a text-based PDF instead of a scanned image</li>
          <li>Take a screenshot of the PDF and upload it as an image</li>
        </ul>
      </div>
            </div>
  <% end %>

  <!-- Document Viewer -->
  <div class="document-frame" style="height: 600px;">
    <% case canvas_data[:content_type] %>
    <% when 'application/pdf' %>
      <embed src="<%= canvas_data[:url] %>" type="application/pdf" width="100%" height="100%" />
    <% when /^image\// %>
      <div class="text-center p-4">
        <img src="<%= canvas_data[:url] %>" class="img-fluid" style="max-height: 100%;" />
      </div>
    <% when /^text\// %>
      <div class="p-4 bg-light h-100 overflow-auto">
        <pre class="mb-0"><%= canvas_data[:extracted_text_preview] || 'Loading...' %></pre>
      </div>
    <% else %>
      <div class="text-center p-5">
        <i data-lucide="file" class="icon-4x text-muted mb-3" aria-hidden="true"></i>
        <p class="text-muted">This file type cannot be displayed in the browser.</p>
        <% if canvas_data[:download_url] %>
          <a href="<%= canvas_data[:download_url] %>" class="btn btn-primary" download aria-label="Download file to view">
            <i data-lucide="download" class="me-2" aria-hidden="true"></i>Download to View
          </a>
        <% end %>
      </div>
    <% end %>
        </div>

  <% if canvas_data[:rag_store_id] %>
    <div class="mt-3 text-muted text-center">
      <small>
        <i data-lucide="database" class="me-1" aria-hidden="true"></i>
        Document stored in knowledge base (ID: <%= canvas_data[:rag_store_id] %>)
      </small>
    </div>
  <% end %>
          </div>

<style>
.document-viewer-container {
  height: 100%;
  display: flex;
  flex-direction: column;
}

.document-frame {
  flex: 1;
  border: 1px solid #dee2e6;
  border-radius: 0.5rem;
  overflow: hidden;
  background: #f8f9fa;
}

.document-frame embed {
  border: none;
}
</style>

<script>
// Initialize document viewer
document.addEventListener('DOMContentLoaded', function() {
  console.log('📄 Document viewer loaded');

  // Initialize Lucide icons
  if (typeof lucide !== 'undefined') {
    lucide.createIcons();
  }

  // Handle PDF loading errors
  const embed = document.querySelector('.document-frame embed');
  if (embed) {
    embed.addEventListener('error', function() {
      console.error('Failed to load PDF');
      // Could show an error message here
    });
  }
});

// Re-initialize icons when canvas is loaded via Turbo
document.addEventListener('turbo:load', function() {
  if (typeof lucide !== 'undefined') {
    lucide.createIcons();
  }
});
</script>