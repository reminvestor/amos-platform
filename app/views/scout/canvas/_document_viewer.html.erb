<!-- Document Viewer Canvas -->
<div class="document-viewer-container" data-asset-id="<%= canvas_data[:asset_id] %>" data-url="<%= canvas_data[:url] %>">
  <div class="viewer-header mb-3">
    <div class="d-flex justify-content-between align-items-center">
      <div>
        <h5 class="mb-0 d-flex align-items-center">
          <i data-lucide="<%= canvas_data[:view_type] == 'library' ? 'folder-open' : (canvas_data[:content_type]&.include?('pdf') ? 'file-text' : 'file') %>" 
             class="me-2" 
             style="width: 1.25rem; height: 1.25rem; color: <%= canvas_data[:view_type] == 'library' ? '#A78BFA' : '#64748B' %>;" 
             aria-hidden="true"></i>
          <%= canvas_data[:view_type] == 'library' ? 'My Documents' : (canvas_data[:filename] || 'Document') %>
        </h5>
        <% if canvas_data[:view_type] == 'single' && canvas_data[:size] %>
          <small class="text-muted d-block mt-1">
            <%= number_to_human_size(canvas_data[:size]) %> • <%= canvas_data[:content_type] %>
          </small>
        <% elsif canvas_data[:view_type] == 'library' && canvas_data[:documents] %>
          <small class="text-muted d-block mt-1">
            <%= pluralize(canvas_data[:documents].length, 'document') %>
          </small>
        <% end %>
      </div>
      <div class="d-flex gap-2">
        <% if canvas_data[:view_type] == 'single' && canvas_data[:download_url] %>
          <a href="<%= canvas_data[:download_url] %>" class="btn btn-sm btn-outline-primary" download aria-label="Download document">
            <i data-lucide="download" aria-hidden="true"></i>
            <span class="d-none d-sm-inline ms-1">Download</span>
          </a>
        <% end %>
        <button class="btn btn-sm btn-outline-secondary" onclick="window.scoutController.goToConversation()" aria-label="Close document viewer">
          <i data-lucide="x" aria-hidden="true"></i>
          <span class="d-none d-sm-inline ms-1">Close</span>
        </button>
      </div>
    </div>
  </div>

  <!-- LIBRARY VIEW: Show list of documents -->
  <% if canvas_data[:view_type] == 'library' %>
    <% if canvas_data[:documents]&.any? %>
      <div class="document-library">
        <div class="list-group">
          <% canvas_data[:documents].each do |doc| %>
            <div class="list-group-item list-group-item-action d-flex align-items-center py-3" style="cursor: pointer;"
                 data-asset-id="<%= doc[:id] %>"
                 onclick="window.scoutController?.loadCanvas('document_viewer', {asset_id: <%= doc[:id] %>})">
              <div class="flex-grow-1">
                <div class="d-flex align-items-center">
                  <i data-lucide="file" class="text-secondary me-2" style="width: 20px; height: 20px;" aria-hidden="true"></i>
                  <div>
                    <h6 class="mb-1"><%= doc[:title] %></h6>
                    <small class="text-muted">
                      <%= number_to_human_size(doc[:size]) %> • <%= Time.parse(doc[:created_at].to_s).strftime('%b %d, %Y') %>
                    </small>
                  </div>
                </div>
              </div>
              <div class="flex-shrink-0">
                <a href="<%= doc[:download_url] %>" class="btn btn-sm btn-outline-secondary ms-2" download
                   onclick="event.stopPropagation();" aria-label="Download file">
                  <i data-lucide="download" aria-hidden="true"></i>
                </a>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    <% else %>
      <div class="alert alert-info">
        <i data-lucide="info" class="me-2" aria-hidden="true"></i>
        No documents uploaded yet. Upload a document to get started!
      </div>
    <% end %>
  <% end %>

  <!-- SINGLE DOCUMENT VIEW: Show document content -->
  <% if canvas_data[:view_type] == 'single' %>
    <% if canvas_data[:extracted_text_preview] && canvas_data[:extracted_text_preview].include?("⚠️ Unable to extract text") %>
      <!-- Show OCR error message -->
      <div class="alert alert-warning">
        <h5 class="alert-heading">
          <i data-lucide="alert-triangle" class="me-2" aria-hidden="true"></i>Unable to Process Document
        </h5>
        <p class="mb-2">This appears to be a scanned PDF that requires special tools to read.</p>

        <div class="mt-3">
          <p class="mb-2"><strong>To enable OCR processing:</strong></p>
          <ol class="mb-3">
            <li>Install ImageMagick: <code>brew install imagemagick</code></li>
            <li>Install Ghostscript: <code>brew install ghostscript</code></li>
            <li>Restart your Rails server</li>
          </ol>

          <p class="mb-2"><strong>Alternative options:</strong></p>
          <ul class="mb-0">
            <li>Convert the PDF to text using an online tool</li>
            <li>Upload a text-based PDF instead of a scanned image</li>
            <li>Take a screenshot of the PDF and upload it as an image</li>
          </ul>
        </div>
      </div>
    <% end %>

    <!-- Document Viewer -->
    <div class="document-frame" style="height: 600px; background: #0F172A; border: 1px solid #1E293B; border-radius: 0.5rem; overflow: hidden;">
      <% if canvas_data[:processing_status] == 'processing' && canvas_data[:content_type]&.include?('pdf') %>
        <%# Show PDF while processing %>
        <div style="position: relative; height: 100%;">
          <iframe 
            src="<%= canvas_data[:url] %>" 
            style="width: 100%; height: 100%; border: none;"
            title="<%= canvas_data[:filename] %>">
          </iframe>
          <div style="position: absolute; bottom: 0; left: 0; right: 0; background: rgba(15, 23, 42, 0.95); padding: 1rem; border-top: 1px solid #1E293B;">
            <div class="d-flex align-items-center">
              <div class="spinner-border spinner-border-sm text-primary me-3" role="status">
                <span class="visually-hidden">Processing...</span>
              </div>
              <div>
                <strong style="color: white;">Processing Document...</strong>
                <div class="small text-muted mt-1">
                  <%= canvas_data[:processing_stage]&.humanize || 'Initializing' %> - 
                  <%= canvas_data[:processing_progress] || 0 %>% complete
                </div>
              </div>
            </div>
          </div>
        </div>
      <% else %>
        <% case canvas_data[:content_type] %>
        <% when 'application/pdf' %>
          <iframe 
            src="<%= canvas_data[:url] %>" 
            style="width: 100%; height: 100%; border: none;"
            title="<%= canvas_data[:filename] %>">
          </iframe>
        <% when /^image\// %>
          <div class="text-center p-4" style="height: 100%; display: flex; align-items: center; justify-content: center;">
            <img src="<%= canvas_data[:url] %>" class="img-fluid" style="max-height: 100%;" alt="<%= canvas_data[:filename] %>" />
          </div>
        <% when /^text\// %>
          <div class="p-4 h-100 overflow-auto" style="background: #0F172A; color: #E2E8F0;">
            <pre class="mb-0" style="color: #E2E8F0; font-family: 'SF Mono', Monaco, 'Cascadia Code', 'Roboto Mono', monospace;"><%= canvas_data[:extracted_text_preview] || 'Loading...' %></pre>
          </div>
        <% else %>
          <div class="text-center p-5" style="color: #E2E8F0;">
            <i data-lucide="file" class="mb-3" style="width: 4rem; height: 4rem; color: #64748B;" aria-hidden="true"></i>
            <p class="text-muted">This file type cannot be displayed in the browser.</p>
            <% if canvas_data[:download_url] %>
              <a href="<%= canvas_data[:download_url] %>" class="btn btn-primary mt-3" download aria-label="Download file to view">
                <i data-lucide="download" class="me-2" aria-hidden="true"></i>Download to View
              </a>
            <% end %>
          </div>
        <% end %>
      <% end %>
    </div>

    <!-- Document Indexing Status (for recently uploaded documents) -->
    <% if canvas_data[:asset_id] %>
      <div class="mt-4" id="indexing-status-container"></div>
    <% end %>

    <% if canvas_data[:rag_store_id] %>
      <div class="mt-3 text-muted text-center">
        <small>
          <i data-lucide="database" class="me-1" aria-hidden="true"></i>
          Document stored in knowledge base (ID: <%= canvas_data[:rag_store_id] %>)
        </small>
      </div>
    <% end %>
  <% end %>
</div>

<style>
.document-viewer-container {
  height: 100%;
  display: flex;
  flex-direction: column;
  background: #0A0E1A;
  color: #E2E8F0;
}

.viewer-header {
  background: #0F172A;
  border: 1px solid #1E293B;
  border-radius: 0.5rem;
  padding: 1rem;
}

.viewer-header h5 {
  color: white;
  font-weight: 600;
}

.viewer-header .text-muted {
  color: #64748B !important;
}

.document-frame {
  flex: 1;
  background: #0F172A;
}

.document-frame iframe {
  background: white; /* PDFs render with white background */
}

/* Buttons */
.btn-outline-primary {
  color: #A78BFA;
  border-color: #A78BFA;
}

.btn-outline-primary:hover {
  background-color: #A78BFA;
  border-color: #A78BFA;
  color: #0A0E1A;
}

.btn-outline-secondary {
  color: #64748B;
  border-color: #64748B;
}

.btn-outline-secondary:hover {
  background-color: #64748B;
  border-color: #64748B;
  color: white;
}

/* Library view styles */
.document-library .list-group-item {
  background: #0F172A;
  border: 1px solid #1E293B;
  color: #E2E8F0;
  margin-bottom: 0.5rem;
}

.document-library .list-group-item:hover {
  background: rgba(167, 139, 250, 0.1);
  border-color: #A78BFA;
}

.document-library h6 {
  color: white;
  margin: 0;
}

/* Processing indicator */
.spinner-border-sm {
  width: 1rem;
  height: 1rem;
}

/* Alert styles */
.alert-info {
  background: rgba(59, 130, 246, 0.1);
  border: 1px solid rgba(59, 130, 246, 0.3);
  color: #93BBFB;
}

.alert-warning {
  background: rgba(251, 191, 36, 0.1);
  border: 1px solid rgba(251, 191, 36, 0.3);
  color: #FDE68A;
}

/* Status cards */
.card.border-info {
  background: rgba(59, 130, 246, 0.05);
  border: 1px solid rgba(59, 130, 246, 0.3) !important;
  color: #E2E8F0;
}

.card-body {
  color: #E2E8F0;
}

/* Progress bar */
.progress {
  background-color: #1E293B;
}

.progress-bar {
  background-color: #A78BFA;
}
</style>

<script>
// Initialize document viewer - runs immediately since canvas is already loaded
console.log('📄 Document viewer script loaded');

// Handle PDF loading errors
setTimeout(function() {
  const embed = document.querySelector('.document-frame embed');
  if (embed) {
    embed.addEventListener('error', function() {
      console.error('Failed to load PDF');
    });
  }
}, 100);

// Poll document indexing status - runs immediately
const assetId = document.querySelector('.document-viewer-container')?.dataset?.assetId;
console.log('Asset ID from data attribute:', assetId);
if (assetId) {
  console.log('Starting document status polling for asset:', assetId);
  pollDocumentStatus(assetId);
}

function pollDocumentStatus(assetId) {
  const statusContainer = document.getElementById('indexing-status-container');
  if (!statusContainer) return;

  // Poll every 5 seconds
  const pollInterval = setInterval(async () => {
    try {
      const response = await fetch(`/scout/document-status/${assetId}`);
      if (!response.ok) {
        clearInterval(pollInterval);
        return;
      }

      const status = await response.json();
      displayStatusUI(status, statusContainer);

      // Stop polling when complete or failed
      if (status.ready_for_chat || status.status === 'embedding_failed' ||
          status.status === 'extraction_failed' || status.status === 'chunking_failed' ||
          status.status === 'upload_failed') {
        clearInterval(pollInterval);
      }
    } catch (error) {
      console.error('Error polling document status:', error);
    }
  }, 5000);

  // Poll immediately on first load
  (async () => {
    try {
      const response = await fetch(`/scout/document-status/${assetId}`);
      if (response.ok) {
        const status = await response.json();
        displayStatusUI(status, statusContainer);
      }
    } catch (error) {
      console.error('Error fetching initial status:', error);
    }
  })();
}

function displayStatusUI(status, container) {
  if (!status) return;

  let html = '';

  // Hide status if document is ready or has no processing
  if (status.ready_for_chat) {
    container.innerHTML = '';
    return;
  }

  if (status.status === 'pending') {
    html = `
      <div class="alert alert-info" role="alert">
        <i data-lucide="clock" class="me-2" aria-hidden="true"></i>
        <strong>Preparing document...</strong><br>
        <small>This document hasn't been indexed yet. It will be ready for chat once processing completes.</small>
      </div>
    `;
  } else if (status.status.includes('failed')) {
    const errorMsg = status.error ? ` ${status.error}` : '';
    html = `
      <div class="alert alert-danger" role="alert">
        <i data-lucide="alert-circle" class="me-2" aria-hidden="true"></i>
        <strong>Processing Failed</strong><br>
        <small>${status.message}.${errorMsg}</small>
      </div>
    `;
  } else {
    const progressPercent = status.progress_percent || Math.round((status.stage / status.total_stages) * 100);
    const stageIcon = getStageIcon(status.stage);

    html = `
      <div class="card border-info">
        <div class="card-body">
          <div class="d-flex align-items-center mb-2">
            ${stageIcon}
            <strong>${status.message}</strong>
          </div>
          <div class="progress" style="height: 24px;">
            <div class="progress-bar progress-bar-striped progress-bar-animated"
                 role="progressbar"
                 style="width: ${progressPercent}%"
                 aria-valuenow="${progressPercent}"
                 aria-valuemin="0"
                 aria-valuemax="100">
              ${progressPercent}%
            </div>
          </div>
          <small class="text-muted d-block mt-2">
            Stage ${status.stage} of ${status.total_stages}
            ${status.embedded_chunks ? ` • ${status.embedded_chunks}/${status.total_chunks} chunks embedded` : ''}
          </small>
        </div>
      </div>
    `;
  }

  container.innerHTML = html;

  // Reinitialize lucide icons if they were added
  if (window.lucide) {
    window.lucide.createIcons();
  }
}

function getStageIcon(stage) {
  const icons = {
    0: '<i data-lucide="upload" class="me-2 text-muted" aria-hidden="true"></i>',
    1: '<i data-lucide="upload" class="me-2 text-info" aria-hidden="true"></i>',
    2: '<i data-lucide="file-text" class="me-2 text-info" aria-hidden="true"></i>',
    3: '<i data-lucide="layers" class="me-2 text-info" aria-hidden="true"></i>',
    4: '<i data-lucide="zap" class="me-2 text-info" aria-hidden="true"></i>'
  };
  return icons[stage] || '';
}
</script>