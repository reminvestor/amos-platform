<div class="scout-canvas document-viewer">
  <div class="canvas-header d-flex justify-content-between align-items-center mb-4">
    <div>
      <h4 class="mb-1">
        <i class="fas fa-file-alt text-primary me-2"></i>
        Document Viewer
      </h4>
      <p class="text-muted mb-0"><%= canvas_data[:filename] || 'Uploaded Document' %></p>
    </div>
    <div class="d-flex gap-2">
      <% if canvas_data[:download_url] %>
        <a href="<%= canvas_data[:download_url] %>" class="btn btn-outline-secondary" download>
          <i class="fas fa-download me-1"></i>
          Download
        </a>
      <% end %>
      <button class="btn btn-outline-secondary" onclick="window.scoutSendMessage?.('Summarize this document')">
        <i class="fas fa-file-alt me-1"></i>
        Summarize
      </button>
      <button class="btn btn-outline-secondary" onclick="window.scoutSendMessage?.('Translate this document')">
        <i class="fas fa-language me-1"></i>
        Translate
      </button>
      <button class="btn btn-primary" onclick="window.scoutSendMessage?.('Extract data from this document')">
        <i class="fas fa-database me-1"></i>
        Extract Data
      </button>
    </div>
  </div>
  
  <!-- Document Display -->
  <div class="document-display card border-0 shadow-sm">
    <div class="card-body p-0">
      <% if canvas_data[:content_type]&.start_with?('image/') %>
        <!-- Image Display -->
        <div class="text-center p-4" style="background: #f8f9fa;">
          <img src="<%= canvas_data[:url] %>" 
               alt="<%= canvas_data[:filename] %>" 
               class="img-fluid rounded shadow"
               style="max-height: 600px; max-width: 100%;">
        </div>
        
      <% elsif canvas_data[:content_type] == 'application/pdf' %>
        <!-- PDF Display -->
        <div class="pdf-viewer" style="height: 700px;">
          <% if canvas_data[:url] %>
            <iframe src="<%= canvas_data[:url] %>#toolbar=0&navpanes=0" 
                    width="100%" 
                    height="100%" 
                    style="border: none;"
                    title="<%= canvas_data[:filename] %>">
            </iframe>
          <% else %>
            <div class="text-center p-5">
              <i class="fas fa-file-pdf text-danger" style="font-size: 6rem;"></i>
              <p class="text-muted mt-3">PDF Preview</p>
              <p class="small"><%= canvas_data[:filename] %></p>
            </div>
          <% end %>
        </div>
        
      <% else %>
        <!-- Generic File Display -->
        <div class="text-center p-5">
          <i class="fas fa-file text-secondary" style="font-size: 6rem;"></i>
          <p class="text-muted mt-3"><%= canvas_data[:filename] %></p>
          <p class="small text-muted">
            Type: <%= canvas_data[:content_type] %><br>
            Size: <%= number_to_human_size(canvas_data[:size]) if canvas_data[:size] %>
          </p>
        </div>
      <% end %>
    </div>
  </div>
  
  <!-- Document Info -->
  <div class="document-info mt-3">
    <div class="card border-0 shadow-sm">
      <div class="card-body">
        <h6 class="mb-3 text-dark">
          <i class="fas fa-info-circle text-primary me-2"></i>
          Document Information
        </h6>
        <div class="row">
          <div class="col-md-6">
            <dl class="mb-0">
              <dt class="small text-secondary">Filename</dt>
              <dd class="text-dark fw-semibold"><%= canvas_data[:filename] %></dd>
              
              <dt class="small text-secondary">Type</dt>
              <dd class="text-dark"><%= canvas_data[:content_type] %></dd>
            </dl>
          </div>
          <div class="col-md-6">
            <dl class="mb-0">
              <% if canvas_data[:size] %>
                <dt class="small text-secondary">Size</dt>
                <dd class="text-dark"><%= number_to_human_size(canvas_data[:size]) %></dd>
              <% end %>
              
              <% if canvas_data[:pages] %>
                <dt class="small text-secondary">Pages</dt>
                <dd class="text-dark"><%= canvas_data[:pages] %></dd>
              <% end %>
            </dl>
          </div>
        </div>
        
        <% if canvas_data[:extracted_text_preview] %>
          <div class="mt-3">
            <dt class="small text-secondary">Extracted Text Preview</dt>
            <dd class="small font-monospace bg-light text-dark p-2 rounded" style="max-height: 100px; overflow-y: auto;">
              <%= truncate(canvas_data[:extracted_text_preview], length: 500) %>
            </dd>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>

<style>
.document-viewer {
  height: 100%;
  overflow-y: auto;
}

.document-display {
  background: white;
}

.pdf-viewer {
  background: #f8f9fa;
}

/* Force dark text for document info */
.document-viewer .card-body h6,
.document-viewer .card-body dd,
.document-viewer .card-body dt {
  color: #1f2937 !important;
}

.document-viewer .text-secondary {
  color: #6b7280 !important;
}
</style>

