<%# Document Store Canvas - Manage RAG stores and documents %>
<% data = canvas_data || {} %>
<% rag_stores = RagStore.where(entity_id: current_entity.id).order(updated_at: :desc) %>

<div class="document-store-canvas">
  <div class="ds-header">
    <div class="ds-title">
      <i data-lucide="folder-open" style="width: 24px; height: 24px;"></i>
      <h4>Document Store</h4>
    </div>
    <div class="ds-actions">
      <button class="btn btn-sm btn-outline-secondary" onclick="refreshDocumentStore()">
        <i data-lucide="refresh-cw" style="width: 14px; height: 14px;"></i>
        Refresh
      </button>
      <button class="btn btn-sm btn-primary" onclick="createNewStore()">
        <i data-lucide="plus" style="width: 14px; height: 14px;"></i>
        New Store
      </button>
    </div>
  </div>

  <div class="ds-content">
    <% if rag_stores.any? %>
      <div class="ds-stores-grid">
        <% rag_stores.each do |store| %>
          <div class="ds-store-card" data-store-id="<%= store.id %>">
            <div class="ds-store-header">
              <div class="ds-store-icon">
                <i data-lucide="database" style="width: 20px; height: 20px;"></i>
              </div>
              <div class="ds-store-info">
                <h5 class="ds-store-name"><%= store.name %></h5>
                <span class="ds-store-meta">
                  <%= store.rag_documents.count %> documents
                  <% if store.description.present? %>
                    · <%= store.description.truncate(50) %>
                  <% end %>
                </span>
              </div>
              <div class="ds-store-actions">
                <button class="btn btn-sm btn-ghost" onclick="openStore(<%= store.id %>)" title="Open">
                  <i data-lucide="folder-open" style="width: 14px; height: 14px;"></i>
                </button>
                <button class="btn btn-sm btn-ghost" onclick="uploadToStore(<%= store.id %>)" title="Upload">
                  <i data-lucide="upload" style="width: 14px; height: 14px;"></i>
                </button>
              </div>
            </div>
            
            <% if store.rag_documents.any? %>
              <div class="ds-store-documents">
                <% store.rag_documents.order(created_at: :desc).limit(5).each do |doc| %>
                  <div class="ds-document-item" onclick="viewDocument(<%= doc.id %>)">
                    <i data-lucide="<%= doc.content_type&.include?('pdf') ? 'file-text' : 'file' %>" 
                       style="width: 14px; height: 14px;" class="ds-doc-icon"></i>
                    <span class="ds-doc-name"><%= doc.original_filename.truncate(40) %></span>
                    <span class="ds-doc-meta">
                      <%= doc.is_transient ? '⏳' : '💾' %>
                      <%= time_ago_in_words(doc.created_at) %> ago
                    </span>
                  </div>
                <% end %>
                <% if store.rag_documents.count > 5 %>
                  <div class="ds-more-docs" onclick="openStore(<%= store.id %>)">
                    + <%= store.rag_documents.count - 5 %> more documents
                  </div>
                <% end %>
              </div>
            <% else %>
              <div class="ds-empty-store">
                <p>No documents yet</p>
                <button class="btn btn-sm btn-outline-primary" onclick="uploadToStore(<%= store.id %>)">
                  <i data-lucide="upload" style="width: 14px; height: 14px;"></i>
                  Upload Documents
                </button>
              </div>
            <% end %>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="ds-empty-state">
        <i data-lucide="folder-plus" style="width: 48px; height: 48px;"></i>
        <h5>No Document Stores Yet</h5>
        <p>Create a store to organize and search your documents with AI.</p>
        <button class="btn btn-primary" onclick="createNewStore()">
          <i data-lucide="plus" style="width: 16px; height: 16px;"></i>
          Create Your First Store
        </button>
      </div>
    <% end %>
  </div>
</div>

<style>
  .document-store-canvas {
    height: 100%;
    display: flex;
    flex-direction: column;
    background: var(--bg-primary, #0f0f1a);
    color: var(--text-primary, #e0e0e0);
    overflow: hidden;
  }
  
  .ds-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 16px 24px;
    border-bottom: 1px solid var(--border-primary, #2d2d44);
    background: var(--bg-secondary, #1a1a2e);
  }
  
  .ds-title {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  
  .ds-title h4 {
    margin: 0;
    font-weight: 600;
  }
  
  .ds-title i {
    color: #f59e0b;
  }
  
  .ds-actions {
    display: flex;
    gap: 8px;
  }
  
  .ds-content {
    flex: 1;
    overflow-y: auto;
    padding: 24px;
  }
  
  .ds-stores-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));
    gap: 20px;
  }
  
  .ds-store-card {
    background: var(--bg-secondary, #1a1a2e);
    border: 1px solid var(--border-primary, #2d2d44);
    border-radius: 12px;
    overflow: hidden;
    transition: border-color 0.2s;
  }
  
  .ds-store-card:hover {
    border-color: #f59e0b;
  }
  
  .ds-store-header {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    padding: 16px;
    border-bottom: 1px solid var(--border-primary, #2d2d44);
  }
  
  .ds-store-icon {
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, #f59e0b, #fbbf24);
    border-radius: 8px;
    color: white;
  }
  
  .ds-store-info {
    flex: 1;
    min-width: 0;
  }
  
  .ds-store-name {
    margin: 0 0 4px 0;
    font-size: 1rem;
    font-weight: 600;
  }
  
  .ds-store-meta {
    font-size: 0.75rem;
    color: var(--text-secondary, #a0a0b0);
  }
  
  .ds-store-actions {
    display: flex;
    gap: 4px;
  }
  
  .btn-ghost {
    background: transparent;
    border: none;
    padding: 6px;
    border-radius: 6px;
    color: var(--text-secondary, #a0a0b0);
    cursor: pointer;
    transition: all 0.15s;
  }
  
  .btn-ghost:hover {
    background: rgba(255,255,255,0.1);
    color: var(--text-primary, #fff);
  }
  
  .ds-store-documents {
    padding: 8px;
  }
  
  .ds-document-item {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 8px 10px;
    border-radius: 6px;
    cursor: pointer;
    transition: background 0.15s;
  }
  
  .ds-document-item:hover {
    background: rgba(255,255,255,0.05);
  }
  
  .ds-doc-icon {
    color: var(--text-secondary, #a0a0b0);
    flex-shrink: 0;
  }
  
  .ds-doc-name {
    flex: 1;
    font-size: 0.875rem;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  
  .ds-doc-meta {
    font-size: 0.7rem;
    color: var(--text-tertiary, #6b6b8a);
    white-space: nowrap;
  }
  
  .ds-more-docs {
    padding: 8px 10px;
    font-size: 0.8rem;
    color: #f59e0b;
    cursor: pointer;
    text-align: center;
  }
  
  .ds-more-docs:hover {
    text-decoration: underline;
  }
  
  .ds-empty-store {
    padding: 20px;
    text-align: center;
    color: var(--text-secondary, #a0a0b0);
  }
  
  .ds-empty-store p {
    margin: 0 0 12px 0;
    font-size: 0.875rem;
  }
  
  .ds-empty-state {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 60px 20px;
    color: var(--text-secondary, #a0a0b0);
  }
  
  .ds-empty-state i {
    margin-bottom: 16px;
    color: #f59e0b;
    opacity: 0.5;
  }
  
  .ds-empty-state h5 {
    margin: 0 0 8px 0;
    color: var(--text-primary, #fff);
  }
  
  .ds-empty-state p {
    margin: 0 0 20px 0;
  }
  
  /* Light mode */
  [data-theme="light"] .document-store-canvas,
  [data-bs-theme="light"] .document-store-canvas {
    background: #f8f9fa;
    color: #1a1a2e;
  }
  
  [data-theme="light"] .ds-header,
  [data-bs-theme="light"] .ds-header,
  [data-theme="light"] .ds-store-card,
  [data-bs-theme="light"] .ds-store-card {
    background: #fff;
    border-color: #e0e0e0;
  }
  
  [data-theme="light"] .ds-store-header,
  [data-bs-theme="light"] .ds-store-header {
    border-color: #e0e0e0;
  }
</style>

<script>
  if (typeof lucide !== 'undefined') {
    lucide.createIcons();
  }
  
  function refreshDocumentStore() {
    window.scoutController?.loadCanvas('document_store');
  }
  
  function createNewStore() {
    window.scoutController?.sendScoutMessage("I want to create a new document store");
  }
  
  function openStore(storeId) {
    window.scoutController?.sendScoutMessage(`Show me the documents in store ID ${storeId}`);
  }
  
  function uploadToStore(storeId) {
    window.scoutController?.sendScoutMessage(`I want to upload documents to store ID ${storeId}`);
  }
  
  function viewDocument(docId) {
    window.scoutController?.loadCanvas('document_viewer', { document_id: docId });
  }
</script>
