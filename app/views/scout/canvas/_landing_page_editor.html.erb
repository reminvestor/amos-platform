    /* ==================== LIGHT MODE STYLES ==================== */
    @media (prefers-color-scheme: light) {
      .component-panel {
        background: #f8f9fa;
        border-right-color: #e5e7eb;
      }
      
      .panel-header {
        background: #ffffff;
        border-bottom-color: #e5e7eb;
      }
      
      .component-group {
        border-bottom-color: #e5e7eb;
      }
      
      .component-group-title {
        color: #6b7280;
      }
      
      .component-item {
