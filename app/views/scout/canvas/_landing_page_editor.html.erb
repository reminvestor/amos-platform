    // ==================== Theme Sync from Parent ====================
    (function() {
      console.log('🎨 Iframe: Theme sync starting...');
      
      function applyLightMode() {
        console.log('🎨 Iframe: Applying light mode');
        document.body.classList.add('light-mode');
        document.body.setAttribute('data-theme', 'light');
      }
      
      function applyDarkMode() {
        console.log('🎨 Iframe: Applying dark mode');
        document.body.classList.remove('light-mode');
        document.body.removeAttribute('data-theme');
      }
      
      try {
        // Check if we can access parent document
        if (window.parent && window.parent !== window) {
          var parentTheme = null;
          try {
            parentTheme = window.parent.document.documentElement.getAttribute('data-theme') ||
