<div class="landing-page-editor" data-page-id="<%= landing_page.id %>" style="background-color: #0A0E1A; color: #FFFFFF; min-height: 100vh; padding: 2rem;">
  <!-- Header with page info and actions -->
  <div style="background: #1A1F35; border: 1px solid #1E293B; border-radius: 0.75rem; padding: 1.5rem; margin-bottom: 1.5rem;">
    <div style="display: flex; justify-content: space-between; align-items: center;">
      <div>
        <h1 style="color: #FFFFFF; font-size: 1.5rem; font-weight: 700; margin: 0 0 0.5rem 0; display: flex; align-items: center; gap: 0.75rem;">
          <i data-lucide="pencil" style="width: 1.5rem; height: 1.5rem; color: #A78BFA;"></i>
          <%= landing_page.title %>
        </h1>
        <small style="color: #94A3B8; font-size: 0.875rem;">
          Last updated <%= time_ago_in_words(landing_page.updated_at) %> ago
        </small>
      </div>
      <div style="display: flex; gap: 0.5rem; flex-wrap: wrap;">
        <button id="saveInlineChanges" onclick="saveInlineChanges()" aria-label="Save changes to landing page"
                style="background: linear-gradient(135deg, rgba(74, 222, 128, 0.8) 0%, rgba(74, 222, 128, 0.6) 100%); color: white; border: none; padding: 0.5rem 1rem; border-radius: 0.375rem; cursor: pointer; display: inline-flex; align-items: center; gap: 0.5rem; font-size: 0.875rem; font-weight: 500;">
          <i data-lucide="save" style="width: 1rem; height: 1rem;"></i> Save Changes
        </button>
        <a href="<%= preview_landing_page_path(landing_page) %>" target="_blank" aria-label="Preview landing page"
           style="background: transparent; color: #22D3EE; border: 1px solid #22D3EE; padding: 0.5rem 1rem; border-radius: 0.375rem; cursor: pointer; display: inline-flex; align-items: center; gap: 0.5rem; font-size: 0.875rem; font-weight: 500; text-decoration: none;">
          <i data-lucide="eye" style="width: 1rem; height: 1rem;"></i> Preview
        </a>
        <% if landing_page.status == 'published' %>
          <a href="<%= landing_page.full_url %>" target="_blank" aria-label="View live landing page"
             style="background: transparent; color: #A78BFA; border: 1px solid #A78BFA; padding: 0.5rem 1rem; border-radius: 0.375rem; cursor: pointer; display: inline-flex; align-items: center; gap: 0.5rem; font-size: 0.875rem; font-weight: 500; text-decoration: none;">
            <i data-lucide="external-link" style="width: 1rem; height: 1rem;"></i> Live Page
          </a>
        <% end %>
        <button onclick="window.scoutLoadCanvas?.('landing_page_viewer', {})" aria-label="Back to landing pages list"
                style="background: transparent; color: #94A3B8; border: 1px solid #1E293B; padding: 0.5rem 1rem; border-radius: 0.375rem; cursor: pointer; display: inline-flex; align-items: center; gap: 0.5rem; font-size: 0.875rem; font-weight: 500;">
          <i data-lucide="arrow-left" style="width: 1rem; height: 1rem;"></i> Back to List
        </button>
      </div>
    </div>
  </div>

  <!-- Instructions -->
  <div id="editingInstructions" style="background: linear-gradient(135deg, rgba(124, 58, 237, 0.2) 0%, rgba(167, 139, 250, 0.1) 100%); border: 1px solid rgba(124, 58, 237, 0.3); border-radius: 0.75rem; padding: 1.5rem; margin-bottom: 1.5rem; position: relative;">
    <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 1rem;">
      <strong style="color: #FFFFFF; display: flex; align-items: center; gap: 0.5rem; font-size: 1rem;">
        <i data-lucide="info" style="width: 1.25rem; height: 1.25rem; color: #A78BFA;"></i>Direct Editing Mode
      </strong>
      <button type="button" onclick="document.getElementById('editingInstructions').style.display='none';" aria-label="Close instructions"
              style="background: transparent; border: none; color: #94A3B8; cursor: pointer; padding: 0.25rem; line-height: 1; font-size: 1.25rem;">
        ×
      </button>
    </div>
    <ul style="margin: 0; padding-left: 1.5rem; color: #FFFFFF; font-size: 0.875rem;">
      <li style="margin-bottom: 0.5rem;">Click on any text to edit it directly</li>
      <li style="margin-bottom: 0.5rem;">Click the <i data-lucide="image" style="width: 0.875rem; height: 0.875rem; display: inline; vertical-align: middle; color: #A78BFA;"></i> icon on images to replace them</li>
      <li style="margin-bottom: 0.5rem;">Changes are highlighted until saved</li>
      <li>Press <kbd style="background: rgba(0, 0, 0, 0.3); border: 1px solid rgba(255, 255, 255, 0.2); border-radius: 0.25rem; padding: 0.125rem 0.375rem; font-family: monospace; color: #FFFFFF;">Escape</kbd> to cancel editing text</li>
    </ul>
  </div>

  <!-- Editable preview container -->
  <div style="background: #1A1F35; border: 1px solid #1E293B; border-radius: 0.75rem; overflow: hidden;">
    <div id="editablePreview" class="position-relative" style="min-height: 600px; background: white;">
      <iframe id="editorFrame" style="width: 100%; border: none; min-height: 800px;"></iframe>
    </div>
  </div>
</div>

<!-- Image Picker Modal -->
<div class="modal fade" id="scoutImagePickerModal" tabindex="-1">
  <div class="modal-dialog modal-lg">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">Select Image from Library</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <div id="scoutImageLibraryGrid" class="row g-3">
          <!-- Images will be loaded here -->
        </div>
        <div class="text-center mt-3">
          <button class="btn btn-sm btn-outline-secondary" id="loadMoreImages">Load More</button>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="button" class="btn btn-primary" id="selectImageBtn" disabled>Select Image</button>
      </div>
    </div>
  </div>
</div>

<style>
  /* Inline editing styles for iframe content */
  .inline-editor-styles {
    --edit-hover-bg: rgba(0, 123, 255, 0.1);
    --edit-hover-outline: rgba(0, 123, 255, 0.3);
    --edit-active-bg: rgba(255, 193, 7, 0.2);
    --edit-active-outline: #ffc107;
    --edit-changed-bg: rgba(255, 193, 7, 0.1);
  }
  
  /* Image picker styles */
  .image-picker-item {
    cursor: pointer;
    border: 2px solid transparent;
    transition: all 0.2s;
  }
  
  .image-picker-item:hover {
    border-color: #0d6efd;
    transform: scale(1.02);
  }
  
  .image-picker-item.selected {
    border-color: #0d6efd;
    box-shadow: 0 0 0 4px rgba(13, 110, 253, 0.25);
  }
  
  /* Ensure modal is above any canvas stacking contexts */
  #scoutImagePickerModal { z-index: 1060; }
  .modal-backdrop { z-index: 1050; }
</style>

<script>
  // Global state for inline editor
  window.scoutInlineEditor = {
    changes: {},
    currentImageElement: null,
    selectedImageUrl: null,
    imageLibraryPage: 1,
    pageId: '<%= landing_page.id %>',
    iframeDoc: null
  };
  
  // Initialize immediately when canvas loads (since this is loaded via AJAX)
  setTimeout(function() {
    initializeInlineEditor();
    setupAutoReloadListener();
    // Initialize Lucide icons
    if (typeof lucide !== 'undefined') {
      lucide.createIcons();
    }
  }, 100);
  
  // Also initialize on turbo load
  document.addEventListener('turbo:load', () => {
    if (typeof lucide !== 'undefined') {
      lucide.createIcons();
    }
  });
  
  // Set up listener for Scout updates to auto-reload editor
  function setupAutoReloadListener() {
    const editor = window.scoutInlineEditor;
    
    // Listen for Scout messages that indicate landing page updates
    document.addEventListener('scout:message-added', function(event) {
      const message = event.detail;
      
      console.log('📨 Scout message received in editor:', {
        role: message.role,
        content: message.content?.substring(0, 100) + '...',
        hasUpdated: message.content?.includes('updated'),
        hasChanged: message.content?.includes('changed'),
        hasModified: message.content?.includes('modified'),
        hasLandingPage: message.content?.includes('landing page'),
        hasPage: message.content?.includes('page')
      });
      
      // Check if Scout mentioned updating the current landing page
      if (message.role === 'assistant' && 
          (message.content.includes('updated') || message.content.includes('changed') || message.content.includes('modified')) &&
          (message.content.includes('landing page') || message.content.includes('page'))) {
        
        console.log('🔄 Detected Scout landing page update, reloading editor content');
        
        // Reload the landing page content after a brief delay
        setTimeout(() => {
          reloadEditorContent();
        }, 2000);
      }
    });
    
    // Also listen for job completion notifications
    if (window.jobNotificationChannel) {
      const originalReceived = window.jobNotificationChannel.received || function() {};
      window.jobNotificationChannel.received = function(data) {
        originalReceived.call(this, data);
        
        if (data.job_type === 'landing_page_update' && 
            data.landing_page_id == editor.pageId) {
          console.log('🎉 Landing page update completed via WebSocket, reloading editor');
          reloadEditorContent();
        }
      };
    }
  }
  
  // Reload the editor content from the server
  function reloadEditorContent() {
    const editor = window.scoutInlineEditor;
    
    // Fetch updated landing page content
    fetch(`/landing_pages/${editor.pageId}.json`)
      .then(response => response.json())
      .then(data => {
        if (data.html_content) {
          console.log('✅ Reloading editor with updated content');
          
          // Strip any markdown code blocks before displaying
          let cleanedContent = stripMarkdownCodeBlocks(data.html_content);
          
          // Update the iframe with new content
          const iframe = document.getElementById('editorFrame');
          editor.iframeDoc = iframe.contentDocument || iframe.contentWindow.document;
          editor.iframeDoc.open();
          editor.iframeDoc.write(cleanedContent);
          editor.iframeDoc.close();
          
          // Re-initialize editing capabilities
          iframe.onload = function() {
            makeContentEditable(editor.iframeDoc);
            iframe.style.height = editor.iframeDoc.body.scrollHeight + 'px';
          };
          
          // Clear any pending changes since we have fresh content
          editor.changes = {};
          updateSaveButton();
          
          // Show notification
          window.scoutShowNotification?.('Landing page updated with latest changes!', 'success');
        }
      })
      .catch(error => {
        console.error('Error reloading editor content:', error);
      });
  }
  
  // Strip markdown code blocks from HTML content
  function stripMarkdownCodeBlocks(html) {
    if (!html || typeof html !== 'string') return html;
    
    let cleaned = html.trim();
    
    // First, try to match complete markdown code blocks (```html ... ``` or ``` ... ```)
    // Only match if there's a newline after opening and before closing (markdown pattern)
    cleaned = cleaned.replace(/^```html\s*\n([\s\S]*?)\n```\s*$/i, '$1');
    cleaned = cleaned.replace(/^```\s*\n([\s\S]*?)\n```\s*$/, '$1');
    
    // Fallback: remove code block markers at start/end if they weren't part of a complete block
    // This handles cases where the pattern is slightly different
    if (cleaned.startsWith('```html') || cleaned.startsWith('```')) {
      cleaned = cleaned.replace(/^```html\s*\n?/i, '');
      cleaned = cleaned.replace(/^```\s*\n?/, '');
    }
    if (cleaned.endsWith('```')) {
      cleaned = cleaned.replace(/\n?```\s*$/, '');
    }
    
    return cleaned.trim();
  }

  function initializeInlineEditor() {
    const editor = window.scoutInlineEditor;
    let htmlContent = <%= raw (landing_page.html_content || '<div class="container py-5"><h1>Landing Page Under Construction</h1><p>This landing page is being prepared. Please check back soon!</p></div>').to_json %>;
    
    // Strip any markdown code blocks that might have been included
    htmlContent = stripMarkdownCodeBlocks(htmlContent);
    
    const iframe = document.getElementById('editorFrame');
    
    console.log('🎯 Initializing landing page editor for page ID:', editor.pageId);
    console.log('📄 HTML content length:', htmlContent.length);
    console.log('🖼️ Iframe element:', iframe);
    
    // Write content to iframe
    editor.iframeDoc = iframe.contentDocument || iframe.contentWindow.document;
    console.log('📄 Iframe document:', editor.iframeDoc);
    
    editor.iframeDoc.open();
    editor.iframeDoc.write(htmlContent);
    editor.iframeDoc.close();
    
    console.log('✅ HTML content written to iframe');
    
    // Wait for iframe to load
    iframe.onload = function() {
      makeContentEditable(editor.iframeDoc);
      
      // Adjust iframe height
      iframe.style.height = editor.iframeDoc.body.scrollHeight + 'px';
      
      // Monitor for content changes
      const resizeObserver = new ResizeObserver(entries => {
        iframe.style.height = editor.iframeDoc.body.scrollHeight + 'px';
      });
      resizeObserver.observe(editor.iframeDoc.body);
    };
    
    // Also set up editing after a short delay as fallback
    setTimeout(() => {
      if (editor.iframeDoc && editor.iframeDoc.body) {
        makeContentEditable(editor.iframeDoc);
        iframe.style.height = editor.iframeDoc.body.scrollHeight + 'px';
      }
    }, 500);
    
    // Set up image picker modal events
    document.getElementById('loadMoreImages').addEventListener('click', function() {
      editor.imageLibraryPage = editor.imageLibraryPage + 1;
      editorLoadImageLibrary(editor.imageLibraryPage, true);
    });
    
    document.getElementById('selectImageBtn').addEventListener('click', function() {
      if (editor.currentImageElement && editor.selectedImageUrl) {
        // Store the change
        const oldSrc = editor.currentImageElement.src;
        editor.currentImageElement.src = editor.selectedImageUrl;
        editor.currentImageElement.dataset.changed = 'true';
        
        // Track the change
        if (!editor.changes.images) editor.changes.images = [];
        editor.changes.images.push({
          element: editor.currentImageElement,
          oldSrc: oldSrc,
          newSrc: editor.selectedImageUrl
        });
        
        // Update save button
        updateSaveButton();
        
        // Close modal
        bootstrap.Modal.getInstance(document.getElementById('scoutImagePickerModal')).hide();
      }
    });

    // Expose minimal API for LLM-driven adjustments via chat
    window.scoutAdjustImage = function(selector, opts = {}) {
      // opts: { width, height, crop: { x, y, scale } }
      try {
        const el = editor.iframeDoc.querySelector(selector);
        if (!el) return false;
        const container = el.closest('.editable-image-container') || el.parentElement;
        if (opts.width) container.style.width = String(opts.width).endsWith('px') ? opts.width : opts.width + 'px';
        if (opts.height) el.style.height = String(opts.height).endsWith('px') ? opts.height : opts.height + 'px';
        if (opts.crop) {
          // Simple CSS crop via object-position and scale
          const s = opts.crop.scale || 1;
          el.style.objectFit = 'cover';
          el.style.transformOrigin = 'center center';
          el.style.transform = `scale(${s})`;
          if (opts.crop.x || opts.crop.y) {
            el.style.objectPosition = `${opts.crop.x || 50}% ${opts.crop.y || 50}%`;
          }
        }
        updateSaveButton();
        return true;
      } catch (e) { return false; }
    }
  }
  
  function makeContentEditable(doc) {
    // Inject editing styles
    const style = doc.createElement('style');
    style.textContent = `
      /* Editor-specific overrides for better editing experience */
      .hero-section {
        min-height: 300px !important; /* Override the 60vh to fixed height */
        max-height: 400px !important;
      }
      
      .editable-text {
        cursor: text;
        transition: background-color 0.2s;
      }
      .editable-text:hover {
        background-color: rgba(0, 123, 255, 0.1);
        outline: 2px dashed rgba(0, 123, 255, 0.3);
      }
      .editable-text.editing {
        background-color: rgba(255, 193, 7, 0.2);
        outline: 2px solid #ffc107;
      }
      .editable-text.changed {
        background-color: rgba(255, 193, 7, 0.1);
      }
      .editable-image-container {
        position: relative;
        display: inline-block;
      }
      .editable-image-container .image-edit-btn {
        position: absolute;
        top: 10px;
        right: 10px;
        background: rgba(0, 0, 0, 0.7);
        color: white;
        border: none;
        border-radius: 50%;
        width: 40px;
        height: 40px;
        display: none;
        cursor: pointer;
        z-index: 10;
        align-items: center;
        justify-content: center;
      }
      .editable-image-container:hover .image-edit-btn {
        display: flex;
      }
      .image-edit-btn:hover {
        background: rgba(0, 123, 255, 0.8);
      }

  /* Resize handles */
  .resize-handle {
    position: absolute;
    width: 12px; height: 12px;
    background: #0d6efd; border: 2px solid #fff; border-radius: 50%;
    box-shadow: 0 1px 2px rgba(0,0,0,0.2);
    cursor: nwse-resize; z-index: 11; display: none;
  }
  .editable-image-container:hover .resize-handle { display: block; }
  .resize-handle.br { right: -6px; bottom: -6px; }
    `;
    doc.head.appendChild(style);
    
    // Make text elements editable
    const textElements = doc.querySelectorAll('h1, h2, h3, h4, h5, h6, p, span, a, button, li, td, th, label');
    textElements.forEach(el => {
      // Skip elements with nested block-level children or form inputs
      if (el.querySelector('div, p, h1, h2, h3, h4, h5, h6, input, select, textarea')) return;
      
      el.classList.add('editable-text');
      el.contentEditable = true;
      el.spellcheck = false;
      
      // Track original content
      el.dataset.originalContent = el.innerHTML;
      
      // Add event listeners
      el.addEventListener('focus', handleTextFocus);
      el.addEventListener('blur', handleTextBlur);
      el.addEventListener('input', handleTextInput);
      el.addEventListener('keydown', handleTextKeydown);
    });
    
    // Make images replaceable
    const images = doc.querySelectorAll('img');
    images.forEach(img => {
      // Skip icons and tiny images
      if (img.width < 50 || img.height < 50) return;
      if (img.src.includes('data:image')) return; // Skip data URLs
      
      // Wrap in container if needed
      let container = img.parentElement;
      if (!container.classList.contains('editable-image-container')) {
        container = doc.createElement('div');
        container.className = 'editable-image-container';
        container.style.display = 'inline-block';
        img.parentNode.insertBefore(container, img);
        container.appendChild(img);
      }
      
      // Add edit button
      const editBtn = doc.createElement('button');
      editBtn.className = 'image-edit-btn';
      editBtn.innerHTML = '<i data-lucide="image" aria-hidden="true"></i>';
      editBtn.onclick = function(e) {
        e.preventDefault();
        openImagePicker(img);
      };
      container.appendChild(editBtn);

      // Initialize Lucide icon for the button
      if (typeof lucide !== 'undefined') {
        lucide.createIcons({ nameAttr: 'data-lucide' });
      }

      // Add resize handle (bottom-right)
      const handle = doc.createElement('div');
      handle.className = 'resize-handle br';
      container.appendChild(handle);

      attachResizeBehavior(doc, container, img, handle);
    });
  }
  
  function handleTextFocus(e) {
    e.target.classList.add('editing');
  }
  
  function handleTextBlur(e) {
    e.target.classList.remove('editing');
  }
  
  function handleTextInput(e) {
    const el = e.target;
    const editor = window.scoutInlineEditor;
    
    if (el.innerHTML !== el.dataset.originalContent) {
      el.classList.add('changed');
      
      // Track the change
      if (!editor.changes.text) editor.changes.text = [];
      const existingChange = editor.changes.text.find(c => c.element === el);
      if (existingChange) {
        existingChange.newContent = el.innerHTML;
      } else {
        editor.changes.text.push({
          element: el,
          selector: getElementSelector(el),
          originalContent: el.dataset.originalContent,
          newContent: el.innerHTML
        });
      }
      
      updateSaveButton();
    } else {
      el.classList.remove('changed');
      // Remove from changes if it exists
      if (editor.changes.text) {
        editor.changes.text = editor.changes.text.filter(c => c.element !== el);
      }
    }
  }
  
  function handleTextKeydown(e) {
    if (e.key === 'Escape') {
      e.preventDefault();
      e.target.innerHTML = e.target.dataset.originalContent;
      e.target.classList.remove('changed');
      e.target.blur();
      
      // Remove from changes
      const editor = window.scoutInlineEditor;
      if (editor.changes.text) {
        editor.changes.text = editor.changes.text.filter(c => c.element !== e.target);
      }
      updateSaveButton();
    }
  }
  
  function openImagePicker(imgElement) {
    const editor = window.scoutInlineEditor;
    editor.currentImageElement = imgElement;
    editor.selectedImageUrl = null;
    
    // Reset and load
    document.getElementById('scoutImageLibraryGrid').innerHTML = '';
    editor.imageLibraryPage = 1;
    editorLoadImageLibrary(1);
    
    // Show modal (ensure backdrop and scroll not locked by previous overlays)
    const modalEl = document.getElementById('scoutImagePickerModal');
    // Ensure modal is attached directly to <body> to avoid stacking-context issues
    if (modalEl && modalEl.parentElement !== document.body) {
      document.body.appendChild(modalEl);
    }
    document.body.classList.remove('modal-open');
    document.querySelectorAll('.modal-backdrop').forEach(b => b.remove());
    const bs = window.bootstrap || bootstrap;
    const modal = bs.Modal.getOrCreateInstance(modalEl, { backdrop: true, focus: true, keyboard: true });
    modal.show();
  }

  // Provide a global shim so other canvases or shared JS can open the library
  // This avoids the "Image library not available yet" alert when a generic
  // loadImageLibrary() call is used from the editor context.
  window.openImageLibraryModal = function(_targetId) {
    try {
      const grid = document.getElementById('scoutImageLibraryGrid');
      if (grid) { grid.innerHTML = ''; }
      window.scoutInlineEditor.imageLibraryPage = 1;
      editorLoadImageLibrary(1);
      const modal = new bootstrap.Modal(document.getElementById('scoutImagePickerModal'));
      modal.show();
    } catch (e) {
      console.warn('Failed to open image library modal from editor:', e);
    }
  }
  
  function editorLoadImageLibrary(page = 1, append = false) {
    fetch(`/image_assets.json?page=${page}`)
      .then(response => response.json())
      .then(data => {
        const grid = document.getElementById('scoutImageLibraryGrid');
        if (!append) grid.innerHTML = '';
        // Make modal body scrollable if many images
        document.querySelector('#scoutImagePickerModal .modal-body').style.maxHeight = '70vh';
        document.querySelector('#scoutImagePickerModal .modal-body').style.overflowY = 'auto';
        
        data.images.forEach(image => {
          const col = document.createElement('div');
          col.className = 'col-md-4';
          col.innerHTML = `
            <div class=\"image-picker-item card\" data-url=\"${image.url}\" data-id=\"${image.id}\">
              <img src=\"${image.thumb_url || image.url}\" class=\"card-img-top\" alt=\"${image.title}\" style=\"height: 150px; object-fit: cover;\">
              <div class="card-body p-2">
                <small class="text-muted text-truncate d-block">${image.title}</small>
              </div>
            </div>
          `;
          
          col.querySelector('.image-picker-item').addEventListener('click', function() {
            // Remove previous selection
            document.querySelectorAll('.image-picker-item').forEach(item => {
              item.classList.remove('selected');
            });
            
            // Select this image
            this.classList.add('selected');
            window.scoutInlineEditor.selectedImageUrl = this.dataset.url;
            window.scoutInlineEditor.selectedImageId = this.dataset.id;
            document.getElementById('selectImageBtn').disabled = false;
          });
          
          grid.appendChild(col);
        });
        
        // Hide load more if no more
        document.getElementById('loadMoreImages').style.display = data.images.length < 12 ? 'none' : 'block';
      })
      .catch(error => {
        console.error('Error loading images:', error);
      });
  }
  
  function getElementSelector(element) {
    const path = [];
    while (element && element.nodeType === Node.ELEMENT_NODE) {
      let selector = element.nodeName.toLowerCase();
      if (element.id) {
        selector += '#' + element.id;
        path.unshift(selector);
        break;
      } else if (element.className && typeof element.className === 'string') {
        const classes = element.className.split(' ').filter(c => c && !c.startsWith('editable'));
        if (classes.length > 0) {
          selector += '.' + classes.join('.');
        }
      }
      
      // Add index if needed
      let sibling = element;
      let index = 1;
      while (sibling = sibling.previousElementSibling) {
        if (sibling.nodeName.toLowerCase() === element.nodeName.toLowerCase()) {
          index++;
        }
      }
      if (index > 1) {
        selector += ':nth-of-type(' + index + ')';
      }
      
      path.unshift(selector);
      element = element.parentNode;
    }
    return path.join(' > ');
  }

  // Simple drag-to-resize behavior preserving aspect ratio
  function attachResizeBehavior(doc, container, img, handle) {
    let startX, startY, startW, startH, ratio;
    const minW = 80, minH = 60;
    const onMouseMove = (e) => {
      const dx = e.clientX - startX;
      const dy = e.clientY - startY;
      // Choose the dominant delta to maintain aspect ratio
      const delta = Math.abs(dx) > Math.abs(dy) ? dx : dy;
      let newW = Math.max(minW, startW + delta);
      let newH = Math.max(minH, Math.round(newW / ratio));
      container.style.width = newW + 'px';
      img.style.width = '100%';
      img.style.height = newH + 'px';
      img.style.objectFit = 'cover';
      // Mark as change for Save button
      const editor = window.scoutInlineEditor;
      if (!editor.changes.images) editor.changes.images = [];
      const existing = editor.changes.images.find(c => c.element === img);
      if (!existing) {
        editor.changes.images.push({ element: img, oldSize: { w: startW, h: startH }, newSize: { w: newW, h: newH } });
      } else {
        existing.newSize = { w: newW, h: newH };
      }
      updateSaveButton();
    };
    const onMouseUp = () => {
      doc.removeEventListener('mousemove', onMouseMove);
      doc.removeEventListener('mouseup', onMouseUp);
    };
    handle.addEventListener('mousedown', (e) => {
      e.preventDefault(); e.stopPropagation();
      try { if (doc.activeElement) doc.activeElement.blur(); } catch(_) {}
      try { if (window.document.activeElement) window.document.activeElement.blur(); } catch(_) {}
      const rect = container.getBoundingClientRect();
      // If container has no explicit width yet, set from current rect
      if (!container.style.width) container.style.width = rect.width + 'px';
      startX = e.clientX; startY = e.clientY;
      startW = rect.width; startH = rect.height;
      ratio = rect.width / rect.height || (img.naturalWidth / img.naturalHeight) || 16/9;
      doc.addEventListener('mousemove', onMouseMove);
      doc.addEventListener('mouseup', onMouseUp);
    });
  }
  
  function updateSaveButton() {
    const editor = window.scoutInlineEditor;
    const hasChanges = (editor.changes.text && editor.changes.text.length > 0) || 
                      (editor.changes.images && editor.changes.images.length > 0);
    
    const saveBtn = document.getElementById('saveInlineChanges');
    if (hasChanges) {
      saveBtn.style.background = 'linear-gradient(135deg, rgba(250, 204, 21, 0.8) 0%, rgba(250, 204, 21, 0.6) 100%)';
      saveBtn.innerHTML = '<i data-lucide="save" style="width: 1rem; height: 1rem;"></i> Save Changes*';
      // Re-initialize Lucide icons
      if (typeof lucide !== 'undefined') {
        lucide.createIcons();
      }
    } else {
      saveBtn.style.background = 'linear-gradient(135deg, rgba(74, 222, 128, 0.8) 0%, rgba(74, 222, 128, 0.6) 100%)';
      saveBtn.innerHTML = '<i data-lucide="save" style="width: 1rem; height: 1rem;"></i> Save Changes';
      // Re-initialize Lucide icons
      if (typeof lucide !== 'undefined') {
        lucide.createIcons();
      }
    }
  }
  
  function saveInlineChanges() {
    const editor = window.scoutInlineEditor;
    
    if ((!editor.changes.text || editor.changes.text.length === 0) && 
        (!editor.changes.images || editor.changes.images.length === 0)) {
      window.scoutShowNotification?.('No changes to save', 'info');
      return;
    }
    
    // Get updated HTML
    const updatedHtml = editor.iframeDoc.documentElement.outerHTML;
    
    // Send to server
    fetch(`/landing_pages/${editor.pageId}`, {
      method: 'PATCH',
      headers: {
        'Content-Type': 'application/json',
        'Accept': 'application/json',
        'X-CSRF-Token': window.parent.document.querySelector('meta[name="csrf-token"]')?.getAttribute('content') || document.querySelector('meta[name="csrf-token"]')?.getAttribute('content')
      },
      body: JSON.stringify({
        landing_page: {
          html_content: updatedHtml
        }
      })
    })
    .then(response => response.json())
    .then(data => {
      if (data.success) {
        // Clear changes
        editor.changes = {};
        
        // Update all elements
        editor.iframeDoc.querySelectorAll('.changed').forEach(el => {
          el.classList.remove('changed');
          el.dataset.originalContent = el.innerHTML;
        });
        
        updateSaveButton();
        window.scoutShowNotification?.('Changes saved successfully!', 'success');
      } else {
        window.scoutShowNotification?.('Error saving: ' + (data.error || 'Unknown error'), 'error');
      }
    })
    .catch(error => {
      window.scoutShowNotification?.('Error saving: ' + error.message, 'error');
    });
  }
  
  // Global function for Scout to show notifications
  window.scoutShowNotification = function(message, type = 'info') {
    const alertClass = {
      'success': 'alert-success',
      'error': 'alert-danger',
      'warning': 'alert-warning',
      'info': 'alert-info'
    }[type] || 'alert-info';
    
    const alert = document.createElement('div');
    alert.className = `alert ${alertClass} alert-dismissible fade show position-fixed top-0 start-50 translate-middle-x mt-3`;
    alert.style.zIndex = '1050';
    alert.innerHTML = `
      ${message}
      <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    `;
    document.body.appendChild(alert);
    
    setTimeout(() => {
      alert.remove();
    }, 3000);
  };
</script>
