    .image-modal-divider::before,
    .image-modal-divider::after {
      content: '';
      flex: 1;
      height: 1px;
      background: #3a3a4a;
    }
    
    .ai-generate-section {
      display: none;
      margin-bottom: 16px;
    }
    
    .ai-generate-section.active {
