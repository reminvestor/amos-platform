      const headingFontSelect = document.getElementById('headingFontSelect');
      const landingContent = document.getElementById('landingContent');
      
      function loadGoogleFont(fontName) {
        if (!fontName) return;
        const fontId = 'font-' + fontName.replace(/\\s+/g, '-').toLowerCase();
        if (document.getElementById(fontId)) return; // Already loaded
        
        const link = document.createElement('link');
        link.id = fontId;
        link.rel = 'stylesheet';
        link.href = 'https://fonts.googleapis.com/css2?family=' + encodeURIComponent(fontName) + ':wght@400;500;600;700&display=swap';
        document.head.appendChild(link);
      }
      
      function applyPageFont(fontName) {
        if (!landingContent) return;
        if (fontName) {
          loadGoogleFont(fontName);
          landingContent.style.fontFamily = '"' + fontName + '", sans-serif';
        } else {
          landingContent.style.fontFamily = '';
        }
        notifyParentChange();
      }
      
      function applyHeadingFont(fontName) {
        if (!landingContent) return;
        const headings = landingContent.querySelectorAll('h1, h2, h3, h4, h5, h6');
        if (fontName) {
          loadGoogleFont(fontName);
          headings.forEach(h => h.style.fontFamily = '"' + fontName + '", sans-serif');
        } else {
          headings.forEach(h => h.style.fontFamily = '');
        }
        notifyParentChange();
      }
      
      function notifyParentChange() {
        try {
          window.parent.postMessage({ type: 'content-changed' }, '*');
        } catch (e) {}
      }
      
      if (pageFontSelect) {
        pageFontSelect.addEventListener('change', function() {
          applyPageFont(this.value);
        });
      }
      
      if (headingFontSelect) {
