    // ==================== Initialize Editing ====================
    function initializeEditing() {
      // Extended selector to include more text elements
      const textElements = landingContent.querySelectorAll('h1, h2, h3, h4, h5, h6, p, span, a, button, li, td, th, strong, small, em, b, i, u, label, figcaption, blockquote, cite, address, dt, dd');
      
      console.log('📝 initializeEditing: Found', textElements.length, 'potential text elements');
      let madeEditable = 0;
      
      textElements.forEach(el => {
        // Skip if already editable
        if (el.dataset.editable) return;
        
        // Skip if this is a child of another editable element (avoid nested editables)
        if (el.closest('[data-editable="true"]') && el.closest('[data-editable="true"]') !== el) return;
        
        // Skip special UI elements (video wrappers, controls, handles, drop zones)
        if (el.closest('[data-video-editable]')) return;
        if (el.closest('.media-controls')) return;
        if (el.closest('.drag-handle')) return;
        if (el.closest('.section-delete-btn')) return;
        if (el.classList.contains('media-btn')) return;
        if (el.classList.contains('drag-handle')) return;
        if (el.classList.contains('section-delete-btn')) return;
        if (el.classList.contains('element-delete-btn')) return;
        
        // Skip form inputs (they have their own editing)
        if (el.tagName === 'BUTTON' && el.closest('form') && el.type === 'submit') {
          // Allow submit buttons to be editable for text
        } else if (el.closest('input, textarea, select')) return;
        
        // Skip elements inside drop zone placeholders
        if (el.closest('.drop-zone') && el.parentElement.children.length === 1 && el.tagName === 'SPAN') return;
        
        // Skip component panel elements
        if (el.closest('.component-panel')) return;
        
        // For headings and paragraphs, make them editable even if they contain inline elements
        // Only skip if they contain BLOCK elements that would break editing
        const hasBlockChildren = el.querySelector('div, section, article, aside, header, footer, nav, main, ul, ol, table, form');
        if (hasBlockChildren) return;
        
        el.contentEditable = true;
        el.dataset.editable = 'true';
        el.dataset.original = el.innerHTML;
        madeEditable++;
        
        el.oninput = function() { markChanged(); };
        
        el.onkeydown = function(e) {
          if (e.key === 'Escape') {
            el.innerHTML = el.dataset.original;
            el.blur();
          }
        };
        
        // Add visual feedback on hover
        el.style.cursor = 'text';
      });
      
      console.log('📝 initializeEditing: Made', madeEditable, 'elements editable');
      
      landingContent.querySelectorAll('a').forEach(link => {
        link.onclick = function(e) {
          if (!e.ctrlKey && !e.metaKey) e.preventDefault();
        };
      });
    }
    
    // ==================== Text Selection Toolbar ====================
    function setupTextToolbar() {
      const toolbar = document.getElementById('textToolbar');
      const linkInput = document.getElementById('linkInput');
      if (!toolbar) return;
      
      let savedSelection = null;
      
      // Show toolbar on text selection
      document.addEventListener('selectionchange', () => {
        const selection = window.getSelection();
        
        // Check if we have a valid selection with text
        if (!selection || selection.isCollapsed || selection.toString().trim() === '') {
          // Don't hide if we're in link mode (user is typing URL)
          if (!toolbar.classList.contains('link-mode')) {
            toolbar.classList.remove('visible');
          }
          return;
        }
        
        // Check if selection is within editable content
        const anchorNode = selection.anchorNode;
        const editableParent = anchorNode?.parentElement?.closest('[contenteditable="true"]') ||
                              (anchorNode?.nodeType === 1 && anchorNode.closest('[contenteditable="true"]'));
        
        if (!editableParent || !landingContent.contains(editableParent)) {
          toolbar.classList.remove('visible');
          return;
        }
        
        // Position and show toolbar
        const range = selection.getRangeAt(0);
        const rect = range.getBoundingClientRect();
        
        toolbar.style.left = (rect.left + rect.width / 2 - toolbar.offsetWidth / 2) + 'px';
        toolbar.style.top = (rect.top - toolbar.offsetHeight - 8) + 'px';
        
        // Ensure toolbar doesn't go off screen
        const toolbarRect = toolbar.getBoundingClientRect();
        if (toolbarRect.left < 10) toolbar.style.left = '10px';
        if (toolbarRect.top < 10) toolbar.style.top = (rect.bottom + 8) + 'px';
        
        toolbar.classList.add('visible');
        toolbar.classList.remove('link-mode');
        
        // Update button states
        updateToolbarButtonStates();
      });
      
      function updateToolbarButtonStates() {
        toolbar.querySelectorAll('.text-toolbar-btn[data-command]').forEach(btn => {
          const command = btn.dataset.command;
          if (command === 'link' || command === 'removeFormat') return;
          
          const isActive = document.queryCommandState(command);
          btn.classList.toggle('active', isActive);
        });
      }
      
      function saveSelection() {
        const selection = window.getSelection();
        if (selection.rangeCount > 0) {
          savedSelection = selection.getRangeAt(0).cloneRange();
        }
      }
      
      function restoreSelection() {
        if (savedSelection) {
          const selection = window.getSelection();
          selection.removeAllRanges();
          selection.addRange(savedSelection);
        }
      }
      
      // Handle toolbar button clicks
      toolbar.querySelectorAll('.text-toolbar-btn').forEach(btn => {
        btn.addEventListener('mousedown', (e) => {
          e.preventDefault(); // Prevent losing selection
        });
        
        btn.addEventListener('click', (e) => {
          e.preventDefault();
          e.stopPropagation();
          
          const command = btn.dataset.command;
          
          if (command === 'link') {
            // Show link input
            saveSelection();
            toolbar.classList.add('link-mode');
            linkInput.value = '';
            linkInput.focus();
            
            // Check if current selection is already a link
            const selection = window.getSelection();
            if (selection.anchorNode) {
              const link = selection.anchorNode.parentElement?.closest('a');
              if (link) {
                linkInput.value = link.href;
              }
            }
          } else if (command === 'foreColor') {
            // Open color picker
            saveSelection();
            const colorPicker = document.getElementById('colorPicker');
            colorPicker.click();
          } else if (command === 'removeFormat') {
            document.execCommand('removeFormat', false, null);
            // Also unlink if it's a link
            document.execCommand('unlink', false, null);
            markChanged();
          } else {
            document.execCommand(command, false, null);
            updateToolbarButtonStates();
            markChanged();
          }
        });
      });
      
      // Handle link input
      linkInput.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') {
          e.preventDefault();
          const url = linkInput.value.trim();
          
          restoreSelection();
          
          if (url) {
            // Add https:// if no protocol
            const finalUrl = url.match(/^https?:\\/\\//) ? url : 'https://' + url;
            document.execCommand('createLink', false, finalUrl);
          } else {
            // Remove link if URL is empty
            document.execCommand('unlink', false, null);
          }
          
          toolbar.classList.remove('link-mode');
          markChanged();
        } else if (e.key === 'Escape') {
          toolbar.classList.remove('link-mode');
          restoreSelection();
        }
      });
      
      // Close link input when clicking outside
      linkInput.addEventListener('blur', () => {
        setTimeout(() => {
          if (!toolbar.contains(document.activeElement)) {
            toolbar.classList.remove('link-mode');
          }
        }, 100);
      });
      
      // Color picker handler
      const colorPicker = document.getElementById('colorPicker');
      const colorIndicator = document.getElementById('colorIndicator');
      
      colorPicker.addEventListener('input', (e) => {
        const color = e.target.value;
        colorIndicator.style.borderBottomColor = color;
        restoreSelection();
        document.execCommand('foreColor', false, color);
        markChanged();
      });
      
      colorPicker.addEventListener('change', (e) => {
        // Final color selection
        const color = e.target.value;
        colorIndicator.style.borderBottomColor = color;
      });
      
      // Keyboard shortcuts for formatting
      landingContent.addEventListener('keydown', (e) => {
        if (!e.ctrlKey && !e.metaKey) return;
        
        const editableParent = e.target.closest('[contenteditable="true"]');
        if (!editableParent) return;
        
        switch(e.key.toLowerCase()) {
          case 'b':
            e.preventDefault();
            document.execCommand('bold', false, null);
            markChanged();
            break;
          case 'i':
            e.preventDefault();
            document.execCommand('italic', false, null);
            markChanged();
            break;
          case 'u':
            e.preventDefault();
            document.execCommand('underline', false, null);
            markChanged();
            break;
          case 'k':
            e.preventDefault();
            // Trigger link mode
            saveSelection();
            toolbar.classList.add('visible', 'link-mode');
            linkInput.value = '';
            linkInput.focus();
            break;
        }
      });
      
      console.log('📝 Text toolbar initialized');
    }
    
    // ==================== Add Delete Buttons ====================
    function addDeleteButtons() {
      const sections = landingContent.querySelectorAll('section, footer');
      
      sections.forEach(section => {
        if (section.querySelector('.section-delete-btn')) return;
        
        const btn = document.createElement('button');
        btn.className = 'section-delete-btn';
        btn.innerHTML = '×';
        btn.title = 'Delete section';
        btn.type = 'button';
        
        btn.addEventListener('click', (e) => {
          e.stopPropagation();
          if (confirm('Delete this section?')) {
            section.remove();
            markChanged();
            window.parent.postMessage({ type: 'save', force: true }, '*');
          }
        });
        
        section.insertBefore(btn, section.firstChild);
      });
    }
    
    // ==================== Drag & Drop ====================
    let draggedComponentType = null;
    
    document.querySelectorAll('.component-item').forEach(item => {
      item.addEventListener('dragstart', (e) => {
        draggedComponentType = item.dataset.type;
        e.dataTransfer.setData('text/plain', item.dataset.type);
        e.dataTransfer.effectAllowed = 'copy';
        item.classList.add('dragging');
        document.body.classList.add('is-dragging'); // Show drop zones
      });
      
      item.addEventListener('dragend', () => {
        item.classList.remove('dragging');
        draggedComponentType = null;
        document.body.classList.remove('is-dragging'); // Hide drop zones
        // Clear all drop highlights
        document.querySelectorAll('.drop-zone.drag-over, .drop-target').forEach(el => {
          el.classList.remove('drag-over', 'drop-target');
        });
      });
    });
    
    contentArea.addEventListener('dragover', (e) => {
      e.preventDefault();
      e.dataTransfer.dropEffect = 'copy';
      
      // Check if we're over a droppable container first (broader selector)
      const dropContainer = e.target.closest('.drop-zone, .grid-col, [class*="col-"], .row > div, .section-grid > div');
      if (dropContainer) {
        // Highlight the drop container
        document.querySelectorAll('.drag-over').forEach(z => {
          if (z !== dropContainer) z.classList.remove('drag-over');
        });
        dropContainer.classList.add('drag-over');
        if (dragOverTarget) {
          dragOverTarget.classList.remove('drop-target');
          dragOverTarget = null;
        }
        return;
      }
      
      // Otherwise highlight section
      contentArea.classList.add('drag-over');
      const target = e.target.closest('section, footer, header');
      if (target !== dragOverTarget) {
        if (dragOverTarget) dragOverTarget.classList.remove('drop-target');
        dragOverTarget = target;
        if (dragOverTarget) dragOverTarget.classList.add('drop-target');
      }
    });
    
    contentArea.addEventListener('dragleave', (e) => {
      if (!contentArea.contains(e.relatedTarget)) {
        contentArea.classList.remove('drag-over');
        if (dragOverTarget) {
          dragOverTarget.classList.remove('drop-target');
          dragOverTarget = null;
        }
      }
    });
    
    contentArea.addEventListener('drop', (e) => {
      e.preventDefault();
      contentArea.classList.remove('drag-over');
      
      // Clear all highlights
      document.querySelectorAll('.drop-zone.drag-over, .drop-target, .drag-over').forEach(el => {
        el.classList.remove('drag-over', 'drop-target');
      });
      
      // Try multiple data formats - design panel uses application/json, internal uses text/plain
      let componentType = e.dataTransfer.getData('text/plain');
      
      // If no text/plain, try application/json (from design panel)
      if (!componentType) {
        try {
          const jsonData = e.dataTransfer.getData('application/json');
          if (jsonData) {
            const parsed = JSON.parse(jsonData);
            componentType = parsed.componentType || parsed.type;
            console.log('📦 Got component from JSON:', componentType);
          }
        } catch (err) {
          console.log('📦 Could not parse JSON data:', err);
        }
      }
      
      if (!componentType || !components[componentType]) {
        console.log('📦 Unknown component type:', componentType);
        return;
      }
      
      console.log('📦 Dropping component:', componentType);
      
      const wrapper = document.createElement('div');
      wrapper.innerHTML = components[componentType];
      const newElement = wrapper.firstElementChild;
      newElement.classList.add('just-inserted');
      
      const isSectionType = componentType.startsWith('section_') || componentType === 'footer';
      
      // Find drop target - look for various container types
      const dropTarget = e.target.closest('.drop-zone, .grid-col, [class*="col-"], .row > div, .section-grid > div');
      const section = e.target.closest('section');
      
      if (isSectionType) {
        // Section-level drop
        console.log('📦 Dropping section');
        if (dragOverTarget) {
          dragOverTarget.after(newElement);
        } else {
          landingContent.appendChild(newElement);
        }
      } else if (dropTarget && section) {
        // Dropping into a column/container inside a section
        console.log('📦 Dropping into column:', dropTarget.className);
        
        // Clear placeholder text if present
        const placeholder = dropTarget.querySelector(':scope > span:only-child, :scope > p:only-child');
        if (placeholder && (placeholder.textContent.includes('Drop') || placeholder.textContent.includes('placeholder'))) {
          placeholder.remove();
        }
        
        // If dropping into empty column, mark it as having content
        if (dropTarget.classList.contains('empty-col')) {
          dropTarget.classList.remove('empty-col');
          dropTarget.classList.add('has-content');
        }
        
        newElement.setAttribute('data-just-dropped', 'true');
        dropTarget.appendChild(newElement);
      } else if (section) {
        // Dropping directly on a section - find a suitable container
        console.log('📦 Dropping into section:', section.className);
        
        // Look for common containers inside the section
        const container = section.querySelector('.section-grid > div, .grid-col, [class*="col-"], .container > .row > div, .container') || section;
        
        newElement.setAttribute('data-just-dropped', 'true');
        container.appendChild(newElement);
      } else {
        // Fallback - append to last section or landing content
        console.log('📦 Dropping at fallback location');
        const lastSection = landingContent.querySelector('section:last-of-type');
        const container = lastSection?.querySelector('.container') || lastSection || landingContent;
        
        newElement.setAttribute('data-just-dropped', 'true');
        container.appendChild(newElement);
      }
      
      // Full re-initialization to add drag handles, etc.
      document.body.classList.remove('is-dragging'); // Hide drop zones
      setTimeout(() => {
        if (!isReinitializing) reinitializeAll();
      }, 100);
      markChanged();
      
      newElement.scrollIntoView({ behavior: 'smooth', block: 'center' });
      window.parent.postMessage({ type: 'changed' }, '*');
      
      dragOverTarget = null;
    });
    
    // ==================== Communication ====================
    function markChanged() {
      hasChanges = true;
      window.parent.postMessage({ type: 'changed' }, '*');
    }
    
    function getContent() {
      const clone = landingContent.cloneNode(true);
      
      // Remove editor UI elements
      clone.querySelectorAll('.section-delete-btn').forEach(btn => btn.remove());
      clone.querySelectorAll('.element-delete-btn').forEach(btn => btn.remove());
      clone.querySelectorAll('.media-controls').forEach(el => el.remove());
      clone.querySelectorAll('.drag-handle').forEach(el => el.remove());
      clone.querySelectorAll('.drag-overlay').forEach(el => el.remove());
      clone.querySelectorAll('.resize-handle').forEach(el => el.remove());
      clone.querySelectorAll('.resize-info').forEach(el => el.remove());
      clone.querySelectorAll('.drop-indicator, .drop-indicator-h').forEach(el => el.remove());
      clone.querySelectorAll('.empty-placeholder').forEach(el => el.remove());
      
      // Remove ONLY truly empty drop zone columns (just placeholder text, no real content)
      clone.querySelectorAll('.empty-col').forEach(el => {
        // Check if it only has a placeholder span or is truly empty
        const hasRealContent = el.querySelector('div, section, h1, h2, h3, h4, h5, h6, p, img, video, iframe, form, button, a, ul, ol');
        if (!hasRealContent) {
          el.remove();
        } else {
          // Has content - just remove the empty-col class
          el.classList.remove('empty-col');
        }
      });
      
      // Remove any "Drop elements here" placeholder text
      clone.querySelectorAll('.drop-placeholder, [data-drop-placeholder]').forEach(el => el.remove());
      // Also remove spans that are just placeholders
      clone.querySelectorAll('.grid-col > span, .drop-zone > span').forEach(span => {
        if (span.textContent.toLowerCase().includes('drop') || 
            span.textContent.toLowerCase().includes('here') ||
            span.textContent.toLowerCase().includes('element')) {
          span.remove();
        }
      });
      
      // Clean up section-edit-grid structure
      // If a grid only has one column left, unwrap it to restore original structure
      clone.querySelectorAll('.section-edit-grid').forEach(grid => {
        const cols = grid.querySelectorAll('.grid-col');
        if (cols.length === 0) {
          // Empty grid, remove it
          grid.remove();
        } else if (cols.length === 1) {
          // Single column - unwrap contents to parent
          const col = cols[0];
          const parent = grid.parentElement;
          while (col.firstChild) {
            parent.insertBefore(col.firstChild, grid);
          }
          grid.remove();
        }
        // If 2+ columns with content, keep the grid structure
      });
      
      // Remove drop-zone class from elements (editor-only class)
      clone.querySelectorAll('.drop-zone').forEach(el => {
        el.classList.remove('drop-zone');
      });
      
      // Remove grid-col class if element is no longer in a grid
      clone.querySelectorAll('.grid-col').forEach(el => {
        if (!el.closest('.section-edit-grid, .section-grid')) {
          el.classList.remove('grid-col');
        }
      });
      
      // Remove has-content class (editor-only)
      clone.querySelectorAll('.has-content').forEach(el => {
        el.classList.remove('has-content');
      });
      
      // Clean up editing attributes
      clone.querySelectorAll('[contenteditable]').forEach(el => {
        el.removeAttribute('contenteditable');
        delete el.dataset.editable;
        delete el.dataset.original;
      });
      
      // Clean up editor data attributes
      clone.querySelectorAll('[data-drag-setup]').forEach(el => delete el.dataset.dragSetup);
      clone.querySelectorAll('[data-drag-id]').forEach(el => delete el.dataset.dragId);
      clone.querySelectorAll('[data-reorder-setup]').forEach(el => delete el.dataset.reorderSetup);
      clone.querySelectorAll('[data-resize-setup]').forEach(el => delete el.dataset.resizeSetup);
      clone.querySelectorAll('[data-overlay-setup]').forEach(el => delete el.dataset.overlaySetup);
      clone.querySelectorAll('[data-grid-converted]').forEach(el => delete el.dataset.gridConverted);
      clone.querySelectorAll('[data-overlay-setup]').forEach(el => delete el.dataset.overlaySetup);
      clone.querySelectorAll('[data-just-dropped]').forEach(el => delete el.dataset.justDropped);
      clone.querySelectorAll('[data-drop-zone]').forEach(el => delete el.dataset.dropZone);
      clone.querySelectorAll('[data-video-editable]').forEach(el => delete el.dataset.videoEditable);
      
      clone.querySelectorAll('.just-inserted').forEach(el => el.classList.remove('just-inserted'));
      clone.querySelectorAll('.being-dragged').forEach(el => el.classList.remove('being-dragged'));
      clone.querySelectorAll('.drag-over').forEach(el => el.classList.remove('drag-over'));
      clone.querySelectorAll('.resizing').forEach(el => el.classList.remove('resizing'));
      
      return clone.innerHTML;
    }
    
    window.addEventListener('message', (e) => {
      if (e.data.type === 'getContent') {
        window.parent.postMessage({ type: 'content', html: getContent() }, '*');
      } else if (e.data.type === 'reload') {
        location.reload();
      }
    });
    
    // ==================== Video Modal ====================
    let activeVideoElement = null;
    
    function showVideoModal(videoEl) {
      activeVideoElement = videoEl;
      
      const overlay = document.createElement('div');
      overlay.className = 'video-modal-overlay';
      overlay.innerHTML = \`
        <div class="video-modal">
          <h3>Add Video</h3>
          <div class="video-modal-tabs">
            <button class="video-modal-tab active" data-tab="url">URL</button>
            <button class="video-modal-tab" data-tab="embed">Embed Code</button>
            <button class="video-modal-tab" data-tab="ai">AI Generate</button>
          </div>
          <div class="video-modal-content">
            <div class="tab-content" data-content="url">
              <input type="text" id="videoUrl" placeholder="https://youtube.com/watch?v=... or vimeo.com/...">
              <p class="video-modal-helper">Paste a YouTube or Vimeo URL</p>
            </div>
            <div class="tab-content" data-content="embed" style="display:none;">
              <textarea id="videoEmbed" placeholder="Paste embed code here..."></textarea>
              <p class="video-modal-helper">Paste iframe embed code from YouTube, Vimeo, etc.</p>
            </div>
            <div class="tab-content" data-content="ai" style="display:none;">
              <textarea id="videoAiPrompt" placeholder="Describe the video you want... e.g., 'A professional explainer video showing how our crisis training program works'"></textarea>
              <p class="video-modal-helper">We'll use Nano Banana AI to generate your video</p>
            </div>
          </div>
          <div class="video-modal-actions">
            <button class="video-modal-btn cancel">Cancel</button>
            <button class="video-modal-btn primary" id="insertVideoBtn">Insert Video</button>
            <button class="video-modal-btn ai" id="generateVideoBtn" style="display:none;">Generate with AI</button>
          </div>
        </div>
      \`;
      
      document.body.appendChild(overlay);
      
      // Tab switching
      overlay.querySelectorAll('.video-modal-tab').forEach(tab => {
        tab.addEventListener('click', () => {
          overlay.querySelectorAll('.video-modal-tab').forEach(t => t.classList.remove('active'));
          tab.classList.add('active');
          
          const tabName = tab.dataset.tab;
          overlay.querySelectorAll('.tab-content').forEach(c => c.style.display = 'none');
          overlay.querySelector(\`[data-content="\${tabName}"]\`).style.display = 'block';
          
          // Show/hide buttons based on tab
          const insertBtn = overlay.querySelector('#insertVideoBtn');
          const aiBtn = overlay.querySelector('#generateVideoBtn');
          if (tabName === 'ai') {
            insertBtn.style.display = 'none';
            aiBtn.style.display = 'block';
          } else {
            insertBtn.style.display = 'block';
            aiBtn.style.display = 'none';
          }
        });
      });
      
      // Cancel
      overlay.querySelector('.cancel').addEventListener('click', () => {
        overlay.remove();
        activeVideoElement = null;
      });
      
      // Click outside to close
      overlay.addEventListener('click', (e) => {
        if (e.target === overlay) {
          overlay.remove();
          activeVideoElement = null;
        }
      });
      
      // Insert video
      overlay.querySelector('#insertVideoBtn').addEventListener('click', () => {
        const activeTab = overlay.querySelector('.video-modal-tab.active').dataset.tab;
        
        if (activeTab === 'url') {
          const url = overlay.querySelector('#videoUrl').value.trim();
          if (url) {
            insertVideoFromUrl(url);
          }
        } else if (activeTab === 'embed') {
          const embed = overlay.querySelector('#videoEmbed').value.trim();
          if (embed) {
            insertVideoEmbed(embed);
          }
        }
        
        overlay.remove();
      });
      
      // AI Generate
      overlay.querySelector('#generateVideoBtn').addEventListener('click', () => {
        const prompt = overlay.querySelector('#videoAiPrompt').value.trim();
        if (prompt) {
          generateVideoWithAI(prompt);
        }
        overlay.remove();
      });
      
      // Focus input
      setTimeout(() => overlay.querySelector('#videoUrl').focus(), 100);
    }
    
    function insertVideoFromUrl(url) {
      if (!activeVideoElement) return;
      
      let embedHtml = '';
      
      // YouTube
      const ytMatch = url.match(/(?:youtube\\.com\\/watch\\?v=|youtu\\.be\\/)([a-zA-Z0-9_-]+)/);
      if (ytMatch) {
        embedHtml = \`<iframe width="100%" height="315" src="https://www.youtube.com/embed/\${ytMatch[1]}" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen style="border-radius: 12px;"></iframe>\`;
      }
      
      // Vimeo
      const vimeoMatch = url.match(/vimeo\\.com\\/(\\d+)/);
      if (vimeoMatch) {
        embedHtml = \`<iframe src="https://player.vimeo.com/video/\${vimeoMatch[1]}" width="100%" height="315" frameborder="0" allow="autoplay; fullscreen; picture-in-picture" allowfullscreen style="border-radius: 12px;"></iframe>\`;
      }
      
      if (embedHtml) {
        activeVideoElement.innerHTML = embedHtml;
        activeVideoElement.style.padding = '0';
        activeVideoElement.style.background = 'transparent';
        activeVideoElement.removeAttribute('data-video-editable');
        markChanged();
      } else {
        alert('Could not parse video URL. Please use YouTube or Vimeo links.');
      }
      
      activeVideoElement = null;
    }
    
    function insertVideoEmbed(embedCode) {
      if (!activeVideoElement) return;
      
      activeVideoElement.innerHTML = embedCode;
      activeVideoElement.style.padding = '0';
      activeVideoElement.style.background = 'transparent';
      activeVideoElement.removeAttribute('data-video-editable');
      markChanged();
      activeVideoElement = null;
    }
    
    function generateVideoWithAI(prompt) {
      if (!activeVideoElement) return;
      
      // Show generating state
      activeVideoElement.innerHTML = \`
        <div style="padding: 2rem; text-align: center;">
          <div style="font-size: 2rem; margin-bottom: 1rem;">🎬</div>
          <p>Generating video with AI...</p>
          <small style="opacity: 0.6;">This may take a few minutes</small>
        </div>
      \`;
      
      // Send to parent to trigger AI generation
      window.parent.postMessage({
        type: 'generate-video',
        prompt: prompt,
        elementId: Date.now() // Unique identifier
      }, '*');
      
      markChanged();
      activeVideoElement = null;
    }
    
    // Listen for AI video result
    window.addEventListener('message', (e) => {
      if (e.data.type === 'video-generated') {
        // Find the placeholder and replace with actual video
        const placeholder = landingContent.querySelector('[data-generating-video]');
        if (placeholder && e.data.videoUrl) {
          placeholder.innerHTML = \`<video src="\${e.data.videoUrl}" controls style="width: 100%; border-radius: 12px;"></video>\`;
          placeholder.removeAttribute('data-generating-video');
          markChanged();
        }
      }
    });
    
    // Setup video click handlers
    function setupVideoEditing() {
      landingContent.querySelectorAll('[data-video-editable]').forEach(video => {
        if (video.dataset.videoClickBound) return;
        video.dataset.videoClickBound = 'true';
        
        video.addEventListener('click', (e) => {
          e.preventDefault();
          e.stopPropagation();
          showVideoModal(video);
        });
      });
    }
    
    // ==================== Grid Drop Zones ====================
    function setupDropZones() {
      // Find all drop zones and set up handlers
      landingContent.querySelectorAll('.drop-zone, .grid-col').forEach(zone => {
        if (zone.dataset.dropBound) return;
        zone.dataset.dropBound = 'true';
        zone.classList.add('drop-zone'); // Ensure class is present
        
        zone.addEventListener('dragover', (e) => {
          e.preventDefault();
          e.stopPropagation();
          e.dataTransfer.dropEffect = 'copy';
          zone.classList.add('drag-over');
        });
        
        zone.addEventListener('dragleave', (e) => {
          if (!zone.contains(e.relatedTarget)) {
            zone.classList.remove('drag-over');
          }
        });
        
        zone.addEventListener('drop', (e) => {
          e.preventDefault();
          e.stopPropagation();
          zone.classList.remove('drag-over');
          
          const componentType = e.dataTransfer.getData('text/plain');
          
          // Check if this is an existing element being moved
          const draggedEl = e.dataTransfer.getData('element-id');
          if (draggedEl) {
            const el = document.querySelector(\`[data-drag-id="\${draggedEl}"]\`);
            if (el) {
              zone.appendChild(el);
              markChanged();
              return;
            }
          }
          
          if (!componentType || !components[componentType]) return;
          
          // Clear placeholder text if this is an empty zone
          const placeholder = zone.querySelector(':scope > span:only-child');
          if (placeholder && placeholder.textContent.includes('Drop')) {
            zone.innerHTML = '';
            zone.style.border = 'none';
            zone.style.display = '';
            zone.style.alignItems = '';
            zone.style.justifyContent = '';
          }
          
          const wrapper = document.createElement('div');
          wrapper.innerHTML = components[componentType];
          const newElement = wrapper.firstElementChild;
          newElement.classList.add('just-inserted');
          newElement.setAttribute('data-just-dropped', 'true');
          
          zone.appendChild(newElement);
          
          // Re-initialize to add drag handles, etc.
          setTimeout(() => {
            if (!isReinitializing) reinitializeAll();
          }, 100);
          markChanged();
        });
      });
    }
    
    // ==================== Element Drag & Reorder ====================
    let globalDraggedElement = null;
    let dragIdCounter = 0;
    
    function setupElementDragging() {
      // Add drag handles to movable elements
      // Target: major content blocks that users would want to reorder
      const draggableSelector = [
        '.media-wrapper',
        '.video-wrapper',
        'form',
        '.grid-col > *:not(.drop-indicator):not(.media-controls):not(.drag-handle):not(.empty-col)',
        '.drop-zone > *:not(.section-grid):not(.section-edit-grid):not(.drop-indicator):not(.media-controls):not(.drag-handle)',
        '[data-just-dropped]'
      ].join(', ');
      
      const allMatches = landingContent.querySelectorAll(draggableSelector);
      // console.log('🎯 Found draggable candidates:', allMatches.length);
      
      allMatches.forEach(el => {
        // Skip specific excluded items
        if (el.dataset.dragSetup) {
          // Already setup, skip silently
          return;
        }
        if (el.classList.contains('section-delete-btn')) return;
        if (el.classList.contains('element-delete-btn')) return;
        if (el.classList.contains('drag-handle')) return;
        if (el.classList.contains('drop-indicator')) return;
        if (el.classList.contains('drop-indicator-h')) return;
        if (el.classList.contains('media-controls')) return;
        if (el.classList.contains('media-btn')) return;
        if (el.classList.contains('empty-col')) return;
        
        // Skip if this element is already inside a draggable wrapper (avoid double handles)
        // BUT always allow video-wrapper and media-wrapper to have their own handles
        if (el.parentElement && el.parentElement.closest('[data-drag-setup]')) {
          if (!el.classList.contains('video-wrapper') && !el.classList.contains('media-wrapper')) {
            return; // Parent already has drag, skip silently
          }
        }
        
        el.dataset.dragSetup = 'true';
        el.dataset.dragId = 'el-' + (dragIdCounter++);
        el.removeAttribute('data-just-dropped');
        
        // Make element relatively positioned
        const currentPos = getComputedStyle(el).position;
        if (currentPos === 'static') {
          el.style.position = 'relative';
        }
        
        // For elements containing iframes, use MOUSE-BASED dragging (not native drag API)
        const hasIframe = el.querySelector('iframe');
        if (hasIframe && !el.querySelector('.drag-overlay')) {
          const overlay = document.createElement('div');
          overlay.className = 'drag-overlay';
          el.appendChild(overlay);
          el.dataset.overlaySetup = 'true';
          el.draggable = false; // Disable native drag
          
          let isDragging = false;
          let dragClone = null;
          let startX, startY;
          
          overlay.onmousedown = function(e) {
            e.preventDefault();
            e.stopPropagation();
            
            isDragging = true;
            startX = e.clientX;
            startY = e.clientY;
            
            // Create a visual clone to drag
            dragClone = document.createElement('div');
            dragClone.style.cssText = 'position:fixed;width:150px;height:80px;background:linear-gradient(135deg,#ec4899,#8b5cf6);color:white;display:flex;align-items:center;justify-content:center;border-radius:12px;font-size:14px;font-weight:600;box-shadow:0 8px 32px rgba(0,0,0,0.4);z-index:99999;pointer-events:none;';
            dragClone.textContent = '📹 Moving...';
            dragClone.style.left = (e.clientX - 75) + 'px';
            dragClone.style.top = (e.clientY - 40) + 'px';
            document.body.appendChild(dragClone);
            
            globalDraggedElement = el;
            el.classList.add('being-dragged');
            el.style.opacity = '0.5';
            document.body.classList.add('is-dragging');
            
            console.log('🖱️ MOUSE DRAG START:', el.tagName, el.className);
          };
          
          document.addEventListener('mousemove', function(e) {
            if (!isDragging || !dragClone) return;
            
            dragClone.style.left = (e.clientX - 75) + 'px';
            dragClone.style.top = (e.clientY - 40) + 'px';
            
            // Find drop target under cursor
            dragClone.style.display = 'none'; // Hide to get element under cursor
            const elementUnder = document.elementFromPoint(e.clientX, e.clientY);
            dragClone.style.display = 'flex';
            
            // Highlight drop targets
            document.querySelectorAll('.drag-over').forEach(c => c.classList.remove('drag-over'));
            if (elementUnder) {
              const dropTarget = elementUnder.closest('.grid-col, .drop-zone, .container, .row, section');
              if (dropTarget && dropTarget !== el && !el.contains(dropTarget)) {
                dropTarget.classList.add('drag-over');
              }
            }
          });
          
          document.addEventListener('mouseup', function(e) {
            if (!isDragging) return;
            isDragging = false;
            
            console.log('🖱️ MOUSE DRAG END');
            
            // Store reference before cleanup
            const draggedEl = globalDraggedElement;
            
            // Find drop target
            if (dragClone) {
              dragClone.style.display = 'none';
              const elementUnder = document.elementFromPoint(e.clientX, e.clientY);
              dragClone.remove();
              dragClone = null;
              
              if (elementUnder && draggedEl) {
                const dropTarget = elementUnder.closest('.grid-col, .drop-zone, .container, .row, section');
                if (dropTarget && dropTarget !== draggedEl && !draggedEl.contains(dropTarget)) {
                  console.log('📥 MOUSE DROP on:', dropTarget.tagName, dropTarget.className);
                  
                  // IMPORTANT: Block reinitializeAll during the move
                  isReinitializing = true;
                  
                  // Move the element
                  dropTarget.appendChild(draggedEl);
                  
                  // Restore element state
                  draggedEl.style.opacity = '1';
                  draggedEl.classList.remove('being-dragged');
                  
                  // Re-add the overlay if it was lost
                  if (!draggedEl.querySelector('.drag-overlay')) {
                    const newOverlay = document.createElement('div');
                    newOverlay.className = 'drag-overlay';
                    draggedEl.appendChild(newOverlay);
                  }
                  
                  console.log('✅ Element moved successfully!');
                  
                  // Allow reinit after a delay, then save
                  setTimeout(() => {
                    isReinitializing = false;
                    markChanged();
                    // Trigger auto-save via postMessage to parent
                    window.parent.postMessage({ type: 'save', force: true }, '*');
                  }, 200);
                  
                  // Clean up
                  globalDraggedElement = null;
                  document.body.classList.remove('is-dragging');
                  document.querySelectorAll('.drag-over').forEach(c => c.classList.remove('drag-over'));
                  return; // Exit early - we handled the drop
                }
              }
            }
            
            // Clean up if no valid drop
            if (draggedEl) {
              draggedEl.style.opacity = '1';
              draggedEl.classList.remove('being-dragged');
            }
            globalDraggedElement = null;
            document.body.classList.remove('is-dragging');
            document.querySelectorAll('.drag-over').forEach(c => c.classList.remove('drag-over'));
          });
          
          // Skip native drag setup for this element
          return;
        }
        
        // Make element draggable but PRESERVE text editability
        // The trick: use a drag handle instead of making the whole element the drag source
        el.style.position = 'relative';
        
        // DON'T disable contentEditable - we want text to remain editable!
        // Instead, we'll use a drag handle for moving
        
        // Create a drag handle in the corner
        const handle = document.createElement('div');
        handle.className = 'drag-handle';
        handle.innerHTML = '⋮⋮';
        handle.draggable = true;
        handle.style.pointerEvents = 'auto'; // Handle is interactive!
        handle.style.cursor = 'grab';
        el.appendChild(handle);
        
        // Create a delete button next to the drag handle
        const deleteBtn = document.createElement('button');
        deleteBtn.className = 'element-delete-btn';
        deleteBtn.innerHTML = '×';
        deleteBtn.title = 'Delete this element';
        deleteBtn.type = 'button';
        deleteBtn.onclick = function(e) {
          e.preventDefault();
          e.stopPropagation();
          if (confirm('Delete this element?')) {
            el.remove();
            markChanged();
          }
        };
        el.appendChild(deleteBtn);
        
        // Show handle and delete button on hover
        el.onmouseenter = () => {
          handle.style.display = 'flex';
          deleteBtn.style.display = 'flex';
        };
        el.onmouseleave = () => {
          if (globalDraggedElement !== el) {
            handle.style.display = 'none';
            deleteBtn.style.display = 'none';
          }
        };
        
        // Drag starts from the HANDLE, not the element
        handle.ondragstart = function(e) {
          e.stopPropagation();
          console.log('🚀 DRAG START (from handle):', el.tagName, el.className);
          e.dataTransfer.setData('text/plain', el.dataset.dragId);
          e.dataTransfer.effectAllowed = 'move';
          globalDraggedElement = el;
          el.classList.add('being-dragged');
          document.body.classList.add('is-dragging');
          el.style.opacity = '0.5';
        };
        
        handle.ondragend = function(e) {
          console.log('🛑 DRAG END - dropEffect:', e.dataTransfer.dropEffect);
          el.style.opacity = '1';
          el.classList.remove('being-dragged');
          document.body.classList.remove('is-dragging');
          handle.style.display = 'none';
          
          setTimeout(() => {
            if (globalDraggedElement === el) {
              console.log('🛑 Clearing globalDraggedElement');
              globalDraggedElement = null;
            }
            document.querySelectorAll('.drop-indicator, .drop-indicator-h').forEach(i => i.remove());
            document.querySelectorAll('.drag-over').forEach(c => c.classList.remove('drag-over'));
          }, 50);
        };
      });
    }
    
    // ==================== Drop Targets ====================
    function setupDropTargets() {
      // Set up drop targets for reordering (sections and grid columns)
      // Use a broad selector to catch all containers
      // Note: media-wrapper/video-wrapper are NOT drop targets (can't drop things INTO images/videos)
      const dropTargets = landingContent.querySelectorAll('section, .grid-col, .drop-zone, .section-grid, .section-edit-grid, .container, .row, form');
      // console.log('📦 Setting up drop targets:', dropTargets.length);
      
      dropTargets.forEach(container => {
        if (container.dataset.reorderSetup) return;
        container.dataset.reorderSetup = 'true';
        // console.log('📦 Drop target added:', container.tagName, container.className);
        
        container.ondragover = function(e) {
          console.log('📍 DRAGOVER:', container.tagName, 'globalDraggedElement:', !!globalDraggedElement);
          
          // Must have a dragged element
          if (!globalDraggedElement) return;
          
          // Don't drop on self or into own children
          if (container === globalDraggedElement) return;
          if (globalDraggedElement.contains(container)) return;
          
          // Accept the drop!
          e.preventDefault();
          e.stopPropagation();
          e.dataTransfer.dropEffect = 'move';
          
          container.classList.add('drag-over');
          
          // Detect if this is a horizontal (grid/flex) layout
          const style = window.getComputedStyle(container);
          const isHorizontal = style.display === 'flex' && style.flexDirection === 'row' ||
                               style.display === 'grid' && style.gridTemplateColumns !== 'none';
          
          // Find closest child element to show indicator
          const children = Array.from(container.children).filter(c => 
            !c.classList.contains('drop-indicator') && 
            !c.classList.contains('drop-indicator-h') &&
            !c.classList.contains('section-delete-btn') &&
            !c.classList.contains('element-delete-btn') &&
            !c.classList.contains('drag-handle') &&
            !c.classList.contains('media-controls') &&
            c !== globalDraggedElement &&
            c.style.display !== 'none'
          );
          
          // Clear existing indicators in other containers
          document.querySelectorAll('.drop-indicator, .drop-indicator-h').forEach(i => {
            if (i.parentElement !== container) i.remove();
          });
          document.querySelectorAll('.drag-over').forEach(el => {
            if (el !== container) el.classList.remove('drag-over');
          });
          
          if (children.length === 0) {
             // Empty container - just highlight it
             return;
          }
          
          // Clear indicators in THIS container to update position
          container.querySelectorAll('.drop-indicator, .drop-indicator-h').forEach(i => i.remove());
          
          if (isHorizontal) {
            // Horizontal layout - use X position
            const mouseX = e.clientX;
            let insertBefore = null;
            let insertAfter = null;
            
            for (const child of children) {
              const rect = child.getBoundingClientRect();
              if (mouseX < rect.left + rect.width / 2) {
                insertBefore = child;
                break;
              }
              insertAfter = child;
            }
            
            const indicator = document.createElement('div');
            indicator.className = 'drop-indicator-h';
            
            if (insertBefore) {
              indicator.classList.add('left');
              insertBefore.style.position = 'relative';
              insertBefore.appendChild(indicator);
            } else if (insertAfter) {
              indicator.classList.add('right');
              insertAfter.style.position = 'relative';
              insertAfter.appendChild(indicator);
            } else {
               // Fallback if no children matched (shouldn't happen with length check)
               container.appendChild(indicator);
            }
          } else {
            // Vertical layout - use Y position
            const mouseY = e.clientY;
            let insertBefore = null;
            
            for (const child of children) {
              const rect = child.getBoundingClientRect();
              if (mouseY < rect.top + rect.height / 2) {
                insertBefore = child;
                break;
              }
            }
            
            const indicator = document.createElement('div');
            indicator.className = 'drop-indicator';
            
            if (insertBefore) {
              container.insertBefore(indicator, insertBefore);
            } else {
              container.appendChild(indicator);
            }
          }
        };
        
        container.ondragleave = function(e) {
          if (!container.contains(e.relatedTarget)) {
            container.classList.remove('drag-over');
            document.querySelectorAll('.drop-indicator, .drop-indicator-h').forEach(i => i.remove());
          }
        };
        
        container.ondrop = function(e) {
          const draggedEl = globalDraggedElement;
          if (!draggedEl) return;
          
          // Don't drop on self or into own children
          if (container === draggedEl) return;
          if (draggedEl.contains(container)) return;
          
          e.preventDefault();
          e.stopPropagation();
          
          console.log('📥 DROP:', draggedEl.tagName, '→', container.tagName);
          container.classList.remove('drag-over');
          
          // Check for vertical indicator
          const vIndicator = container.querySelector('.drop-indicator');
          if (vIndicator) {
            console.log('📥 Inserting at vertical indicator');
            container.insertBefore(draggedEl, vIndicator);
            vIndicator.remove();
          } else {
            // Check for horizontal indicator
            const hIndicator = container.querySelector('.drop-indicator-h');
            if (hIndicator) {
              console.log('📥 Inserting at horizontal indicator');
              const parent = hIndicator.parentElement;
              if (hIndicator.classList.contains('left')) {
                parent.parentElement.insertBefore(draggedEl, parent);
              } else {
                parent.parentElement.insertBefore(draggedEl, parent.nextSibling);
              }
              hIndicator.remove();
            } else {
              console.log('📥 Appending to container');
              container.appendChild(draggedEl);
            }
          }
          
          draggedEl.style.opacity = '1';
          draggedEl.classList.remove('being-dragged');
          globalDraggedElement = null;
          document.body.classList.remove('is-dragging');
          document.querySelectorAll('.drop-indicator, .drop-indicator-h').forEach(i => i.remove());
          document.querySelectorAll('.drag-over').forEach(c => c.classList.remove('drag-over'));
          
          // If dropped into an empty column, mark it as having content
          if (container.classList.contains('empty-col')) {
            container.classList.remove('empty-col');
            container.classList.add('has-content');
            // Remove the placeholder text
            const placeholder = container.querySelector('span');
            if (placeholder) placeholder.remove();
          }
          
          markChanged();
          
          // Re-init after a delay, but only if not already reinitializing
          setTimeout(() => {
            if (!isReinitializing) {
              reinitializeAll();
            }
          }, 150);
        };
      });
    }
    
    // ==================== Resize Handles for Media ====================
    function setupResizeHandles() {
      console.log('📐 Setting up resize handles...');
      
      // Find all media wrappers that need resize handles
      landingContent.querySelectorAll('.media-wrapper, .video-wrapper').forEach(wrapper => {
        if (wrapper.dataset.resizeSetup) return;
        wrapper.dataset.resizeSetup = 'true';
        
        // Remove any existing resize handles
        wrapper.querySelectorAll('.resize-handle').forEach(h => h.remove());
        
        // Add resize handles
        const handleSE = document.createElement('div');
        handleSE.className = 'resize-handle resize-handle-se';
        handleSE.title = 'Drag to resize';
        
        const handleE = document.createElement('div');
        handleE.className = 'resize-handle resize-handle-e';
        handleE.title = 'Drag to resize width';
        
        wrapper.appendChild(handleSE);
        wrapper.appendChild(handleE);
        
        // Find the resizable element (img or iframe)
        const resizable = wrapper.querySelector('img, iframe') || wrapper;
        
        // Set initial dimensions if not set
        if (resizable.tagName === 'IMG' || resizable.tagName === 'IFRAME') {
          if (!resizable.style.width) {
            resizable.style.width = '100%';
          }
          resizable.style.maxWidth = '100%';
        }
        
        let isResizing = false;
        let startX, startY, startWidth, startHeight, aspectRatio;
        let resizeInfo = null;
        
        function startResize(e, maintainAspect = true) {
          e.preventDefault();
          e.stopPropagation();
          
          isResizing = true;
          wrapper.classList.add('resizing');
          
          startX = e.clientX;
          startY = e.clientY;
          
          const rect = resizable.getBoundingClientRect();
          startWidth = rect.width;
          startHeight = rect.height;
          aspectRatio = startWidth / startHeight;
          
          // Create size info tooltip
          resizeInfo = document.createElement('div');
          resizeInfo.className = 'resize-info';
          wrapper.appendChild(resizeInfo);
          updateResizeInfo(startWidth, startHeight);
          
          document.addEventListener('mousemove', maintainAspect ? doResizeAspect : doResizeWidth);
          document.addEventListener('mouseup', stopResize);
        }
        
        function updateResizeInfo(w, h) {
          if (resizeInfo) {
            resizeInfo.textContent = Math.round(w) + ' × ' + Math.round(h) + 'px';
          }
        }
        
        function doResizeAspect(e) {
          if (!isResizing) return;
          
          const deltaX = e.clientX - startX;
          const deltaY = e.clientY - startY;
          
          // Use the larger delta to maintain aspect ratio
          const delta = Math.abs(deltaX) > Math.abs(deltaY) ? deltaX : deltaY * aspectRatio;
          
          let newWidth = Math.max(100, startWidth + delta);
          let newHeight = newWidth / aspectRatio;
          
          resizable.style.width = newWidth + 'px';
          resizable.style.height = newHeight + 'px';
          
          updateResizeInfo(newWidth, newHeight);
        }
        
        function doResizeWidth(e) {
          if (!isResizing) return;
          
          const deltaX = e.clientX - startX;
          let newWidth = Math.max(100, startWidth + deltaX);
          
          resizable.style.width = newWidth + 'px';
          // For width-only resize, let height be auto (or maintain for videos)
          if (resizable.tagName === 'IFRAME') {
            resizable.style.height = (newWidth / aspectRatio) + 'px';
          } else {
            resizable.style.height = 'auto';
          }
          
          const rect = resizable.getBoundingClientRect();
          updateResizeInfo(newWidth, rect.height);
        }
        
        function stopResize() {
          if (!isResizing) return;
          
          isResizing = false;
          wrapper.classList.remove('resizing');
          
          if (resizeInfo) {
            resizeInfo.remove();
            resizeInfo = null;
          }
          
          document.removeEventListener('mousemove', doResizeAspect);
          document.removeEventListener('mousemove', doResizeWidth);
          document.removeEventListener('mouseup', stopResize);
          
          markChanged();
        }
        
        // Corner handle - maintains aspect ratio
        handleSE.addEventListener('mousedown', (e) => startResize(e, true));
        
        // Edge handle - width only
        handleE.addEventListener('mousedown', (e) => startResize(e, false));
        
        console.log('📐 Added resize handles to:', wrapper.className);
      });
    }
    
    // ==================== Convert Existing Sections to Grid ====================
    function convertSectionsToGrid() {
      // Find sections and ensure they have a grid structure for dropping elements side-by-side
      landingContent.querySelectorAll('section').forEach(section => {
        if (section.dataset.gridConverted) return;
        section.dataset.gridConverted = 'true';
        section.style.position = 'relative';
        
        // Check if section already has a grid structure
        const existingGrid = section.querySelector('.section-grid, .section-edit-grid');
        if (existingGrid) {
          // Ensure grid columns are marked as drop zones
          existingGrid.querySelectorAll('.grid-col').forEach(col => {
            col.classList.add('drop-zone');
          });
          return;
        }
        
        // Check if section has row/col structure (Bootstrap-like)
        const existingRow = section.querySelector('.row');
        if (existingRow) {
          existingRow.querySelectorAll('[class*="col"]').forEach(col => {
            col.classList.add('drop-zone', 'grid-col');
          });
          return;
        }
        
        // For sections without grid structure, wrap content in a 2-column grid
        // Get the container or create one
        let container = section.querySelector('.container');
        if (!container) {
          // Move all section children into a container
          container = document.createElement('div');
          container.className = 'container';
          container.style.cssText = 'max-width: 1200px; margin: 0 auto; padding: 0 2rem;';
          while (section.firstChild) {
            if (section.firstChild.classList && section.firstChild.classList.contains('section-delete-btn')) {
              section.firstChild.remove();
              continue;
            }
            container.appendChild(section.firstChild);
          }
          section.appendChild(container);
        }
        
        // Create a 2-column edit grid
        const editGrid = document.createElement('div');
        editGrid.className = 'section-edit-grid';
        
        const leftCol = document.createElement('div');
        leftCol.className = 'grid-col drop-zone';
        leftCol.dataset.dropZone = 'left';
        
        const rightCol = document.createElement('div');
        rightCol.className = 'grid-col drop-zone';
        rightCol.dataset.dropZone = 'right';
        
        // Move existing content to left column
        while (container.firstChild) {
          leftCol.appendChild(container.firstChild);
        }
        
        // If right column is empty, mark it (CSS ::after will show placeholder text)
        if (rightCol.children.length === 0) {
          rightCol.classList.add('empty-col');
          // Don't add span text - CSS handles the placeholder via ::after
        }
        
        editGrid.appendChild(leftCol);
        editGrid.appendChild(rightCol);
        container.appendChild(editGrid);
      });
    }
    
    // ==================== Grid Overlay on Drag ====================
    function setupGridOverlay() {
      // Show grid overlay when dragging components (not when reordering elements)
      let isComponentDrag = false;
      
      componentPanel.addEventListener('dragstart', () => {
        isComponentDrag = true;
      });
      
      componentPanel.addEventListener('dragend', () => {
        isComponentDrag = false;
        hideAllGridOverlays();
      });
      
      landingContent.querySelectorAll('section').forEach(section => {
        if (section.dataset.overlaySetup) return;
        section.dataset.overlaySetup = 'true';
        
        section.addEventListener('dragenter', (e) => {
          if (!isComponentDrag) return;
          e.stopPropagation();
          
          // Hide other overlays
          hideAllGridOverlays();
          
          // Show this section's grid
          section.classList.add('show-grid-overlay');
        });
      });
      
      // Hide overlays when leaving content area
      landingContent.addEventListener('dragleave', (e) => {
        if (!landingContent.contains(e.relatedTarget)) {
          hideAllGridOverlays();
        }
      });
      
      contentArea.addEventListener('dragend', hideAllGridOverlays);
      contentArea.addEventListener('drop', hideAllGridOverlays);
    }
    
    function hideAllGridOverlays() {
      document.querySelectorAll('.show-grid-overlay').forEach(el => {
        el.classList.remove('show-grid-overlay');
      });
    }
    
    // ==================== Media Controls (Edit/Delete for Images & Videos) ====================
    function setupMediaControls() {
      console.log('🎬 Setting up media controls...');
      
      // STEP 1: Remove ALL existing media-controls to prevent duplication
      landingContent.querySelectorAll('.media-controls').forEach(el => el.remove());
      
      // STEP 2: Find all media elements that need controls
      
      // Handle video-wrapper elements (already a wrapper - just add controls)
      landingContent.querySelectorAll('.video-wrapper').forEach(videoWrapper => {
        console.log('🎬 Found video-wrapper');
        // Find the actual media inside (iframe or placeholder)
        const iframe = videoWrapper.querySelector('iframe');
        addMediaControlsTo(videoWrapper, iframe || videoWrapper);
      });
      
      // Handle images (skip small icons)
      landingContent.querySelectorAll('img').forEach(img => {
        // Skip tiny images and images already in a wrapper with controls
        if (img.width > 0 && img.width < 50) return;
        if (img.height > 0 && img.height < 50) return;
        
        let wrapper = img.closest('.media-wrapper');
        if (!wrapper) {
          wrapper = document.createElement('div');
          wrapper.className = 'media-wrapper';
          img.parentNode.insertBefore(wrapper, img);
          wrapper.appendChild(img);
          console.log('🎬 Wrapped img');
        }
        
        addMediaControlsTo(wrapper, img);
      });
      
      // Handle standalone iframes (YouTube/Vimeo not in video-wrapper)
      landingContent.querySelectorAll('iframe').forEach(iframe => {
        const src = iframe.src || '';
        if (!src.includes('youtube') && !src.includes('vimeo')) return;
        if (iframe.closest('.video-wrapper')) return; // Already in video wrapper
        
        let wrapper = iframe.closest('.media-wrapper');
        if (!wrapper) {
          wrapper = document.createElement('div');
          wrapper.className = 'media-wrapper';
          iframe.parentNode.insertBefore(wrapper, iframe);
          wrapper.appendChild(iframe);
          console.log('🎬 Wrapped iframe');
        }
        
        addMediaControlsTo(wrapper, iframe);
      });
      
      console.log('🎬 Media controls setup complete');
    }
    
    function addMediaControlsTo(wrapper, mediaElement) {
      const controls = document.createElement('div');
      controls.className = 'media-controls';
      controls.contentEditable = 'false';
      
      const editBtn = document.createElement('button');
      editBtn.className = 'media-btn media-btn-edit';
      editBtn.title = 'Change';
      editBtn.textContent = '✎';
      editBtn.contentEditable = 'false';
      
      const deleteBtn = document.createElement('button');
      deleteBtn.className = 'media-btn media-btn-delete';
      deleteBtn.title = 'Remove';
      deleteBtn.textContent = '✕';
      deleteBtn.contentEditable = 'false';
      
      controls.appendChild(editBtn);
      controls.appendChild(deleteBtn);
      wrapper.appendChild(controls);
      
      editBtn.onclick = function(e) {
        e.preventDefault();
        e.stopPropagation();
        console.log('✏️ EDIT clicked');
        if (mediaElement.tagName === 'IMG') {
          showImageModal(mediaElement);
        } else {
          showVideoModal(wrapper);
        }
        return false;
      };
      
      deleteBtn.onclick = function(e) {
        e.preventDefault();
        e.stopPropagation();
        console.log('🗑️ DELETE clicked');
        if (confirm('Remove this element?')) {
          wrapper.remove();
          markChanged();
        }
        return false;
      };
      
      console.log('🎬 Controls added');
    }
    
    // ==================== Image Edit Modal ====================
    let currentImageElement = null;
    
    function showImageModal(imgElement) {
      currentImageElement = imgElement;
      
      const modal = document.createElement('div');
      modal.className = 'image-modal';
      modal.innerHTML = '<div class="image-modal-content">' +
        '<h3>Change Image</h3>' +
        '<div class="image-source-buttons">' +
        '<button type="button" class="image-source-btn btn-library" data-source="library">' +
        '<span style="font-size: 24px;">📁</span><span>Media Library</span></button>' +
        '<button type="button" class="image-source-btn btn-ai" data-source="ai">' +
        '<span style="font-size: 24px;">✨</span><span>Generate with AI</span></button>' +
        '</div>' +
        '<div class="library-picker-section" id="libraryPickerSection">' +
        '<div class="library-loading">Loading images...</div></div>' +
        '<div class="ai-generate-section" id="aiGenerateSection">' +
        '<textarea id="aiImagePrompt" placeholder="Describe the image you want to generate..."></textarea>' +
        '<button type="button" class="btn-generate" id="generateImageBtn"><span>✨</span> Generate Image</button>' +
        '</div>' +
        '<div class="image-modal-divider">or enter URL</div>' +
        '<input type="text" id="imageUrlInput" placeholder="Enter image URL..." value="' + (imgElement.src || '') + '">' +
        '<input type="text" id="imageAltInput" placeholder="Alt text (optional)" value="' + (imgElement.alt || '') + '">' +
        '<div class="image-modal-buttons">' +
        '<button type="button" class="btn-cancel">Cancel</button>' +
        '<button type="button" class="btn-apply">Apply</button>' +
        '</div></div>';
      
      document.body.appendChild(modal);
      
      const urlInput = modal.querySelector('#imageUrlInput');
      const librarySection = modal.querySelector('#libraryPickerSection');
      const aiSection = modal.querySelector('#aiGenerateSection');
      let selectedLibraryImage = null;
      
      // Source button handlers
      modal.querySelectorAll('.image-source-btn').forEach(btn => {
        btn.addEventListener('click', function() {
          const source = this.dataset.source;
          
          // Reset all sections
          librarySection.classList.remove('active');
          aiSection.classList.remove('active');
          modal.querySelectorAll('.image-source-btn').forEach(b => b.style.borderStyle = 'dashed');
          
          if (source === 'library') {
            this.style.borderStyle = 'solid';
            librarySection.classList.add('active');
            loadMediaLibrary(librarySection, urlInput);
          } else if (source === 'ai') {
            this.style.borderStyle = 'solid';
            aiSection.classList.add('active');
            modal.querySelector('#aiImagePrompt').focus();
          }
        });
      });
      
      // AI Generate button handler
      modal.querySelector('#generateImageBtn').addEventListener('click', async function() {
        const prompt = modal.querySelector('#aiImagePrompt').value.trim();
        if (!prompt) {
          alert('Please describe the image you want to generate');
          return;
        }
        
        const btn = this;
        const originalText = btn.innerHTML;
        btn.innerHTML = '<span class="spin">⏳</span> Generating...';
        btn.disabled = true;
        
        try {
          // Call Nano Banana API for image generation
          const response = await fetch('/api/image_assets/generate', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]')?.content || ''
            },
            body: JSON.stringify({ prompt: prompt })
          });
          
          if (response.ok) {
            const data = await response.json();
            if (data.image_url) {
              urlInput.value = data.image_url;
              // Auto-apply if generation was successful
              currentImageElement.src = data.image_url;
              modal.querySelector('#imageAltInput').value = prompt.substring(0, 100);
              markChanged();
              modal.remove();
              return;
            }
          }
          
          throw new Error('Failed to generate image');
        } catch (err) {
          console.error('Image generation error:', err);
          alert('Image generation failed. Please try again or use a URL instead.');
        } finally {
          btn.innerHTML = originalText;
          btn.disabled = false;
        }
      });
      
      modal.querySelector('.btn-cancel').addEventListener('click', () => modal.remove());
      modal.querySelector('.btn-apply').addEventListener('click', () => {
        const newUrl = urlInput.value.trim();
        const newAlt = modal.querySelector('#imageAltInput').value.trim();
        
        if (newUrl) {
          currentImageElement.src = newUrl;
          if (newAlt) currentImageElement.alt = newAlt;
          markChanged();
        }
        modal.remove();
      });
      
      // Close on backdrop click
      modal.addEventListener('click', (e) => {
        if (e.target === modal) modal.remove();
      });
      
      // Close on Escape
      document.addEventListener('keydown', function escHandler(e) {
        if (e.key === 'Escape') {
          modal.remove();
          document.removeEventListener('keydown', escHandler);
        }
      });
    }
    
    // Load images from Media Library
    async function loadMediaLibrary(container, urlInput) {
      try {
        const response = await fetch('/image_assets.json', {
          headers: { 'Accept': 'application/json' }
        });
        
        if (!response.ok) throw new Error('Failed to load library');
        
        const data = await response.json();
        const images = data.image_assets || data || [];
        
        if (images.length === 0) {
          container.innerHTML = '<div class="library-empty">' +
            '<p>No images in your library yet.</p>' +
            '<p style="font-size: 12px; margin-top: 8px;">Upload images via the Media Library canvas.</p>' +
            '</div>';
          return;
        }
        
        let html = '<div class="library-images-grid">';
        images.forEach(img => {
          const url = img.url || img.file_url || (img.file && img.file.url);
          const name = img.name || img.filename || 'Image';
          if (url) {
            html += '<div class="library-image-item" data-url="' + url + '" data-name="' + name + '" title="' + name + '">' +
              '<img src="' + url + '" alt="' + name + '" loading="lazy">' +
              '</div>';
          }
        });
        html += '</div>';
        
        container.innerHTML = html;
        
        // Add click handlers
        container.querySelectorAll('.library-image-item').forEach(item => {
          item.addEventListener('click', function() {
            container.querySelectorAll('.library-image-item').forEach(i => i.classList.remove('selected'));
            this.classList.add('selected');
            urlInput.value = this.dataset.url;
          });
          
          // Double-click to apply immediately
          item.addEventListener('dblclick', function() {
            urlInput.value = this.dataset.url;
            const modal = container.closest('.image-modal');
            const altInput = modal.querySelector('#imageAltInput');
            if (!altInput.value) altInput.value = this.dataset.name;
            modal.querySelector('.btn-apply').click();
          });
        });
        
      } catch (err) {
        console.error('Error loading media library:', err);
        container.innerHTML = '<div class="library-empty">' +
          '<p>Could not load media library.</p>' +
          '<p style="font-size: 12px; margin-top: 8px;">Please enter a URL manually.</p>' +
          '</div>';
      }
    }
    
    // ==================== Full Re-initialization ====================
    let isReinitializing = false; // Flag to prevent infinite loops
    
    function reinitializeAll() {
      if (isReinitializing) {
        console.log('⏸️ Already reinitializing, skipping');
        return;
      }
      isReinitializing = true;
      console.log('🔄 reinitializeAll: Starting...');
      
      try {
        // 0. Clean up any empty-col classes on columns that have content
        landingContent.querySelectorAll('.empty-col').forEach(col => {
          const hasRealContent = col.querySelector('div, section, h1, h2, h3, h4, h5, h6, p, img, video, iframe, form, button, .video-wrapper, .media-wrapper');
          if (hasRealContent) {
            console.log('🔄 Removing empty-col from column with content');
            col.classList.remove('empty-col');
            col.classList.add('has-content');
          }
        });
        
        // 1. Convert structure
        console.log('🔄 Step 1: convertSectionsToGrid');
        convertSectionsToGrid();
        
        // 2. Setup wrappers and controls (Must be before drag setup!)
        console.log('🔄 Step 2: setupMediaControls');
        setupMediaControls();
        console.log('🔄 Step 2: setupResizeHandles');
        setupResizeHandles();
        
        // 3. Setup editing and features
        console.log('🔄 Step 3: initializeEditing');
        initializeEditing();
        console.log('🔄 Step 3: setupTextToolbar');
        setupTextToolbar();
        console.log('🔄 Step 3: addDeleteButtons');
        addDeleteButtons();
        console.log('🔄 Step 3: setupVideoEditing');
        setupVideoEditing();
        console.log('🔄 Step 3: setupDropZones');
        setupDropZones();
        
        // 4. Setup dragging (Now finds the wrappers created in step 2)
        console.log('🔄 Step 4: setupElementDragging');
        setupElementDragging();
        console.log('🔄 Step 4: setupDropTargets');
        setupDropTargets();
        console.log('🔄 Step 4: setupGridOverlay');
        setupGridOverlay();
        
        console.log('✅ reinitializeAll: Complete!');
      } catch (err) {
        console.error('❌ reinitializeAll error:', err);
      }
      
      isReinitializing = false;
    }
    
    // ==================== Initialize ====================
    // Debug drag listener to see all drag events
    document.addEventListener('dragstart', (e) => {
      console.log('🌐 GLOBAL DRAGSTART:', e.target.tagName, e.target.className);
      console.log('🌐 Body is-dragging?', document.body.classList.contains('is-dragging'));
    }, true);
    
    document.addEventListener('drag', (e) => {
      // Only log once per second to avoid spam
      if (!window._lastDragLog || Date.now() - window._lastDragLog > 1000) {
        console.log('🌐 DRAGGING... body.is-dragging:', document.body.classList.contains('is-dragging'));
        window._lastDragLog = Date.now();
      }
    }, true);
    
    // Global dragover to see if any dragover events fire at all
    document.addEventListener('dragover', (e) => {
      if (!window._lastDragoverLog || Date.now() - window._lastDragoverLog > 500) {
        console.log('🌐 GLOBAL DRAGOVER on:', e.target.tagName, e.target.className?.substring?.(0, 30) || '');
        window._lastDragoverLog = Date.now();
      }
    }, true);

    // Global dragover handler to allow drops on the content area
    landingContent.addEventListener('dragover', function(e) {
      if (globalDraggedElement) {
        e.preventDefault();
        e.dataTransfer.dropEffect = 'move';
      }
    });
    
    // Global drop handler as fallback
    landingContent.addEventListener('drop', function(e) {
      if (globalDraggedElement) {
        e.preventDefault();
        console.log('📥 Fallback drop on landingContent');
        // Just append to the section the element was dragged from
        const draggedEl = globalDraggedElement;
        draggedEl.style.opacity = '1';
        draggedEl.classList.remove('being-dragged');
        globalDraggedElement = null;
        document.body.classList.remove('is-dragging');
        document.querySelectorAll('.drop-indicator, .drop-indicator-h').forEach(i => i.remove());
        document.querySelectorAll('.drag-over').forEach(c => c.classList.remove('drag-over'));
      }
    });
    
    try {
      console.log('🎨 Iframe: Calling reinitializeAll...');
      reinitializeAll();
      console.log('🎨 Iframe: reinitializeAll completed successfully');
    } catch (initError) {
      console.error('🔴 Iframe: Error in reinitializeAll:', initError);
    }
    
    // Re-run setup when new content is added (debounced)
    // But skip if we're in the middle of a drag operation or reinitializing
    let reinitTimeout = null;
    // Note: isReinitializing is declared above in reinitializeAll section
    
    const observer = new MutationObserver((mutations) => {
      // Don't reinitialize during drag - it interferes with drag/drop
      if (document.body.classList.contains('is-dragging')) {
        return;
      }
      if (globalDraggedElement) {
        return;
      }
      // Don't reinitialize while already reinitializing (prevents infinite loop)
      if (isReinitializing) {
        return;
      }
      
      // Only trigger reinit for "real" content changes, not our internal changes
      // Check if any mutation is NOT just adding our internal elements
      const isRealChange = mutations.some(m => {
        for (const node of m.addedNodes) {
          if (node.nodeType === 1) { // Element node
            const isInternal = node.classList?.contains('drag-handle') ||
                              node.classList?.contains('media-controls') ||
                              node.classList?.contains('resize-handle') ||
                              node.classList?.contains('section-delete-btn') ||
                              node.classList?.contains('element-delete-btn') ||
                              node.classList?.contains('drop-indicator') ||
                              node.classList?.contains('drop-indicator-h');
            if (!isInternal) return true; // This is a real change
          }
        }
        return false;
      });
      
      if (!isRealChange) {
        return; // Skip reinit for internal changes
      }
      
      console.log('🔄 Content changed, scheduling reinit');
      if (reinitTimeout) clearTimeout(reinitTimeout);
      reinitTimeout = setTimeout(reinitializeAll, 200);
    });
    observer.observe(landingContent, { childList: true, subtree: true });
    
    console.log('🎨 Landing Page Editor (iframe) initialized');
    console.log('📝 landingContent element:', landingContent);
    console.log('📝 contentArea element:', contentArea);
    console.log('📝 componentPanel element:', componentPanel);
    console.log('📝 Number of component items:', document.querySelectorAll('.component-item').length);
    console.log('✅ Iframe script execution complete');
  </scr` + `ipt>
</body>
</html>
  `;
  
  console.log('📄 iframeContent built successfully, length:', iframeContent.length);
  console.log('📄 iframeContent contains script?', iframeContent.includes('<script>'));
  console.log('📄 iframeContent contains reinitializeAll?', iframeContent.includes('reinitializeAll'));
  
  // Write to iframe
  console.log('📄 Writing to iframe.srcdoc...');
  iframe.srcdoc = iframeContent;
  console.log('📄 iframe.srcdoc written');
  
  // Send theme to iframe after it loads
  iframe.addEventListener('load', function() {
    console.log('📄 Iframe load event fired');
    const currentTheme = document.documentElement.getAttribute('data-theme') || 'dark';
    console.log('🎨 Landing Page Editor: Sending theme to iframe:', currentTheme);
    try {
      iframe.contentWindow.postMessage({ type: 'theme-change', theme: currentTheme }, '*');
      
      // Check if iframe has any error
      try {
        const iframeDoc = iframe.contentDocument || iframe.contentWindow.document;
        console.log('📄 Iframe document title:', iframeDoc.title);
        console.log('📄 Iframe body children:', iframeDoc.body?.children?.length || 0);
        
        // Check for console errors in iframe
        const scripts = iframeDoc.querySelectorAll('script');
        console.log('📄 Iframe script tags:', scripts.length);
      } catch (docErr) {
        console.log('📄 Cannot access iframe document:', docErr.message);
      }
    } catch (e) {
      console.log('Could not send theme to iframe:', e);
    }
  });
  
  // ==================== Parent-Side Handlers ====================
  
  window.addEventListener('message', async (e) => {
    if (e.data.type === 'changed') {
      saveBtn.disabled = false;
    } else if (e.data.type === 'content') {
      await doSave(e.data.html);
    } else if (e.data.type === 'save') {
      if (e.data.force) {
        iframe.contentWindow.postMessage({ type: 'getContent' }, '*');
      }
    }
  });
  
  async function doSave(html) {
    saveBtn.disabled = true;
    saveBtn.innerHTML = '<i data-lucide="loader-2" class="spin"></i><span>Saving...</span>';
    if (typeof lucide !== 'undefined') lucide.createIcons();
    
    // Get the selected font
    const fontSelector = document.getElementById('pageFontSelector');
    const selectedFont = fontSelector ? fontSelector.value : '';
    
    // Build save data including font metadata
    const saveData = { 
      landing_page: { 
        html_content: html 
      } 
    };
    
    // Add font to metadata if selected
    if (selectedFont) {
      saveData.landing_page.metadata = { page_font: selectedFont };
    }
    
    try {
      const response = await fetch(`/landing_pages/${pageSlug}`, {
        method: 'PATCH',
        headers: {
          'Content-Type': 'application/json',
          'Accept': 'application/json',
          'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]')?.content
        },
        body: JSON.stringify(saveData)
      });
      
      if (response.ok) {
        saveBtn.innerHTML = '<i data-lucide="check"></i><span>Saved!</span>';
        setTimeout(() => {
          saveBtn.innerHTML = '<i data-lucide="save"></i><span>Save</span>';
          saveBtn.disabled = true;
          if (typeof lucide !== 'undefined') lucide.createIcons();
        }, 2000);
        
        if (window.scoutShowNotification) {
          window.scoutShowNotification('Changes saved!', 'success');
        }
      } else {
        throw new Error('Save failed');
      }
    } catch (err) {
      console.error('Save error:', err);
      saveBtn.innerHTML = '<i data-lucide="save"></i><span>Save</span>';
      saveBtn.disabled = false;
      if (window.scoutShowNotification) {
        window.scoutShowNotification('Failed to save', 'error');
      }
    }
    
    if (typeof lucide !== 'undefined') lucide.createIcons();
  }
  
  saveBtn?.addEventListener('click', () => {
    iframe.contentWindow.postMessage({ type: 'getContent' }, '*');
  });
  
  toggleCodeBtn?.addEventListener('click', () => {
    isCodeView = !isCodeView;
    
    if (isCodeView) {
      iframe.contentWindow.postMessage({ type: 'getContent' }, '*');
      setTimeout(() => {
        mainView.style.display = 'none';
        codeView.style.display = 'block';
      }, 100);
    } else {
      mainView.style.display = 'block';
      codeView.style.display = 'none';
    }
  });
  
  historyBtn?.addEventListener('click', () => {
    if (window.scoutLoadCanvas) {
      window.scoutLoadCanvas('landing_page_versions', { landing_page_id: pageId });
    }
  });
  
  publishBtn?.addEventListener('click', async () => {
    if (!confirm('Publish this landing page?')) return;
    
    publishBtn.disabled = true;
    publishBtn.innerHTML = '<i data-lucide="loader-2" class="spin"></i><span>Publishing...</span>';
    if (typeof lucide !== 'undefined') lucide.createIcons();
    
    try {
      const response = await fetch(`/landing_pages/${pageSlug}/publish`, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]')?.content
        }
      });
      
      if (response.ok) {
        publishBtn.innerHTML = '<i data-lucide="check"></i><span>Published!</span>';
        if (window.scoutShowNotification) {
          window.scoutShowNotification('Landing page published!', 'success');
        }
        
        setTimeout(() => {
          if (window.scoutLoadCanvas) {
            window.scoutLoadCanvas('landing_page_editor', { landing_page_id: pageId });
          }
        }, 1500);
      } else {
        throw new Error('Publish failed');
      }
    } catch (err) {
      console.error('Publish error:', err);
      publishBtn.innerHTML = '<i data-lucide="globe"></i><span>Publish</span>';
      publishBtn.disabled = false;
    }
    
    if (typeof lucide !== 'undefined') lucide.createIcons();
  });
  
  const titleEl = document.getElementById('editablePageTitle');
  if (titleEl) {
    titleEl.addEventListener('blur', async () => {
      const newTitle = titleEl.textContent.trim();
      if (newTitle && newTitle !== titleEl.dataset.original) {
        try {
          await fetch(`/landing_pages/${pageSlug}`, {
            method: 'PATCH',
            headers: {
              'Content-Type': 'application/json',
              'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]')?.content
            },
            body: JSON.stringify({ landing_page: { title: newTitle } })
          });
          titleEl.dataset.original = newTitle;
        } catch (err) {
          console.error('Title save error:', err);
        }
      }
    });
  }
  
  document.addEventListener('keydown', (e) => {
    if ((e.ctrlKey || e.metaKey) && e.key === 's') {
      e.preventDefault();
      if (!saveBtn.disabled) {
        iframe.contentWindow.postMessage({ type: 'getContent' }, '*');
      }
    }
  });
  
  // Back button handler
  const backBtn = document.getElementById('backToAssetsBtn');
  if (backBtn) {
    backBtn.addEventListener('click', function() {
      // Dispatch event to load the Created Assets canvas
      const evt = new CustomEvent('scout:load-canvas', { 
        detail: { canvas: 'my_creations', data: {} } 
      });
      document.dispatchEvent(evt);
    });
  }
  
  // Font selector handler
  const fontSelector = document.getElementById('pageFontSelector');
  if (fontSelector) {
    // Initialize from saved metadata (if exists)
    const pageFont = '<%= landing_page.metadata&.dig("page_font") || "" %>';
    if (pageFont) {
      fontSelector.value = pageFont;
      // Load the font immediately
      loadGoogleFont(pageFont);
      // Apply to iframe when it's ready
      iframe.addEventListener('load', () => {
        applyFontToIframe(pageFont);
      });
      // Apply now if iframe is already loaded
      if (iframe.contentDocument && iframe.contentDocument.body) {
        applyFontToIframe(pageFont);
      }
    }
    
    fontSelector.addEventListener('change', function() {
      const selectedFont = this.value;
      console.log('🔤 Font selected:', selectedFont);
      
      if (selectedFont) {
        loadGoogleFont(selectedFont);
        applyFontToIframe(selectedFont);
      } else {
        // Remove custom font
        applyFontToIframe(null);
      }
      
      // Mark as changed
      hasChanges = true;
      saveBtn.disabled = false;
    });
  }
  
  // Load Google Font dynamically
  function loadGoogleFont(fontName) {
    if (!fontName) return;
    
    const fontId = 'gfont-' + fontName.replace(/\s+/g, '-').toLowerCase();
    
    // Check if already loaded
    if (document.getElementById(fontId)) return;
    
    const link = document.createElement('link');
    link.id = fontId;
    link.rel = 'stylesheet';
    link.href = `https://fonts.googleapis.com/css2?family=${encodeURIComponent(fontName)}:wght@300;400;500;600;700;800;900&display=swap`;
    document.head.appendChild(link);
    
    // Also inject into iframe
    if (iframe.contentDocument && iframe.contentDocument.head) {
      const iframeLink = link.cloneNode();
      iframeLink.id = fontId + '-iframe';
      if (!iframe.contentDocument.getElementById(iframeLink.id)) {
        iframe.contentDocument.head.appendChild(iframeLink);
      }
    }
  }
  
  // Apply font to iframe content
  function applyFontToIframe(fontName) {
    if (!iframe.contentDocument) return;
    
    const landingContent = iframe.contentDocument.getElementById('landingContent');
    if (!landingContent) return;
    
    const styleId = 'page-font-style';
    let styleEl = iframe.contentDocument.getElementById(styleId);
    
    if (!styleEl) {
      styleEl = iframe.contentDocument.createElement('style');
      styleEl.id = styleId;
      iframe.contentDocument.head.appendChild(styleEl);
    }
    
    if (fontName) {
      // Apply font with high priority, but allow specific elements to override
      styleEl.textContent = `
        #landingContent, 
        #landingContent * {
          font-family: '${fontName}', sans-serif !important;
        }
        /* Allow icons to keep their font */
        #landingContent i[class*="fa-"],
        #landingContent [class*="icon"],
        #landingContent .material-icons {
          font-family: inherit !important;
        }
      `;
      console.log('🔤 Applied font to landing page:', fontName);
    } else {
      styleEl.textContent = '';
      console.log('🔤 Removed custom font from landing page');
    }
  }
  
  
  console.log('🎨 Landing Page Editor (parent) initialized');
})();
</script>
