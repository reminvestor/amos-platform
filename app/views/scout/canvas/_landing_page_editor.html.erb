            console.log('🎨 Iframe: Parent theme detected:', parentTheme);
          } catch (accessError) {
            console.log('🎨 Iframe: Cannot access parent (cross-origin), using fallback');
          }
          
          if (parentTheme === 'light') {
            applyLightMode();
          }
        }
        
        // Fallback: check prefers-color-scheme
        if (!document.body.classList.contains('light-mode')) {
          if (window.matchMedia && window.matchMedia('(prefers-color-scheme: light)').matches) {
            console.log('🎨 Iframe: System prefers light mode');
            applyLightMode();
