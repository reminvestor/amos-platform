<%# Landing Page Editor - Iframe with Embedded Component Panel %>
<%# Perfect CSS isolation + native drag-and-drop %>

<div class="landing-page-editor canvas-container" 
     data-page-id="<%= landing_page.id %>" 
     data-page-slug="<%= landing_page.slug %>"
     id="lpEditorContainer">
  
  <!-- Toolbar (in parent) -->
  <div class="editor-toolbar">
    <div class="editor-toolbar-left">
      <button type="button" class="editor-btn back-btn" id="backToAssetsBtn" title="Back to Created Assets">
        <i data-lucide="arrow-left" style="width: 16px; height: 16px;"></i>
      </button>
      <span id="editablePageTitle" 
            contenteditable="true" 
            spellcheck="false"
            class="editable-title"
            data-original="<%= landing_page.title %>"><%= landing_page.title %></span>
      <span class="editor-status" id="editorStatus">
        <% if landing_page.status == 'published' %>
          <span class="status-badge status-published">Published</span>
        <% else %>
          <span class="status-badge status-draft">Draft</span>
        <% end %>
      </span>
    </div>
    <div class="editor-toolbar-right">
      <button type="button" id="toggleHtmlView" class="editor-btn" title="View HTML">
        <i data-lucide="code"></i>
      </button>
      <button type="button" id="versionHistoryBtn" class="editor-btn" title="Version History">
        <i data-lucide="history"></i>
      </button>
      <button type="button" id="saveChangesBtn" class="editor-btn editor-btn-save" disabled title="Save Changes">
        <i data-lucide="save"></i>
        <span>Save</span>
      </button>
      <a href="<%= preview_landing_page_path(landing_page) %>" target="_blank" class="editor-btn" title="Preview">
        <i data-lucide="eye"></i>
      </a>
      <% if landing_page.status == 'published' %>
        <a href="<%= landing_page.full_url %>" target="_blank" class="editor-btn" title="View Live">
          <i data-lucide="external-link"></i>
        </a>
      <% else %>
        <button type="button" id="publishBtn" class="editor-btn editor-btn-publish" title="Publish">
          <i data-lucide="globe"></i>
          <span>Publish</span>
        </button>
      <% end %>
    </div>
  </div>

  <!-- Main Editor (iframe) -->
  <div class="editor-main">
    <iframe id="editorFrame" class="editor-iframe"></iframe>
  </div>
  
  <!-- Code View (hidden by default) -->
  <div class="editor-code" id="editorCode" style="display: none;">
    <textarea id="htmlCodeEditor" spellcheck="false"><%= landing_page.html_content %></textarea>
  </div>
</div>

<style>
  .landing-page-editor {
    display: flex;
    flex-direction: column;
    height: 100%;
    background: var(--bg-primary);
  }
  
  .editor-toolbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.5rem 1rem;
    background: var(--bg-secondary);
    border-bottom: 1px solid var(--border-primary);
    flex-shrink: 0;
  }
  
  .editor-toolbar-left {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  
  .back-btn {
    background: transparent;
    border: 1px solid var(--border-primary);
    color: var(--text-muted);
    padding: 0.375rem 0.5rem;
  }
  
  .back-btn:hover {
    background: var(--bg-tertiary);
    color: var(--text-primary);
  }
  

  .editable-title {
    font-size: 1rem;
    font-weight: 600;
    color: var(--text-primary);
    padding: 0.25rem 0.5rem;
    border-radius: 4px;
    outline: none;
    min-width: 100px;
  }
  
  .editable-title:hover {
    background: rgba(255,255,255,0.05);
  }
  
  .editable-title:focus {
    background: rgba(255,255,255,0.1);
    box-shadow: 0 0 0 2px var(--design-accent, #ec4899);
  }
  
  .editor-status {
    display: flex;
    align-items: center;
  }
  
  .status-badge {
    font-size: 0.75rem;
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
    font-weight: 500;
  }
  
  .status-published {
    background: rgba(34, 197, 94, 0.2);
    color: #4ade80;
  }
  
  .status-draft {
    background: rgba(251, 191, 36, 0.2);
    color: #fbbf24;
  }
  
  .editor-toolbar-right {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  
  .editor-btn {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0.375rem 0.625rem;
    border: 1px solid var(--border-primary);
    border-radius: 6px;
    background: transparent;
    color: var(--text-muted);
    cursor: pointer;
    transition: all 0.15s;
    text-decoration: none;
    font-size: 0.875rem;
  }
  
  .editor-btn:hover {
    background: rgba(255,255,255,0.05);
    color: var(--text-primary);
    border-color: var(--text-muted);
  }
  
  .editor-btn i {
    width: 16px;
    height: 16px;
  }
  
  .editor-btn-save {
    background: var(--design-accent, #ec4899);
    border-color: var(--design-accent, #ec4899);
    color: white;
  }
  
  .editor-btn-save:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }
  
  .editor-btn-save:not(:disabled):hover {
    filter: brightness(1.1);
  }
  
  .editor-btn-publish {
    background: linear-gradient(135deg, #22c55e, #16a34a);
    border-color: #22c55e;
    color: white;
  }
  
  .editor-main {
    flex: 1;
    overflow: hidden;
    position: relative;
  }
  
  .editor-iframe {
    width: 100%;
    height: 100%;
    border: none;
    border-radius: 0; /* No rounded corners for editor */
    background: white;
  }
  
  .editor-code {
    flex: 1;
    overflow: hidden;
  }
  
  .editor-code textarea {
    width: 100%;
    height: 100%;
    padding: 1rem;
    border: none;
    background: #1a1a2e;
    color: #e0e0e0;
    font-family: 'Menlo', 'Monaco', 'Courier New', monospace;
    font-size: 14px;
    line-height: 1.5;
    resize: none;
  }
  
  .editor-code textarea:focus {
    outline: none;
  }
  
  @keyframes spin {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }
  
  .spin {
    animation: spin 1s linear infinite;
  }
  
  /* Light mode */
  [data-theme="light"] .landing-page-editor-container {
    background: #f8f9fa;
  }
  
  [data-theme="light"] .editor-toolbar {
    background: #ffffff;
    border-color: #e5e7eb;
  }
  
  [data-theme="light"] .editable-title {
    color: #1a1a2e;
    background: #f3f4f6;
  }
  
  [data-theme="light"] .editable-title:focus,
  [data-theme="light"] .editable-title:hover {
    background: #e5e7eb;
  }
  
  [data-theme="light"] .editor-btn {
    border-color: #e5e7eb;
    color: #6b7280;
  }
  
  [data-theme="light"] .editor-btn:hover {
    background: #f3f4f6;
    color: #1a1a2e;
  }
  
  [data-theme="light"] .font-selector {
    background: #f3f4f6;
    border-color: #e5e7eb;
    color: #1a1a2e;
  }
  
  [data-theme="light"] .font-selector:hover {
    border-color: #ec4899;
  }
  
  [data-theme="light"] .font-selector option {
    background: #ffffff;
    color: #1a1a2e;
  }
  
  [data-theme="light"] .editor-btn-save:not(:disabled) {
    background: linear-gradient(135deg, #22c55e 0%, #16a34a 100%);
  }
  
  [data-theme="light"] .html-viewer-container {
    background: #1e1e2e;
  }
  
  [data-theme="light"] .iframe-container {
    background: #ffffff;
  }
</style>

<script>
(function() {
  const container = document.getElementById('lpEditorContainer');
  if (!container || container.dataset.initialized) return;
  container.dataset.initialized = 'true';
  
  const pageId = container.dataset.pageId;
  const pageSlug = container.dataset.pageSlug;
  const iframe = document.getElementById('editorFrame');
  const saveBtn = document.getElementById('saveChangesBtn');
  const codeEditor = document.getElementById('htmlCodeEditor');
  const toggleCodeBtn = document.getElementById('toggleHtmlView');
  const publishBtn = document.getElementById('publishBtn');
  const historyBtn = document.getElementById('versionHistoryBtn');
  const codeView = document.getElementById('editorCode');
  const mainView = document.querySelector('.editor-main');
  let isCodeView = false;
  
  // Landing page content - stored as JSON, then escaped for template literal
  // Step 1: Ruby outputs valid JSON string
  // Step 2: JavaScript escapes for template literal use
  <%
    default_content = '<section style="padding: 4rem 2rem; text-align: center; background: linear-gradient(135deg, #1a1a2e, #16213e);"><h1 style="color: white; font-size: 2.5rem;">Your Landing Page</h1><p style="color: rgba(255,255,255,0.7);">Start adding components from the left panel</p></section>'
    page_html = landing_page.html_content.presence || default_content
    
    # Extract external script URLs from the content (we'll add them to iframe head)
    external_scripts = page_html.scan(/<script[^>]+src=["']([^"']+)["'][^>]*>/i).flatten
    
    # Remove ALL script tags from editable content - they break the editor
    # External scripts will be added to the iframe's <head> section
    # Inline scripts are not safe in the editor context
    safe_html = page_html.gsub(/<script\b[^>]*>[\s\S]*?<\/script>/im, '<!-- script removed for editor -->')
  %>
  const rawPageContent = <%= raw safe_html.to_json %>;
  
  console.log('📄 Raw page content length:', rawPageContent.length);
  console.log('📄 Raw page content first 200 chars:', rawPageContent.substring(0, 200));
  
  // Escape for template literal: backticks and ${} interpolation
  // Note: Backslashes are already escaped by JSON.stringify
  const pageContent = rawPageContent
    .replace(/`/g, '\\`')
    .replace(/\$\{/g, '\\${');
  
  console.log('📄 Escaped page content length:', pageContent.length);
  
  // External scripts extracted from landing page (will be added to iframe head)
  const externalScripts = <%= raw external_scripts.to_json %>;
  console.log('📄 External scripts found:', externalScripts.length, externalScripts);
  
  // Build script tags for external scripts
  const externalScriptTags = externalScripts.map(src => 
    '<scr' + 'ipt src="' + src + '"></scr' + 'ipt>'
  ).join('\n  ');
  
  // Build iframe content with embedded component panel
  console.log('📄 Building iframe content...');
  const iframeContent = `
<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Inter:wght@400;500;600;700&family=Lato:wght@400;700&family=Merriweather:wght@400;700&family=Montserrat:wght@400;500;600;700&family=Open+Sans:wght@400;600;700&family=Oswald:wght@400;500;600;700&family=Playfair+Display:wght@400;500;600;700&family=Poppins:wght@400;500;600;700&family=Raleway:wght@400;500;600;700&family=Roboto:wght@400;500;700&display=swap" rel="stylesheet">
  ${externalScriptTags}
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    
    body {
      display: flex;
      height: 100vh;
      overflow: hidden;
    }
    
    /* Component Panel - 2-column grid like design panel */
    .component-panel {
      width: 200px;
      background: #1a1a2e;
      border-right: 1px solid #2d2d44;
      display: flex;
      flex-direction: column;
      flex-shrink: 0;
      overflow-y: auto;
      position: relative;
      z-index: 10000; /* Ensure panel stays above landing page content */
    }
    
    .panel-header {
      padding: 0.625rem 0.75rem;
      border-bottom: 1px solid #2d2d44;
      background: #0f0f1a;
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }
    
    .panel-header-icon { font-size: 14px; }
    
    .panel-header-text {
      color: #ec4899;
      font-size: 0.75rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }
    
    .component-group {
      padding: 0.5rem;
      border-bottom: 1px solid #2d2d44;
    }
    
    .component-group-title {
      color: #888;
      font-size: 0.625rem;
      font-weight: 600;
      text-transform: uppercase;
      padding: 0.25rem 0.25rem 0.5rem;
      letter-spacing: 0.05em;
    }
    
    .component-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 0.375rem;
    }
    
    .component-item {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.25rem;
      padding: 0.5rem 0.25rem;
      color: #a0a0b0;
      font-size: 0.625rem;
      border: 1px solid #2d2d44;
      border-radius: 6px;
      background: #252536;
      cursor: grab;
      transition: all 0.15s;
      user-select: none;
      text-align: center;
    }
    
    .component-item:hover {
      background: rgba(236, 72, 153, 0.15);
      border-color: #ec4899;
      color: #ec4899;
    }
    
    .component-item:active {
      cursor: grabbing;
      transform: scale(0.95);
    }
    
    .component-item.dragging {
      opacity: 0.5;
      border-color: #ec4899;
    }
    
    .component-icon { font-size: 16px; line-height: 1; }
    .component-name { line-height: 1.2; }
    
    /* Font Selector in Component Panel */
    .font-selector-wrapper {
      margin-bottom: 0.5rem;
    }
    
    .font-label {
      display: block;
      color: #888;
      font-size: 0.625rem;
      margin-bottom: 0.25rem;
    }
    
    .font-select {
      width: 100%;
      padding: 0.375rem 0.5rem;
      background: #252536;
      border: 1px solid #2d2d44;
      border-radius: 4px;
      color: #a0a0b0;
      font-size: 0.75rem;
      cursor: pointer;
    }
    
    .font-select:hover {
      border-color: #ec4899;
    }
    
    .font-select:focus {
      outline: none;
      border-color: #ec4899;
    }
    
    .font-select option {
      background: #1a1a2e;
      color: #a0a0b0;
    }
    
    /* Light Mode - Component Panel */
    body.light-mode .component-panel,
    body[data-theme="light"] .component-panel {
      background: #f8f9fa;
      border-right-color: #e0e0e0;
    }
    
    body.light-mode .panel-header,
    body[data-theme="light"] .panel-header {
      background: #f0f0f0;
      border-bottom-color: #e0e0e0;
    }
    
    body.light-mode .component-group,
    body[data-theme="light"] .component-group {
      border-bottom-color: #e0e0e0;
    }
    
    body.light-mode .component-group-title,
    body[data-theme="light"] .component-group-title {
      color: #666;
    }
    
    body.light-mode .component-item,
    body[data-theme="light"] .component-item {
      background: #fff;
      border-color: #e0e0e0;
      color: #555;
    }
    
    body.light-mode .component-item:hover,
    body[data-theme="light"] .component-item:hover {
      background: rgba(236, 72, 153, 0.1);
      border-color: #ec4899;
      color: #ec4899;
    }
    
    body.light-mode .font-label,
    body[data-theme="light"] .font-label {
      color: #666;
    }
    
    body.light-mode .font-select,
    body[data-theme="light"] .font-select {
      background: #fff;
      border-color: #d0d0d0;
      color: #333;
    }
    
    body.light-mode .font-select option,
    body[data-theme="light"] .font-select option {
      background: #fff;
      color: #333;
    }
    
    /* Content Area - FULL WIDTH */
    .content-area {
      flex: 1;
      overflow-y: auto;
      background: white;
      position: relative;
      z-index: 1; /* Lower z-index so component panel stays on top */
      isolation: isolate; /* Create stacking context to contain child z-indexes */
    }
    
    /* Ensure landing page nav/header doesn't bleed over component panel */
    .content-area nav,
    .content-area header,
    .content-area .navbar,
    .content-area [class*="nav"],
    .content-area [class*="header"] {
      position: relative !important;
      z-index: 100 !important; /* High within content area but contained by isolation */
    }
    
    .landing-content { min-height: 100%; }
    
    /* Drag & Drop States */
    .content-area.drag-over {
      box-shadow: inset 0 0 0 3px rgba(236, 72, 153, 0.3);
    }
    
    .drop-target {
      outline: 2px dashed #ec4899 !important;
      outline-offset: -2px;
    }
    
    .just-inserted {
      animation: insertPulse 1s ease-out;
    }
    
    @keyframes insertPulse {
      0% { box-shadow: 0 0 0 4px rgba(236, 72, 153, 0.6); }
      100% { box-shadow: none; }
    }
    
    /* Editable Elements */
    [contenteditable="true"] { 
      outline: none; 
      cursor: text;
      transition: background-color 0.15s, box-shadow 0.15s;
    }
    [contenteditable="true"]:hover {
      background-color: rgba(236, 72, 153, 0.08);
      box-shadow: inset 0 0 0 1px rgba(236, 72, 153, 0.3);
    }
    [contenteditable="true"]:focus {
      background-color: rgba(236, 72, 153, 0.12);
      box-shadow: inset 0 -2px 0 0 rgba(236, 72, 153, 0.5);
    }
    
    /* Floating Text Toolbar */
    .text-toolbar {
      position: fixed;
      display: none;
      background: #1a1a2e;
      border: 1px solid #2d2d44;
      border-radius: 8px;
      padding: 4px;
      gap: 2px;
      z-index: 10001;
      box-shadow: 0 4px 16px rgba(0,0,0,0.4);
      flex-direction: row;
      align-items: center;
    }
    
    .text-toolbar.visible {
      display: flex;
    }
    
    .text-toolbar-btn {
      width: 32px;
      height: 32px;
      display: flex;
      align-items: center;
      justify-content: center;
      background: transparent;
      border: none;
      color: #a0a0b0;
      border-radius: 4px;
      cursor: pointer;
      font-size: 14px;
      font-weight: 600;
      transition: all 0.15s;
    }
    
    .text-toolbar-btn:hover {
      background: rgba(236, 72, 153, 0.2);
      color: #ec4899;
    }
    
    .text-toolbar-btn.active {
      background: #ec4899;
      color: white;
    }
    
    .text-toolbar-divider {
      width: 1px;
      height: 20px;
      background: #2d2d44;
      margin: 0 4px;
    }
    
    .text-toolbar-link-input {
      display: none;
      padding: 6px 10px;
      background: #252536;
      border: 1px solid #2d2d44;
      border-radius: 4px;
      color: white;
      font-size: 12px;
      width: 200px;
      margin-left: 4px;
    }
    
    .text-toolbar-link-input:focus {
      outline: none;
      border-color: #ec4899;
    }
    
    .text-toolbar.link-mode .text-toolbar-link-input {
      display: block;
    }
    
    /* Color Picker */
    .color-btn {
      position: relative;
    }
    
    .color-indicator {
      font-weight: 700;
      font-size: 14px;
      border-bottom: 3px solid #ec4899;
      line-height: 1;
      padding-bottom: 2px;
    }
    
    .color-picker-input {
      position: absolute;
      opacity: 0;
      width: 0;
      height: 0;
      pointer-events: none;
    }
    
    /* Light mode toolbar */
    body.light-mode .text-toolbar,
    body[data-theme="light"] .text-toolbar {
      background: #ffffff;
      border-color: #e0e0e0;
      box-shadow: 0 4px 16px rgba(0,0,0,0.15);
    }
    
    body.light-mode .text-toolbar-btn,
    body[data-theme="light"] .text-toolbar-btn {
      color: #555;
    }
    
    body.light-mode .text-toolbar-btn:hover,
    body[data-theme="light"] .text-toolbar-btn:hover {
      background: rgba(236, 72, 153, 0.15);
      color: #ec4899;
    }
    
    body.light-mode .text-toolbar-divider,
    body[data-theme="light"] .text-toolbar-divider {
      background: #e0e0e0;
    }
    
    body.light-mode .text-toolbar-link-input,
    body[data-theme="light"] .text-toolbar-link-input {
      background: #f5f5f5;
      border-color: #e0e0e0;
      color: #333;
    }
    
    /* Section Delete Button */
    section, footer { position: relative; }
    
    .section-delete-btn {
      position: absolute;
      top: 10px;
      right: 10px;
      width: 28px;
      height: 28px;
      display: flex;
      align-items: center;
      justify-content: center;
      background: #ef4444;
      color: white;
      border: none;
      border-radius: 6px;
      cursor: pointer;
      opacity: 0;
      transition: opacity 0.2s;
      z-index: 100;
      font-size: 18px;
      font-weight: bold;
    }
    
    section:hover .section-delete-btn,
    footer:hover .section-delete-btn { opacity: 1; }
    
    .section-delete-btn:hover {
      background: #dc2626;
      transform: scale(1.1);
    }
    
    /* Grid Drop Zones */
    .drop-zone, .grid-col {
      min-height: 100px;
      transition: all 0.2s;
      position: relative;
    }
    
    .drop-zone.drag-over, .grid-col.drag-over {
      background: rgba(236, 72, 153, 0.15) !important;
      outline: 3px dashed #ec4899 !important;
      outline-offset: -4px;
      border-radius: 8px;
    }
    
    .drop-zone.empty {
      border: 2px dashed rgba(255,255,255,0.2);
      border-radius: 12px;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    
    /* Drag handle - Force visibility and high z-index */
    .drag-handle {
      position: absolute;
      left: 8px;
      top: 8px;
      width: 32px;
      height: 32px;
      background: #ec4899;
      color: white;
      display: none; /* Hidden by default */
      align-items: center;
      justify-content: center;
      cursor: grab;
      border-radius: 6px;
      font-size: 16px;
      font-weight: bold;
      z-index: 9000 !important; /* Extremely high z-index */
      box-shadow: 0 2px 8px rgba(0,0,0,0.4);
      user-select: none;
      pointer-events: auto !important;
      /* Ensure dragging works */
      -webkit-user-drag: element;
      touch-action: none;
    }
    
    .drag-handle:active {
      cursor: grabbing;
    }
    
    /* Prevent iframe from capturing drag events during drag operations */
    /* But allow interaction when not dragging */
    body.is-dragging .video-wrapper iframe,
    body.is-dragging .media-wrapper iframe {
      pointer-events: none !important;
    }
    
    /* Normal state - allow iframe interaction for playback controls */
    .video-wrapper iframe,
    .media-wrapper iframe {
      pointer-events: auto;
      position: relative;
      z-index: 1;
    }
    
    /* Drag overlay for iframe-containing elements - VISIBLE handle area */
    .drag-overlay {
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 40px; /* Only cover top area as a drag bar */
      background: linear-gradient(to bottom, rgba(236, 72, 153, 0.3) 0%, rgba(236, 72, 153, 0) 100%);
      z-index: 100;
      cursor: grab;
      display: flex;
      align-items: center;
      justify-content: center;
      opacity: 0;
      transition: opacity 0.2s;
    }
    .drag-overlay::before {
      content: '⋮⋮ Drag to move';
      font-size: 11px;
      color: white;
      background: rgba(236, 72, 153, 0.8);
      padding: 4px 12px;
      border-radius: 4px;
      font-weight: 500;
    }
    .video-wrapper:hover .drag-overlay,
    .media-wrapper:hover .drag-overlay {
      opacity: 1;
    }
    .drag-overlay:active {
      cursor: grabbing;
    }
    
    /* When dragging, disable iframe pointer events */
    body.is-dragging iframe {
      pointer-events: none !important;
    }
    
    /* Show handle on element hover - FORCE DISPLAY */
    [data-drag-setup]:hover > .drag-handle {
      display: flex !important;
    }
    
    /* Element Delete Button - appears next to drag handle */
    .element-delete-btn {
      position: absolute;
      left: 44px; /* Next to drag handle */
      top: 8px;
      width: 32px;
      height: 32px;
      background: #ef4444;
      color: white;
      display: none;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      border-radius: 6px;
      font-size: 18px;
      font-weight: bold;
      z-index: 9000 !important;
      box-shadow: 0 2px 8px rgba(0,0,0,0.4);
      user-select: none;
      border: none;
    }
    
    .element-delete-btn:hover {
      background: #dc2626;
      transform: scale(1.1);
    }
    
    [data-drag-setup]:hover > .element-delete-btn {
      display: flex !important;
    }
    
    /* Empty placeholder box - make it obvious how to delete */
    .empty-placeholder {
      position: relative;
      min-height: 100px;
      border: 2px dashed rgba(236, 72, 153, 0.4);
      border-radius: 12px;
      display: flex;
      align-items: center;
      justify-content: center;
      color: rgba(236, 72, 153, 0.6);
      font-size: 0.875rem;
      background: rgba(236, 72, 153, 0.05);
      cursor: pointer;
    }
    
    .empty-placeholder:hover {
      border-color: #ef4444;
      background: rgba(239, 68, 68, 0.1);
    }
    
    .empty-placeholder::after {
      content: '✕ Click to delete';
      opacity: 0;
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      background: #ef4444;
      color: white;
      padding: 0.5rem 1rem;
      border-radius: 6px;
      font-weight: 600;
      transition: opacity 0.2s;
    }
    
    .empty-placeholder:hover::after {
      opacity: 1;
    }
    
    /* Media wrapper - needs position for controls */
    .media-wrapper, .video-wrapper {
      position: relative !important;
      display: block;
      width: 100%;
    }
    
    /* Ensure video iframes display properly */
    .video-wrapper iframe {
      display: block;
      width: 100%;
      min-height: 200px;
      border-radius: 12px;
    }
    
    /* Video wrapper in grid columns should fill space */
    .grid-col .video-wrapper,
    .drop-zone .video-wrapper {
      width: 100%;
      height: 100%;
      min-height: 200px;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    
    .grid-col .video-wrapper iframe,
    .drop-zone .video-wrapper iframe {
      width: 100%;
      height: 100%;
      min-height: 250px;
    }
    
    /* Media controls - ensure clickable */
    .media-controls {
      position: absolute;
      top: 8px;
      right: 8px;
      display: none;
      gap: 6px;
      z-index: 9001 !important;
      pointer-events: auto !important;
      flex-direction: row;
    }
    
    .media-wrapper:hover .media-controls,
    .video-wrapper:hover .media-controls {
      display: flex !important;
    }
    
    .media-btn {
      width: 28px;
      height: 28px;
      border: none;
      border-radius: 6px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 14px;
      z-index: 9002 !important;
      cursor: pointer !important;
      pointer-events: auto !important;
    }
    
    .media-btn-edit {
      background: #3b82f6;
      color: white;
    }
    
    .media-btn-delete {
      background: #ef4444;
      color: white;
    }
    
    .media-btn:hover {
      transform: scale(1.1);
    }
    
    /* Resize handles for media elements */
    .resize-handle {
      position: absolute;
      background: #ec4899;
      border: 2px solid white;
      border-radius: 4px;
      z-index: 9003;
      opacity: 0;
      transition: opacity 0.2s;
      pointer-events: auto;
    }
    
    .media-wrapper:hover .resize-handle,
    .video-wrapper:hover .resize-handle,
    .resizing .resize-handle {
      opacity: 1;
    }
    
    .resize-handle-se {
      width: 14px;
      height: 14px;
      bottom: -4px;
      right: -4px;
      cursor: se-resize;
    }
    
    .resize-handle-sw {
      width: 14px;
      height: 14px;
      bottom: -4px;
      left: -4px;
      cursor: sw-resize;
    }
    
    .resize-handle-e {
      width: 8px;
      height: 30px;
      top: 50%;
      right: -4px;
      transform: translateY(-50%);
      cursor: e-resize;
    }
    
    .resize-handle-w {
      width: 8px;
      height: 30px;
      top: 50%;
      left: -4px;
      transform: translateY(-50%);
      cursor: w-resize;
    }
    
    /* Resize info tooltip */
    .resize-info {
      position: absolute;
      bottom: -30px;
      left: 50%;
      transform: translateX(-50%);
      background: rgba(0,0,0,0.8);
      color: white;
      padding: 4px 8px;
      border-radius: 4px;
      font-size: 12px;
      white-space: nowrap;
      pointer-events: none;
      z-index: 9999;
    }
    
    /* Horizontal drop indicator for grid layouts */
    .drop-indicator-h {
      width: 4px;
      height: 100%;
      min-height: 50px;
      background: linear-gradient(180deg, #ec4899, #f472b6, #ec4899);
      border-radius: 2px;
      position: absolute;
      top: 0;
      pointer-events: none;
      animation: pulseIndicator 0.5s ease-in-out infinite alternate;
      z-index: 100;
    }
    
    .drop-indicator-h.left {
      left: -4px;
    }
    
    .drop-indicator-h.right {
      right: -4px;
    }
    
    /* Element being dragged */
    .being-dragged {
      opacity: 0.5;
      outline: 2px dashed #ec4899;
    }
    
    /* Drop indicator line */
    .drop-indicator {
      height: 4px;
      background: linear-gradient(90deg, #ec4899, #f472b6, #ec4899);
      border-radius: 2px;
      margin: 8px 0;
      pointer-events: none;
      animation: pulseIndicator 0.5s ease-in-out infinite alternate;
    }
    
    @keyframes pulseIndicator {
      from { opacity: 0.6; transform: scaleX(0.98); }
      to { opacity: 1; transform: scaleX(1); }
    }
    
    /* Container receiving a drag */
    .drag-over {
      background: rgba(236, 72, 153, 0.08) !important;
    }
    
    /* Section edit grid - default is single column, expands to 2-column when dragging */
    .section-edit-grid {
      display: block; /* Single column by default */
      max-width: 1200px;
      margin: 0 auto;
    }
    
    /* When dragging, show as 2-column grid */
    body.is-dragging .section-edit-grid {
      display: grid !important;
      grid-template-columns: 1fr 1fr;
      gap: 2rem;
      align-items: start;
    }
    
    .section-edit-grid > .grid-col {
      min-height: auto;
      border-radius: 8px;
      transition: all 0.2s;
    }
    
    /* When dragging, add padding to columns */
    body.is-dragging .section-edit-grid > .grid-col {
      min-height: 150px;
      padding: 1rem;
    }
    
    .section-edit-grid > .grid-col.drag-over {
      background: rgba(236, 72, 153, 0.2) !important;
      outline: 3px dashed #ec4899;
    }
    
    /* Empty column - hidden by default, shown when dragging */
    /* ONLY hide if the column has NO child elements */
    .section-edit-grid > .grid-col.empty-col:not(:has(*:not(span))) {
      display: none; /* Hidden by default - only when truly empty */
    }
    
    body.is-dragging .section-edit-grid > .grid-col.empty-col {
      display: flex !important;
      border: 2px dashed rgba(255,255,255,0.3);
      align-items: center;
      justify-content: center;
      color: rgba(255,255,255,0.5);
      font-size: 0.9rem;
    }
    
    /* When empty-col has content, always show it */
    .section-edit-grid > .grid-col.empty-col.has-content,
    .section-edit-grid > .grid-col.has-content {
      display: block !important;
    }
    
    /* CRITICAL: Always show grid columns that have any real content */
    .section-edit-grid > .grid-col:has(div),
    .section-edit-grid > .grid-col:has(section),
    .section-edit-grid > .grid-col:has(h1),
    .section-edit-grid > .grid-col:has(h2),
    .section-edit-grid > .grid-col:has(p),
    .section-edit-grid > .grid-col:has(button),
    .section-edit-grid > .grid-col:has(form),
    .section-edit-grid > .grid-col:has(iframe),
    .section-grid > .grid-col {
      display: block !important;
    }
    
    /* Force visibility for columns containing video or media */
    .grid-col:has(.video-wrapper),
    .grid-col:has(.media-wrapper),
    .drop-zone:has(.video-wrapper),
    .drop-zone:has(.media-wrapper),
    .video-wrapper,
    .media-wrapper {
      display: block !important;
      min-height: 200px;
    }
    
    /* Empty drop zones - make them obvious in edit mode */
    .grid-col.empty-col,
    .drop-zone:empty,
    .grid-col:not(:has(*:not(span))) {
      display: flex !important;
      align-items: center;
      justify-content: center;
      min-height: 150px;
      border: 2px dashed rgba(236, 72, 153, 0.4);
      border-radius: 12px;
      background: rgba(236, 72, 153, 0.05);
      position: relative;
    }
    
    .grid-col.empty-col::after,
    .drop-zone:empty::after {
      content: '➕ Drop component here';
      color: rgba(236, 72, 153, 0.6);
      font-size: 0.875rem;
      font-weight: 500;
      pointer-events: none;
    }
    
    .grid-col.empty-col:hover,
    .drop-zone:empty:hover {
      border-color: #ec4899;
      background: rgba(236, 72, 153, 0.1);
    }
    
    .grid-col.empty-col:hover::after,
    .drop-zone:empty:hover::after {
      color: #ec4899;
    }
    
    /* Hide the drop placeholder for columns with content */
    .grid-col:has(*:not(span))::after,
    .grid-col.has-content::after {
      display: none !important;
    }
    
    /* Grid overlay shown when dragging over sections */
    section.show-grid-overlay {
      position: relative;
    }
    
    section.show-grid-overlay::before {
      content: '';
      position: absolute;
      inset: 0;
      pointer-events: none;
      z-index: 50;
      background: 
        linear-gradient(90deg, rgba(236, 72, 153, 0.1) 1px, transparent 1px),
        linear-gradient(rgba(236, 72, 153, 0.1) 1px, transparent 1px);
      background-size: 50% 100%;
      border: 2px dashed #ec4899;
      border-radius: 8px;
    }
    
    /* Drop zone columns visible when parent is being dragged over */
    section.show-grid-overlay .grid-col,
    section.show-grid-overlay .drop-zone:not(section) {
      background: rgba(236, 72, 153, 0.15) !important;
      border: 2px dashed rgba(236, 72, 153, 0.6) !important;
      border-radius: 8px;
      min-height: 100px;
      transition: all 0.2s;
    }
    
    section.show-grid-overlay .grid-col:hover,
    section.show-grid-overlay .drop-zone:not(section):hover {
      background: rgba(236, 72, 153, 0.25) !important;
      border-color: #ec4899 !important;
    }
    
    /* Grid zone labels */
    section.show-grid-overlay .grid-col::after,
    section.show-grid-overlay .drop-zone:not(section)::after {
      content: 'Drop here';
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      color: #ec4899;
      font-size: 12px;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 1px;
      opacity: 0.8;
      pointer-events: none;
    }
    
    /* Media controls overlay for images and videos */
    .media-wrapper {
      position: relative;
      display: inline-block;
    }
    
    .media-controls {
      position: absolute;
      top: 8px;
      right: 8px;
      display: none;
      gap: 6px;
      z-index: 200;
      pointer-events: auto;
    }
    
    .media-wrapper:hover .media-controls {
      display: flex;
    }
    
    .media-btn {
      width: 36px;
      height: 36px;
      border: none;
      border-radius: 8px;
      cursor: pointer !important;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 16px;
      transition: transform 0.1s, background 0.1s;
      box-shadow: 0 2px 8px rgba(0,0,0,0.4);
      pointer-events: auto !important;
      user-select: none;
    }
    
    .media-btn:hover {
      transform: scale(1.15);
    }
    
    .media-btn-edit {
      background: #3b82f6;
      color: white;
    }
    
    .media-btn-edit:hover {
      background: #2563eb;
    }
    
    .media-btn-delete {
      background: #ef4444;
      color: white;
    }
    
    .media-btn-delete:hover {
      background: #dc2626;
    }
    
    /* Image modal */
    .image-modal {
