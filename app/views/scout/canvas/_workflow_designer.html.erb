            <div style="display: flex; gap: 8px;">
              <input type="number" id="prop-delay-value" min="1" value="${data.config?.delay_value || 5}" style="flex: 1; padding: 8px 12px; background: var(--bs-tertiary-bg, #252540); border: 1px solid var(--bs-border-color, #333); border-radius: 6px; color: var(--bs-body-color, #fff);">
              <select id="prop-delay-unit" style="width: 120px; padding: 8px 12px; background: var(--bs-tertiary-bg, #252540); border: 1px solid var(--bs-border-color, #333); border-radius: 6px; color: var(--bs-body-color, #fff);">
                <option value="seconds" ${data.config?.delay_unit === 'seconds' ? 'selected' : ''}>Seconds</option>
                <option value="minutes" ${data.config?.delay_unit === 'minutes' || !data.config?.delay_unit ? 'selected' : ''}>Minutes</option>
                <option value="hours" ${data.config?.delay_unit === 'hours' ? 'selected' : ''}>Hours</option>
                <option value="days" ${data.config?.delay_unit === 'days' ? 'selected' : ''}>Days</option>
              </select>
            </div>
          </div>
          <div style="margin-bottom: 16px;">
            <label style="display: block; font-size: 12px; color: var(--bs-secondary-color, #6b7280); margin-bottom: 6px;">Delay Type</label>
            <select id="prop-delay-type" style="width: 100%; padding: 8px 12px; background: var(--bs-tertiary-bg, #252540); border: 1px solid var(--bs-border-color, #333); border-radius: 6px; color: var(--bs-body-color, #fff);">
              <option value="fixed" ${data.config?.delay_type === 'fixed' || !data.config?.delay_type ? 'selected' : ''}>Fixed Duration</option>
              <option value="until_time" ${data.config?.delay_type === 'until_time' ? 'selected' : ''}>Until Specific Time</option>
              <option value="until_date" ${data.config?.delay_type === 'until_date' ? 'selected' : ''}>Until Specific Date/Time</option>
            </select>
          </div>
          <div id="prop-delay-until-container" style="margin-bottom: 16px; display: none;">
            <label style="display: block; font-size: 12px; color: var(--bs-secondary-color, #6b7280); margin-bottom: 6px;">Wait Until</label>
            <input type="datetime-local" id="prop-delay-until" value="${data.config?.delay_until || ''}" style="width: 100%; padding: 8px 12px; background: var(--bs-tertiary-bg, #252540); border: 1px solid var(--bs-border-color, #333); border-radius: 6px; color: var(--bs-body-color, #fff);">
          </div>
          <div style="padding: 12px; background: rgba(59, 130, 246, 0.1); border-radius: 8px; border: 1px solid rgba(59, 130, 246, 0.3);">
            <p style="font-size: 12px; color: var(--bs-body-color, #e0e0e0); margin: 0;">
              <strong>Use cases:</strong><br>
              • Wait before sending follow-up emails<br>
              • Schedule actions for business hours<br>
              • Add cooling-off period before escalation
            </p>
          </div>
        `;
      }
    } else if (category === 'logic') {
      if (subtype === 'condition') {
        // Condition node - structured condition builder
        formHtml += `
          <div style="margin-bottom: 16px;">
            <label style="display: block; font-size: 12px; color: var(--bs-secondary-color, #6b7280); margin-bottom: 6px;">If this field...</label>
            <input type="text" id="prop-cond-left" placeholder="{{trigger.data.status}} or {{previous_step.result}}" value="${data.config?.left_operand || ''}" style="width: 100%; padding: 8px 12px; background: var(--bs-tertiary-bg, #252540); border: 1px solid var(--bs-border-color, #333); border-radius: 6px; color: var(--bs-body-color, #fff); font-family: monospace; font-size: 12px;">
            <p style="font-size: 11px; color: var(--bs-secondary-color, #6b7280); margin-top: 4px;">Use {{step_name.field}} to reference data from previous steps</p>
          </div>
          <div style="margin-bottom: 16px;">
            <label style="display: block; font-size: 12px; color: var(--bs-secondary-color, #6b7280); margin-bottom: 6px;">Operator</label>
            <select id="prop-cond-operator" style="width: 100%; padding: 8px 12px; background: var(--bs-tertiary-bg, #252540); border: 1px solid var(--bs-border-color, #333); border-radius: 6px; color: var(--bs-body-color, #fff);">
              <option value="equals" ${data.config?.operator === 'equals' ? 'selected' : ''}>Equals (==)</option>
              <option value="not_equals" ${data.config?.operator === 'not_equals' ? 'selected' : ''}>Not Equals (!=)</option>
              <option value="contains" ${data.config?.operator === 'contains' ? 'selected' : ''}>Contains</option>
              <option value="not_contains" ${data.config?.operator === 'not_contains' ? 'selected' : ''}>Does Not Contain</option>
              <option value="starts_with" ${data.config?.operator === 'starts_with' ? 'selected' : ''}>Starts With</option>
              <option value="ends_with" ${data.config?.operator === 'ends_with' ? 'selected' : ''}>Ends With</option>
              <option value="greater_than" ${data.config?.operator === 'greater_than' ? 'selected' : ''}>Greater Than (>)</option>
              <option value="less_than" ${data.config?.operator === 'less_than' ? 'selected' : ''}>Less Than (<)</option>
              <option value="greater_or_equal" ${data.config?.operator === 'greater_or_equal' ? 'selected' : ''}>Greater or Equal (>=)</option>
              <option value="less_or_equal" ${data.config?.operator === 'less_or_equal' ? 'selected' : ''}>Less or Equal (<=)</option>
              <option value="is_empty" ${data.config?.operator === 'is_empty' ? 'selected' : ''}>Is Empty/Null</option>
              <option value="is_not_empty" ${data.config?.operator === 'is_not_empty' ? 'selected' : ''}>Is Not Empty</option>
              <option value="is_true" ${data.config?.operator === 'is_true' ? 'selected' : ''}>Is True</option>
              <option value="is_false" ${data.config?.operator === 'is_false' ? 'selected' : ''}>Is False</option>
            </select>
          </div>
          <div id="prop-cond-right-container" style="margin-bottom: 16px;">
            <label style="display: block; font-size: 12px; color: var(--bs-secondary-color, #6b7280); margin-bottom: 6px;">Compare to this value...</label>
            <input type="text" id="prop-cond-right" placeholder="active, 100, {{other_step.value}}" value="${data.config?.right_operand || ''}" style="width: 100%; padding: 8px 12px; background: var(--bs-tertiary-bg, #252540); border: 1px solid var(--bs-border-color, #333); border-radius: 6px; color: var(--bs-body-color, #fff); font-family: monospace; font-size: 12px;">
          </div>
          <div style="margin-bottom: 16px; padding: 12px; background: rgba(139, 92, 246, 0.1); border-radius: 8px; border: 1px solid rgba(139, 92, 246, 0.3);">
            <p style="font-size: 12px; color: var(--bs-body-color, #e0e0e0); margin: 0;">
              <strong>True path:</strong> Connect from the <span style="color: #10b981;">green</span> (✓) port<br>
              <strong>False path:</strong> Connect from the <span style="color: #ef4444;">red</span> (✗) port
            </p>
          </div>
        `;
      } else if (subtype === 'loop') {
        // Loop node - specify collection and item variable
        formHtml += `
          <div style="margin-bottom: 16px;">
            <label style="display: block; font-size: 12px; color: var(--bs-secondary-color, #6b7280); margin-bottom: 6px;">Loop Over (Collection/Array)</label>
