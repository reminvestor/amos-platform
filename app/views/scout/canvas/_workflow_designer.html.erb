<%# Workflow Designer Canvas - Visual builder for automations and integrations %>
<% data = (canvas_data || {}).with_indifferent_access %>

<% app_id = data[:app_id] || data[:plan_id] %>
<% is_app_workflow = app_id.present? %>
<div class="workflow-designer-canvas" 
     id="workflow-designer-<%= SecureRandom.hex(4) %>"
     data-workflow-id="<%= data[:workflow_id] %>"
     data-workflow-name="<%= data[:workflow_name] %>"
     data-template-name="<%= data[:template_name] %>"
     data-template-id="<%= data[:template_id] %>"
     data-app-id="<%= app_id %>"
     data-is-app-workflow="<%= is_app_workflow %>">
  <div class="workflow-designer-layout">
    <!-- Component Sidebar -->
    <div class="workflow-component-panel">
      <div class="component-panel-header">
        <i data-lucide="puzzle" style="width: 16px; height: 16px;"></i>
        <span>Components</span>
      </div>
      
      <div class="component-panel-search">
        <input type="text" placeholder="Search components..." id="component-search">
      </div>
      
      <div class="component-panel-body" id="component-panel-body">
        <!-- Triggers -->
        <div class="component-section" data-category="trigger">
          <div class="section-header">
            <i data-lucide="zap" style="width: 14px; height: 14px;"></i>
            TRIGGERS
          </div>
          <div class="component-item" draggable="true" data-type="trigger-form" data-color="#10b981">
            <i data-lucide="file-input" style="width: 16px; height: 16px;"></i>
            <span>Form Submit</span>
          </div>
          <div class="component-item" draggable="true" data-type="trigger-webhook" data-color="#10b981">
            <i data-lucide="webhook" style="width: 16px; height: 16px;"></i>
            <span>Webhook</span>
          </div>
          <div class="component-item" draggable="true" data-type="trigger-schedule" data-color="#10b981">
            <i data-lucide="clock" style="width: 16px; height: 16px;"></i>
            <span>Schedule</span>
          </div>
          <div class="component-item" draggable="true" data-type="trigger-record" data-color="#10b981">
            <i data-lucide="database" style="width: 16px; height: 16px;"></i>
            <span>Record Event</span>
          </div>
          <div class="component-item" draggable="true" data-type="trigger-manual" data-color="#10b981">
            <i data-lucide="play" style="width: 16px; height: 16px;"></i>
            <span>Manual Trigger</span>
          </div>
        </div>
        
        <!-- Actions -->
        <div class="component-section" data-category="action">
          <div class="section-header">
            <i data-lucide="play" style="width: 14px; height: 14px;"></i>
            ACTIONS
          </div>
          <div class="component-item" draggable="true" data-type="action-email" data-color="#3b82f6">
            <i data-lucide="mail" style="width: 16px; height: 16px;"></i>
            <span>Send Email</span>
          </div>
          <div class="component-item" draggable="true" data-type="action-create-record" data-color="#3b82f6">
            <i data-lucide="plus-circle" style="width: 16px; height: 16px;"></i>
            <span>Create Record</span>
          </div>
          <div class="component-item" draggable="true" data-type="action-update-record" data-color="#3b82f6">
            <i data-lucide="edit-3" style="width: 16px; height: 16px;"></i>
            <span>Update Record</span>
          </div>
          <div class="component-item" draggable="true" data-type="action-delay" data-color="#3b82f6">
            <i data-lucide="timer" style="width: 16px; height: 16px;"></i>
            <span>Delay</span>
          </div>
        </div>
        
        <!-- Logic -->
        <div class="component-section" data-category="logic">
          <div class="section-header">
            <i data-lucide="git-branch" style="width: 14px; height: 14px;"></i>
            LOGIC
          </div>
          <div class="component-item" draggable="true" data-type="logic-condition" data-color="#f59e0b">
            <i data-lucide="git-branch" style="width: 16px; height: 16px;"></i>
            <span>Condition</span>
          </div>
          <div class="component-item" draggable="true" data-type="logic-switch" data-color="#f59e0b">
            <i data-lucide="git-merge" style="width: 16px; height: 16px;"></i>
            <span>Switch</span>
          </div>
          <div class="component-item" draggable="true" data-type="logic-loop" data-color="#f59e0b">
            <i data-lucide="repeat" style="width: 16px; height: 16px;"></i>
            <span>Loop</span>
          </div>
          <div class="component-item" draggable="true" data-type="logic-merge" data-color="#f59e0b">
            <i data-lucide="git-pull-request" style="width: 16px; height: 16px;"></i>
            <span>Merge</span>
          </div>
        </div>
        
        <!-- Transforms -->
        <div class="component-section" data-category="transform">
          <div class="section-header">
            <i data-lucide="shuffle" style="width: 14px; height: 14px;"></i>
            TRANSFORMS
          </div>
          <div class="component-item" draggable="true" data-type="transform-map" data-color="#8b5cf6">
            <i data-lucide="shuffle" style="width: 16px; height: 16px;"></i>
            <span>Map Fields</span>
          </div>
          <div class="component-item" draggable="true" data-type="transform-filter" data-color="#8b5cf6">
            <i data-lucide="filter" style="width: 16px; height: 16px;"></i>
            <span>Filter Array</span>
          </div>
          <div class="component-item" draggable="true" data-type="transform-aggregate" data-color="#8b5cf6">
            <i data-lucide="calculator" style="width: 16px; height: 16px;"></i>
            <span>Aggregate</span>
          </div>
          <div class="component-item" draggable="true" data-type="transform-code" data-color="#8b5cf6">
            <i data-lucide="code" style="width: 16px; height: 16px;"></i>
            <span>Custom Code</span>
          </div>
        </div>
        
        <!-- AI / Amos -->
        <div class="component-section" data-category="agent">
          <div class="section-header">
            <i data-lucide="sparkles" style="width: 14px; height: 14px;"></i>
            AMOS AI
          </div>
          <div class="component-item" draggable="true" data-type="agent-invoke" data-color="#8b5cf6">
            <i data-lucide="bot" style="width: 16px; height: 16px;"></i>
            <span>Ask Amos</span>
          </div>
          <div class="component-item" draggable="true" data-type="agent-decide" data-color="#8b5cf6">
            <i data-lucide="brain" style="width: 16px; height: 16px;"></i>
            <span>AI Decision</span>
          </div>
        </div>
        
        <!-- Outputs -->
        <div class="component-section" data-category="output">
          <div class="section-header">
            <i data-lucide="flag" style="width: 14px; height: 14px;"></i>
            OUTPUTS
          </div>
          <div class="component-item" draggable="true" data-type="output-success" data-color="#22c55e">
            <i data-lucide="check-circle" style="width: 16px; height: 16px;"></i>
            <span>Success</span>
          </div>
          <div class="component-item" draggable="true" data-type="output-error" data-color="#ef4444">
            <i data-lucide="x-circle" style="width: 16px; height: 16px;"></i>
            <span>Error</span>
          </div>
        </div>
        
        <!-- Integrations (Connected) -->
        <div class="component-section" data-category="integration">
          <div class="section-header">
            <i data-lucide="plug" style="width: 14px; height: 14px;"></i>
            INTEGRATIONS
            <button type="button" class="section-add-btn" id="add-integration-btn" title="Connect new integration">
              <i data-lucide="plus" style="width: 12px; height: 12px;"></i>
            </button>
          </div>
          <% connected_integrations = (user.connections.where(entity: entity).active.includes(:integration).limit(10) rescue []) %>
          <% if connected_integrations.any? %>
            <% connected_integrations.each do |connection| %>
              <% integration = connection.integration %>
              <% icon = case integration.category
                   when 'payment' then 'credit-card'
                   when 'communication' then 'message-square'
                   when 'crm' then 'users'
                   when 'ecommerce' then 'shopping-cart'
                   when 'marketing' then 'megaphone'
                   when 'analytics' then 'bar-chart-2'
                   when 'accounting' then 'calculator'
                   when 'productivity' then 'briefcase'
                   else 'plug'
                 end %>
              <div class="component-item" draggable="true" data-type="integration-call" data-integration-slug="<%= integration.slug %>" data-connection-id="<%= connection.id %>" data-color="#ec4899">
                <i data-lucide="<%= icon %>" style="width: 16px; height: 16px;"></i>
                <span><%= integration.name %></span>
          </div>
            <% end %>
          <% else %>
            <div class="component-empty-state">
              <p>No integrations connected</p>
              <button type="button" class="component-connect-btn" id="connect-first-integration-btn">
                <i data-lucide="plus" style="width: 12px; height: 12px;"></i>
                Connect
              </button>
          </div>
          <% end %>
        </div>
      </div>
    </div>
    
    <!-- Main Content Area -->
    <div class="workflow-main-content">
      <% if is_app_workflow %>
      <!-- App Context Navigation Bar -->
      <div class="app-context-nav">
        <button class="app-nav-back" id="back-to-app-btn" title="Back to App Designer">
          <i data-lucide="arrow-left" style="width: 16px; height: 16px;"></i>
          <span>Back to App</span>
        </button>
        <div class="app-nav-tabs">
          <button class="app-nav-tab" data-mode="pages">
            <i data-lucide="layout-template" style="width: 14px; height: 14px;"></i>
            Pages
          </button>
          <button class="app-nav-tab" data-mode="canvases">
            <i data-lucide="layout-dashboard" style="width: 14px; height: 14px;"></i>
            Canvases
          </button>
          <button class="app-nav-tab" data-mode="data">
            <i data-lucide="database" style="width: 14px; height: 14px;"></i>
            Data
          </button>
          <button class="app-nav-tab active" data-mode="workflows">
            <i data-lucide="git-branch" style="width: 14px; height: 14px;"></i>
            Workflows
          </button>
        </div>
      </div>
      <% end %>
      
      <!-- Header -->
      <div class="designer-header">
    <div class="designer-header-left">
      <i data-lucide="git-branch" class="designer-icon"></i>
      <div>
        <div class="designer-title-row">
          <h4 class="designer-title" id="workflow-title" contenteditable="true" spellcheck="false" title="Click to edit workflow name"><%= data[:workflow_name] || 'Untitled Workflow' %></h4>
          <span class="beta-badge">Beta</span>
        </div>
        <p class="designer-subtitle">Build automations visually</p>
      </div>
    </div>
    <div class="designer-header-right">
      <button type="button" class="designer-btn-new" id="new-workflow-btn" title="Create New Workflow">
        <i data-lucide="plus"></i>
        New
      </button>
      <div class="designer-divider"></div>
      <button type="button" class="designer-btn" id="undo-btn" title="Undo">
        <i data-lucide="undo-2"></i>
      </button>
      <button type="button" class="designer-btn" id="redo-btn" title="Redo">
        <i data-lucide="redo-2"></i>
      </button>
      <div class="designer-divider"></div>
      <button type="button" class="designer-btn" id="zoom-out-btn" title="Zoom out">
        <i data-lucide="zoom-out"></i>
      </button>
      <span class="zoom-level">100%</span>
      <button type="button" class="designer-btn" id="zoom-in-btn" title="Zoom in">
        <i data-lucide="zoom-in"></i>
      </button>
      <div class="designer-divider"></div>
      <button type="button" class="designer-btn-primary" id="save-workflow-btn">
        <i data-lucide="save"></i>
        Save
      </button>
      <div class="designer-divider"></div>
      <button type="button" class="designer-btn-build" id="build-workflow-btn" title="Build this workflow into an executable automation">
        <i data-lucide="hammer"></i>
        Build
      </button>
      <button type="button" class="designer-btn-test" id="test-workflow-btn" title="Test run this workflow" disabled>
        <i data-lucide="play-circle"></i>
        Test
      </button>
      <button type="button" class="designer-btn-activate" id="activate-workflow-btn" title="Activate this workflow for production use" disabled>
        <i data-lucide="rocket"></i>
        Activate
      </button>
    </div>
  </div>
  
  <!-- Build Status Banner -->
  <div class="build-status-banner" id="build-status-banner" style="display: none;">
    <div class="build-status-content">
      <span class="build-status-icon">
        <i data-lucide="check-circle"></i>
      </span>
      <span class="build-status-text">Workflow built successfully</span>
      <span class="build-status-details"></span>
    </div>
    <button type="button" class="build-status-close" id="close-build-status">
      <i data-lucide="x"></i>
    </button>
  </div>
  
  <!-- Workflow Canvas (full width now) -->
  <div class="workflow-canvas" id="workflow-canvas">
    <div class="canvas-grid" id="canvas-grid"></div>
    
    <!-- Empty state (fixed in viewport center, outside transform) -->
    <div class="canvas-empty-state" id="canvas-empty-state">
      <div class="empty-icon">
        <i data-lucide="workflow"></i>
      </div>
      <h5>Start Building Your Workflow</h5>
      <p>Drag components from the panel or click a trigger to begin</p>
      <div class="quick-triggers">
        <button type="button" class="quick-trigger" data-trigger="webhook">
          <i data-lucide="webhook"></i>
          Webhook
        </button>
        <button type="button" class="quick-trigger" data-trigger="schedule">
          <i data-lucide="clock"></i>
          Schedule
        </button>
        <button type="button" class="quick-trigger" data-trigger="event">
          <i data-lucide="bell"></i>
          Event
        </button>
      </div>
      <div class="empty-state-divider">
        <span>or</span>
      </div>
      <button type="button" class="btn-load-existing" id="load-existing-workflow-btn">
        <i data-lucide="folder-open" style="width: 16px; height: 16px;"></i>
        Load Existing Workflow
      </button>
    </div>
    
    <!-- Transform container for pan/zoom -->
    <div class="workflow-transform-container" id="workflow-transform-container">      
      <!-- Nodes will be rendered here dynamically -->
      <div class="workflow-nodes" id="workflow-nodes"></div>
      
      <!-- Connections SVG layer -->
      <svg class="workflow-connections" id="workflow-connections"></svg>
    </div>
    
    <!-- Pan hint -->
    <div class="canvas-pan-hint" id="canvas-pan-hint">
      <i data-lucide="move" style="width: 12px; height: 12px;"></i>
      Drag canvas to pan • Scroll to zoom
    </div>
  </div>
  
  <!-- Properties Panel (shown when node selected) -->
  <div class="properties-panel" id="properties-panel" style="display: none;">
    <div class="properties-header">
      <h5>Node Properties</h5>
      <button type="button" class="close-properties">
        <i data-lucide="x"></i>
      </button>
    </div>
    <div class="properties-content">
      <!-- Dynamically populated -->
    </div>
  </div>
    </div><!-- End workflow-main-content -->
  </div><!-- End workflow-designer-layout -->
</div>

<style>
  /* Layout */
  .workflow-designer-layout {
    display: flex;
    flex: 1;
    height: 100%;
    overflow: hidden;
  }
  
  /* Component Panel */
  .workflow-component-panel {
    width: 240px;
    min-width: 240px;
    background: #1e1e2e;
    border-right: 1px solid #3a3a4a;
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }
  
  .component-panel-header {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 12px 16px;
    border-bottom: 1px solid #3a3a4a;
    background: #252536;
    color: #e0e0e0;
    font-weight: 600;
    font-size: 0.875rem;
  }
  
  .component-panel-search {
    padding: 8px 12px;
    border-bottom: 1px solid #3a3a4a;
  }
  
  .component-panel-search input {
    width: 100%;
    padding: 6px 10px;
    border: 1px solid #3a3a4a;
    border-radius: 4px;
    background: #1a1a2a;
    color: #e0e0e0;
    font-size: 0.75rem;
  }
  
  .component-panel-search input::placeholder {
    color: #6b7280;
  }
  
  .component-panel-body {
    flex: 1;
    overflow-y: auto;
    padding: 8px;
  }
  
  .component-section {
    margin-bottom: 16px;
  }
  
  .section-header {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 8px 8px 6px;
    font-size: 0.65rem;
    font-weight: 600;
    color: #6b7280;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }
  
  .section-add-btn {
    margin-left: auto;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 18px;
    height: 18px;
    border: 1px dashed rgba(139, 92, 246, 0.4);
    border-radius: 4px;
    background: transparent;
    color: #8b5cf6;
    cursor: pointer;
    transition: all 0.15s;
    padding: 0;
  }
  
  .section-add-btn:hover {
    background: rgba(139, 92, 246, 0.1);
    border-color: #8b5cf6;
  }
  
  .component-empty-state {
    padding: 12px 8px;
    text-align: center;
    color: #6b7280;
    font-size: 0.7rem;
  }
  
  .component-empty-state p {
    margin: 0 0 8px 0;
  }
  
  .component-connect-btn {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 4px 10px;
    border: 1px dashed rgba(139, 92, 246, 0.4);
    border-radius: 4px;
    background: transparent;
    color: #8b5cf6;
    font-size: 0.7rem;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.15s;
  }
  
  .component-connect-btn:hover {
    background: rgba(139, 92, 246, 0.1);
    border-color: #8b5cf6;
  }
  
  .component-item {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 8px 10px;
    border: 1px dashed #3a3a4a;
    border-radius: 6px;
    margin-bottom: 4px;
    cursor: grab;
    transition: all 0.15s ease;
    color: #a0a0a0;
    font-size: 0.8125rem;
  }
  
  .component-item:hover {
    background: rgba(139, 92, 246, 0.1);
    border-color: #8b5cf6;
    color: #e0e0e0;
  }
  
  /* Category-specific hover colors */
  [data-category="trigger"] .component-item:hover {
    background: rgba(16, 185, 129, 0.15);
    border-color: #10b981;
  }
  
  [data-category="action"] .component-item:hover {
    background: rgba(59, 130, 246, 0.15);
    border-color: #3b82f6;
  }
  
  [data-category="logic"] .component-item:hover {
    background: rgba(245, 158, 11, 0.15);
    border-color: #f59e0b;
  }
  
  [data-category="transform"] .component-item:hover {
    background: rgba(139, 92, 246, 0.15);
    border-color: #8b5cf6;
  }
  
  [data-category="agent"] .component-item:hover {
    background: rgba(6, 182, 212, 0.15);
    border-color: #06b6d4;
  }
  
  [data-category="output"] .component-item:hover {
    background: rgba(34, 197, 94, 0.15);
    border-color: #22c55e;
  }
  
  [data-category="integration"] .component-item:hover {
    background: rgba(236, 72, 153, 0.15);
    border-color: #ec4899;
  }
  
  /* Category icons in section headers */
  [data-category="trigger"] .section-header { color: #10b981; }
  [data-category="action"] .section-header { color: #3b82f6; }
  [data-category="logic"] .section-header { color: #f59e0b; }
  [data-category="transform"] .section-header { color: #8b5cf6; }
  [data-category="agent"] .section-header { color: #06b6d4; }
  [data-category="output"] .section-header { color: #22c55e; }
  [data-category="integration"] .section-header { color: #ec4899; }
  
  .component-item:active {
    cursor: grabbing;
  }
  
  .workflow-main-content {
    flex: 1;
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }
  
  .workflow-designer-canvas {
    display: flex;
    flex-direction: column;
    height: 100%;
    background: #1a1a2a;
    color: #e0e0e0;
  }
  
  /* Spin animation for save indicator */
  @keyframes spin {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }
  
  .spin {
    animation: spin 1s linear infinite;
  }
  
  /* App Context Navigation (when workflow is part of an app) */
  .app-context-nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 8px 16px;
    background: linear-gradient(135deg, #1a1a2e 0%, #16162a 100%);
    border-bottom: 1px solid #2d2d44;
  }
  
  .app-nav-back {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 6px 12px;
    background: transparent;
    border: 1px solid #3d3d5c;
    border-radius: 6px;
    color: #a5a5c0;
    font-size: 0.8rem;
    cursor: pointer;
    transition: all 0.2s ease;
  }
  
  .app-nav-back:hover {
    background: rgba(99, 102, 241, 0.1);
    border-color: #6366f1;
    color: #818cf8;
  }
  
  .app-nav-tabs {
    display: flex;
    gap: 4px;
    background: rgba(0, 0, 0, 0.2);
    padding: 4px;
    border-radius: 10px;
  }
  
  .app-nav-tab {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 8px 14px;
    background: transparent;
    border: none;
    border-radius: 8px;
    color: #6b6b8a;
    font-size: 0.8rem;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.2s ease;
  }
  
  .app-nav-tab:hover {
    color: #a5a5c0;
    background: rgba(99, 102, 241, 0.1);
  }
  
  .app-nav-tab.active {
    background: linear-gradient(135deg, #6366f1 0%, #818cf8 100%);
    color: white;
    box-shadow: 0 2px 8px rgba(99, 102, 241, 0.3);
  }
  
  [data-theme="light"] .app-context-nav { background: linear-gradient(135deg, #f9fafb 0%, #f3f4f6 100%); border-color: #e5e7eb; }
  [data-theme="light"] .app-nav-back { border-color: #d1d5db; color: #6b7280; }
  [data-theme="light"] .app-nav-back:hover { background: rgba(99, 102, 241, 0.08); border-color: #6366f1; color: #6366f1; }
  [data-theme="light"] .app-nav-tabs { background: rgba(0, 0, 0, 0.05); }
  [data-theme="light"] .app-nav-tab { color: #6b7280; }
