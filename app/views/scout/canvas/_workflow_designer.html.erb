    margin: 0;
    font-size: 0.8125rem;
    color: #e0e0e0;
  }
  
  .close-properties {
    display: flex;
    padding: 0.25rem;
    border: none;
    border-radius: 4px;
    background: transparent;
    color: #a0a0a0;
    cursor: pointer;
  }
  
  .close-properties:hover {
    background: rgba(255,255,255,0.08);
  }
  
  .close-properties i {
    width: 14px;
    height: 14px;
  }
  
  .properties-content {
    flex: 1;
    padding: 0.75rem;
    overflow-y: auto;
  }
  
