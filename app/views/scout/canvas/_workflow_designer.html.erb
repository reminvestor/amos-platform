  // Convert a select to a searchable dropdown
  function makeSearchable(selectElement, items, placeholder, labelField) {
    const wrapper = document.createElement('div');
    wrapper.className = 'searchable-dropdown';
    wrapper.style.cssText = 'position: relative; width: 100%;';
    
    // Create search input
    const searchInput = document.createElement('input');
    searchInput.type = 'text';
    searchInput.placeholder = '🔍 Type to search...';
    searchInput.className = 'searchable-input';
    searchInput.style.cssText = 'width: 100%; padding: 8px 12px; background: var(--bs-tertiary-bg, #252540); border: 1px solid var(--bs-border-color, #333); border-radius: 6px 6px 0 0; color: var(--bs-body-color, #fff); font-size: 13px; outline: none;';
    
    // Create results container
    const resultsDiv = document.createElement('div');
    resultsDiv.className = 'searchable-results';
    resultsDiv.style.cssText = 'max-height: 200px; overflow-y: auto; background: var(--bs-tertiary-bg, #252540); border: 1px solid var(--bs-border-color, #333); border-top: none; border-radius: 0 0 6px 6px; display: none;';
    
    // Hidden select to store value
    selectElement.style.display = 'none';
    
    // Insert wrapper
    selectElement.parentNode.insertBefore(wrapper, selectElement);
    wrapper.appendChild(searchInput);
    wrapper.appendChild(resultsDiv);
    wrapper.appendChild(selectElement);
    
    // Render items
    function renderItems(filter = '') {
      const filtered = items.filter(item => {
        const label = item[labelField] || item.name || '';
        return label.toLowerCase().includes(filter.toLowerCase());
      });
      
      resultsDiv.innerHTML = '';
      
      if (filtered.length === 0) {
        resultsDiv.innerHTML = '<div style="padding: 10px 12px; color: var(--bs-secondary-color, #6b7280); font-size: 13px;">No results found</div>';
      } else {
        filtered.forEach(item => {
          const itemDiv = document.createElement('div');
          itemDiv.className = 'searchable-item';
          itemDiv.style.cssText = 'padding: 8px 12px; cursor: pointer; font-size: 13px; color: var(--bs-body-color, #e0e0e0); transition: background 0.15s;';
          itemDiv.textContent = item[labelField] || item.name || 'Item ' + item.id;
          itemDiv.dataset.id = item.id;
          
          itemDiv.addEventListener('mouseenter', () => {
            itemDiv.style.background = 'var(--bs-primary, #8b5cf6)';
            itemDiv.style.color = 'white';
          });
          itemDiv.addEventListener('mouseleave', () => {
            itemDiv.style.background = 'transparent';
            itemDiv.style.color = 'var(--bs-body-color, #e0e0e0)';
          });
          itemDiv.addEventListener('click', () => {
            selectElement.value = item.id;
            searchInput.value = item[labelField] || item.name;
            resultsDiv.style.display = 'none';
            searchInput.style.borderRadius = '6px';
            selectElement.dispatchEvent(new Event('change'));
          });
          
          resultsDiv.appendChild(itemDiv);
        });
      }
      
      resultsDiv.style.display = 'block';
      searchInput.style.borderRadius = '6px 6px 0 0';
    }
    
    // Events
    searchInput.addEventListener('focus', () => renderItems(searchInput.value));
    searchInput.addEventListener('input', () => renderItems(searchInput.value));
    searchInput.addEventListener('blur', () => {
      // Delay to allow click on item
      setTimeout(() => {
        resultsDiv.style.display = 'none';
        searchInput.style.borderRadius = '6px';
      }, 200);
    });
    
    // If there's a pre-selected value, show it
    if (selectElement.value) {
      const selected = items.find(i => String(i.id) === String(selectElement.value));
      if (selected) {
        searchInput.value = selected[labelField] || selected.name;
      }
    }
  }
  
