<%# Workflow Designer Canvas - Visual builder for automations and integrations %>
<% data = canvas_data || {} %>

<div class="workflow-designer-canvas" id="workflow-designer-<%= SecureRandom.hex(4) %>">
  <div class="workflow-designer-layout">
    <!-- Component Sidebar -->
    <div class="workflow-component-panel">
      <div class="component-panel-header">
        <i data-lucide="puzzle" style="width: 16px; height: 16px;"></i>
        <span>Components</span>
      </div>
      
      <div class="component-panel-search">
        <input type="text" placeholder="Search components..." id="component-search">
      </div>
      
      <div class="component-panel-body">
        <!-- Triggers -->
        <div class="component-section">
          <div class="section-header">
            <i data-lucide="zap" style="width: 14px; height: 14px;"></i>
            TRIGGERS
          </div>
          <div class="component-item" draggable="true" data-type="trigger-webhook">
            <i data-lucide="webhook" style="width: 16px; height: 16px;"></i>
            <span>Webhook</span>
          </div>
          <div class="component-item" draggable="true" data-type="trigger-schedule">
            <i data-lucide="clock" style="width: 16px; height: 16px;"></i>
            <span>Schedule</span>
          </div>
          <div class="component-item" draggable="true" data-type="trigger-event">
            <i data-lucide="bell" style="width: 16px; height: 16px;"></i>
            <span>Event</span>
          </div>
          <div class="component-item" draggable="true" data-type="trigger-form">
            <i data-lucide="file-input" style="width: 16px; height: 16px;"></i>
            <span>Form Submit</span>
          </div>
        </div>
        
        <!-- Actions -->
        <div class="component-section">
          <div class="section-header">
            <i data-lucide="play" style="width: 14px; height: 14px;"></i>
            ACTIONS
          </div>
          <div class="component-item" draggable="true" data-type="action-email">
            <i data-lucide="mail" style="width: 16px; height: 16px;"></i>
            <span>Send Email</span>
          </div>
          <div class="component-item" draggable="true" data-type="action-sms">
            <i data-lucide="message-square" style="width: 16px; height: 16px;"></i>
            <span>Send SMS</span>
          </div>
          <div class="component-item" draggable="true" data-type="action-http">
            <i data-lucide="globe" style="width: 16px; height: 16px;"></i>
            <span>HTTP Request</span>
          </div>
          <div class="component-item" draggable="true" data-type="action-update">
            <i data-lucide="edit-3" style="width: 16px; height: 16px;"></i>
            <span>Update Record</span>
          </div>
          <div class="component-item" draggable="true" data-type="action-create">
            <i data-lucide="plus-circle" style="width: 16px; height: 16px;"></i>
            <span>Create Record</span>
          </div>
          <div class="component-item" draggable="true" data-type="action-ai">
            <i data-lucide="sparkles" style="width: 16px; height: 16px;"></i>
            <span>AI Action</span>
          </div>
        </div>
        
        <!-- Logic -->
        <div class="component-section">
          <div class="section-header">
            <i data-lucide="git-branch" style="width: 14px; height: 14px;"></i>
            LOGIC
          </div>
          <div class="component-item" draggable="true" data-type="logic-condition">
            <i data-lucide="git-branch" style="width: 16px; height: 16px;"></i>
            <span>Condition</span>
          </div>
          <div class="component-item" draggable="true" data-type="logic-loop">
            <i data-lucide="repeat" style="width: 16px; height: 16px;"></i>
            <span>Loop</span>
          </div>
          <div class="component-item" draggable="true" data-type="logic-delay">
            <i data-lucide="timer" style="width: 16px; height: 16px;"></i>
            <span>Delay</span>
          </div>
          <div class="component-item" draggable="true" data-type="logic-filter">
            <i data-lucide="filter" style="width: 16px; height: 16px;"></i>
            <span>Filter</span>
          </div>
        </div>
        
        <!-- Integrations -->
        <div class="component-section">
          <div class="section-header">
            <i data-lucide="plug" style="width: 14px; height: 14px;"></i>
            INTEGRATIONS
          </div>
          <div class="component-item" draggable="true" data-type="integration-slack">
            <i data-lucide="hash" style="width: 16px; height: 16px;"></i>
            <span>Slack</span>
          </div>
          <div class="component-item" draggable="true" data-type="integration-stripe">
            <i data-lucide="credit-card" style="width: 16px; height: 16px;"></i>
            <span>Stripe</span>
          </div>
          <div class="component-item" draggable="true" data-type="integration-api">
            <i data-lucide="code" style="width: 16px; height: 16px;"></i>
            <span>Custom API</span>
          </div>
        </div>
      </div>
    </div>
    
    <!-- Main Content Area -->
    <div class="workflow-main-content">
      <!-- Header -->
      <div class="designer-header">
    <div class="designer-header-left">
      <i data-lucide="git-branch" class="designer-icon"></i>
      <div>
        <h4 class="designer-title"><%= data[:workflow_name] || 'Workflow Designer' %></h4>
        <p class="designer-subtitle">Build automations visually</p>
      </div>
    </div>
    <div class="designer-header-right">
      <button type="button" class="designer-btn" id="undo-btn" title="Undo">
        <i data-lucide="undo-2"></i>
      </button>
      <button type="button" class="designer-btn" id="redo-btn" title="Redo">
        <i data-lucide="redo-2"></i>
      </button>
      <div class="designer-divider"></div>
      <button type="button" class="designer-btn" id="zoom-out-btn" title="Zoom out">
        <i data-lucide="zoom-out"></i>
      </button>
      <span class="zoom-level">100%</span>
      <button type="button" class="designer-btn" id="zoom-in-btn" title="Zoom in">
        <i data-lucide="zoom-in"></i>
      </button>
      <div class="designer-divider"></div>
      <button type="button" class="designer-btn-primary" id="save-workflow-btn">
        <i data-lucide="save"></i>
        Save
      </button>
      <button type="button" class="designer-btn-accent" id="run-workflow-btn">
        <i data-lucide="play"></i>
        Test Run
      </button>
    </div>
  </div>
  
  <!-- Workflow Canvas (full width now) -->
  <div class="workflow-canvas" id="workflow-canvas">
    <div class="canvas-grid"></div>
    
    <!-- Empty state -->
    <div class="canvas-empty-state" id="canvas-empty-state">
      <div class="empty-icon">
        <i data-lucide="workflow"></i>
      </div>
      <h5>Start Building Your Workflow</h5>
      <p>Drag components from the panel or click a trigger to begin</p>
      <div class="quick-triggers">
        <button type="button" class="quick-trigger" data-trigger="webhook">
          <i data-lucide="webhook"></i>
          Webhook
        </button>
        <button type="button" class="quick-trigger" data-trigger="schedule">
          <i data-lucide="clock"></i>
          Schedule
        </button>
        <button type="button" class="quick-trigger" data-trigger="event">
          <i data-lucide="bell"></i>
          Event
        </button>
      </div>
    </div>
    
    <!-- Nodes will be rendered here dynamically -->
    <div class="workflow-nodes" id="workflow-nodes"></div>
    
    <!-- Connections SVG layer -->
    <svg class="workflow-connections" id="workflow-connections"></svg>
  </div>
  
  <!-- Properties Panel (shown when node selected) -->
  <div class="properties-panel" id="properties-panel" style="display: none;">
    <div class="properties-header">
      <h5>Node Properties</h5>
      <button type="button" class="close-properties">
        <i data-lucide="x"></i>
      </button>
    </div>
    <div class="properties-content">
      <!-- Dynamically populated -->
    </div>
  </div>
    </div><!-- End workflow-main-content -->
  </div><!-- End workflow-designer-layout -->
</div>

<style>
  /* Layout */
  .workflow-designer-layout {
    display: flex;
    flex: 1;
    height: 100%;
    overflow: hidden;
  }
  
  /* Component Panel */
  .workflow-component-panel {
    width: 240px;
    min-width: 240px;
    background: #1e1e2e;
    border-right: 1px solid #3a3a4a;
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }
  
  .component-panel-header {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 12px 16px;
    border-bottom: 1px solid #3a3a4a;
    background: #252536;
    color: #e0e0e0;
    font-weight: 600;
    font-size: 0.875rem;
  }
  
  .component-panel-search {
    padding: 8px 12px;
    border-bottom: 1px solid #3a3a4a;
  }
  
  .component-panel-search input {
    width: 100%;
    padding: 6px 10px;
    border: 1px solid #3a3a4a;
    border-radius: 4px;
    background: #1a1a2a;
    color: #e0e0e0;
    font-size: 0.75rem;
  }
  
  .component-panel-search input::placeholder {
    color: #6b7280;
  }
  
  .component-panel-body {
    flex: 1;
    overflow-y: auto;
    padding: 8px;
  }
  
  .component-section {
    margin-bottom: 16px;
  }
  
  .section-header {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 8px 8px 6px;
    font-size: 0.65rem;
    font-weight: 600;
    color: #6b7280;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }
  
  .component-item {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 8px 10px;
    border: 1px dashed #3a3a4a;
    border-radius: 6px;
    margin-bottom: 4px;
    cursor: grab;
    transition: all 0.15s ease;
    color: #a0a0a0;
    font-size: 0.8125rem;
  }
  
  .component-item:hover {
    background: rgba(139, 92, 246, 0.1);
    border-color: #8b5cf6;
    color: #e0e0e0;
  }
  
  .component-item:active {
    cursor: grabbing;
  }
  
  .workflow-main-content {
    flex: 1;
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }
  
  .workflow-designer-canvas {
    display: flex;
    flex-direction: column;
    height: 100%;
    background: #1a1a2a;
    color: #e0e0e0;
  }
  
  .designer-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.5rem 1rem;
    border-bottom: 1px solid #3a3a4a;
    background: #252536;
    flex-shrink: 0;
  }
  
  .designer-header-left {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  
  .designer-icon {
    width: 20px;
    height: 20px;
    color: #8b5cf6;
  }
  
  .designer-title {
    margin: 0;
    font-size: 0.9375rem;
    font-weight: 600;
    color: #e0e0e0;
  }
  
  .designer-subtitle {
    margin: 0;
    font-size: 0.6875rem;
    color: #a0a0a0;
  }
  
  .designer-header-right {
    display: flex;
    align-items: center;
    gap: 0.375rem;
  }
  
  .designer-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0.375rem;
    border: none;
    border-radius: 4px;
    background: transparent;
    color: #a0a0a0;
    cursor: pointer;
    transition: all 0.15s;
  }
  
  .designer-btn:hover {
    background: rgba(255,255,255,0.08);
    color: #e0e0e0;
  }
  
  .designer-btn i {
    width: 14px;
    height: 14px;
  }
  
  .designer-divider {
    width: 1px;
    height: 16px;
    background: #3a3a4a;
    margin: 0 0.25rem;
  }
  
  .zoom-level {
    font-size: 0.6875rem;
    color: #a0a0a0;
    min-width: 36px;
    text-align: center;
  }
  
  .designer-btn-primary,
  .designer-btn-accent {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0.375rem 0.625rem;
    border: none;
    border-radius: 4px;
    font-size: 0.75rem;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.15s;
  }
  
  .designer-btn-primary {
    background: #3a3a4a;
    color: #e0e0e0;
  }
  
  .designer-btn-primary:hover {
    background: rgba(255,255,255,0.12);
  }
  
  .designer-btn-accent {
    background: linear-gradient(135deg, #8b5cf6 0%, #7c3aed 100%);
    color: white;
  }
  
  .designer-btn-accent:hover {
    filter: brightness(1.1);
  }
  
  .designer-btn-primary i,
  .designer-btn-accent i {
    width: 12px;
    height: 12px;
  }
  
  /* Workflow Canvas - full width */
  .workflow-canvas {
    flex: 1;
    position: relative;
    overflow: hidden;
    background: #1a1a2a;
  }
  
  .canvas-grid {
    position: absolute;
    inset: 0;
    background-image: 
      radial-gradient(circle, rgba(255,255,255,0.04) 1px, transparent 1px);
    background-size: 20px 20px;
    pointer-events: none;
  }
  
  .canvas-empty-state {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    text-align: center;
    color: #a0a0a0;
  }
  
  .empty-icon {
    margin-bottom: 0.75rem;
  }
  
  .empty-icon i {
    width: 40px;
    height: 40px;
    opacity: 0.4;
  }
  
  .canvas-empty-state h5 {
    margin: 0 0 0.375rem;
    font-size: 1rem;
    color: #e0e0e0;
  }
  
  .canvas-empty-state p {
    margin: 0 0 1.25rem;
    font-size: 0.8125rem;
  }
  
  .quick-triggers {
    display: flex;
    gap: 0.625rem;
    justify-content: center;
  }
  
  .quick-trigger {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.375rem;
    padding: 0.75rem 1.25rem;
    border: 1px dashed #3a3a4a;
    border-radius: 8px;
    background: transparent;
    color: #a0a0a0;
    cursor: pointer;
    transition: all 0.15s;
    font-size: 0.75rem;
  }
  
  .quick-trigger:hover {
    border-color: #22c55e;
    border-style: solid;
    color: #22c55e;
    background: rgba(34, 197, 94, 0.08);
  }
  
  .quick-trigger i {
    width: 20px;
    height: 20px;
  }
  
  .workflow-nodes {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  
  .workflow-connections {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  
  /* Properties Panel */
  .properties-panel {
    position: absolute;
    right: 0;
    top: 0;
    bottom: 0;
    width: 280px;
    border-left: 1px solid #3a3a4a;
    background: #252536;
    display: flex;
    flex-direction: column;
    z-index: 10;
  }
  
  .properties-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.625rem 0.75rem;
    border-bottom: 1px solid #3a3a4a;
  }
  
  .properties-header h5 {
    margin: 0;
    font-size: 0.8125rem;
    color: #e0e0e0;
  }
  
  .close-properties {
    display: flex;
    padding: 0.25rem;
    border: none;
    border-radius: 4px;
    background: transparent;
    color: #a0a0a0;
    cursor: pointer;
  }
  
  .close-properties:hover {
    background: rgba(255,255,255,0.08);
  }
  
  .close-properties i {
    width: 14px;
    height: 14px;
  }
  
  .properties-content {
    flex: 1;
    padding: 0.75rem;
    overflow-y: auto;
  }
  
  /* ==================== Light Mode ==================== */
  [data-theme="light"] .workflow-designer-canvas {
    background: #f8f9fa;
    color: #1a1a2e;
  }
  
  [data-theme="light"] .workflow-component-panel {
    background: #ffffff;
    border-color: #e5e7eb;
  }
  
  [data-theme="light"] .component-panel-header {
    background: #f8f9fa;
    border-color: #e5e7eb;
    color: #1a1a2e;
  }
  
  [data-theme="light"] .component-panel-search input {
    background: #ffffff;
    border-color: #d1d5db;
    color: #1a1a2e;
  }
  
  [data-theme="light"] .section-header {
    color: #6b7280;
  }
  
  [data-theme="light"] .component-item {
    background: #ffffff;
    border-color: #d1d5db;
    color: #4b5563;
  }
  
  [data-theme="light"] .component-item:hover {
    background: rgba(139, 92, 246, 0.08);
    border-color: #8b5cf6;
    color: #1a1a2e;
  }
  
  [data-theme="light"] .designer-header {
    background: #ffffff;
    border-color: #e5e7eb;
  }
  
  [data-theme="light"] .designer-title {
    color: #1a1a2e;
  }
  
  [data-theme="light"] .designer-subtitle {
    color: #6b7280;
  }
  
  [data-theme="light"] .designer-btn {
    color: #6b7280;
  }
  
  [data-theme="light"] .designer-btn:hover {
    background: rgba(0,0,0,0.05);
    color: #1a1a2e;
  }
  
  [data-theme="light"] .designer-divider {
    background: #e5e7eb;
  }
  
  [data-theme="light"] .zoom-level {
    color: #6b7280;
  }
  
  [data-theme="light"] .designer-btn-primary {
    background: #f3f4f6;
    color: #1a1a2e;
  }
  
  [data-theme="light"] .designer-btn-primary:hover {
    background: #e5e7eb;
  }
  
  [data-theme="light"] .workflow-canvas {
    background: #f3f4f6;
  }
  
  [data-theme="light"] .canvas-grid {
    background-image: 
      radial-gradient(circle, rgba(0,0,0,0.06) 1px, transparent 1px);
  }
  
  [data-theme="light"] .canvas-empty-state {
    color: #6b7280;
  }
  
  [data-theme="light"] .canvas-empty-state h5 {
    color: #1a1a2e;
  }
  
  [data-theme="light"] .quick-trigger {
    background: #ffffff;
    border-color: #d1d5db;
    color: #4b5563;
  }
  
  [data-theme="light"] .quick-trigger:hover {
    border-color: #8b5cf6;
    color: #8b5cf6;
  }
  
  [data-theme="light"] .properties-panel {
    background: #ffffff;
    border-color: #e5e7eb;
  }
  
  [data-theme="light"] .properties-header {
    background: #f8f9fa;
    border-color: #e5e7eb;
  }
  
  [data-theme="light"] .properties-header h5 {
    color: #1a1a2e;
  }
  
  [data-theme="light"] .close-properties {
    color: #6b7280;
  }
  
  [data-theme="light"] .close-properties:hover {
    background: #f3f4f6;
    color: #1a1a2e;
  }
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
  const container = document.querySelector('.workflow-designer-canvas');
  if (!container) return;
  
  // Handle drop from design panel components
  const canvas = container.querySelector('#workflow-canvas');
  if (canvas) {
    canvas.addEventListener('dragover', function(e) {
      e.preventDefault();
      e.dataTransfer.dropEffect = 'copy';
    });
    
    canvas.addEventListener('drop', function(e) {
      e.preventDefault();
      try {
        const data = JSON.parse(e.dataTransfer.getData('application/json'));
        console.log('Dropped on workflow canvas:', data);
        
        // Hide empty state when first node added
        const emptyState = document.getElementById('canvas-empty-state');
        if (emptyState) emptyState.style.display = 'none';
        
        // TODO: Create workflow node at drop position
      } catch (err) {
        console.log('Invalid drop data');
      }
    });
  }
  
  // Quick trigger buttons
  container.querySelectorAll('.quick-trigger').forEach(btn => {
    btn.addEventListener('click', function() {
      const trigger = this.dataset.trigger;
      console.log('Add trigger:', trigger);
      
      // Hide empty state
      const emptyState = document.getElementById('canvas-empty-state');
      if (emptyState) emptyState.style.display = 'none';
      
      // TODO: Create trigger node
    });
  });
  
  // Init icons
  if (typeof lucide !== 'undefined') {
    lucide.createIcons();
  }
});
</script>
