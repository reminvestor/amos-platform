  /* Workflow Canvas - full width */
  .workflow-canvas {
    flex: 1;
    position: relative;
    overflow: hidden;
    background: #1a1a2a;
    cursor: grab;
  }
  
  .workflow-canvas.panning {
    cursor: grabbing;
  }
  
  .canvas-grid {
    position: absolute;
    width: 5000px;
    height: 5000px;
    left: -2500px;
    top: -2500px;
    background-image: 
      radial-gradient(circle, rgba(255,255,255,0.04) 1px, transparent 1px);
    background-size: 20px 20px;
    pointer-events: none;
    transform-origin: center center;
  }
  
  .workflow-transform-container {
    position: absolute;
    width: 5000px;
    height: 5000px;
    left: 0;
    top: 0;
    transform-origin: 0 0;
    transition: none;
  }
  
  .canvas-pan-hint {
    position: absolute;
    bottom: 12px;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 6px 12px;
    background: rgba(0, 0, 0, 0.6);
    border-radius: 20px;
    font-size: 11px;
    color: #a0a0a0;
    pointer-events: none;
    opacity: 0.7;
    z-index: 100;
  }
  
  .canvas-empty-state {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    color: #a0a0a0;
    z-index: 50;
    pointer-events: none;
  }
  
  .canvas-empty-state .quick-triggers {
    pointer-events: auto;
  }
  
  .canvas-empty-state h5,
  .canvas-empty-state p {
    pointer-events: none;
  }
  
  .canvas-empty-state .empty-state-divider {
    display: flex;
    align-items: center;
    gap: 12px;
    margin: 20px 0 16px;
    pointer-events: none;
    width: 100%;
    max-width: 300px;
  }
  
  .canvas-empty-state .empty-state-divider::before,
  .canvas-empty-state .empty-state-divider::after {
    content: '';
    flex: 1;
    height: 1px;
    background: rgba(139, 92, 246, 0.3);
  }
  
  .canvas-empty-state .empty-state-divider span {
