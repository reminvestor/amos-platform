  .workflow-nodes {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  
  .workflow-connections {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  
  /* Connection Ports - Enhanced visibility */
  .node-port {
    position: absolute;
    width: 14px;
    height: 14px;
    border-radius: 50%;
    border: 2px solid var(--bs-body-bg, #1a1a2e);
    cursor: crosshair;
    z-index: 20;
    transition: transform 0.15s, box-shadow 0.15s;
    pointer-events: auto;
  }
  
  .node-port:hover {
    transform: scale(1.4);
    box-shadow: 0 0 8px currentColor;
  }
  
  .node-port.port-active {
    animation: port-pulse 0.8s infinite;
  }
  
  @keyframes port-pulse {
    0%, 100% { transform: scale(1); box-shadow: 0 0 0 0 currentColor; }
    50% { transform: scale(1.3); box-shadow: 0 0 12px currentColor; }
  }
  
  .node-port-top { top: -7px; left: 50%; transform: translateX(-50%); }
  .node-port-bottom { bottom: -7px; left: 50%; transform: translateX(-50%); }
  .node-port-left { left: -7px; top: 50%; transform: translateY(-50%); }
  .node-port-right { right: -7px; top: 50%; transform: translateY(-50%); }
  
  .node-port-top:hover, .node-port-bottom:hover { transform: translateX(-50%) scale(1.4); }
  .node-port-left:hover, .node-port-right:hover { transform: translateY(-50%) scale(1.4); }
  
  /* Connection lines */
  .workflow-connection-line {
    stroke: #8b5cf6;
    stroke-width: 2;
    fill: none;
    transition: stroke-width 0.15s, stroke 0.15s;
  }
  
  .workflow-connection-line:hover {
    stroke: #a78bfa;
    stroke-width: 3;
    filter: drop-shadow(0 0 4px rgba(139, 92, 246, 0.5));
  }
  
  /* Connection preview line */
  .connection-preview {
    stroke: #8b5cf6;
    stroke-width: 2;
    stroke-dasharray: 8 4;
    fill: none;
    pointer-events: none;
  }
  
  /* Workflow node when connecting */
  .workflow-node.connection-target {
    outline: 2px dashed #8b5cf6;
    outline-offset: 4px;
  }
  
  /* Properties Panel */
  .properties-panel {
    position: absolute;
    right: 0;
    top: 0;
    bottom: 0;
    width: 280px;
    border-left: 1px solid #3a3a4a;
    background: #252536;
    display: flex;
    flex-direction: column;
    z-index: 10;
  }
  
  .properties-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.625rem 0.75rem;
    border-bottom: 1px solid #3a3a4a;
  }
  
