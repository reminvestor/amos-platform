  async function fetchIntegrationOperations(selectElement, integrationSlug, connectionId, selectedValue) {
    try {
      let url = '/scout/workflow_items?type=integration_operations';
      if (connectionId) url += '&connection_id=' + encodeURIComponent(connectionId);
      if (integrationSlug) url += '&integration_slug=' + encodeURIComponent(integrationSlug);
      
      console.log('🔌 Fetching operations:', url);
      const response = await fetch(url);
      const data = await response.json();
      
      selectElement.innerHTML = '<option value="">Select operation...</option>';
      
      // Group by read/write
      const reads = (data.items || []).filter(op => op.is_read);
      const writes = (data.items || []).filter(op => !op.is_read);
      
      if (reads.length > 0) {
        selectElement.innerHTML += '<optgroup label="📖 Read Operations">';
        reads.forEach(op => {
          const selected = op.operation_id === selectedValue ? 'selected' : '';
          selectElement.innerHTML += `<option value="${op.operation_id}" 
            data-description="${escapeHtml(op.description || '')}"
            data-method="${op.http_method}"
            data-isread="true"
            ${selected}>${op.name}</option>`;
        });
        selectElement.innerHTML += '</optgroup>';
      }
      
      if (writes.length > 0) {
        selectElement.innerHTML += '<optgroup label="✏️ Write Operations">';
        writes.forEach(op => {
          const selected = op.operation_id === selectedValue ? 'selected' : '';
          selectElement.innerHTML += `<option value="${op.operation_id}" 
            data-description="${escapeHtml(op.description || '')}"
            data-method="${op.http_method}"
            data-isread="false"
            ${selected}>${op.name}</option>`;
        });
        selectElement.innerHTML += '</optgroup>';
      }
      
      if ((data.items || []).length === 0) {
        selectElement.innerHTML = '<option value="">No operations available</option>';
      }
      
      // Trigger change event if there's a selected value to show details
      if (selectedValue && selectElement.value) {
        selectElement.dispatchEvent(new Event('change'));
      }
      
      console.log('🔌 Loaded', (data.items || []).length, 'operations');
    } catch (err) {
      console.error('Failed to load operations:', err);
      selectElement.innerHTML = '<option value="">Failed to load operations</option>';
    }
  }
  
  function escapeHtml(text) {
    const div = document.createElement('div');
    div.textContent = text;
    return div.innerHTML;
  }
  
