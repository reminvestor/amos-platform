  .quick-trigger {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.375rem;
    padding: 0.75rem 1.25rem;
    border: 1px dashed #3a3a4a;
    border-radius: 8px;
    background: transparent;
