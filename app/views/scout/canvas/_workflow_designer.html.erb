          <div style="margin-bottom: 16px;">
            <label style="display: block; font-size: 12px; color: var(--bs-secondary-color, #6b7280); margin-bottom: 6px;">Output Variable Name</label>
            <input type="text" id="prop-merge-output" placeholder="merged_results" value="${data.config?.output_variable || 'merged_results'}" style="width: 100%; padding: 8px 12px; background: var(--bs-tertiary-bg, #252540); border: 1px solid var(--bs-border-color, #333); border-radius: 6px; color: var(--bs-body-color, #fff); font-family: monospace; font-size: 12px;">
            <p style="font-size: 11px; color: var(--bs-secondary-color, #6b7280); margin-top: 4px;">Access combined data via {{merged_results}}</p>
          </div>
        `;
      } else {
