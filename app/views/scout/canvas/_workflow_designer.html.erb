          </div>
          <div style="margin-bottom: 16px;">
            <label style="display: block; font-size: 12px; color: var(--bs-secondary-color, #6b7280); margin-bottom: 6px;">Time</label>
            <input type="time" id="prop-time" value="09:00" style="width: 100%; padding: 8px 12px; background: var(--bs-tertiary-bg, #252540); border: 1px solid var(--bs-border-color, #333); border-radius: 6px; color: var(--bs-body-color, #fff);">
          </div>
        `;
      } else if (subtype === 'form') {
        formHtml += `
          <div style="margin-bottom: 16px;">
            <label style="display: block; font-size: 12px; color: var(--bs-secondary-color, #6b7280); margin-bottom: 6px;">Form Source</label>
            <select id="prop-form-source" style="width: 100%; padding: 8px 12px; background: var(--bs-tertiary-bg, #252540); border: 1px solid var(--bs-border-color, #333); border-radius: 6px; color: var(--bs-body-color, #fff);">
              <option value="">Select source type...</option>
              <option value="landing_page">Landing Page</option>
              <option value="contact_form">Contact Form</option>
              <option value="app_module">App Module Form</option>
            </select>
          </div>
          <div id="prop-form-select-container" style="margin-bottom: 16px; display: none;">
            <label style="display: block; font-size: 12px; color: var(--bs-secondary-color, #6b7280); margin-bottom: 6px;">Select <span id="prop-form-label">Form</span></label>
            <select id="prop-form-item" style="width: 100%; padding: 8px 12px; background: var(--bs-tertiary-bg, #252540); border: 1px solid var(--bs-border-color, #333); border-radius: 6px; color: var(--bs-body-color, #fff);">
              <option value="">Loading...</option>
            </select>
          </div>
        `;
      }
    } else if (category === 'action') {
      if (subtype === 'email') {
        formHtml += `
          <div style="margin-bottom: 16px;">
            <label style="display: block; font-size: 12px; color: var(--bs-secondary-color, #6b7280); margin-bottom: 6px;">To (Email)</label>
            <input type="text" id="prop-to" placeholder="{{contact.email}}" style="width: 100%; padding: 8px 12px; background: var(--bs-tertiary-bg, #252540); border: 1px solid var(--bs-border-color, #333); border-radius: 6px; color: var(--bs-body-color, #fff);">
          </div>
