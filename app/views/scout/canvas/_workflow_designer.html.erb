  // Handle dynamic dropdowns based on selections
  function setupDynamicFormHandlers(category, subtype) {
    // Copy webhook URL button
    const copyWebhookBtn = document.getElementById('copy-webhook-url');
    if (copyWebhookBtn) {
      copyWebhookBtn.addEventListener('click', function() {
        const urlInput = document.getElementById('prop-webhook-url');
        if (urlInput && urlInput.value) {
          navigator.clipboard.writeText(urlInput.value).then(() => {
            this.textContent = '✓';
            setTimeout(() => { this.textContent = '📋'; }, 2000);
          });
        }
      });
    }
    
    // Record type selector (for Record Event trigger)
    const recordTypeSelect = document.getElementById('prop-record-type');
    if (recordTypeSelect) {
      recordTypeSelect.addEventListener('change', function() {
        const appModuleContainer = document.getElementById('prop-app-module-container');
        const moduleSelect = document.getElementById('prop-module');
        
        if (this.value === 'app_module') {
          appModuleContainer.style.display = 'block';
          if (moduleSelect) {
            fetchAppModules(moduleSelect);
          }
        } else {
          appModuleContainer.style.display = 'none';
        }
      });
      
      // Trigger change if app_module is already selected (for editing)
      if (recordTypeSelect.value === 'app_module') {
        recordTypeSelect.dispatchEvent(new Event('change'));
      }
    }
    
    // Load app modules for Record Event trigger (legacy fallback)
    const moduleSelect = document.getElementById('prop-module');
    if (moduleSelect && !recordTypeSelect) {
      fetchAppModules(moduleSelect);
    }
    
    // Delay type selector - show/hide until datetime field
    const delayTypeSelect = document.getElementById('prop-delay-type');
    if (delayTypeSelect) {
      delayTypeSelect.addEventListener('change', function() {
        const untilContainer = document.getElementById('prop-delay-until-container');
        const durationInputs = document.getElementById('prop-delay-value')?.parentElement;
        
        if (this.value === 'until_time' || this.value === 'until_date') {
          if (untilContainer) untilContainer.style.display = 'block';
          if (durationInputs) durationInputs.style.display = 'none';
        } else {
          if (untilContainer) untilContainer.style.display = 'none';
          if (durationInputs) durationInputs.style.display = 'flex';
        }
      });
      // Trigger on load if needed
      delayTypeSelect.dispatchEvent(new Event('change'));
    }
    
    // Form source selector
    const formSourceSelect = document.getElementById('prop-form-source');
    if (formSourceSelect) {
      formSourceSelect.addEventListener('change', async function() {
        const container = document.getElementById('prop-form-select-container');
        const itemSelect = document.getElementById('prop-form-item');
        const label = document.getElementById('prop-form-label');
        
        if (!this.value) {
          container.style.display = 'none';
          return;
        }
        
        container.style.display = 'block';
        itemSelect.innerHTML = '<option value="">Loading...</option>';
        
        // Update label based on source type
        const labels = {
          'landing_page': 'Landing Page',
          'contact_form': 'Contact Form',
          'app_module': 'App Module'
        };
        label.textContent = labels[this.value] || 'Form';
        
        // Fetch items from server
        try {
          const sourceType = this.value;
          const response = await fetch('/scout/workflow_items?type=' + sourceType);
          const data = await response.json();
          
          // Remove any existing searchable wrapper
          const existingWrapper = itemSelect.closest('.searchable-dropdown');
          if (existingWrapper) {
            existingWrapper.parentNode.insertBefore(itemSelect, existingWrapper);
            existingWrapper.remove();
          }
          itemSelect.style.display = '';
          
          itemSelect.innerHTML = '<option value="">Select ' + (labels[sourceType] || 'item') + '...</option>';
          (data.items || []).forEach(item => {
            itemSelect.innerHTML += '<option value="' + item.id + '">' + item.name + '</option>';
          });
          
          // Convert to searchable if more than 10 items
          if ((data.items || []).length > 10) {
            makeSearchable(itemSelect, data.items, 'Select ' + (labels[sourceType] || 'item') + '...', 'name');
          }
        } catch (err) {
          console.error('Failed to load items:', err);
          // Fallback to placeholder options
          itemSelect.innerHTML = '<option value="">Select ' + (labels[this.value] || 'item') + '...</option>';
          if (this.value === 'landing_page') {
            itemSelect.innerHTML += '<option value="demo">Demo Landing Page</option>';
          } else if (this.value === 'contact_form') {
            itemSelect.innerHTML += '<option value="main">Main Contact Form</option>';
          } else if (this.value === 'app_module') {
            itemSelect.innerHTML += '<option value="crm">CRM Module</option>';
          }
        }
      });
    }
    
    // Email template selector - fetch real templates
    const templateSelect = document.getElementById('prop-template');
    if (templateSelect) {
      // Fetch email templates on modal open
      fetchEmailTemplates(templateSelect);
      
      templateSelect.addEventListener('change', function() {
        console.log('Template selected:', this.value);
      });
    }
    
    // Integration operations selector
    const operationSelect = document.getElementById('prop-operation');
    if (operationSelect) {
      const integrationSlug = document.getElementById('prop-integration-slug')?.value;
      const connectionId = document.getElementById('prop-connection-id')?.value;
      const selectedOperation = operationSelect.dataset.selected || '';
      
      // Fetch operations for this integration
      fetchIntegrationOperations(operationSelect, integrationSlug, connectionId, selectedOperation);
      
      // Show details when operation is selected
      operationSelect.addEventListener('change', function() {
        const detailsDiv = document.getElementById('prop-operation-details');
        const descDiv = document.getElementById('prop-operation-description');
        const methodSpan = document.getElementById('prop-operation-method');
        const typeSpan = document.getElementById('prop-operation-type');
        
        const option = this.options[this.selectedIndex];
        if (option && option.value) {
          const description = option.dataset.description || 'No description';
          const method = option.dataset.method || 'GET';
          const isRead = option.dataset.isread === 'true';
          
          descDiv.textContent = description;
          methodSpan.textContent = method;
          methodSpan.style.background = method === 'GET' ? '#10b981' : 
                                        method === 'POST' ? '#3b82f6' : 
                                        method === 'DELETE' ? '#ef4444' : '#f59e0b';
          methodSpan.style.color = 'white';
          typeSpan.textContent = isRead ? 'Read operation' : 'Write operation';
          
          detailsDiv.style.display = 'block';
        } else {
          detailsDiv.style.display = 'none';
        }
      });
    }
  }
  
  async function fetchIntegrationOperations(selectElement, integrationSlug, connectionId, selectedValue) {
    try {
      let url = '/scout/workflow_items?type=integration_operations';
      if (connectionId) url += '&connection_id=' + encodeURIComponent(connectionId);
      if (integrationSlug) url += '&integration_slug=' + encodeURIComponent(integrationSlug);
      
      console.log('🔌 Fetching operations:', url);
      const response = await fetch(url);
      const data = await response.json();
      
      selectElement.innerHTML = '<option value="">Select operation...</option>';
      
      // Group by read/write
      const reads = (data.items || []).filter(op => op.is_read);
      const writes = (data.items || []).filter(op => !op.is_read);
      
      if (reads.length > 0) {
        selectElement.innerHTML += '<optgroup label="📖 Read Operations">';
        reads.forEach(op => {
          const selected = op.operation_id === selectedValue ? 'selected' : '';
          selectElement.innerHTML += `<option value="${op.operation_id}" 
            data-description="${escapeHtml(op.description || '')}"
            data-method="${op.http_method}"
            data-isread="true"
            ${selected}>${op.name}</option>`;
        });
        selectElement.innerHTML += '</optgroup>';
      }
      
      if (writes.length > 0) {
        selectElement.innerHTML += '<optgroup label="✏️ Write Operations">';
        writes.forEach(op => {
          const selected = op.operation_id === selectedValue ? 'selected' : '';
          selectElement.innerHTML += `<option value="${op.operation_id}" 
            data-description="${escapeHtml(op.description || '')}"
            data-method="${op.http_method}"
            data-isread="false"
            ${selected}>${op.name}</option>`;
        });
        selectElement.innerHTML += '</optgroup>';
      }
      
      if ((data.items || []).length === 0) {
        selectElement.innerHTML = '<option value="">No operations available</option>';
      }
      
      // Convert to searchable if more than 10 items
      if ((data.items || []).length > 10) {
        const searchItems = (data.items || []).map(op => ({ id: op.operation_id, name: op.name, ...op }));
        makeSearchable(selectElement, searchItems, 'Select operation...', 'name');
      }
      
      // Trigger change event if there's a selected value to show details
      if (selectedValue && selectElement.value) {
        selectElement.dispatchEvent(new Event('change'));
      }
      
      console.log('🔌 Loaded', (data.items || []).length, 'operations');
    } catch (err) {
      console.error('Failed to load operations:', err);
      selectElement.innerHTML = '<option value="">Failed to load operations</option>';
    }
  }
  
