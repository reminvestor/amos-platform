    background: #f8f9fa;
    border-color: #e5e7eb;
  }
  
  [data-theme="light"] .properties-header h5,
  [data-bs-theme="light"] .properties-header h5 {
    color: #1a1a2e;
  }
  
  [data-theme="light"] .close-properties,
  [data-bs-theme="light"] .close-properties {
    color: #6b7280;
  }
  
  [data-theme="light"] .close-properties:hover,
  [data-bs-theme="light"] .close-properties:hover {
    background: #f3f4f6;
    color: #1a1a2e;
  }
  
  [data-theme="light"] .canvas-pan-hint,
  [data-bs-theme="light"] .canvas-pan-hint {
    background: rgba(255, 255, 255, 0.9);
    color: #6b7280;
    box-shadow: 0 2px 8px rgba(0,0,0,0.1);
  }
  
  [data-theme="light"] .node-port,
  [data-bs-theme="light"] .node-port {
    border-color: #ffffff;
  }
  
  [data-theme="light"] .workflow-node.connection-target,
  [data-bs-theme="light"] .workflow-node.connection-target {
    outline-color: #7c3aed;
  }
</style>

<script>
(function() {
  // IIFE for immediate execution when loaded via AJAX
  console.log('🔧 Workflow Designer: Initializing...');
  
  const container = document.querySelector('.workflow-designer-canvas');
  if (!container) {
    console.warn('Workflow designer container not found');
    return;
  }
  
  const canvas = container.querySelector('#workflow-canvas');
  const transformContainer = container.querySelector('#workflow-transform-container');
  const canvasGrid = container.querySelector('#canvas-grid');
  const componentSearch = container.querySelector('#component-search');
  let nodeIdCounter = 0;
  
  // ========== Canvas Pan & Zoom State ==========
  let panState = {
    x: 0,
    y: 0,
    scale: 1,
    isPanning: false,
    startX: 0,
    startY: 0,
    startPanX: 0,
    startPanY: 0
  };
  
  // Center the canvas initially
  function centerCanvas() {
    if (!canvas || !transformContainer) return;
    const rect = canvas.getBoundingClientRect();
    // Start with the center of the transform container visible in the center of the canvas
    panState.x = rect.width / 2 - 2500;
    panState.y = rect.height / 2 - 2500;
    applyTransform();
  }
  
  function applyTransform() {
    if (transformContainer) {
      transformContainer.style.transform = `translate(${panState.x}px, ${panState.y}px) scale(${panState.scale})`;
    }
    if (canvasGrid) {
      canvasGrid.style.transform = `translate(${panState.x}px, ${panState.y}px) scale(${panState.scale})`;
    }
  }
  
  // ========== Canvas Panning ==========
  if (canvas) {
    canvas.addEventListener('mousedown', function(e) {
      // Only pan on direct canvas clicks (not on nodes or other elements)
      if (e.target === canvas || e.target === transformContainer || e.target.classList.contains('canvas-grid') || e.target.classList.contains('workflow-nodes')) {
        panState.isPanning = true;
        panState.startX = e.clientX;
        panState.startY = e.clientY;
        panState.startPanX = panState.x;
        panState.startPanY = panState.y;
        canvas.classList.add('panning');
        e.preventDefault();
      }
    });
    
    document.addEventListener('mousemove', function(e) {
      if (!panState.isPanning) return;
      const dx = e.clientX - panState.startX;
      const dy = e.clientY - panState.startY;
      panState.x = panState.startPanX + dx;
      panState.y = panState.startPanY + dy;
      applyTransform();
    });
    
    document.addEventListener('mouseup', function() {
      if (panState.isPanning) {
        panState.isPanning = false;
        canvas.classList.remove('panning');
      }
    });
    
    // Scroll to zoom
    canvas.addEventListener('wheel', function(e) {
      e.preventDefault();
      const delta = e.deltaY > 0 ? 0.9 : 1.1;
      const newScale = Math.max(0.25, Math.min(2, panState.scale * delta));
      
      // Zoom toward mouse position
      const rect = canvas.getBoundingClientRect();
      const mouseX = e.clientX - rect.left;
      const mouseY = e.clientY - rect.top;
      
      // Adjust pan to zoom toward cursor
      const scaleDiff = newScale / panState.scale;
      panState.x = mouseX - (mouseX - panState.x) * scaleDiff;
      panState.y = mouseY - (mouseY - panState.y) * scaleDiff;
      panState.scale = newScale;
      
      applyTransform();
      updateZoomDisplay();
    }, { passive: false });
  }
  
  function updateZoomDisplay() {
    const zoomLevel = container.querySelector('.zoom-level');
    if (zoomLevel) {
      zoomLevel.textContent = Math.round(panState.scale * 100) + '%';
    }
  }
  
  // Zoom buttons
  const zoomInBtn = container.querySelector('#zoom-in-btn');
  const zoomOutBtn = container.querySelector('#zoom-out-btn');
  
  if (zoomInBtn) {
    zoomInBtn.addEventListener('click', function() {
      panState.scale = Math.min(2, panState.scale * 1.2);
      applyTransform();
      updateZoomDisplay();
    });
  }
  
  if (zoomOutBtn) {
    zoomOutBtn.addEventListener('click', function() {
      panState.scale = Math.max(0.25, panState.scale / 1.2);
      applyTransform();
      updateZoomDisplay();
    });
  }
  
  // Center on init
  setTimeout(centerCanvas, 100);
  
  // ========== Node & Connection Storage ==========
  const nodes = new Map(); // nodeId -> { element, data, x, y }
  const connections = []; // [{ from: nodeId, to: nodeId, line: SVGElement }]
  let selectedNode = null;
  let connectingFrom = null; // For drawing connections
  let saveTimeout = null;
  let isSaving = false;
  
  // Get workflow ID from data attribute, URL, or localStorage (for persistence across refresh)
  const urlParams = new URLSearchParams(window.location.search);
  const isExplicitNewWorkflow = urlParams.get('new') === 'true';
  const urlWorkflowId = urlParams.get('workflow_id');
  const dataWorkflowId = container.dataset.workflowId;
  const storedWorkflowId = localStorage.getItem('current_workflow_id');
  
  // Priority: explicit data attribute > URL param > localStorage
  let currentWorkflowId = null;
  
  if (isExplicitNewWorkflow) {
    // User clicked "Create New" - start fresh
    localStorage.removeItem('current_workflow_id');
    currentWorkflowId = null;
    console.log('🔧 Explicit new workflow requested - starting fresh');
  } else if (dataWorkflowId && dataWorkflowId !== '' && dataWorkflowId !== 'null') {
    // Workflow ID passed via canvas data (e.g., from Created Assets)
    currentWorkflowId = dataWorkflowId;
    localStorage.setItem('current_workflow_id', currentWorkflowId);
    console.log('🔧 Using workflow ID from data attribute:', currentWorkflowId);
  } else if (urlWorkflowId && urlWorkflowId !== 'null') {
    // Workflow ID in URL
    currentWorkflowId = urlWorkflowId;
    localStorage.setItem('current_workflow_id', currentWorkflowId);
    console.log('🔧 Using workflow ID from URL:', currentWorkflowId);
  } else if (storedWorkflowId && storedWorkflowId !== 'null') {
    // Use persisted workflow from localStorage (e.g., after refresh)
    currentWorkflowId = storedWorkflowId;
    console.log('🔧 Restored workflow ID from localStorage:', currentWorkflowId);
  } else {
    console.log('🔧 No workflow ID found - new workflow will be created on first save');
  }
  
  console.log('🔧 Workflow Designer: Final currentWorkflowId =', currentWorkflowId);
  
  // ========== Load Existing Workflow ==========
  async function loadWorkflow(workflowId) {
    if (!workflowId) return;
    
    try {
      const response = await fetch(`/scout/load_workflow?workflow_id=${workflowId}`);
      if (response.ok) {
        const data = await response.json();
        if (data.workflow_definition) {
          console.log('📂 Loading workflow:', data);
          
          // Clear existing nodes
          nodes.clear();
          connections.length = 0;
          const targetContainer = transformContainer || canvas;
          targetContainer.querySelectorAll('.workflow-node').forEach(n => n.remove());
          svgLayer.querySelectorAll('path').forEach(l => l.remove());
          
          // Hide empty state
          const emptyState = document.getElementById('canvas-empty-state');
          if (emptyState && data.workflow_definition.nodes?.length > 0) {
            emptyState.style.display = 'none';
          }
          
          // Create nodes from saved data
          (data.workflow_definition.nodes || []).forEach(nodeData => {
            createWorkflowNode({
              type: nodeData.type,
              label: nodeData.label,
              config: nodeData.config || {}
            }, nodeData.x, nodeData.y, nodeData.id);
          });
          
          // Create connections
          (data.workflow_definition.connections || []).forEach(conn => {
            createConnection(conn.from, conn.fromPort || 'bottom', conn.to, conn.toPort || 'top');
          });
          
          // Update header with workflow name
          const titleEl = container.querySelector('.designer-title');
          if (titleEl && data.name) {
            titleEl.textContent = data.name;
          }
          
          // Center view on loaded nodes
          centerOnNodes();
        }
      }
    } catch (err) {
      console.error('Failed to load workflow:', err);
    }
  }
  
  // Center the view on existing nodes
  function centerOnNodes() {
    if (nodes.size === 0) {
      centerCanvas();
      return;
    }
    
    // Calculate bounding box of all nodes
    let minX = Infinity, minY = Infinity, maxX = -Infinity, maxY = -Infinity;
    nodes.forEach(n => {
      minX = Math.min(minX, n.x);
      minY = Math.min(minY, n.y);
      maxX = Math.max(maxX, n.x + 160); // Node width
      maxY = Math.max(maxY, n.y + 60);  // Node height
    });
    
    // Calculate center of nodes
    const centerX = (minX + maxX) / 2;
    const centerY = (minY + maxY) / 2;
    
    // Position so nodes are centered in view
    const rect = canvas.getBoundingClientRect();
    panState.x = rect.width / 2 - centerX;
    panState.y = rect.height / 2 - centerY;
    applyTransform();
  }
  
  // Load on init if workflow_id exists
  if (currentWorkflowId) {
    loadWorkflow(currentWorkflowId).then(() => {
      // Clear URL params after loading to prevent re-loading on refresh
      const url = new URL(window.location);
      if (url.searchParams.has('workflow_id')) {
        url.searchParams.delete('workflow_id');
        window.history.replaceState({}, '', url);
        console.log('🧹 Cleared workflow_id from URL after loading');
      }
    });
  }
  
  // ========== Auto-Save Functionality ==========
  function autoSave() {
    // Debounce - wait 500ms after last change
    if (saveTimeout) clearTimeout(saveTimeout);
    saveTimeout = setTimeout(() => {
      performSave();
    }, 500);
  }
  
  async function performSave() {
    if (isSaving) return;
    isSaving = true;
    
    updateSaveStatus('saving');
    
    const workflowData = {
      nodes: Array.from(nodes.entries()).map(([id, n]) => ({
        id,
        type: n.data.type,
        label: n.data.label,
        config: n.data.config || {},
        connectionId: n.data.connectionId || null,
        x: n.x,
        y: n.y
      })),
      connections: connections.map(c => ({ from: c.from, fromPort: c.fromPort, to: c.to, toPort: c.toPort }))
    };
    
    // Get workflow name from editable title
    const titleEl = document.getElementById('workflow-title');
    const workflowName = titleEl?.textContent?.trim() || 'Untitled Workflow';
    
    console.log('💾 Auto-saving workflow:', workflowName, workflowData);
    
    try {
      const response = await fetch('/scout/save_workflow', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]')?.content
        },
        body: JSON.stringify({
          workflow_id: currentWorkflowId,
          workflow_name: workflowName,
          workflow_data: workflowData
        })
      });
      
      if (response.ok) {
        const result = await response.json();
        console.log('✅ Workflow saved:', result);
        // Store the workflow_id for subsequent saves
        if (result.workflow_id) {
          if (!currentWorkflowId) {
            currentWorkflowId = result.workflow_id;
            console.log('📝 New workflow created with ID:', currentWorkflowId);
          }
          // Update container data attribute
          container.dataset.workflowId = currentWorkflowId;
          // Store in localStorage so it persists across refresh
          localStorage.setItem('current_workflow_id', currentWorkflowId);
          
          // Update URL to include workflow_id and remove 'new' param
          const url = new URL(window.location);
          url.searchParams.set('workflow_id', currentWorkflowId);
          url.searchParams.delete('new');
          window.history.replaceState({}, '', url);
        }
        updateSaveStatus('saved');
      } else {
        console.error('❌ Save failed:', response.status);
        updateSaveStatus('error');
      }
    } catch (err) {
      console.error('❌ Save error:', err);
      updateSaveStatus('error');
    }
    
    isSaving = false;
  }
  
  function updateSaveStatus(status) {
    const indicator = document.getElementById('save-status-indicator');
    if (!indicator) return;
    
    switch (status) {
      case 'saving':
        indicator.innerHTML = '<i data-lucide="loader" class="spin"></i> Saving...';
        indicator.style.color = '#fbbf24';
        break;
      case 'saved':
        indicator.innerHTML = '<i data-lucide="check-circle"></i> Saved';
        indicator.style.color = '#10b981';
        if (typeof lucide !== 'undefined') lucide.createIcons();
        // Fade out after 2 seconds
        setTimeout(() => {
          indicator.innerHTML = '';
        }, 2000);
        break;
      case 'error':
        indicator.innerHTML = '<i data-lucide="alert-circle"></i> Save failed';
        indicator.style.color = '#ef4444';
        if (typeof lucide !== 'undefined') lucide.createIcons();
        break;
    }
    if (typeof lucide !== 'undefined') lucide.createIcons();
  }
  
  // ========== App Context Navigation ==========
  const appId = container.dataset.appId;
  const isAppWorkflow = container.dataset.isAppWorkflow === 'true';
  
  if (isAppWorkflow) {
    console.log('🔗 Workflow is part of app:', appId);
    
    // Back to App button
    const backBtn = container.querySelector('#back-to-app-btn');
    if (backBtn) {
      backBtn.addEventListener('click', function() {
        loadDesignStudioWithApp(appId);
      });
    }
    
    // App nav tabs
    container.querySelectorAll('.app-nav-tab').forEach(function(tab) {
      tab.addEventListener('click', function() {
        const mode = this.dataset.mode;
        if (mode === 'workflows') return; // Already on workflows
        
        // Load design studio with the app and switch to the appropriate mode
        loadDesignStudioWithApp(appId, mode);
      });
    });
  }
  
  function loadDesignStudioWithApp(appId, mode) {
    mode = mode || 'pages';
    console.log('🔄 Loading design studio for app:', appId, 'mode:', mode);
    
    const scoutController = window.Stimulus?.getControllerForElementAndIdentifier(
      document.getElementById('workspace'), 'scout'
    );
    
    if (scoutController && typeof scoutController.loadScoutCanvas === 'function') {
      scoutController.loadScoutCanvas('design_studio', { 
        plan_id: appId, 
        create_type: 'app',
        app_mode: mode 
      });
    } else {
      window.dispatchEvent(new CustomEvent('load-canvas', {
        detail: { 
          canvas: 'design_studio', 
          data: { plan_id: appId, create_type: 'app', app_mode: mode } 
        }
      }));
    }
  }
  
  // Add save status indicator to header
  const headerRight = container.querySelector('.designer-header-right');
  if (headerRight) {
    const statusSpan = document.createElement('span');
    statusSpan.id = 'save-status-indicator';
    statusSpan.style.cssText = 'display: inline-flex; align-items: center; gap: 4px; font-size: 12px; margin-right: 12px;';
    headerRight.insertBefore(statusSpan, headerRight.firstChild);
  }
  
  // ========== Create SVG Layer for Connections ==========
  const svgLayer = document.createElementNS('http://www.w3.org/2000/svg', 'svg');
  svgLayer.id = 'workflow-svg-connections';
  svgLayer.style.cssText = 'position: absolute; top: 0; left: 0; width: 5000px; height: 5000px; pointer-events: none; z-index: 5; overflow: visible;';
  svgLayer.innerHTML = '<defs><marker id="arrowhead" markerWidth="10" markerHeight="7" refX="9" refY="3.5" orient="auto"><polygon points="0 0, 10 3.5, 0 7" fill="#8b5cf6"/></marker></defs>';
  if (transformContainer) transformContainer.appendChild(svgLayer);
  console.log('🔗 SVG layer created:', svgLayer);
  
  // ========== Properties Modal HTML ==========
  const modalHtml = `
    <div class="modal fade" id="nodePropertiesModal" tabindex="-1" aria-labelledby="nodePropertiesModalLabel" aria-hidden="true">
      <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="background: var(--bs-body-bg, #1a1a2e); border: 1px solid var(--bs-border-color, #333);">
          <div class="modal-header" style="border-bottom: 1px solid var(--bs-border-color, #333);">
            <h5 class="modal-title" id="nodePropertiesModalLabel">Configure Node</h5>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
          </div>
          <div class="modal-body" id="props-content" style="max-height: 60vh; overflow-y: auto;">
            <!-- Dynamic content here -->
          </div>
          <div class="modal-footer" style="border-top: 1px solid var(--bs-border-color, #333);">
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
            <button type="button" class="btn btn-primary" id="save-node-btn" style="background: #8b5cf6; border-color: #8b5cf6;">Save Configuration</button>
          </div>
        </div>
      </div>
    </div>
  `;
  document.body.insertAdjacentHTML('beforeend', modalHtml);
  
  const propertiesModal = new bootstrap.Modal(document.getElementById('nodePropertiesModal'));
  const modalElement = document.getElementById('nodePropertiesModal');
  
  // Save button handler
  document.getElementById('save-node-btn').addEventListener('click', saveNodeConfig);
  
  function openPropertiesPanel(nodeId, data) {
    selectedNode = nodeId;
    document.getElementById('nodePropertiesModalLabel').textContent = data.label || 'Configure Node';
    
    const content = document.getElementById('props-content');
    const [category, subtype] = (data.type || '').split('-');
    
    // Generate form based on node type
    let formHtml = `
      <div style="margin-bottom: 16px;">
        <label style="display: block; font-size: 12px; color: var(--bs-secondary-color, #6b7280); margin-bottom: 6px;">Node Name</label>
        <input type="text" id="prop-name" value="${data.label || ''}" style="width: 100%; padding: 8px 12px; background: var(--bs-tertiary-bg, #252540); border: 1px solid var(--bs-border-color, #333); border-radius: 6px; color: var(--bs-body-color, #fff);">
      </div>
    `;
    
    // Type-specific fields
    if (category === 'trigger') {
      if (subtype === 'webhook') {
        const webhookPath = data.config?.webhook_path || '';
        const webhookUrl = webhookPath ? `${window.location.origin}/webhooks/workflow/${webhookPath}` : '';
        formHtml += `
          <div style="margin-bottom: 16px;">
            <label style="display: block; font-size: 12px; color: var(--bs-secondary-color, #6b7280); margin-bottom: 6px;">Webhook URL</label>
            <div style="display: flex; gap: 8px;">
              <input type="text" id="prop-webhook-url" value="${webhookUrl}" readonly placeholder="Save workflow to generate URL" style="flex: 1; padding: 8px 12px; background: var(--bs-tertiary-bg, #252540); border: 1px solid var(--bs-border-color, #333); border-radius: 6px; color: var(--bs-body-color, #fff); font-size: 11px;">
              <button type="button" id="copy-webhook-url" style="padding: 8px 12px; background: #8b5cf6; border: none; border-radius: 6px; color: white; cursor: pointer; font-size: 11px;" title="Copy URL">📋</button>
            </div>
            <p style="font-size: 11px; color: var(--bs-secondary-color, #6b7280); margin-top: 4px;">POST requests to this URL will trigger the workflow</p>
          </div>
          <div style="margin-bottom: 16px;">
            <label style="display: block; font-size: 12px; color: var(--bs-secondary-color, #6b7280); margin-bottom: 6px;">Authentication</label>
            <select id="prop-webhook-auth" style="width: 100%; padding: 8px 12px; background: var(--bs-tertiary-bg, #252540); border: 1px solid var(--bs-border-color, #333); border-radius: 6px; color: var(--bs-body-color, #fff);">
              <option value="none">No Authentication</option>
              <option value="api_key">API Key Header</option>
              <option value="hmac">HMAC Signature</option>
            </select>
          </div>
          <div style="margin-bottom: 16px;">
            <label style="display: block; font-size: 12px; color: var(--bs-secondary-color, #6b7280); margin-bottom: 6px;">Expected Payload Schema (JSON)</label>
            <textarea id="prop-webhook-schema" rows="5" placeholder='{
  "event": "string",
  "data": {
    "email": "string",
    "name": "string"
  }
}' style="width: 100%; padding: 8px 12px; background: var(--bs-tertiary-bg, #252540); border: 1px solid var(--bs-border-color, #333); border-radius: 6px; color: var(--bs-body-color, #fff); font-family: monospace; font-size: 12px;">${JSON.stringify(data.config?.payload_schema || {}, null, 2)}</textarea>
            <p style="font-size: 11px; color: var(--bs-secondary-color, #6b7280); margin-top: 4px;">Define the expected payload structure for documentation</p>
          </div>
        `;
      } else if (subtype === 'record') {
        formHtml += `
          <div style="margin-bottom: 16px;">
            <label style="display: block; font-size: 12px; color: var(--bs-secondary-color, #6b7280); margin-bottom: 6px;">Record Type</label>
            <select id="prop-record-type" style="width: 100%; padding: 8px 12px; background: var(--bs-tertiary-bg, #252540); border: 1px solid var(--bs-border-color, #333); border-radius: 6px; color: var(--bs-body-color, #fff);">
              <option value="">Select record type...</option>
              <optgroup label="CRM">
                <option value="contact" ${data.config?.record_type === 'contact' ? 'selected' : ''}>Contact</option>
                <option value="lead" ${data.config?.record_type === 'lead' ? 'selected' : ''}>Lead</option>
                <option value="opportunity" ${data.config?.record_type === 'opportunity' ? 'selected' : ''}>Opportunity</option>
              </optgroup>
              <optgroup label="Documents">
                <option value="rag_document" ${data.config?.record_type === 'rag_document' ? 'selected' : ''}>Document Uploaded</option>
                <option value="rag_store" ${data.config?.record_type === 'rag_store' ? 'selected' : ''}>Document Store</option>
              </optgroup>
              <optgroup label="Marketing">
                <option value="landing_page" ${data.config?.record_type === 'landing_page' ? 'selected' : ''}>Landing Page</option>
                <option value="email_campaign" ${data.config?.record_type === 'email_campaign' ? 'selected' : ''}>Email Campaign</option>
                <option value="social_post" ${data.config?.record_type === 'social_post' ? 'selected' : ''}>Social Post</option>
              </optgroup>
              <optgroup label="Tasks & Workflows">
                <option value="task" ${data.config?.record_type === 'task' ? 'selected' : ''}>Task</option>
                <option value="automation_code" ${data.config?.record_type === 'automation_code' ? 'selected' : ''}>Workflow</option>
                <option value="scheduled_task" ${data.config?.record_type === 'scheduled_task' ? 'selected' : ''}>Scheduled Task</option>
              </optgroup>
              <optgroup label="App Modules">
                <option value="app_module" ${data.config?.record_type === 'app_module' ? 'selected' : ''}>App Module Record</option>
              </optgroup>
            </select>
          </div>
          <div id="prop-app-module-container" style="margin-bottom: 16px; display: none;">
            <label style="display: block; font-size: 12px; color: var(--bs-secondary-color, #6b7280); margin-bottom: 6px;">Select App Module</label>
            <select id="prop-module" style="width: 100%; padding: 8px 12px; background: var(--bs-tertiary-bg, #252540); border: 1px solid var(--bs-border-color, #333); border-radius: 6px; color: var(--bs-body-color, #fff);">
              <option value="">Loading modules...</option>
            </select>
          </div>
          <div style="margin-bottom: 16px;">
            <label style="display: block; font-size: 12px; color: var(--bs-secondary-color, #6b7280); margin-bottom: 6px;">Trigger When</label>
            <div style="display: flex; flex-direction: column; gap: 8px;">
