}' style="width: 100%; padding: 8px 12px; background: var(--bs-tertiary-bg, #252540); border: 1px solid var(--bs-border-color, #333); border-radius: 6px; color: var(--bs-body-color, #fff); font-family: monospace; font-size: 12px;">${JSON.stringify(data.config?.input_schema || {}, null, 2)}</textarea>
            <p style="font-size: 11px; color: var(--bs-secondary-color, #6b7280); margin-top: 4px;">Define what parameters are expected when triggering manually</p>
