          <div style="margin-bottom: 16px;">
            <label style="display: flex; align-items: center; gap: 8px; cursor: pointer;">
              <input type="checkbox" id="prop-require-confirm" ${data.config?.require_confirmation ? 'checked' : ''} style="width: 16px; height: 16px;">
              <span style="font-size: 13px;">Require User Confirmation</span>
            </label>
          </div>
        `;
      } else if (subtype === 'schedule') {
        formHtml += `
          <div style="margin-bottom: 16px;">
            <label style="display: block; font-size: 12px; color: var(--bs-secondary-color, #6b7280); margin-bottom: 6px;">Schedule</label>
            <select id="prop-schedule" style="width: 100%; padding: 8px 12px; background: var(--bs-tertiary-bg, #252540); border: 1px solid var(--bs-border-color, #333); border-radius: 6px; color: var(--bs-body-color, #fff);">
              <option value="hourly">Every Hour</option>
              <option value="daily">Daily</option>
              <option value="weekly">Weekly</option>
              <option value="monthly">Monthly</option>
              <option value="cron">Custom (Cron)</option>
