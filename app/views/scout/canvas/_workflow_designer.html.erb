            <input type="text" id="prop-loop-item-var" placeholder="item, product, expense" value="${data.config?.item_variable || 'item'}" style="width: 100%; padding: 8px 12px; background: var(--bs-tertiary-bg, #252540); border: 1px solid var(--bs-border-color, #333); border-radius: 6px; color: var(--bs-body-color, #fff); font-family: monospace; font-size: 12px;">
            <p style="font-size: 11px; color: var(--bs-secondary-color, #6b7280); margin-top: 4px;">Use {{item.field}} in nodes inside the loop to access each element</p>
          </div>
          <div style="margin-bottom: 16px;">
            <label style="display: block; font-size: 12px; color: var(--bs-secondary-color, #6b7280); margin-bottom: 6px;">Index Variable Name (Optional)</label>
            <input type="text" id="prop-loop-index-var" placeholder="index, i" value="${data.config?.index_variable || ''}" style="width: 100%; padding: 8px 12px; background: var(--bs-tertiary-bg, #252540); border: 1px solid var(--bs-border-color, #333); border-radius: 6px; color: var(--bs-body-color, #fff); font-family: monospace; font-size: 12px;">
            <p style="font-size: 11px; color: var(--bs-secondary-color, #6b7280); margin-top: 4px;">Access loop position with {{index}} (0-based)</p>
          </div>
          <div style="margin-bottom: 16px;">
            <label style="display: block; font-size: 12px; color: var(--bs-secondary-color, #6b7280); margin-bottom: 6px;">Max Iterations (Safety Limit)</label>
            <input type="number" id="prop-loop-max" placeholder="100" value="${data.config?.max_iterations || 100}" min="1" max="10000" style="width: 100%; padding: 8px 12px; background: var(--bs-tertiary-bg, #252540); border: 1px solid var(--bs-border-color, #333); border-radius: 6px; color: var(--bs-body-color, #fff);">
          </div>
          <div style="padding: 12px; background: rgba(16, 185, 129, 0.1); border-radius: 8px; border: 1px solid rgba(16, 185, 129, 0.3);">
            <p style="font-size: 12px; color: var(--bs-body-color, #e0e0e0); margin: 0;">
              <strong>Example:</strong> If looping over <code style="background: rgba(0,0,0,0.3); padding: 2px 4px; border-radius: 3px;">{{order.products}}</code> with item variable <code style="background: rgba(0,0,0,0.3); padding: 2px 4px; border-radius: 3px;">product</code>, use <code style="background: rgba(0,0,0,0.3); padding: 2px 4px; border-radius: 3px;">{{product.name}}</code> or <code style="background: rgba(0,0,0,0.3); padding: 2px 4px; border-radius: 3px;">{{product.price}}</code> in downstream nodes.
            </p>
          </div>
        `;
      } else if (subtype === 'switch') {
        // Switch node - specify what to switch on and cases
        const cases = data.config?.cases || [{ value: '', label: 'Case 1' }];
        formHtml += `
          <div style="margin-bottom: 16px;">
            <label style="display: block; font-size: 12px; color: var(--bs-secondary-color, #6b7280); margin-bottom: 6px;">Switch On (Value to Evaluate)</label>
            <input type="text" id="prop-switch-value" placeholder="{{trigger.data.type}} or {{contact.status}}" value="${data.config?.switch_value || ''}" style="width: 100%; padding: 8px 12px; background: var(--bs-tertiary-bg, #252540); border: 1px solid var(--bs-border-color, #333); border-radius: 6px; color: var(--bs-body-color, #fff); font-family: monospace; font-size: 12px;">
            <p style="font-size: 11px; color: var(--bs-secondary-color, #6b7280); margin-top: 4px;">This value will be compared against each case</p>
          </div>
          <div style="margin-bottom: 16px;">
            <label style="display: block; font-size: 12px; color: var(--bs-secondary-color, #6b7280); margin-bottom: 6px;">Cases (one per line: value = label)</label>
            <textarea id="prop-switch-cases" rows="5" placeholder="new = New Lead
qualified = Qualified Lead
customer = Existing Customer
default = Other" style="width: 100%; padding: 8px 12px; background: var(--bs-tertiary-bg, #252540); border: 1px solid var(--bs-border-color, #333); border-radius: 6px; color: var(--bs-body-color, #fff); font-family: monospace; font-size: 12px;">${(data.config?.cases || []).map(c => c.value + ' = ' + c.label).join('\n') || ''}</textarea>
            <p style="font-size: 11px; color: var(--bs-secondary-color, #6b7280); margin-top: 4px;">Each case creates a separate output port. Include "default" for unmatched values.</p>
          </div>
          <div style="padding: 12px; background: rgba(245, 158, 11, 0.1); border-radius: 8px; border: 1px solid rgba(245, 158, 11, 0.3);">
            <p style="font-size: 12px; color: var(--bs-body-color, #e0e0e0); margin: 0;">
              <strong>Note:</strong> Connect each case to different downstream paths. The matching case's path will execute.
            </p>
          </div>
        `;
      } else if (subtype === 'merge') {
        // Merge node - wait for multiple inputs
        formHtml += `
          <div style="margin-bottom: 16px;">
            <label style="display: block; font-size: 12px; color: var(--bs-secondary-color, #6b7280); margin-bottom: 6px;">Merge Mode</label>
            <select id="prop-merge-mode" style="width: 100%; padding: 8px 12px; background: var(--bs-tertiary-bg, #252540); border: 1px solid var(--bs-border-color, #333); border-radius: 6px; color: var(--bs-body-color, #fff);">
              <option value="wait_all" ${data.config?.mode === 'wait_all' ? 'selected' : ''}>Wait for All Inputs</option>
              <option value="first" ${data.config?.mode === 'first' ? 'selected' : ''}>Continue on First Input</option>
              <option value="any" ${data.config?.mode === 'any' ? 'selected' : ''}>Continue on Any Input</option>
