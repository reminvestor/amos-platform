<script>
(function() {
  // IIFE for immediate execution when loaded via AJAX
  console.log('🔧 Workflow Designer: Initializing...');
  
  const container = document.querySelector('.workflow-designer-canvas');
  if (!container) {
    console.warn('Workflow designer container not found');
    return;
  }
  
  const canvas = container.querySelector('#workflow-canvas');
  const componentSearch = container.querySelector('#component-search');
  let nodeIdCounter = 0;
  
  // ========== Node & Connection Storage ==========
  const nodes = new Map(); // nodeId -> { element, data, x, y }
  const connections = []; // [{ from: nodeId, to: nodeId, line: SVGElement }]
  let selectedNode = null;
  let connectingFrom = null; // For drawing connections
  let saveTimeout = null;
  let isSaving = false;
  
  // Get workflow ID from data attribute or URL
  const workflowId = container.dataset.workflowId || new URLSearchParams(window.location.search).get('workflow_id');
  
  // ========== Auto-Save Functionality ==========
  function autoSave() {
    // Debounce - wait 500ms after last change
    if (saveTimeout) clearTimeout(saveTimeout);
    saveTimeout = setTimeout(() => {
      performSave();
    }, 500);
  }
  
  async function performSave() {
    if (isSaving) return;
    isSaving = true;
    
    updateSaveStatus('saving');
    
    const workflowData = {
      nodes: Array.from(nodes.entries()).map(([id, n]) => ({
        id,
        type: n.data.type,
        label: n.data.label,
        config: n.data.config || {},
        x: n.x,
        y: n.y
      })),
      connections: connections.map(c => ({ from: c.from, to: c.to }))
    };
    
    console.log('💾 Auto-saving workflow:', workflowData);
    
    try {
      const response = await fetch('/scout/save_workflow', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]')?.content
        },
        body: JSON.stringify({
          workflow_id: workflowId,
          workflow_data: workflowData
        })
      });
      
      if (response.ok) {
        const result = await response.json();
        console.log('✅ Workflow saved:', result);
        updateSaveStatus('saved');
      } else {
        console.error('❌ Save failed:', response.status);
        updateSaveStatus('error');
      }
    } catch (err) {
      console.error('❌ Save error:', err);
      updateSaveStatus('error');
    }
    
    isSaving = false;
  }
  
  function updateSaveStatus(status) {
    const indicator = document.getElementById('save-status-indicator');
    if (!indicator) return;
    
    switch (status) {
      case 'saving':
        indicator.innerHTML = '<i data-lucide="loader" class="spin"></i> Saving...';
        indicator.style.color = '#fbbf24';
        break;
      case 'saved':
        indicator.innerHTML = '<i data-lucide="check-circle"></i> Saved';
        indicator.style.color = '#10b981';
        if (typeof lucide !== 'undefined') lucide.createIcons();
        // Fade out after 2 seconds
        setTimeout(() => {
          indicator.innerHTML = '';
        }, 2000);
        break;
      case 'error':
        indicator.innerHTML = '<i data-lucide="alert-circle"></i> Save failed';
        indicator.style.color = '#ef4444';
