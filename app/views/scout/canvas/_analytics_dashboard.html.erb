<div class="scout-canvas analytics-dashboard">
  <div class="canvas-header d-flex justify-content-between align-items-center mb-4">
    <div>
      <h4 class="mb-1">
        <i class="fas fa-chart-bar text-primary me-2"></i>
        Analytics Dashboard
      </h4>
      <p class="text-muted mb-0">Marketing performance insights and metrics</p>
    </div>
    <div class="d-flex gap-2">
      <select class="form-select" id="dateRangeFilter" style="width: auto;">
        <option value="7">Last 7 days</option>
        <option value="30" selected>Last 30 days</option>
        <option value="90">Last 90 days</option>
        <option value="365">Last year</option>
      </select>
      <button class="btn btn-outline-secondary" onclick="scoutExportReport()">
        <i class="fas fa-download me-1"></i>
        Export
      </button>
      <button class="btn btn-primary" onclick="scoutCustomReport()">
        <i class="fas fa-chart-line me-1"></i>
        Custom Report
      </button>
    </div>
  </div>
  
  <!-- Key Metrics Overview -->
  <div class="row mb-4">
    <div class="col-lg-3 col-md-6 mb-3">
      <div class="metric-card">
        <div class="metric-icon bg-primary bg-opacity-10">
          <i class="fas fa-envelope text-primary"></i>
        </div>
        <div class="metric-content">
          <h3 class="metric-number">
            <%= number_with_delimiter(analytics_data[:total_emails_sent]) %>
          </h3>
          <p class="metric-label">Total Emails Sent</p>
          <span class="metric-change positive">
            <i class="fas fa-arrow-up"></i> +12.5%
          </span>
        </div>
      </div>
    </div>
    <div class="col-lg-3 col-md-6 mb-3">
      <div class="metric-card">
        <div class="metric-icon bg-success bg-opacity-10">
          <i class="fas fa-eye text-success"></i>
        </div>
        <div class="metric-content">
          <h3 class="metric-number">
            <%= analytics_data[:avg_open_rate] %>%
          </h3>
          <p class="metric-label">Average Open Rate</p>
          <span class="metric-change <%= analytics_data[:avg_open_rate] > 20 ? 'positive' : 'negative' %>">
            <i class="fas fa-arrow-<%= analytics_data[:avg_open_rate] > 20 ? 'up' : 'down' %>"></i> 
            <%= analytics_data[:avg_open_rate] > 20 ? '+' : '-' %>2.1%
          </span>
        </div>
      </div>
    </div>
    <div class="col-lg-3 col-md-6 mb-3">
      <div class="metric-card">
        <div class="metric-icon bg-info bg-opacity-10">
          <i class="fas fa-users text-info"></i>
        </div>
        <div class="metric-content">
          <h3 class="metric-number">
            <%= number_with_delimiter(analytics_data[:recent_contacts]) %>
          </h3>
          <p class="metric-label">New Contacts (30d)</p>
          <span class="metric-change positive">
            <i class="fas fa-arrow-up"></i> +8.3%
          </span>
        </div>
      </div>
    </div>
    <div class="col-lg-3 col-md-6 mb-3">
      <div class="metric-card">
        <div class="metric-icon bg-warning bg-opacity-10">
          <i class="fas fa-globe text-warning"></i>
        </div>
        <div class="metric-content">
          <h3 class="metric-number">
            <%= analytics_data[:landing_pages] %>
          </h3>
          <p class="metric-label">Active Landing Pages</p>
          <span class="metric-change neutral">
            <i class="fas fa-minus"></i> 0%
          </span>
        </div>
      </div>
    </div>
  </div>
  
  <!-- Charts Row -->
  <div class="row mb-4">
    <!-- Campaign Performance Chart -->
    <div class="col-lg-8 mb-4">
      <div class="card border-0 shadow-sm">
        <div class="card-header bg-light d-flex justify-content-between align-items-center">
          <h6 class="mb-0">
            <i class="fas fa-chart-line me-2"></i>
            Campaign Performance Over Time
          </h6>
          <div class="btn-group btn-group-sm" role="group">
            <button type="button" class="btn btn-outline-secondary active" onclick="scoutChangeChart('emails')">
              Emails
            </button>
            <button type="button" class="btn btn-outline-secondary" onclick="scoutChangeChart('opens')">
              Opens
            </button>
            <button type="button" class="btn btn-outline-secondary" onclick="scoutChangeChart('clicks')">
              Clicks
            </button>
          </div>
        </div>
        <div class="card-body">
          <div class="chart-container" style="height: 300px;">
            <canvas id="performanceChart"></canvas>
          </div>
        </div>
      </div>
    </div>
    
    <!-- Top Campaigns -->
    <div class="col-lg-4 mb-4">
      <div class="card border-0 shadow-sm">
        <div class="card-header bg-light">
          <h6 class="mb-0">
            <i class="fas fa-trophy me-2"></i>
            Top Performing Campaigns
          </h6>
        </div>
        <div class="card-body">
          <% analytics_data[:campaigns].limit(5).each_with_index do |campaign, index| %>
            <% 
              sent = campaign.mailgun_stats&.dig('sent') || 0
              opened = campaign.mailgun_stats&.dig('opened') || 0
              open_rate = sent > 0 ? (opened.to_f / sent * 100) : 0
            %>
            <div class="campaign-item <%= 'mb-3' unless index == 4 %>">
              <div class="d-flex justify-content-between align-items-start">
                <div class="campaign-info flex-grow-1">
                  <h6 class="mb-1">
                    <%= campaign.name.present? ? truncate(campaign.name, length: 25) : "Campaign #{campaign.id}" %>
                  </h6>
                  <small class="text-muted">
                    <%= number_with_delimiter(sent) %> sent
                  </small>
                </div>
                <div class="campaign-metric text-end">
                  <div class="metric-badge <%= open_rate > 25 ? 'bg-success' : open_rate > 15 ? 'bg-warning' : 'bg-danger' %>">
                    <%= number_with_precision(open_rate, precision: 1) %>%
                  </div>
                </div>
              </div>
              <div class="progress mt-2" style="height: 4px;">
                <div class="progress-bar <%= open_rate > 25 ? 'bg-success' : open_rate > 15 ? 'bg-warning' : 'bg-danger' %>" 
                     style="width: <%= [open_rate, 100].min %>%"></div>
              </div>
            </div>
          <% end %>
          <button class="btn btn-sm btn-outline-primary w-100 mt-2" onclick="scoutViewAllCampaigns()">
            View All Campaigns
          </button>
        </div>
      </div>
    </div>
  </div>
  
  <!-- Additional Analytics -->
  <div class="row">
    <!-- Contact Growth -->
    <div class="col-lg-6 mb-4">
      <div class="card border-0 shadow-sm">
        <div class="card-header bg-light">
          <h6 class="mb-0">
            <i class="fas fa-user-plus me-2"></i>
            Contact Growth
          </h6>
        </div>
        <div class="card-body">
          <div class="chart-container" style="height: 200px;">
            <canvas id="contactGrowthChart"></canvas>
          </div>
        </div>
      </div>
    </div>
    
    <!-- Email Performance Breakdown -->
    <div class="col-lg-6 mb-4">
      <div class="card border-0 shadow-sm">
        <div class="card-header bg-light">
          <h6 class="mb-0">
            <i class="fas fa-pie-chart me-2"></i>
            Email Performance Breakdown
          </h6>
        </div>
        <div class="card-body">
          <div class="row text-center">
            <div class="col-4">
              <div class="metric-circle delivered">
                <div class="metric-circle-value">85%</div>
                <div class="metric-circle-label">Delivered</div>
              </div>
            </div>
            <div class="col-4">
              <div class="metric-circle opened">
                <div class="metric-circle-value"><%= analytics_data[:avg_open_rate] %>%</div>
                <div class="metric-circle-label">Opened</div>
              </div>
            </div>
            <div class="col-4">
              <div class="metric-circle clicked">
                <div class="metric-circle-value">4.2%</div>
                <div class="metric-circle-label">Clicked</div>
              </div>
            </div>
          </div>
          <div class="mt-3">
            <small class="text-muted">
              <i class="fas fa-info-circle me-1"></i>
              Based on last 30 days of campaign data
            </small>
          </div>
        </div>
      </div>
    </div>
  </div>
  
  <!-- AI-Powered Analytics Query Section -->
  <div class="row mb-4">
    <div class="col-12">
      <div class="card border-0 shadow-sm" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
        <div class="card-body text-white">
          <h6 class="mb-3">
            <i class="fas fa-magic me-2"></i>
            AI-Powered Analytics
          </h6>
          <p class="mb-3 opacity-75 small">Ask Amos to analyze your marketing data, integration metrics, or create custom reports</p>
          
          <!-- Quick Analysis Buttons -->
          <div class="d-flex gap-2 flex-wrap">
            <button class="btn btn-light btn-sm" onclick="quickAnalyticsQuery('campaign_performance')">
              <i class="fas fa-envelope me-1"></i>
              Campaign Performance
            </button>
            <button class="btn btn-light btn-sm" onclick="quickAnalyticsQuery('email_engagement')">
              <i class="fas fa-chart-line me-1"></i>
              Email Engagement
            </button>
            <button class="btn btn-light btn-sm" onclick="quickAnalyticsQuery('contact_growth')">
              <i class="fas fa-user-plus me-1"></i>
              Contact Growth
            </button>
            <% if current_entity.connections.joins(:integration).where(integrations: { slug: 'stripe' }).where(status: :connected).exists? %>
            <button class="btn btn-success btn-sm" onclick="quickAnalyticsQuery('stripe_revenue')">
              <i class="fas fa-dollar-sign me-1"></i>
              Stripe Revenue
            </button>
            <% end %>
            <button class="btn btn-outline-light btn-sm" onclick="customAnalyticsQuery()">
              <i class="fas fa-question me-1"></i>
              Custom Analysis
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>
  
  <!-- Recent Activity -->
  <div class="row">
    <div class="col-12">
      <div class="card border-0 shadow-sm">
        <div class="card-header bg-light d-flex justify-content-between align-items-center">
          <h6 class="mb-0">
            <i class="fas fa-clock me-2"></i>
            Recent Activity
          </h6>
          <button class="btn btn-sm btn-outline-primary" onclick="scoutViewFullActivity()">
            View All Activity
          </button>
        </div>
        <div class="card-body">
          <div class="activity-timeline">
            <div class="activity-item">
              <div class="activity-icon bg-success">
                <i class="fas fa-paper-plane text-white"></i>
              </div>
              <div class="activity-content">
                <div class="activity-title">Campaign "Newsletter #47" sent</div>
                <div class="activity-meta">2 hours ago • 1,234 recipients</div>
              </div>
            </div>
            <div class="activity-item">
              <div class="activity-icon bg-info">
                <i class="fas fa-user-plus text-white"></i>
              </div>
              <div class="activity-content">
                <div class="activity-title">15 new contacts added</div>
                <div class="activity-meta">4 hours ago • From landing page form</div>
              </div>
            </div>
            <div class="activity-item">
              <div class="activity-icon bg-warning">
                <i class="fas fa-globe text-white"></i>
              </div>
              <div class="activity-content">
                <div class="activity-title">Landing page "Product Demo" published</div>
                <div class="activity-meta">1 day ago • Now live at /landing/product-demo</div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
// Analytics dashboard functionality
function scoutChangeChart(chartType) {
  // Update active button
  document.querySelectorAll('.btn-group .btn').forEach(btn => btn.classList.remove('active'));
  event.target.classList.add('active');
  
  window.scoutSendMessage?.(`Show ${chartType} performance chart`);
}

function scoutExportReport() {
  const dateRange = document.getElementById('dateRangeFilter').value;
  window.scoutSendMessage?.(`Export analytics report for last ${dateRange} days`);
}

function scoutCustomReport() {
  window.scoutSendMessage?.("Help me create a custom analytics report");
}

// Quick analytics queries
function quickAnalyticsQuery(type) {
  const queries = {
    'campaign_performance': "Show me campaign performance metrics for the last 90 days",
    'email_engagement': "Analyze email engagement trends over the last quarter",
    'contact_growth': "Show me contact growth trends for the last 6 months",
    'stripe_revenue': "Show me Stripe revenue breakdown by month for this year"
  };
  
  const query = queries[type];
  if (query && window.scoutSendMessage) {
    window.scoutSendMessage(query);
  }
}

// Custom analytics query
function customAnalyticsQuery() {
  const question = prompt("What would you like to analyze?\n\nExamples:\n- Revenue trends by channel\n- Campaign performance comparison\n- Customer lifetime value\n- Email vs Stripe correlation");
  
  if (question && window.scoutSendMessage) {
    window.scoutSendMessage(question);
  }
}

function scoutViewAllCampaigns() {
  window.scoutLoadCanvas?.('campaign_viewer');
}

function scoutViewFullActivity() {
  window.scoutSendMessage?.("Show me complete activity log");
}

// Date range filter
document.addEventListener('DOMContentLoaded', function() {
  const dateFilter = document.getElementById('dateRangeFilter');
  if (dateFilter) {
    dateFilter.addEventListener('change', function() {
      window.scoutSendMessage?.(`Update analytics for last ${this.value} days`);
    });
  }
  
  // Initialize charts
  initializeCharts();
});

function initializeCharts() {
  // Performance Chart (placeholder)
  const performanceCtx = document.getElementById('performanceChart');
  if (performanceCtx) {
    // This would integrate with Chart.js or similar library
    performanceCtx.style.background = 'linear-gradient(45deg, #f8f9fa, #e9ecef)';
    performanceCtx.style.borderRadius = '8px';
    
    // Add placeholder text
    const placeholder = document.createElement('div');
    placeholder.className = 'chart-placeholder';
    placeholder.innerHTML = `
      <div class="text-center py-5">
        <i class="fas fa-chart-line text-muted mb-3" style="font-size: 3rem;"></i>
        <p class="text-muted">Performance chart will display here</p>
        <button class="btn btn-sm btn-primary" onclick="scoutLoadChart('performance')">
          Load Chart Data
        </button>
      </div>
    `;
    performanceCtx.parentNode.appendChild(placeholder);
    performanceCtx.style.display = 'none';
  }
  
  // Contact Growth Chart (placeholder)
  const contactCtx = document.getElementById('contactGrowthChart');
  if (contactCtx) {
    contactCtx.style.background = 'linear-gradient(45deg, #f8f9fa, #e9ecef)';
    contactCtx.style.borderRadius = '8px';
    
    const placeholder = document.createElement('div');
    placeholder.className = 'chart-placeholder';
    placeholder.innerHTML = `
      <div class="text-center py-4">
        <i class="fas fa-users text-muted mb-2" style="font-size: 2rem;"></i>
        <p class="text-muted small">Contact growth chart</p>
        <button class="btn btn-sm btn-outline-primary" onclick="scoutLoadChart('contacts')">
          Load Data
        </button>
      </div>
    `;
    contactCtx.parentNode.appendChild(placeholder);
    contactCtx.style.display = 'none';
  }
}

function scoutLoadChart(chartType) {
  window.scoutSendMessage?.(`Load ${chartType} chart data`);
}
</script>

<style>
