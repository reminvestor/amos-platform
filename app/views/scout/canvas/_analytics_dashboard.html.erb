<div class="scout-canvas canvas-container analytics-dashboard">
  <!-- Page Header -->
  <div class="analytics-header">
    <div>
      <h1 class="analytics-title">
        <i data-lucide="bar-chart-3"></i>
        Analytics Dashboard
      </h1>
      <p class="analytics-subtitle">Marketing performance insights and metrics</p>
    </div>
    <div class="analytics-actions">
      <select class="form-select analytics-select" id="dateRangeFilter">
        <option value="7">Last 7 days</option>
        <option value="30" selected>Last 30 days</option>
        <option value="90">Last 90 days</option>
        <option value="365">Last year</option>
      </select>
      <button onclick="scoutExportReport()" class="analytics-btn">
        <i data-lucide="download"></i>
        Export
      </button>
      <button onclick="scoutCustomReport()" class="analytics-btn primary">
        <i data-lucide="trending-up"></i>
        Custom Report
      </button>
    </div>
  </div>

  <!-- Key Metrics Overview -->
  <div class="analytics-metrics-grid">
    <!-- Total Emails Sent -->
    <div class="analytics-metric-card">
      <div class="analytics-metric-content">
        <div class="analytics-metric-icon purple">
          <i data-lucide="mail"></i>
        </div>
        <div>
          <p class="analytics-metric-label">Total Emails Sent</p>
          <h3 class="analytics-metric-value"><%= number_with_delimiter(analytics_data[:total_emails_sent]) %></h3>
          <span class="analytics-metric-change positive">
            <i data-lucide="arrow-up"></i> +12.5%
          </span>
        </div>
      </div>
    </div>

    <!-- Average Open Rate -->
    <div class="analytics-metric-card">
      <div class="analytics-metric-content">
        <div class="analytics-metric-icon green">
          <i data-lucide="eye"></i>
        </div>
        <div>
          <p class="analytics-metric-label">Average Open Rate</p>
          <h3 class="analytics-metric-value"><%= analytics_data[:avg_open_rate] %>%</h3>
          <span class="analytics-metric-change <%= analytics_data[:avg_open_rate] > 20 ? 'positive' : 'negative' %>">
            <i data-lucide="<%= analytics_data[:avg_open_rate] > 20 ? 'arrow-up' : 'arrow-down' %>"></i>
            <%= analytics_data[:avg_open_rate] > 20 ? '+' : '-' %>2.1%
          </span>
        </div>
      </div>
    </div>

    <!-- New Contacts -->
    <div class="analytics-metric-card">
      <div class="analytics-metric-content">
        <div class="analytics-metric-icon cyan">
          <i data-lucide="users"></i>
        </div>
        <div>
          <p class="analytics-metric-label">New Contacts (30d)</p>
          <h3 class="analytics-metric-value"><%= number_with_delimiter(analytics_data[:recent_contacts]) %></h3>
          <span class="analytics-metric-change positive">
            <i data-lucide="arrow-up"></i> +8.3%
          </span>
        </div>
      </div>
    </div>

    <!-- Active Landing Pages -->
    <div class="analytics-metric-card">
      <div class="analytics-metric-content">
        <div class="analytics-metric-icon yellow">
          <i data-lucide="globe"></i>
        </div>
        <div>
          <p class="analytics-metric-label">Active Landing Pages</p>
          <h3 class="analytics-metric-value"><%= analytics_data[:landing_pages] %></h3>
          <span class="analytics-metric-change neutral">
            <i data-lucide="minus"></i> 0%
          </span>
        </div>
      </div>
    </div>
  </div>

  <!-- Charts Row -->
  <div class="analytics-charts-row">
    <!-- Campaign Performance Chart -->
    <div class="analytics-chart-card">
      <div class="analytics-chart-header">
        <h3>
          <i data-lucide="trending-up"></i>
          Campaign Performance Over Time
        </h3>
        <div class="analytics-chart-tabs">
          <button type="button" onclick="scoutChangeChart('emails')" class="analytics-chart-tab active">
            Emails
          </button>
          <button type="button" onclick="scoutChangeChart('opens')" class="analytics-chart-tab">
            Opens
          </button>
          <button type="button" onclick="scoutChangeChart('clicks')" class="analytics-chart-tab">
            Clicks
          </button>
        </div>
      </div>
      <div class="analytics-chart-body">
        <canvas id="performanceChart"></canvas>
      </div>
    </div>

    <!-- Top Campaigns -->
    <div class="analytics-chart-card">
      <div class="analytics-chart-header">
        <h3>
          <i data-lucide="trophy"></i>
          Top Performing Campaigns
        </h3>
      </div>
      <div class="analytics-campaign-list">
        <% analytics_data[:campaigns].limit(5).each_with_index do |campaign, index| %>
          <%
            sent = campaign.mailgun_stats&.dig('sent') || 0
            opened = campaign.mailgun_stats&.dig('opened') || 0
            open_rate = sent > 0 ? (opened.to_f / sent * 100) : 0
            rate_class = open_rate > 25 ? 'high' : (open_rate > 15 ? 'medium' : 'low')
          %>
          <div class="analytics-campaign-item">
            <div class="analytics-campaign-header">
              <div>
                <h6 class="analytics-campaign-name"><%= campaign.name.present? ? truncate(campaign.name, length: 25) : "Campaign #{campaign.id}" %></h6>
                <small class="analytics-campaign-sent"><%= number_with_delimiter(sent) %> sent</small>
              </div>
              <div class="analytics-campaign-rate <%= rate_class %>">
                <%= number_with_precision(open_rate, precision: 1) %>%
              </div>
            </div>
            <div class="analytics-progress-bar">
              <div class="analytics-progress-fill <%= rate_class %>" style="width: <%= [open_rate, 100].min %>%;"></div>
            </div>
          </div>
        <% end %>
        <button onclick="scoutViewAllCampaigns()" class="analytics-btn primary analytics-btn-full">
          View All Campaigns
        </button>
      </div>
    </div>
  </div>

  <!-- Additional Analytics -->
  <div class="analytics-grid-half">
    <!-- Contact Growth -->
    <div class="analytics-chart-card">
      <div class="analytics-chart-header">
        <h3>
          <i data-lucide="user-plus"></i>
          Contact Growth
        </h3>
      </div>
      <div class="analytics-chart-body analytics-chart-body-small">
        <canvas id="contactGrowthChart"></canvas>
      </div>
    </div>

    <!-- Email Performance Breakdown -->
    <div class="analytics-chart-card">
      <div class="analytics-chart-header">
        <h3>
          <i data-lucide="pie-chart"></i>
          Email Performance Breakdown
        </h3>
      </div>
      <div class="analytics-breakdown">
        <div class="analytics-breakdown-grid">
          <div>
            <div class="analytics-breakdown-value green">85%</div>
            <div class="analytics-breakdown-label">Delivered</div>
          </div>
          <div>
            <div class="analytics-breakdown-value cyan"><%= analytics_data[:avg_open_rate] %>%</div>
            <div class="analytics-breakdown-label">Opened</div>
          </div>
          <div>
            <div class="analytics-breakdown-value red">4.2%</div>
            <div class="analytics-breakdown-label">Clicked</div>
          </div>
        </div>
        <div class="analytics-breakdown-footer">
          <small><i data-lucide="info"></i> Based on last 30 days of campaign data</small>
        </div>
      </div>
    </div>
  </div>

  <!-- AI-Powered Analytics Query Section -->
  <div class="analytics-ai-section">
    <h3>
      <i data-lucide="wand-2"></i>
      AI-Powered Analytics
    </h3>
    <p>Ask Amos to analyze your marketing data, integration metrics, or create custom reports</p>

    <!-- Quick Analysis Buttons -->
    <div class="analytics-ai-buttons">
      <button onclick="quickAnalyticsQuery('campaign_performance')" class="analytics-ai-btn">
        <i data-lucide="mail"></i>
        Campaign Performance
      </button>
      <button onclick="quickAnalyticsQuery('email_engagement')" class="analytics-ai-btn">
        <i data-lucide="trending-up"></i>
        Email Engagement
      </button>
      <button onclick="quickAnalyticsQuery('contact_growth')" class="analytics-ai-btn">
        <i data-lucide="user-plus"></i>
        Contact Growth
      </button>
      <% if current_entity.connections.joins(:integration).where(integrations: { slug: 'stripe' }).where(status: :connected).exists? %>
      <button onclick="quickAnalyticsQuery('stripe_revenue')" class="analytics-ai-btn success">
        <i data-lucide="dollar-sign"></i>
        Stripe Revenue
      </button>
      <% end %>
      <button onclick="customAnalyticsQuery()" class="analytics-ai-btn outline">
        <i data-lucide="help-circle"></i>
        Custom Analysis
      </button>
    </div>
  </div>

  <!-- Recent Activity -->
  <div class="analytics-activity-card">
    <div class="analytics-activity-header">
      <h3>
        <i data-lucide="clock"></i>
        Recent Activity
      </h3>
      <button onclick="scoutViewFullActivity()" class="analytics-btn">
        View All Activity
      </button>
    </div>
    <div class="analytics-activity-list">
      <% [
        { type: 'success', icon: 'send', title: 'Campaign "Newsletter #47" sent', meta: '2 hours ago • 1,234 recipients' },
        { type: 'info', icon: 'user-plus', title: '15 new contacts added', meta: '4 hours ago • From landing page form' },
        { type: 'warning', icon: 'globe', title: 'Landing page "Product Demo" published', meta: '1 day ago • Now live at /landing/product-demo' }
      ].each do |activity| %>
        <div class="analytics-activity-item">
          <div class="analytics-activity-icon <%= activity[:type] %>">
            <i data-lucide="<%= activity[:icon] %>"></i>
          </div>
          <div>
            <div class="analytics-activity-title"><%= activity[:title] %></div>
            <div class="analytics-activity-meta"><%= activity[:meta] %></div>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>

<script>
// Analytics dashboard functionality
function scoutChangeChart(chartType) {
  // Update active button
  document.querySelectorAll('.analytics-chart-tab').forEach(btn => {
    btn.classList.remove('active');
  });
  event.target.classList.add('active');

  window.scoutSendMessage?.(`Show ${chartType} performance chart`);
}

function scoutExportReport() {
  const dateRange = document.getElementById('dateRangeFilter').value;
  window.scoutSendMessage?.(`Export analytics report for last ${dateRange} days`);
}

function scoutCustomReport() {
  window.scoutSendMessage?.("Help me create a custom analytics report");
}

// Quick analytics queries
function quickAnalyticsQuery(type) {
  const queries = {
    'campaign_performance': "Show me campaign performance metrics for the last 90 days",
    'email_engagement': "Analyze email engagement trends over the last quarter",
    'contact_growth': "Show me contact growth trends for the last 6 months",
    'stripe_revenue': "Show me Stripe revenue breakdown by month for this year"
  };

  const query = queries[type];
  if (query && window.scoutSendMessage) {
    window.scoutSendMessage(query);
  }
}

// Custom analytics query
function customAnalyticsQuery() {
  const question = prompt("What would you like to analyze?\n\nExamples:\n- Revenue trends by channel\n- Campaign performance comparison\n- Customer lifetime value\n- Email vs Stripe correlation");

  if (question && window.scoutSendMessage) {
    window.scoutSendMessage(question);
  }
}

function scoutViewAllCampaigns() {
  window.scoutLoadCanvas?.('campaign_viewer');
}

function scoutViewFullActivity() {
  window.scoutSendMessage?.("Show me complete activity log");
}

// Date range filter
document.addEventListener('DOMContentLoaded', function() {
  const dateFilter = document.getElementById('dateRangeFilter');
  if (dateFilter) {
    dateFilter.addEventListener('change', function() {
      window.scoutSendMessage?.(`Update analytics for last ${this.value} days`);
    });
  }

  // Initialize charts
  initializeCharts();
});

function initializeCharts() {
  // Performance Chart (placeholder)
  const performanceCtx = document.getElementById('performanceChart');
  if (performanceCtx) {
    const placeholder = document.createElement('div');
    placeholder.className = 'chart-placeholder';
    placeholder.innerHTML = `
      <div class="chart-placeholder-content">
        <i data-lucide="trending-up"></i>
        <p>Performance chart will display here</p>
        <button onclick="scoutLoadChart('performance')" class="analytics-btn primary">
          Load Chart Data
        </button>
      </div>
    `;
    performanceCtx.parentNode.appendChild(placeholder);
    performanceCtx.style.display = 'none';
  }

  // Contact Growth Chart (placeholder)
  const contactCtx = document.getElementById('contactGrowthChart');
  if (contactCtx) {
    const placeholder = document.createElement('div');
    placeholder.className = 'chart-placeholder';
    placeholder.innerHTML = `
      <div class="chart-placeholder-content">
        <i data-lucide="users"></i>
        <p>Contact growth chart</p>
        <button onclick="scoutLoadChart('contacts')" class="analytics-btn primary">
          Load Data
        </button>
      </div>
    `;
    contactCtx.parentNode.appendChild(placeholder);
    contactCtx.style.display = 'none';
  }

  if (typeof lucide !== 'undefined') {
    lucide.createIcons();
  }
}

function scoutLoadChart(chartType) {
  window.scoutSendMessage?.(`Load ${chartType} chart data`);
}

// Initialize on load
document.addEventListener('turbo:load', () => {
  if (typeof lucide !== 'undefined') {
    lucide.createIcons();
  }
});

document.addEventListener('DOMContentLoaded', () => {
  if (typeof lucide !== 'undefined') {
    lucide.createIcons();
  }
});
</script>
