<div class="scout-canvas analytics-dashboard" style="background-color: #0A0E1A; color: #FFFFFF; min-height: 100vh; padding: 2rem;">
  <!-- Page Header -->
  <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 2rem; flex-wrap: wrap; gap: 1rem;">
    <div>
      <h1 style="color: #FFFFFF; font-size: 2rem; font-weight: 700; margin-bottom: 0.5rem; display: flex; align-items: center; gap: 1rem;">
        <i data-lucide="bar-chart-3" style="width: 2rem; height: 2rem;"></i>
        Analytics Dashboard
      </h1>
      <p style="color: #94A3B8; margin-bottom: 0;">Marketing performance insights and metrics</p>
    </div>
    <div style="display: flex; gap: 1rem; flex-wrap: wrap;">
      <select class="form-select" id="dateRangeFilter" style="width: auto; background: #1A1F35; border: 1px solid #1E293B; color: #FFFFFF; border-radius: 0.5rem; padding: 0.5rem;">
        <option value="7" style="background: #1A1F35; color: #FFFFFF;">Last 7 days</option>
        <option value="30" selected style="background: #1A1F35; color: #FFFFFF;">Last 30 days</option>
        <option value="90" style="background: #1A1F35; color: #FFFFFF;">Last 90 days</option>
        <option value="365" style="background: #1A1F35; color: #FFFFFF;">Last year</option>
      </select>
      <button onclick="scoutExportReport()" style="background: transparent; border: 1px solid #1E293B; color: #94A3B8; padding: 0.5rem 1rem; border-radius: 0.5rem; cursor: pointer; display: flex; align-items: center; gap: 0.5rem; font-weight: 500; transition: all 0.2s ease;">
        <i data-lucide="download" style="width: 1rem; height: 1rem;"></i>
        Export
      </button>
      <button onclick="scoutCustomReport()" style="background: linear-gradient(135deg, #7C3AED 0%, #A78BFA 100%); border: none; color: #FFFFFF; padding: 0.5rem 1rem; border-radius: 0.5rem; cursor: pointer; display: flex; align-items: center; gap: 0.5rem; font-weight: 500; transition: all 0.2s ease;">
        <i data-lucide="trending-up" style="width: 1rem; height: 1rem;"></i>
        Custom Report
      </button>
    </div>
  </div>

  <!-- Key Metrics Overview -->
  <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1.5rem; margin-bottom: 2rem;">
    <!-- Total Emails Sent -->
    <div style="background: #1A1F35; border: 1px solid #1E293B; border-radius: 0.75rem; padding: 1.5rem;">
      <div style="display: flex; align-items: center; gap: 1rem;">
        <div style="width: 3rem; height: 3rem; background: linear-gradient(135deg, #7C3AED 0%, #A78BFA 100%); border-radius: 0.75rem; display: flex; align-items: center; justify-content: center;">
          <i data-lucide="mail" style="width: 1.5rem; height: 1.5rem; color: white;"></i>
        </div>
        <div>
          <p style="color: #94A3B8; font-size: 0.875rem; margin: 0;">Total Emails Sent</p>
          <h3 style="color: white; font-size: 1.875rem; font-weight: 600; margin: 0;"><%= number_with_delimiter(analytics_data[:total_emails_sent]) %></h3>
          <span style="color: rgb(74, 222, 128); font-size: 0.75rem; font-weight: 600;"><i data-lucide="arrow-up" style="width: 0.75rem; height: 0.75rem; display: inline-block; vertical-align: middle;"></i> +12.5%</span>
        </div>
      </div>
    </div>

    <!-- Average Open Rate -->
    <div style="background: #1A1F35; border: 1px solid #1E293B; border-radius: 0.75rem; padding: 1.5rem;">
      <div style="display: flex; align-items: center; gap: 1rem;">
        <div style="width: 3rem; height: 3rem; background: rgba(34, 197, 94, 0.1); border: 1px solid rgba(34, 197, 94, 0.2); border-radius: 0.75rem; display: flex; align-items: center; justify-content: center;">
          <i data-lucide="eye" style="width: 1.5rem; height: 1.5rem; color: rgb(74, 222, 128);"></i>
        </div>
        <div>
          <p style="color: #94A3B8; font-size: 0.875rem; margin: 0;">Average Open Rate</p>
          <h3 style="color: white; font-size: 1.875rem; font-weight: 600; margin: 0;"><%= analytics_data[:avg_open_rate] %>%</h3>
          <span style="color: <%= analytics_data[:avg_open_rate] > 20 ? 'rgb(74, 222, 128)' : 'rgb(248, 113, 113)' %>; font-size: 0.75rem; font-weight: 600;"><i data-lucide="<%= analytics_data[:avg_open_rate] > 20 ? 'arrow-up' : 'arrow-down' %>" style="width: 0.75rem; height: 0.75rem; display: inline-block; vertical-align: middle;"></i> <%= analytics_data[:avg_open_rate] > 20 ? '+' : '-' %>2.1%</span>
        </div>
      </div>
    </div>

    <!-- New Contacts -->
    <div style="background: #1A1F35; border: 1px solid #1E293B; border-radius: 0.75rem; padding: 1.5rem;">
      <div style="display: flex; align-items: center; gap: 1rem;">
        <div style="width: 3rem; height: 3rem; background: rgba(34, 211, 238, 0.1); border: 1px solid rgba(34, 211, 238, 0.2); border-radius: 0.75rem; display: flex; align-items: center; justify-content: center;">
          <i data-lucide="users" style="width: 1.5rem; height: 1.5rem; color: #22D3EE;"></i>
        </div>
        <div>
          <p style="color: #94A3B8; font-size: 0.875rem; margin: 0;">New Contacts (30d)</p>
          <h3 style="color: white; font-size: 1.875rem; font-weight: 600; margin: 0;"><%= number_with_delimiter(analytics_data[:recent_contacts]) %></h3>
          <span style="color: rgb(74, 222, 128); font-size: 0.75rem; font-weight: 600;"><i data-lucide="arrow-up" style="width: 0.75rem; height: 0.75rem; display: inline-block; vertical-align: middle;"></i> +8.3%</span>
        </div>
      </div>
    </div>

    <!-- Active Landing Pages -->
    <div style="background: #1A1F35; border: 1px solid #1E293B; border-radius: 0.75rem; padding: 1.5rem;">
      <div style="display: flex; align-items: center; gap: 1rem;">
        <div style="width: 3rem; height: 3rem; background: rgba(250, 204, 21, 0.1); border: 1px solid rgba(250, 204, 21, 0.2); border-radius: 0.75rem; display: flex; align-items: center; justify-content: center;">
          <i data-lucide="globe" style="width: 1.5rem; height: 1.5rem; color: rgb(250, 204, 21);"></i>
        </div>
        <div>
          <p style="color: #94A3B8; font-size: 0.875rem; margin: 0;">Active Landing Pages</p>
          <h3 style="color: white; font-size: 1.875rem; font-weight: 600; margin: 0;"><%= analytics_data[:landing_pages] %></h3>
          <span style="color: #64748B; font-size: 0.75rem; font-weight: 600;"><i data-lucide="minus" style="width: 0.75rem; height: 0.75rem; display: inline-block; vertical-align: middle;"></i> 0%</span>
        </div>
      </div>
    </div>
  </div>

  <!-- Charts Row -->
  <div style="display: grid; grid-template-columns: 2fr 1fr; gap: 1.5rem; margin-bottom: 2rem;">
    <!-- Campaign Performance Chart -->
    <div style="background: #1A1F35; border: 1px solid #1E293B; border-radius: 0.75rem; overflow: hidden;">
      <div style="background: #0F172A; padding: 1.5rem; border-bottom: 1px solid #1E293B; display: flex; justify-content: space-between; align-items: center;">
        <h3 style="color: #FFFFFF; font-size: 1rem; font-weight: 600; margin: 0; display: flex; align-items: center; gap: 0.75rem;">
          <i data-lucide="trending-up" style="width: 1.25rem; height: 1.25rem;"></i>
          Campaign Performance Over Time
        </h3>
        <div style="display: flex; gap: 0.5rem;">
          <button type="button" onclick="scoutChangeChart('emails')" style="background: linear-gradient(135deg, #7C3AED 0%, #A78BFA 100%); color: white; border: none; padding: 0.375rem 0.75rem; border-radius: 0.375rem; cursor: pointer; font-size: 0.75rem; font-weight: 600;" class="chart-btn active">
            Emails
          </button>
          <button type="button" onclick="scoutChangeChart('opens')" style="background: transparent; color: #94A3B8; border: 1px solid #1E293B; padding: 0.375rem 0.75rem; border-radius: 0.375rem; cursor: pointer; font-size: 0.75rem; font-weight: 600;" class="chart-btn">
            Opens
          </button>
          <button type="button" onclick="scoutChangeChart('clicks')" style="background: transparent; color: #94A3B8; border: 1px solid #1E293B; padding: 0.375rem 0.75rem; border-radius: 0.375rem; cursor: pointer; font-size: 0.75rem; font-weight: 600;" class="chart-btn">
            Clicks
          </button>
        </div>
      </div>
      <div style="padding: 1.5rem; height: 300px;">
        <canvas id="performanceChart"></canvas>
      </div>
    </div>

    <!-- Top Campaigns -->
    <div style="background: #1A1F35; border: 1px solid #1E293B; border-radius: 0.75rem; overflow: hidden;">
      <div style="background: #0F172A; padding: 1.5rem; border-bottom: 1px solid #1E293B;">
        <h3 style="color: #FFFFFF; font-size: 1rem; font-weight: 600; margin: 0; display: flex; align-items: center; gap: 0.75rem;">
          <i data-lucide="trophy" style="width: 1.25rem; height: 1.25rem;"></i>
          Top Performing Campaigns
        </h3>
      </div>
      <div style="padding: 1.5rem; max-height: 400px; overflow-y: auto;">
        <% analytics_data[:campaigns].limit(5).each_with_index do |campaign, index| %>
          <%
            sent = campaign.mailgun_stats&.dig('sent') || 0
            opened = campaign.mailgun_stats&.dig('opened') || 0
            open_rate = sent > 0 ? (opened.to_f / sent * 100) : 0
          %>
          <div style="padding-bottom: 1rem; <%= 'border-bottom: 1px solid #1E293B; margin-bottom: 1rem;' unless index == 4 %>">
            <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 0.75rem;">
              <div>
                <h6 style="color: #FFFFFF; font-weight: 600; margin: 0;"><%= campaign.name.present? ? truncate(campaign.name, length: 25) : "Campaign #{campaign.id}" %></h6>
                <small style="color: #94A3B8;"><%= number_with_delimiter(sent) %> sent</small>
              </div>
              <div style="background: <%= open_rate > 25 ? 'rgba(34, 197, 94, 0.2); color: rgb(74, 222, 128);' : open_rate > 15 ? 'rgba(250, 204, 21, 0.2); color: rgb(250, 204, 21);' : 'rgba(248, 113, 113, 0.2); color: rgb(248, 113, 113);' %> padding: 0.25rem 0.5rem; border-radius: 0.375rem; font-size: 0.75rem; font-weight: 600;">
                <%= number_with_precision(open_rate, precision: 1) %>%
              </div>
            </div>
            <div style="width: 100%; height: 4px; background: #0F172A; border-radius: 2px; overflow: hidden;">
              <div style="width: <%= [open_rate, 100].min %>%; height: 100%; background: <%= open_rate > 25 ? 'rgb(74, 222, 128)' : open_rate > 15 ? 'rgb(250, 204, 21)' : 'rgb(248, 113, 113)' %>;"></div>
            </div>
          </div>
        <% end %>
        <button onclick="scoutViewAllCampaigns()" style="width: 100%; background: transparent; color: #22D3EE; border: 1px solid #22D3EE; padding: 0.5rem; border-radius: 0.375rem; cursor: pointer; font-weight: 500; margin-top: 1rem;">
          View All Campaigns
        </button>
      </div>
    </div>
  </div>

  <!-- Additional Analytics -->
  <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; margin-bottom: 2rem;">
    <!-- Contact Growth -->
    <div style="background: #1A1F35; border: 1px solid #1E293B; border-radius: 0.75rem; overflow: hidden;">
      <div style="background: #0F172A; padding: 1.5rem; border-bottom: 1px solid #1E293B;">
        <h3 style="color: #FFFFFF; font-size: 1rem; font-weight: 600; margin: 0; display: flex; align-items: center; gap: 0.75rem;">
          <i data-lucide="user-plus" style="width: 1.25rem; height: 1.25rem;"></i>
          Contact Growth
        </h3>
      </div>
      <div style="padding: 1.5rem; height: 200px;">
        <canvas id="contactGrowthChart"></canvas>
      </div>
    </div>

    <!-- Email Performance Breakdown -->
    <div style="background: #1A1F35; border: 1px solid #1E293B; border-radius: 0.75rem; overflow: hidden;">
      <div style="background: #0F172A; padding: 1.5rem; border-bottom: 1px solid #1E293B;">
        <h3 style="color: #FFFFFF; font-size: 1rem; font-weight: 600; margin: 0; display: flex; align-items: center; gap: 0.75rem;">
          <i data-lucide="pie-chart" style="width: 1.25rem; height: 1.25rem;"></i>
          Email Performance Breakdown
        </h3>
      </div>
      <div style="padding: 1.5rem;">
        <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; text-align: center; margin-bottom: 1.5rem;">
          <div>
            <div style="font-size: 1.5rem; font-weight: 700; color: rgb(74, 222, 128); margin-bottom: 0.25rem;">85%</div>
            <div style="font-size: 0.75rem; color: #94A3B8;">Delivered</div>
          </div>
          <div>
            <div style="font-size: 1.5rem; font-weight: 700; color: #22D3EE; margin-bottom: 0.25rem;"><%= analytics_data[:avg_open_rate] %>%</div>
            <div style="font-size: 0.75rem; color: #94A3B8;">Opened</div>
          </div>
          <div>
            <div style="font-size: 1.5rem; font-weight: 700; color: rgb(248, 113, 113); margin-bottom: 0.25rem;">4.2%</div>
            <div style="font-size: 0.75rem; color: #94A3B8;">Clicked</div>
          </div>
        </div>
        <div style="padding-top: 1rem; border-top: 1px solid #1E293B;">
          <small style="color: #94A3B8;"><i data-lucide="info" style="width: 0.75rem; height: 0.75rem; display: inline-block; vertical-align: middle;"></i> Based on last 30 days of campaign data</small>
        </div>
      </div>
    </div>
  </div>

  <!-- AI-Powered Analytics Query Section -->
  <div style="background: linear-gradient(135deg, #7C3AED 0%, #A78BFA 100%); border-radius: 0.75rem; padding: 2rem; margin-bottom: 2rem;">
    <h3 style="color: #FFFFFF; font-size: 1.125rem; font-weight: 600; margin-bottom: 0.75rem; display: flex; align-items: center; gap: 0.75rem;">
      <i data-lucide="wand-2" style="width: 1.25rem; height: 1.25rem;"></i>
      AI-Powered Analytics
    </h3>
    <p style="color: rgba(255, 255, 255, 0.9); margin-bottom: 1.5rem; font-size: 0.875rem;">Ask Amos to analyze your marketing data, integration metrics, or create custom reports</p>

    <!-- Quick Analysis Buttons -->
    <div style="display: flex; gap: 1rem; flex-wrap: wrap;">
      <button onclick="quickAnalyticsQuery('campaign_performance')" style="background: rgba(255, 255, 255, 0.95); color: #374151; border: none; padding: 0.5rem 1rem; border-radius: 0.375rem; cursor: pointer; font-weight: 500; display: flex; align-items: center; gap: 0.5rem;">
        <i data-lucide="mail" style="width: 1rem; height: 1rem;"></i>
        Campaign Performance
      </button>
      <button onclick="quickAnalyticsQuery('email_engagement')" style="background: rgba(255, 255, 255, 0.95); color: #374151; border: none; padding: 0.5rem 1rem; border-radius: 0.375rem; cursor: pointer; font-weight: 500; display: flex; align-items: center; gap: 0.5rem;">
        <i data-lucide="trending-up" style="width: 1rem; height: 1rem;"></i>
        Email Engagement
      </button>
      <button onclick="quickAnalyticsQuery('contact_growth')" style="background: rgba(255, 255, 255, 0.95); color: #374151; border: none; padding: 0.5rem 1rem; border-radius: 0.375rem; cursor: pointer; font-weight: 500; display: flex; align-items: center; gap: 0.5rem;">
        <i data-lucide="user-plus" style="width: 1rem; height: 1rem;"></i>
        Contact Growth
      </button>
      <% if current_entity.connections.joins(:integration).where(integrations: { slug: 'stripe' }).where(status: :connected).exists? %>
      <button onclick="quickAnalyticsQuery('stripe_revenue')" style="background: #10b981; color: #FFFFFF; border: none; padding: 0.5rem 1rem; border-radius: 0.375rem; cursor: pointer; font-weight: 500; display: flex; align-items: center; gap: 0.5rem;">
        <i data-lucide="dollar-sign" style="width: 1rem; height: 1rem;"></i>
        Stripe Revenue
      </button>
      <% end %>
      <button onclick="customAnalyticsQuery()" style="background: transparent; color: #FFFFFF; border: 1px solid rgba(255, 255, 255, 0.8); padding: 0.5rem 1rem; border-radius: 0.375rem; cursor: pointer; font-weight: 500; display: flex; align-items: center; gap: 0.5rem;">
        <i data-lucide="help-circle" style="width: 1rem; height: 1rem;"></i>
        Custom Analysis
      </button>
    </div>
  </div>

  <!-- Recent Activity -->
  <div style="background: #1A1F35; border: 1px solid #1E293B; border-radius: 0.75rem; overflow: hidden;">
    <div style="background: #0F172A; padding: 1.5rem; border-bottom: 1px solid #1E293B; display: flex; justify-content: space-between; align-items: center;">
      <h3 style="color: #FFFFFF; font-size: 1rem; font-weight: 600; margin: 0; display: flex; align-items: center; gap: 0.75rem;">
        <i data-lucide="clock" style="width: 1.25rem; height: 1.25rem;"></i>
        Recent Activity
      </h3>
      <button onclick="scoutViewFullActivity()" style="background: transparent; color: #22D3EE; border: 1px solid #22D3EE; padding: 0.375rem 0.75rem; border-radius: 0.375rem; cursor: pointer; font-size: 0.75rem; font-weight: 600;">
        View All Activity
      </button>
    </div>
    <div style="padding: 1.5rem;">
      <% ['success', 'info', 'warning'].each_with_index do |type, index| %>
        <div style="display: flex; gap: 1rem; padding-bottom: 1rem; <%= 'border-bottom: 1px solid #1E293B; margin-bottom: 1rem;' unless index == 2 %>">
          <div style="width: 2.5rem; height: 2.5rem; border-radius: 50%; display: flex; align-items: center; justify-content: center; flex-shrink: 0; background: <%= type == 'success' ? 'rgb(74, 222, 128)' : type == 'info' ? '#22D3EE' : 'rgb(250, 204, 21)' %>; color: white;">
            <% if type == 'success' %>
              <i data-lucide="send" style="width: 1.25rem; height: 1.25rem;"></i>
            <% elsif type == 'info' %>
              <i data-lucide="user-plus" style="width: 1.25rem; height: 1.25rem;"></i>
            <% else %>
              <i data-lucide="globe" style="width: 1.25rem; height: 1.25rem;"></i>
            <% end %>
          </div>
          <div>
            <div style="color: #FFFFFF; font-weight: 600; margin-bottom: 0.25rem;">
              <% if type == 'success' %>
                Campaign "Newsletter #47" sent
              <% elsif type == 'info' %>
                15 new contacts added
              <% else %>
                Landing page "Product Demo" published
              <% end %>
            </div>
            <div style="color: #94A3B8; font-size: 0.875rem;">
              <% if type == 'success' %>
                2 hours ago • 1,234 recipients
              <% elsif type == 'info' %>
                4 hours ago • From landing page form
              <% else %>
                1 day ago • Now live at /landing/product-demo
              <% end %>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>

<script>
// Analytics dashboard functionality
function scoutChangeChart(chartType) {
  // Update active button
  document.querySelectorAll('.chart-btn').forEach(btn => {
    btn.style.background = 'transparent';
    btn.style.color = '#94A3B8';
    btn.style.border = '1px solid #1E293B';
  });
  event.target.style.background = 'linear-gradient(135deg, #7C3AED 0%, #A78BFA 100%)';
  event.target.style.color = '#FFFFFF';
  event.target.style.border = 'none';

  window.scoutSendMessage?.(`Show ${chartType} performance chart`);
}

function scoutExportReport() {
  const dateRange = document.getElementById('dateRangeFilter').value;
  window.scoutSendMessage?.(`Export analytics report for last ${dateRange} days`);
}

function scoutCustomReport() {
  window.scoutSendMessage?.("Help me create a custom analytics report");
}

// Quick analytics queries
function quickAnalyticsQuery(type) {
  const queries = {
    'campaign_performance': "Show me campaign performance metrics for the last 90 days",
    'email_engagement': "Analyze email engagement trends over the last quarter",
    'contact_growth': "Show me contact growth trends for the last 6 months",
    'stripe_revenue': "Show me Stripe revenue breakdown by month for this year"
  };

  const query = queries[type];
  if (query && window.scoutSendMessage) {
    window.scoutSendMessage(query);
  }
}

// Custom analytics query
function customAnalyticsQuery() {
  const question = prompt("What would you like to analyze?\n\nExamples:\n- Revenue trends by channel\n- Campaign performance comparison\n- Customer lifetime value\n- Email vs Stripe correlation");

  if (question && window.scoutSendMessage) {
    window.scoutSendMessage(question);
  }
}

function scoutViewAllCampaigns() {
  window.scoutLoadCanvas?.('campaign_viewer');
}

function scoutViewFullActivity() {
  window.scoutSendMessage?.("Show me complete activity log");
}

// Date range filter
document.addEventListener('DOMContentLoaded', function() {
  const dateFilter = document.getElementById('dateRangeFilter');
  if (dateFilter) {
    dateFilter.addEventListener('change', function() {
      window.scoutSendMessage?.(`Update analytics for last ${this.value} days`);
    });
  }

  // Initialize charts
  initializeCharts();
});

function initializeCharts() {
  // Performance Chart (placeholder)
  const performanceCtx = document.getElementById('performanceChart');
  if (performanceCtx) {
    performanceCtx.style.background = 'linear-gradient(45deg, #0F172A, #1A1F35)';
    performanceCtx.style.borderRadius = '8px';

    const placeholder = document.createElement('div');
    placeholder.className = 'chart-placeholder';
    placeholder.innerHTML = `
      <div style="text-align: center; padding: 2rem;">
        <i data-lucide="trending-up" style="width: 2rem; height: 2rem; color: #64748B; margin-bottom: 1rem; display: block;"></i>
        <p style="color: #64748B; margin-bottom: 1rem;">Performance chart will display here</p>
        <button onclick="scoutLoadChart('performance')" style="background: linear-gradient(135deg, #7C3AED 0%, #A78BFA 100%); color: white; border: none; padding: 0.5rem 1rem; border-radius: 0.375rem; cursor: pointer; font-size: 0.875rem; font-weight: 500;">
          Load Chart Data
        </button>
      </div>
    `;
    performanceCtx.parentNode.appendChild(placeholder);
    performanceCtx.style.display = 'none';
  }

  // Contact Growth Chart (placeholder)
  const contactCtx = document.getElementById('contactGrowthChart');
  if (contactCtx) {
    contactCtx.style.background = 'linear-gradient(45deg, #0F172A, #1A1F35)';
    contactCtx.style.borderRadius = '8px';

    const placeholder = document.createElement('div');
    placeholder.className = 'chart-placeholder';
    placeholder.innerHTML = `
      <div style="text-align: center; padding: 2rem;">
        <i data-lucide="users" style="width: 2rem; height: 2rem; color: #64748B; margin-bottom: 1rem; display: block;"></i>
        <p style="color: #64748B; font-size: 0.875rem; margin-bottom: 1rem;">Contact growth chart</p>
        <button onclick="scoutLoadChart('contacts')" style="background: linear-gradient(135deg, #7C3AED 0%, #A78BFA 100%); color: white; border: none; padding: 0.5rem 1rem; border-radius: 0.375rem; cursor: pointer; font-size: 0.875rem; font-weight: 500;">
          Load Data
        </button>
      </div>
    `;
    contactCtx.parentNode.appendChild(placeholder);
    contactCtx.style.display = 'none';
  }

  if (typeof lucide !== 'undefined') {
    lucide.createIcons();
  }
}

function scoutLoadChart(chartType) {
  window.scoutSendMessage?.(`Load ${chartType} chart data`);
}

// Initialize on load
document.addEventListener('turbo:load', () => {
  if (typeof lucide !== 'undefined') {
    lucide.createIcons();
  }
});

document.addEventListener('DOMContentLoaded', () => {
  if (typeof lucide !== 'undefined') {
    lucide.createIcons();
