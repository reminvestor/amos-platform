}

.metric-badge {
  color: white;
  padding: 0.25rem 0.5rem;
  border-radius: 0.375rem;
  font-size: 0.75rem;
  font-weight: 600;
}

.metric-circle {
  text-align: center;
}

.metric-circle-value {
  font-size: 1.5rem;
  font-weight: 700;
  color: #495057;
}

