<%# Module Marketplace Canvas - Browse and install module templates %>
<div class="module-marketplace-canvas p-4" data-controller="module-marketplace">
  <!-- Header -->
  <div class="marketplace-header mb-4">
    <div class="row align-items-center">
      <div class="col-md-8">
        <h2 class="mb-1">
          <i data-lucide="store" class="me-2"></i>
          Module Marketplace
        </h2>
        <p class="text-muted mb-0">Browse pre-built modules or request a custom one</p>
      </div>
      <div class="col-md-4 text-end">
        <button class="btn btn-primary" data-action="click->module-marketplace#requestCustom">
          <i data-lucide="sparkles"></i> Request Custom Module
        </button>
      </div>
    </div>
  </div>

  <!-- Search and Filters -->
  <div class="card mb-4">
    <div class="card-body">
      <div class="row">
        <div class="col-md-6">
          <div class="input-group">
            <span class="input-group-text bg-white"><i data-lucide="search"></i></span>
            <input type="text" class="form-control" placeholder="Search modules..." 
                   data-module-marketplace-target="search"
                   data-action="input->module-marketplace#search">
          </div>
        </div>
        <div class="col-md-6">
          <div class="btn-group w-100">
            <button class="btn btn-outline-secondary active" data-category="all" data-action="click->module-marketplace#filterCategory">
              All
            </button>
            <button class="btn btn-outline-secondary" data-category="business" data-action="click->module-marketplace#filterCategory">
              Business
            </button>
            <button class="btn btn-outline-secondary" data-category="sales" data-action="click->module-marketplace#filterCategory">
              Sales
            </button>
            <button class="btn btn-outline-secondary" data-category="operations" data-action="click->module-marketplace#filterCategory">
              Operations
            </button>
            <button class="btn btn-outline-secondary" data-category="finance" data-action="click->module-marketplace#filterCategory">
              Finance
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Featured Modules -->
  <h5 class="mb-3"><i data-lucide="star" class="me-2"></i> Featured Templates</h5>
  <div class="row mb-4" data-module-marketplace-target="featured">
    <!-- Inventory Management -->
