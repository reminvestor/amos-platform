<%# Apps Canvas - Unified marketplace for apps and modules %>
<div class="apps-canvas p-4" data-controller="module-marketplace">
  <!-- Header -->
  <div class="apps-header mb-4">
    <div class="row align-items-center">
      <div class="col-md-8">
        <h2 class="mb-1">
          <i data-lucide="grid-2x2" class="me-2"></i>
          Apps
        </h2>
        <p class="text-muted mb-0">Add new capabilities to your workspace</p>
      </div>
      <div class="col-md-4 text-end">
        <button class="btn btn-primary" data-action="click->module-marketplace#requestCustom">
          <i data-lucide="sparkles"></i> Build Custom App
        </button>
      </div>
    </div>
  </div>

  <!-- Search and Filters -->
  <div class="card mb-4">
    <div class="card-body">
      <div class="row">
        <div class="col-md-6">
          <div class="input-group">
            <span class="input-group-text bg-white"><i data-lucide="search"></i></span>
            <input type="text" class="form-control" placeholder="Search apps..." 
                   data-module-marketplace-target="search"
                   data-action="input->module-marketplace#search">
          </div>
        </div>
        <div class="col-md-6">
          <div class="btn-group w-100">
            <button class="btn btn-outline-secondary active" data-category="all" data-action="click->module-marketplace#filterCategory">
              All
            </button>
            <button class="btn btn-outline-secondary" data-category="business" data-action="click->module-marketplace#filterCategory">
              Business
            </button>
            <button class="btn btn-outline-secondary" data-category="sales" data-action="click->module-marketplace#filterCategory">
              Sales
            </button>
            <button class="btn btn-outline-secondary" data-category="operations" data-action="click->module-marketplace#filterCategory">
              Operations
            </button>
            <button class="btn btn-outline-secondary" data-category="finance" data-action="click->module-marketplace#filterCategory">
              Finance
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Featured Apps -->
  <h5 class="mb-3"><i data-lucide="star" class="me-2"></i> Featured Apps</h5>
  <div class="row mb-4" data-module-marketplace-target="featured">
    <!-- Social Media Manager (App with AI Assistant) -->
    <div class="col-md-4 mb-3">
      <div class="card h-100 app-card">
        <div class="card-body">
          <div class="d-flex justify-content-between mb-3">
            <div class="app-icon bg-primary-subtle rounded p-3">
              <i data-lucide="share-2" style="width: 32px; height: 32px;"></i>
            </div>
            <div>
              <span class="badge bg-purple me-1" title="Includes AI assistant">
                <i data-lucide="bot" style="width: 10px; height: 10px;"></i> AI
              </span>
              <span class="badge bg-success">Popular</span>
            </div>
          </div>
          <h5 class="card-title">Social Media Manager</h5>
          <p class="card-text text-muted small">Plan, schedule, and analyze social posts across platforms. Includes content calendar.</p>
          <div class="small text-muted mb-3">
            <span class="me-2"><i data-lucide="database" style="width: 14px;"></i> 3 models</span>
            <span class="me-2"><i data-lucide="layout" style="width: 14px;"></i> 5 canvases</span>
            <span><i data-lucide="wrench" style="width: 14px;"></i> 10 tools</span>
          </div>
        </div>
        <div class="card-footer bg-transparent">
          <button class="btn btn-primary w-100" data-action="click->module-marketplace#installTemplate" 
                  data-template="social_media_manager">
            <i data-lucide="download"></i> Install
          </button>
        </div>
      </div>
    </div>

    <!-- Inventory Management -->
    <div class="col-md-4 mb-3">
      <div class="card h-100 app-card">
        <div class="card-body">
          <div class="d-flex justify-content-between mb-3">
            <div class="app-icon bg-success-subtle rounded p-3">
              <i data-lucide="package" style="width: 32px; height: 32px;"></i>
            </div>
            <span class="badge bg-info">Essential</span>
          </div>
          <h5 class="card-title">Inventory Management</h5>
          <p class="card-text text-muted small">Track products, stock levels, reorder points, and suppliers. Get alerts for low stock.</p>
          <div class="small text-muted mb-3">
            <span class="me-2"><i data-lucide="database" style="width: 14px;"></i> 3 models</span>
            <span class="me-2"><i data-lucide="layout" style="width: 14px;"></i> 4 canvases</span>
            <span><i data-lucide="wrench" style="width: 14px;"></i> 8 tools</span>
          </div>
        </div>
        <div class="card-footer bg-transparent">
          <button class="btn btn-primary w-100" data-action="click->module-marketplace#installTemplate" 
                  data-template="inventory_management">
            <i data-lucide="download"></i> Install
          </button>
        </div>
      </div>
    </div>

    <!-- Project Management -->
    <div class="col-md-4 mb-3">
      <div class="card h-100 app-card">
        <div class="card-body">
          <div class="d-flex justify-content-between mb-3">
            <div class="app-icon bg-warning-subtle rounded p-3">
              <i data-lucide="kanban" style="width: 32px; height: 32px;"></i>
            </div>
            <div>
              <span class="badge bg-purple me-1" title="Includes AI assistant">
                <i data-lucide="bot" style="width: 10px; height: 10px;"></i> AI
              </span>
              <span class="badge bg-info">New</span>
            </div>
          </div>
          <h5 class="card-title">Project Tracker</h5>
          <p class="card-text text-muted small">Manage projects, tasks, milestones, and team assignments. Kanban board included.</p>
          <div class="small text-muted mb-3">
            <span class="me-2"><i data-lucide="database" style="width: 14px;"></i> 4 models</span>
            <span class="me-2"><i data-lucide="layout" style="width: 14px;"></i> 5 canvases</span>
            <span><i data-lucide="wrench" style="width: 14px;"></i> 12 tools</span>
          </div>
        </div>
        <div class="card-footer bg-transparent">
          <button class="btn btn-primary w-100" data-action="click->module-marketplace#installTemplate"
                  data-template="project_management">
            <i data-lucide="download"></i> Install
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- All Apps Grid -->
  <h5 class="mb-3"><i data-lucide="grid-3x3" class="me-2"></i> All Apps</h5>
  <div class="row" data-module-marketplace-target="grid">
    <!-- Event Planner -->
    <div class="col-md-3 mb-3" data-category="operations">
      <div class="card h-100 app-card-sm">
        <div class="card-body">
          <div class="d-flex justify-content-between mb-2">
            <div class="app-icon-sm bg-primary-subtle rounded p-2 d-inline-block">
              <i data-lucide="calendar" style="width: 20px; height: 20px;"></i>
            </div>
            <span class="badge bg-purple small" title="Includes AI assistant">
              <i data-lucide="bot" style="width: 10px; height: 10px;"></i>
            </span>
          </div>
          <h6 class="card-title mb-1">Event Planner</h6>
          <p class="card-text text-muted small mb-2">Plan events, track RSVPs, manage venues and speakers.</p>
          <button class="btn btn-outline-primary btn-sm w-100" data-action="click->module-marketplace#installTemplate"
                  data-template="event_management">
            Install
          </button>
        </div>
      </div>
    </div>

    <!-- Financial Tracking -->
    <div class="col-md-3 mb-3" data-category="finance">
      <div class="card h-100 app-card-sm">
        <div class="card-body">
          <div class="app-icon-sm bg-warning-subtle rounded p-2 mb-2 d-inline-block">
            <i data-lucide="wallet" style="width: 20px; height: 20px;"></i>
          </div>
          <h6 class="card-title mb-1">Financial Tracking</h6>
          <p class="card-text text-muted small mb-2">Track income, expenses, invoices, and generate reports.</p>
          <button class="btn btn-outline-primary btn-sm w-100" data-action="click->module-marketplace#installTemplate"
                  data-template="financial_tracking">
            Install
          </button>
        </div>
      </div>
    </div>

    <!-- CRM Extension -->
    <div class="col-md-3 mb-3" data-category="sales">
      <div class="card h-100 app-card-sm">
        <div class="card-body">
          <div class="app-icon-sm bg-info-subtle rounded p-2 mb-2 d-inline-block">
            <i data-lucide="users" style="width: 20px; height: 20px;"></i>
          </div>
          <h6 class="card-title mb-1">CRM Extension</h6>
          <p class="card-text text-muted small mb-2">Enhanced contact management with custom fields and segments.</p>
          <button class="btn btn-outline-primary btn-sm w-100" data-action="click->module-marketplace#installTemplate"
                  data-template="crm_extension">
            Install
          </button>
        </div>
      </div>
    </div>

    <!-- Property Management -->
    <div class="col-md-3 mb-3" data-category="business">
      <div class="card h-100 app-card-sm">
        <div class="card-body">
          <div class="app-icon-sm bg-danger-subtle rounded p-2 mb-2 d-inline-block">
            <i data-lucide="building" style="width: 20px; height: 20px;"></i>
          </div>
          <h6 class="card-title mb-1">Property Management</h6>
          <p class="card-text text-muted small mb-2">Manage properties, tenants, leases, and maintenance.</p>
          <button class="btn btn-outline-primary btn-sm w-100" data-action="click->module-marketplace#installTemplate"
                  data-template="property_management">
            Install
          </button>
        </div>
      </div>
    </div>

    <!-- Support Tickets -->
    <div class="col-md-3 mb-3" data-category="operations">
      <div class="card h-100 app-card-sm">
        <div class="card-body">
          <div class="app-icon-sm bg-secondary-subtle rounded p-2 mb-2 d-inline-block">
            <i data-lucide="ticket" style="width: 20px; height: 20px;"></i>
          </div>
          <h6 class="card-title mb-1">Support Tickets</h6>
          <p class="card-text text-muted small mb-2">Customer support ticketing with SLA tracking.</p>
          <button class="btn btn-outline-primary btn-sm w-100" data-action="click->module-marketplace#installTemplate"
                  data-template="support_tickets">
            Install
          </button>
        </div>
      </div>
    </div>

    <!-- Employee Directory -->
    <div class="col-md-3 mb-3" data-category="business">
      <div class="card h-100 app-card-sm">
        <div class="card-body">
          <div class="app-icon-sm bg-success-subtle rounded p-2 mb-2 d-inline-block">
            <i data-lucide="contact" style="width: 20px; height: 20px;"></i>
          </div>
          <h6 class="card-title mb-1">Employee Directory</h6>
          <p class="card-text text-muted small mb-2">Team directory with departments, roles, and org chart.</p>
          <button class="btn btn-outline-primary btn-sm w-100" data-action="click->module-marketplace#installTemplate"
                  data-template="employee_directory">
            Install
          </button>
        </div>
      </div>
    </div>

    <!-- Subscription Billing -->
    <div class="col-md-3 mb-3" data-category="finance">
      <div class="card h-100 app-card-sm">
        <div class="card-body">
          <div class="app-icon-sm bg-warning-subtle rounded p-2 mb-2 d-inline-block">
            <i data-lucide="credit-card" style="width: 20px; height: 20px;"></i>
          </div>
          <h6 class="card-title mb-1">Subscription Billing</h6>
          <p class="card-text text-muted small mb-2">Manage subscriptions, billing cycles, and payments.</p>
          <button class="btn btn-outline-primary btn-sm w-100" data-action="click->module-marketplace#installTemplate"
                  data-template="subscription_billing">
            Install
          </button>
        </div>
      </div>
    </div>

    <!-- Knowledge Base -->
    <div class="col-md-3 mb-3" data-category="operations">
      <div class="card h-100 app-card-sm">
        <div class="card-body">
          <div class="app-icon-sm bg-info-subtle rounded p-2 mb-2 d-inline-block">
            <i data-lucide="book-open" style="width: 20px; height: 20px;"></i>
          </div>
          <h6 class="card-title mb-1">Knowledge Base</h6>
          <p class="card-text text-muted small mb-2">Articles, FAQs, and documentation with search.</p>
          <button class="btn btn-outline-primary btn-sm w-100" data-action="click->module-marketplace#installTemplate"
                  data-template="knowledge_base">
            Install
          </button>
        </div>
      </div>
    </div>

    <!-- Custom App Card -->
    <div class="col-md-3 mb-3">
      <div class="card h-100 app-card-sm border-dashed">
        <div class="card-body text-center">
          <div class="app-icon-sm bg-light rounded p-2 mb-2 d-inline-block">
            <i data-lucide="sparkles" style="width: 20px; height: 20px;"></i>
          </div>
          <h6 class="card-title mb-1">Build Custom App</h6>
          <p class="card-text text-muted small mb-2">Describe what you need and AI will build it for you.</p>
          <button class="btn btn-outline-primary btn-sm w-100" data-action="click->module-marketplace#requestCustom">
            Build with AI
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- Installed Apps Section -->
  <% if current_user&.entity&.app_modules&.active&.any? %>
    <h5 class="mb-3 mt-4"><i data-lucide="check-circle" class="me-2"></i> Your Installed Apps</h5>
    <div class="row">
      <% current_user.entity.app_modules.active.each do |app_module| %>
        <% 
          # Get the list canvas for this module
          # Canvas format is: module_<canvas.slug> where canvas.slug is the full slug from ModuleCanvas
          list_canvas = app_module.module_canvases.find_by(canvas_type: 'data_grid') || 
                        app_module.module_canvases.find_by("slug LIKE ?", "%list%") ||
                        app_module.module_canvases.first
          canvas_slug = list_canvas ? "module_#{list_canvas.slug}" : "module_#{app_module.slug}_list"
        %>
        <div class="col-md-3 mb-3">
          <div class="card h-100 app-card-sm border-success">
            <div class="card-body">
              <div class="d-flex justify-content-between mb-2">
                <div class="app-icon-sm bg-success-subtle rounded p-2 d-inline-block">
                  <i data-lucide="<%= app_module.icon || 'box' %>" style="width: 20px; height: 20px;"></i>
                </div>
                <span class="badge bg-success small">Installed</span>
              </div>
              <h6 class="card-title mb-1"><%= app_module.name.truncate(25) %></h6>
              <p class="card-text text-muted small mb-2"><%= app_module.description&.truncate(60) || 'Custom app' %></p>
              <div class="d-flex gap-2">
                <button class="btn btn-success btn-sm flex-grow-1" 
                        onclick="window.scoutController && window.scoutController.loadScoutCanvas('<%= canvas_slug %>', {})"
                        title="Open <%= app_module.name %>">
                  <i data-lucide="external-link" style="width: 14px; height: 14px;"></i> Open
                </button>
                <button class="btn btn-outline-secondary btn-sm" 
                        onclick="window.scoutController && window.scoutController.loadScoutCanvas('module_manager', { module_id: <%= app_module.id %> })"
                        title="Manage settings">
                  <i data-lucide="settings" style="width: 14px; height: 14px;"></i>
                </button>
              </div>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  <% end %>
</div>

<style>
.apps-canvas .app-card {
  transition: transform 0.2s, box-shadow 0.2s;
  border: 1px solid var(--bs-border-color);
}

.apps-canvas .app-card:hover {
  transform: translateY(-4px);
  box-shadow: 0 8px 25px rgba(0,0,0,0.1);
}

.apps-canvas .app-card-sm {
  transition: transform 0.2s;
}

.apps-canvas .app-card-sm:hover {
  transform: translateY(-2px);
}

.apps-canvas .border-dashed {
  border-style: dashed !important;
}

.apps-canvas .app-icon {
  display: inline-flex;
  align-items: center;
  justify-content: center;
}

.apps-canvas .app-icon-sm {
  display: inline-flex;
  align-items: center;
  justify-content: center;
}

.apps-canvas .bg-purple {
  background-color: #7C3AED !important;
  color: white;
}

.apps-canvas .badge.bg-purple i {
  vertical-align: middle;
}
</style>

<script>
// Inline script for button functionality
(function() {
  console.log('📱 Apps canvas script loaded');
  
  function initAppsCanvas() {
    // Build Custom App buttons
    const customBtns = document.querySelectorAll('[data-action="click->module-marketplace#requestCustom"]');
    customBtns.forEach(function(btn) {
      btn.onclick = function(e) {
        e.preventDefault();
        console.log('🎨 Building custom app...');
        sendMessageToAmos("I'd like to build a custom app. Can you help me design it?");
      };
    });
    
    // Install Template buttons - handled by Stimulus controller (module_marketplace_controller.js)
    // The controller handles the plan flow and canvas loading
  }
  
  function sendMessageToAmos(message) {
    const messageInput = document.getElementById('message-input');
    const messageForm = document.getElementById('message-form');
    
    if (messageInput && messageForm) {
      console.log('✅ Sending message to Amos:', message);
      messageInput.value = message;
      messageInput.focus();
      messageForm.dispatchEvent(new Event('submit', { bubbles: true, cancelable: true }));
    } else {
      console.warn('Could not find message-input or message-form');
      alert('Please type this in the chat: ' + message);
    }
  }
  
  function showNotification(message, type) {
    const toast = document.createElement('div');
    toast.className = 'toast show position-fixed bottom-0 end-0 m-3';
    toast.style.zIndex = '9999';
    
    // Handle different notification types
    let bgClass, icon, title;
    if (type === 'success') {
      bgClass = 'success';
      icon = '✅';
      title = 'Success';
    } else if (type === 'info') {
      bgClass = 'info';
      icon = '🔧';
      title = 'Building';
    } else {
      bgClass = 'danger';
      icon = '❌';
      title = 'Error';
    }
    
    toast.innerHTML = '<div class="toast-header bg-' + bgClass + ' text-white">' +
      '<strong class="me-auto">' + icon + ' ' + title + '</strong>' +
      '<button type="button" class="btn-close btn-close-white" onclick="this.closest(\'.toast\').remove()"></button>' +
      '</div><div class="toast-body">' + message + '</div>';
    document.body.appendChild(toast);
    setTimeout(function() { toast.remove(); }, 5000);
  }
  
  // Initialize
  initAppsCanvas();
  document.addEventListener('DOMContentLoaded', initAppsCanvas);
  if (window.lucide) window.lucide.createIcons();
})();
</script>
