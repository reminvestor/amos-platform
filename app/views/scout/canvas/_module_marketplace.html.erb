<%# Apps Canvas - Unified marketplace for apps and modules %>
<%
  # Get list of installed template slugs to avoid showing "Install" for already-installed apps
  installed_slugs = current_entity.app_modules.pluck(:slug).map(&:to_s)
%>
<div class="apps-canvas p-4" data-controller="module-marketplace">
  <!-- Header -->
  <div class="apps-header mb-4">
    <div class="row align-items-center">
      <div class="col-md-8">
        <h2 class="mb-1">
          <i data-lucide="grid-2x2" class="me-2"></i>
          Apps
        </h2>
        <p class="text-muted mb-0">Add new capabilities to your workspace</p>
      </div>
      <div class="col-md-4 text-end">
        <button class="btn btn-primary" data-action="click->module-marketplace#requestCustom">
          <i data-lucide="sparkles"></i> Build Custom App
        </button>
      </div>
    </div>
  </div>

  <!-- Search and Filters -->
  <div class="card mb-4">
    <div class="card-body">
      <div class="row">
        <div class="col-md-6">
          <div class="input-group">
            <span class="input-group-text bg-white"><i data-lucide="search"></i></span>
            <input type="text" class="form-control" placeholder="Search apps..." 
                   data-module-marketplace-target="search"
                   data-action="input->module-marketplace#search">
          </div>
        </div>
        <div class="col-md-6">
          <div class="btn-group w-100">
            <button class="btn btn-outline-secondary active" data-category="all" data-action="click->module-marketplace#filterCategory">
              All
            </button>
            <button class="btn btn-outline-secondary" data-category="business" data-action="click->module-marketplace#filterCategory">
              Business
            </button>
            <button class="btn btn-outline-secondary" data-category="sales" data-action="click->module-marketplace#filterCategory">
              Sales
            </button>
            <button class="btn btn-outline-secondary" data-category="operations" data-action="click->module-marketplace#filterCategory">
              Operations
            </button>
            <button class="btn btn-outline-secondary" data-category="finance" data-action="click->module-marketplace#filterCategory">
              Finance
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Featured Apps (only show non-installed) -->
  <% featured_apps = [
    { slug: 'social_media_manager', name: 'Social Media Manager', icon: 'share-2', color: 'primary', 
      desc: 'Plan, schedule, and analyze social posts across platforms. Includes content calendar.',
      badges: [{ text: 'AI', class: 'bg-purple', icon: 'bot' }, { text: 'Popular', class: 'bg-success' }],
      stats: { models: 3, canvases: 5, tools: 10 } },
    { slug: 'inventory_management', name: 'Inventory Management', icon: 'package', color: 'success',
      desc: 'Track products, stock levels, reorder points, and suppliers. Get alerts for low stock.',
      badges: [{ text: 'Essential', class: 'bg-info' }],
      stats: { models: 3, canvases: 4, tools: 8 } },
    { slug: 'project_management', name: 'Project Tracker', icon: 'kanban', color: 'warning',
      desc: 'Manage projects, tasks, milestones, and team assignments. Kanban board included.',
      badges: [{ text: 'AI', class: 'bg-purple', icon: 'bot' }, { text: 'New', class: 'bg-info' }],
      stats: { models: 4, canvases: 5, tools: 12 } }
  ].reject { |app| installed_slugs.include?(app[:slug]) }
  %>
  <% if featured_apps.any? %>
    <h5 class="mb-3"><i data-lucide="star" class="me-2"></i> Featured Apps</h5>
    <div class="row mb-4" data-module-marketplace-target="featured">
      <% featured_apps.each do |app| %>
        <div class="col-md-4 mb-3">
          <div class="card h-100 app-card">
            <div class="card-body">
              <div class="d-flex justify-content-between mb-3">
                <div class="app-icon bg-<%= app[:color] %>-subtle rounded p-3">
                  <i data-lucide="<%= app[:icon] %>" style="width: 32px; height: 32px;"></i>
                </div>
                <div>
                  <% app[:badges].each do |badge| %>
                    <span class="badge <%= badge[:class] %> me-1" <%= badge[:icon] ? 'title="Includes AI assistant"' : '' %>>
                      <% if badge[:icon] %><i data-lucide="<%= badge[:icon] %>" style="width: 10px; height: 10px;"></i><% end %> <%= badge[:text] %>
                    </span>
                  <% end %>
                </div>
              </div>
              <h5 class="card-title"><%= app[:name] %></h5>
              <p class="card-text text-muted small"><%= app[:desc] %></p>
              <div class="small text-muted mb-3">
                <span class="me-2"><i data-lucide="database" style="width: 14px;"></i> <%= app[:stats][:models] %> models</span>
                <span class="me-2"><i data-lucide="layout" style="width: 14px;"></i> <%= app[:stats][:canvases] %> canvases</span>
                <span><i data-lucide="wrench" style="width: 14px;"></i> <%= app[:stats][:tools] %> tools</span>
              </div>
            </div>
            <div class="card-footer bg-transparent">
              <button class="btn btn-primary w-100" data-action="click->module-marketplace#installTemplate" 
                      data-template="<%= app[:slug] %>">
                <i data-lucide="download"></i> Install
              </button>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  <% end %>

  <!-- All Apps Grid (only show non-installed) -->
  <% all_apps = [
    { slug: 'event_management', name: 'Event Planner', icon: 'calendar', color: 'primary', category: 'operations',
      desc: 'Plan events, track RSVPs, manage venues and speakers.', has_ai: true },
    { slug: 'financial_tracking', name: 'Financial Tracking', icon: 'wallet', color: 'warning', category: 'finance',
      desc: 'Track income, expenses, invoices, and generate reports.', has_ai: false },
    { slug: 'crm_extension', name: 'CRM Extension', icon: 'users', color: 'info', category: 'sales',
      desc: 'Enhanced contact management with custom fields and segments.', has_ai: false },
    { slug: 'property_management', name: 'Property Management', icon: 'building', color: 'danger', category: 'business',
      desc: 'Manage properties, tenants, leases, and maintenance.', has_ai: false },
    { slug: 'support_tickets', name: 'Support Tickets', icon: 'ticket', color: 'secondary', category: 'operations',
      desc: 'Customer support ticketing with SLA tracking.', has_ai: false },
    { slug: 'employee_directory', name: 'Employee Directory', icon: 'contact', color: 'success', category: 'business',
      desc: 'Team directory with departments, roles, and org chart.', has_ai: false },
    { slug: 'subscription_billing', name: 'Subscription Billing', icon: 'credit-card', color: 'warning', category: 'finance',
      desc: 'Manage subscriptions, billing cycles, and payments.', has_ai: false },
    { slug: 'knowledge_base', name: 'Knowledge Base', icon: 'book-open', color: 'info', category: 'operations',
      desc: 'Articles, FAQs, and documentation with search.', has_ai: false }
  ].reject { |app| installed_slugs.include?(app[:slug]) }
  %>
  <h5 class="mb-3"><i data-lucide="grid-3x3" class="me-2"></i> All Apps</h5>
  <div class="row" data-module-marketplace-target="grid">
    <% all_apps.each do |app| %>
      <div class="col-md-3 mb-3" data-category="<%= app[:category] %>">
        <div class="card h-100 app-card-sm">
          <div class="card-body">
            <div class="d-flex justify-content-between mb-2">
              <div class="app-icon-sm bg-<%= app[:color] %>-subtle rounded p-2 d-inline-block">
                <i data-lucide="<%= app[:icon] %>" style="width: 20px; height: 20px;"></i>
              </div>
              <% if app[:has_ai] %>
                <span class="badge bg-purple small" title="Includes AI assistant">
                  <i data-lucide="bot" style="width: 10px; height: 10px;"></i>
                </span>
              <% end %>
            </div>
            <h6 class="card-title mb-1"><%= app[:name] %></h6>
            <p class="card-text text-muted small mb-2"><%= app[:desc] %></p>
            <button class="btn btn-outline-primary btn-sm w-100" data-action="click->module-marketplace#installTemplate"
                    data-template="<%= app[:slug] %>">
              Install
            </button>
          </div>
        </div>
      </div>
    <% end %>

    <!-- Custom App Card (always show) -->
    <div class="col-md-3 mb-3">
      <div class="card h-100 app-card-sm border-dashed">
        <div class="card-body text-center">
          <div class="app-icon-sm bg-light rounded p-2 mb-2 d-inline-block">
            <i data-lucide="sparkles" style="width: 20px; height: 20px;"></i>
          </div>
          <h6 class="card-title mb-1">Build Custom App</h6>
          <p class="card-text text-muted small mb-2">Describe what you need and AI will build it for you.</p>
          <button class="btn btn-outline-primary btn-sm w-100" data-action="click->module-marketplace#requestCustom">
            Build with AI
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- Installed Apps Section (only show apps visible to current user) -->
  <% user_visible_apps = current_entity.app_modules.visible_to(current_user).active %>
  <% if user_visible_apps.any? %>
    <h5 class="mb-3 mt-4"><i data-lucide="check-circle" class="me-2"></i> Your Installed Apps</h5>
    <div class="row">
      <% user_visible_apps.each do |app_module| %>
        <% 
          # Get the list canvas for this module
          # Canvas format is: module_<canvas.slug> where canvas.slug is the full slug from ModuleCanvas
          list_canvas = app_module.module_canvases.find_by(canvas_type: 'data_grid') || 
                        app_module.module_canvases.find_by("slug LIKE ?", "%list%") ||
                        app_module.module_canvases.first
          canvas_slug = list_canvas ? "module_#{list_canvas.slug}" : "module_#{app_module.slug}_list"
        %>
        <div class="col-md-3 mb-3">
          <div class="card h-100 app-card-sm border-success">
            <div class="card-body">
              <div class="d-flex justify-content-between mb-2">
                <div class="app-icon-sm bg-success-subtle rounded p-2 d-inline-block">
                  <i data-lucide="<%= app_module.icon || 'box' %>" style="width: 20px; height: 20px;"></i>
                </div>
                <span class="badge bg-success small">Installed</span>
              </div>
              <h6 class="card-title mb-1"><%= app_module.name.truncate(25) %></h6>
              <p class="card-text text-muted small mb-2"><%= app_module.description&.truncate(60) || 'Custom app' %></p>
              <div class="d-flex gap-2">
                <button class="btn btn-success btn-sm flex-grow-1" 
                        onclick="window.scoutController && window.scoutController.loadScoutCanvas('<%= canvas_slug %>', {})"
                        title="Open <%= app_module.name %>">
                  <i data-lucide="external-link" style="width: 14px; height: 14px;"></i> Open
                </button>
                <button class="btn btn-outline-secondary btn-sm" 
                        onclick="window.scoutController && window.scoutController.loadScoutCanvas('module_manager', { module_id: <%= app_module.id %> })"
                        title="Manage settings">
                  <i data-lucide="settings" style="width: 14px; height: 14px;"></i>
                </button>
              </div>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  <% end %>
</div>

<style>
.apps-canvas .app-card {
  transition: transform 0.2s, box-shadow 0.2s;
  border: 1px solid var(--bs-border-color);
}

.apps-canvas .app-card:hover {
  transform: translateY(-4px);
  box-shadow: 0 8px 25px rgba(0,0,0,0.1);
}

.apps-canvas .app-card-sm {
  transition: transform 0.2s;
}

.apps-canvas .app-card-sm:hover {
  transform: translateY(-2px);
}

.apps-canvas .border-dashed {
  border-style: dashed !important;
}

.apps-canvas .app-icon {
  display: inline-flex;
  align-items: center;
  justify-content: center;
}

.apps-canvas .app-icon-sm {
  display: inline-flex;
  align-items: center;
  justify-content: center;
}

.apps-canvas .bg-purple {
  background-color: #7C3AED !important;
  color: white;
}

.apps-canvas .badge.bg-purple i {
  vertical-align: middle;
}
</style>

<script>
// Inline script for button functionality
(function() {
  console.log('📱 Apps canvas script loaded');
  
  function initAppsCanvas() {
    // Build Custom App buttons
    const customBtns = document.querySelectorAll('[data-action="click->module-marketplace#requestCustom"]');
    customBtns.forEach(function(btn) {
      btn.onclick = function(e) {
        e.preventDefault();
        console.log('🎨 Building custom app...');
        sendMessageToAmos("I'd like to build a custom app. Can you help me design it?");
      };
    });
    
    // Install Template buttons - handled by Stimulus controller (module_marketplace_controller.js)
    // The controller handles the plan flow and canvas loading
  }
  
  function sendMessageToAmos(message) {
    const messageInput = document.getElementById('message-input');
    const messageForm = document.getElementById('message-form');
    
    if (messageInput && messageForm) {
      console.log('✅ Sending message to Amos:', message);
      messageInput.value = message;
      messageInput.focus();
      messageForm.dispatchEvent(new Event('submit', { bubbles: true, cancelable: true }));
    } else {
      console.warn('Could not find message-input or message-form');
      showInfo('Please type this in the chat: ' + message);
    }
  }
  
  function showNotification(message, type) {
    const toast = document.createElement('div');
    toast.className = 'toast show position-fixed bottom-0 end-0 m-3';
    toast.style.zIndex = '9999';
    
    // Handle different notification types
    let bgClass, icon, title;
    if (type === 'success') {
      bgClass = 'success';
      icon = '✅';
      title = 'Success';
    } else if (type === 'info') {
      bgClass = 'info';
      icon = '🔧';
      title = 'Building';
    } else {
      bgClass = 'danger';
      icon = '❌';
      title = 'Error';
    }
    
    toast.innerHTML = '<div class="toast-header bg-' + bgClass + ' text-white">' +
      '<strong class="me-auto">' + icon + ' ' + title + '</strong>' +
      '<button type="button" class="btn-close btn-close-white" onclick="this.closest(\'.toast\').remove()"></button>' +
      '</div><div class="toast-body">' + message + '</div>';
    document.body.appendChild(toast);
    setTimeout(function() { toast.remove(); }, 5000);
  }
  
  // Initialize
  initAppsCanvas();
  document.addEventListener('DOMContentLoaded', initAppsCanvas);
  if (window.lucide) window.lucide.createIcons();
})();
</script>
