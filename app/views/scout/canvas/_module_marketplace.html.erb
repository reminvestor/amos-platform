    <!-- Subscription Billing -->
    <div class="col-md-3 mb-3" data-category="finance">
      <div class="card h-100 module-card-sm">
        <div class="card-body">
          <div class="module-icon-sm bg-warning-subtle rounded p-2 mb-2 d-inline-block">
            <i data-lucide="credit-card" style="width: 20px; height: 20px;"></i>
          </div>
          <h6 class="card-title mb-1">Subscription Billing</h6>
          <p class="card-text text-muted small mb-2">Manage subscriptions, billing cycles, and payment tracking.</p>
          <button class="btn btn-outline-primary btn-sm w-100" data-action="click->module-marketplace#installTemplate"
                  data-template="subscription_billing">
