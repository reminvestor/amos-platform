        <div class="card-body">
          <div class="module-icon-sm bg-secondary-subtle rounded p-2 mb-2 d-inline-block">
            <i data-lucide="ticket" style="width: 20px; height: 20px;"></i>
          </div>
          <h6 class="card-title mb-1">Support Tickets</h6>
          <p class="card-text text-muted small mb-2">Customer support ticketing with SLA tracking and escalation.</p>
          <button class="btn btn-outline-primary btn-sm w-100" data-action="click->module-marketplace#installTemplate"
