<script>
// Plan visualization functions (global scope for onclick handlers)
function editSectionInline(sectionIdx) {
  var card = document.querySelector('[data-section-idx="' + sectionIdx + '"]');
  if (!card) return;
  
  // Toggle layout options visibility
  var layoutOptions = card.querySelector('.section-layout-options');
  if (layoutOptions) {
    var isVisible = layoutOptions.style.display !== 'none';
    layoutOptions.style.display = isVisible ? 'none' : 'flex';
  }
  
  // Focus on the first editable field
  var firstEditable = card.querySelector('[contenteditable="true"]');
  if (firstEditable) {
    firstEditable.focus();
    // Select all text
    var range = document.createRange();
    range.selectNodeContents(firstEditable);
    var sel = window.getSelection();
    sel.removeAllRanges();
    sel.addRange(range);
  }
}

function removeSection(sectionIdx) {
  var card = document.querySelector('[data-section-idx="' + sectionIdx + '"]');
  if (!card) return;
  
  var sectionName = card.dataset.sectionName || 'this section';
  if (confirm('Remove ' + sectionName + '?')) {
    // Animate out
    card.style.opacity = '0';
    card.style.transform = 'translateX(-20px)';
    setTimeout(function() {
      card.remove();
      // Re-number remaining sections
      document.querySelectorAll('.plan-section-card').forEach(function(c, i) {
        c.dataset.sectionIdx = i;
        var numEl = c.querySelector('.section-number');
        if (numEl) numEl.textContent = i + 1;
      });
    }, 300);
    
    // Update plan in backend
    var planId = document.querySelector('.plan-visualization-enhanced');
    planId = planId ? planId.dataset.planId : null;
    if (planId && window.sendScoutMessage) {
      window.sendScoutMessage('Remove the ' + sectionName + ' section from plan ' + planId);
    }
  }
}

function changeSectionLayout(sectionIdx, newLayout) {
  var card = document.querySelector('[data-section-idx="' + sectionIdx + '"]');
  if (!card) return;
  
  // Update active state
  card.querySelectorAll('.layout-option-btn').forEach(function(btn) {
    btn.classList.toggle('active', btn.dataset.layout === newLayout);
  });
  
  // Update layout badge
  var layoutBadge = card.querySelector('.section-layout-badge');
  if (layoutBadge) {
    layoutBadge.innerHTML = '<i data-lucide="layout" style="width: 12px; height: 12px;"></i> ' + newLayout.replace('-', ' ');
    if (typeof lucide !== 'undefined') lucide.createIcons();
  }
  
  // Update preview layout
  var preview = card.querySelector('.section-card-preview > div');
  if (preview) {
    preview.className = preview.className.replace(/layout-\S+/g, '');
    preview.classList.add('layout-' + newLayout);
  }
  
  // Notify backend of layout change
  var planEl = document.querySelector('.plan-visualization-enhanced');
  var planId = planEl ? planEl.dataset.planId : null;
  var sectionType = card.dataset.sectionType;
  if (planId && window.sendScoutMessage) {
    window.sendScoutMessage('Change the ' + sectionType + ' section layout to ' + newLayout + ' in plan ' + planId);
  }
}

// ===== Design Specs Interactive Functions =====

function updateDesignColor(colorType, newColor) {
  console.log('🎨 Updating', colorType, 'color to', newColor);
  
  // Update the CSS custom properties for live preview
  var vizEl = document.querySelector('.plan-visualization-enhanced');
  if (vizEl) {
    if (colorType === 'primary') vizEl.style.setProperty('--primary', newColor);
    if (colorType === 'secondary') vizEl.style.setProperty('--secondary', newColor);
    if (colorType === 'accent') vizEl.style.setProperty('--accent', newColor);
  }
  
  // Update the swatch display
  var wrapper = document.querySelector('#color-' + colorType).parentElement;
  var swatch = wrapper.querySelector('.color-swatch');
  if (swatch) swatch.style.background = newColor;
  
  // Update data attribute
  var specsBar = document.getElementById('design-specs-bar');
  if (specsBar) specsBar.dataset[colorType] = newColor;
  
  // Debounce sending to Amos
  clearTimeout(window.designColorTimeout);
  window.designColorTimeout = setTimeout(function() {
    var planEl = document.querySelector('.plan-visualization-enhanced');
    var planId = planEl ? planEl.dataset.planId : null;
    if (planId) {
      sendToAmos('Update the ' + colorType + ' color to ' + newColor + ' in plan ' + planId);
    }
  }, 1000);
}

function updateDesignFont(newFont) {
  console.log('🔤 Updating font to', newFont);
  
  // Update data attribute
  var specsBar = document.getElementById('design-specs-bar');
  if (specsBar) specsBar.dataset.headingFont = newFont;
  
  // Send to Amos
  var planEl = document.querySelector('.plan-visualization-enhanced');
  var planId = planEl ? planEl.dataset.planId : null;
  if (planId) {
    sendToAmos('Change the heading font to ' + newFont + ' in plan ' + planId);
  }
}

function updateDesignStyle(newStyle) {
  console.log('✨ Updating style to', newStyle);
  
  // Update data attribute
  var specsBar = document.getElementById('design-specs-bar');
  if (specsBar) specsBar.dataset.style = newStyle;
  
  // Send to Amos
  var planEl = document.querySelector('.plan-visualization-enhanced');
  var planId = planEl ? planEl.dataset.planId : null;
  if (planId) {
    sendToAmos('Change the design style to ' + newStyle + ' in plan ' + planId);
  }
}

function toggleReferenceUpload() {
  var panel = document.getElementById('design-reference-panel');
  if (panel) {
    panel.style.display = panel.style.display === 'none' ? 'block' : 'none';
    if (typeof lucide !== 'undefined') lucide.createIcons();
  }
}

function handleReferenceUpload(input) {
  if (!input.files || !input.files[0]) return;
  
  var file = input.files[0];
  if (file.size > 5 * 1024 * 1024) {
    alert('File too large. Maximum 5MB allowed.');
    return;
  }
  
  // Show preview immediately
  var zone = document.getElementById('reference-upload-zone');
  if (zone) {
    zone.innerHTML = '<div class="spinner-border spinner-border-sm me-2"></div> Uploading...';
  }
  
  // Create FormData for upload using existing endpoint
  var formData = new FormData();
  formData.append('files[0]', file);
  formData.append('storage_type', 'long-term');
  
  // Upload to server using existing upload_files endpoint
  fetch('/scout/upload_files', {
    method: 'POST',
    headers: {
      'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]').content
    },
    body: formData
  })
  .then(function(response) { return response.json(); })
  .then(function(data) {
    if (data.success && data.urls && data.urls.length > 0) {
      var imageUrl = data.urls[0];
      
      // Show the uploaded image
      var panel = document.getElementById('design-reference-panel');
      if (panel) {
        panel.querySelector('.reference-panel-content').innerHTML = 
          '<div class="reference-preview">' +
          '<img src="' + imageUrl + '" alt="Design reference" id="reference-image">' +
          '<button class="btn-remove-reference" onclick="removeDesignReference()">' +
          '<i data-lucide="trash-2" style="width: 12px; height: 12px;"></i> Remove</button>' +
          '</div>' +
          '<p class="reference-tip">' +
          '<i data-lucide="lightbulb" style="width: 12px; height: 12px;"></i>' +
          'Upload a screenshot of a design you like. Amos will use it as inspiration when building your page.</p>';
        if (typeof lucide !== 'undefined') lucide.createIcons();
      }
      
      // Update reference badge
      var btn = document.querySelector('.btn-upload-reference');
      if (btn && !btn.querySelector('.reference-badge')) {
        var badge = document.createElement('span');
        badge.className = 'reference-badge';
        badge.textContent = '✓';
        btn.appendChild(badge);
      }
      
      // Store the reference URL in the data attributes
      var specsBar = document.getElementById('design-specs-bar');
      if (specsBar) specsBar.dataset.referenceUrl = imageUrl;
      
      // Tell Amos about the reference
      var planEl = document.querySelector('.plan-visualization-enhanced');
      var planId = planEl ? planEl.dataset.planId : null;
      if (planId) {
        sendToAmos('I uploaded a design reference image for plan ' + planId + '. Please use this as inspiration when building: ' + imageUrl);
      }
    } else {
      alert('Upload failed: ' + (data.error || 'Unknown error'));
    }
  })
  .catch(function(error) {
    console.error('Upload error:', error);
    alert('Upload failed. Please try again.');
  });
}

function removeDesignReference() {
  var panel = document.getElementById('design-reference-panel');
  if (panel) {
    panel.querySelector('.reference-panel-content').innerHTML = 
      '<div class="reference-upload-zone" id="reference-upload-zone" onclick="document.getElementById(\'reference-file-input\').click()">' +
      '<i data-lucide="upload-cloud" style="width: 32px; height: 32px;"></i>' +
      '<p>Click or drag to upload a design reference</p>' +
      '<span class="upload-hint">PNG, JPG up to 5MB</span>' +
      '</div>' +
      '<input type="file" id="reference-file-input" accept="image/*" style="display: none;" onchange="handleReferenceUpload(this)">' +
      '<p class="reference-tip">' +
      '<i data-lucide="lightbulb" style="width: 12px; height: 12px;"></i>' +
      'Upload a screenshot of a design you like. Amos will use it as inspiration when building your page.</p>';
    if (typeof lucide !== 'undefined') lucide.createIcons();
  }
  
  // Remove reference badge
  var badge = document.querySelector('.btn-upload-reference .reference-badge');
  if (badge) badge.remove();
}

function saveDesignToProfile() {
  var specsBar = document.getElementById('design-specs-bar');
  if (!specsBar) return;
  
  var colors = {
    primary: specsBar.dataset.primary,
    secondary: specsBar.dataset.secondary,
    accent: specsBar.dataset.accent
  };
  var font = specsBar.dataset.headingFont;
  var style = specsBar.dataset.style;
  
  // Tell Amos to save these as defaults
  sendToAmos('Save my design preferences as defaults: colors ' + JSON.stringify(colors) + ', font ' + font + ', style ' + style);
  
  // Visual feedback
  var btn = document.querySelector('.btn-save-to-profile');
  if (btn) {
    btn.innerHTML = '<i data-lucide="check" style="width: 14px; height: 14px;"></i>';
    btn.style.borderColor = '#22c55e';
    btn.style.color = '#22c55e';
    if (typeof lucide !== 'undefined') lucide.createIcons();
    
    setTimeout(function() {
      btn.innerHTML = '<i data-lucide="save" style="width: 14px; height: 14px;"></i>';
      btn.style.borderColor = '';
      btn.style.color = '';
      if (typeof lucide !== 'undefined') lucide.createIcons();
    }, 2000);
  }
}

function editDesignSpecs() {
  // Legacy function - now specs are directly editable in the bar
  toggleReferenceUpload();
}

