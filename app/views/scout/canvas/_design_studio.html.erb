<script>
// Plan visualization functions (global scope for onclick handlers)
function editSectionInline(sectionIdx) {
  var card = document.querySelector('[data-section-idx="' + sectionIdx + '"]');
  if (!card) return;
  
  // Toggle layout options visibility
  var layoutOptions = card.querySelector('.section-layout-options');
  if (layoutOptions) {
    var isVisible = layoutOptions.style.display !== 'none';
    layoutOptions.style.display = isVisible ? 'none' : 'flex';
  }
  
  // Focus on the first editable field
  var firstEditable = card.querySelector('[contenteditable="true"]');
  if (firstEditable) {
    firstEditable.focus();
    // Select all text
    var range = document.createRange();
    range.selectNodeContents(firstEditable);
    var sel = window.getSelection();
    sel.removeAllRanges();
    sel.addRange(range);
  }
}

function removeSection(sectionIdx) {
  var card = document.querySelector('[data-section-idx="' + sectionIdx + '"]');
  if (!card) return;
  
  var sectionName = card.dataset.sectionName || 'this section';
  if (confirm('Remove ' + sectionName + '?')) {
    // Animate out
    card.style.opacity = '0';
    card.style.transform = 'translateX(-20px)';
    setTimeout(function() {
      card.remove();
      // Re-number remaining sections
      document.querySelectorAll('.plan-section-card').forEach(function(c, i) {
        c.dataset.sectionIdx = i;
        var numEl = c.querySelector('.section-number');
        if (numEl) numEl.textContent = i + 1;
      });
    }, 300);
    
    // Update plan in backend directly (no chat message)
    var planEl = document.querySelector('.plan-visualization-enhanced');
    var planId = planEl ? planEl.dataset.planId : null;
    if (planId) {
      updatePlanDirectly(planId, {
        remove_section: sectionName
      });
    }
  }
}

// Toggle advanced options panel for a section
function toggleAdvancedSection(sectionIdx) {
  var advancedPanel = document.getElementById('advanced-' + sectionIdx);
  var toggleBtn = document.querySelector('.btn-toggle-advanced[data-section-idx="' + sectionIdx + '"]');
  
  if (!advancedPanel) return;
  
  var isVisible = advancedPanel.style.display !== 'none';
  
  if (isVisible) {
    advancedPanel.style.display = 'none';
    if (toggleBtn) toggleBtn.classList.remove('expanded');
  } else {
    advancedPanel.style.display = 'block';
    if (toggleBtn) toggleBtn.classList.add('expanded');
  }
  
  // Re-initialize lucide icons for the newly shown content
  if (typeof lucide !== 'undefined') lucide.createIcons();
}

// Save advanced field value to plan
function saveAdvancedField(sectionIdx, fieldName, value) {
  var planEl = document.querySelector('.plan-visualization-enhanced');
  var planId = planEl ? planEl.dataset.planId : null;
  
  if (!planId) {
    console.log('No plan ID found for advanced field save');
    return;
  }
  
  // Get section name
  var sectionCard = document.querySelector('.plan-section-card[data-section-idx="' + sectionIdx + '"]');
  var sectionName = sectionCard ? sectionCard.dataset.sectionName : null;
  
  if (!sectionName) {
    console.log('No section name found');
    return;
  }
  
  // Build the update payload
  var refinement = {
    update_section_advanced: {
      section_name: sectionName,
      section_idx: sectionIdx,
      field: fieldName,
      value: value
    }
  };
  
  // Visual feedback
  var field = document.querySelector('[data-field="' + fieldName + '"][data-section-idx="' + sectionIdx + '"]');
  if (field) {
    field.style.borderColor = '#10b981';
    setTimeout(function() { field.style.borderColor = ''; }, 1000);
  }
  
  // Save to backend
  updatePlanDirectly(planId, refinement);
}

function changeSectionLayout(sectionIdx, newLayout) {
  var card = document.querySelector('[data-section-idx="' + sectionIdx + '"]');
  if (!card) return;
  
  // Update active state
  card.querySelectorAll('.layout-option-btn').forEach(function(btn) {
    btn.classList.toggle('active', btn.dataset.layout === newLayout);
  });
  
  // Update layout badge
  var layoutBadge = card.querySelector('.section-layout-badge');
  if (layoutBadge) {
    layoutBadge.innerHTML = '<i data-lucide="layout" style="width: 12px; height: 12px;"></i> ' + newLayout.replace('-', ' ');
    if (typeof lucide !== 'undefined') lucide.createIcons();
  }
  
  // Update preview layout
  var preview = card.querySelector('.section-card-preview > div');
  if (preview) {
    preview.className = preview.className.replace(/layout-\S+/g, '');
    preview.classList.add('layout-' + newLayout);
  }
  
  // Update backend directly (no chat message)
  var planEl = document.querySelector('.plan-visualization-enhanced');
  var planId = planEl ? planEl.dataset.planId : null;
  var sectionName = card.dataset.sectionName || card.dataset.sectionType;
  if (planId) {
    updatePlanDirectly(planId, {
      update_section: { name: sectionName, layout: newLayout }
    });
  }
}

function addFeatureItem(sectionIdx) {
  var planEl = document.querySelector('.plan-visualization-enhanced');
  var planId = planEl ? planEl.dataset.planId : null;
  var card = document.querySelector('[data-section-idx="' + sectionIdx + '"]');
  
  if (!card) return;
  
  // Find the features container
  var featuresContainer = card.querySelector('.preview-features-list');
  if (!featuresContainer) {
    var contentBody = card.querySelector('.section-content-body');
    if (contentBody) {
      featuresContainer = document.createElement('div');
      featuresContainer.className = 'preview-features-list';
      contentBody.appendChild(featuresContainer);
    }
  }
  
  if (featuresContainer) {
    // Get current count
    var existingItems = featuresContainer.querySelectorAll('.preview-feature-item');
    var newIdx = existingItems.length;
    
    // Add new feature item locally
    var newItem = document.createElement('div');
    newItem.className = 'preview-feature-item';
    newItem.dataset.itemIdx = newIdx;
    newItem.innerHTML = '<i data-lucide="check-circle" style="width: 14px; height: 14px; color: #6366f1;"></i>' +
      '<span class="feature-title" contenteditable="true" data-field="item_title" data-item-idx="' + newIdx + '">New Feature - Click to edit</span>' +
      '<button class="btn-remove-item" onclick="removeFeatureItem(' + sectionIdx + ', ' + newIdx + ')" title="Remove">' +
        '<i data-lucide="x" style="width: 10px; height: 10px;"></i></button>';
    
    // Insert before the add button
    var addBtn = featuresContainer.querySelector('.btn-add-item, .btn-add-feature');
    if (addBtn) {
      featuresContainer.insertBefore(newItem, addBtn);
    } else {
      featuresContainer.appendChild(newItem);
    }
    
    // Initialize lucide icons
    if (typeof lucide !== 'undefined') lucide.createIcons();
    
    // Focus on the new feature
    var titleEl = newItem.querySelector('.feature-title');
    if (titleEl) {
      titleEl.focus();
      var range = document.createRange();
      range.selectNodeContents(titleEl);
      var sel = window.getSelection();
      sel.removeAllRanges();
      sel.addRange(range);
    }
  }
  
  // Persist directly (no chat message)
  if (planId) {
    updatePlanDirectly(planId, {
      update_section: { name: 'features', add_item: { title: 'New Feature - Click to edit' } }
    });
  }
}

function removeFeatureItem(sectionIdx, itemIdx) {
  var planEl = document.querySelector('.plan-visualization-enhanced');
  var planId = planEl ? planEl.dataset.planId : null;
  var card = document.querySelector('[data-section-idx="' + sectionIdx + '"]');
  
  // Optimistically remove from UI first
  var itemEl = card ? card.querySelector('[data-item-idx="' + itemIdx + '"] .feature-title') : null;
  if (itemEl) {
    var itemContainer = itemEl.closest('.preview-feature-item');
    if (itemContainer) {
      itemContainer.style.opacity = '0';
      itemContainer.style.transition = 'opacity 0.3s';
      setTimeout(function() { itemContainer.remove(); }, 300);
    }
  }
  
  // Persist directly (no chat message)
  if (planId) {
    updatePlanDirectly(planId, {
      update_section: { name: 'features', remove_item: { index: parseInt(itemIdx) } }
    });
  }
}

function addTestimonial(sectionIdx) {
  var planEl = document.querySelector('.plan-visualization-enhanced');
  var planId = planEl ? planEl.dataset.planId : null;
  var card = document.querySelector('[data-section-idx="' + sectionIdx + '"]');
  
  if (!card) return;
  
  // Find the testimonials container
  var testimonialsContainer = card.querySelector('.preview-testimonials-list');
  if (!testimonialsContainer) {
    // Create container if it doesn't exist
    var contentBody = card.querySelector('.section-content-body');
    if (contentBody) {
      testimonialsContainer = document.createElement('div');
      testimonialsContainer.className = 'preview-testimonials-list';
      contentBody.appendChild(testimonialsContainer);
    }
  }
  
  if (testimonialsContainer) {
    // Get current count
    var existingItems = testimonialsContainer.querySelectorAll('.preview-testimonial-card');
    var newIdx = existingItems.length;
    
    // Add new testimonial card locally
    var newCard = document.createElement('div');
    newCard.className = 'preview-testimonial-card';
    newCard.dataset.itemIdx = newIdx;
    newCard.innerHTML = '<div class="quote-text" contenteditable="true" data-item-idx="' + newIdx + '">"Click to edit this testimonial quote..."</div>' +
      '<div class="quote-author" contenteditable="true" data-item-idx="' + newIdx + '">— Customer Name, Company</div>' +
      '<button class="btn-remove-testimonial" onclick="removeTestimonial(' + sectionIdx + ', ' + newIdx + ')" title="Remove">' +
        '<i data-lucide="x" style="width: 10px; height: 10px;"></i></button>';
    testimonialsContainer.appendChild(newCard);
    
    // Initialize lucide icons
    if (typeof lucide !== 'undefined') lucide.createIcons();
    
    // Focus on the new quote
    var quoteEl = newCard.querySelector('.quote-text');
    if (quoteEl) {
      quoteEl.focus();
      // Select placeholder text
      var range = document.createRange();
      range.selectNodeContents(quoteEl);
      var sel = window.getSelection();
      sel.removeAllRanges();
      sel.addRange(range);
    }
  }
  
  // Persist directly (no chat message)
  if (planId) {
    updatePlanDirectly(planId, {
      update_section: { name: 'testimonials', add_item: { quote: 'Click to edit this testimonial quote...', author: 'Customer Name, Company' } }
    });
  }
}

function removeTestimonial(sectionIdx, itemIdx) {
  var planEl = document.querySelector('.plan-visualization-enhanced');
  var planId = planEl ? planEl.dataset.planId : null;
  var card = document.querySelector('[data-section-idx="' + sectionIdx + '"]');
  
  // Optimistically remove from UI first
  var itemEl = card ? card.querySelector('[data-item-idx="' + itemIdx + '"]') : null;
  if (!itemEl) itemEl = card ? card.querySelector('.preview-testimonial-card[data-item-idx="' + itemIdx + '"]') : null;
  if (itemEl) {
    itemEl.style.opacity = '0';
    itemEl.style.transition = 'opacity 0.3s';
    setTimeout(function() { itemEl.remove(); }, 300);
  }
  
  // Persist directly (no chat message)
  if (planId) {
    updatePlanDirectly(planId, {
      update_section: { name: 'testimonials', remove_item: { index: parseInt(itemIdx) } }
    });
  }
}

function addPricingTier(sectionIdx) {
  var planEl = document.querySelector('.plan-visualization-enhanced');
  var planId = planEl ? planEl.dataset.planId : null;
  
