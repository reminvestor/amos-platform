function handleReferenceUpload(input) {
  if (!input.files || !input.files[0]) return;
  
  var file = input.files[0];
  if (file.size > 5 * 1024 * 1024) {
    alert('File too large. Maximum 5MB allowed.');
    return;
  }
  
  // Show preview immediately
  var zone = document.getElementById('reference-upload-zone');
  if (zone) {
    zone.innerHTML = '<div class="spinner-border spinner-border-sm me-2"></div> Uploading...';
  }
  
  // Create FormData for upload using existing endpoint
  var formData = new FormData();
  formData.append('files[0]', file);
  formData.append('storage_type', 'long-term');
  
  // Upload to server using existing upload_files endpoint
  fetch('/scout/upload_files', {
    method: 'POST',
    headers: {
      'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]').content
    },
    body: formData
  })
  .then(function(response) { return response.json(); })
  .then(function(data) {
    if (data.success && data.urls && data.urls.length > 0) {
      var imageUrl = data.urls[0];
      
      // Show the uploaded image
      var panel = document.getElementById('design-reference-panel');
      if (panel) {
        panel.querySelector('.reference-panel-content').innerHTML = 
          '<div class="reference-preview">' +
          '<img src="' + imageUrl + '" alt="Design reference" id="reference-image">' +
          '<button class="btn-remove-reference" onclick="removeDesignReference()">' +
          '<i data-lucide="trash-2" style="width: 12px; height: 12px;"></i> Remove</button>' +
          '</div>' +
          '<p class="reference-tip">' +
          '<i data-lucide="lightbulb" style="width: 12px; height: 12px;"></i>' +
          'Upload a screenshot of a design you like. Amos will use it as inspiration when building your page.</p>';
        if (typeof lucide !== 'undefined') lucide.createIcons();
      }
      
      // Update reference badge
      var btn = document.querySelector('.btn-upload-reference');
      if (btn && !btn.querySelector('.reference-badge')) {
        var badge = document.createElement('span');
        badge.className = 'reference-badge';
        badge.textContent = '✓';
        btn.appendChild(badge);
      }
      
      // Store the reference URL in the data attributes
      var specsBar = document.getElementById('design-specs-bar');
      if (specsBar) specsBar.dataset.referenceUrl = imageUrl;
      
      // Tell Amos about the reference
      var planEl = document.querySelector('.plan-visualization-enhanced');
      var planId = planEl ? planEl.dataset.planId : null;
      if (planId) {
        sendToAmos('I uploaded a design reference image for plan ' + planId + '. Please use this as inspiration when building: ' + imageUrl);
      }
    } else {
      alert('Upload failed: ' + (data.error || 'Unknown error'));
    }
  })
  .catch(function(error) {
    console.error('Upload error:', error);
    alert('Upload failed. Please try again.');
  });
}

