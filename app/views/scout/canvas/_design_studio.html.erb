  // Initialize grid component interactions
  function initGridComponents() {
    var gridArea = container.querySelector('#freeform-drop-zone');
    if (!gridArea) return;
    
    // Make grid items draggable within the grid
    gridArea.addEventListener('dragstart', function(e) {
      var component = e.target.closest('.dashboard-component.grid-item');
      if (!component) return;
      
      component.classList.add('dragging');
      e.dataTransfer.setData('text/plain', 'grid-reorder');
      e.dataTransfer.effectAllowed = 'move';
      
      // Store the component being dragged
      window._draggingGridComponent = component;
    });
    
    gridArea.addEventListener('dragend', function(e) {
      var component = e.target.closest('.dashboard-component.grid-item');
      if (component) {
        component.classList.remove('dragging');
      }
      window._draggingGridComponent = null;
      
      // Remove any drop indicators
      gridArea.querySelectorAll('.grid-drop-indicator').forEach(function(el) { el.remove(); });
    });
    
    // Handle grid reordering
    gridArea.addEventListener('dragover', function(e) {
      if (!window._draggingGridComponent) return;
      e.preventDefault();
      e.dataTransfer.dropEffect = 'move';
    });
    
    gridArea.addEventListener('drop', function(e) {
      if (!window._draggingGridComponent) return;
      e.preventDefault();
      e.stopPropagation(); // Prevent bubbling to parent drop handlers
      
      var component = window._draggingGridComponent;
      var rect = gridArea.getBoundingClientRect();
      var dropX = e.clientX - rect.left;
      var dropY = e.clientY - rect.top;
      
      // Calculate grid position (12 columns)
      var colWidth = (rect.width - 40) / 12; // Subtract padding
      var rowHeight = 96; // 80px + 16px gap
      
      var col = Math.floor(dropX / colWidth) + 1;
      var row = Math.floor(dropY / rowHeight) + 1;
      
      // Get the component's span
      var style = window.getComputedStyle(component);
      var colSpan = parseInt(style.gridColumnEnd) - parseInt(style.gridColumnStart) || 3;
      if (isNaN(colSpan) || colSpan < 1) colSpan = 3;
      
      // Ensure it fits within the grid
      col = Math.min(col, 13 - colSpan);
      col = Math.max(col, 1);
      
      // Update component position
      component.style.gridColumn = col + ' / span ' + colSpan;
      component.style.gridRow = row;
      component.dataset.gridCol = col + ' / span ' + colSpan;
      component.dataset.gridRow = row.toString();
      
      console.log('📍 Component moved to grid position:', col, row);
      scheduleAutoSave();
    });
    
    // Initialize resize handles
    initResizeHandles(gridArea);
  }
  
  // Initialize resize functionality
  function initResizeHandles(gridArea) {
    var resizing = false;
    var resizeComponent = null;
    var startX, startY, startWidth, startHeight;
    var colWidth, rowHeight;
    
    gridArea.addEventListener('mousedown', function(e) {
      var handle = e.target.closest('.resize-handle');
      if (!handle) return;
      
      e.preventDefault();
      resizing = true;
      resizeComponent = handle.closest('.dashboard-component');
      
      var rect = resizeComponent.getBoundingClientRect();
      startX = e.clientX;
      startY = e.clientY;
      startWidth = rect.width;
      startHeight = rect.height;
      
      var gridRect = gridArea.getBoundingClientRect();
      colWidth = (gridRect.width - 40) / 12;
      rowHeight = 96;
      
      resizeComponent.classList.add('resizing');
      document.body.style.cursor = 'nwse-resize';
    });
    
    document.addEventListener('mousemove', function(e) {
      if (!resizing || !resizeComponent) return;
      
      var deltaX = e.clientX - startX;
      var deltaY = e.clientY - startY;
      
      // Calculate new spans
      var newColSpan = Math.max(2, Math.round((startWidth + deltaX) / colWidth));
      var newRowSpan = Math.max(1, Math.round((startHeight + deltaY) / rowHeight));
      
      // Limit to grid bounds
      newColSpan = Math.min(newColSpan, 12);
      newRowSpan = Math.min(newRowSpan, 8);
      
      // Get current column start
      var currentStyle = window.getComputedStyle(resizeComponent);
      var colStart = parseInt(resizeComponent.dataset.gridCol) || 1;
      if (typeof colStart === 'string' && colStart.includes('span')) {
        colStart = parseInt(colStart.split('/')[0]) || 1;
      }
      
      // Ensure it fits
      if (colStart + newColSpan > 13) {
        newColSpan = 13 - colStart;
      }
      
      resizeComponent.style.gridColumn = colStart + ' / span ' + newColSpan;
      resizeComponent.style.gridRow = 'span ' + newRowSpan;
    });
    
    document.addEventListener('mouseup', function(e) {
      if (!resizing || !resizeComponent) return;
      
      resizing = false;
      resizeComponent.classList.remove('resizing');
      document.body.style.cursor = '';
      
      // Save the new size
      resizeComponent.dataset.gridCol = resizeComponent.style.gridColumn;
      resizeComponent.dataset.gridRow = resizeComponent.style.gridRow;
      
      console.log('📐 Component resized:', resizeComponent.dataset.gridCol, resizeComponent.dataset.gridRow);
      scheduleAutoSave();
      
      resizeComponent = null;
    });
  }
  
