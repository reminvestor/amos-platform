<%# App Designer Canvas - Unified Page Builder %>
<%# Supports: Landing Pages, Multi-page Websites, Amos Canvases %>
<%# Once built, content is in edit mode %>

<% data = (canvas_data || {}).with_indifferent_access %>
<% plan = (data[:plan] || {}).with_indifferent_access %>
<% plan_id = data[:plan_id] %>
<% website = data[:website] %>
<% website_id = data[:website_id] %>
<% pages = data[:pages] || [] %>
<% current_page = data[:current_page] %>
<% landing_page = data[:landing_page] %>
<% landing_page_id = data[:landing_page_id] %>
<% is_website = website_id.present? || pages.any? %>
<%# Template-based creation params %>
<% create_type = data[:create_type] %>
<% template_name = data[:template_name] %>
<% template_id = data[:template_id] %>

<%# Get design defaults from BusinessProfile %>
<% 
  bp = defined?(business_profile) ? business_profile : nil
  style_guidelines = bp&.style_guidelines&.with_indifferent_access || {}
  bp_colors = style_guidelines[:colors] || {}
  bp_typography = style_guidelines[:typography] || {}
  bp_style = style_guidelines[:style] || 'modern'
  design_reference_url = data[:design_reference_url] || style_guidelines[:reference_image_url]
%>

<% # Check if plan has actual content (not just empty hash) %>
<% # Website plans have sections inside pages, landing page plans have top-level sections %>
<% plan_pages = plan[:pages] || plan['pages'] || [] %>
<% sections = plan[:sections] || plan['sections'] || [] %>
<% is_website_plan = plan_pages.any? %>
<% # For websites, use first page's sections for display; for landing pages use top-level sections %>
<% if is_website_plan && sections.empty? %>
  <% first_page = plan_pages.first.respond_to?(:with_indifferent_access) ? plan_pages.first.with_indifferent_access : plan_pages.first %>
  <% sections = first_page[:sections] || first_page['sections'] || [] %>
<% end %>
<% has_plan = plan_id.present? || sections.any? || plan_pages.any? %>
<%# design_type priority: plan > canvas_data > create_type > default %>
<%# design_type resolution: plan takes precedence, then explicit data keys, then create_type, finally default %>
<% plan_design_type = plan[:design_type] || plan['design_type'] || data[:design_type] || data['design_type'] || create_type || 'landing_page' %>
<% is_app_or_canvas = %w[app canvas].include?(plan_design_type.to_s) %>
<% Rails.logger.info "🎨 Design Studio Canvas: plan_id=#{plan_id}, has_plan=#{has_plan}, is_website_plan=#{is_website_plan}, design_type=#{plan_design_type}, is_app_or_canvas=#{is_app_or_canvas}, create_type=#{create_type}, data_keys=#{data.keys.join(',')}" %>
<% is_built = landing_page_id.present? || website_id.present? %>
<div class="design-studio-canvas" id="design-studio-<%= SecureRandom.hex(4) %>"
     data-plan-id="<%= plan_id %>"
     data-website-id="<%= website_id %>"
     data-landing-page-id="<%= landing_page_id %>"
     data-is-website="<%= is_website %>"
     data-is-website-plan="<%= is_website_plan %>"
     data-design-type="<%= plan_design_type %>"
     data-is-app-or-canvas="<%= is_app_or_canvas %>"
     data-has-plan="<%= has_plan %>"
     data-is-built="<%= is_built %>"
     data-create-type="<%= create_type %>"
     data-template-name="<%= template_name %>"
     data-template-id="<%= template_id %>"
     data-plan-pages="<%= plan_pages.to_json.gsub('"', '&quot;') %>"
     data-current-page-index="0">
  <div class="studio-layout">
    <%# Pages sidebar removed - now using tabs above canvas %>
    
    <!-- Component Sidebar -->
    <div class="studio-component-sidebar" id="studio-component-sidebar">
      <div class="component-sidebar-header">
        <h6><i data-lucide="component" style="width: 14px; height: 14px;" class="me-2"></i>Components</h6>
      </div>
      
      <div class="component-search">
        <input type="text" placeholder="Search components..." id="component-search" class="search-input">
        <i data-lucide="search" class="search-icon" style="width: 14px; height: 14px;"></i>
      </div>
      
      <div class="component-categories">
        <%# 
          COMPONENT VISIBILITY LOGIC:
          - Landing Pages/Websites: Show Layout (Hero, Features, etc.), Typography, Elements, Navigation
          - Apps/Canvases: Show Dashboard, Data Sources, Data Models, Forms, App Layout
        %>
        
        <!-- Landing Page Layout (for landing pages/websites only) -->
        <div class="component-category" id="landing-page-components" style="<%= is_app_or_canvas ? 'display: none;' : '' %>">
          <div class="category-header" data-toggle="collapse" data-target="layout">
            <i data-lucide="layout-grid" style="width: 14px; height: 14px;"></i>
            <span>Layout</span>
            <i data-lucide="chevron-down" class="category-chevron" style="width: 12px; height: 12px;"></i>
          </div>
          <div class="category-items show" id="category-layout">
            <!-- Hero Variants -->
            <div class="component-group">
              <div class="component-group-label">Hero Sections</div>
              <div class="studio-component" draggable="true" data-component-type="hero" data-variant="centered" data-layout="centered">
                <div class="component-preview"><i data-lucide="align-center" style="width: 18px; height: 18px;"></i></div>
                <span>Hero Centered</span>
            </div>
              <div class="studio-component" draggable="true" data-component-type="hero" data-variant="split-image" data-layout="split">
              <div class="component-preview"><i data-lucide="columns" style="width: 18px; height: 18px;"></i></div>
                <span>Hero + Image</span>
            </div>
              <div class="studio-component" draggable="true" data-component-type="hero" data-variant="split-video" data-layout="split-video">
                <div class="component-preview"><i data-lucide="play-circle" style="width: 18px; height: 18px;"></i></div>
                <span>Hero + Video</span>
              </div>
              <div class="studio-component" draggable="true" data-component-type="hero" data-variant="split-form" data-layout="split-form">
                <div class="component-preview"><i data-lucide="text-cursor-input" style="width: 18px; height: 18px;"></i></div>
                <span>Hero + Form</span>
              </div>
            </div>
            
            <!-- Features Variants -->
            <div class="component-group">
              <div class="component-group-label">Features</div>
              <div class="studio-component" draggable="true" data-component-type="features" data-variant="3-column" data-layout="3-column">
              <div class="component-preview"><i data-lucide="layout-grid" style="width: 18px; height: 18px;"></i></div>
                <span>3 Column Grid</span>
            </div>
              <div class="studio-component" draggable="true" data-component-type="features" data-variant="icon-grid" data-layout="icon-grid">
                <div class="component-preview"><i data-lucide="grid-3x3" style="width: 18px; height: 18px;"></i></div>
                <span>Icon Grid</span>
              </div>
              <div class="studio-component" draggable="true" data-component-type="features" data-variant="list" data-layout="list">
                <div class="component-preview"><i data-lucide="list" style="width: 18px; height: 18px;"></i></div>
                <span>Feature List</span>
              </div>
            </div>
            
            <!-- Testimonials Variants -->
            <div class="component-group">
              <div class="component-group-label">Testimonials</div>
              <div class="studio-component" draggable="true" data-component-type="testimonials" data-variant="cards" data-layout="cards">
              <div class="component-preview"><i data-lucide="square" style="width: 18px; height: 18px;"></i></div>
                <span>Quote Cards</span>
            </div>
              <div class="studio-component" draggable="true" data-component-type="testimonials" data-variant="carousel" data-layout="carousel">
                <div class="component-preview"><i data-lucide="gallery-horizontal" style="width: 18px; height: 18px;"></i></div>
                <span>Carousel</span>
              </div>
              <div class="studio-component" draggable="true" data-component-type="testimonials" data-variant="single" data-layout="single">
                <div class="component-preview"><i data-lucide="quote" style="width: 18px; height: 18px;"></i></div>
                <span>Single Quote</span>
              </div>
            </div>
            
            <!-- Pricing Variants -->
            <div class="component-group">
              <div class="component-group-label">Pricing</div>
              <div class="studio-component" draggable="true" data-component-type="pricing" data-variant="3-tier" data-layout="3-column">
                <div class="component-preview"><i data-lucide="credit-card" style="width: 18px; height: 18px;"></i></div>
                <span>3 Tier Pricing</span>
              </div>
              <div class="studio-component" draggable="true" data-component-type="pricing" data-variant="comparison" data-layout="comparison">
                <div class="component-preview"><i data-lucide="table" style="width: 18px; height: 18px;"></i></div>
                <span>Comparison Table</span>
              </div>
            </div>
            
            <!-- CTA Variants -->
            <div class="component-group">
              <div class="component-group-label">Call to Action</div>
              <div class="studio-component" draggable="true" data-component-type="cta" data-variant="banner" data-layout="centered">
                <div class="component-preview"><i data-lucide="megaphone" style="width: 18px; height: 18px;"></i></div>
                <span>CTA Banner</span>
              </div>
              <div class="studio-component" draggable="true" data-component-type="cta" data-variant="split" data-layout="split">
                <div class="component-preview"><i data-lucide="arrow-right-circle" style="width: 18px; height: 18px;"></i></div>
                <span>CTA Split</span>
              </div>
            </div>
            
            <!-- Other Sections -->
            <div class="component-group">
              <div class="component-group-label">Other Sections</div>
              <div class="studio-component" draggable="true" data-component-type="faq" data-variant="accordion" data-layout="accordion">
                <div class="component-preview"><i data-lucide="help-circle" style="width: 18px; height: 18px;"></i></div>
                <span>FAQ Accordion</span>
              </div>
              <div class="studio-component" draggable="true" data-component-type="gallery" data-variant="grid" data-layout="grid">
                <div class="component-preview"><i data-lucide="image" style="width: 18px; height: 18px;"></i></div>
                <span>Image Gallery</span>
              </div>
              <div class="studio-component" draggable="true" data-component-type="contact" data-variant="form" data-layout="centered">
                <div class="component-preview"><i data-lucide="mail" style="width: 18px; height: 18px;"></i></div>
                <span>Contact Form</span>
              </div>
              <div class="studio-component" draggable="true" data-component-type="team" data-variant="grid" data-layout="grid">
                <div class="component-preview"><i data-lucide="users" style="width: 18px; height: 18px;"></i></div>
                <span>Team Section</span>
              </div>
            </div>
          </div>
        </div>
        
        <!-- Typography (for landing pages/websites only) -->
        <div class="component-category" id="typography-category" style="<%= is_app_or_canvas ? 'display: none;' : '' %>">
          <div class="category-header" data-toggle="collapse" data-target="typography">
            <i data-lucide="type" style="width: 14px; height: 14px;"></i>
            <span>Typography</span>
            <i data-lucide="chevron-down" class="category-chevron" style="width: 12px; height: 12px;"></i>
          </div>
          <div class="category-items" id="category-typography">
            <div class="studio-component" draggable="true" data-component-type="heading" data-variant="h1">
              <div class="component-preview"><i data-lucide="heading-1" style="width: 18px; height: 18px;"></i></div>
              <span>Heading 1</span>
            </div>
            <div class="studio-component" draggable="true" data-component-type="heading" data-variant="h2">
              <div class="component-preview"><i data-lucide="heading-2" style="width: 18px; height: 18px;"></i></div>
              <span>Heading 2</span>
            </div>
            <div class="studio-component" draggable="true" data-component-type="paragraph" data-variant="default">
              <div class="component-preview"><i data-lucide="text" style="width: 18px; height: 18px;"></i></div>
              <span>Paragraph</span>
            </div>
            <div class="studio-component" draggable="true" data-component-type="list" data-variant="bullet">
              <div class="component-preview"><i data-lucide="list" style="width: 18px; height: 18px;"></i></div>
              <span>Bullet List</span>
            </div>
          </div>
        </div>
        
        <!-- Media (for landing pages/websites only) -->
        <div class="component-category" id="media-category" style="<%= is_app_or_canvas ? 'display: none;' : '' %>">
          <div class="category-header" data-toggle="collapse" data-target="media">
            <i data-lucide="image" style="width: 14px; height: 14px;"></i>
            <span>Media</span>
            <i data-lucide="chevron-down" class="category-chevron" style="width: 12px; height: 12px;"></i>
          </div>
          <div class="category-items" id="category-media">
            <div class="studio-component" draggable="true" data-component-type="image" data-variant="default">
              <div class="component-preview"><i data-lucide="image" style="width: 18px; height: 18px;"></i></div>
              <span>Image</span>
            </div>
            <div class="studio-component" draggable="true" data-component-type="video" data-variant="embed">
              <div class="component-preview"><i data-lucide="video" style="width: 18px; height: 18px;"></i></div>
              <span>Video</span>
            </div>
            <div class="studio-component" draggable="true" data-component-type="gallery" data-variant="grid">
              <div class="component-preview"><i data-lucide="grid-3x3" style="width: 18px; height: 18px;"></i></div>
              <span>Gallery</span>
            </div>
          </div>
        </div>
        
        <!-- Landing Page Forms (for landing pages/websites only) -->
        <div class="component-category" id="lp-forms-category" style="<%= is_app_or_canvas ? 'display: none;' : '' %>">
          <div class="category-header" data-toggle="collapse" data-target="lpforms">
            <i data-lucide="text-cursor-input" style="width: 14px; height: 14px;"></i>
            <span>Forms</span>
            <i data-lucide="chevron-down" class="category-chevron" style="width: 12px; height: 12px;"></i>
          </div>
          <div class="category-items" id="category-forms">
            <div class="studio-component" draggable="true" data-component-type="form" data-variant="contact">
              <div class="component-preview"><i data-lucide="file-text" style="width: 18px; height: 18px;"></i></div>
              <span>Contact Form</span>
            </div>
            <div class="studio-component" draggable="true" data-component-type="form" data-variant="newsletter">
              <div class="component-preview"><i data-lucide="mail" style="width: 18px; height: 18px;"></i></div>
              <span>Newsletter</span>
            </div>
            <div class="studio-component" draggable="true" data-component-type="input" data-variant="text">
              <div class="component-preview"><i data-lucide="text-cursor" style="width: 18px; height: 18px;"></i></div>
              <span>Text Input</span>
            </div>
            <div class="studio-component" draggable="true" data-component-type="button" data-variant="primary">
              <div class="component-preview"><i data-lucide="rectangle-horizontal" style="width: 18px; height: 18px;"></i></div>
              <span>Button</span>
            </div>
          </div>
        </div>
        
        <!-- Cards (for landing pages/websites only) -->
        <div class="component-category" id="cards-category" style="<%= is_app_or_canvas ? 'display: none;' : '' %>">
          <div class="category-header" data-toggle="collapse" data-target="cards">
            <i data-lucide="credit-card" style="width: 14px; height: 14px;"></i>
            <span>Cards</span>
            <i data-lucide="chevron-down" class="category-chevron" style="width: 12px; height: 12px;"></i>
          </div>
          <div class="category-items" id="category-cards">
            <div class="studio-component" draggable="true" data-component-type="card" data-variant="feature">
              <div class="component-preview"><i data-lucide="sparkles" style="width: 18px; height: 18px;"></i></div>
              <span>Feature Card</span>
            </div>
            <div class="studio-component" draggable="true" data-component-type="card" data-variant="pricing">
              <div class="component-preview"><i data-lucide="tag" style="width: 18px; height: 18px;"></i></div>
              <span>Pricing Card</span>
            </div>
            <div class="studio-component" draggable="true" data-component-type="card" data-variant="testimonial">
              <div class="component-preview"><i data-lucide="quote" style="width: 18px; height: 18px;"></i></div>
              <span>Testimonial</span>
            </div>
            <div class="studio-component" draggable="true" data-component-type="card" data-variant="team">
              <div class="component-preview"><i data-lucide="user" style="width: 18px; height: 18px;"></i></div>
              <span>Team Member</span>
            </div>
          </div>
        </div>
        
        <!-- Navigation (for landing pages/websites only) -->
        <div class="component-category" id="navigation-category" style="<%= is_app_or_canvas ? 'display: none;' : '' %>">
          <div class="category-header" data-toggle="collapse" data-target="navigation">
            <i data-lucide="navigation" style="width: 14px; height: 14px;"></i>
            <span>Navigation</span>
            <i data-lucide="chevron-down" class="category-chevron" style="width: 12px; height: 12px;"></i>
          </div>
          <div class="category-items" id="category-navigation">
            <div class="studio-component" draggable="true" data-component-type="navbar" data-variant="default">
              <div class="component-preview"><i data-lucide="navigation" style="width: 18px; height: 18px;"></i></div>
              <span>Navbar</span>
            </div>
            <div class="studio-component" draggable="true" data-component-type="footer" data-variant="default">
              <div class="component-preview"><i data-lucide="panel-bottom" style="width: 18px; height: 18px;"></i></div>
              <span>Footer</span>
            </div>
          </div>
        </div>
        
        <!-- App Layout (for apps/canvases only) -->
        <div class="component-category" id="app-layout-category" style="<%= is_app_or_canvas ? '' : 'display: none;' %>">
          <div class="category-header" data-toggle="collapse" data-target="app-layout">
            <i data-lucide="layout-dashboard" style="width: 14px; height: 14px;"></i>
            <span>App Layout</span>
            <i data-lucide="chevron-down" class="category-chevron" style="width: 12px; height: 12px;"></i>
          </div>
          <div class="category-items show" id="category-app-layout">
            <div class="component-group">
              <div class="component-group-label">Structure</div>
              <div class="studio-component" draggable="true" data-component-type="app_header" data-variant="default">
                <div class="component-preview"><i data-lucide="panel-top" style="width: 18px; height: 18px;"></i></div>
                <span>App Header</span>
              </div>
              <div class="studio-component" draggable="true" data-component-type="app_sidebar" data-variant="default">
                <div class="component-preview"><i data-lucide="panel-left" style="width: 18px; height: 18px;"></i></div>
                <span>Sidebar Nav</span>
              </div>
              <div class="studio-component" draggable="true" data-component-type="container" data-variant="default">
