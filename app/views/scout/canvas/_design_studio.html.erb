}

function buildFromPlan(planId) {
  var buildBtn = document.getElementById('build-plan-btn');
  if (buildBtn) {
    buildBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Building...';
    buildBtn.disabled = true;
  }
  
  // Collect any inline edits before building
  var editedContent = {};
  document.querySelectorAll('.plan-section-card').forEach(function(card, idx) {
    var sectionEdits = {};
    card.querySelectorAll('[contenteditable="true"]').forEach(function(el) {
      var field = el.dataset.field;
      if (field && el.textContent.trim()) {
        sectionEdits[field] = el.textContent.trim();
      }
    });
    if (Object.keys(sectionEdits).length > 0) {
      editedContent[idx] = sectionEdits;
    }
  });
  
  // Send build command via the correct global function
  var message = 'Build it now from plan ' + planId;
  if (window.scoutController && typeof window.scoutController.sendScoutMessage === 'function') {
    window.scoutController.sendScoutMessage(message);
  } else if (typeof window.scoutSendMessage === 'function') {
    window.scoutSendMessage(message);
  } else {
    // Fallback to custom event
    window.dispatchEvent(new CustomEvent('scout:send-message', {
      detail: { message: message }
    }));
  }
}

// Initialize contenteditable change tracking
document.addEventListener('DOMContentLoaded', function() {
  document.querySelectorAll('.plan-section-card [contenteditable="true"]').forEach(function(el) {
    el.addEventListener('blur', function() {
      var field = this.dataset.field;
      var value = this.textContent.trim();
      var card = this.closest('.plan-section-card');
      if (field && value && card) {
        card.dataset['edited_' + field] = value;
        // Visual indicator that field was edited
        this.style.background = 'rgba(16, 185, 129, 0.1)';
      }
    });
  });
  
  // Page tab click handler for multi-page websites
  document.querySelectorAll('.page-tab').forEach(function(tab) {
    tab.addEventListener('click', function() {
      var pageIndex = parseInt(this.dataset.pageIndex, 10);
      var container = document.querySelector('.design-studio-canvas');
      if (!container) return;
      
      // Update active tab
      document.querySelectorAll('.page-tab').forEach(function(t) { t.classList.remove('active'); });
      this.classList.add('active');
      
      // Get pages from data attribute
      try {
        var pagesJson = container.dataset.planPages;
        if (!pagesJson) return;
        var pages = JSON.parse(pagesJson);
        var page = pages[pageIndex];
        if (!page) return;
        
        container.dataset.currentPageIndex = pageIndex.toString();
        
        // Re-render sections for this page
        renderPageSections(page, pageIndex);
      } catch (err) {
        console.error('Page switch error:', err);
      }
    });
  });
});

// Render sections for a specific page (website plans)
function renderPageSections(page, pageIndex) {
  var sectionsList = document.querySelector('.plan-sections-list');
  if (!sectionsList) return;
  
  var sections = page.sections || [];
  var container = document.querySelector('.design-studio-canvas');
  var planId = container ? container.dataset.planId : null;
  
  // Clear existing sections
  sectionsList.innerHTML = '';
  
  // Render each section
  sections.forEach(function(section, idx) {
    var cardHtml = buildSectionCard(section, idx, pageIndex);
    sectionsList.insertAdjacentHTML('beforeend', cardHtml);
  });
  
  // Re-initialize lucide icons
  if (typeof lucide !== 'undefined') lucide.createIcons();
  
  // Re-attach drag handlers
  initSectionDragDrop();
}

// Initialize drag-drop handlers (already set up via event delegation, but called after dynamic content changes)
function initSectionDragDrop() {
  // Drag-drop is handled via event delegation on .design-studio-canvas, no re-init needed
  console.log('📋 Section drag-drop ready (event delegation)');
}

// Build HTML for a section card
function buildSectionCard(section, idx, pageIndex) {
  var sectionType = section.type || section.name || 'unknown';
  var sectionName = section.name || sectionType;
  var layoutHint = section.layout_hint || 'default';
  var background = section.background || 'light';
  var content = section.content || {};
  
  var pagePrefix = pageIndex !== undefined ? ('p' + pageIndex + '_') : '';
  var sectionId = pagePrefix + 'section_' + idx;
  
  var html = '<div class="plan-section-card" data-section-idx="' + idx + '" ' +
    'data-section-type="' + sectionType + '" ' +
    'data-section-name="' + sectionName + '" ' +
    'data-page-index="' + (pageIndex || 0) + '" ' +
    'data-layout="' + layoutHint + '" ' +
    'data-background="' + background + '" draggable="true">';
  
  html += '<div class="section-card-header">' +
    '<div class="section-drag-handle"><i data-lucide="grip-vertical" style="width: 14px; height: 14px;"></i></div>' +
    '<span class="section-number">' + (idx + 1) + '</span>' +
    '<span class="section-type-badge">' + sectionType + '</span>' +
    '<span class="section-layout-badge"><i data-lucide="layout" style="width: 12px; height: 12px;"></i> ' + layoutHint + '</span>' +
    '<span class="section-bg-badge ' + background + '">' + background + '</span>' +
    '<div class="section-actions">' +
    '<button class="btn-section-remove" onclick="removeSection(' + idx + ', \'' + sectionName + '\')" title="Remove section">' +
    '<i data-lucide="trash-2" style="width: 12px; height: 12px;"></i></button>' +
    '</div></div>';
  
  html += '<div class="section-content-body">' + getSectionContentHtml(sectionType, content, idx) + '</div>';
  html += '</div>';
  
  return html;
}

