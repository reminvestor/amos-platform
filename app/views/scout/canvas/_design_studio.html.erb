<script>
(function() {
  const container = document.querySelector('.design-studio-canvas');
  if (!container || container.dataset.initialized) return;
  container.dataset.initialized = 'true';
  
  const canvas = container.querySelector('#studio-canvas');
  
  // Update toolbar buttons based on creation type
  function updateToolbarButtons(type) {
    const toolbarRight = container.querySelector('.toolbar-right');
    if (!toolbarRight) return;
    
    // Clear existing buttons
    toolbarRight.innerHTML = '';
    
    // Add Save button
    const saveBtn = document.createElement('button');
    saveBtn.className = 'btn btn-sm btn-outline-secondary me-2';
    saveBtn.id = 'save-design-btn';
    saveBtn.innerHTML = '<i data-lucide="save" style="width: 14px; height: 14px;" class="me-1"></i>Save';
    saveBtn.addEventListener('click', () => saveDesign());
    toolbarRight.appendChild(saveBtn);
    
    // Add Preview button
    const previewBtn = document.createElement('button');
    previewBtn.className = 'btn btn-sm btn-outline-secondary me-2';
    previewBtn.id = 'preview-design-btn';
    previewBtn.innerHTML = '<i data-lucide="eye" style="width: 14px; height: 14px;" class="me-1"></i>Preview';
    previewBtn.addEventListener('click', () => previewDesign());
    toolbarRight.appendChild(previewBtn);
    
    // Add Publish button
    const publishBtn = document.createElement('button');
    publishBtn.className = 'btn-publish';
    publishBtn.id = 'publish-design-btn';
    publishBtn.innerHTML = '<i data-lucide="globe" style="width: 14px; height: 14px;"></i> Publish';
    publishBtn.addEventListener('click', () => publishDesign());
    toolbarRight.appendChild(publishBtn);
    
        if (typeof lucide !== 'undefined') lucide.createIcons();
      }
  
  // Save design
  function saveDesign() {
    const type = container.dataset.createType || 'landing_page';
    sendToAmos(`Save this ${type} design`);
  }
  
  // Preview design
  function previewDesign() {
    const type = container.dataset.createType || 'landing_page';
    sendToAmos(`Preview the current ${type} design`);
  }
  
  // Publish design
  function publishDesign() {
    const type = container.dataset.createType || 'landing_page';
    sendToAmos(`Publish this ${type}`);
  }
  
  // Helper to send messages to Amos
  function sendToAmos(message) {
    if (!message) return;
    if (window.scoutController?.sendScoutMessage) {
      window.scoutController.sendScoutMessage(message);
    } else {
      window.dispatchEvent(new CustomEvent('scout:send-message', {
        detail: { message: message }
      }));
    }
  }
  
  // Helper to update toolbar buttons based on state
  function updateToolbarState() {
    const hasPlan = container.dataset.hasPlan === 'true' || container.dataset.planId;
    const isBuilt = container.dataset.isBuilt === 'true' || container.dataset.landingPageId || container.dataset.websiteId;
    const toolbarRight = container.querySelector('.toolbar-right');
    
    if (!toolbarRight) return;
    
    // Build button: show only when plan exists but not built
    let buildBtn = toolbarRight.querySelector('#build-from-plan-btn');
    if (hasPlan && !isBuilt && !buildBtn) {
      // Add build button
      const btn = document.createElement('button');
      btn.className = 'btn-build';
      btn.id = 'build-from-plan-btn';
      btn.title = 'Build this design into a page';
      btn.innerHTML = '<i data-lucide="hammer" style="width: 14px; height: 14px;"></i> Build';
      toolbarRight.insertBefore(btn, toolbarRight.firstChild);
        if (typeof lucide !== 'undefined') lucide.createIcons();
      
      // Add click handler
      btn.addEventListener('click', handleBuildClick);
    } else if ((!hasPlan || isBuilt) && buildBtn) {
      buildBtn.remove();
    }
    
    // Preview & Publish: show only when built
    let previewBtn = toolbarRight.querySelector('#preview-btn');
    let publishBtn = toolbarRight.querySelector('#publish-btn');
    
    if (isBuilt && !previewBtn) {
      // Add preview button
      const preview = document.createElement('button');
      preview.className = 'btn btn-sm btn-outline-secondary';
      preview.id = 'preview-btn';
      preview.innerHTML = '<i data-lucide="eye" style="width: 14px; height: 14px;" class="me-1"></i> Preview';
      toolbarRight.appendChild(preview);
      if (typeof lucide !== 'undefined') lucide.createIcons();
    } else if (!isBuilt && previewBtn) {
      previewBtn.remove();
    }
    
    if (isBuilt && !publishBtn) {
      // Add publish button
      const publish = document.createElement('button');
      publish.className = 'btn-publish';
      publish.id = 'publish-btn';
      publish.title = 'Publish this page/site';
      publish.innerHTML = '<i data-lucide="globe" style="width: 14px; height: 14px;"></i> Publish';
      toolbarRight.appendChild(publish);
      if (typeof lucide !== 'undefined') lucide.createIcons();
      
      // Add click handler
      publish.addEventListener('click', handlePublishClick);
    } else if (!isBuilt && publishBtn) {
      publishBtn.remove();
    }
  }
  
  function handleBuildClick() {
    const planId = container.dataset.planId;
    if (!planId) {
      sendToAmos('Create a design plan for my landing page');
      return;
    }
    sendToAmos(`Build the landing page from design plan ${planId}`);
  }
  
  function handlePublishClick() {
    const landingPageId = container.dataset.landingPageId;
    const websiteId = container.dataset.websiteId;
    if (landingPageId) {
      sendToAmos(`Publish landing page ${landingPageId}`);
    } else if (websiteId) {
      sendToAmos(`Publish website ${websiteId}`);
    } else {
      sendToAmos('Publish this design');
    }
  }
  
  // Listen for state updates from Amos
  window.addEventListener('design-studio:state-update', function(e) {
    if (e.detail) {
      if (e.detail.planId) container.dataset.planId = e.detail.planId;
      if (e.detail.hasPlan !== undefined) container.dataset.hasPlan = e.detail.hasPlan;
      if (e.detail.isBuilt !== undefined) container.dataset.isBuilt = e.detail.isBuilt;
      if (e.detail.landingPageId) container.dataset.landingPageId = e.detail.landingPageId;
      if (e.detail.websiteId) container.dataset.websiteId = e.detail.websiteId;
      updateToolbarState();
    }
  });
  
  // Category collapse/expand
  container.querySelectorAll('.category-header[data-toggle="collapse"]').forEach(header => {
    header.addEventListener('click', function() {
      const targetId = 'category-' + this.dataset.target;
      const items = container.querySelector('#' + targetId);
      if (items) {
        items.classList.toggle('show');
        const chevron = this.querySelector('.category-chevron');
        if (chevron) {
          chevron.style.transform = items.classList.contains('show') ? 'rotate(0deg)' : 'rotate(-90deg)';
        }
      }
    });
  });
  
  // Search filter
  const searchInput = container.querySelector('#component-search');
  if (searchInput) {
    searchInput.addEventListener('input', function() {
      const query = this.value.toLowerCase();
      container.querySelectorAll('.studio-component').forEach(comp => {
        const text = comp.textContent.toLowerCase();
        comp.style.display = text.includes(query) ? '' : 'none';
      });
    });
  }
  
  // Component drag
  container.querySelectorAll('.studio-component').forEach(comp => {
    comp.addEventListener('dragstart', function(e) {
      e.dataTransfer.setData('application/json', JSON.stringify({
        type: this.dataset.componentType,
        variant: this.dataset.variant,
        label: this.querySelector('span')?.textContent || 'Component'
      }));
      e.dataTransfer.effectAllowed = 'copy';
      this.classList.add('dragging');
    });
    
    comp.addEventListener('dragend', function() {
      this.classList.remove('dragging');
    });
  });
  
  // Canvas drop zone
  if (canvas) {
    canvas.addEventListener('dragover', function(e) {
      e.preventDefault();
      e.dataTransfer.dropEffect = 'copy';
      this.classList.add('drag-over');
    });
    
    canvas.addEventListener('dragleave', function() {
      this.classList.remove('drag-over');
    });
    
    canvas.addEventListener('drop', function(e) {
      e.preventDefault();
      this.classList.remove('drag-over');
      
      try {
        const data = JSON.parse(e.dataTransfer.getData('application/json'));
        console.log('🎨 Drop component:', data);
        
        // Remove empty state if present
        const emptyState = this.querySelector('.canvas-empty-state');
        if (emptyState) emptyState.remove();
        
        // Add component to canvas
        addComponentToCanvas(data);
      } catch (err) {
        console.error('Drop error:', err);
      }
    });
  }
  
  // Add component to canvas
  function addComponentToCanvas(data) {
    const wrapper = canvas.querySelector('.plan-visualization') || canvas;
    const componentHtml = getComponentHtml(data);
    wrapper.insertAdjacentHTML('beforeend', componentHtml);
    if (typeof lucide !== 'undefined') lucide.createIcons();
  }
  
  // Generate component HTML
  function getComponentHtml(data) {
    const type = data.type;
    const variant = data.variant;
    
    // Simple preview sections for plan mode
    return `<div class="preview-section section-${variant}" draggable="true" data-section="${variant}">
      <div class="section-label">${data.label}</div>
      <div class="section-content">
        <span class="section-type-badge">${type}</span>
        <p class="section-hint">Drag to reorder or configure this section</p>
      </div>
      <div class="section-actions">
        <button class="section-action-btn" data-action="edit" title="Edit"><i data-lucide="pencil" style="width: 12px;"></i></button>
        <button class="section-action-btn" data-action="remove" title="Remove"><i data-lucide="trash-2" style="width: 12px;"></i></button>
      </div>
    </div>`;
  }
  
  // Creation cards - What do you want to create?
  container.querySelectorAll('.creation-card').forEach(card => {
    card.addEventListener('click', function() {
      const type = this.dataset.type;
      console.log('🎨 Creation type selected:', type);
      
      // Store selection
      container.dataset.createType = type;
      
      // Update toolbar title
      const toolbarTitle = container.querySelector('.toolbar-title');
      if (toolbarTitle) {
        const typeNames = { 'landing_page': 'Landing Page', 'website': 'Website', 'app': 'App', 'canvas': 'Canvas' };
        toolbarTitle.textContent = 'New ' + typeNames[type];
      }
      
      // Show toolbar action buttons
      updateToolbarButtons(type);
      
      // Show/create pages tab bar for websites, apps, and canvases
      const pagesTabBar = container.querySelector('#pages-tab-bar');
      
      if (type === 'website' || type === 'app' || type === 'canvas') {
        if (pagesTabBar) {
          pagesTabBar.style.display = 'flex';
          
          // Add initial Homepage tab if tabs are empty
          const pagesTabs = container.querySelector('#pages-tabs');
          if (pagesTabs && !pagesTabs.querySelector('.page-tab')) {
            const homeTabHtml = `
              <div class="page-tab active" data-page-id="home" data-page-slug="home">
                <i data-lucide="home" style="width: 12px; height: 12px;"></i>
                <span class="page-tab-name">Homepage</span>
                <button class="page-tab-close" title="Close"><i data-lucide="x" style="width: 10px; height: 10px;"></i></button>
              </div>
            `;
            pagesTabs.innerHTML = homeTabHtml;
            if (typeof lucide !== 'undefined') lucide.createIcons();
          }
          
          // Setup add page tab button
          setupAddPageTabButton();
          setupPageTabs();
        }
      } else if (pagesTabBar) {
        pagesTabBar.style.display = 'none';
      }
      
      // Replace empty state with blank workspace
      const emptyState = container.querySelector('.canvas-empty-state');
      if (emptyState) {
        const typeNames = {
          'landing_page': 'Landing Page',
          'website': 'Website', 
          'app': 'App',
          'canvas': 'Canvas'
        };
        
        // Create blank workspace based on type
        let workspaceHtml = '';
        
        if (type === 'canvas') {
          // Canvas gets a different template - freeform with data sources
          workspaceHtml = `
            <div class="blank-canvas-workspace" data-type="${type}">
              <div class="canvas-toolbar-mini">
                <span class="workspace-type-label"><i data-lucide="frame"></i> New ${typeNames[type]}</span>
                <button class="btn-add-data-source" id="add-data-source-btn" title="Connect data source">
                  <i data-lucide="database" style="width: 14px; height: 14px;"></i>
                  Add Data Source
                </button>
              </div>
              <div class="canvas-freeform-area" id="freeform-drop-zone">
                <div class="drop-hint">
                  <i data-lucide="mouse-pointer-click" style="width: 24px; height: 24px;"></i>
                  <span>Drag components here or ask Amos to help</span>
                </div>
              </div>
            </div>
          `;
          
          // Setup data source button for canvas
          setupDataSourceButton();
        } else {
          // Landing page, website, app get page-based template
          const showDataBtn = (type === 'app');
          workspaceHtml = `
            <div class="blank-page-workspace" data-type="${type}">
              <div class="page-toolbar-mini">
                <span class="workspace-type-label"><i data-lucide="${type === 'landing_page' ? 'file-text' : type === 'website' ? 'layout-template' : 'layers'}"></i> New ${typeNames[type]}</span>
                ${showDataBtn ? `<button class="btn-add-data-source" id="add-data-source-btn" title="Connect data source">
                  <i data-lucide="database" style="width: 14px; height: 14px;"></i>
                  Add Data Source
                </button>` : ''}
              </div>
              <div class="page-sections-area" id="sections-drop-zone">
                <div class="page-section-placeholder" data-section="header">
                  <i data-lucide="panel-top" style="width: 20px; height: 20px;"></i>
                  <span>Header / Navigation</span>
                  <small>Drag a header component here</small>
                </div>
                <div class="page-section-placeholder hero" data-section="hero">
                  <i data-lucide="image" style="width: 24px; height: 24px;"></i>
                  <span>Hero Section</span>
                  <small>Drag a hero component here</small>
                </div>
                <div class="page-section-placeholder" data-section="content">
                  <i data-lucide="layout-grid" style="width: 20px; height: 20px;"></i>
                  <span>Content Sections</span>
                  <small>Drag content components here</small>
                </div>
                <div class="page-section-placeholder" data-section="footer">
                  <i data-lucide="panel-bottom" style="width: 20px; height: 20px;"></i>
                  <span>Footer</span>
                  <small>Drag a footer component here</small>
                </div>
              </div>
            </div>
          `;
        }
        
        emptyState.outerHTML = workspaceHtml;
        if (typeof lucide !== 'undefined') lucide.createIcons();
        
        // Setup drop zones for the new workspace
        setupDropZones();
        
        // Setup data source button for apps and canvases
        if (type === 'app' || type === 'canvas') {
          setupDataSourceButton();
        }
        
        // Update toolbar title
        const titleEl = container.querySelector('.toolbar-title');
        if (titleEl) {
          titleEl.textContent = `New ${typeNames[type]}`;
        }
      }
    });
  });
  
  // Show data sources dropdown (not a sidebar)
  function showDataSourcesDropdown(button) {
    // Remove any existing dropdown
    const existing = document.querySelector('.data-sources-dropdown');
    if (existing) {
      existing.remove();
      return;
    }
    
    const dropdownHtml = `
      <div class="data-sources-dropdown">
        <div class="dropdown-header">
          <span>Add Data Source</span>
        </div>
        <button class="dropdown-item" data-source="integration">
          <i data-lucide="plug" style="width: 16px; height: 16px;"></i>
          <div class="dropdown-item-text">
            <span class="dropdown-item-title">Integration</span>
            <small>Stripe, QuickBooks, HubSpot...</small>
          </div>
        </button>
        <button class="dropdown-item" data-source="module">
          <i data-lucide="box" style="width: 16px; height: 16px;"></i>
          <div class="dropdown-item-text">
            <span class="dropdown-item-title">App Module</span>
            <small>Your custom data modules</small>
          </div>
        </button>
        <button class="dropdown-item" data-source="api">
          <i data-lucide="globe" style="width: 16px; height: 16px;"></i>
          <div class="dropdown-item-text">
            <span class="dropdown-item-title">External API</span>
            <small>Connect any REST API</small>
          </div>
        </button>
      </div>
    `;
    
    // Position dropdown below button
    const rect = button.getBoundingClientRect();
    const dropdown = document.createElement('div');
    dropdown.innerHTML = dropdownHtml;
    const dropdownEl = dropdown.firstElementChild;
    dropdownEl.style.position = 'fixed';
    dropdownEl.style.top = (rect.bottom + 4) + 'px';
    dropdownEl.style.left = rect.left + 'px';
    document.body.appendChild(dropdownEl);
    
    if (typeof lucide !== 'undefined') lucide.createIcons();
    
    // Setup click handlers
    dropdownEl.querySelectorAll('.dropdown-item').forEach(item => {
      item.addEventListener('click', function() {
        const sourceType = this.dataset.source;
        dropdownEl.remove();
        if (sourceType === 'integration') {
          sendToAmos('Show me my available integrations to connect as a data source');
        } else if (sourceType === 'module') {
          sendToAmos('Show me my app modules to use as a data source');
        } else if (sourceType === 'api') {
          sendToAmos('Help me connect an external API as a data source');
        }
      });
    });
    
    // Close on click outside
    setTimeout(() => {
      document.addEventListener('click', function closeDropdown(e) {
        if (!dropdownEl.contains(e.target) && e.target !== button) {
          dropdownEl.remove();
          document.removeEventListener('click', closeDropdown);
        }
      });
    }, 10);
  }
  
  // Setup data source button click handler
  function setupDataSourceButton() {
    const dataBtn = container.querySelector('#add-data-source-btn');
    if (dataBtn) {
      dataBtn.addEventListener('click', function(e) {
        e.stopPropagation();
        showDataSourcesDropdown(this);
      });
    }
  }
  
  // Setup add page tab button
  function setupAddPageTabButton() {
    const addBtn = container.querySelector('#add-page-tab-btn');
    if (addBtn && !addBtn.dataset.initialized) {
      addBtn.dataset.initialized = 'true';
      addBtn.addEventListener('click', function() {
        const pageName = prompt('Enter page name:', 'About Us');
        if (pageName && pageName.trim()) {
          addNewPageTab(pageName.trim());
        }
      });
    }
  }
  
  // Setup page tab click handlers
  function setupPageTabs() {
    container.querySelectorAll('.page-tab').forEach(tab => {
      if (tab.dataset.initialized) return;
      tab.dataset.initialized = 'true';
      
      tab.addEventListener('click', function(e) {
        if (e.target.closest('.page-tab-close')) return;
        
        container.querySelectorAll('.page-tab').forEach(t => t.classList.remove('active'));
        this.classList.add('active');
        
        const pageId = this.dataset.pageId;
        const pageName = this.querySelector('.page-tab-name')?.textContent || 'Page';
        resetCanvasForPage(pageId, pageName);
      });
      
      // Close button
      const closeBtn = tab.querySelector('.page-tab-close');
      if (closeBtn) {
        closeBtn.addEventListener('click', function(e) {
          e.stopPropagation();
          const tabToRemove = this.closest('.page-tab');
          const wasActive = tabToRemove.classList.contains('active');
          tabToRemove.remove();
          
          // If removed tab was active, activate first remaining tab
          if (wasActive) {
            const firstTab = container.querySelector('.page-tab');
            if (firstTab) {
              firstTab.classList.add('active');
              firstTab.click();
            }
          }
        });
      }
    });
  }
  
  // Add a new page tab
  function addNewPageTab(pageName) {
    const pagesTabs = container.querySelector('#pages-tabs');
    if (!pagesTabs) return;
    
    const pageSlug = pageName.toLowerCase().replace(/\s+/g, '-').replace(/[^a-z0-9-]/g, '');
    const pageId = 'page-' + Date.now();
    
    // Remove active class from other tabs
    pagesTabs.querySelectorAll('.page-tab').forEach(t => t.classList.remove('active'));
    
    // Add new tab
    const tabHtml = `
      <div class="page-tab active" data-page-id="${pageId}" data-page-slug="${pageSlug}">
        <i data-lucide="file" style="width: 12px; height: 12px;"></i>
        <span class="page-tab-name">${pageName}</span>
        <button class="page-tab-close" title="Close"><i data-lucide="x" style="width: 10px; height: 10px;"></i></button>
      </div>
    `;
    pagesTabs.insertAdjacentHTML('beforeend', tabHtml);
    
    if (typeof lucide !== 'undefined') lucide.createIcons();
    
    // Setup handlers for new tab
    setupPageTabs();
    
    // Reset canvas for the new page
    resetCanvasForPage(pageId, pageName);
    
    console.log('📄 Added new page tab:', pageName);
  }
  
  // Reset canvas for a specific page
  function resetCanvasForPage(pageId, pageName) {
    const canvasArea = container.querySelector('#studio-canvas');
    if (!canvasArea) return;
    
    canvasArea.innerHTML = `
      <div class="blank-page-workspace" data-type="website" data-page-id="${pageId}">
        <div class="page-toolbar-mini">
          <span class="workspace-type-label"><i data-lucide="file"></i> ${pageName}</span>
        </div>
        <div class="page-sections-area" id="sections-drop-zone">
          <div class="page-section-placeholder" data-section="header">
            <i data-lucide="panel-top" style="width: 20px; height: 20px;"></i>
            <span>Header / Navigation</span>
            <small>Drag a header component here</small>
          </div>
          <div class="page-section-placeholder hero" data-section="hero">
            <i data-lucide="image" style="width: 24px; height: 24px;"></i>
            <span>Hero Section</span>
            <small>Drag a hero component here</small>
          </div>
          <div class="page-section-placeholder" data-section="content">
            <i data-lucide="layout-grid" style="width: 20px; height: 20px;"></i>
            <span>Content Sections</span>
            <small>Drag content components here</small>
          </div>
          <div class="page-section-placeholder" data-section="footer">
            <i data-lucide="panel-bottom" style="width: 20px; height: 20px;"></i>
            <span>Footer</span>
            <small>Drag a footer component here</small>
          </div>
        </div>
      </div>
    `;
    
    if (typeof lucide !== 'undefined') lucide.createIcons();
    setupDropZones();
    
    // Update toolbar title
    const titleEl = container.querySelector('.toolbar-title');
    if (titleEl) {
      titleEl.textContent = pageName;
    }
  }
  
  
  // Setup drop zones for drag and drop
  function setupDropZones() {
    const dropZones = container.querySelectorAll('.page-section-placeholder, #freeform-drop-zone, #sections-drop-zone');
    
    dropZones.forEach(zone => {
      zone.addEventListener('dragover', function(e) {
        e.preventDefault();
        this.classList.add('drag-over');
      });
      
      zone.addEventListener('dragleave', function(e) {
        this.classList.remove('drag-over');
      });
      
      zone.addEventListener('drop', function(e) {
        e.preventDefault();
        this.classList.remove('drag-over');
        
        try {
          const data = JSON.parse(e.dataTransfer.getData('application/json') || e.dataTransfer.getData('text/plain'));
          console.log('📦 Dropped component:', data);
          
          // Add component to this zone
          const componentHtml = getComponentHtml(data);
          if (this.classList.contains('page-section-placeholder')) {
            this.outerHTML = componentHtml;
          } else {
            this.insertAdjacentHTML('beforeend', componentHtml);
            // Remove drop hint if present
            const hint = this.querySelector('.drop-hint');
            if (hint) hint.remove();
          }
          
          if (typeof lucide !== 'undefined') lucide.createIcons();
        } catch (err) {
          console.error('Drop error:', err);
        }
      });
    });
  }
  
  // Build from plan button
  const buildBtn = container.querySelector('#build-from-plan-btn');
  const statusBanner = container.querySelector('#build-status-banner');
  
  if (buildBtn) {
    buildBtn.addEventListener('click', async function() {
      // Show building state
      this.disabled = true;
      this.innerHTML = '<i data-lucide="loader-2" class="spin"></i> Building...';
      if (typeof lucide !== 'undefined') lucide.createIcons();
      
      try {
        handleBuildClick();
        
        // Show success (Amos will handle the actual building)
        if (statusBanner) {
          statusBanner.style.display = 'flex';
          statusBanner.className = 'build-status-banner';
          statusBanner.querySelector('.build-status-text').textContent = 'Building your landing page...';
          statusBanner.querySelector('.build-status-details').textContent = 'Amos is generating the HTML';
        }
        
        buildBtn.classList.add('built');
        buildBtn.innerHTML = '<i data-lucide="hammer"></i> Building...';
        
      } catch (error) {
        console.error('Build error:', error);
        if (statusBanner) {
          statusBanner.style.display = 'flex';
          statusBanner.className = 'build-status-banner error';
          statusBanner.querySelector('.build-status-text').textContent = 'Build failed';
          statusBanner.querySelector('.build-status-details').textContent = error.message;
        }
        buildBtn.innerHTML = '<i data-lucide="hammer"></i> Build';
      } finally {
        buildBtn.disabled = false;
        if (typeof lucide !== 'undefined') lucide.createIcons();
      }
    });
  }
  
  // Close build status banner
  const closeStatusBtn = container.querySelector('#close-build-status');
  if (closeStatusBtn && statusBanner) {
    closeStatusBtn.addEventListener('click', function() {
      statusBanner.style.display = 'none';
    });
  }
  
  // Section actions
  container.querySelectorAll('.section-action-btn').forEach(btn => {
    btn.addEventListener('click', function(e) {
      e.stopPropagation();
      const action = this.dataset.action;
      const section = this.closest('.preview-section');
      const sectionName = section?.dataset.section;
      
      if (action === 'remove' && section) {
        section.remove();
      } else if (action === 'edit' && sectionName) {
        const planId = container.dataset.planId;
        sendToAmos(`Edit the ${sectionName} section in the design plan`);
      }
    });
  });
  
  // Viewport controls
  container.querySelectorAll('.viewport-btn').forEach(btn => {
    btn.addEventListener('click', function() {
      container.querySelectorAll('.viewport-btn').forEach(b => b.classList.remove('active'));
      this.classList.add('active');
      
      const viewport = this.dataset.viewport;
      const canvasEl = container.querySelector('.studio-canvas');
      if (canvasEl) {
        canvasEl.style.maxWidth = viewport === 'mobile' ? '375px' : 
                                   viewport === 'tablet' ? '768px' : '1200px';
      }
    });
  });
  
  // Page selection
  container.querySelectorAll('.page-item').forEach(item => {
    item.addEventListener('click', function() {
      const pageId = this.dataset.pageId;
      const pageSlug = this.dataset.pageSlug;
      
      container.querySelectorAll('.page-item').forEach(i => i.classList.remove('active'));
      this.classList.add('active');
      
      console.log('📄 Selected page:', pageId, pageSlug);
      
      // Ask Amos to load this page
      sendToAmos(`Open page ${pageSlug || pageId} in the editor`);
    });
  });
  
  // Setup page tabs for existing pages
  setupPageTabs();
  setupAddPageTabButton();
  
  // Create first page button
  const createFirstPageBtn = container.querySelector('#create-first-page-btn');
  if (createFirstPageBtn) {
    createFirstPageBtn.addEventListener('click', function() {
      const websiteId = container.dataset.websiteId;
      sendToAmos(`Create the homepage for website ${websiteId}`);
    });
  }
  
  // Site settings button
  const siteSettingsBtn = container.querySelector('#site-settings-btn');
  if (siteSettingsBtn) {
    siteSettingsBtn.addEventListener('click', function() {
      const websiteId = container.dataset.websiteId;
      sendToAmos(`Show site settings for website ${websiteId}`);
    });
  }
  
  // Publish button
  const publishBtn = container.querySelector('#publish-btn');
  if (publishBtn) {
    publishBtn.addEventListener('click', function() {
      handlePublishClick();
      
      // Visual feedback
      this.classList.add('published');
      this.innerHTML = '<i data-lucide="check"></i> Publishing...';
      if (typeof lucide !== 'undefined') lucide.createIcons();
    });
  }
  
  // Init icons
  if (typeof lucide !== 'undefined') {
    lucide.createIcons();
  }
})();
</script>
