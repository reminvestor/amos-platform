  // Setup drop zones for drag and drop
  function setupDropZones() {
    var dropZones = container.querySelectorAll('.page-section-placeholder, .app-placeholder-item, #freeform-drop-zone, #sections-drop-zone');
    
    dropZones.forEach(function(zone) {
      // Skip if already initialized
      if (zone.dataset.dropInitialized) return;
      zone.dataset.dropInitialized = 'true';
      
      zone.addEventListener('dragover', function(e) {
        e.preventDefault();
        this.classList.add('drag-over');
      });
      
      zone.addEventListener('dragleave', function(e) {
        this.classList.remove('drag-over');
      });
      
      zone.addEventListener('drop', function(e) {
        e.preventDefault();
        e.stopPropagation(); // Prevent bubbling to parent canvas drop handler
        this.classList.remove('drag-over');
        
        // Only handle component drops (application/json), ignore section reorders
        var jsonData = e.dataTransfer.getData('application/json');
        if (!jsonData) {
          // Not a component drop - might be section reorder or data model
          return;
        }
        
        try {
          var data = JSON.parse(jsonData);
          // Ensure it's a component object with a type
          if (!data || typeof data !== 'object' || !data.type) {
            return;
          }
          console.log('📦 Dropped component:', data);
          
          // Add component to this zone
          var componentHtml = getComponentHtml(data);
          
          if (this.classList.contains('page-section-placeholder') || this.classList.contains('app-placeholder-item')) {
            // Replace the placeholder with the component
            this.outerHTML = componentHtml;
          } else if (this.id === 'freeform-drop-zone') {
            // For freeform area, append and remove hints
            this.insertAdjacentHTML('beforeend', componentHtml);
            // Remove app-drop-hint if present
            var appHint = this.querySelector('.app-drop-hint');
            if (appHint) appHint.remove();
            // Remove regular drop hint if present
            var hint = this.querySelector('.drop-hint');
            if (hint) hint.remove();
          } else {
            this.insertAdjacentHTML('beforeend', componentHtml);
            // Remove drop hint if present
            var hint = this.querySelector('.drop-hint');
            if (hint) hint.remove();
          }
          
          if (typeof lucide !== 'undefined') lucide.createIcons();
          
          // Auto-save after component drop
          scheduleAutoSave();
        } catch (err) {
          console.error('Drop error:', err);
        }
      });
    });
  }
  
