  var createFirstPageBtn = container.querySelector('#create-first-page-btn');
  if (createFirstPageBtn) {
    createFirstPageBtn.addEventListener('click', function() {
      var websiteId = container.dataset.websiteId;
      sendToAmos('Create the homepage for website ' + websiteId);
    });
  }
  
  // Site settings button
  var siteSettingsBtn = container.querySelector('#site-settings-btn');
  if (siteSettingsBtn) {
    siteSettingsBtn.addEventListener('click', function() {
      var websiteId = container.dataset.websiteId;
      sendToAmos('Show site settings for website ' + websiteId);
    });
  }
  
  // Publish button
  var publishBtn2 = container.querySelector('#publish-btn');
  if (publishBtn2) {
    publishBtn2.addEventListener('click', function() {
      handlePublishClick();
      
      // Visual feedback
      this.classList.add('published');
      this.innerHTML = '<i data-lucide="check"></i> Publishing...';
      if (typeof lucide !== 'undefined') lucide.createIcons();
    });
  }
  
  // Save button
  var saveBtn = container.querySelector('#save-design-btn');
  if (saveBtn) {
    saveBtn.addEventListener('click', function() {
      console.log('💾 Saving design...');
      autoSaveDesign();
      
      // Visual feedback
      var originalHtml = this.innerHTML;
      this.innerHTML = '<i data-lucide="check" style="width: 14px; height: 14px;"></i> Saved!';
      this.disabled = true;
      if (typeof lucide !== 'undefined') lucide.createIcons();
      
      setTimeout(function() {
        saveBtn.innerHTML = originalHtml;
        saveBtn.disabled = false;
        if (typeof lucide !== 'undefined') lucide.createIcons();
      }, 2000);
    });
  }
  
  // Click-to-configure on component placeholder
  container.addEventListener('click', function(e) {
    var configHint = e.target.closest('.component-config-hint');
    var placeholder = e.target.closest('.component-placeholder');
    
    if (configHint || (placeholder && !e.target.closest('.component-action-btn'))) {
      var component = (configHint || placeholder).closest('.dashboard-component');
      if (component) {
        var componentType = component.dataset.componentType;
        var label = component.querySelector('.component-label')?.textContent || componentType;
        console.log('🖱️ Click-to-configure triggered:', componentType);
        configureComponent(component, componentType, label);
      }
    }
  });
  
  // Init icons
  if (typeof lucide !== 'undefined') {
    lucide.createIcons();
  }
  
  // ===== SECTION DRAG & DROP REORDERING (Event Delegation) =====
  // Use event delegation so it works with dynamically added sections
  var draggedSectionCard = null;
  
  // Drag start - delegated to container
  container.addEventListener('dragstart', function(e) {
    var card = e.target.closest('.plan-section-card');
    if (!card) return;
    
    draggedSectionCard = card;
    card.classList.add('dragging');
    e.dataTransfer.effectAllowed = 'move';
    e.dataTransfer.setData('text/plain', card.dataset.sectionIdx || '0');
    console.log('🎯 Started dragging section:', card.dataset.sectionName);
  });
  
  // Drag end - delegated
  container.addEventListener('dragend', function(e) {
    var card = e.target.closest('.plan-section-card');
    if (!card) return;
    
    card.classList.remove('dragging');
    // Clear all drag-over states
    container.querySelectorAll('.plan-section-card').forEach(function(c) {
      c.classList.remove('drag-over-top', 'drag-over-bottom');
    });
    draggedSectionCard = null;
  });
  
  // Drag over - delegated
  container.addEventListener('dragover', function(e) {
    var card = e.target.closest('.plan-section-card');
    if (!card || !draggedSectionCard || draggedSectionCard === card) {
      // Also allow dropping on the sections list itself
      var sectionsList = e.target.closest('.plan-sections-list');
      if (sectionsList && draggedSectionCard) {
        e.preventDefault();
        e.dataTransfer.dropEffect = 'move';
      }
      return;
    }
    
    e.preventDefault();
    e.dataTransfer.dropEffect = 'move';
    
    // Clear previous states
    container.querySelectorAll('.plan-section-card').forEach(function(c) {
      c.classList.remove('drag-over-top', 'drag-over-bottom');
    });
    
    // Determine if drop should be above or below
    var rect = card.getBoundingClientRect();
    var midpoint = rect.top + rect.height / 2;
    
    if (e.clientY < midpoint) {
      card.classList.add('drag-over-top');
    } else {
      card.classList.add('drag-over-bottom');
    }
  });
  
  // Drag leave - delegated
  container.addEventListener('dragleave', function(e) {
    var card = e.target.closest('.plan-section-card');
    if (card) {
      // Only remove if actually leaving the card (not just moving within it)
      var related = e.relatedTarget;
      if (!card.contains(related)) {
        card.classList.remove('drag-over-top', 'drag-over-bottom');
      }
    }
  });
  
  // Drop - delegated
  container.addEventListener('drop', function(e) {
    var card = e.target.closest('.plan-section-card');
    var sectionsList = container.querySelector('.plan-sections-list');
    
    if (!draggedSectionCard || !sectionsList) return;
    
    e.preventDefault();
    
    // Clear all drag states
    container.querySelectorAll('.plan-section-card').forEach(function(c) {
      c.classList.remove('drag-over-top', 'drag-over-bottom');
    });
    
    if (!card || draggedSectionCard === card) {
      draggedSectionCard = null;
      return;
    }
    
    var fromIdx = parseInt(draggedSectionCard.dataset.sectionIdx) || 0;
    var toIdx = parseInt(card.dataset.sectionIdx) || 0;
    
    // Determine if dropping before or after
    var rect = card.getBoundingClientRect();
    var midpoint = rect.top + rect.height / 2;
    var insertBefore = e.clientY < midpoint;
    
    // Calculate final position
    var finalPosition = insertBefore ? toIdx : toIdx + 1;
    if (fromIdx < toIdx) finalPosition--;
    
    console.log('📦 Reorder section from', fromIdx, 'to', finalPosition);
    
    // Visual reorder immediately
    if (insertBefore) {
      sectionsList.insertBefore(draggedSectionCard, card);
    } else {
      sectionsList.insertBefore(draggedSectionCard, card.nextSibling);
    }
    
    // Update section numbers visually
    sectionsList.querySelectorAll('.plan-section-card').forEach(function(c, idx) {
      c.dataset.sectionIdx = idx;
      var numEl = c.querySelector('.section-number');
      if (numEl) numEl.textContent = idx + 1;
    });
    
    // Notify Amos to persist the change
    var planEl = container.querySelector('.plan-visualization-enhanced');
    var planId = planEl ? planEl.dataset.planId : container.dataset.planId;
    
    if (planId) {
      var sectionName = draggedSectionCard.dataset.sectionName || 'section';
      sendToAmos('Move the "' + sectionName + '" section to position ' + (finalPosition + 1) + ' in plan ' + planId);
    }
    
    draggedSectionCard = null;
  });
})();
</script>
