// Track which color type is being edited
var currentColorType = null;

function openColorPicker(colorType, event) {
  event.stopPropagation();
  currentColorType = colorType;
  
  var picker = document.getElementById('custom-color-picker');
  var hexInput = document.getElementById('picker-hex-input');
  var specsBar = document.getElementById('design-specs-bar');
  
  // Get current color value
  var currentColor = specsBar ? specsBar.dataset[colorType] : '#6366F1';
  hexInput.value = currentColor.toUpperCase();
  
  // Position and show picker
  picker.style.display = 'block';
  hexInput.focus();
  hexInput.select();
  
  // Close picker when clicking outside
  setTimeout(function() {
    document.addEventListener('click', closePickerOnClickOutside);
  }, 10);
}

function closeColorPicker() {
  var picker = document.getElementById('custom-color-picker');
  picker.style.display = 'none';
  currentColorType = null;
  document.removeEventListener('click', closePickerOnClickOutside);
}

function closePickerOnClickOutside(event) {
  var picker = document.getElementById('custom-color-picker');
  if (!picker.contains(event.target)) {
    closeColorPicker();
  }
}

function selectPresetColor(hexColor) {
  var hexInput = document.getElementById('picker-hex-input');
  hexInput.value = hexColor;
}

function applyPickerColor() {
  if (!currentColorType) return;
  
  var hexInput = document.getElementById('picker-hex-input');
  var hexValue = hexInput.value.trim().toUpperCase();
  
  // Add # if missing
  if (hexValue && hexValue[0] !== '#') {
    hexValue = '#' + hexValue;
  }
  
  // Validate hex format
  var hexPattern = /^#([A-Fa-f0-9]{6}|[A-Fa-f0-9]{3})$/;
  if (!hexPattern.test(hexValue)) {
    hexInput.style.borderColor = '#EF4444';
    return;
  }
  
  // Expand 3-char hex to 6-char
  if (hexValue.length === 4) {
    hexValue = '#' + hexValue[1] + hexValue[1] + hexValue[2] + hexValue[2] + hexValue[3] + hexValue[3];
  }
  
  console.log('🎨 Applying', currentColorType, 'color:', hexValue);
  
  // Update the swatch
  var swatch = document.getElementById('swatch-' + currentColorType);
  if (swatch) swatch.style.background = hexValue;
  
  // Update data attribute
  var specsBar = document.getElementById('design-specs-bar');
  if (specsBar) specsBar.dataset[currentColorType] = hexValue;
  
  // Save to plan
  var planEl = document.querySelector('.plan-visualization-enhanced');
  var planId = planEl ? planEl.dataset.planId : null;
  console.log('🎨 Plan ID for color update:', planId);
  
  if (planId && window.updatePlanDirectly) {
    var colorUpdate = {};
    colorUpdate[currentColorType] = hexValue;
    window.updatePlanDirectly(planId, { update_colors: colorUpdate });
  } else if (!planId) {
    console.warn('⚠️ No plan ID available for color update');
  } else {
    console.warn('⚠️ updatePlanDirectly not available yet');
  }
  
  closeColorPicker();
}

