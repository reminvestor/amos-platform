  // Generate component HTML based on design type
  function getComponentHtml(data) {
    var type = data.type || '';
    var variant = data.variant || type;
    var label = data.label || variant;
    var designType = container.dataset.designType || container.dataset.createType || 'landing_page';
    var isAppOrCanvas = (designType === 'app' || designType === 'canvas');
    
    // Debug logging
    console.log('🎯 getComponentHtml:', {
      type: type,
      designType: designType,
      isAppOrCanvas: isAppOrCanvas,
      datasetDesignType: container.dataset.designType,
      datasetCreateType: container.dataset.createType
    });
    
    // List of app/canvas component types (by component type, not category)
    var appComponentTypes = [
      // App Layout
      'app_header', 'app_sidebar', 'sidebar_nav', 'container', 'row', 'column', 'grid', 
      'tabs', 'accordion', 'modal_trigger', 'app_card',
      // Dashboard
      'kpi', 'metric', 'chart', 'line_chart', 'bar_chart', 'pie_chart', 'table', 
      'data_loop', 'conditional', 'data_field',
      // Forms
      'form', 'input', 'textarea', 'select', 'checkbox', 'radio', 'button', 'date_picker',
      // Data
      'data_source', 'data_model', 'api_call'
    ];
    
    // For app/canvas, check if this is an app component type
    var isAppComponent = appComponentTypes.indexOf(type) !== -1;
    console.log('🎯 Component check:', { type: type, isAppComponent: isAppComponent, willUseDashboard: isAppOrCanvas && isAppComponent });
    
    if (isAppOrCanvas && isAppComponent) {
      return getDashboardComponentHtml(type, label, data);
