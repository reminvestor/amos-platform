    '</div>';
    
    if (typeof lucide !== 'undefined') lucide.createIcons();
    setupDropZones();
    
    // Update toolbar title
    var titleEl = container.querySelector('.toolbar-title');
    if (titleEl) {
      titleEl.textContent = pageName;
    }
  }
  
  
  // Setup drop zones for drag and drop
  function setupDropZones() {
    var dropZones = container.querySelectorAll('.page-section-placeholder, #freeform-drop-zone, #sections-drop-zone');
    
    dropZones.forEach(function(zone) {
      zone.addEventListener('dragover', function(e) {
        e.preventDefault();
        this.classList.add('drag-over');
      });
      
      zone.addEventListener('dragleave', function(e) {
        this.classList.remove('drag-over');
      });
      
      zone.addEventListener('drop', function(e) {
        e.preventDefault();
        this.classList.remove('drag-over');
        
        try {
          var data = JSON.parse(e.dataTransfer.getData('application/json') || e.dataTransfer.getData('text/plain'));
          console.log('📦 Dropped component:', data);
          
          // Add component to this zone
          var componentHtml = getComponentHtml(data);
          if (this.classList.contains('page-section-placeholder')) {
            this.outerHTML = componentHtml;
          } else {
            this.insertAdjacentHTML('beforeend', componentHtml);
            // Remove drop hint if present
            var hint = this.querySelector('.drop-hint');
            if (hint) hint.remove();
          }
          
          if (typeof lucide !== 'undefined') lucide.createIcons();
        } catch (err) {
          console.error('Drop error:', err);
        }
      });
    });
  }
  
  // Build from plan button
  var buildBtn2 = container.querySelector('#build-from-plan-btn');
  var statusBanner = container.querySelector('#build-status-banner');
  
  if (buildBtn2) {
    buildBtn2.addEventListener('click', function() {
      // Show building state
      this.disabled = true;
      this.innerHTML = '<i data-lucide="loader-2" class="spin"></i> Building...';
      if (typeof lucide !== 'undefined') lucide.createIcons();
      
      try {
        handleBuildClick();
        
        // Show success (Amos will handle the actual building)
        if (statusBanner) {
          statusBanner.style.display = 'flex';
          statusBanner.className = 'build-status-banner';
          statusBanner.querySelector('.build-status-text').textContent = 'Building your landing page...';
          statusBanner.querySelector('.build-status-details').textContent = 'Amos is generating the HTML';
        }
        
        buildBtn2.classList.add('built');
        buildBtn2.innerHTML = '<i data-lucide="hammer"></i> Building...';
        
      } catch (error) {
        console.error('Build error:', error);
        if (statusBanner) {
          statusBanner.style.display = 'flex';
          statusBanner.className = 'build-status-banner error';
          statusBanner.querySelector('.build-status-text').textContent = 'Build failed';
          statusBanner.querySelector('.build-status-details').textContent = error.message;
        }
        buildBtn2.innerHTML = '<i data-lucide="hammer"></i> Build';
      }
      buildBtn2.disabled = false;
      if (typeof lucide !== 'undefined') lucide.createIcons();
    });
  }
  
  // Close build status banner
  var closeStatusBtn = container.querySelector('#close-build-status');
  if (closeStatusBtn && statusBanner) {
    closeStatusBtn.addEventListener('click', function() {
      statusBanner.style.display = 'none';
    });
  }
  
  // Section actions
  container.querySelectorAll('.section-action-btn').forEach(function(btn) {
    btn.addEventListener('click', function(e) {
      e.stopPropagation();
      var action = this.dataset.action;
      var section = this.closest('.preview-section');
      var sectionName = section ? section.dataset.section : null;
      
      if (action === 'remove' && section) {
        section.remove();
      } else if (action === 'edit' && sectionName) {
        var planId = container.dataset.planId;
        sendToAmos('Edit the ' + sectionName + ' section in the design plan');
      }
    });
  });
  
  // Viewport controls
  container.querySelectorAll('.viewport-btn').forEach(function(btn) {
    btn.addEventListener('click', function() {
      container.querySelectorAll('.viewport-btn').forEach(function(b) { b.classList.remove('active'); });
      this.classList.add('active');
      
      var viewport = this.dataset.viewport;
      var canvasEl = container.querySelector('.studio-canvas');
      if (canvasEl) {
        canvasEl.style.maxWidth = viewport === 'mobile' ? '375px' : 
                                   viewport === 'tablet' ? '768px' : '1200px';
      }
    });
  });
  
  // Page selection
  container.querySelectorAll('.page-item').forEach(function(item) {
    item.addEventListener('click', function() {
      var pageId = this.dataset.pageId;
      var pageSlug = this.dataset.pageSlug;
      
      container.querySelectorAll('.page-item').forEach(function(i) { i.classList.remove('active'); });
      this.classList.add('active');
      
      console.log('📄 Selected page:', pageId, pageSlug);
      
      // Ask Amos to load this page
      sendToAmos('Open page ' + (pageSlug || pageId) + ' in the editor');
    });
  });
  
  // Setup page tabs for existing pages
  setupPageTabs();
  setupAddPageTabButton();
  
  // Create first page button
  var createFirstPageBtn = container.querySelector('#create-first-page-btn');
  if (createFirstPageBtn) {
    createFirstPageBtn.addEventListener('click', function() {
      var websiteId = container.dataset.websiteId;
      sendToAmos('Create the homepage for website ' + websiteId);
    });
  }
  
  // Site settings button
  var siteSettingsBtn = container.querySelector('#site-settings-btn');
  if (siteSettingsBtn) {
    siteSettingsBtn.addEventListener('click', function() {
      var websiteId = container.dataset.websiteId;
      sendToAmos('Show site settings for website ' + websiteId);
    });
  }
  
  // Publish button
  var publishBtn2 = container.querySelector('#publish-btn');
  if (publishBtn2) {
    publishBtn2.addEventListener('click', function() {
      handlePublishClick();
      
      // Visual feedback
      this.classList.add('published');
      this.innerHTML = '<i data-lucide="check"></i> Publishing...';
      if (typeof lucide !== 'undefined') lucide.createIcons();
    });
  }
  
  // Init icons
  if (typeof lucide !== 'undefined') {
    lucide.createIcons();
  }
})();
</script>
