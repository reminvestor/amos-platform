function addNewSection(sectionType) {
  var planEl = document.querySelector('.plan-visualization-enhanced');
  var planId = planEl ? planEl.dataset.planId : null;
  var sectionsList = document.querySelector('.plan-sections-list');
  
  // Close panel first
  var existingPanel = document.querySelector('.add-section-panel');
  if (existingPanel) existingPanel.remove();
  
  if (sectionsList) {
    // Get current section count
    var existingCards = sectionsList.querySelectorAll('.plan-section-card');
    var newIdx = existingCards.length;
    
    // Create new section card locally with proper styling
    var newCard = document.createElement('div');
    newCard.className = 'plan-section-card';
    newCard.dataset.sectionIdx = newIdx;
    newCard.dataset.sectionType = sectionType;
    newCard.dataset.sectionName = sectionType;
    newCard.draggable = true;
    
    // Generate section HTML based on type
    var contentHtml = getSectionContentHtml(sectionType, newIdx);
    
    newCard.innerHTML = '<div class="section-card-header">' +
      '<div class="section-drag-handle"><i data-lucide="grip-vertical" style="width: 14px; height: 14px;"></i></div>' +
      '<span class="section-number">' + (newIdx + 1) + '</span>' +
      '<span class="section-type-label">' + sectionType.charAt(0).toUpperCase() + sectionType.slice(1) + '</span>' +
      '<div class="section-card-actions">' +
        '<button class="btn-section-action" onclick="removeSection(' + newIdx + ')" title="Remove section">' +
          '<i data-lucide="trash-2" style="width: 12px; height: 12px;"></i></button>' +
      '</div>' +
    '</div>' +
    '<div class="section-content-body">' + contentHtml + '</div>';
    
    // Insert before the add section area
    var addArea = document.querySelector('.add-section-area');
    if (addArea) {
      sectionsList.insertBefore(newCard, addArea);
    } else {
      sectionsList.appendChild(newCard);
    }
    
    // Initialize lucide icons
    if (typeof lucide !== 'undefined') lucide.createIcons();
    
    // Scroll to the new section
    newCard.scrollIntoView({ behavior: 'smooth', block: 'center' });
    
    // Flash highlight
    newCard.style.boxShadow = '0 0 20px rgba(99, 102, 241, 0.5)';
    setTimeout(function() { newCard.style.boxShadow = ''; }, 1500);
  }
  
  // Persist directly (no chat message)
  if (planId) {
    updatePlanDirectly(planId, {
      add_section: { type: sectionType, name: sectionType, background: 'light', content: {} }
    });
  }
}

