  function setupAppModeSwitcher() {
    var modeSwitcher = container.querySelector('#app-mode-switcher');
    if (!modeSwitcher) return;
    
    var modeTabs = modeSwitcher.querySelectorAll('.app-mode-tab');
    var modeHint = modeSwitcher.querySelector('#app-mode-hint');
    var pagesTabBar = container.querySelector('#pages-tab-bar');
    
    var modeHints = {
      'pages': 'Design external-facing pages for your app',
      'canvases': 'Build internal dashboards and data displays',
      'data': 'Define data models and connect data sources',
      'workflows': 'Create automations and business logic'
    };
    
    modeTabs.forEach(function(tab) {
      tab.addEventListener('click', function() {
        var mode = this.dataset.mode;
        console.log('🔄 Switching app mode to:', mode);
        
        // Update active tab
        modeTabs.forEach(function(t) { t.classList.remove('active'); });
        this.classList.add('active');
        
        // Update hint
        if (modeHint) {
          modeHint.textContent = modeHints[mode] || '';
        }
        
        // Update component visibility based on mode
        if (mode === 'pages') {
          // Pages mode: Show landing page components
          container.dataset.appMode = 'pages';
          container.dataset.designType = 'website';
          container.dataset.isAppOrCanvas = 'false';
          if (pagesTabBar) pagesTabBar.style.display = 'flex';
        } else if (mode === 'canvases') {
          // Canvases mode: Show dashboard components
          container.dataset.appMode = 'canvases';
          container.dataset.designType = 'canvas';
          container.dataset.isAppOrCanvas = 'true';
          if (pagesTabBar) pagesTabBar.style.display = 'flex';
        } else if (mode === 'data') {
          // Data mode: Show data model and source components only
          container.dataset.appMode = 'data';
          container.dataset.designType = 'app';
          container.dataset.isAppOrCanvas = 'true';
          if (pagesTabBar) pagesTabBar.style.display = 'none';
        } else if (mode === 'workflows') {
          // Workflows mode: Load the workflow designer canvas
          container.dataset.appMode = 'workflows';
          if (pagesTabBar) pagesTabBar.style.display = 'none';
          
          // Load workflow designer via scout controller
