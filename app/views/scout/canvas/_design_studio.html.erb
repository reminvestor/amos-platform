<%# App Designer Canvas - Unified Page Builder %>
<%# Supports: Landing Pages, Multi-page Websites, Amos Canvases %>
<%# Once built, content is in edit mode %>

<% data = canvas_data || {} %>
<% plan = data[:plan] || data['plan'] %>
<% plan_id = data[:plan_id] || data['plan_id'] %>
<% website = data[:website] || data['website'] %>
<% website_id = data[:website_id] || data['website_id'] %>
<% pages = data[:pages] || data['pages'] || [] %>
<% current_page = data[:current_page] || data['current_page'] %>
<% landing_page = data[:landing_page] || data['landing_page'] %>
<% landing_page_id = data[:landing_page_id] || data['landing_page_id'] %>
<% is_website = website_id.present? || pages.any? %>

<% has_plan = plan.present? || plan_id.present? %>
<% is_built = landing_page_id.present? || website_id.present? %>
<div class="design-studio-canvas" id="design-studio-<%= SecureRandom.hex(4) %>"
     data-plan-id="<%= plan_id %>"
     data-website-id="<%= website_id %>"
     data-landing-page-id="<%= landing_page_id %>"
     data-is-website="<%= is_website %>"
     data-has-plan="<%= has_plan %>"
     data-is-built="<%= is_built %>">
  <div class="studio-layout">
    <%# Pages sidebar removed - now using tabs above canvas %>
    
    <!-- Component Sidebar -->
    <div class="studio-component-sidebar" id="studio-component-sidebar">
      <div class="component-sidebar-header">
        <h6><i data-lucide="component" style="width: 14px; height: 14px;" class="me-2"></i>Components</h6>
      </div>
      
      <div class="component-search">
        <input type="text" placeholder="Search components..." id="component-search" class="search-input">
        <i data-lucide="search" class="search-icon" style="width: 14px; height: 14px;"></i>
      </div>
      
      <div class="component-categories">
        <!-- Layout -->
        <div class="component-category">
          <div class="category-header" data-toggle="collapse" data-target="layout">
            <i data-lucide="layout-grid" style="width: 14px; height: 14px;"></i>
            <span>Layout</span>
            <i data-lucide="chevron-down" class="category-chevron" style="width: 12px; height: 12px;"></i>
          </div>
          <div class="category-items show" id="category-layout">
            <div class="studio-component" draggable="true" data-component-type="section" data-variant="hero">
              <div class="component-preview"><i data-lucide="rectangle-horizontal" style="width: 18px; height: 18px;"></i></div>
              <span>Hero Section</span>
            </div>
            <div class="studio-component" draggable="true" data-component-type="section" data-variant="two-column">
              <div class="component-preview"><i data-lucide="columns" style="width: 18px; height: 18px;"></i></div>
              <span>Two Column</span>
            </div>
            <div class="studio-component" draggable="true" data-component-type="section" data-variant="three-column">
              <div class="component-preview"><i data-lucide="layout-grid" style="width: 18px; height: 18px;"></i></div>
              <span>Three Column</span>
            </div>
            <div class="studio-component" draggable="true" data-component-type="section" data-variant="features">
              <div class="component-preview"><i data-lucide="grid-3x3" style="width: 18px; height: 18px;"></i></div>
              <span>Features</span>
            </div>
            <div class="studio-component" draggable="true" data-component-type="section" data-variant="testimonials">
              <div class="component-preview"><i data-lucide="quote" style="width: 18px; height: 18px;"></i></div>
              <span>Testimonials</span>
            </div>
            <div class="studio-component" draggable="true" data-component-type="section" data-variant="pricing">
              <div class="component-preview"><i data-lucide="credit-card" style="width: 18px; height: 18px;"></i></div>
              <span>Pricing</span>
            </div>
            <div class="studio-component" draggable="true" data-component-type="section" data-variant="cta">
              <div class="component-preview"><i data-lucide="megaphone" style="width: 18px; height: 18px;"></i></div>
              <span>CTA Banner</span>
            </div>
          </div>
        </div>
        
        <!-- Typography -->
        <div class="component-category">
          <div class="category-header" data-toggle="collapse" data-target="typography">
            <i data-lucide="type" style="width: 14px; height: 14px;"></i>
            <span>Typography</span>
            <i data-lucide="chevron-down" class="category-chevron" style="width: 12px; height: 12px;"></i>
          </div>
          <div class="category-items" id="category-typography">
            <div class="studio-component" draggable="true" data-component-type="heading" data-variant="h1">
              <div class="component-preview"><i data-lucide="heading-1" style="width: 18px; height: 18px;"></i></div>
              <span>Heading 1</span>
            </div>
            <div class="studio-component" draggable="true" data-component-type="heading" data-variant="h2">
              <div class="component-preview"><i data-lucide="heading-2" style="width: 18px; height: 18px;"></i></div>
              <span>Heading 2</span>
            </div>
            <div class="studio-component" draggable="true" data-component-type="paragraph" data-variant="default">
              <div class="component-preview"><i data-lucide="text" style="width: 18px; height: 18px;"></i></div>
              <span>Paragraph</span>
            </div>
            <div class="studio-component" draggable="true" data-component-type="list" data-variant="bullet">
              <div class="component-preview"><i data-lucide="list" style="width: 18px; height: 18px;"></i></div>
              <span>Bullet List</span>
            </div>
          </div>
        </div>
        
        <!-- Media -->
        <div class="component-category">
          <div class="category-header" data-toggle="collapse" data-target="media">
            <i data-lucide="image" style="width: 14px; height: 14px;"></i>
            <span>Media</span>
            <i data-lucide="chevron-down" class="category-chevron" style="width: 12px; height: 12px;"></i>
          </div>
          <div class="category-items" id="category-media">
            <div class="studio-component" draggable="true" data-component-type="image" data-variant="default">
              <div class="component-preview"><i data-lucide="image" style="width: 18px; height: 18px;"></i></div>
              <span>Image</span>
            </div>
            <div class="studio-component" draggable="true" data-component-type="video" data-variant="embed">
              <div class="component-preview"><i data-lucide="video" style="width: 18px; height: 18px;"></i></div>
              <span>Video</span>
            </div>
            <div class="studio-component" draggable="true" data-component-type="gallery" data-variant="grid">
              <div class="component-preview"><i data-lucide="grid-3x3" style="width: 18px; height: 18px;"></i></div>
              <span>Gallery</span>
            </div>
          </div>
        </div>
        
        <!-- Forms -->
        <div class="component-category">
          <div class="category-header" data-toggle="collapse" data-target="forms">
            <i data-lucide="text-cursor-input" style="width: 14px; height: 14px;"></i>
            <span>Forms</span>
            <i data-lucide="chevron-down" class="category-chevron" style="width: 12px; height: 12px;"></i>
          </div>
          <div class="category-items" id="category-forms">
            <div class="studio-component" draggable="true" data-component-type="form" data-variant="contact">
              <div class="component-preview"><i data-lucide="file-text" style="width: 18px; height: 18px;"></i></div>
              <span>Contact Form</span>
            </div>
            <div class="studio-component" draggable="true" data-component-type="form" data-variant="newsletter">
              <div class="component-preview"><i data-lucide="mail" style="width: 18px; height: 18px;"></i></div>
              <span>Newsletter</span>
            </div>
            <div class="studio-component" draggable="true" data-component-type="input" data-variant="text">
              <div class="component-preview"><i data-lucide="text-cursor" style="width: 18px; height: 18px;"></i></div>
              <span>Text Input</span>
            </div>
            <div class="studio-component" draggable="true" data-component-type="button" data-variant="primary">
              <div class="component-preview"><i data-lucide="rectangle-horizontal" style="width: 18px; height: 18px;"></i></div>
              <span>Button</span>
            </div>
          </div>
        </div>
        
        <!-- Cards -->
        <div class="component-category">
          <div class="category-header" data-toggle="collapse" data-target="cards">
            <i data-lucide="credit-card" style="width: 14px; height: 14px;"></i>
            <span>Cards</span>
            <i data-lucide="chevron-down" class="category-chevron" style="width: 12px; height: 12px;"></i>
          </div>
          <div class="category-items" id="category-cards">
            <div class="studio-component" draggable="true" data-component-type="card" data-variant="feature">
              <div class="component-preview"><i data-lucide="sparkles" style="width: 18px; height: 18px;"></i></div>
              <span>Feature Card</span>
            </div>
            <div class="studio-component" draggable="true" data-component-type="card" data-variant="pricing">
              <div class="component-preview"><i data-lucide="tag" style="width: 18px; height: 18px;"></i></div>
              <span>Pricing Card</span>
            </div>
            <div class="studio-component" draggable="true" data-component-type="card" data-variant="testimonial">
              <div class="component-preview"><i data-lucide="quote" style="width: 18px; height: 18px;"></i></div>
              <span>Testimonial</span>
            </div>
            <div class="studio-component" draggable="true" data-component-type="card" data-variant="team">
              <div class="component-preview"><i data-lucide="user" style="width: 18px; height: 18px;"></i></div>
              <span>Team Member</span>
            </div>
          </div>
        </div>
        
        <!-- Navigation -->
        <div class="component-category">
          <div class="category-header" data-toggle="collapse" data-target="navigation">
            <i data-lucide="navigation" style="width: 14px; height: 14px;"></i>
            <span>Navigation</span>
            <i data-lucide="chevron-down" class="category-chevron" style="width: 12px; height: 12px;"></i>
          </div>
          <div class="category-items" id="category-navigation">
            <div class="studio-component" draggable="true" data-component-type="navbar" data-variant="default">
              <div class="component-preview"><i data-lucide="navigation" style="width: 18px; height: 18px;"></i></div>
              <span>Navbar</span>
            </div>
            <div class="studio-component" draggable="true" data-component-type="footer" data-variant="default">
              <div class="component-preview"><i data-lucide="panel-bottom" style="width: 18px; height: 18px;"></i></div>
              <span>Footer</span>
            </div>
          </div>
        </div>
      </div>
    </div>
    
    <!-- Main Canvas Area -->
    <div class="studio-main-area">
      <!-- Toolbar -->
      <div class="studio-toolbar">
        <div class="toolbar-left">
          <span class="toolbar-title"><%= plan ? (plan['name'] || 'New Design') : 'Untitled Design' %></span>
        </div>
        <div class="toolbar-center">
          <div class="viewport-controls">
            <button class="viewport-btn active" data-viewport="desktop" title="Desktop">
              <i data-lucide="monitor" style="width: 16px; height: 16px;"></i>
            </button>
            <button class="viewport-btn" data-viewport="tablet" title="Tablet">
              <i data-lucide="tablet" style="width: 16px; height: 16px;"></i>
            </button>
            <button class="viewport-btn" data-viewport="mobile" title="Mobile">
              <i data-lucide="smartphone" style="width: 16px; height: 16px;"></i>
            </button>
          </div>
        </div>
        <div class="toolbar-right">
          <%# Build: Only show when plan exists but not yet built %>
          <% has_plan = plan.present? %>
          <% is_built = landing_page_id.present? || website_id.present? %>
          
          <% if has_plan && !is_built %>
          <button class="btn-build" id="build-from-plan-btn" title="Build this design into a page">
            <i data-lucide="hammer" style="width: 14px; height: 14px;"></i>
            Build
          </button>
          <% end %>
          
          <%# Preview & Publish: Only show when something is built %>
          <% if is_built %>
          <button class="btn btn-sm btn-outline-secondary" id="preview-btn">
            <i data-lucide="eye" style="width: 14px; height: 14px;" class="me-1"></i>
            Preview
          </button>
          <button class="btn-publish" id="publish-btn" title="Publish this page/site">
            <i data-lucide="globe" style="width: 14px; height: 14px;"></i>
            Publish
          </button>
          <% end %>
        </div>
      </div>
      
      <!-- Pages Tab Bar (for multi-page sites/apps/canvases) -->
      <div class="pages-tab-bar" id="pages-tab-bar" style="display: none;">
        <div class="pages-tabs" id="pages-tabs">
          <% pages.each do |page| %>
          <div class="page-tab <%= current_page&.dig('id') == page['id'] ? 'active' : '' %>" 
               data-page-id="<%= page['id'] %>" 
               data-page-slug="<%= page['slug'] %>">
            <i data-lucide="<%= page['is_homepage'] ? 'home' : 'file' %>" style="width: 12px; height: 12px;"></i>
            <span class="page-tab-name"><%= page['name'] || page['title'] %></span>
            <button class="page-tab-close" title="Close page"><i data-lucide="x" style="width: 10px; height: 10px;"></i></button>
          </div>
          <% end %>
        </div>
        <button class="add-page-tab-btn" id="add-page-tab-btn" title="Add new page">
          <i data-lucide="plus" style="width: 14px; height: 14px;"></i>
        </button>
      </div>
      
      <!-- Build Status Banner -->
      <div class="build-status-banner" id="build-status-banner" style="display: none;">
        <div class="build-status-content">
          <span class="build-status-icon"><i data-lucide="check-circle"></i></span>
          <span class="build-status-text">Design built successfully</span>
          <span class="build-status-details"></span>
        </div>
        <button type="button" class="build-status-close" id="close-build-status">
          <i data-lucide="x"></i>
        </button>
      </div>
      
      <!-- Canvas -->
      <div class="studio-canvas-wrapper">
        <div class="studio-canvas" id="studio-canvas">
          <% if plan && plan['sections']&.any? %>
            <!-- Show plan visualization -->
            <div class="plan-visualization" 
                 style="--primary-color: <%= plan.dig('color_scheme', 'primary') || '#6366f1' %>; 
                        --accent-color: <%= plan.dig('color_scheme', 'accent') || '#f59e0b' %>;">
              <% plan['sections'].each do |section| %>
              <div class="preview-section section-<%= section['type'] %>" draggable="true" data-section="<%= section['name'] %>">
                <div class="section-label"><%= section['name'].to_s.titleize %></div>
                <div class="section-content">
                  <span class="section-type-badge"><%= section['type'] %></span>
                  <p class="section-hint"><%= section['content_ideas'] %></p>
                </div>
                <div class="section-actions">
                  <button class="section-action-btn" data-action="edit" title="Edit"><i data-lucide="pencil" style="width: 12px;"></i></button>
                  <button class="section-action-btn" data-action="remove" title="Remove"><i data-lucide="trash-2" style="width: 12px;"></i></button>
                </div>
              </div>
              <% end %>
            </div>
          <% else %>
            <!-- Empty state - What do you want to create? -->
          <div class="canvas-empty-state">
            <div class="empty-header">
              <h4>What would you like to create?</h4>
              <p>Choose a starting point or describe your idea to Amos</p>
            </div>
            
            <div class="creation-options">
              <!-- Single Page / Landing Page -->
              <div class="creation-card" data-type="landing_page">
                <div class="creation-icon" style="background: linear-gradient(135deg, #6366f1 0%, #818cf8 100%);">
                  <i data-lucide="file-text" style="width: 32px; height: 32px;"></i>
            </div>
                <h5>Landing Page</h5>
                <p>Single-page site for marketing, lead capture, or product promotion</p>
                <div class="creation-examples">
                  <span>Lead gen</span>
                  <span>Product launch</span>
                  <span>Event signup</span>
          </div>
        </div>
              
              <!-- Multi-Page Website -->
              <div class="creation-card" data-type="website">
                <div class="creation-icon" style="background: linear-gradient(135deg, #06b6d4 0%, #0891b2 100%);">
                  <i data-lucide="layout-template" style="width: 32px; height: 32px;"></i>
      </div>
                <h5>Website</h5>
                <p>Multi-page site with navigation, shared header/footer, and consistent branding</p>
                <div class="creation-examples">
                  <span>Business site</span>
                  <span>Portfolio</span>
                  <span>Blog</span>
                </div>
              </div>
              
              <!-- App -->
              <div class="creation-card" data-type="app">
                <div class="creation-icon" style="background: linear-gradient(135deg, #10b981 0%, #059669 100%);">
                  <i data-lucide="layers" style="width: 32px; height: 32px;"></i>
                </div>
                <h5>App</h5>
                <p>Full application with pages, interactive canvases, and automated workflows</p>
                <div class="creation-examples">
                  <span>CRM</span>
                  <span>Portal</span>
                  <span>SaaS tool</span>
                </div>
              </div>
              
              <!-- Custom Canvas -->
              <div class="creation-card" data-type="canvas">
                <div class="creation-icon" style="background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);">
                  <i data-lucide="frame" style="width: 32px; height: 32px;"></i>
                </div>
                <h5>Amos Canvas</h5>
                <p>Interactive canvas for dashboards, data displays, or custom tools that work with Amos</p>
                <div class="creation-examples">
                  <span>Dashboard</span>
                  <span>Data viewer</span>
                  <span>Custom UI</span>
                </div>
              </div>
            </div>
            
            <div class="ai-prompt-hint">
              <i data-lucide="sparkles" style="width: 16px; height: 16px;"></i>
              <span>Or just tell Amos what you need: <em>"Create a landing page for my law firm"</em></span>
            </div>
          </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .design-studio-canvas {
    height: 100%;
    display: flex;
    flex-direction: column;
    background: #0f0f1a;
    color: #e0e0e0;
  }
  
  .studio-layout {
    display: flex;
    flex: 1;
    height: 100%;
    overflow: hidden;
  }
  
  /* Component Sidebar */
  .studio-component-sidebar {
    width: 260px;
    min-width: 260px;
    background: #1a1a2e;
    border-right: 1px solid #2d2d44;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    transition: width 0.2s ease, min-width 0.2s ease;
  }
  
  .component-sidebar-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 14px 16px;
    border-bottom: 1px solid #2d2d44;
    background: #16162a;
  }
  
  .component-sidebar-header h6 {
    margin: 0;
    color: #e0e0e0;
    font-size: 0.875rem;
    font-weight: 600;
    display: flex;
    align-items: center;
  }
  
  .component-search {
    position: relative;
    padding: 12px;
    border-bottom: 1px solid #2d2d44;
  }
  
  .component-search .search-input {
    width: 100%;
    padding: 8px 12px 8px 32px;
    border: 1px solid #2d2d44;
    border-radius: 6px;
    background: #0f0f1a;
    color: #e0e0e0;
    font-size: 0.8rem;
  }
  
  .component-search .search-input::placeholder { color: #6b6b8a; }
  
  .component-search .search-icon {
    position: absolute;
    left: 22px;
    top: 50%;
    transform: translateY(-50%);
    color: #6b6b8a;
  }
  
  .component-categories {
    flex: 1;
    overflow-y: auto;
    padding: 8px;
  }
  
  .component-category { margin-bottom: 4px; }
  
  .category-header {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 10px 12px;
    color: #8f8faa;
    cursor: pointer;
    border-radius: 6px;
    transition: all 0.2s;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }
  
  .category-header:hover {
    background: rgba(255,255,255,0.03);
    color: #e0e0e0;
  }
  
  .category-header .category-chevron {
    margin-left: auto;
    transition: transform 0.2s;
  }
  
  .category-items { display: none; padding: 4px 0 8px 0; }
  .category-items.show { display: block; }
  
  .studio-component {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 12px;
    margin: 2px 0;
    background: #1e1e36;
    border: 1px solid #2d2d44;
    border-radius: 8px;
    color: #c0c0d0;
    font-size: 0.8rem;
    cursor: grab;
    transition: all 0.15s ease;
  }
  
  .studio-component:hover {
    background: #252545;
    border-color: #6366f1;
    color: #fff;
    transform: translateX(3px);
  }
  
  .studio-component:active { cursor: grabbing; }
  
  .studio-component .component-preview {
    width: 32px;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(99, 102, 241, 0.15);
    border-radius: 6px;
    color: #818cf8;
  }
  
  .studio-component:hover .component-preview {
    background: rgba(99, 102, 241, 0.25);
    color: #a5b4fc;
  }
  
  /* Main Canvas Area */
  .studio-main-area {
    flex: 1;
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }
  
  .studio-toolbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 10px 16px;
    background: #16162a;
    border-bottom: 1px solid #2d2d44;
  }
  
  .toolbar-title {
    font-weight: 500;
    color: #c0c0d0;
  }
  
  .plan-badge {
    font-size: 0.65rem;
    padding: 2px 8px;
    background: rgba(16, 185, 129, 0.2);
    color: #34d399;
    border-radius: 4px;
    margin-left: 10px;
  }
  
  .viewport-controls {
    display: flex;
    gap: 4px;
    background: #0f0f1a;
    padding: 4px;
    border-radius: 6px;
  }
  
  .viewport-btn {
    padding: 6px 10px;
    border: none;
    background: transparent;
    color: #6b6b8a;
    border-radius: 4px;
    cursor: pointer;
    transition: all 0.2s;
  }
  
  .viewport-btn:hover { color: #c0c0d0; }
  .viewport-btn.active { background: #6366f1; color: white; }
  
  .toolbar-right { display: flex; gap: 8px; align-items: center; }
  .toolbar-right .btn { font-size: 0.8rem; }
  
  /* Build Button */
  .btn-build {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 6px 12px;
    border: none;
    border-radius: 6px;
    font-size: 0.8rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.15s;
    background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);
    color: white;
  }
  
  .btn-build:hover { filter: brightness(1.1); }
  .btn-build:disabled { opacity: 0.5; cursor: not-allowed; }
