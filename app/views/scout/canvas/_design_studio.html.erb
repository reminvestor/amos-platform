        '<button class="section-action-btn" data-action="remove" title="Remove"><i data-lucide="trash-2" style="width: 12px;"></i></button>' +
      '</div>' +
    '</div>';
  }
  
  // Generate dashboard-specific component HTML
  function getDashboardComponentHtml(variant, label, data) {
    var icons = {
      'kpi': 'hash', 'metric': 'trending-up', 'chart': 'bar-chart-3', 'line_chart': 'line-chart',
      'pie_chart': 'pie-chart', 'bar_chart': 'bar-chart-3', 'table': 'table', 'data_loop': 'repeat',
      'conditional': 'git-branch', 'data_field': 'text-cursor', 'form': 'file-input',
      'input': 'text-cursor-input', 'button': 'mouse-pointer-click', 'select': 'list',
      'app_header': 'panel-top', 'app_sidebar': 'panel-left', 'container': 'square',
      'row': 'rows', 'column': 'columns', 'grid': 'grid-3x3', 'tabs': 'folder-tree',
      'accordion': 'chevrons-down', 'modal_trigger': 'maximize-2', 'app_card': 'credit-card'
    };
    var icon = icons[variant] || 'component';
    
    // Get grid position from data or use defaults
    var gridCol = data.gridCol || '';
    var gridRow = data.gridRow || '';
    var gridStyle = '';
    if (gridCol) gridStyle += 'grid-column: ' + gridCol + ';';
    if (gridRow) gridStyle += 'grid-row: ' + gridRow + ';';
    
    return '<div class="dashboard-component grid-item component-' + variant + '" ' +
      'draggable="true" ' +
      'data-component-type="' + variant + '" ' +
      'data-grid-col="' + (gridCol || 'auto') + '" ' +
      'data-grid-row="' + (gridRow || 'auto') + '" ' +
      (gridStyle ? 'style="' + gridStyle + '"' : '') + '>' +
      '<div class="component-header">' +
        '<i data-lucide="' + icon + '" style="width: 16px; height: 16px;"></i>' +
        '<span class="component-label">' + label + '</span>' +
      '</div>' +
      '<div class="component-body">' +
        '<div class="component-placeholder">' +
          '<span class="component-config-hint">Click to configure</span>' +
        '</div>' +
      '</div>' +
      '<div class="component-actions">' +
        '<button class="component-action-btn" data-action="configure" title="Configure"><i data-lucide="settings" style="width: 12px;"></i></button>' +
        '<button class="component-action-btn" data-action="remove" title="Remove"><i data-lucide="trash-2" style="width: 12px;"></i></button>' +
      '</div>' +
      '<div class="resize-handle" title="Drag to resize"></div>' +
    '</div>';
  }
  
  // Auto-save design after component changes
  function autoSaveDesign() {
    var planId = container.dataset.planId;
    if (!planId) {
      console.log('📝 No plan ID - creating new plan...');
      createNewPlan();
      return;
    }
    
    // Collect current components
    var components = collectCanvasComponents();
    console.log('💾 Auto-saving design with', components.length, 'components');
    
    // Send to server via AJAX
    fetch('/scout/save_design', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]')?.content
      },
      body: JSON.stringify({
        plan_id: planId,
        sections: components
      })
    }).then(function(response) {
      return response.json();
    }).then(function(data) {
      if (data.success) {
        console.log('✅ Design auto-saved');
        showSaveIndicator('saved');
      } else {
        console.error('❌ Save failed:', data.error);
        showSaveIndicator('error');
      }
    }).catch(function(err) {
      console.error('❌ Save error:', err);
      showSaveIndicator('error');
    });
  }
  
  // Create a new plan when user starts designing
  function createNewPlan() {
    var designType = container.dataset.createType || container.dataset.designType || 'landing_page';
    var components = collectCanvasComponents();
    
    fetch('/scout/create_design_plan', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]')?.content
      },
      body: JSON.stringify({
        design_type: designType,
        name: 'New ' + (designType === 'landing_page' ? 'Landing Page' : designType.charAt(0).toUpperCase() + designType.slice(1)),
        sections: components
      })
    }).then(function(response) {
      return response.json();
    }).then(function(data) {
      if (data.success && data.plan_id) {
        console.log('✅ New plan created:', data.plan_id);
        container.dataset.planId = data.plan_id;
        
        // Persist to localStorage for refresh survival
        persistPlanToStorage(data.plan_id, container.dataset.designType || 'canvas');
        
        showSaveIndicator('saved');
      } else {
        console.error('❌ Plan creation failed:', data.error);
      }
    }).catch(function(err) {
      console.error('❌ Plan creation error:', err);
    });
  }
  
  // Persist plan info to localStorage for refresh survival
  function persistPlanToStorage(planId, designType) {
    try {
      var key = 'amos_current_plan';
      var data = {
        plan_id: planId,
        design_type: designType,
        timestamp: Date.now()
      };
      localStorage.setItem(key, JSON.stringify(data));
      console.log('💾 Plan persisted to storage:', data);
    } catch(e) {
      console.warn('Could not persist plan to storage:', e);
    }
  }
  
  // Check for saved plan on load
  function checkSavedPlan() {
    if (container.dataset.planId) {
      console.log('📌 Plan already loaded from server:', container.dataset.planId);
      return;
    }
    
    try {
      var saved = localStorage.getItem('amos_current_plan');
      if (saved) {
        var data = JSON.parse(saved);
        // Only restore if recent (within 24 hours)
        var maxAge = 24 * 60 * 60 * 1000;
        if (Date.now() - data.timestamp < maxAge) {
          console.log('🔄 Restoring plan from storage:', data);
          // Reload the canvas with the saved plan
          if (window.loadCanvasViaAjax) {
            window.loadCanvasViaAjax('design_studio', { plan_id: data.plan_id });
          }
        } else {
          // Clear old data
          localStorage.removeItem('amos_current_plan');
        }
      }
    } catch(e) {
      console.warn('Could not check saved plan:', e);
    }
  }
  
  // Collect components from the canvas
  function collectCanvasComponents() {
    var components = [];
    var canvasEl = container.querySelector('#studio-canvas');
    if (!canvasEl) return components;
    
    // Collect dashboard components with grid positions
    canvasEl.querySelectorAll('.dashboard-component').forEach(function(comp, idx) {
      components.push({
        type: comp.dataset.componentType || comp.dataset.component || 'unknown',
        label: comp.querySelector('.component-label')?.textContent || '',
        title: comp.dataset.title || '',
        value: comp.dataset.value || '',
        gridCol: comp.dataset.gridCol || comp.style.gridColumn || '',
        gridRow: comp.dataset.gridRow || comp.style.gridRow || '',
        order: idx,
        config: {
          title: comp.dataset.title,
          value: comp.dataset.value,
          dataSource: comp.dataset.dataSource
        }
      });
    });
    
    // Collect preview sections (landing page mode)
    canvasEl.querySelectorAll('.preview-section').forEach(function(section, idx) {
      components.push({
        type: section.dataset.section || 'unknown',
        name: section.querySelector('.section-label')?.textContent || '',
        order: idx,
        config: {}
      });
    });
    
    return components;
  }
  
  // Show save indicator
  function showSaveIndicator(status) {
    var indicator = container.querySelector('.save-indicator');
    if (!indicator) {
      indicator = document.createElement('div');
      indicator.className = 'save-indicator';
      var toolbar = container.querySelector('.studio-toolbar');
      if (toolbar) toolbar.appendChild(indicator);
    }
    
    if (status === 'saved') {
      indicator.innerHTML = '<i data-lucide="check-circle" style="width: 14px; height: 14px;"></i> Saved';
      indicator.classList.remove('error');
      indicator.classList.add('success');
    } else if (status === 'error') {
      indicator.innerHTML = '<i data-lucide="alert-circle" style="width: 14px; height: 14px;"></i> Save failed';
      indicator.classList.remove('success');
      indicator.classList.add('error');
    } else {
      indicator.innerHTML = '<i data-lucide="loader" style="width: 14px; height: 14px;" class="spin"></i> Saving...';
      indicator.classList.remove('success', 'error');
    }
    
    if (typeof lucide !== 'undefined') lucide.createIcons();
    
    // Hide after 2 seconds
    setTimeout(function() {
      indicator.classList.add('fade-out');
    }, 2000);
  }
  
