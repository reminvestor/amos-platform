              </div>
              <div class="studio-component" draggable="true" data-component-type="row" data-variant="default">
                <div class="component-preview"><i data-lucide="rectangle-horizontal" style="width: 18px; height: 18px;"></i></div>
                <span>Row</span>
              </div>
              <div class="studio-component" draggable="true" data-component-type="column" data-variant="default">
                <div class="component-preview"><i data-lucide="rectangle-vertical" style="width: 18px; height: 18px;"></i></div>
                <span>Column</span>
              </div>
              <div class="studio-component" draggable="true" data-component-type="grid" data-variant="default">
                <div class="component-preview"><i data-lucide="grid-2x2" style="width: 18px; height: 18px;"></i></div>
                <span>Grid</span>
              </div>
            </div>
            <div class="component-group">
              <div class="component-group-label">UI Elements</div>
              <div class="studio-component" draggable="true" data-component-type="tabs" data-variant="default">
                <div class="component-preview"><i data-lucide="layout-template" style="width: 18px; height: 18px;"></i></div>
                <span>Tabs</span>
              </div>
              <div class="studio-component" draggable="true" data-component-type="accordion" data-variant="default">
                <div class="component-preview"><i data-lucide="chevrons-down-up" style="width: 18px; height: 18px;"></i></div>
                <span>Accordion</span>
              </div>
              <div class="studio-component" draggable="true" data-component-type="modal_trigger" data-variant="default">
                <div class="component-preview"><i data-lucide="app-window" style="width: 18px; height: 18px;"></i></div>
                <span>Modal Trigger</span>
              </div>
              <div class="studio-component" draggable="true" data-component-type="app_card" data-variant="default">
                <div class="component-preview"><i data-lucide="credit-card" style="width: 18px; height: 18px;"></i></div>
                <span>App Card</span>
              </div>
            </div>
          </div>
        </div>
        
        <!-- Dashboard (for apps/canvases) -->
        <div class="component-category" id="dashboard-components" style="<%= is_app_or_canvas ? '' : 'display: none;' %>">
          <div class="category-header" data-toggle="collapse" data-target="dashboard">
            <i data-lucide="bar-chart-3" style="width: 14px; height: 14px;"></i>
            <span>Dashboard</span>
            <i data-lucide="chevron-down" class="category-chevron" style="width: 12px; height: 12px;"></i>
          </div>
          <div class="category-items show" id="category-dashboard">
            <!-- KPIs & Metrics -->
            <div class="component-group">
              <div class="component-group-label">Metrics</div>
              <div class="studio-component" draggable="true" data-component-type="kpi" data-variant="simple" data-requires-data="true">
                <div class="component-preview"><i data-lucide="hash" style="width: 18px; height: 18px;"></i></div>
                <span>KPI Card</span>
              </div>
              <div class="studio-component" draggable="true" data-component-type="metric_card" data-variant="comparison" data-requires-data="true">
                <div class="component-preview"><i data-lucide="trending-up" style="width: 18px; height: 18px;"></i></div>
                <span>Metric + Trend</span>
              </div>
              <div class="studio-component" draggable="true" data-component-type="stat_grid" data-variant="4-col" data-requires-data="true">
                <div class="component-preview"><i data-lucide="layout-grid" style="width: 18px; height: 18px;"></i></div>
