<%# My Creations Canvas - Unified view of all projects and assets %>
<%# Shows landing pages, websites, apps, workflows with filtering %>

<% 
  data = canvas_data || {}
  
  # Get all creations
  landing_pages = entity.landing_pages.order(updated_at: :desc)
  app_modules = entity.app_modules.order(updated_at: :desc) rescue []
  workflows = entity.workflows.order(updated_at: :desc) rescue []
  
  # Current filter
  filter_type = data[:type] || 'all'
  filter_status = data[:status] || 'all'
%>

<div class="my-creations-canvas" id="my-creations-<%= SecureRandom.hex(4) %>">
  <!-- Header -->
  <div class="creations-header">
    <div class="header-left">
      <i data-lucide="folder-open" class="header-icon"></i>
      <div>
        <h4 class="header-title">Created Assets</h4>
        <p class="header-subtitle">All your landing pages, websites, apps & workflows</p>
      </div>
    </div>
    <div class="header-right">
      <div class="search-box">
        <i data-lucide="search" class="search-icon"></i>
        <input type="text" placeholder="Search creations..." id="creations-search" class="search-input">
      </div>
      <button type="button" class="btn btn-primary create-new-btn" id="create-new-btn">
        <i data-lucide="plus" style="width: 16px; height: 16px;" class="me-1"></i>
        Create New
      </button>
    </div>
  </div>
  
  <!-- Filter Bar -->
  <div class="creations-filters">
    <div class="filter-group">
      <span class="filter-label">Type:</span>
      <div class="filter-tabs" id="type-filters">
        <button type="button" class="filter-tab <%= 'active' if filter_type == 'all' %>" data-filter="all">
          <i data-lucide="layers" style="width: 14px; height: 14px;"></i>
          All
        </button>
        <button type="button" class="filter-tab <%= 'active' if filter_type == 'landing_page' %>" data-filter="landing_page">
          <i data-lucide="file-text" style="width: 14px; height: 14px;"></i>
          Landing Pages
          <span class="count"><%= landing_pages.count %></span>
        </button>
        <button type="button" class="filter-tab <%= 'active' if filter_type == 'website' %>" data-filter="website">
          <i data-lucide="globe" style="width: 14px; height: 14px;"></i>
          Websites
          <span class="count">0</span>
        </button>
        <button type="button" class="filter-tab <%= 'active' if filter_type == 'app_module' %>" data-filter="app_module">
          <i data-lucide="boxes" style="width: 14px; height: 14px;"></i>
          App Modules
          <span class="count"><%= app_modules.respond_to?(:count) ? app_modules.count : 0 %></span>
        </button>
        <button type="button" class="filter-tab <%= 'active' if filter_type == 'workflow' %>" data-filter="workflow">
          <i data-lucide="git-branch" style="width: 14px; height: 14px;"></i>
          Workflows
          <span class="count"><%= workflows.respond_to?(:count) ? workflows.count : 0 %></span>
        </button>
      </div>
    </div>
    
    <div class="filter-group">
      <span class="filter-label">Status:</span>
      <div class="filter-tabs" id="status-filters">
        <button type="button" class="filter-tab small <%= 'active' if filter_status == 'all' %>" data-status="all">All</button>
        <button type="button" class="filter-tab small <%= 'active' if filter_status == 'draft' %>" data-status="draft">
          <span class="status-dot draft"></span> Draft
        </button>
        <button type="button" class="filter-tab small <%= 'active' if filter_status == 'published' %>" data-status="published">
          <span class="status-dot published"></span> Published
        </button>
      </div>
    </div>
  </div>
  
  <!-- Creations Grid -->
  <div class="creations-grid-container">
    <% total_count = landing_pages.count + (app_modules.respond_to?(:count) ? app_modules.count : 0) + (workflows.respond_to?(:count) ? workflows.count : 0) %>
    
    <% if total_count > 0 %>
      <div class="creations-grid" id="creations-grid">
        
        <%# Landing Pages %>
        <% landing_pages.each do |lp| %>
          <div class="creation-card" 
               data-id="<%= lp.id %>" 
               data-type="landing_page"
               data-status="<%= lp.status == 'published' ? 'published' : 'draft' %>"
               data-title="<%= lp.title.downcase %>">
            <div class="creation-preview">
              <% if lp.html_content.present? %>
                <div class="preview-iframe-container">
                  <% 
                    # Prepare preview HTML with base tag and error hiding
                    preview_html = lp.html_content
                    # Add base tag and error-hiding styles at the start of head or body
                    error_hide_css = '<style>body{margin:0;overflow:hidden}*{animation:none!important;transition:none!important}.error,.alert-danger,[class*="error"]{display:none!important}</style>'
                    if preview_html.include?('<head')
                      preview_html = preview_html.sub('<head>', "<head><base href=\"#{request.base_url}/\">#{error_hide_css}")
                    elsif preview_html.include?('<body')
                      preview_html = preview_html.sub('<body', "<head><base href=\"#{request.base_url}/\">#{error_hide_css}</head><body")
                    else
                      preview_html = "<html><head><base href=\"#{request.base_url}/\">#{error_hide_css}</head><body>#{preview_html}</body></html>"
                    end
                  %>
                  <iframe 
                    srcdoc="<%= preview_html.gsub('"', '&quot;') %>"
                    sandbox="allow-same-origin"
                    scrolling="no"
                    class="preview-iframe"
                    loading="lazy"></iframe>
                </div>
              <% else %>
                <div class="preview-placeholder landing-page">
                  <i data-lucide="file-text" style="width: 32px; height: 32px;"></i>
                  <span class="placeholder-text">No content yet</span>
                </div>
              <% end %>
              <div class="creation-type-badge">
                <i data-lucide="file-text" style="width: 12px; height: 12px;"></i>
                Landing Page
              </div>
              <div class="creation-status <%= lp.status == 'published' ? 'published' : 'draft' %>">
                <%= lp.status == 'published' ? 'Published' : 'Draft' %>
              </div>
            </div>
            <div class="creation-info">
              <h6 class="creation-title"><%= lp.title.truncate(30) %></h6>
              <div class="creation-meta">
                <span class="meta-item">
                  <i data-lucide="calendar" style="width: 12px; height: 12px;"></i>
                  <%= lp.updated_at.strftime('%b %d, %Y') %>
                </span>
                <% if lp.respond_to?(:views_count) && lp.views_count.to_i > 0 %>
                  <span class="meta-item">
                    <i data-lucide="eye" style="width: 12px; height: 12px;"></i>
                    <%= lp.views_count %> views
                  </span>
                <% end %>
              </div>
            </div>
            <div class="creation-actions">
              <button type="button" class="action-btn edit-btn" data-id="<%= lp.id %>" data-type="landing_page" title="Edit">
                <i data-lucide="edit-2" style="width: 14px; height: 14px;"></i>
              </button>
              <button type="button" class="action-btn preview-btn" data-id="<%= lp.id %>" data-type="landing_page" title="Preview">
                <i data-lucide="eye" style="width: 14px; height: 14px;"></i>
              </button>
              <button type="button" class="action-btn more-btn" data-id="<%= lp.id %>" data-type="landing_page" title="More">
                <i data-lucide="more-horizontal" style="width: 14px; height: 14px;"></i>
              </button>
            </div>
          </div>
        <% end %>
        
        <%# App Modules %>
        <% if app_modules.respond_to?(:each) %>
          <% app_modules.each do |mod| %>
            <div class="creation-card" 
                 data-id="<%= mod.id %>" 
                 data-type="app_module"
                 data-status="<%= mod.respond_to?(:published?) && mod.published? ? 'published' : 'draft' %>"
                 data-title="<%= mod.name.downcase rescue '' %>">
              <div class="creation-preview">
                <div class="preview-placeholder app-module">
                  <i data-lucide="boxes" style="width: 32px; height: 32px;"></i>
                </div>
                <div class="creation-type-badge app">
                  <i data-lucide="boxes" style="width: 12px; height: 12px;"></i>
                  App Module
                </div>
                <div class="creation-status <%= mod.respond_to?(:published?) && mod.published? ? 'published' : 'draft' %>">
                  <%= mod.respond_to?(:published?) && mod.published? ? 'Published' : 'Draft' %>
                </div>
              </div>
              <div class="creation-info">
                <h6 class="creation-title"><%= (mod.name rescue 'Untitled').truncate(30) %></h6>
                <div class="creation-meta">
                  <span class="meta-item">
                    <i data-lucide="calendar" style="width: 12px; height: 12px;"></i>
                    <%= mod.updated_at.strftime('%b %d, %Y') rescue 'N/A' %>
                  </span>
                </div>
              </div>
              <div class="creation-actions">
                <button type="button" class="action-btn edit-btn" data-id="<%= mod.id %>" data-type="app_module" title="Edit">
                  <i data-lucide="edit-2" style="width: 14px; height: 14px;"></i>
                </button>
                <button type="button" class="action-btn preview-btn" data-id="<%= mod.id %>" data-type="app_module" title="Preview">
                  <i data-lucide="eye" style="width: 14px; height: 14px;"></i>
                </button>
              </div>
            </div>
          <% end %>
        <% end %>
        
        <%# Workflows %>
        <% if workflows.respond_to?(:each) %>
          <% workflows.each do |wf| %>
            <div class="creation-card" 
                 data-id="<%= wf.id %>" 
                 data-type="workflow"
                 data-status="<%= wf.respond_to?(:active?) && wf.active? ? 'published' : 'draft' %>"
                 data-title="<%= wf.name.downcase rescue '' %>">
              <div class="creation-preview">
                <div class="preview-placeholder workflow">
                  <i data-lucide="git-branch" style="width: 32px; height: 32px;"></i>
                </div>
                <div class="creation-type-badge workflow">
                  <i data-lucide="git-branch" style="width: 12px; height: 12px;"></i>
                  Workflow
                </div>
                <div class="creation-status <%= wf.respond_to?(:active?) && wf.active? ? 'published' : 'draft' %>">
                  <%= wf.respond_to?(:active?) && wf.active? ? 'Active' : 'Draft' %>
                </div>
              </div>
              <div class="creation-info">
                <h6 class="creation-title"><%= (wf.name rescue 'Untitled').truncate(30) %></h6>
                <div class="creation-meta">
                  <span class="meta-item">
                    <i data-lucide="calendar" style="width: 12px; height: 12px;"></i>
                    <%= wf.updated_at.strftime('%b %d, %Y') rescue 'N/A' %>
                  </span>
                </div>
              </div>
              <div class="creation-actions">
                <button type="button" class="action-btn edit-btn" data-id="<%= wf.id %>" data-type="workflow" title="Edit">
                  <i data-lucide="edit-2" style="width: 14px; height: 14px;"></i>
                </button>
              </div>
            </div>
          <% end %>
        <% end %>
        
      </div>
    <% else %>
      <div class="empty-state">
        <div class="empty-icon">
          <i data-lucide="rocket" style="width: 48px; height: 48px;"></i>
        </div>
        <h5>No creations yet</h5>
        <p>Start building landing pages, websites, apps, or workflows</p>
        <button type="button" class="btn btn-primary" id="empty-create-btn">
          <i data-lucide="plus" style="width: 16px; height: 16px;" class="me-1"></i>
          Create Your First Project
        </button>
      </div>
    <% end %>
  </div>
</div>

<style>
  .my-creations-canvas {
    height: 100%;
    display: flex;
    flex-direction: column;
    background: var(--canvas-bg, #1e1e2e);
    color: var(--canvas-text, #e0e0e0);
  }
  
  .creations-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1rem 1.5rem;
    border-bottom: 1px solid var(--canvas-border, #3a3a4a);
    background: var(--canvas-header-bg, #252536);
  }
  
  .header-left {
    display: flex;
    align-items: center;
    gap: 1rem;
  }
  
  .header-icon {
    width: 32px;
    height: 32px;
    color: #f59e0b;
  }
  
  .header-title {
    margin: 0;
    font-size: 1.25rem;
    font-weight: 600;
  }
  
  .header-subtitle {
    margin: 0;
    font-size: 0.875rem;
    color: var(--canvas-text-muted, #a0a0a0);
  }
  
  .header-right {
    display: flex;
    align-items: center;
    gap: 1rem;
  }
  
  .search-box {
    position: relative;
  }
  
  .search-box .search-icon {
    position: absolute;
    left: 12px;
    top: 50%;
    transform: translateY(-50%);
    width: 16px;
    height: 16px;
    color: var(--canvas-text-muted, #a0a0a0);
  }
  
  .search-box .search-input {
    padding: 8px 12px 8px 36px;
    border: 1px solid var(--canvas-border, #3a3a4a);
    border-radius: 8px;
    background: var(--canvas-input-bg, #2a2a3a);
    color: var(--canvas-text, #e0e0e0);
    width: 220px;
  }
  
  .creations-filters {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1rem 1.5rem;
    border-bottom: 1px solid var(--canvas-border, #3a3a4a);
    flex-wrap: wrap;
    gap: 1rem;
  }
  
  .filter-group {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  
  .filter-label {
    font-size: 0.8rem;
    color: var(--canvas-text-muted, #a0a0a0);
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }
  
  .filter-tabs {
    display: flex;
    gap: 0.4rem;
  }
  
  .filter-tab {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.4rem 0.75rem;
    border: 1px solid var(--canvas-border, #3a3a4a);
    border-radius: 6px;
    background: transparent;
    color: var(--canvas-text-muted, #a0a0a0);
    font-size: 0.8rem;
    cursor: pointer;
    transition: all 0.2s;
  }
  
  .filter-tab.small {
    padding: 0.3rem 0.6rem;
    font-size: 0.75rem;
  }
  
  .filter-tab:hover {
    border-color: #f59e0b;
    color: var(--canvas-text, #e0e0e0);
  }
  
  .filter-tab.active {
    background: linear-gradient(135deg, #f59e0b 0%, #fbbf24 100%);
    border-color: transparent;
    color: #1a1a2e;
  }
  
  .filter-tab .count {
    font-size: 0.7rem;
    padding: 1px 5px;
    border-radius: 8px;
    background: rgba(255,255,255,0.15);
  }
  
  .filter-tab.active .count {
    background: rgba(0,0,0,0.15);
  }
  
  .status-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
  }
  
  .status-dot.draft {
    background: #6b7280;
  }
  
  .status-dot.published {
    background: #22c55e;
  }
  
  .creations-grid-container {
    flex: 1;
    padding: 1.5rem;
    overflow-y: auto;
  }
  
  .creations-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.25rem;
  }
  
  .creation-card {
    background: var(--canvas-card-bg, #252536);
    border: 1px solid var(--canvas-border, #3a3a4a);
    border-radius: 12px;
    overflow: hidden;
    transition: all 0.2s;
    cursor: pointer;
  }
  
  .creation-card:hover {
    border-color: #f59e0b;
    transform: translateY(-3px);
    box-shadow: 0 8px 24px rgba(245, 158, 11, 0.15);
  }
  
  .creation-preview {
    position: relative;
    height: 160px;
    overflow: hidden;
    background: #1a1a2e;
  }
  
  .preview-iframe-container {
    width: 100%;
    height: 100%;
    overflow: hidden;
    position: relative;
    background: linear-gradient(135deg, #1e293b 0%, #334155 100%);
  }
  
  /* Gradient mask to hide bottom content and errors */
  .preview-iframe-container::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 40%;
    background: linear-gradient(to bottom, transparent 0%, rgba(30, 41, 59, 0.9) 100%);
    pointer-events: none;
    z-index: 1;
  }
  
  .preview-iframe {
    width: 1200px;
    height: 800px;
    border: none;
    transform: scale(0.25);
    transform-origin: top left;
    pointer-events: none;
    position: absolute;
    top: 0;
    left: 50%;
    margin-left: -150px; /* Center the scaled iframe: (1200 * 0.25) / 2 = 150 */
    background: white;
  }
  
  .preview-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 8px;
    color: var(--canvas-text-muted, #6b6b8a);
  }
  
  .placeholder-text {
    font-size: 0.75rem;
    opacity: 0.7;
  }
  
  .preview-placeholder.landing-page {
    background: linear-gradient(135deg, #3b82f6 0%, #1d4ed8 100%);
    color: rgba(255,255,255,0.5);
  }
  
  /* Hover overlay for preview */
  .creation-preview::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, transparent 50%, rgba(0,0,0,0.6) 100%);
    opacity: 0;
    transition: opacity 0.2s ease;
    pointer-events: none;
  }
  
  .creation-card:hover .creation-preview::after {
    opacity: 1;
  }
  
  .preview-placeholder.app-module {
    background: linear-gradient(135deg, #8b5cf6 0%, #6d28d9 100%);
    color: rgba(255,255,255,0.3);
  }
  
  .preview-placeholder.workflow {
    background: linear-gradient(135deg, #22c55e 0%, #16a34a 100%);
    color: rgba(255,255,255,0.3);
  }
  
  .preview-placeholder.website {
    background: linear-gradient(135deg, #06b6d4 0%, #0891b2 100%);
    color: rgba(255,255,255,0.3);
  }
  
  .creation-type-badge {
    position: absolute;
    top: 10px;
    left: 10px;
    display: flex;
    align-items: center;
    gap: 4px;
    padding: 4px 8px;
    background: rgba(0,0,0,0.5);
    backdrop-filter: blur(4px);
    border-radius: 6px;
    font-size: 0.7rem;
    color: white;
  }
  
  .creation-status {
    position: absolute;
    top: 10px;
    right: 10px;
    padding: 4px 8px;
    border-radius: 6px;
    font-size: 0.7rem;
    font-weight: 500;
  }
  
  .creation-status.draft {
    background: rgba(107, 114, 128, 0.8);
    color: white;
  }
  
  .creation-status.published {
    background: rgba(34, 197, 94, 0.9);
    color: white;
  }
  
  .creation-info {
    padding: 1rem;
  }
  
  .creation-title {
    margin: 0 0 0.5rem;
    font-size: 1rem;
    font-weight: 600;
    color: var(--canvas-text, #e0e0e0);
  }
  
  .creation-meta {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }
  
  .meta-item {
    display: flex;
    align-items: center;
    gap: 4px;
    font-size: 0.75rem;
    color: var(--canvas-text-muted, #a0a0a0);
  }
  
  .creation-actions {
    display: flex;
    gap: 0.5rem;
    padding: 0.75rem 1rem;
    border-top: 1px solid var(--canvas-border, #3a3a4a);
    background: rgba(0,0,0,0.1);
  }
  
  .action-btn {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0.5rem;
    border: 1px solid var(--canvas-border, #3a3a4a);
    border-radius: 6px;
    background: transparent;
    color: var(--canvas-text-muted, #a0a0a0);
    cursor: pointer;
    transition: all 0.2s;
  }
  
  .action-btn:hover {
    background: var(--canvas-border, #3a3a4a);
    color: var(--canvas-text, #e0e0e0);
  }
  
  .action-btn.edit-btn:hover {
    background: #f59e0b;
    border-color: #f59e0b;
    color: #1a1a2e;
  }
  
  .empty-state {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 4rem 2rem;
    text-align: center;
  }
  
  .empty-icon {
    width: 80px;
    height: 80px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, #f59e0b 0%, #fbbf24 100%);
    border-radius: 20px;
    color: #1a1a2e;
    margin-bottom: 1.5rem;
  }
  
  .empty-state h5 {
    margin: 0 0 0.5rem;
    color: var(--canvas-text, #e0e0e0);
  }
  
  .empty-state p {
    margin: 0 0 1.5rem;
    color: var(--canvas-text-muted, #a0a0a0);
  }
  
  /* Dropdown menu */
  .creation-dropdown {
    background: var(--canvas-card-bg, #252536);
    border: 1px solid var(--canvas-border, #3a3a4a);
    border-radius: 8px;
    padding: 4px;
    min-width: 140px;
    box-shadow: 0 8px 24px rgba(0,0,0,0.4);
  }
  
  .dropdown-item {
    display: flex;
    align-items: center;
    gap: 8px;
    width: 100%;
    padding: 8px 12px;
    border: none;
    background: transparent;
    color: var(--canvas-text, #e0e0e0);
    font-size: 0.85rem;
    cursor: pointer;
    border-radius: 6px;
    text-align: left;
  }
  
  .dropdown-item:hover {
    background: var(--canvas-border, #3a3a4a);
  }
  
  .dropdown-item.text-danger {
    color: #ef4444;
  }
  
  .dropdown-item.text-danger:hover {
    background: rgba(239, 68, 68, 0.15);
  }
  
  .dropdown-divider {
    height: 1px;
    background: var(--canvas-border, #3a3a4a);
    margin: 4px 0;
  }
  
  /* Light mode */
  [data-theme="light"] .my-creations-canvas {
    --canvas-bg: #f8f9fa;
    --canvas-text: #1a1a2e;
    --canvas-text-muted: #6b7280;
    --canvas-border: #e5e7eb;
    --canvas-header-bg: #ffffff;
    --canvas-card-bg: #ffffff;
    --canvas-input-bg: #f3f4f6;
  }
  
  [data-theme="light"] .creations-header {
    background: #ffffff;
    border-color: #e5e7eb;
  }
  
  [data-theme="light"] .header-title,
  [data-theme="light"] .creation-title {
    color: #1a1a2e;
  }
  
  [data-theme="light"] .header-subtitle,
  [data-theme="light"] .meta-item {
    color: #6b7280;
  }
  
  [data-theme="light"] .search-box .search-input {
    background: #f3f4f6;
    border-color: #e5e7eb;
    color: #1a1a2e;
  }
  
  [data-theme="light"] .creations-filters {
    border-color: #e5e7eb;
  }
  
  [data-theme="light"] .filter-tab {
    border-color: #e5e7eb;
    color: #6b7280;
  }
  
  [data-theme="light"] .filter-tab:hover {
    color: #1a1a2e;
  }
  
  [data-theme="light"] .filter-tab.active {
    color: #1a1a2e;
  }
  
  [data-theme="light"] .creation-card {
    background: #ffffff;
    border-color: #e5e7eb;
  }
  
  [data-theme="light"] .creation-card:hover {
    box-shadow: 0 8px 24px rgba(245, 158, 11, 0.1);
  }
  
  [data-theme="light"] .creation-preview {
    background: #e5e7eb;
  }
  
  [data-theme="light"] .preview-iframe-container {
    background: linear-gradient(135deg, #e2e8f0 0%, #cbd5e1 100%);
  }
  
  [data-theme="light"] .preview-iframe-container::after {
    background: linear-gradient(to bottom, transparent 0%, rgba(255, 255, 255, 0.9) 100%);
  }
  
  [data-theme="light"] .preview-placeholder {
    color: #6b7280;
  }
  
  [data-theme="light"] .creation-actions {
    background: #f9fafb;
    border-color: #e5e7eb;
  }
  
  [data-theme="light"] .action-btn {
    border-color: #e5e7eb;
    color: #6b7280;
  }
  
  [data-theme="light"] .action-btn:hover {
    background: #e5e7eb;
    color: #1a1a2e;
  }
  
  [data-theme="light"] .empty-state h5 {
    color: #1a1a2e;
  }
  
  [data-theme="light"] .empty-state p {
    color: #6b7280;
  }
  
  [data-theme="light"] .creation-dropdown {
    background: #ffffff;
    border-color: #e5e7eb;
    box-shadow: 0 8px 24px rgba(0,0,0,0.15);
  }
  
  [data-theme="light"] .dropdown-item {
    color: #1a1a2e;
  }
  
  [data-theme="light"] .dropdown-item:hover {
    background: #f3f4f6;
  }
  
  [data-theme="light"] .dropdown-divider {
    background: #e5e7eb;
  }
</style>

<script>
(function() {
  // Find the specific container by unique ID (generated fresh each time)
  const containers = document.querySelectorAll('.my-creations-canvas');
  const container = containers[containers.length - 1]; // Get the most recent one
  if (!container) return;
  
  // Use unique ID to prevent double-init on same instance
  const containerId = container.id;
  if (window._myCreationsInitialized && window._myCreationsInitialized[containerId]) return;
  window._myCreationsInitialized = window._myCreationsInitialized || {};
  window._myCreationsInitialized[containerId] = true;
  
  console.log('🎨 Initializing My Creations canvas:', containerId);
  
  let currentTypeFilter = 'all';
  let currentStatusFilter = 'all';
  
  // Helper to load a canvas via event
  function loadCanvas(canvasType, canvasData = {}) {
    console.log('📂 Loading canvas:', canvasType, canvasData);
    const evt = new CustomEvent('scout:load-canvas', { 
      detail: { canvas: canvasType, data: canvasData } 
    });
    document.dispatchEvent(evt);
  }
  
  // Type filter
  container.querySelectorAll('#type-filters .filter-tab').forEach(tab => {
    tab.addEventListener('click', function(e) {
      e.preventDefault();
      e.stopPropagation();
      currentTypeFilter = this.dataset.filter;
      container.querySelectorAll('#type-filters .filter-tab').forEach(t => t.classList.remove('active'));
      this.classList.add('active');
      applyFilters();
    });
  });
  
  // Status filter
  container.querySelectorAll('#status-filters .filter-tab').forEach(tab => {
    tab.addEventListener('click', function(e) {
      e.preventDefault();
      e.stopPropagation();
      currentStatusFilter = this.dataset.status;
      container.querySelectorAll('#status-filters .filter-tab').forEach(t => t.classList.remove('active'));
      this.classList.add('active');
      applyFilters();
    });
  });
  
  // Search
  const searchInput = container.querySelector('#creations-search');
  if (searchInput) {
    searchInput.addEventListener('input', applyFilters);
  }
  
  function applyFilters() {
    const query = searchInput?.value.toLowerCase() || '';
    
    container.querySelectorAll('.creation-card').forEach(card => {
      const type = card.dataset.type;
      const status = card.dataset.status;
      const title = card.dataset.title || '';
      
      const matchesType = currentTypeFilter === 'all' || type === currentTypeFilter;
      const matchesStatus = currentStatusFilter === 'all' || status === currentStatusFilter;
      const matchesSearch = title.includes(query);
      
      card.style.display = (matchesType && matchesStatus && matchesSearch) ? '' : 'none';
    });
  }
  
  // Edit button
  container.querySelectorAll('.edit-btn').forEach(btn => {
    btn.addEventListener('click', function(e) {
      e.preventDefault();
      e.stopPropagation();
      const id = this.dataset.id;
      const type = this.dataset.type;
      
      console.log('✏️ Edit clicked:', type, id);
      
      let canvasType = 'landing_page_editor';
      let canvasData = {};
      
      switch(type) {
        case 'landing_page':
          canvasType = 'landing_page_editor';
          canvasData = { landing_page_id: id };
          break;
        case 'app_module':
          canvasType = 'module_manager';
          canvasData = { module_id: id };
          break;
        case 'workflow':
          canvasType = 'workflow_editor';
          canvasData = { workflow_id: id };
          break;
      }
      
      loadCanvas(canvasType, canvasData);
    });
  });
  
  // Card click = edit (on preview area or info, not action buttons)
  container.querySelectorAll('.creation-card').forEach(card => {
    card.querySelector('.creation-preview')?.addEventListener('click', function(e) {
      const editBtn = card.querySelector('.edit-btn');
      if (editBtn) editBtn.click();
    });
    card.querySelector('.creation-info')?.addEventListener('click', function(e) {
      const editBtn = card.querySelector('.edit-btn');
      if (editBtn) editBtn.click();
    });
  });
  
  // Preview button - opens in new tab
  container.querySelectorAll('.preview-btn').forEach(btn => {
    btn.addEventListener('click', function(e) {
      e.preventDefault();
      e.stopPropagation();
      const id = this.dataset.id;
      const type = this.dataset.type;
      
      console.log('👁️ Preview clicked:', type, id);
      
      if (type === 'landing_page') {
        window.open('/landing_pages/' + id + '/preview', '_blank');
      } else if (type === 'app_module') {
        window.open('/design_preview/module/' + id, '_blank');
      }
    });
  });
  
  // More button - show dropdown menu
  container.querySelectorAll('.more-btn').forEach(btn => {
    btn.addEventListener('click', function(e) {
      e.preventDefault();
      e.stopPropagation();
      const id = this.dataset.id;
      const type = this.dataset.type;
      
      console.log('⋯ More clicked:', type, id);
      
      // Remove any existing dropdown
      document.querySelectorAll('.creation-dropdown').forEach(d => d.remove());
      
      // Create dropdown
      const dropdown = document.createElement('div');
      dropdown.className = 'creation-dropdown';
      dropdown.innerHTML = `
        <button type="button" class="dropdown-item" data-action="duplicate">
          <i data-lucide="copy" style="width: 14px; height: 14px;"></i>
          Duplicate
        </button>
        ${type === 'landing_page' ? `
          <button type="button" class="dropdown-item" data-action="publish">
            <i data-lucide="globe" style="width: 14px; height: 14px;"></i>
            Publish
          </button>
        ` : ''}
        <div class="dropdown-divider"></div>
        <button type="button" class="dropdown-item text-danger" data-action="delete">
          <i data-lucide="trash-2" style="width: 14px; height: 14px;"></i>
          Delete
        </button>
      `;
      
      // Position it
      const btnRect = this.getBoundingClientRect();
      dropdown.style.position = 'fixed';
      dropdown.style.top = (btnRect.bottom + 4) + 'px';
      dropdown.style.left = (btnRect.left - 100) + 'px';
      dropdown.style.zIndex = '9999';
      
      document.body.appendChild(dropdown);
      
      // Init icons in dropdown
      if (typeof lucide !== 'undefined') lucide.createIcons({ node: dropdown });
      
      // Handle dropdown actions
      dropdown.querySelectorAll('.dropdown-item').forEach(item => {
        item.addEventListener('click', function() {
          const action = this.dataset.action;
          console.log('📋 Dropdown action:', action, type, id);
          
          if (action === 'delete') {
            if (confirm('Are you sure you want to delete this item?')) {
              // Send delete request
              fetch('/landing_pages/' + id, {
                method: 'DELETE',
                headers: {
                  'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]')?.content,
                  'Accept': 'application/json'
                }
              }).then(() => {
                // Reload the canvas
                loadCanvas('my_creations', {});
              });
            }
          } else if (action === 'publish' && type === 'landing_page') {
            fetch('/landing_pages/' + id + '/publish', {
              method: 'POST',
              headers: {
                'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]')?.content,
                'Accept': 'application/json'
              }
            }).then(() => {
              loadCanvas('my_creations', {});
            });
          } else if (action === 'duplicate') {
            alert('Duplicate feature coming soon!');
          }
          
          dropdown.remove();
        });
      });
      
      // Close on outside click
      setTimeout(() => {
        const closeHandler = (e) => {
          if (!dropdown.contains(e.target)) {
            dropdown.remove();
            document.removeEventListener('click', closeHandler);
          }
        };
        document.addEventListener('click', closeHandler);
      }, 10);
    });
  });
  
  // Create new button
  const createBtns = container.querySelectorAll('#create-new-btn, #empty-create-btn');
  createBtns.forEach(btn => {
    btn.addEventListener('click', function(e) {
      e.preventDefault();
      loadCanvas('template_library', {});
    });
  });
  
  // Init icons
  if (typeof lucide !== 'undefined') lucide.createIcons();
  
  console.log('📂 My Creations canvas initialized');
})();
</script>

