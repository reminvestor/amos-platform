    background: rgba(0,0,0,0.1);
  }
  
  .results-summary .search-results-text,
  .results-summary .total-count {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.85rem;
    color: var(--canvas-text-muted, #a0a0a0);
  }
  
  .results-summary .search-hint {
    color: var(--canvas-text-muted, #6b7280);
    font-style: italic;
