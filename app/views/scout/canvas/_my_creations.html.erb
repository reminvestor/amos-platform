    border-radius: 6px;
    color: var(--canvas-text-muted, #a0a0a0);
    font-size: 0.8rem;
    cursor: pointer;
    transition: all 0.2s;
  }
  
  .clear-search-btn:hover {
    background: rgba(245, 158, 11, 0.1);
    border-color: #f59e0b;
    color: #f59e0b;
