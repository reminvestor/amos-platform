  /* Dropdown menu */
  .creation-dropdown {
    background: var(--canvas-card-bg, #252536);
    border: 1px solid var(--canvas-border, #3a3a4a);
    border-radius: 8px;
    padding: 4px;
    min-width: 140px;
    box-shadow: 0 8px 24px rgba(0,0,0,0.4);
  }
  
  .dropdown-item {
    display: flex;
    align-items: center;
    gap: 8px;
