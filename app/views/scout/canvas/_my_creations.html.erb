  }
</style>

<script>
(function() {
  try {
    console.log('🎨 My Creations script starting...');
    
    // Find the specific container by unique ID (generated fresh each time)
    const containers = document.querySelectorAll('.my-creations-canvas');
    console.log('🎨 Found ' + containers.length + ' canvas containers');
    
    const container = containers[containers.length - 1]; // Get the most recent one
    if (!container) {
      console.error('🎨 No container found!');
      return;
    }
    
    // Use unique ID to prevent double-init on same instance
    const containerId = container.id;
    if (window._myCreationsInitialized && window._myCreationsInitialized[containerId]) {
      console.log('🎨 Already initialized:', containerId);
      return;
    }
    window._myCreationsInitialized = window._myCreationsInitialized || {};
    window._myCreationsInitialized[containerId] = true;
    
    console.log('🎨 Initializing My Creations canvas:', containerId);
  
  // Initialize filters from canvas data (allows pre-filtering when opened from workflow/app designer)
  let currentTypeFilter = '<%= filter_type %>';
  let currentStatusFilter = '<%= filter_status %>';
  
  // Apply initial filter if not 'all' (pre-filter on load)
  if (currentTypeFilter !== 'all' || currentStatusFilter !== 'all') {
    console.log('🔍 Pre-filtering to type:', currentTypeFilter, 'status:', currentStatusFilter);
    // Delay slightly to ensure DOM is ready
    setTimeout(() => {
      applyFilters();
    }, 100);
  }
  
  // Helper to load a canvas via event
  function loadCanvas(canvasType, canvasData = {}) {
    console.log('📂 Loading canvas:', canvasType, canvasData);
    const evt = new CustomEvent('scout:load-canvas', { 
      detail: { canvas: canvasType, data: canvasData } 
    });
    document.dispatchEvent(evt);
  }
  
  // Type filter
  container.querySelectorAll('#type-filters .filter-tab').forEach(tab => {
    tab.addEventListener('click', function(e) {
      e.preventDefault();
      e.stopPropagation();
      currentTypeFilter = this.dataset.filter;
      container.querySelectorAll('#type-filters .filter-tab').forEach(t => t.classList.remove('active'));
      this.classList.add('active');
      applyFilters();
    });
  });
  
  // Status filter
  container.querySelectorAll('#status-filters .filter-tab').forEach(tab => {
    tab.addEventListener('click', function(e) {
      e.preventDefault();
      e.stopPropagation();
      currentStatusFilter = this.dataset.status;
      container.querySelectorAll('#status-filters .filter-tab').forEach(t => t.classList.remove('active'));
      this.classList.add('active');
      applyFilters();
    });
  });
  
  // Search
  const searchInput = container.querySelector('#creations-search');
  if (searchInput) {
    searchInput.addEventListener('input', applyFilters);
  }
  
  function applyFilters() {
    const query = searchInput?.value.toLowerCase() || '';
    
    container.querySelectorAll('.creation-card').forEach(card => {
      const type = card.dataset.type;
      const status = card.dataset.status;
      const title = card.dataset.title || '';
      
      const matchesType = currentTypeFilter === 'all' || type === currentTypeFilter;
      const matchesStatus = currentStatusFilter === 'all' || status === currentStatusFilter;
      const matchesSearch = title.includes(query);
      
      card.style.display = (matchesType && matchesStatus && matchesSearch) ? '' : 'none';
    });
  }
  
  // Edit button - use event delegation for dynamic content
  container.addEventListener('click', function(e) {
    const editBtn = e.target.closest('.edit-btn');
    if (!editBtn) return;
    
    e.preventDefault();
    e.stopPropagation();
    const id = editBtn.dataset.id;
    const type = editBtn.dataset.type;
    
    console.log('✏️ Edit clicked:', type, id);
    
    let canvasType = 'landing_page_editor';
    let canvasData = {};
      
      switch(type) {
        case 'landing_page':
          canvasType = 'landing_page_editor';
          canvasData = { landing_page_id: id };
          break;
        case 'app_module':
          canvasType = 'module_manager';
          canvasData = { module_id: id };
          break;
        case 'workflow':
          canvasType = 'workflow_designer';
          canvasData = { workflow_id: id };
          break;
        case 'design_plan':
          canvasType = 'design_studio';
          canvasData = { plan_id: id };
          // Load directly - no need to message Amos
          break;
      }
      
      loadCanvas(canvasType, canvasData);
  });
  
  // Preview button - event delegation
  container.addEventListener('click', function(e) {
    const previewBtn = e.target.closest('.preview-btn');
    if (!previewBtn) return;
    
    e.preventDefault();
    e.stopPropagation();
    const id = previewBtn.dataset.id;
    const type = previewBtn.dataset.type;
    
    console.log('👁️ Preview clicked:', type, id);
    
    if (type === 'landing_page') {
      loadCanvas('landing_page_viewer', { landing_page_id: id });
    } else if (type === 'app_module') {
      loadCanvas('module_preview', { module_id: id });
    }
  });
  
  // Build button - event delegation
  container.addEventListener('click', function(e) {
    const buildBtn = e.target.closest('.build-btn');
    if (!buildBtn) return;
    
    e.preventDefault();
    e.stopPropagation();
    const id = buildBtn.dataset.id;
    const type = buildBtn.dataset.type;
    
    console.log('🔨 Build clicked:', type, id);
    
    if (type === 'design_plan') {
      // Send message to Amos to build the plan
      const msg = 'Build design plan ' + id;
      if (window.scoutController && typeof window.scoutController.sendScoutMessage === 'function') {
        window.scoutController.sendScoutMessage(msg);
      } else if (typeof window.scoutSendMessage === 'function') {
        window.scoutSendMessage(msg);
      }
    }
  });
  
  // Card click = edit (on preview area or info, not action buttons) - event delegation
  container.addEventListener('click', function(e) {
    // Ignore if clicked on action buttons
    if (e.target.closest('.creation-actions')) return;
    
    const card = e.target.closest('.creation-card');
    if (!card) return;
    
    // Only trigger on preview or info areas
    if (e.target.closest('.creation-preview') || e.target.closest('.creation-info')) {
      const editBtn = card.querySelector('.edit-btn');
      if (editBtn) editBtn.click();
    }
  });
  
  // More button - show dropdown menu (event delegation)
  container.addEventListener('click', function(e) {
    const moreBtn = e.target.closest('.more-btn');
    if (!moreBtn) return;
    
    e.preventDefault();
    e.stopPropagation();
    const id = moreBtn.dataset.id;
    const type = moreBtn.dataset.type;
    
    console.log('⋯ More clicked:', type, id);
      
      // Remove any existing dropdown
      document.querySelectorAll('.creation-dropdown').forEach(d => d.remove());
      
      // Create dropdown
      const dropdown = document.createElement('div');
      dropdown.className = 'creation-dropdown';
      dropdown.innerHTML = `
        <button type="button" class="dropdown-item" data-action="duplicate">
          <i data-lucide="copy" style="width: 14px; height: 14px;"></i>
          Duplicate
        </button>
        ${type === 'landing_page' ? `
          <button type="button" class="dropdown-item" data-action="publish">
            <i data-lucide="globe" style="width: 14px; height: 14px;"></i>
            Publish
          </button>
        ` : ''}
        <div class="dropdown-divider"></div>
        <button type="button" class="dropdown-item text-danger" data-action="delete">
          <i data-lucide="trash-2" style="width: 14px; height: 14px;"></i>
          Delete
        </button>
      `;
      
      // Position it
      const btnRect = this.getBoundingClientRect();
      dropdown.style.position = 'fixed';
      dropdown.style.top = (btnRect.bottom + 4) + 'px';
      dropdown.style.left = (btnRect.left - 100) + 'px';
      dropdown.style.zIndex = '9999';
      
      document.body.appendChild(dropdown);
      
      // Init icons in dropdown
      if (typeof lucide !== 'undefined') lucide.createIcons({ node: dropdown });
      
      // Handle dropdown actions
      dropdown.querySelectorAll('.dropdown-item').forEach(item => {
        item.addEventListener('click', function() {
          const action = this.dataset.action;
          console.log('📋 Dropdown action:', action, type, id);
          
          if (action === 'delete') {
            if (confirm('Are you sure you want to delete this item?')) {
              // Send delete request
              fetch('/landing_pages/' + id, {
                method: 'DELETE',
                headers: {
                  'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]')?.content,
                  'Accept': 'application/json'
                }
              }).then(() => {
                // Reload the canvas
                loadCanvas('my_creations', {});
              });
            }
          } else if (action === 'publish' && type === 'landing_page') {
            fetch('/landing_pages/' + id + '/publish', {
              method: 'POST',
              headers: {
                'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]')?.content,
                'Accept': 'application/json'
              }
            }).then(() => {
              loadCanvas('my_creations', {});
            });
          } else if (action === 'duplicate') {
            alert('Duplicate feature coming soon!');
          }
          
          dropdown.remove();
        });
      });
      
      // Close on outside click
    setTimeout(() => {
      const closeHandler = (e) => {
        if (!dropdown.contains(e.target)) {
          dropdown.remove();
          document.removeEventListener('click', closeHandler);
        }
      };
      document.addEventListener('click', closeHandler);
    }, 10);
  });
  
  // Create new button
  const createBtns = container.querySelectorAll('#create-new-btn, #empty-create-btn');
  createBtns.forEach(btn => {
    btn.addEventListener('click', function(e) {
      e.preventDefault();
      loadCanvas('template_library', {});
    });
  });
  
  // ============================================
  // Live Search with Debouncing
  // ============================================
  // searchInput already declared above
  const clearSearchBtn = container.querySelector('#clear-search-btn');
  let searchTimeout = null;
  let currentSearch = '';
  
  function performSearch(query) {
    currentSearch = query;
    
    // Show loading state
    const grid = container.querySelector('#creations-grid');
    if (grid) {
      grid.style.opacity = '0.5';
    }
    
    fetch('/scout/load_canvas', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]')?.content
      },
      body: JSON.stringify({
        canvas_type: 'my_creations',
        canvas_data: { 
          search: query,
          type: currentTypeFilter,
          status: currentStatusFilter
        }
      })
    })
    .then(response => response.json())
    .then(data => {
      if (data.html) {
        // Replace entire canvas content
        const tempDiv = document.createElement('div');
        tempDiv.innerHTML = data.html;
        const newCanvas = tempDiv.querySelector('.my-creations-canvas');
        if (newCanvas) {
          // Preserve the search input value
          container.innerHTML = newCanvas.innerHTML;
          
          // Re-set the search value
          const newSearchInput = container.querySelector('#creations-search');
          if (newSearchInput) {
            newSearchInput.value = query;
            newSearchInput.focus();
          }
          
          // Re-init lucide icons
          if (typeof lucide !== 'undefined') lucide.createIcons();
          
          // Re-attach clear search handler
          const newClearBtn = container.querySelector('#clear-search-btn');
          if (newClearBtn) {
            newClearBtn.addEventListener('click', clearSearch);
          }
        }
      }
    })
    .catch(err => {
      console.error('Search error:', err);
      if (grid) grid.style.opacity = '1';
    });
  }
  
  function clearSearch() {
    currentSearch = '';
    if (searchInput) {
      searchInput.value = '';
    }
    performSearch('');
  }
  
  if (searchInput) {
    searchInput.addEventListener('input', function(e) {
      const query = e.target.value.trim();
      
      // Debounce search - wait 300ms after user stops typing
      if (searchTimeout) {
        clearTimeout(searchTimeout);
      }
      
      searchTimeout = setTimeout(function() {
        if (query !== currentSearch) {
          performSearch(query);
        }
      }, 300);
    });
    
    // Handle Enter key for immediate search
    searchInput.addEventListener('keypress', function(e) {
      if (e.key === 'Enter') {
        if (searchTimeout) {
          clearTimeout(searchTimeout);
        }
        performSearch(e.target.value.trim());
      }
    });
  }
  
  if (clearSearchBtn) {
    clearSearchBtn.addEventListener('click', clearSearch);
  }
  
  // Init icons
  if (typeof lucide !== 'undefined') lucide.createIcons();
  
  console.log('📂 My Creations canvas initialized successfully');
  
  } catch (err) {
    console.error('🎨 My Creations canvas initialization error:', err);
  }
})();
</script>

