<%# My Creations Canvas - Unified project & asset manager %>
<%# Cards for landing pages/websites, project view for app modules, list for automations %>

<% 
  data = canvas_data || {}
  search_query = (data[:search] || data['search'] || '').to_s.strip.downcase
  max_display = 100

  # ── Fetch data: user's own + entity-shared assets ──
  # Each asset uses visible_to_user(user) scope: shows user's own creations
  # plus anything shared_with_entity by teammates.
  # AppModule keeps its own visibility system (user_private/entity_shared/public).
  landing_pages_all = entity.landing_pages.visible_to_user(current_user).order(updated_at: :desc)
  app_modules_all = entity.app_modules
    .visible_to(current_user)
    .includes(:app, :module_canvases, :module_codes, :tool_definitions, :agent_plugins, :module_webhooks, :module_actions)
    .order(updated_at: :desc) rescue []
  automations_all = entity.automation_codes.visible_to_user(current_user).order(updated_at: :desc) rescue []
  websites_all = entity.websites.visible_to_user(current_user).includes(:website_pages).order(updated_at: :desc) rescue []
  web_apps_all = entity.web_apps.visible_to_user(current_user).includes(:website, :web_app_modules, :app_modules).order(updated_at: :desc) rescue []
  
  # Fetch Apps (parent containers for grouped modules)
  apps_all = entity.apps.visible_to_user(current_user).includes(app_modules: [:module_canvases, :module_codes, :tool_definitions, :agent_plugins]).order(updated_at: :desc) rescue []
  
  # Fetch Email Sequences — show all entity sequences (many are created by AI with no created_by_id)
  email_sequences_all = entity.email_sequences.includes(:sequence_steps, :contact_group).order(updated_at: :desc) rescue []

  # Apply search filter
  if search_query.present?
    landing_pages_all = landing_pages_all.where("LOWER(title) LIKE ? OR LOWER(description) LIKE ?", "%#{search_query}%", "%#{search_query}%")
    app_modules_all = app_modules_all.respond_to?(:where) ? app_modules_all.where("LOWER(name) LIKE ?", "%#{search_query}%") : app_modules_all.select { |m| m.name.to_s.downcase.include?(search_query) }
    automations_all = automations_all.respond_to?(:where) ? automations_all.where("LOWER(name) LIKE ?", "%#{search_query}%") : automations_all.select { |a| a.name.to_s.downcase.include?(search_query) }
    websites_all = websites_all.respond_to?(:where) ? websites_all.where("LOWER(name) LIKE ?", "%#{search_query}%") : websites_all
    web_apps_all = web_apps_all.respond_to?(:where) ? web_apps_all.where("LOWER(name) LIKE ?", "%#{search_query}%") : web_apps_all
    apps_all = apps_all.respond_to?(:where) ? apps_all.where("LOWER(name) LIKE ?", "%#{search_query}%") : apps_all
    email_sequences_all = email_sequences_all.respond_to?(:where) ? email_sequences_all.where("LOWER(name) LIKE ?", "%#{search_query}%") : email_sequences_all
  end

  landing_pages = landing_pages_all.limit(max_display)
  app_modules = app_modules_all.respond_to?(:limit) ? app_modules_all.limit(max_display) : app_modules_all.first(max_display)
  automations = automations_all.respond_to?(:limit) ? automations_all.limit(max_display) : automations_all.first(max_display)
  websites = websites_all.respond_to?(:limit) ? websites_all.limit(max_display) : websites_all.first(max_display)
  web_apps = web_apps_all.respond_to?(:limit) ? web_apps_all.limit(max_display) : web_apps_all.first(max_display)
  apps = apps_all.respond_to?(:limit) ? apps_all.limit(max_display) : apps_all.first(max_display)
  email_sequences = email_sequences_all.respond_to?(:limit) ? email_sequences_all.limit(max_display) : email_sequences_all.first(max_display)
  
  # Separate grouped vs standalone modules
  grouped_module_ids = (apps.respond_to?(:flat_map) ? apps.flat_map { |a| a.app_modules.map(&:id) } : []) rescue []
  standalone_modules = app_modules.respond_to?(:reject) ? app_modules.reject { |m| grouped_module_ids.include?(m.id) } : (app_modules.to_a.reject { |m| grouped_module_ids.include?(m.id) } rescue [])
  
  # Group automations by parent context
  automation_list = automations.respond_to?(:to_a) ? automations.to_a : automations
  automations_by_app = automation_list.select { |a| a.respond_to?(:web_app_id) && a.web_app_id.present? }.group_by(&:web_app_id) rescue {}
  automations_by_module = automation_list.select { |a| a.respond_to?(:app_module_id) && a.app_module_id.present? && (!a.respond_to?(:web_app_id) || a.web_app_id.blank?) }.group_by(&:app_module_id) rescue {}
  grouped_auto_ids = (automations_by_app.values.flatten.map(&:id) + automations_by_module.values.flatten.map(&:id)) rescue []
  standalone_automations = automation_list.reject { |a| grouped_auto_ids.include?(a.id) }
  
  # Smart-group standalone automations by name prefix (e.g., "Welcome Email - Day 1/3/7")
  prefix_groups = {}
  truly_standalone = []
  standalone_automations.each do |auto|
    name = auto.name.to_s
    # Match patterns like "Name - Day X", "Name - Step X", "Name (Part X)"
    if name.match?(/\s*[-–]\s*(day|step|part|phase)\s*\d/i) || name.match?(/\s*\(\s*(part|step)\s*\d/i)
      prefix = name.sub(/\s*[-–]\s*(day|step|part|phase)\s*\d.*$/i, '').sub(/\s*\(\s*(part|step)\s*\d.*$/i, '').strip
      (prefix_groups[prefix] ||= []) << auto
    else
      truly_standalone << auto
    end
  end
  # Only keep prefix groups with 2+ items, otherwise treat as standalone
  prefix_groups.each do |prefix, items|
    if items.size < 2
      truly_standalone.concat(items)
    end
  end
  prefix_groups.reject! { |_, items| items.size < 2 }

  # ── Stats (user's own + entity-shared) ──
  my_landing_pages = entity.landing_pages.visible_to_user(current_user)
  total_landing_pages = my_landing_pages.count rescue 0
  published_landing_pages = my_landing_pages.where(status: 'published').count rescue 0
  draft_landing_pages = total_landing_pages - published_landing_pages
  total_submissions = (my_landing_pages.joins("LEFT JOIN landing_page_submissions ON landing_page_submissions.landing_page_id = landing_pages.id").count("landing_page_submissions.id") rescue 0)

  my_app_modules = entity.app_modules.visible_to(current_user) rescue entity.app_modules
  total_app_modules = (my_app_modules.count rescue 0)
  active_app_modules = (my_app_modules.where(status: 'active').count rescue 0)
  deployed_app_modules = (my_app_modules.where.not(deployed_at: nil).count rescue 0)

  my_automations = entity.automation_codes.visible_to_user(current_user)
  total_automations = (my_automations.count rescue 0)
  active_automations = (my_automations.where(status: 'active').count rescue 0)
  total_executions = (my_automations.sum(:execution_count) rescue 0)
  total_successes = (my_automations.sum(:success_count) rescue 0)
  avg_success_rate = total_executions > 0 ? ((total_successes.to_f / total_executions) * 100).round(1) : 0

  my_websites = entity.websites.visible_to_user(current_user)
  total_websites = (my_websites.count rescue 0)
  published_websites = (my_websites.where(status: 'published').count rescue 0)

  my_web_apps = entity.web_apps.visible_to_user(current_user)
  total_web_apps = (my_web_apps.count rescue 0)
  active_web_apps = (my_web_apps.where(status: 'active').count rescue 0)
  total_web_app_modules = (my_web_apps.joins(:web_app_modules).count rescue 0)

  total_apps = (entity.apps.visible_to_user(current_user).count rescue 0)
  
  total_email_sequences = (entity.email_sequences.count rescue 0)
  active_email_sequences = (entity.email_sequences.where(status: 'active').count rescue 0)

  total_items = total_landing_pages + total_app_modules + total_automations + total_websites + total_web_apps + total_email_sequences

  filter_type = data[:type] || data['type'] || 'all'
  filter_status = data[:status] || data['status'] || 'all'
%>

<div class="my-creations-canvas" id="my-creations-<%= SecureRandom.hex(4) %>">
  <!-- Header -->
  <div class="creations-header d-flex justify-content-between align-items-center p-3 border-bottom">
    <div class="d-flex align-items-center gap-3">
      <div class="header-icon-wrap">
        <i data-lucide="layout-dashboard" style="width: 22px; height: 22px;"></i>
      </div>
      <div>
        <h5 class="mb-0 fw-semibold">My Projects & Assets</h5>
        <small class="text-muted">Everything you've built in one place</small>
      </div>
    </div>
    <div class="d-flex align-items-center gap-2">
      <div class="position-relative">
        <i data-lucide="search" class="position-absolute" style="width: 16px; height: 16px; left: 10px; top: 50%; transform: translateY(-50%); opacity: 0.4;"></i>
        <input type="text" placeholder="Search..." id="creations-search" class="form-control form-control-sm" style="padding-left: 32px; width: 180px;" value="<%= search_query %>">
      </div>
      <button type="button" class="btn btn-sm btn-primary" id="create-new-btn">
        <i data-lucide="plus" style="width: 16px; height: 16px;" class="me-1"></i>Create
      </button>
    </div>
  </div>

  <!-- Tab Navigation -->
  <div class="creations-tabs px-3 pt-2 border-bottom">
    <ul class="nav nav-tabs border-0" id="asset-tabs">
      <li class="nav-item">
        <button type="button" class="nav-link asset-tab <%= 'active' if filter_type == 'all' %>" data-filter="all">
          All <span class="badge bg-secondary bg-opacity-25 text-body ms-1"><%= total_items %></span>
        </button>
      </li>
      <li class="nav-item">
        <button type="button" class="nav-link asset-tab <%= 'active' if filter_type == 'landing_page' %>" data-filter="landing_page">
          <i data-lucide="file-text" style="width: 14px; height: 14px;" class="me-1"></i>Pages <span class="badge bg-secondary bg-opacity-25 text-body ms-1"><%= total_landing_pages %></span>
        </button>
      </li>
      <li class="nav-item">
        <button type="button" class="nav-link asset-tab <%= 'active' if filter_type == 'web_app' %>" data-filter="web_app">
          <i data-lucide="app-window" style="width: 14px; height: 14px;" class="me-1"></i>Web Apps <span class="badge bg-secondary bg-opacity-25 text-body ms-1"><%= total_web_apps %></span>
        </button>
      </li>
      <li class="nav-item">
        <button type="button" class="nav-link asset-tab <%= 'active' if filter_type == 'app_module' %>" data-filter="app_module">
          <i data-lucide="boxes" style="width: 14px; height: 14px;" class="me-1"></i>Modules <span class="badge bg-secondary bg-opacity-25 text-body ms-1"><%= total_app_modules %></span>
        </button>
      </li>
      <% if total_websites > 0 %>
        <li class="nav-item">
          <button type="button" class="nav-link asset-tab <%= 'active' if filter_type == 'website' %>" data-filter="website">
            <i data-lucide="globe" style="width: 14px; height: 14px;" class="me-1"></i>Sites <span class="badge bg-secondary bg-opacity-25 text-body ms-1"><%= total_websites %></span>
          </button>
        </li>
      <% end %>
      <li class="nav-item">
        <button type="button" class="nav-link asset-tab <%= 'active' if filter_type == 'automation' %>" data-filter="automation">
          <i data-lucide="zap" style="width: 14px; height: 14px;" class="me-1"></i>Automations <span class="badge bg-secondary bg-opacity-25 text-body ms-1"><%= total_automations + total_email_sequences %></span>
        </button>
      </li>
    </ul>
  </div>

  <!-- Scrollable Content Area -->
  <div class="creations-body p-3" style="flex: 1; overflow-y: auto;">

    <!-- ════════════════════════════════════════════════ -->
    <!-- Stats Cards - contextual per tab                -->
    <!-- ════════════════════════════════════════════════ -->
    <div class="stats-row row g-2 mb-3" data-stats="all">
      <div class="col-6 col-lg-3">
        <div class="stat-card card border-0 shadow-sm h-100"><div class="card-body py-2 px-3 text-center">
          <p class="text-muted small mb-0">Total Assets</p><h5 class="mb-0 fw-bold"><%= total_items %></h5>
        </div></div>
      </div>
      <div class="col-6 col-lg-3">
        <div class="stat-card card border-0 shadow-sm h-100"><div class="card-body py-2 px-3 text-center">
          <p class="text-muted small mb-0">Landing Pages</p><h5 class="mb-0 fw-bold"><%= total_landing_pages %></h5>
        </div></div>
      </div>
      <div class="col-6 col-lg-3">
        <div class="stat-card card border-0 shadow-sm h-100"><div class="card-body py-2 px-3 text-center">
          <p class="text-muted small mb-0">Apps</p><h5 class="mb-0 fw-bold"><%= total_app_modules %></h5>
        </div></div>
      </div>
      <div class="col-6 col-lg-3">
        <div class="stat-card card border-0 shadow-sm h-100"><div class="card-body py-2 px-3 text-center">
          <p class="text-muted small mb-0">Automations</p><h5 class="mb-0 fw-bold"><%= total_automations %></h5>
        </div></div>
      </div>
    </div>

    <div class="stats-row row g-2 mb-3" data-stats="landing_page" style="display: none;">
      <div class="col-6 col-lg-3"><div class="stat-card card border-0 shadow-sm h-100"><div class="card-body py-2 px-3 text-center"><p class="text-muted small mb-0">Total</p><h5 class="mb-0 fw-bold text-primary"><%= total_landing_pages %></h5></div></div></div>
      <div class="col-6 col-lg-3"><div class="stat-card card border-0 shadow-sm h-100"><div class="card-body py-2 px-3 text-center"><p class="text-muted small mb-0">Published</p><h5 class="mb-0 fw-bold text-success"><%= published_landing_pages %></h5></div></div></div>
      <div class="col-6 col-lg-3"><div class="stat-card card border-0 shadow-sm h-100"><div class="card-body py-2 px-3 text-center"><p class="text-muted small mb-0">Drafts</p><h5 class="mb-0 fw-bold text-warning"><%= draft_landing_pages %></h5></div></div></div>
      <div class="col-6 col-lg-3"><div class="stat-card card border-0 shadow-sm h-100"><div class="card-body py-2 px-3 text-center"><p class="text-muted small mb-0">Submissions</p><h5 class="mb-0 fw-bold text-info"><%= total_submissions %></h5></div></div></div>
    </div>

    <div class="stats-row row g-2 mb-3" data-stats="app_module" style="display: none;">
      <div class="col-6 col-lg-3"><div class="stat-card card border-0 shadow-sm h-100"><div class="card-body py-2 px-3 text-center"><p class="text-muted small mb-0">Total Apps</p><h5 class="mb-0 fw-bold text-primary"><%= total_app_modules %></h5></div></div></div>
      <div class="col-6 col-lg-3"><div class="stat-card card border-0 shadow-sm h-100"><div class="card-body py-2 px-3 text-center"><p class="text-muted small mb-0">Active</p><h5 class="mb-0 fw-bold text-success"><%= active_app_modules %></h5></div></div></div>
      <div class="col-6 col-lg-3"><div class="stat-card card border-0 shadow-sm h-100"><div class="card-body py-2 px-3 text-center"><p class="text-muted small mb-0">Deployed</p><h5 class="mb-0 fw-bold text-info"><%= deployed_app_modules %></h5></div></div></div>
      <div class="col-6 col-lg-3"><div class="stat-card card border-0 shadow-sm h-100"><div class="card-body py-2 px-3 text-center"><p class="text-muted small mb-0">Draft</p><h5 class="mb-0 fw-bold text-warning"><%= total_app_modules - active_app_modules %></h5></div></div></div>
    </div>

    <div class="stats-row row g-2 mb-3" data-stats="automation" style="display: none;">
      <div class="col-6 col-lg-3"><div class="stat-card card border-0 shadow-sm h-100"><div class="card-body py-2 px-3 text-center"><p class="text-muted small mb-0">Automations</p><h5 class="mb-0 fw-bold text-primary"><%= total_automations %></h5></div></div></div>
      <div class="col-6 col-lg-3"><div class="stat-card card border-0 shadow-sm h-100"><div class="card-body py-2 px-3 text-center"><p class="text-muted small mb-0">Sequences</p><h5 class="mb-0 fw-bold" style="color: #a855f7;"><%= total_email_sequences %></h5></div></div></div>
      <div class="col-6 col-lg-3"><div class="stat-card card border-0 shadow-sm h-100"><div class="card-body py-2 px-3 text-center"><p class="text-muted small mb-0">Executions</p><h5 class="mb-0 fw-bold text-info"><%= total_executions %></h5></div></div></div>
      <div class="col-6 col-lg-3"><div class="stat-card card border-0 shadow-sm h-100"><div class="card-body py-2 px-3 text-center"><p class="text-muted small mb-0">Success</p><h5 class="mb-0 fw-bold <%= avg_success_rate >= 95 ? 'text-success' : avg_success_rate >= 80 ? 'text-warning' : 'text-danger' %>"><%= avg_success_rate %>%</h5></div></div></div>
    </div>

    <div class="stats-row row g-2 mb-3" data-stats="web_app" style="display: none;">
      <div class="col-6 col-lg-3"><div class="stat-card card border-0 shadow-sm h-100"><div class="card-body py-2 px-3 text-center"><p class="text-muted small mb-0">Total Web Apps</p><h5 class="mb-0 fw-bold text-primary"><%= total_web_apps %></h5></div></div></div>
      <div class="col-6 col-lg-3"><div class="stat-card card border-0 shadow-sm h-100"><div class="card-body py-2 px-3 text-center"><p class="text-muted small mb-0">Active</p><h5 class="mb-0 fw-bold text-success"><%= active_web_apps %></h5></div></div></div>
      <div class="col-6 col-lg-3"><div class="stat-card card border-0 shadow-sm h-100"><div class="card-body py-2 px-3 text-center"><p class="text-muted small mb-0">Connected Modules</p><h5 class="mb-0 fw-bold text-info"><%= total_web_app_modules %></h5></div></div></div>
      <div class="col-6 col-lg-3"><div class="stat-card card border-0 shadow-sm h-100"><div class="card-body py-2 px-3 text-center"><p class="text-muted small mb-0">Draft</p><h5 class="mb-0 fw-bold text-warning"><%= total_web_apps - active_web_apps %></h5></div></div></div>
    </div>


    <!-- ════════════════════════════════════════════════ -->
    <!-- SECTION: Landing Pages (Card Grid)              -->
    <!-- ════════════════════════════════════════════════ -->
    <div class="section-block" data-section="landing_page">
      <% if filter_type == 'all' && total_landing_pages > 0 %>
        <div class="section-header d-flex align-items-center justify-content-between mb-2">
          <h6 class="mb-0 fw-semibold text-muted text-uppercase" style="font-size: 0.75rem; letter-spacing: 0.5px;">
            <i data-lucide="file-text" style="width: 14px; height: 14px;" class="me-1"></i>Landing Pages
          </h6>
          <button type="button" class="btn btn-link btn-sm text-muted p-0 view-all-btn" data-filter="landing_page" style="font-size: 0.75rem;">View all (<%= total_landing_pages %>)</button>
        </div>
      <% end %>

      <% if landing_pages.any? %>
        <div class="lp-grid mb-4">
          <% landing_pages.each do |lp| %>
            <div class="creation-card card border-0 shadow-sm" 
                 data-id="<%= lp.id %>" data-type="landing_page"
                 data-status="<%= lp.status == 'published' ? 'published' : 'draft' %>"
                 data-title="<%= lp.title.downcase %>">
              <div class="creation-preview">
                <% if lp.html_content.present? && lp.html_content.strip.length > 100 %>
                  <div class="preview-iframe-container">
                    <% 
                      preview_html = lp.html_content.to_s
                      error_hide_css = '<style>html,body{margin:0!important;padding:0!important;overflow:hidden!important;background:#fff!important}*{animation:none!important;transition:none!important}.error,.alert,.alert-danger,.flash,[class*="error"],[class*="Error"],#error-page,.rails-default-error-page{display:none!important}</style>'
                      if preview_html.include?('<head>')
                        preview_html = preview_html.sub(/<head[^>]*>/i, "\\0<base href=\"#{request.base_url}/\">#{error_hide_css}")
                      elsif preview_html.include?('<html')
                        preview_html = preview_html.sub(/<html[^>]*>/i, "\\0<head><base href=\"#{request.base_url}/\">#{error_hide_css}</head>")
                      else
                        preview_html = "<!DOCTYPE html><html><head><base href=\"#{request.base_url}/\">#{error_hide_css}</head><body style=\"background:#fff;\">#{preview_html}</body></html>"
                      end
                    %>
                    <iframe srcdoc="<%= raw preview_html.gsub('"', '&quot;').gsub("'", '&#39;') %>"
                      sandbox="allow-same-origin allow-scripts" scrolling="no"
                      class="preview-iframe" loading="lazy"></iframe>
                  </div>
                <% else %>
                  <div class="preview-placeholder landing-page">
                    <i data-lucide="file-text" style="width: 28px; height: 28px;"></i>
                  </div>
                <% end %>
                <span class="status-badge <%= lp.status == 'published' ? 'published' : 'draft' %>">
                  <%= lp.status == 'published' ? 'Published' : 'Draft' %>
                </span>
              </div>
              <div class="card-body py-2 px-3">
                <h6 class="mb-1 fw-semibold text-truncate" style="font-size: 0.85rem;"><%= lp.title.truncate(40) %></h6>
                <div class="d-flex align-items-center gap-2 text-muted" style="font-size: 0.7rem;">
                  <span><%= lp.updated_at.strftime('%b %d') %></span>
                  <% subs = (lp.landing_page_submissions.count rescue 0) %>
                  <% if subs > 0 %><span class="text-info"><i data-lucide="inbox" style="width: 11px; height: 11px;" class="me-1"></i><%= subs %></span><% end %>
                </div>
              </div>
              <div class="card-footer bg-transparent border-top d-flex gap-1 p-2">
                <button type="button" class="btn btn-sm btn-outline-secondary flex-fill action-btn edit-btn" data-id="<%= lp.id %>" data-type="landing_page">
                  <i data-lucide="edit-2" style="width: 12px; height: 12px;" class="me-1"></i>Edit
                </button>
                <button type="button" class="btn btn-sm btn-outline-secondary flex-fill action-btn preview-btn" data-id="<%= lp.id %>" data-type="landing_page">
                  <i data-lucide="eye" style="width: 12px; height: 12px;" class="me-1"></i>View
                </button>
                <button type="button" class="btn btn-sm <%= lp.shared_with_entity? ? 'btn-info' : 'btn-outline-secondary' %> share-toggle-btn" 
                        data-id="<%= lp.id %>" data-asset-type="landing_page" data-shared="<%= lp.shared_with_entity? %>"
                        title="<%= lp.shared_with_entity? ? 'Shared with team — click to make private' : 'Private — click to share with team' %>">
                  <i data-lucide="<%= lp.shared_with_entity? ? 'users' : 'lock' %>" style="width: 12px; height: 12px;"></i>
                </button>
                <button type="button" class="btn btn-sm btn-outline-secondary action-btn more-btn" data-id="<%= lp.id %>" data-type="landing_page">
                  <i data-lucide="more-horizontal" style="width: 12px; height: 12px;"></i>
                </button>
              </div>
            </div>
          <% end %>
        </div>
      <% elsif filter_type == 'landing_page' %>
        <div class="text-center py-4 text-muted"><p>No landing pages yet. Ask Amos to create one!</p></div>
      <% end %>
    </div>


    <!-- ════════════════════════════════════════════════ -->
    <!-- SECTION: Websites (Card Grid - like landing pages) -->
    <!-- ════════════════════════════════════════════════ -->
    <div class="section-block" data-section="website">
      <% if filter_type == 'all' && total_websites > 0 %>
        <div class="section-header d-flex align-items-center justify-content-between mb-2">
          <h6 class="mb-0 fw-semibold text-muted text-uppercase" style="font-size: 0.75rem; letter-spacing: 0.5px;">
            <i data-lucide="globe" style="width: 14px; height: 14px;" class="me-1"></i>Websites
          </h6>
          <button type="button" class="btn btn-link btn-sm text-muted p-0 view-all-btn" data-filter="website" style="font-size: 0.75rem;">View all (<%= total_websites %>)</button>
        </div>
      <% end %>

      <% if websites.respond_to?(:each) && websites.any? %>
        <div class="lp-grid mb-4">
          <% websites.each do |site| %>
            <div class="creation-card card border-0 shadow-sm"
                 data-id="<%= site.id %>" data-type="website"
                 data-status="<%= site.status == 'published' ? 'published' : 'draft' %>"
                 data-title="<%= site.name.downcase rescue '' %>">
              <div class="creation-preview">
                <div class="preview-placeholder website">
                  <i data-lucide="globe" style="width: 28px; height: 28px;"></i>
                  <span style="font-size: 0.7rem; color: rgba(255,255,255,0.7);"><%= (site.website_pages.count rescue 0) %> pages</span>
                </div>
                <span class="status-badge <%= site.status == 'published' ? 'published' : 'draft' %>">
                  <%= site.status&.titleize || 'Draft' %>
                </span>
              </div>
              <div class="card-body py-2 px-3">
                <h6 class="mb-1 fw-semibold text-truncate" style="font-size: 0.85rem;"><%= site.name.truncate(40) rescue 'Untitled' %></h6>
                <div class="d-flex align-items-center gap-2 text-muted" style="font-size: 0.7rem;">
                  <span><%= site.updated_at.strftime('%b %d') rescue '' %></span>
                  <% if site.subdomain.present? %>
                    <span class="text-info"><i data-lucide="link" style="width: 10px; height: 10px;" class="me-1"></i><%= site.subdomain %></span>
                  <% end %>
                </div>
              </div>
              <div class="card-footer bg-transparent border-top d-flex gap-1 p-2">
                <button type="button" class="btn btn-sm btn-outline-secondary flex-fill action-btn website-edit-btn" data-id="<%= site.id %>" data-slug="<%= site.slug %>">
                  <i data-lucide="edit-2" style="width: 12px; height: 12px;" class="me-1"></i>Edit
                </button>
                <% if site.subdomain.present? || site.respond_to?(:custom_domain) && site.custom_domain.present? %>
                  <a href="<%= site.public_url %>" target="_blank" class="btn btn-sm btn-outline-secondary flex-fill">
                    <i data-lucide="external-link" style="width: 12px; height: 12px;" class="me-1"></i>Visit
                  </a>
                <% end %>
                <button type="button" class="btn btn-sm <%= site.shared_with_entity? ? 'btn-info' : 'btn-outline-secondary' %> share-toggle-btn"
                        data-id="<%= site.id %>" data-asset-type="website" data-shared="<%= site.shared_with_entity? %>"
                        title="<%= site.shared_with_entity? ? 'Shared — make private' : 'Private — share with team' %>">
                  <i data-lucide="<%= site.shared_with_entity? ? 'users' : 'lock' %>" style="width: 12px; height: 12px;"></i>
                </button>
              </div>
            </div>
          <% end %>
        </div>
      <% elsif filter_type == 'website' %>
        <div class="text-center py-4 text-muted"><p>No websites yet. Ask Amos to build one!</p></div>
      <% end %>
    </div>


    <!-- ════════════════════════════════════════════════ -->
    <!-- SECTION: Web Apps (Expandable Project View)     -->
    <!-- ════════════════════════════════════════════════ -->
    <div class="section-block" data-section="web_app">
      <% if filter_type == 'all' && total_web_apps > 0 %>
        <div class="section-header d-flex align-items-center justify-content-between mb-2">
          <h6 class="mb-0 fw-semibold text-muted text-uppercase" style="font-size: 0.75rem; letter-spacing: 0.5px;">
            <i data-lucide="app-window" style="width: 14px; height: 14px;" class="me-1"></i>Web Apps
          </h6>
          <button type="button" class="btn btn-link btn-sm text-muted p-0 view-all-btn" data-filter="web_app" style="font-size: 0.75rem;">View all (<%= total_web_apps %>)</button>
        </div>
      <% end %>

      <% if web_apps.respond_to?(:each) && web_apps.any? %>
        <div class="project-list mb-4">
          <% web_apps.each do |wa| %>
            <%
              wa_website = wa.website rescue nil
              wa_pages = wa_website&.website_pages || []
              wa_modules = wa.app_modules rescue []
              wa_auth_methods = (wa.auth_methods rescue []) || []
              wa_module_count = wa_modules.size
              wa_page_count = wa_pages.size
              wa_url = wa.public_url rescue nil
            %>
            <div class="project-card card border-0 shadow-sm mb-2" data-type="web_app" data-id="<%= wa.id %>"
                 data-status="<%= wa.status == 'active' ? 'published' : 'draft' %>"
                 data-title="<%= wa.name.downcase rescue '' %>">
              <!-- Web App Header (always visible) -->
              <div class="card-body py-2 px-3">
                <div class="d-flex align-items-center gap-3">
                  <div class="project-icon rounded-2 d-flex align-items-center justify-content-center flex-shrink-0" 
                       style="width: 38px; height: 38px; background: linear-gradient(135deg, #0ea5e9 0%, #0284c7 100%);">
                    <i data-lucide="app-window" style="width: 18px; height: 18px; color: white;"></i>
                  </div>
                  <div class="flex-grow-1 min-width-0">
                    <div class="d-flex align-items-center gap-2">
                      <h6 class="mb-0 fw-semibold text-truncate" style="font-size: 0.9rem;"><%= wa.name rescue 'Untitled App' %></h6>
                      <span class="badge rounded-pill <%= wa.status == 'active' ? 'bg-success' : 'bg-secondary' %>" style="font-size: 0.6rem;"><%= wa.status&.titleize || 'Draft' %></span>
                      <% if wa_url.present? && wa.status == 'active' %>
                        <a href="<%= wa_url %>" target="_blank" class="badge rounded-pill bg-info text-decoration-none" style="font-size: 0.6rem;">
                          <i data-lucide="external-link" style="width: 9px; height: 9px;" class="me-1"></i>Live
                        </a>
                      <% end %>
                    </div>
                    <div class="d-flex align-items-center gap-3 text-muted" style="font-size: 0.7rem;">
                      <% if wa.subdomain.present? %>
                        <span><i data-lucide="link" style="width: 10px; height: 10px;" class="me-1"></i><%= wa.subdomain %>.app.amoslabs.com</span>
                      <% end %>
                      <% if wa.respond_to?(:description) && wa.description.present? %>
                        <span><%= wa.description.to_s.truncate(50) %></span>
                      <% end %>
                    </div>
                  </div>
                  <div class="d-flex align-items-center gap-3 flex-shrink-0">
                    <div class="d-flex align-items-center gap-2 text-muted" style="font-size: 0.7rem;">
                      <% if wa_page_count > 0 %><span title="Pages"><i data-lucide="file-text" style="width: 12px; height: 12px;"></i> <%= wa_page_count %></span><% end %>
                      <% if wa_module_count > 0 %><span title="Modules"><i data-lucide="boxes" style="width: 12px; height: 12px;"></i> <%= wa_module_count %></span><% end %>
                      <% if wa_auth_methods.any? %><span title="Auth enabled"><i data-lucide="shield" style="width: 12px; height: 12px;"></i></span><% end %>
                    </div>
                    <button type="button" class="btn btn-sm btn-outline-secondary project-expand-btn" data-bs-toggle="collapse" data-bs-target="#webapp-<%= wa.id %>">
                      <i data-lucide="chevron-down" style="width: 14px; height: 14px;"></i>
                    </button>
                  </div>
                </div>
              </div>

              <!-- Expandable Detail -->
              <div class="collapse" id="webapp-<%= wa.id %>">
                <div class="card-body pt-0 px-3 pb-3">
                  <div class="component-grid border-top pt-2 mt-1">

                    <% if wa_website.present? %>
                      <div class="component-group mb-2">
                        <div class="component-label text-muted text-uppercase fw-semibold mb-1" style="font-size: 0.65rem; letter-spacing: 0.5px;">
                          <i data-lucide="globe" style="width: 12px; height: 12px;" class="me-1"></i>Website (<%= wa_page_count %> pages)
                        </div>
                        <div class="d-flex flex-wrap gap-1">
                          <% wa_pages.each do |page| %>
                            <span class="btn btn-sm component-chip component-chip-muted">
                              <i data-lucide="<%= page.is_homepage ? 'home' : page.template == 'form' ? 'clipboard-list' : page.template == 'list' ? 'list' : 'file-text' %>" style="width: 12px; height: 12px;" class="me-1"></i>
                              <%= page.name || page.slug&.titleize || 'Page' %>
                              <span class="chip-type"><%= page.template %></span>
                            </span>
                          <% end %>
                        </div>
                      </div>
                    <% end %>

                    <% if wa_modules.any? %>
                      <div class="component-group mb-2">
                        <div class="component-label text-muted text-uppercase fw-semibold mb-1" style="font-size: 0.65rem; letter-spacing: 0.5px;">
                          <i data-lucide="boxes" style="width: 12px; height: 12px;" class="me-1"></i>Connected Modules
                        </div>
                        <div class="d-flex flex-wrap gap-1">
                          <% wa_modules.each do |mod| %>
                            <button type="button" class="btn btn-sm component-chip canvas-link"
                                    data-slug="<%= mod.slug %>" data-canvas-slug="<%= mod.slug %>_list" data-module-id="<%= mod.id %>">
                              <i data-lucide="<%= mod.icon.present? ? mod.icon : 'box' %>" style="width: 12px; height: 12px;" class="me-1"></i>
                              <%= mod.name %>
                              <span class="badge rounded-pill <%= mod.status == 'active' ? 'bg-success' : 'bg-secondary' %>" style="font-size: 0.5rem; padding: 1px 4px;"><%= mod.status&.titleize %></span>
                            </button>
                          <% end %>
                        </div>
                      </div>
                    <% end %>

                    <% if wa_auth_methods.any? %>
                      <div class="component-group mb-2">
                        <div class="component-label text-muted text-uppercase fw-semibold mb-1" style="font-size: 0.65rem; letter-spacing: 0.5px;">
                          <i data-lucide="shield" style="width: 12px; height: 12px;" class="me-1"></i>Authentication
                        </div>
                        <div class="d-flex flex-wrap gap-1">
                          <% wa_auth_methods.each do |method| %>
                            <span class="btn btn-sm component-chip component-chip-muted">
                              <i data-lucide="<%= method == 'google' ? 'chrome' : method == 'github' ? 'github' : method == 'magic_link' ? 'wand-2' : 'key' %>" style="width: 12px; height: 12px;" class="me-1"></i>
                              <%= method.titleize %>
                            </span>
                          <% end %>
                        </div>
                      </div>
                    <% end %>

                    <% if wa_module_count == 0 && wa_page_count == 0 %>
                      <p class="text-muted small mb-0">No components yet. Ask Amos to add modules and pages to this app.</p>
                    <% end %>

                    <div class="d-flex gap-2 mt-2 pt-2 border-top">
                      <% if wa_url.present? %>
                        <a href="<%= wa_url %>" target="_blank" class="btn btn-sm btn-outline-primary">
                          <i data-lucide="external-link" style="width: 12px; height: 12px;" class="me-1"></i>Open App
                        </a>
                      <% end %>
                      <button type="button" class="btn btn-sm btn-outline-secondary web-app-edit-btn" data-id="<%= wa.id %>" data-slug="<%= wa.slug %>">
                        <i data-lucide="settings" style="width: 12px; height: 12px;" class="me-1"></i>Manage
                      </button>
                      <button type="button" class="btn btn-sm <%= wa.shared_with_entity? ? 'btn-info' : 'btn-outline-secondary' %> share-toggle-btn"
                              data-id="<%= wa.id %>" data-asset-type="web_app" data-shared="<%= wa.shared_with_entity? %>"
                              title="<%= wa.shared_with_entity? ? 'Shared — make private' : 'Private — share with team' %>">
                        <i data-lucide="<%= wa.shared_with_entity? ? 'users' : 'lock' %>" style="width: 12px; height: 12px;"></i>
                      </button>
                      <span class="text-muted small align-self-center">Updated <%= wa.updated_at.strftime('%b %d, %Y') rescue 'N/A' %></span>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          <% end %>
        </div>
      <% elsif filter_type == 'web_app' %>
        <div class="text-center py-4 text-muted"><p>No web apps yet. Ask Amos to build one!</p></div>
      <% end %>
    </div>


    <!-- ════════════════════════════════════════════════ -->
    <!-- SECTION: App Modules (Grouped under Apps + Standalone) -->
    <!-- ════════════════════════════════════════════════ -->
    <div class="section-block" data-section="app_module">
      <% if filter_type == 'all' && total_app_modules > 0 %>
        <div class="section-header d-flex align-items-center justify-content-between mb-2">
          <h6 class="mb-0 fw-semibold text-muted text-uppercase" style="font-size: 0.75rem; letter-spacing: 0.5px;">
            <i data-lucide="boxes" style="width: 14px; height: 14px;" class="me-1"></i>Apps & Modules
          </h6>
          <button type="button" class="btn btn-link btn-sm text-muted p-0 view-all-btn" data-filter="app_module" style="font-size: 0.75rem;">View all (<%= total_app_modules %>)</button>
        </div>
      <% end %>

      <% has_any_modules = (apps.respond_to?(:any?) && apps.any?) || standalone_modules.any? %>
      <% if has_any_modules %>
        <div class="project-list mb-4">

          <%# ── Grouped Apps (parent App → child modules) ── %>
          <% if apps.respond_to?(:each) %>
            <% apps.each do |parent_app| %>
              <% app_mods = parent_app.app_modules.to_a rescue [] %>
              <% next if app_mods.empty? && search_query.present? %>
              <div class="project-card card border-0 shadow-sm mb-2" data-type="app_module"
                   data-status="<%= parent_app.status == 'active' ? 'published' : 'draft' %>"
                   data-title="<%= parent_app.name.downcase rescue '' %>">
                <div class="card-body py-2 px-3">
                  <div class="d-flex align-items-center gap-3">
                    <div class="project-icon rounded-2 d-flex align-items-center justify-content-center flex-shrink-0"
                         style="width: 38px; height: 38px; background: linear-gradient(135deg, #6366f1 0%, #4f46e5 100%);">
                      <i data-lucide="<%= parent_app.respond_to?(:icon) && parent_app.icon.present? ? parent_app.icon : 'grid' %>" style="width: 18px; height: 18px; color: white;"></i>
                    </div>
                    <div class="flex-grow-1 min-width-0">
                      <div class="d-flex align-items-center gap-2">
                        <h6 class="mb-0 fw-semibold text-truncate" style="font-size: 0.9rem;"><%= parent_app.name %></h6>
                        <span class="badge rounded-pill <%= parent_app.status == 'active' ? 'bg-success' : 'bg-secondary' %>" style="font-size: 0.6rem;"><%= parent_app.status&.titleize || 'Draft' %></span>
                        <span class="badge rounded-pill bg-primary bg-opacity-25 text-primary" style="font-size: 0.6rem;"><%= app_mods.size %> modules</span>
                      </div>
                      <div class="text-muted" style="font-size: 0.7rem;"><%= parent_app.description.to_s.truncate(80) %></div>
                    </div>
                    <div class="d-flex align-items-center gap-2 flex-shrink-0">
                      <button type="button" class="btn btn-sm btn-outline-secondary project-expand-btn" data-bs-toggle="collapse" data-bs-target="#app-<%= parent_app.id %>">
                        <i data-lucide="chevron-down" style="width: 14px; height: 14px;"></i>
                      </button>
                    </div>
                  </div>
                </div>

                <div class="collapse" id="app-<%= parent_app.id %>">
                  <div class="card-body pt-0 px-3 pb-3">
                    <div class="border-top pt-2 mt-1">
                      <% app_mods.each do |mod| %>
                        <%
                          canvases = mod.module_canvases rescue []
                          models = (mod.module_codes.select { |c| c.code_type == 'model' } rescue [])
                          tools = mod.tool_definitions rescue []
                        %>
                        <div class="d-flex align-items-center gap-2 py-1 px-2 rounded-1 module-sub-row" style="cursor: pointer;"
                             data-module-slug="<%= mod.slug %>" data-module-id="<%= mod.id %>">
                          <i data-lucide="<%= mod.icon.present? ? mod.icon : 'box' %>" style="width: 14px; height: 14px; color: #8b5cf6;"></i>
                          <span class="fw-medium" style="font-size: 0.82rem;"><%= mod.name %></span>
                          <span class="badge rounded-pill <%= mod.status == 'active' ? 'bg-success' : 'bg-secondary' %>" style="font-size: 0.5rem; padding: 1px 4px;"><%= mod.status&.titleize %></span>
                          <% if mod.is_primary %><span class="badge rounded-pill bg-info bg-opacity-25 text-info" style="font-size: 0.5rem;">Primary</span><% end %>
                          <span class="ms-auto d-flex align-items-center gap-2 text-muted" style="font-size: 0.65rem;">
                            <% if canvases.any? %><span title="Views"><i data-lucide="layout" style="width: 10px; height: 10px;"></i> <%= canvases.size %></span><% end %>
                            <% if models.any? %><span title="Models"><i data-lucide="database" style="width: 10px; height: 10px;"></i> <%= models.size %></span><% end %>
                            <% if tools.any? %><span title="Tools"><i data-lucide="wrench" style="width: 10px; height: 10px;"></i> <%= tools.size %></span><% end %>
                          </span>
                        </div>
                      <% end %>
                      <div class="d-flex gap-2 mt-2 pt-2 border-top">
                        <% primary_mod = app_mods.find { |m| m.is_primary } || app_mods.first %>
                        <% if primary_mod %>
                          <button type="button" class="btn btn-sm btn-outline-primary canvas-link" data-slug="<%= primary_mod.slug %>" data-canvas-slug="<%= primary_mod.slug %>_list" data-module-id="<%= primary_mod.id %>">
                            <i data-lucide="external-link" style="width: 12px; height: 12px;" class="me-1"></i>Open App
                          </button>
                        <% end %>
                        <button type="button" class="btn btn-sm <%= parent_app.shared_with_entity? ? 'btn-info' : 'btn-outline-secondary' %> share-toggle-btn"
                                data-id="<%= parent_app.id %>" data-asset-type="app" data-shared="<%= parent_app.shared_with_entity? %>"
                                title="<%= parent_app.shared_with_entity? ? 'Shared — make private' : 'Private — share with team' %>">
                          <i data-lucide="<%= parent_app.shared_with_entity? ? 'users' : 'lock' %>" style="width: 12px; height: 12px;"></i>
                        </button>
                        <span class="text-muted small align-self-center">Updated <%= parent_app.updated_at.strftime('%b %d, %Y') rescue 'N/A' %></span>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            <% end %>
          <% end %>

          <%# ── Standalone Modules (no parent App) ── %>
          <% standalone_modules.each do |mod| %>
            <%
              canvases = mod.module_canvases rescue []
              models = (mod.module_codes.select { |c| c.code_type == 'model' } rescue [])
              tools = mod.tool_definitions rescue []
              agents = mod.agent_plugins rescue []
              webhooks = mod.module_webhooks rescue []
              actions = mod.module_actions rescue []
              total_components = canvases.size + models.size + tools.size + agents.size + webhooks.size + actions.size
            %>
            <div class="project-card card border-0 shadow-sm mb-2" data-type="app_module" data-id="<%= mod.id %>"
                 data-status="<%= mod.status == 'active' ? 'published' : 'draft' %>"
                 data-title="<%= mod.name.downcase rescue '' %>">
              <div class="card-body py-2 px-3">
                <div class="d-flex align-items-center gap-3">
                  <div class="project-icon rounded-2 d-flex align-items-center justify-content-center flex-shrink-0" 
                       style="width: 38px; height: 38px; background: linear-gradient(135deg, #8b5cf6 0%, #6d28d9 100%);">
                    <i data-lucide="<%= mod.icon.present? ? mod.icon : 'boxes' %>" style="width: 18px; height: 18px; color: white;"></i>
                  </div>
                  <div class="flex-grow-1 min-width-0">
                    <div class="d-flex align-items-center gap-2">
                      <h6 class="mb-0 fw-semibold text-truncate" style="font-size: 0.9rem;"><%= mod.name rescue 'Untitled Module' %></h6>
                      <span class="badge rounded-pill <%= mod.status == 'active' ? 'bg-success' : 'bg-secondary' %>" style="font-size: 0.6rem;"><%= mod.status&.titleize || 'Draft' %></span>
                    </div>
                    <div class="text-muted" style="font-size: 0.7rem;"><%= mod.description.to_s.truncate(60) %></div>
                  </div>
                  <div class="d-flex align-items-center gap-3 flex-shrink-0">
                    <div class="d-flex align-items-center gap-2 text-muted" style="font-size: 0.7rem;">
                      <% if canvases.any? %><span title="Views"><i data-lucide="layout" style="width: 12px; height: 12px;"></i> <%= canvases.size %></span><% end %>
                      <% if models.any? %><span title="Data Models"><i data-lucide="database" style="width: 12px; height: 12px;"></i> <%= models.size %></span><% end %>
                      <% if tools.any? %><span title="Tools"><i data-lucide="wrench" style="width: 12px; height: 12px;"></i> <%= tools.size %></span><% end %>
                    </div>
                    <button type="button" class="btn btn-sm btn-outline-secondary project-expand-btn" data-bs-toggle="collapse" data-bs-target="#project-<%= mod.id %>">
                      <i data-lucide="chevron-down" style="width: 14px; height: 14px;"></i>
                    </button>
                  </div>
                </div>
              </div>

              <div class="collapse" id="project-<%= mod.id %>">
                <div class="card-body pt-0 px-3 pb-3">
                  <div class="component-grid border-top pt-2 mt-1">
                    <% if canvases.any? %>
                      <div class="component-group mb-2">
                        <div class="component-label text-muted text-uppercase fw-semibold mb-1" style="font-size: 0.65rem; letter-spacing: 0.5px;">
                          <i data-lucide="layout" style="width: 12px; height: 12px;" class="me-1"></i>Views & Canvases
                        </div>
                        <div class="d-flex flex-wrap gap-1">
                          <% canvases.each do |canvas| %>
                            <button type="button" class="btn btn-sm component-chip canvas-link" 
                                    data-slug="<%= mod.slug %>" data-canvas-slug="<%= canvas.slug %>"
                                    data-module-id="<%= mod.id %>" data-canvas-type="<%= canvas.canvas_type %>">
                              <i data-lucide="<%= canvas.canvas_type == 'dashboard' ? 'bar-chart-3' : canvas.canvas_type == 'form' ? 'clipboard-list' : canvas.canvas_type == 'kanban' ? 'columns' : canvas.canvas_type == 'calendar' ? 'calendar' : canvas.canvas_type == 'detail' ? 'file-search' : 'table' %>" style="width: 12px; height: 12px;" class="me-1"></i>
                              <%= canvas.name || canvas.slug.titleize %>
                              <span class="chip-type"><%= canvas.canvas_type %></span>
                            </button>
                          <% end %>
                        </div>
                      </div>
                    <% end %>
                    <% if models.any? %>
                      <div class="component-group mb-2">
                        <div class="component-label text-muted text-uppercase fw-semibold mb-1" style="font-size: 0.65rem; letter-spacing: 0.5px;">
                          <i data-lucide="database" style="width: 12px; height: 12px;" class="me-1"></i>Data Models
                        </div>
                        <div class="d-flex flex-wrap gap-1">
                          <% models.each do |model| %>
                            <span class="btn btn-sm component-chip component-chip-muted">
                              <i data-lucide="table-2" style="width: 12px; height: 12px;" class="me-1"></i><%= model.name %>
                            </span>
                          <% end %>
                        </div>
                      </div>
                    <% end %>
                    <% if tools.any? %>
                      <div class="component-group mb-2">
                        <div class="component-label text-muted text-uppercase fw-semibold mb-1" style="font-size: 0.65rem; letter-spacing: 0.5px;">
                          <i data-lucide="wrench" style="width: 12px; height: 12px;" class="me-1"></i>Tools
                        </div>
                        <div class="d-flex flex-wrap gap-1">
                          <% tools.each do |tool| %>
                            <span class="btn btn-sm component-chip component-chip-muted">
                              <i data-lucide="terminal" style="width: 12px; height: 12px;" class="me-1"></i><%= tool.name %>
                            </span>
                          <% end %>
                        </div>
                      </div>
                    <% end %>
                    <% if agents.any? %>
                      <div class="component-group mb-2">
                        <div class="component-label text-muted text-uppercase fw-semibold mb-1" style="font-size: 0.65rem; letter-spacing: 0.5px;">
                          <i data-lucide="bot" style="width: 12px; height: 12px;" class="me-1"></i>AI Agents
                        </div>
                        <div class="d-flex flex-wrap gap-1">
                          <% agents.each do |agent| %>
                            <span class="btn btn-sm component-chip component-chip-muted">
                              <i data-lucide="brain" style="width: 12px; height: 12px;" class="me-1"></i><%= agent.name %>
                              <% if agent.status == 'active' %><span class="ms-1" style="color: #22c55e;">●</span><% end %>
                            </span>
                          <% end %>
                        </div>
                      </div>
                    <% end %>
                    <% if total_components == 0 %>
                      <p class="text-muted small mb-0">No components yet. Ask Amos to add features to this module.</p>
                    <% end %>
                    <div class="d-flex gap-2 mt-2 pt-2 border-top">
                      <button type="button" class="btn btn-sm btn-outline-primary canvas-link" data-slug="<%= mod.slug %>" data-canvas-slug="<%= mod.slug %>_list" data-module-id="<%= mod.id %>">
                        <i data-lucide="external-link" style="width: 12px; height: 12px;" class="me-1"></i>Open Module
                      </button>
                      <span class="text-muted small align-self-center">Updated <%= mod.updated_at.strftime('%b %d, %Y') rescue 'N/A' %></span>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          <% end %>

        </div>
      <% elsif filter_type == 'app_module' %>
        <div class="text-center py-4 text-muted"><p>No apps yet. Ask Amos to build one!</p></div>
      <% end %>
    </div>


    <!-- ════════════════════════════════════════════════ -->
    <!-- SECTION: Automations (Grouped + Email Sequences) -->
    <!-- ════════════════════════════════════════════════ -->
    <div class="section-block" data-section="automation">
      <% if filter_type == 'all' && (total_automations + total_email_sequences) > 0 %>
        <div class="section-header d-flex align-items-center justify-content-between mb-2">
          <h6 class="mb-0 fw-semibold text-muted text-uppercase" style="font-size: 0.75rem; letter-spacing: 0.5px;">
            <i data-lucide="zap" style="width: 14px; height: 14px;" class="me-1"></i>Automations & Sequences
          </h6>
          <button type="button" class="btn btn-link btn-sm text-muted p-0 view-all-btn" data-filter="automation" style="font-size: 0.75rem;">View all (<%= total_automations + total_email_sequences %>)</button>
        </div>
      <% end %>

      <% has_any_automations = (automations.respond_to?(:any?) ? automations.any? : automations.size > 0) || (email_sequences.respond_to?(:any?) ? email_sequences.any? : false) %>
      <% if has_any_automations %>
        <div class="automation-list mb-4">

          <%# ── Email Sequences (higher-level, shown first) ── %>
          <% if email_sequences.respond_to?(:each) && email_sequences.any? %>
            <div class="mb-3">
              <div class="d-flex align-items-center gap-2 mb-2">
                <i data-lucide="mail" style="width: 14px; height: 14px; color: #a855f7;"></i>
                <span class="fw-semibold text-muted text-uppercase" style="font-size: 0.7rem; letter-spacing: 0.5px;">Email Sequences (<%= email_sequences.size %>)</span>
              </div>
              <% email_sequences.each do |seq| %>
                <% steps = seq.sequence_steps.respond_to?(:ordered) ? seq.sequence_steps.ordered : (seq.sequence_steps.sort_by { |s| s.step_number } rescue []) %>
                <div class="card border-0 shadow-sm mb-2 sequence-card" data-type="automation" 
                     data-title="<%= seq.name.downcase rescue '' %>"
                     data-status="<%= seq.status == 'active' ? 'published' : 'draft' %>">
                  <div class="card-body py-2 px-3">
                    <div class="d-flex align-items-center gap-3">
                      <div class="project-icon rounded-2 d-flex align-items-center justify-content-center flex-shrink-0"
                           style="width: 34px; height: 34px; background: linear-gradient(135deg, #a855f7 0%, #7c3aed 100%);">
                        <i data-lucide="mail" style="width: 16px; height: 16px; color: white;"></i>
                      </div>
                      <div class="flex-grow-1 min-width-0">
                        <div class="d-flex align-items-center gap-2">
                          <span class="fw-semibold text-truncate" style="font-size: 0.85rem;"><%= seq.name %></span>
                          <span class="badge rounded-pill <%= seq.status == 'active' ? 'bg-success' : seq.status == 'paused' ? 'bg-warning' : 'bg-secondary' %>" style="font-size: 0.55rem;"><%= seq.status&.titleize %></span>
                          <span class="badge rounded-pill bg-primary bg-opacity-25 text-primary" style="font-size: 0.55rem;"><%= steps.size %> steps</span>
                        </div>
                        <div class="d-flex align-items-center gap-3 text-muted" style="font-size: 0.65rem;">
                          <% if seq.enrolled_count.to_i > 0 %><span><i data-lucide="users" style="width: 10px; height: 10px;" class="me-1"></i><%= seq.enrolled_count %> enrolled</span><% end %>
                          <% if seq.completed_count.to_i > 0 %><span class="text-success"><i data-lucide="check" style="width: 10px; height: 10px;" class="me-1"></i><%= seq.completed_count %> completed</span><% end %>
                          <% if seq.respond_to?(:goal) && seq.goal.present? %><span><%= seq.goal.to_s.truncate(40) %></span><% end %>
                        </div>
                      </div>
                      <div class="d-flex gap-1 flex-shrink-0 align-items-center">
                        <button type="button" class="btn btn-sm btn-outline-secondary seq-edit-btn" data-id="<%= seq.id %>" data-name="<%= seq.name %>" title="Edit in Sequence Manager">
                          <i data-lucide="edit-2" style="width: 11px; height: 11px;"></i>
                        </button>
                        <% if seq.status == 'draft' %>
                          <button type="button" class="btn btn-sm btn-outline-success seq-activate-btn" data-id="<%= seq.id %>" title="Activate">
                            <i data-lucide="play" style="width: 11px; height: 11px;"></i>
                          </button>
                        <% elsif seq.status == 'active' %>
                          <button type="button" class="btn btn-sm btn-outline-warning seq-pause-btn" data-id="<%= seq.id %>" title="Pause">
                            <i data-lucide="pause" style="width: 11px; height: 11px;"></i>
                          </button>
                        <% elsif seq.status == 'paused' %>
                          <button type="button" class="btn btn-sm btn-outline-success seq-resume-btn" data-id="<%= seq.id %>" title="Resume">
                            <i data-lucide="play" style="width: 11px; height: 11px;"></i>
                          </button>
                        <% end %>
                        <button type="button" class="btn btn-sm btn-outline-danger seq-delete-btn" data-id="<%= seq.id %>" data-name="<%= seq.name %>" title="Delete">
                          <i data-lucide="trash-2" style="width: 11px; height: 11px;"></i>
                        </button>
                        <button type="button" class="btn btn-sm btn-outline-secondary project-expand-btn" data-bs-toggle="collapse" data-bs-target="#seq-<%= seq.id %>">
                          <i data-lucide="chevron-down" style="width: 14px; height: 14px;"></i>
                        </button>
                      </div>
                    </div>
                  </div>
                  <div class="collapse" id="seq-<%= seq.id %>">
                    <div class="card-body pt-0 px-3 pb-3 border-top">
                      <div class="sequence-steps-timeline pt-2">
                        <% steps.each_with_index do |step, idx| %>
                          <div class="d-flex align-items-start gap-2 mb-2">
                            <div class="step-number rounded-circle bg-primary bg-opacity-10 text-primary d-flex align-items-center justify-content-center flex-shrink-0"
                                 style="width: 24px; height: 24px; font-size: 0.65rem; font-weight: 700;"><%= step.step_number %></div>
                            <div class="flex-grow-1">
                              <div class="fw-medium" style="font-size: 0.8rem;">
                                <%= step.effective_subject || "Step #{step.step_number}" %>
                              </div>
                              <div class="text-muted" style="font-size: 0.65rem;">
                                <% if step.delay_hours.to_i == 0 && idx == 0 %>
                                  <i data-lucide="clock" style="width: 9px; height: 9px;" class="me-1"></i>Immediate
                                <% elsif step.delay_hours.to_i > 0 %>
                                  <i data-lucide="clock" style="width: 9px; height: 9px;" class="me-1"></i>After <%= step.delay_in_days >= 1 ? "#{step.delay_in_days.round} day#{'s' if step.delay_in_days.round != 1}" : "#{step.delay_hours}h" %>
                                <% end %>
                                <% if step.sent_count.to_i > 0 %>
                                  <span class="ms-2"><i data-lucide="send" style="width: 9px; height: 9px;" class="me-1"></i><%= step.sent_count %> sent</span>
                                  <span class="ms-1 text-success"><%= step.open_rate %>% opened</span>
                                <% end %>
                              </div>
                            </div>
                          </div>
                        <% end %>
                        <% if steps.empty? %>
                          <p class="text-muted small mb-0">No steps defined yet. Ask Amos to add steps to this sequence.</p>
                        <% end %>
                      </div>
                    </div>
                  </div>
                </div>
              <% end %>
            </div>
          <% end %>

          <%# ── Grouped Automations (by Web App) ── %>
          <% automations_by_app.each do |wa_id, group_autos| %>
            <% wa_name = (WebApp.find_by(id: wa_id)&.name rescue "Web App ##{wa_id}") %>
            <div class="card border-0 shadow-sm mb-2">
              <div class="card-body py-2 px-3">
                <div class="d-flex align-items-center gap-2 mb-1">
                  <i data-lucide="app-window" style="width: 14px; height: 14px; color: #0ea5e9;"></i>
                  <span class="fw-semibold" style="font-size: 0.8rem;"><%= wa_name %></span>
                  <span class="badge rounded-pill bg-info bg-opacity-25 text-info" style="font-size: 0.55rem;"><%= group_autos.size %> automations</span>
                  <button type="button" class="btn btn-sm btn-outline-secondary project-expand-btn ms-auto" data-bs-toggle="collapse" data-bs-target="#auto-wa-<%= wa_id %>">
                    <i data-lucide="chevron-down" style="width: 12px; height: 12px;"></i>
                  </button>
                </div>
              </div>
              <div class="collapse show" id="auto-wa-<%= wa_id %>">
                <div class="list-group list-group-flush">
                  <% group_autos.each do |auto| %>
                    <div class="list-group-item list-group-item-action automation-row px-3 py-2 border-0 border-bottom"
                         data-type="automation" data-id="<%= auto.id %>"
                         data-status="<%= auto.status == 'active' ? 'published' : 'draft' %>"
                         data-title="<%= auto.name.downcase rescue '' %>" style="padding-left: 2.5rem !important;">
                      <div class="d-flex align-items-center gap-3">
                        <span class="status-dot flex-shrink-0 <%= auto.status == 'active' ? 'active' : 'inactive' %>"></span>
                        <div class="flex-grow-1 min-width-0">
                          <div class="fw-semibold text-truncate" style="font-size: 0.82rem;"><%= auto.name rescue 'Untitled' %></div>
                          <div class="text-muted" style="font-size: 0.65rem;"><i data-lucide="zap" style="width: 9px; height: 9px;" class="me-1"></i><%= auto.trigger_type&.titleize || 'Manual' %></div>
                        </div>
                        <div class="d-flex gap-1 flex-shrink-0">
                          <button type="button" class="btn btn-sm btn-outline-secondary automation-edit-btn" data-id="<%= auto.id %>" title="Edit"><i data-lucide="edit-2" style="width: 11px; height: 11px;"></i></button>
                        </div>
                      </div>
                    </div>
                  <% end %>
                </div>
              </div>
            </div>
          <% end %>

          <%# ── Grouped Automations (by Module) ── %>
          <% automations_by_module.each do |mod_id, group_autos| %>
            <% mod_name = (AppModule.find_by(id: mod_id)&.name rescue "Module ##{mod_id}") %>
            <div class="card border-0 shadow-sm mb-2">
              <div class="card-body py-2 px-3">
                <div class="d-flex align-items-center gap-2 mb-1">
                  <i data-lucide="boxes" style="width: 14px; height: 14px; color: #8b5cf6;"></i>
                  <span class="fw-semibold" style="font-size: 0.8rem;"><%= mod_name %></span>
                  <span class="badge rounded-pill bg-primary bg-opacity-25 text-primary" style="font-size: 0.55rem;"><%= group_autos.size %> automations</span>
                  <button type="button" class="btn btn-sm btn-outline-secondary project-expand-btn ms-auto" data-bs-toggle="collapse" data-bs-target="#auto-mod-<%= mod_id %>">
                    <i data-lucide="chevron-down" style="width: 12px; height: 12px;"></i>
                  </button>
                </div>
              </div>
              <div class="collapse show" id="auto-mod-<%= mod_id %>">
                <div class="list-group list-group-flush">
                  <% group_autos.each do |auto| %>
                    <div class="list-group-item list-group-item-action automation-row px-3 py-2 border-0 border-bottom"
                         data-type="automation" data-id="<%= auto.id %>"
                         data-status="<%= auto.status == 'active' ? 'published' : 'draft' %>"
                         data-title="<%= auto.name.downcase rescue '' %>" style="padding-left: 2.5rem !important;">
                      <div class="d-flex align-items-center gap-3">
                        <span class="status-dot flex-shrink-0 <%= auto.status == 'active' ? 'active' : 'inactive' %>"></span>
                        <div class="flex-grow-1 min-width-0">
                          <div class="fw-semibold text-truncate" style="font-size: 0.82rem;"><%= auto.name rescue 'Untitled' %></div>
                          <div class="text-muted" style="font-size: 0.65rem;"><i data-lucide="zap" style="width: 9px; height: 9px;" class="me-1"></i><%= auto.trigger_type&.titleize || 'Manual' %></div>
                        </div>
                        <div class="d-flex gap-1 flex-shrink-0">
                          <button type="button" class="btn btn-sm btn-outline-secondary automation-edit-btn" data-id="<%= auto.id %>" title="Edit"><i data-lucide="edit-2" style="width: 11px; height: 11px;"></i></button>
                        </div>
                      </div>
                    </div>
                  <% end %>
                </div>
              </div>
            </div>
          <% end %>

          <%# ── Prefix-Grouped Automations (smart name grouping) ── %>
          <% prefix_groups.each do |prefix, group_autos| %>
            <div class="card border-0 shadow-sm mb-2">
              <div class="card-body py-2 px-3">
                <div class="d-flex align-items-center gap-2 mb-1">
                  <i data-lucide="layers" style="width: 14px; height: 14px; color: #f59e0b;"></i>
                  <span class="fw-semibold" style="font-size: 0.8rem;"><%= prefix %></span>
                  <span class="badge rounded-pill bg-warning bg-opacity-25 text-warning" style="font-size: 0.55rem;"><%= group_autos.size %> steps</span>
                  <button type="button" class="btn btn-sm btn-outline-secondary project-expand-btn ms-auto" data-bs-toggle="collapse" data-bs-target="#auto-prefix-<%= prefix.parameterize %>">
                    <i data-lucide="chevron-down" style="width: 12px; height: 12px;"></i>
                  </button>
                </div>
              </div>
              <div class="collapse show" id="auto-prefix-<%= prefix.parameterize %>">
                <div class="list-group list-group-flush">
                  <% group_autos.sort_by { |a| a.name.to_s }.each do |auto| %>
                    <div class="list-group-item list-group-item-action automation-row px-3 py-2 border-0 border-bottom"
                         data-type="automation" data-id="<%= auto.id %>"
                         data-status="<%= auto.status == 'active' ? 'published' : 'draft' %>"
                         data-title="<%= auto.name.downcase rescue '' %>" style="padding-left: 2.5rem !important;">
                      <div class="d-flex align-items-center gap-3">
                        <span class="status-dot flex-shrink-0 <%= auto.status == 'active' ? 'active' : 'inactive' %>"></span>
                        <div class="flex-grow-1 min-width-0">
                          <div class="fw-semibold text-truncate" style="font-size: 0.82rem;"><%= auto.name rescue 'Untitled' %></div>
                          <div class="text-muted" style="font-size: 0.65rem;"><i data-lucide="zap" style="width: 9px; height: 9px;" class="me-1"></i><%= auto.trigger_type&.titleize || 'Manual' %></div>
                        </div>
                        <div class="d-flex align-items-center gap-2 flex-shrink-0 text-muted" style="font-size: 0.7rem;">
                          <% exec_ct = auto.respond_to?(:execution_count) ? auto.execution_count.to_i : 0 %>
                          <% if exec_ct > 0 %><span><%= exec_ct %> runs</span><% end %>
                        </div>
                        <div class="d-flex gap-1 flex-shrink-0">
                          <button type="button" class="btn btn-sm btn-outline-secondary automation-edit-btn" data-id="<%= auto.id %>" title="Edit"><i data-lucide="edit-2" style="width: 11px; height: 11px;"></i></button>
                        </div>
                      </div>
                    </div>
                  <% end %>
                </div>
              </div>
            </div>
          <% end %>

          <%# ── Standalone Automations (no parent, no grouping) ── %>
          <% if truly_standalone.any? %>
            <div class="card border-0 shadow-sm">
              <div class="list-group list-group-flush">
                <% truly_standalone.each do |auto| %>
                  <div class="list-group-item list-group-item-action automation-row px-3 py-2 border-0 border-bottom"
                       data-type="automation" data-id="<%= auto.id %>"
                       data-status="<%= auto.status == 'active' ? 'published' : 'draft' %>"
                       data-title="<%= auto.name.downcase rescue '' %>">
                    <div class="d-flex align-items-center gap-3">
                      <span class="status-dot flex-shrink-0 <%= auto.status == 'active' ? 'active' : 'inactive' %>" title="<%= auto.status&.titleize %>"></span>
                      <div class="flex-grow-1 min-width-0">
                        <div class="fw-semibold text-truncate" style="font-size: 0.85rem;"><%= auto.name rescue 'Untitled' %></div>
                        <div class="text-muted" style="font-size: 0.7rem;">
                          <% if auto.respond_to?(:trigger_type) && auto.trigger_type.present? %>
                            <i data-lucide="zap" style="width: 10px; height: 10px;" class="me-1"></i><%= auto.trigger_type.titleize %>
                          <% else %>
                            <i data-lucide="clock" style="width: 10px; height: 10px;" class="me-1"></i>Manual
                          <% end %>
                        </div>
                      </div>
                      <div class="d-flex align-items-center gap-3 flex-shrink-0 text-end" style="font-size: 0.75rem;">
                        <% exec_count = auto.respond_to?(:execution_count) ? auto.execution_count.to_i : 0 %>
                        <% err_count = auto.respond_to?(:error_count) ? auto.error_count.to_i : 0 %>
                        <% success_count = auto.respond_to?(:success_count) ? auto.success_count.to_i : 0 %>
                        <div class="text-muted" title="Total runs"><span class="fw-semibold"><%= exec_count %></span> runs</div>
                        <% if exec_count > 0 %>
                          <div><span class="text-success"><%= success_count %></span> / <span class="text-danger"><%= err_count %></span></div>
                        <% end %>
                      </div>
                      <div class="d-flex gap-1 flex-shrink-0">
                        <button type="button" class="btn btn-sm btn-outline-secondary automation-edit-btn" data-id="<%= auto.id %>" title="Edit">
                          <i data-lucide="edit-2" style="width: 12px; height: 12px;"></i>
                        </button>
                        <button type="button" class="btn btn-sm <%= auto.shared_with_entity? ? 'btn-info' : 'btn-outline-secondary' %> share-toggle-btn"
                                data-id="<%= auto.id %>" data-asset-type="automation" data-shared="<%= auto.shared_with_entity? %>"
                                title="<%= auto.shared_with_entity? ? 'Shared — make private' : 'Private — share with team' %>">
                          <i data-lucide="<%= auto.shared_with_entity? ? 'users' : 'lock' %>" style="width: 12px; height: 12px;"></i>
                        </button>
                        <% if auto.status == 'active' %>
                          <button type="button" class="btn btn-sm btn-outline-warning toggle-btn" data-id="<%= auto.id %>" data-action-type="pause" title="Pause">
                            <i data-lucide="pause" style="width: 12px; height: 12px;"></i>
                          </button>
                        <% else %>
                          <button type="button" class="btn btn-sm btn-outline-success toggle-btn" data-id="<%= auto.id %>" data-action-type="activate" title="Activate">
                            <i data-lucide="play" style="width: 12px; height: 12px;"></i>
                          </button>
                        <% end %>
                      </div>
                    </div>
                  </div>
                <% end %>
              </div>
            </div>
          <% end %>

        </div>
      <% elsif filter_type == 'automation' %>
        <div class="text-center py-4 text-muted"><p>No automations or sequences yet. Ask Amos to create one!</p></div>
      <% end %>
    </div>


    <!-- Empty state (nothing at all) -->
    <% if total_items == 0 %>
      <div class="text-center py-5">
        <div class="mb-3">
          <div class="d-inline-flex align-items-center justify-content-center bg-primary bg-opacity-10 rounded-4 p-4">
            <i data-lucide="rocket" style="width: 48px; height: 48px;" class="text-primary"></i>
          </div>
        </div>
        <h5>No projects yet</h5>
        <p class="text-muted">Ask Amos to build a landing page, app, or automation</p>
        <button type="button" class="btn btn-primary" id="empty-create-btn">
          <i data-lucide="plus" style="width: 16px; height: 16px;" class="me-1"></i>Create Your First Project
        </button>
      </div>
    <% end %>

    <!-- Results summary -->
    <% if search_query.present? %>
      <div class="text-center text-muted small mt-2 pb-2">
        Found results for "<%= search_query %>"
        <button type="button" class="btn btn-sm btn-link" id="clear-search-btn">Clear</button>
      </div>
    <% end %>

  </div>
</div>

<style>
  .my-creations-canvas {
    height: 100%;
    display: flex;
    flex-direction: column;
    background: var(--bs-body-bg, #fff);
    color: var(--bs-body-color, #212529);
  }
  .creations-header { background: var(--bs-body-bg, #fff); }
  .header-icon-wrap {
    width: 38px; height: 38px;
    display: flex; align-items: center; justify-content: center;
    background: linear-gradient(135deg, #6366f1 0%, #8b5cf6 100%);
    border-radius: 10px; color: #fff;
  }

  /* Tabs */
  .creations-tabs { background: var(--bs-body-bg, #fff); }
  .creations-tabs .nav-tabs { gap: 0; }
  .creations-tabs .nav-link {
    border: none; border-bottom: 2px solid transparent;
    color: var(--bs-secondary-color, #6c757d);
    font-size: 0.82rem; padding: 0.5rem 0.8rem; border-radius: 0;
    display: flex; align-items: center; transition: all 0.15s; white-space: nowrap;
  }
  .creations-tabs .nav-link:hover { color: var(--bs-body-color); border-bottom-color: var(--bs-border-color, #dee2e6); }
  .creations-tabs .nav-link.active { color: var(--bs-primary, #6366f1); border-bottom-color: var(--bs-primary, #6366f1); font-weight: 600; }

  /* Stat cards (compact) */
  .stat-card { transition: transform 0.15s; }
  .stat-card:hover { transform: translateY(-1px); }

  /* Landing page card grid */
  .lp-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 0.75rem;
  }
  .creation-card {
    overflow: hidden; transition: all 0.2s; cursor: pointer; border-radius: 8px !important;
  }
  .creation-card:hover { transform: translateY(-2px); box-shadow: 0 6px 20px rgba(0,0,0,0.1) !important; }

  .creation-preview { position: relative; height: 120px; overflow: hidden; }
  .preview-iframe-container {
    width: 100%; height: 100%; overflow: hidden; position: relative;
    background: linear-gradient(135deg, #e2e8f0, #cbd5e1);
  }
  .preview-iframe-container::after {
    content: ''; position: absolute; bottom: 0; left: 0; right: 0; height: 40%;
    background: linear-gradient(to bottom, transparent, rgba(255,255,255,0.9));
    pointer-events: none; z-index: 1;
  }
  .preview-iframe {
    width: 1200px; height: 800px; border: none;
    transform: scale(0.2); transform-origin: top left;
    pointer-events: none; position: absolute; top: 0;
    left: 50%; margin-left: -120px; background: white;
  }
  .preview-placeholder {
    width: 100%; height: 100%;
    display: flex; align-items: center; justify-content: center;
    color: rgba(255,255,255,0.5);
  }
  .preview-placeholder.landing-page { background: linear-gradient(135deg, #3b82f6, #1d4ed8); }
  .preview-placeholder.website { background: linear-gradient(135deg, #06b6d4, #0891b2); }

  .status-badge {
    position: absolute; top: 6px; right: 6px;
    padding: 2px 6px; border-radius: 4px;
    font-size: 0.6rem; font-weight: 600;
  }
  .status-badge.draft { background: rgba(107,114,128,0.85); color: white; }
  .status-badge.published { background: rgba(34,197,94,0.9); color: white; }

  .creation-card .card-footer .btn { font-size: 0.7rem; padding: 0.25rem 0.4rem; }

  /* Project cards (app modules) */
  .project-card { border-radius: 8px !important; transition: all 0.15s; }
  .project-card:hover { box-shadow: 0 4px 15px rgba(0,0,0,0.08) !important; }
  .project-expand-btn { padding: 0.2rem 0.4rem; transition: transform 0.2s; }
  .project-expand-btn[aria-expanded="true"] i { transform: rotate(180deg); }

  .component-chip {
    font-size: 0.7rem; padding: 0.2rem 0.5rem;
    border: 1px solid var(--bs-border-color, #dee2e6);
    border-radius: 6px; background: transparent;
    display: inline-flex; align-items: center; gap: 2px;
    color: var(--bs-body-color); transition: all 0.15s;
  }
  .component-chip:hover { background: var(--bs-primary); color: white; border-color: var(--bs-primary); }
  .component-chip-muted { cursor: default; }
  .component-chip-muted:hover { background: transparent; color: var(--bs-body-color); border-color: var(--bs-border-color); }
  .chip-type {
    font-size: 0.55rem; opacity: 0.6; margin-left: 2px;
    text-transform: uppercase; letter-spacing: 0.3px;
  }

  /* Automation list */
  .automation-row { transition: background 0.15s; cursor: pointer; }
  .automation-row:hover { background: var(--bs-tertiary-bg, #f8f9fa) !important; }
  .automation-row .btn { padding: 0.2rem 0.35rem; }
  .status-dot {
    width: 8px; height: 8px; border-radius: 50%;
  }
  .status-dot.active { background: #22c55e; box-shadow: 0 0 0 3px rgba(34,197,94,0.2); }
  .status-dot.inactive { background: #9ca3af; }

  /* Module sub-rows (inside grouped Apps) */
  .module-sub-row { transition: background 0.15s; }
  .module-sub-row:hover { background: var(--bs-tertiary-bg, #f8f9fa); }

  /* Sequence cards */
  .sequence-card { border-radius: 8px !important; transition: all 0.15s; }
  .sequence-card:hover { box-shadow: 0 4px 15px rgba(0,0,0,0.08) !important; }
  .sequence-steps-timeline { padding-left: 0.25rem; }

  /* Section visibility */
  .section-block[data-section] { display: block; }

  /* Dark mode */
  [data-bs-theme="dark"] .my-creations-canvas,
  [data-theme="dark"] .my-creations-canvas { background: #1a1a2e; color: #e0e0e0; }
  [data-bs-theme="dark"] .creations-header,
  [data-theme="dark"] .creations-header,
  [data-bs-theme="dark"] .creations-tabs,
  [data-theme="dark"] .creations-tabs { background: #1e1e32; }
  [data-bs-theme="dark"] .creation-card,
  [data-theme="dark"] .creation-card,
  [data-bs-theme="dark"] .project-card,
  [data-theme="dark"] .project-card,
  [data-bs-theme="dark"] .automation-list > .card,
  [data-theme="dark"] .automation-list > .card { background: #252540 !important; border-color: #3a3a50 !important; }
  [data-bs-theme="dark"] .stat-card,
  [data-theme="dark"] .stat-card { background: #252540 !important; border-color: #3a3a50 !important; }
  [data-bs-theme="dark"] .automation-row:hover,
  [data-theme="dark"] .automation-row:hover { background: #2e2e4a !important; }
  [data-bs-theme="dark"] .component-chip,
  [data-theme="dark"] .component-chip { border-color: #3a3a50; color: #ccc; }
  [data-bs-theme="dark"] .preview-iframe-container,
  [data-theme="dark"] .preview-iframe-container { background: linear-gradient(135deg, #1e293b, #334155); }
  [data-bs-theme="dark"] .preview-iframe-container::after,
  [data-theme="dark"] .preview-iframe-container::after { background: linear-gradient(to bottom, transparent, rgba(30,30,60,0.9)); }
</style>

<script>
(function() {
  try {
    const containers = document.querySelectorAll('.my-creations-canvas');
    const container = containers[containers.length - 1];
    if (!container) return;

    const containerId = container.id;
    if (window._myCreationsInitialized && window._myCreationsInitialized[containerId]) return;
    window._myCreationsInitialized = window._myCreationsInitialized || {};
    window._myCreationsInitialized[containerId] = true;

    let currentTypeFilter = '<%= filter_type %>';
    let currentStatusFilter = 'all';

    function loadCanvas(canvasType, canvasData = {}, forceRefresh = false) {
      document.dispatchEvent(new CustomEvent('scout:load-canvas', { 
        detail: { canvas: canvasType, data: canvasData, forceRefresh: forceRefresh } 
      }));
    }

    // ── Tab Navigation ──
    container.querySelectorAll('.asset-tab').forEach(tab => {
      tab.addEventListener('click', function(e) {
        e.preventDefault();
        currentTypeFilter = this.dataset.filter;
        container.querySelectorAll('.asset-tab').forEach(t => t.classList.remove('active'));
        this.classList.add('active');
        updateVisibility();
      });
    });

    // "View all" links in section headers
    container.querySelectorAll('.view-all-btn').forEach(btn => {
      btn.addEventListener('click', function(e) {
        e.preventDefault();
        const tab = container.querySelector(`.asset-tab[data-filter="${this.dataset.filter}"]`);
        if (tab) tab.click();
      });
    });

    // ── Visibility logic ──
    function updateVisibility() {
      // Stats
      container.querySelectorAll('.stats-row').forEach(row => {
        row.style.display = row.dataset.stats === currentTypeFilter ? '' : 'none';
      });

      // Sections
      container.querySelectorAll('.section-block').forEach(sec => {
        const sectionType = sec.dataset.section;
        if (currentTypeFilter === 'all') {
          sec.style.display = '';
        } else {
          sec.style.display = sectionType === currentTypeFilter ? '' : 'none';
        }
      });

      // Section headers (hide in dedicated tab view)
      container.querySelectorAll('.section-header').forEach(hdr => {
        hdr.style.display = currentTypeFilter === 'all' ? '' : 'none';
      });

      // Apply search filter
      applyFilters();
    }

    function applyFilters() {
      const query = container.querySelector('#creations-search')?.value.toLowerCase() || '';

      // Landing page cards
      container.querySelectorAll('.creation-card').forEach(card => {
        const title = card.dataset.title || '';
        const status = card.dataset.status || '';
        const matchesSearch = title.includes(query);
        const matchesStatus = currentStatusFilter === 'all' || status === currentStatusFilter;
        card.style.display = (matchesSearch && matchesStatus) ? '' : 'none';
      });

      // Project cards (app modules)
      container.querySelectorAll('.project-card').forEach(card => {
        const title = card.dataset.title || '';
        const status = card.dataset.status || '';
        const matchesSearch = title.includes(query);
        const matchesStatus = currentStatusFilter === 'all' || status === currentStatusFilter;
        card.style.display = (matchesSearch && matchesStatus) ? '' : 'none';
      });

      // Automation rows
      container.querySelectorAll('.automation-row').forEach(row => {
        const title = row.dataset.title || '';
        const status = row.dataset.status || '';
        const matchesSearch = title.includes(query);
        const matchesStatus = currentStatusFilter === 'all' || status === currentStatusFilter;
        row.style.display = (matchesSearch && matchesStatus) ? '' : 'none';
      });

      // Sequence cards
      container.querySelectorAll('.sequence-card').forEach(card => {
        const title = card.dataset.title || '';
        const status = card.dataset.status || '';
        const matchesSearch = title.includes(query);
        const matchesStatus = currentStatusFilter === 'all' || status === currentStatusFilter;
        card.style.display = (matchesSearch && matchesStatus) ? '' : 'none';
      });
    }

    const searchInput = container.querySelector('#creations-search');
    if (searchInput) searchInput.addEventListener('input', applyFilters);

    // Initial visibility
    if (currentTypeFilter !== 'all') setTimeout(updateVisibility, 50);

    // ── Landing page actions ──
    container.addEventListener('click', function(e) {
      const editBtn = e.target.closest('.edit-btn');
      if (!editBtn) return;
      e.preventDefault(); e.stopPropagation();
      loadCanvas('landing_page_editor', { landing_page_id: editBtn.dataset.id });
    });

    container.addEventListener('click', function(e) {
      const previewBtn = e.target.closest('.preview-btn');
      if (!previewBtn) return;
      e.preventDefault(); e.stopPropagation();
      loadCanvas('landing_page_viewer', { landing_page_id: previewBtn.dataset.id });
    });

    // Landing page card body click = edit
    container.addEventListener('click', function(e) {
      if (e.target.closest('.card-footer') || e.target.closest('button')) return;
      const card = e.target.closest('.creation-card[data-type="landing_page"]');
      if (!card) return;
      loadCanvas('landing_page_editor', { landing_page_id: card.dataset.id });
    });

    // More button dropdown
    container.addEventListener('click', function(e) {
      const moreBtn = e.target.closest('.more-btn');
      if (!moreBtn) return;
      e.preventDefault(); e.stopPropagation();
      const id = moreBtn.dataset.id;
      const type = moreBtn.dataset.type;

      document.querySelectorAll('.creation-dropdown').forEach(d => d.remove());
      const dropdown = document.createElement('div');
      dropdown.className = 'creation-dropdown card shadow border p-1';
      dropdown.style.cssText = 'position:fixed;z-index:9999;min-width:140px;';
      dropdown.innerHTML = `
        <button type="button" class="dropdown-item d-flex align-items-center gap-2 px-3 py-2 border-0 bg-transparent w-100 text-start rounded-1" data-action="duplicate">
          <i data-lucide="copy" style="width:14px;height:14px;"></i> Duplicate
        </button>
        <button type="button" class="dropdown-item d-flex align-items-center gap-2 px-3 py-2 border-0 bg-transparent w-100 text-start rounded-1" data-action="publish">
          <i data-lucide="globe" style="width:14px;height:14px;"></i> Publish
        </button>
        <hr class="my-1">
        <button type="button" class="dropdown-item d-flex align-items-center gap-2 px-3 py-2 border-0 bg-transparent w-100 text-start text-danger rounded-1" data-action="delete">
          <i data-lucide="trash-2" style="width:14px;height:14px;"></i> Delete
        </button>`;

      const rect = moreBtn.getBoundingClientRect();
      dropdown.style.top = (rect.bottom + 4) + 'px';
      dropdown.style.left = (rect.left - 100) + 'px';
      document.body.appendChild(dropdown);
      if (typeof lucide !== 'undefined') lucide.createIcons({ node: dropdown });

      dropdown.querySelectorAll('.dropdown-item').forEach(item => {
        item.addEventListener('click', async function() {
          const action = this.dataset.action;
          if (action === 'delete') {
            const confirmed = window.showConfirm
              ? await window.showConfirm('Delete this landing page? This cannot be undone.', { title: 'Delete Landing Page', dangerous: true, confirmText: 'Delete' })
              : confirm('Delete this landing page?');
            if (confirmed) {
              fetch('/landing_pages/' + id, {
                method: 'DELETE',
                headers: { 'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]')?.content, 'Accept': 'application/json' }
              }).then(() => loadCanvas('my_creations', {}));
            }
          } else if (action === 'publish') {
            fetch('/landing_pages/' + id + '/publish', {
              method: 'POST',
              headers: { 'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]')?.content, 'Accept': 'application/json' }
            }).then(() => loadCanvas('my_creations', {}));
          } else if (action === 'duplicate') {
            window.showInfo ? window.showInfo('Duplicate feature coming soon!') : alert('Duplicate feature coming soon!');
          }
          dropdown.remove();
        });
      });
      setTimeout(() => {
        const close = (ev) => { if (!dropdown.contains(ev.target)) { dropdown.remove(); document.removeEventListener('click', close); } };
        document.addEventListener('click', close);
      }, 10);
    });

    // ── Website actions ──
    container.addEventListener('click', function(e) {
      const editBtn = e.target.closest('.website-edit-btn');
      if (!editBtn) return;
      e.preventDefault(); e.stopPropagation();
      const id = editBtn.dataset.id;
      loadCanvas('website_page_editor', { website_id: id });
    });

    // Website card body click = edit
    container.addEventListener('click', function(e) {
      if (e.target.closest('.card-footer') || e.target.closest('button') || e.target.closest('a')) return;
      const card = e.target.closest('.creation-card[data-type="website"]');
      if (!card) return;
      const editBtn = card.querySelector('.website-edit-btn');
      if (editBtn) editBtn.click();
    });

    // ── Web App actions ──
    container.addEventListener('click', function(e) {
      const editBtn = e.target.closest('.web-app-edit-btn');
      if (!editBtn) return;
      e.preventDefault(); e.stopPropagation();
      const slug = editBtn.dataset.slug;
      const id = editBtn.dataset.id;
      // Load the design preview for this web app
      loadCanvas('design_preview', { web_app_id: id, preview_type: 'web_app' });
    });

    // Web App project card header click -> expand
    container.addEventListener('click', function(e) {
      if (e.target.closest('.project-expand-btn') || e.target.closest('.collapse') || e.target.closest('.canvas-link') || e.target.closest('button') || e.target.closest('a')) return;
      const card = e.target.closest('.project-card[data-type="web_app"]');
      if (!card) return;
      const expandBtn = card.querySelector('.project-expand-btn');
      if (expandBtn) expandBtn.click();
    });

    // ── Module sub-rows inside grouped Apps ──
    container.addEventListener('click', function(e) {
      const row = e.target.closest('.module-sub-row');
      if (!row) return;
      e.preventDefault(); e.stopPropagation();
      const slug = row.dataset.moduleSlug;
      const moduleId = row.dataset.moduleId;
      if (slug) loadCanvas('module_' + slug + '_list', { app_module_id: moduleId });
    });

    // ── App module canvas links ──
    container.addEventListener('click', function(e) {
      const link = e.target.closest('.canvas-link');
      if (!link) return;
      e.preventDefault(); e.stopPropagation();
      const slug = link.dataset.slug;
      const canvasSlug = link.dataset.canvasSlug;
      const moduleId = link.dataset.moduleId;
      if (canvasSlug) {
        loadCanvas('module_' + canvasSlug, { app_module_id: moduleId });
      } else if (slug) {
        loadCanvas('module_' + slug + '_list', { app_module_id: moduleId });
      }
    });

    // Project card header click (not expand btn) -> open app
    container.addEventListener('click', function(e) {
      if (e.target.closest('.project-expand-btn') || e.target.closest('.collapse') || e.target.closest('.canvas-link') || e.target.closest('button')) return;
      const card = e.target.closest('.project-card');
      if (!card) return;
      const slug = card.querySelector('.canvas-link')?.dataset.slug;
      const moduleId = card.dataset.id;
      if (slug) loadCanvas('module_' + slug + '_list', { app_module_id: moduleId });
    });

    // ── Automation actions ──
    container.addEventListener('click', function(e) {
      const editBtn = e.target.closest('.automation-edit-btn');
      if (!editBtn) return;
      e.preventDefault(); e.stopPropagation();
      // Load the automation code editor canvas
      loadCanvas('automation_dashboard', { automation_id: editBtn.dataset.id });
    });

    // Automation row click -> edit
    container.addEventListener('click', function(e) {
      if (e.target.closest('button')) return;
      const row = e.target.closest('.automation-row');
      if (!row) return;
      loadCanvas('automation_dashboard', { automation_id: row.dataset.id });
    });

    // Toggle automation (activate/pause)
    container.addEventListener('click', function(e) {
      const toggleBtn = e.target.closest('.toggle-btn');
      if (!toggleBtn) return;
      e.preventDefault(); e.stopPropagation();
      const id = toggleBtn.dataset.id;
      const action = toggleBtn.dataset.actionType;
      const msg = action === 'pause' ? 'Pause automation ' + id : 'Activate automation ' + id;
      if (window.scoutController?.sendScoutMessage) {
        window.scoutController.sendScoutMessage(msg);
      } else if (window.scoutSendMessage) {
        window.scoutSendMessage(msg);
      }
    });

    // ── Email Sequence actions ──
    // Edit - open the sequence manager canvas
    container.addEventListener('click', function(e) {
      const editBtn = e.target.closest('.seq-edit-btn');
      if (!editBtn) return;
      e.preventDefault(); e.stopPropagation();
      loadCanvas('sequence_manager', {});
    });

    // Activate
    container.addEventListener('click', async function(e) {
      const btn = e.target.closest('.seq-activate-btn');
      if (!btn) return;
      e.preventDefault(); e.stopPropagation();
      const confirmed = window.showConfirm
        ? await window.showConfirm('Activate this sequence? Enrolled contacts will start receiving emails.', { title: 'Activate Sequence', confirmText: 'Activate', confirmClass: 'btn-success' })
        : confirm('Activate this sequence? Enrolled contacts will start receiving emails.');
      if (!confirmed) return;
      try {
        const resp = await fetch('/api/v1/email_sequences/' + btn.dataset.id + '/activate', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]')?.content }
        });
        const data = await resp.json();
        if (data.success) {
          window.showSuccess ? window.showSuccess('Sequence activated! Emails will start sending.') : null;
          loadCanvas('my_creations', {}, true);
        } else {
          window.showError ? window.showError(data.message || 'Failed to activate') : alert(data.message || 'Failed to activate');
        }
      } catch(err) { console.error(err); window.showError ? window.showError('Error activating sequence') : alert('Error activating sequence'); }
    });

    // Pause
    container.addEventListener('click', async function(e) {
      const btn = e.target.closest('.seq-pause-btn');
      if (!btn) return;
      e.preventDefault(); e.stopPropagation();
      try {
        const resp = await fetch('/api/v1/email_sequences/' + btn.dataset.id + '/pause', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]')?.content }
        });
        const data = await resp.json();
        if (data.success) {
          window.showSuccess ? window.showSuccess('Sequence paused.') : null;
          loadCanvas('my_creations', {}, true);
        } else {
          window.showError ? window.showError(data.message || 'Failed to pause') : alert(data.message || 'Failed to pause');
        }
      } catch(err) { console.error(err); window.showError ? window.showError('Error pausing sequence') : alert('Error pausing sequence'); }
    });

    // Resume
    container.addEventListener('click', async function(e) {
      const btn = e.target.closest('.seq-resume-btn');
      if (!btn) return;
      e.preventDefault(); e.stopPropagation();
      try {
        const resp = await fetch('/api/v1/email_sequences/' + btn.dataset.id + '/resume', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]')?.content }
        });
        const data = await resp.json();
        if (data.success) {
          window.showSuccess ? window.showSuccess('Sequence resumed.') : null;
          loadCanvas('my_creations', {}, true);
        } else {
          window.showError ? window.showError(data.message || 'Failed to resume') : alert(data.message || 'Failed to resume');
        }
      } catch(err) { console.error(err); window.showError ? window.showError('Error resuming sequence') : alert('Error resuming sequence'); }
    });

    // Delete
    container.addEventListener('click', async function(e) {
      const btn = e.target.closest('.seq-delete-btn');
      if (!btn) return;
      e.preventDefault(); e.stopPropagation();
      const name = btn.dataset.name || 'this sequence';
      const confirmed = window.showConfirm
        ? await window.showConfirm('Delete "' + name + '"? This cannot be undone.', { title: 'Delete Sequence', dangerous: true, confirmText: 'Delete' })
        : confirm('Delete "' + name + '"? This cannot be undone.');
      if (!confirmed) return;
      if (window.scoutController?.sendScoutMessage) {
        window.scoutController.sendScoutMessage('Delete email sequence #' + btn.dataset.id);
      }
    });

    // Sequence card body click -> open sequence manager
    container.addEventListener('click', function(e) {
      if (e.target.closest('button') || e.target.closest('.collapse')) return;
      const card = e.target.closest('.sequence-card');
      if (!card) return;
      loadCanvas('sequence_manager', {});
    });

    // ── Create new ──
    container.querySelectorAll('#create-new-btn, #empty-create-btn').forEach(btn => {
      btn.addEventListener('click', function(e) {
        e.preventDefault();
        loadCanvas('template_library', {});
      });
    });

    // ── Clear search ──
    const clearSearchBtn = container.querySelector('#clear-search-btn');
    if (clearSearchBtn) {
      clearSearchBtn.addEventListener('click', function() {
        const input = container.querySelector('#creations-search');
        if (input) input.value = '';
        applyFilters();
      });
    }

    // ── Share / Make Private toggle ──
    container.querySelectorAll('.share-toggle-btn').forEach(btn => {
      btn.addEventListener('click', async function(e) {
        e.stopPropagation();
        const assetId = this.dataset.id;
        const assetType = this.dataset.assetType;
        const wasShared = this.dataset.shared === 'true';

        this.disabled = true;
        try {
          const csrfToken = document.querySelector('meta[name="csrf-token"]')?.content;
          const resp = await fetch('/scout/toggle_asset_sharing', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': csrfToken },
            body: JSON.stringify({ asset_type: assetType, asset_id: assetId })
          });
          const data = await resp.json();
          if (data.success) {
            const nowShared = data.shared;
            this.dataset.shared = nowShared.toString();
            this.className = 'btn btn-sm ' + (nowShared ? 'btn-info' : 'btn-outline-secondary') + ' share-toggle-btn';
            this.title = nowShared ? 'Shared with team — click to make private' : 'Private — click to share with team';
            const icon = this.querySelector('i, [data-lucide]');
            if (icon) { icon.setAttribute('data-lucide', nowShared ? 'users' : 'lock'); }
            if (typeof lucide !== 'undefined') lucide.createIcons({ node: this });
          }
        } catch (err) {
          console.error('Share toggle failed:', err);
        } finally {
          this.disabled = false;
        }
      });
    });

    if (typeof lucide !== 'undefined') lucide.createIcons();

  } catch (err) {
    console.error('My Creations canvas error:', err);
  }
})();
</script>
