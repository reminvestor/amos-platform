<%# My Creations Canvas - Unified view of all projects and assets %>
<%# Shows landing pages, websites, apps, workflows with filtering %>

<% 
  data = canvas_data || {}
  
  # Search query (if provided)
  search_query = (data[:search] || data['search'] || '').to_s.strip.downcase
  max_display = 100 # Show up to 100 items, use search to find more
  
  # Get all creations
  landing_pages_all = entity.landing_pages.order(updated_at: :desc)
  app_modules_all = entity.app_modules.order(updated_at: :desc) rescue []
  workflows_all = entity.automation_codes.order(updated_at: :desc) rescue []
  design_plans_all = current_user.design_plans.where(entity: entity).order(updated_at: :desc) rescue []
  draft_plans_all = design_plans_all.respond_to?(:where) ? design_plans_all.where(status: 'draft') : design_plans_all.select { |p| p.status == 'draft' }
  
  # Apply search filter if query provided (server-side search for initial load)
  if search_query.present?
    landing_pages_all = landing_pages_all.where("LOWER(title) LIKE ? OR LOWER(description) LIKE ?", "%#{search_query}%", "%#{search_query}%")
    app_modules_all = app_modules_all.respond_to?(:where) ? app_modules_all.where("LOWER(name) LIKE ?", "%#{search_query}%") : app_modules_all.select { |m| m.name.to_s.downcase.include?(search_query) }
    workflows_all = workflows_all.respond_to?(:where) ? workflows_all.where("LOWER(name) LIKE ?", "%#{search_query}%") : workflows_all.select { |w| w.name.to_s.downcase.include?(search_query) }
    design_plans_all = design_plans_all.respond_to?(:where) ? design_plans_all.where("LOWER(name) LIKE ? OR plan_data::text ILIKE ?", "%#{search_query}%", "%#{search_query}%") : design_plans_all.select { |p| p.name.to_s.downcase.include?(search_query) }
    draft_plans_all = draft_plans_all.respond_to?(:where) ? draft_plans_all.where("LOWER(name) LIKE ? OR plan_data::text ILIKE ?", "%#{search_query}%", "%#{search_query}%") : draft_plans_all.select { |p| p.name.to_s.downcase.include?(search_query) }
  end
  
  # Limit for display
  landing_pages = landing_pages_all.limit(max_display)
  app_modules = app_modules_all.respond_to?(:limit) ? app_modules_all.limit(max_display) : app_modules_all.first(max_display)
  workflows = workflows_all.respond_to?(:limit) ? workflows_all.limit(max_display) : workflows_all.first(max_display)
  design_plans = design_plans_all.respond_to?(:limit) ? design_plans_all.limit(max_display) : design_plans_all.first(max_display)
  draft_plans = draft_plans_all.respond_to?(:limit) ? draft_plans_all.limit(max_display) : draft_plans_all.first(max_display)
  
  # Total counts for tabs (unfiltered)
  total_landing_pages = entity.landing_pages.count rescue 0
  total_app_modules = (entity.app_modules.count rescue 0)
  total_workflows = (entity.automation_codes.count rescue 0)
  total_draft_plans = (current_user.design_plans.where(entity: entity, status: 'draft').count rescue 0)
  total_items = total_landing_pages + total_app_modules + total_workflows + total_draft_plans
  
  # Displayed counts (after search filter)
  displayed_landing_pages = landing_pages.respond_to?(:count) ? landing_pages.count : landing_pages.length
  displayed_app_modules = app_modules.respond_to?(:count) ? app_modules.count : app_modules.length
  displayed_workflows = workflows.respond_to?(:count) ? workflows.count : workflows.length
  displayed_draft_plans = draft_plans.respond_to?(:count) ? draft_plans.count : draft_plans.length
  displayed_items = displayed_landing_pages + displayed_app_modules + displayed_workflows + displayed_draft_plans
  
  # Current filter
  filter_type = data[:type] || data['type'] || 'all'
  filter_status = data[:status] || data['status'] || 'all'
%>

<div class="my-creations-canvas" id="my-creations-<%= SecureRandom.hex(4) %>">
  <!-- Header -->
  <div class="creations-header">
    <div class="header-left">
      <i data-lucide="folder-open" class="header-icon"></i>
      <div>
        <h4 class="header-title">Created Assets</h4>
        <p class="header-subtitle">All your landing pages, websites, apps & workflows</p>
      </div>
    </div>
    <div class="header-right">
      <div class="search-box">
        <i data-lucide="search" class="search-icon"></i>
        <input type="text" placeholder="Search assets..." id="creations-search" class="search-input">
      </div>
      <button type="button" class="btn btn-primary create-new-btn" id="create-new-btn">
        <i data-lucide="plus" style="width: 16px; height: 16px;" class="me-1"></i>
        Create New
      </button>
    </div>
  </div>
  
  <!-- Filter Bar -->
  <div class="creations-filters">
    <div class="filter-group">
      <span class="filter-label">Type:</span>
      <div class="filter-tabs" id="type-filters">
        <button type="button" class="filter-tab <%= 'active' if filter_type == 'all' %>" data-filter="all">
          <i data-lucide="layers" style="width: 14px; height: 14px;"></i>
          All
        </button>
        <button type="button" class="filter-tab <%= 'active' if filter_type == 'landing_page' %>" data-filter="landing_page">
          <i data-lucide="file-text" style="width: 14px; height: 14px;"></i>
          Landing Pages
          <span class="count"><%= total_landing_pages %></span>
        </button>
        <button type="button" class="filter-tab <%= 'active' if filter_type == 'website' %>" data-filter="website">
          <i data-lucide="globe" style="width: 14px; height: 14px;"></i>
          Websites
          <span class="count">0</span>
        </button>
        <button type="button" class="filter-tab <%= 'active' if filter_type == 'app_module' %>" data-filter="app_module">
          <i data-lucide="boxes" style="width: 14px; height: 14px;"></i>
          App Modules
          <span class="count"><%= total_app_modules %></span>
        </button>
        <button type="button" class="filter-tab <%= 'active' if filter_type == 'workflow' %>" data-filter="workflow">
          <i data-lucide="git-branch" style="width: 14px; height: 14px;"></i>
          Workflows
          <span class="count"><%= total_workflows %></span>
        </button>
        <button type="button" class="filter-tab <%= 'active' if filter_type == 'design_plan' %>" data-filter="design_plan">
          <i data-lucide="pencil-ruler" style="width: 14px; height: 14px;"></i>
          Design Plans
          <span class="count"><%= total_draft_plans %></span>
        </button>
      </div>
    </div>
    
    <div class="filter-group">
      <span class="filter-label">Status:</span>
      <div class="filter-tabs" id="status-filters">
        <button type="button" class="filter-tab small <%= 'active' if filter_status == 'all' %>" data-status="all">All</button>
        <button type="button" class="filter-tab small <%= 'active' if filter_status == 'draft' %>" data-status="draft">
          <span class="status-dot draft"></span> Draft
        </button>
        <button type="button" class="filter-tab small <%= 'active' if filter_status == 'published' %>" data-status="published">
          <span class="status-dot published"></span> Published
        </button>
      </div>
    </div>
  </div>
  
  <!-- Creations Grid -->
  <div class="creations-grid-container">
    <% total_count = landing_pages.count + (app_modules.respond_to?(:count) ? app_modules.count : 0) + (workflows.respond_to?(:count) ? workflows.count : 0) + (draft_plans.respond_to?(:count) ? draft_plans.count : 0) %>
    
    <% if total_count > 0 %>
      <div class="creations-grid" id="creations-grid">
        
        <%# Landing Pages %>
        <% landing_pages.each do |lp| %>
          <div class="creation-card" 
               data-id="<%= lp.id %>" 
               data-type="landing_page"
               data-status="<%= lp.status == 'published' ? 'published' : 'draft' %>"
               data-title="<%= lp.title.downcase %>">
            <div class="creation-preview">
              <% if lp.html_content.present? && lp.html_content.strip.length > 100 %>
                <div class="preview-iframe-container">
                  <% 
                    # Prepare preview HTML with base tag and error hiding
                    preview_html = lp.html_content.to_s
                    # More comprehensive error hiding and styling reset
                    error_hide_css = '<style>html,body{margin:0!important;padding:0!important;overflow:hidden!important;background:#fff!important}*{animation:none!important;transition:none!important}.error,.alert,.alert-danger,.flash,[class*="error"],[class*="Error"],#error-page,.rails-default-error-page{display:none!important}</style>'
                    
                    # Ensure we have a complete HTML document
                    if preview_html.include?('<head>')
                      preview_html = preview_html.sub(/<head[^>]*>/i, "\\0<base href=\"#{request.base_url}/\">#{error_hide_css}")
                    elsif preview_html.include?('<head')
                      preview_html = preview_html.sub(/<head/i, "<head><base href=\"#{request.base_url}/\">#{error_hide_css}</head><head")
                    elsif preview_html.include?('<html')
                      preview_html = preview_html.sub(/<html[^>]*>/i, "\\0<head><base href=\"#{request.base_url}/\">#{error_hide_css}</head>")
                    elsif preview_html.include?('<body')
                      preview_html = "<!DOCTYPE html><html><head><base href=\"#{request.base_url}/\">#{error_hide_css}</head>" + preview_html + "</html>"
                    else
                      preview_html = "<!DOCTYPE html><html><head><base href=\"#{request.base_url}/\">#{error_hide_css}</head><body style=\"background:#fff;\">#{preview_html}</body></html>"
                    end
                  %>
                  <iframe 
                    srcdoc="<%= raw preview_html.gsub('"', '&quot;').gsub("'", '&#39;') %>"
                    sandbox="allow-same-origin allow-scripts"
                    scrolling="no"
                    class="preview-iframe"
                    loading="lazy"></iframe>
                </div>
              <% else %>
                <div class="preview-placeholder landing-page">
                  <i data-lucide="file-text" style="width: 32px; height: 32px;"></i>
                  <span class="placeholder-text">No content yet</span>
                </div>
              <% end %>
              <div class="creation-type-badge">
                <i data-lucide="file-text" style="width: 12px; height: 12px;"></i>
                Landing Page
              </div>
              <div class="creation-status <%= lp.status == 'published' ? 'published' : 'draft' %>">
                <%= lp.status == 'published' ? 'Published' : 'Draft' %>
              </div>
            </div>
            <div class="creation-info">
              <h6 class="creation-title"><%= lp.title.truncate(30) %></h6>
              <div class="creation-meta">
                <span class="meta-item">
                  <i data-lucide="calendar" style="width: 12px; height: 12px;"></i>
                  <%= lp.updated_at.strftime('%b %d, %Y') %>
                </span>
                <% if lp.respond_to?(:views_count) && lp.views_count.to_i > 0 %>
                  <span class="meta-item">
                    <i data-lucide="eye" style="width: 12px; height: 12px;"></i>
                    <%= lp.views_count %> views
                  </span>
                <% end %>
              </div>
            </div>
            <div class="creation-actions">
              <button type="button" class="action-btn edit-btn" data-id="<%= lp.id %>" data-type="landing_page" title="Edit">
                <i data-lucide="edit-2" style="width: 14px; height: 14px;"></i>
              </button>
              <button type="button" class="action-btn preview-btn" data-id="<%= lp.id %>" data-type="landing_page" title="Preview">
                <i data-lucide="eye" style="width: 14px; height: 14px;"></i>
              </button>
              <button type="button" class="action-btn more-btn" data-id="<%= lp.id %>" data-type="landing_page" title="More">
                <i data-lucide="more-horizontal" style="width: 14px; height: 14px;"></i>
              </button>
            </div>
          </div>
        <% end %>
        
        <%# App Modules %>
        <% if app_modules.respond_to?(:each) %>
          <% app_modules.each do |mod| %>
            <div class="creation-card" 
                 data-id="<%= mod.id %>" 
                 data-type="app_module"
                 data-status="<%= mod.respond_to?(:published?) && mod.published? ? 'published' : 'draft' %>"
                 data-title="<%= mod.name.downcase rescue '' %>">
              <div class="creation-preview">
                <div class="preview-placeholder app-module">
                  <i data-lucide="boxes" style="width: 32px; height: 32px;"></i>
                </div>
                <div class="creation-type-badge app">
                  <i data-lucide="boxes" style="width: 12px; height: 12px;"></i>
                  App Module
                </div>
                <div class="creation-status <%= mod.respond_to?(:published?) && mod.published? ? 'published' : 'draft' %>">
                  <%= mod.respond_to?(:published?) && mod.published? ? 'Published' : 'Draft' %>
                </div>
              </div>
              <div class="creation-info">
                <h6 class="creation-title"><%= (mod.name rescue 'Untitled').truncate(30) %></h6>
                <div class="creation-meta">
                  <span class="meta-item">
                    <i data-lucide="calendar" style="width: 12px; height: 12px;"></i>
                    <%= mod.updated_at.strftime('%b %d, %Y') rescue 'N/A' %>
                  </span>
                </div>
              </div>
              <div class="creation-actions">
                <button type="button" class="action-btn edit-btn" data-id="<%= mod.id %>" data-type="app_module" title="Edit">
                  <i data-lucide="edit-2" style="width: 14px; height: 14px;"></i>
                </button>
                <button type="button" class="action-btn preview-btn" data-id="<%= mod.id %>" data-type="app_module" title="Preview">
                  <i data-lucide="eye" style="width: 14px; height: 14px;"></i>
                </button>
              </div>
            </div>
          <% end %>
        <% end %>
        
        <%# Workflows %>
        <% if workflows.respond_to?(:each) %>
          <% workflows.each do |wf| %>
            <div class="creation-card" 
                 data-id="<%= wf.id %>" 
                 data-type="workflow"
                 data-status="<%= wf.respond_to?(:active?) && wf.active? ? 'published' : 'draft' %>"
                 data-title="<%= wf.name.downcase rescue '' %>">
              <div class="creation-preview">
                <div class="preview-placeholder workflow">
                  <i data-lucide="git-branch" style="width: 32px; height: 32px;"></i>
                </div>
                <div class="creation-type-badge workflow">
                  <i data-lucide="git-branch" style="width: 12px; height: 12px;"></i>
                  Workflow
                </div>
                <div class="creation-status <%= wf.respond_to?(:active?) && wf.active? ? 'published' : 'draft' %>">
                  <%= wf.respond_to?(:active?) && wf.active? ? 'Active' : 'Draft' %>
                </div>
              </div>
              <div class="creation-info">
                <h6 class="creation-title"><%= (wf.name rescue 'Untitled').truncate(30) %></h6>
                <div class="creation-meta">
                  <span class="meta-item">
                    <i data-lucide="calendar" style="width: 12px; height: 12px;"></i>
                    <%= wf.updated_at.strftime('%b %d, %Y') rescue 'N/A' %>
                  </span>
                </div>
              </div>
              <div class="creation-actions">
                <button type="button" class="action-btn edit-btn" data-id="<%= wf.id %>" data-type="workflow" title="Edit">
                  <i data-lucide="edit-2" style="width: 14px; height: 14px;"></i>
                </button>
              </div>
            </div>
          <% end %>
        <% end %>
        
        <%# Design Plans (Drafts) %>
        <% if draft_plans.respond_to?(:each) %>
          <% draft_plans.each do |plan| %>
            <% 
              plan_data = plan.plan_data || {}
              plan_title = plan_data['title'] || plan_data.dig('content', 'headline') || "Untitled #{plan.design_type.titleize rescue 'Design'}"
              sections_count = (plan_data['sections'] || []).length
              is_built = plan.status == 'built'
            %>
            <div class="creation-card" 
                 data-id="<%= plan.id %>" 
                 data-type="design_plan"
                 data-status="<%= is_built ? 'published' : 'draft' %>"
                 data-title="<%= plan_title.downcase %>">
              <div class="creation-preview">
                <div class="preview-placeholder design-plan">
                  <i data-lucide="pencil-ruler" style="width: 32px; height: 32px;"></i>
                  <div class="plan-section-count">
                    <strong><%= sections_count %></strong> sections
                  </div>
                </div>
                <% 
                  type_icons = { 'website' => 'globe', 'app' => 'layers', 'canvas' => 'frame', 'landing_page' => 'file-text' }
                  type_labels = { 'website' => 'Website', 'app' => 'App', 'canvas' => 'Canvas', 'landing_page' => 'Landing Page' }
                  plan_type = plan.design_type.to_s
                  type_icon = type_icons[plan_type] || 'file-text'
                  type_label = type_labels[plan_type] || 'Landing Page'
                %>
                <div class="creation-type-badge design-plan <%= plan_type %>-plan">
                  <i data-lucide="<%= type_icon %>" style="width: 12px; height: 12px;"></i>
                  <%= type_label %> Plan
                </div>
                <div class="creation-status <%= is_built ? 'published' : 'draft' %>">
                  <%= is_built ? 'Built' : 'Draft' %>
                </div>
              </div>
              <div class="creation-info">
                <h6 class="creation-title"><%= plan_title.truncate(30) %></h6>
                <div class="creation-meta">
                  <span class="meta-item">
                    <i data-lucide="calendar" style="width: 12px; height: 12px;"></i>
                    <%= plan.updated_at.strftime('%b %d, %Y') %>
                  </span>
                  <span class="meta-item">
                    <i data-lucide="layers" style="width: 12px; height: 12px;"></i>
                    <%= sections_count %> sections
                  </span>
                </div>
              </div>
              <div class="creation-actions">
                <button type="button" class="action-btn edit-btn" data-id="<%= plan.id %>" data-type="design_plan" title="Open in Design Studio">
                  <i data-lucide="edit-2" style="width: 14px; height: 14px;"></i>
                </button>
                <% unless is_built %>
                  <button type="button" class="action-btn build-btn" data-id="<%= plan.id %>" data-type="design_plan" title="Build This Design">
                    <i data-lucide="hammer" style="width: 14px; height: 14px;"></i>
                  </button>
                <% end %>
              </div>
            </div>
          <% end %>
        <% end %>
        
      </div>
      
      <!-- Results Summary -->
      <div class="results-summary" id="results-summary">
        <% if search_query.present? %>
          <span class="search-results-text">
            <i data-lucide="search" style="width: 14px; height: 14px;"></i>
            Found <%= displayed_items %> results for "<%= search_query %>"
          </span>
          <button type="button" class="clear-search-btn" id="clear-search-btn">
            <i data-lucide="x" style="width: 14px; height: 14px;"></i>
            Clear Search
          </button>
        <% else %>
          <span class="total-count">
            Showing <%= [displayed_items, max_display].min %> of <%= total_items %> assets
            <% if total_items > max_display %>
              <span class="search-hint">— use search to find more</span>
            <% end %>
          </span>
        <% end %>
      </div>
      
    <% else %>
      <div class="empty-state">
        <div class="empty-icon">
          <i data-lucide="rocket" style="width: 48px; height: 48px;"></i>
        </div>
        <h5>No creations yet</h5>
        <p>Start building landing pages, websites, apps, or workflows</p>
        <button type="button" class="btn btn-primary" id="empty-create-btn">
          <i data-lucide="plus" style="width: 16px; height: 16px;" class="me-1"></i>
          Create Your First Project
        </button>
      </div>
    <% end %>
  </div>
</div>

<style>
  .my-creations-canvas {
    height: 100%;
    display: flex;
    flex-direction: column;
    background: var(--canvas-bg, #1e1e2e);
    color: var(--canvas-text, #e0e0e0);
  }
  
  .creations-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1rem 1.5rem;
    border-bottom: 1px solid var(--canvas-border, #3a3a4a);
    background: var(--canvas-header-bg, #252536);
  }
  
  .header-left {
    display: flex;
    align-items: center;
    gap: 1rem;
  }
  
  .header-icon {
    width: 32px;
    height: 32px;
    color: #f59e0b;
  }
  
  .header-title {
    margin: 0;
    font-size: 1.25rem;
    font-weight: 600;
  }
  
  .header-subtitle {
    margin: 0;
    font-size: 0.875rem;
    color: var(--canvas-text-muted, #a0a0a0);
  }
  
  .header-right {
    display: flex;
    align-items: center;
    gap: 1rem;
  }
  
  .search-box {
    position: relative;
  }
  
  .search-box .search-icon {
    position: absolute;
    left: 12px;
    top: 50%;
    transform: translateY(-50%);
    width: 16px;
    height: 16px;
    color: var(--canvas-text-muted, #a0a0a0);
  }
  
  .search-box .search-input {
    padding: 8px 12px 8px 36px;
    border: 1px solid var(--canvas-border, #3a3a4a);
    border-radius: 8px;
    background: var(--canvas-input-bg, #2a2a3a);
    color: var(--canvas-text, #e0e0e0);
    width: 220px;
  }
  
  .creations-filters {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1rem 1.5rem;
    border-bottom: 1px solid var(--canvas-border, #3a3a4a);
    flex-wrap: wrap;
    gap: 1rem;
  }
  
  .filter-group {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  
  .filter-label {
    font-size: 0.8rem;
    color: var(--canvas-text-muted, #a0a0a0);
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }
  
  .filter-tabs {
    display: flex;
    gap: 0.4rem;
  }
  
  .filter-tab {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.4rem 0.75rem;
    border: 1px solid var(--canvas-border, #3a3a4a);
    border-radius: 6px;
    background: transparent;
    color: var(--canvas-text-muted, #a0a0a0);
    font-size: 0.8rem;
    cursor: pointer;
    transition: all 0.2s;
  }
  
  .filter-tab.small {
    padding: 0.3rem 0.6rem;
    font-size: 0.75rem;
  }
  
  .filter-tab:hover {
    border-color: #f59e0b;
    color: var(--canvas-text, #e0e0e0);
  }
  
  .filter-tab.active {
    background: linear-gradient(135deg, #f59e0b 0%, #fbbf24 100%);
    border-color: transparent;
    color: #1a1a2e;
  }
  
  .filter-tab .count {
    font-size: 0.7rem;
    padding: 1px 5px;
    border-radius: 8px;
    background: rgba(255,255,255,0.15);
  }
  
  .filter-tab.active .count {
    background: rgba(0,0,0,0.15);
  }
  
  .status-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
  }
  
  .status-dot.draft {
    background: #6b7280;
  }
  
  .status-dot.published {
    background: #22c55e;
  }
  
  .creations-grid-container {
    flex: 1;
    padding: 1.5rem;
    overflow-y: auto;
  }
  
  .creations-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.25rem;
  }
  
  .creation-card {
    background: var(--canvas-card-bg, #252536);
    border: 1px solid var(--canvas-border, #3a3a4a);
    border-radius: 12px;
    overflow: hidden;
    transition: all 0.2s;
    cursor: pointer;
  }
  
  .creation-card:hover {
    border-color: #f59e0b;
    transform: translateY(-3px);
    box-shadow: 0 8px 24px rgba(245, 158, 11, 0.15);
  }
  
  .creation-preview {
    position: relative;
    height: 160px;
    overflow: hidden;
    background: #1a1a2e;
  }
  
  .preview-iframe-container {
    width: 100%;
    height: 100%;
    overflow: hidden;
    position: relative;
    background: linear-gradient(135deg, #1e293b 0%, #334155 100%);
  }
  
  /* Gradient mask to hide bottom content and errors */
  .preview-iframe-container::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 40%;
    background: linear-gradient(to bottom, transparent 0%, rgba(30, 41, 59, 0.9) 100%);
    pointer-events: none;
    z-index: 1;
  }
  
  .preview-iframe {
    width: 1200px;
    height: 800px;
    border: none;
    transform: scale(0.25);
    transform-origin: top left;
    pointer-events: none;
    position: absolute;
    top: 0;
    left: 50%;
    margin-left: -150px; /* Center the scaled iframe: (1200 * 0.25) / 2 = 150 */
    background: white;
  }
  
  .preview-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 8px;
    color: var(--canvas-text-muted, #6b6b8a);
  }
  
  .placeholder-text {
    font-size: 0.75rem;
    opacity: 0.7;
  }
  
  .preview-placeholder.landing-page {
    background: linear-gradient(135deg, #3b82f6 0%, #1d4ed8 100%);
    color: rgba(255,255,255,0.5);
  }
  
  /* Hover overlay for preview */
  .creation-preview::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, transparent 50%, rgba(0,0,0,0.6) 100%);
    opacity: 0;
    transition: opacity 0.2s ease;
    pointer-events: none;
  }
  
  .creation-card:hover .creation-preview::after {
    opacity: 1;
