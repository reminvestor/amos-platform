<div class="scout-canvas landing-page-viewer">
  <div class="canvas-header d-flex justify-content-between align-items-center mb-4">
    <div>
      <h4 class="mb-1">
        <i class="fas fa-globe text-primary me-2"></i>
        Landing Pages
      </h4>
      <p class="text-muted mb-0">Manage your marketing landing pages</p>
    </div>
    <div class="d-flex gap-2">
      <button class="btn btn-outline-secondary" id="autoRefreshToggle" onclick="toggleAutoRefresh()" title="Toggle auto refresh">
        <i class="fas fa-rotate"></i>
        <span id="autoRefreshLabel">Auto-refresh: On</span>
      </button>
      <button class="btn btn-primary" onclick="scoutCreateLandingPage()">
      <i class="fas fa-plus me-1"></i>
      Create New Page
      </button>
    </div>
  </div>
  
  <% if landing_pages.any? %>
    <!-- Quick Stats -->
    <div class="row mb-4">
      <div class="col-md-3">
        <div class="stat-card bg-light border-0 h-100">
          <div class="stat-card-body p-3">
            <div class="d-flex align-items-center">
              <div class="stat-icon bg-primary bg-opacity-10 rounded-circle p-2 me-3">
                <i class="fas fa-globe text-primary"></i>
              </div>
              <div>
                <div class="stat-number h5 mb-0"><%= landing_pages.count %></div>
                <div class="stat-label text-muted small">Total Pages</div>
              </div>
            </div>
          </div>
        </div>
      </div>
      <div class="col-md-3">
        <div class="stat-card bg-light border-0 h-100">
          <div class="stat-card-body p-3">
            <div class="d-flex align-items-center">
              <div class="stat-icon bg-success bg-opacity-10 rounded-circle p-2 me-3">
                <i class="fas fa-check-circle text-success"></i>
              </div>
              <div>
                <div class="stat-number h5 mb-0"><%= landing_pages.where(status: 'published').count %></div>
                <div class="stat-label text-muted small">Published</div>
              </div>
            </div>
          </div>
        </div>
      </div>
      <div class="col-md-3">
        <div class="stat-card bg-light border-0 h-100">
          <div class="stat-card-body p-3">
            <div class="d-flex align-items-center">
              <div class="stat-icon bg-warning bg-opacity-10 rounded-circle p-2 me-3">
                <i class="fas fa-edit text-warning"></i>
              </div>
              <div>
                <div class="stat-number h5 mb-0"><%= landing_pages.where(status: 'draft').count %></div>
                <div class="stat-label text-muted small">Drafts</div>
              </div>
            </div>
          </div>
        </div>
      </div>
      <div class="col-md-3">
        <div class="stat-card bg-light border-0 h-100">
          <div class="stat-card-body p-3">
            <div class="d-flex align-items-center">
              <div class="stat-icon bg-info bg-opacity-10 rounded-circle p-2 me-3">
                <i class="fas fa-clock text-info"></i>
              </div>
              <div>
                <div class="stat-number h5 mb-0"><%= landing_pages.where('created_at > ?', 7.days.ago).count %></div>
                <div class="stat-label text-muted small">This Week</div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
    
    <!-- Landing Pages Grid -->
    <div class="row">
      <% landing_pages.each do |page| %>
        <div class="col-lg-6 col-xl-4 mb-4">
          <div class="card landing-page-card h-100 border-0 shadow-sm" 
               data-page-id="<%= page.id %>" 
               data-has-content="<%= page.has_content? %>"
               onclick="scoutEditLandingPageInline(<%= page.id %>)" 
               style="cursor: pointer;">
            <div class="card-header bg-white border-bottom-0 d-flex justify-content-between align-items-center">
              <div class="d-flex gap-2">
                <span class="badge <%= page.status == 'published' ? 'bg-success' : page.status == 'draft' ? 'bg-warning' : 'bg-secondary' %>">
                  <%= page.status.titleize %>
                </span>
                <% unless page.has_content? %>
                  <span class="badge bg-info">
                    <i class="fas fa-cog fa-spin me-1"></i>Generating
                  </span>
                <% end %>
              </div>
              <div class="dropdown" onclick="event.stopPropagation()">
                <button class="btn btn-sm btn-outline-secondary dropdown-toggle" data-bs-toggle="dropdown" onclick="event.stopPropagation()">
                  <i class="fas fa-ellipsis-h"></i>
                </button>
                <ul class="dropdown-menu">
                  <li><a class="dropdown-item" href="#" onclick="event.stopPropagation(); scoutEditLandingPageInline(<%= page.id %>)">
                    <i class="fas fa-edit me-2"></i>Edit Page
                  </a></li>
                  <li><a class="dropdown-item" href="#" onclick="event.stopPropagation(); scoutEditLandingPage(<%= page.id %>)">
                    <i class="fas fa-code me-2"></i>Edit HTML
                  </a></li>
                  <li><a class="dropdown-item" href="#" onclick="event.stopPropagation(); scoutViewLandingPage(<%= page.id %>)">
                    <i class="fas fa-eye me-2"></i>View Details
                  </a></li>
                  <li><a class="dropdown-item" href="#" onclick="event.stopPropagation(); scoutPreviewLandingPageInTab(<%= page.id %>)">
                    <i class="fas fa-external-link-alt me-2"></i>Preview in Tab
                  </a></li>
                  <% if page.status == 'published' %>
                    <li><a class="dropdown-item" href="<%= page.full_url(request.base_url) %>" target="_blank">
                      <i class="fas fa-external-link-alt me-2"></i>View Live
                    </a></li>
                  <% end %>
                  <li><hr class="dropdown-divider"></li>
                  <li><a class="dropdown-item text-danger" href="#" onclick="scoutDeleteLandingPage(<%= page.id %>)">
                    <i class="fas fa-trash me-2"></i>Delete
                  </a></li>
                </ul>
              </div>
            </div>
            <div class="card-body">
              <div class="landing-page-preview mb-3">
                <div class="preview-placeholder bg-light rounded d-flex align-items-center justify-content-center position-relative" style="height: 120px;">
                  <% if page.has_content? %>
                    <i class="fas fa-globe text-primary fa-2x"></i>
                  <% else %>
                    <div class="text-center">
                      <div class="spinner-border text-primary mb-2" role="status" style="width: 1.5rem; height: 1.5rem;">
                        <span class="visually-hidden">Loading...</span>
                      </div>
                      <div class="small text-muted">AI Generating</div>
                    </div>
                  <% end %>
                </div>
              </div>
              <h6 class="card-title mb-2">
                <%= page.title.present? ? page.title : "Untitled Landing Page" %>
              </h6>
              <p class="card-text text-muted small">
                <%= page.description.present? ? truncate(page.description, length: 100) : "No description" %>
              </p>
              <div class="d-flex justify-content-between align-items-center">
                <small class="text-muted">
                  <i class="fas fa-clock me-1"></i>
                  <%= time_ago_in_words(page.updated_at) %> ago
                </small>
                <div class="btn-group" role="group">
                  <button class="btn btn-sm btn-outline-primary" onclick="event.stopPropagation(); scoutEditLandingPageInline(<%= page.id %>)" title="Edit Page">
                    <i class="fas fa-edit"></i>
                  </button>
                  <button class="btn btn-sm btn-outline-success" onclick="event.stopPropagation(); scoutPreviewLandingPageInTab(<%= page.id %>)" title="Preview">
                    <i class="fas fa-eye"></i>
                  </button>
                </div>
              </div>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <!-- Empty State -->
    <div class="empty-state text-center py-5">
      <div class="empty-icon mb-3">
        <i class="fas fa-globe text-muted" style="font-size: 4rem;"></i>
      </div>
      <h5 class="text-muted">No landing pages yet</h5>
      <p class="text-muted mb-4">
        Create your first landing page to start converting visitors into customers.<br>
        Landing pages are focused, single-purpose pages designed to drive specific actions.
      </p>
      <button class="btn btn-primary btn-lg" onclick="scoutCreateLandingPage()">
        <i class="fas fa-plus me-2"></i>
        Create Your First Landing Page
      </button>
    </div>
  <% end %>
</div>

<script>
// Global flag to control auto-refresh behavior
window.scoutAutoRefreshEnabled = true;
function toggleAutoRefresh(){
  window.scoutAutoRefreshEnabled = !window.scoutAutoRefreshEnabled;
  const label = document.getElementById('autoRefreshLabel');
  if (label) label.textContent = `Auto-refresh: ${window.scoutAutoRefreshEnabled ? 'On' : 'Off'}`;
}

function scoutCreateLandingPage() {
  // Fast-path: open the landing page wizard directly (bypass chat)
  window.scoutLoadCanvas?.('landing_page_generator', {});
}

function scoutViewLandingPage(pageId) {
  // Load the landing page details canvas
  window.scoutLoadCanvas?.('landing_page_details', { landing_page_id: pageId });
}

function scoutEditLandingPage(pageId) {
  // Load the landing page generator canvas
  window.scoutLoadCanvas?.('landing_page_generator', { landing_page_id: pageId });
}

function scoutEditLandingPageInline(pageId) {
  // Load the inline editor canvas
  window.scoutLoadCanvas?.('landing_page_editor', { landing_page_id: pageId });
}

function scoutPreviewLandingPageInTab(pageId) {
  // Open preview in new tab
  window.open(`/landing_pages/${pageId}/preview`, '_blank');
}

function scoutDeleteLandingPage(pageId) {
  if (confirm('Are you sure you want to delete this landing page?')) {
    // Send delete request
    fetch(`/landing_pages/${pageId}`, {
      method: 'DELETE',
      headers: {
        'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]').content
      }
    }).then(() => {
      // Refresh the canvas
      window.scoutRefreshCanvas?.();
    });
  }
}

// Auto-refresh functionality for detecting AI generation completion
window.initLandingPageAutoRefresh = function() {
  console.log('🔄 Initializing landing page auto-refresh for AI generation detection');
  
  // Check if there are any pages currently generating
  function hasGeneratingPages() {
    // Primary detection: data attributes
    const pagesWithoutContent = document.querySelectorAll('.landing-page-card[data-has-content="false"]');
    
    // Secondary detection: visual indicators
    const generatingBadges = Array.from(document.querySelectorAll('.badge')).filter(badge => 
      badge.textContent.includes('Generating'));
    const spinners = document.querySelectorAll('.preview-placeholder .spinner-border');
    const aiGeneratingText = Array.from(document.querySelectorAll('.small')).filter(el => 
      el.textContent.includes('AI Generating'));
    
    const total = pagesWithoutContent.length + generatingBadges.length + spinners.length + aiGeneratingText.length;
    console.log(`📊 Found ${pagesWithoutContent.length} pages without content, ${generatingBadges.length} generating badges, ${spinners.length} spinners, ${aiGeneratingText.length} AI generating text (total: ${total})`);
    
    // Get page IDs for tracking
    const generatingPageIds = Array.from(pagesWithoutContent).map(card => card.dataset.pageId);
    if (generatingPageIds.length > 0) {
      console.log(`🔍 Pages generating: ${generatingPageIds.join(', ')}`);
    }
    
    return total > 0;
  }
  
  if (hasGeneratingPages()) {
    console.log('⏱️ Starting auto-refresh timer for AI generation completion');
    
    let refreshCount = 0;
    const maxRefreshes = 6; // Limit to ~1 minute (6 * 10s)
    
    // Set up polling every 10 seconds to check for completion
    const refreshInterval = setInterval(() => {
      if (!window.scoutAutoRefreshEnabled) {
        console.log('⏸️ Auto-refresh paused');
        return;
      }
      refreshCount++;
      console.log(`🔍 Checking for AI generation completion... (check ${refreshCount}/${maxRefreshes})`);
      
      if (hasGeneratingPages()) {
        console.log('⏳ Pages still generating, refreshing canvas...');
        // Refresh the canvas to get updated content
        // Avoid disrupting user typing: skip if chat input is focused
        const active = document.activeElement;
        const chatInput = document.querySelector('[data-scout-target="chatInput"]');
        if (active && chatInput && active === chatInput) {
          console.log('✋ Skipping refresh while user is typing');
        } else {
          window.scoutRefreshCanvas?.();
        }
        
        // Safety: stop after max refreshes
        if (refreshCount >= maxRefreshes) {
          console.log('⚠️ Maximum refresh attempts reached, stopping auto-refresh');
          clearInterval(refreshInterval);
        }
      } else {
        console.log('✅ All AI generation completed, stopping auto-refresh');
        clearInterval(refreshInterval);
      }
    }, 10000); // Check every 10 seconds
    
    // Fallback: stop after 5 minutes max
    setTimeout(() => {
      console.log('⏰ Auto-refresh timeout reached, stopping');
      clearInterval(refreshInterval);
    }, 300000); // 5 minutes max
  } else {
    console.log('✅ No pages generating, auto-refresh not needed');
  }
};

// Initialize auto-refresh when the canvas loads
document.addEventListener('DOMContentLoaded', () => {
  console.log('📋 Landing page viewer loaded, initializing auto-refresh');
  window.initLandingPageAutoRefresh();
});

// Also initialize after a slight delay for dynamic loading
setTimeout(() => {
  window.initLandingPageAutoRefresh();
}, 1000);
</script>

<style>
.scout-canvas {
  padding: 1rem;
  height: 100%;
  overflow-y: auto;
}

.stat-card {
  transition: transform 0.2s ease;
}

.stat-card:hover {
  transform: translateY(-2px);
}

.landing-page-card {
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.landing-page-card:hover {
  transform: translateY(-5px);
  box-shadow: 0 8px 25px rgba(0,0,0,0.1) !important;
}

.preview-placeholder {
  border: 2px dashed #dee2e6;
  transition: all 0.2s ease;
}

.landing-page-card:hover .preview-placeholder {
  border-color: #007bff;
  background-color: rgba(0, 123, 255, 0.05) !important;
}

.empty-state {
  max-width: 500px;
  margin: 0 auto;
}
</style> 