<div class="canvas-container">
  <!-- Page Header -->
  <div class="canvas-page-header" style="margin-bottom: 2rem;">
    <h1 class="canvas-page-title" style="display: flex; align-items: center; gap: 1rem;">
      <i data-lucide="globe" style="width: 2rem; height: 2rem;"></i>
      Landing Pages
    </h1>
    <p class="canvas-page-subtitle" style="margin-bottom: 0;">Manage your marketing landing pages</p>
  </div>

  <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem;">
    <div></div>
    <div style="display: flex; gap: 0.5rem;">
      <button onclick="toggleAutoRefresh()" 
              aria-label="Toggle auto refresh"
              class="canvas-btn secondary">
        <i data-lucide="refresh-cw" class="canvas-icon-sm"></i>
        <span id="autoRefreshLabel">Auto-refresh: On</span>
      </button>
      <button onclick="scoutCreateLandingPage()" 
              aria-label="Create new landing page"
              class="canvas-btn primary">
        <i data-lucide="plus" class="canvas-icon-sm"></i>
        Create New Page
      </button>
    </div>
  </div>
  
  <% if landing_pages.any? %>
    <!-- Quick Stats -->
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1rem; margin-bottom: 2rem;">
      <div style="background: linear-gradient(135deg, rgba(124, 58, 237, 0.2) 0%, rgba(167, 139, 250, 0.05) 100%); border: 1px solid rgba(124, 58, 237, 0.3); border-radius: 0.75rem; padding: 1.5rem;">
        <div style="display: flex; align-items: center; justify-content: space-between;">
          <div>
            <p class="canvas-stat-label">Total Pages</p>
            <p class="canvas-stat-value"><%= landing_pages.count %></p>
          </div>
          <div style="width: 2.5rem; height: 2.5rem; border-radius: 0.5rem; background: var(--accent-glow); display: flex; align-items: center; justify-content: center;">
            <i data-lucide="globe" class="canvas-icon-md canvas-icon-purple"></i>
          </div>
        </div>
      </div>

      <div style="background: linear-gradient(135deg, rgba(74, 222, 128, 0.2) 0%, rgba(74, 222, 128, 0.05) 100%); border: 1px solid rgba(74, 222, 128, 0.3); border-radius: 0.75rem; padding: 1.5rem;">
        <div style="display: flex; align-items: center; justify-content: space-between;">
          <div>
            <p class="canvas-stat-label">Published</p>
            <p class="canvas-stat-value"><%= landing_pages.where(status: 'published').count %></p>
          </div>
          <div style="width: 2.5rem; height: 2.5rem; border-radius: 0.5rem; background: var(--status-success-bg); display: flex; align-items: center; justify-content: center;">
            <i data-lucide="check-circle" class="canvas-icon-md canvas-icon-success"></i>
          </div>
        </div>
      </div>

      <div style="background: linear-gradient(135deg, rgba(250, 204, 21, 0.2) 0%, rgba(250, 204, 21, 0.05) 100%); border: 1px solid rgba(250, 204, 21, 0.3); border-radius: 0.75rem; padding: 1.5rem;">
        <div style="display: flex; align-items: center; justify-content: space-between;">
          <div>
            <p class="canvas-stat-label">Drafts</p>
            <p class="canvas-stat-value"><%= landing_pages.where(status: 'draft').count %></p>
          </div>
          <div style="width: 2.5rem; height: 2.5rem; border-radius: 0.5rem; background: var(--status-warning-bg); display: flex; align-items: center; justify-content: center;">
            <i data-lucide="file-edit" class="canvas-icon-md canvas-icon-warning"></i>
          </div>
        </div>
      </div>

      <div style="background: linear-gradient(135deg, rgba(34, 211, 238, 0.2) 0%, rgba(34, 211, 238, 0.05) 100%); border: 1px solid rgba(34, 211, 238, 0.3); border-radius: 0.75rem; padding: 1.5rem;">
        <div style="display: flex; align-items: center; justify-content: space-between;">
          <div>
            <p class="canvas-stat-label">This Week</p>
            <p class="canvas-stat-value"><%= landing_pages.where('created_at > ?', 7.days.ago).count %></p>
          </div>
          <div style="width: 2.5rem; height: 2.5rem; border-radius: 0.5rem; background: var(--status-info-bg); display: flex; align-items: center; justify-content: center;">
            <i data-lucide="clock" class="canvas-icon-md canvas-icon-cyan"></i>
          </div>
        </div>
      </div>
    </div>
    
    <!-- Landing Pages Grid -->
    <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 1.5rem;">
      <% landing_pages.each do |page| %>
        <div data-page-id="<%= page.id %>" 
             data-has-content="<%= page.has_content? %>"
             onclick="<%= page.has_content? ? "scoutEditLandingPageInline(#{page.id})" : (page.metadata&.dig('generation_requested') ? "scoutOpenInteractiveWizard(#{page.id})" : "scoutEditLandingPageInline(#{page.id})") %>" 
             class="canvas-card" style="padding: 1.5rem; cursor: pointer; transition: transform 0.2s ease, box-shadow 0.2s ease;"
             onmouseover="this.style.transform='translateY(-5px)'; this.style.boxShadow='0 8px 25px rgba(0,0,0,0.3)';"
             onmouseout="this.style.transform=''; this.style.boxShadow='';">
          <!-- Card Header -->
          <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
            <div style="display: flex; gap: 0.5rem; flex-wrap: wrap;">
              <span style="background: <%= page.status == 'published' ? 'rgba(74, 222, 128, 0.2)' : page.status == 'draft' ? 'rgba(250, 204, 21, 0.2)' : 'rgba(100, 116, 139, 0.2)' %>; color: <%= page.status == 'published' ? 'rgb(74, 222, 128)' : page.status == 'draft' ? 'rgb(250, 204, 21)' : 'rgb(100, 116, 139)' %>; padding: 0.25rem 0.75rem; border-radius: 0.375rem; font-size: 0.75rem; font-weight: 600;">
                <%= page.status.titleize %>
              </span>
              <% unless page.has_content? %>
                <span style="background: rgba(34, 211, 238, 0.2); color: var(--accent-cyan); padding: 0.25rem 0.75rem; border-radius: 0.375rem; font-size: 0.75rem; font-weight: 600;">
                  <i data-lucide="settings" style="width: 0.75rem; height: 0.75rem; display: inline; margin-right: 0.25rem; animation: spin 1s linear infinite;"></i>Generating
                </span>
              <% end %>
            </div>
            <div class="dropdown" onclick="event.stopPropagation()">
              <button class="btn btn-sm canvas-btn secondary"
                      data-bs-toggle="dropdown"
                      onclick="event.stopPropagation()"
                      aria-label="More actions for <%= page.title %>">
                <i data-lucide="more-horizontal" class="canvas-icon-sm"></i>
              </button>
              <ul class="dropdown-menu canvas-dropdown-menu">
                <li><a class="dropdown-item" href="#" onclick="event.stopPropagation(); scoutEditLandingPageInline(<%= page.id %>)">
                  <i data-lucide="pencil" class="canvas-icon-sm" style="width: 0.875rem; height: 0.875rem; margin-right: 0.5rem;"></i>Edit Page
                </a></li>
                <li><a class="dropdown-item" href="#" onclick="event.stopPropagation(); scoutEditLandingPage(<%= page.id %>)">
                  <i data-lucide="code" class="canvas-icon-sm" style="width: 0.875rem; height: 0.875rem; margin-right: 0.5rem;"></i>Edit HTML
                </a></li>
                <li><a class="dropdown-item" href="#" onclick="event.stopPropagation(); scoutViewLandingPage(<%= page.id %>)">
                  <i data-lucide="eye" class="canvas-icon-sm" style="width: 0.875rem; height: 0.875rem; margin-right: 0.5rem;"></i>View Details
                </a></li>
                <li><a class="dropdown-item" href="#" onclick="event.stopPropagation(); scoutPreviewLandingPageInTab(<%= page.id %>)">
                  <i data-lucide="external-link" class="canvas-icon-sm" style="width: 0.875rem; height: 0.875rem; margin-right: 0.5rem;"></i>Preview in Tab
                </a></li>
                <% if page.status == 'published' %>
                  <li><a class="dropdown-item" href="<%= page.full_url(request.base_url) %>" target="_blank">
                    <i data-lucide="external-link" class="canvas-icon-sm" style="width: 0.875rem; height: 0.875rem; margin-right: 0.5rem;"></i>View Live
                  </a></li>
                <% end %>
                <li><hr class="dropdown-divider" style="border-color: var(--border-primary);"></li>
                <li><a class="dropdown-item" href="#" onclick="scoutDeleteLandingPage(<%= page.id %>)" style="color: var(--status-error-text);">
                  <i data-lucide="trash-2" class="canvas-icon-sm" style="width: 0.875rem; height: 0.875rem; margin-right: 0.5rem;"></i>Delete
                </a></li>
              </ul>
            </div>
          </div>

          <!-- Preview Placeholder -->
          <div class="canvas-empty-state" style="border: 2px dashed var(--border-primary); border-radius: 0.5rem; height: 120px; display: flex; align-items: center; justify-content: center; margin-bottom: 1rem; transition: all 0.2s ease;">
            <% if page.has_content? %>
              <i data-lucide="globe" class="canvas-icon-4x canvas-icon-purple"></i>
            <% else %>
              <div style="text-align: center;">
                <% if page.metadata&.dig('generation_requested') %>
                  <i data-lucide="wand-2" class="canvas-icon-4x canvas-icon-cyan" style="margin-bottom: 0.5rem;"></i>
                  <div style="color: var(--text-muted); font-size: 0.875rem;">Click to start wizard</div>
                <% else %>
                  <div class="spinner-border" role="status" style="color: var(--accent-purple-end); margin-bottom: 0.5rem;">
                    <span class="visually-hidden">Loading...</span>
                  </div>
                  <div style="color: var(--text-muted); font-size: 0.875rem;">AI Generating</div>
                <% end %>
              </div>
            <% end %>
          </div>

          <!-- Card Content -->
          <h6 style="margin: 0 0 0.5rem 0; font-weight: 600; font-size: 1rem; color: var(--text-primary);">
            <%= page.title.present? ? page.title : "Untitled Landing Page" %>
          </h6>
          <p style="font-size: 0.875rem; margin: 0 0 1rem 0; color: var(--text-muted);">
            <%= page.description.present? ? truncate(page.description, length: 100) : "No description" %>
          </p>
          <div style="display: flex; justify-content: space-between; align-items: center; padding-top: 1rem; border-top: 1px solid var(--border-primary);">
            <small style="color: var(--text-muted); display: flex; align-items: center; gap: 0.25rem;">
              <i data-lucide="clock" class="canvas-icon-sm"></i>
              <%= time_ago_in_words(page.updated_at) %> ago
            </small>
            <div style="display: flex; gap: 0.5rem;">
              <button onclick="event.stopPropagation(); scoutEditLandingPageInline(<%= page.id %>)"
                      aria-label="Edit <%= page.title %>"
                      class="canvas-btn secondary">
                <i data-lucide="pencil" class="canvas-icon-sm"></i>
              </button>
              <button onclick="event.stopPropagation(); scoutPreviewLandingPageInTab(<%= page.id %>)"
                      aria-label="Preview <%= page.title %>"
                      class="canvas-btn secondary">
                <i data-lucide="eye" class="canvas-icon-sm"></i>
              </button>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <!-- Empty State -->
    <div class="canvas-empty-state" style="text-align: center; padding: 3rem 0; max-width: 500px; margin: 0 auto;">
      <div style="margin-bottom: 1.5rem;">
        <i data-lucide="globe" class="canvas-icon-4x canvas-icon-muted"></i>
      </div>
      <h5 class="canvas-empty-state-text" style="margin-bottom: 1rem;">No landing pages yet</h5>
      <p class="canvas-empty-state-text-muted" style="margin-bottom: 2rem;">
        Create your first landing page to start converting visitors into customers.<br>
        Landing pages are focused, single-purpose pages designed to drive specific actions.
      </p>
      <button onclick="scoutCreateLandingPage()" 
              aria-label="Create your first landing page"
              class="canvas-btn primary">
        <i data-lucide="plus" class="canvas-icon-sm"></i>
        Create Your First Landing Page
      </button>
    </div>
  <% end %>
</div>

<script>
// Disabled auto-refresh - now using real-time WebSocket updates
window.scoutAutoRefreshEnabled = false;
function toggleAutoRefresh(){
  // Auto-refresh disabled - using real-time updates instead
  console.log('Auto-refresh disabled - using real-time WebSocket updates');
}

// scoutCreateLandingPage function is defined globally in scout_controller.js

function scoutViewLandingPage(pageId) {
  // Load the landing page details canvas
  window.scoutLoadCanvas?.('landing_page_details', { landing_page_id: pageId });
}

function scoutEditLandingPage(pageId) {
  // Load the landing page generator canvas
  window.scoutSendMessage?.(`Please help me edit landing page ID ${pageId}`);
}

function scoutEditLandingPageInline(pageId) {
  // Load the inline editor canvas
  window.scoutLoadCanvas?.('landing_page_editor', { landing_page_id: pageId });
}

function scoutOpenInteractiveWizard(pageId) {
  // Use the working chat workflow instead of direct canvas loading
  window.scoutController?.sendScoutMessage(`Continue creating landing page ID ${pageId}`);
}

function scoutPreviewLandingPageInTab(pageId) {
  // Open preview in new tab
  window.open(`/landing_pages/${pageId}/preview`, '_blank');
}

function scoutDeleteLandingPage(pageId) {
  if (confirm('Are you sure you want to delete this landing page?')) {
    // Send delete request
    fetch(`/landing_pages/${pageId}`, {
      method: 'DELETE',
      headers: {
        'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]').content
      }
    }).then(() => {
      // Refresh the canvas
      window.scoutRefreshCanvas?.();
    });
  }
}

// Auto-refresh functionality for detecting AI generation completion
window.initLandingPageAutoRefresh = function() {
  console.log('🔄 Initializing landing page auto-refresh for AI generation detection');
  
  // Check if there are any pages currently generating
  function hasGeneratingPages() {
    // Primary detection: data attributes
    const pagesWithoutContent = document.querySelectorAll('[data-has-content="false"]');
    
    // Secondary detection: visual indicators
    const generatingBadges = Array.from(document.querySelectorAll('span')).filter(badge => 
      badge.textContent.includes('Generating'));
    const spinners = document.querySelectorAll('.spinner-border');
    const aiGeneratingText = Array.from(document.querySelectorAll('div')).filter(el => 
      el.textContent.includes('AI Generating'));
    
    const total = pagesWithoutContent.length + generatingBadges.length + spinners.length + aiGeneratingText.length;
    console.log(`📊 Found ${pagesWithoutContent.length} pages without content, ${generatingBadges.length} generating badges, ${spinners.length} spinners, ${aiGeneratingText.length} AI generating text (total: ${total})`);
    
    // Get page IDs for tracking
    const generatingPageIds = Array.from(pagesWithoutContent).map(card => card.dataset.pageId);
    if (generatingPageIds.length > 0) {
      console.log(`🔍 Pages generating: ${generatingPageIds.join(', ')}`);
    }
    
    return total > 0;
  }
  
  if (hasGeneratingPages()) {
    console.log('⏱️ Starting auto-refresh timer for AI generation completion');
    
    let refreshCount = 0;
    const maxRefreshes = 6; // Limit to ~1 minute (6 * 10s)
    
    // Set up polling every 10 seconds to check for completion
    const refreshInterval = setInterval(() => {
      if (!window.scoutAutoRefreshEnabled) {
        console.log('⏸️ Auto-refresh paused');
        return;
      }
      refreshCount++;
      console.log(`🔍 Checking for AI generation completion... (check ${refreshCount}/${maxRefreshes})`);
      
      if (hasGeneratingPages()) {
        console.log('⏳ Pages still generating, refreshing canvas...');
        // Refresh the canvas to get updated content
        // Avoid disrupting user typing: skip if chat input is focused
        const active = document.activeElement;
        const chatInput = document.querySelector('[data-scout-target="chatInput"]');
        if (active && chatInput && active === chatInput) {
          console.log('✋ Skipping refresh while user is typing');
        } else {
          window.scoutRefreshCanvas?.();
        }
        
        // Safety: stop after max refreshes
        if (refreshCount >= maxRefreshes) {
          console.log('⚠️ Maximum refresh attempts reached, stopping auto-refresh');
          clearInterval(refreshInterval);
        }
      } else {
        console.log('✅ All AI generation completed, stopping auto-refresh');
        clearInterval(refreshInterval);
      }
    }, 10000); // Check every 10 seconds
    
    // Fallback: stop after 5 minutes max
    setTimeout(() => {
      console.log('⏰ Auto-refresh timeout reached, stopping');
      clearInterval(refreshInterval);
    }, 300000); // 5 minutes max
  } else {
    console.log('✅ No pages generating, auto-refresh not needed');
  }
};

// Auto-refresh disabled - using real-time updates instead
document.addEventListener('DOMContentLoaded', () => {
  console.log('📋 Landing page viewer loaded - auto-refresh disabled');
  if (typeof lucide !== 'undefined') {
    lucide.createIcons();
  }
});

document.addEventListener('turbo:load', () => {
  if (typeof lucide !== 'undefined') {
    lucide.createIcons();
  }
});
</script>

<style>
@keyframes spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}
</style>
