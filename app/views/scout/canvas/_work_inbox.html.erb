<div class="work-inbox-canvas">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <div>
      <h4 class="mb-1">
        <i data-lucide="inbox" class="me-2"></i>
        Work Inbox
      </h4>
      <p class="text-muted mb-0 small">
        <% unread_count = AgentWorkItem.unread_count_for(current_user, current_entity) %>
        <% action_count = AgentWorkItem.action_required_count_for(current_user, current_entity) %>
        <span class="badge bg-primary me-1"><%= unread_count %> unread</span>
        <% if action_count > 0 %>
          <span class="badge bg-warning text-dark"><%= action_count %> action required</span>
        <% end %>
      </p>
    </div>
    <div class="btn-group btn-group-sm" role="group">
      <button type="button" class="btn btn-outline-light active" data-filter="unread">Unread</button>
      <button type="button" class="btn btn-outline-light" data-filter="all">All</button>
      <button type="button" class="btn btn-outline-light" data-filter="starred">Starred</button>
      <button type="button" class="btn btn-outline-light" data-filter="action">Action</button>
    </div>
  </div>

  <div id="inboxItems" class="inbox-items">
    <% items = AgentWorkItem.inbox_for(current_user, current_entity).limit(50) %>
    <% if items.any? %>
      <% items.each do |item| %>
        <div class="inbox-item <%= 'unread' unless item.read? %> <%= 'starred' if item.starred? %> <%= 'action-required' if item.requires_action? %>"
             data-item-id="<%= item.id %>"
             data-read="<%= item.read? %>">
          <div class="d-flex align-items-start">
            <div class="inbox-item-icon me-3">
              <span class="icon-emoji"><%= item.icon %></span>
            </div>
            <div class="flex-grow-1">
              <div class="d-flex justify-content-between align-items-start">
                <div>
                  <h6 class="mb-1 inbox-item-title">
                    <%= item.title %>
                    <% if item.requires_action? %>
                      <span class="badge bg-warning text-dark ms-1">Action Required</span>
                    <% end %>
                    <% if item.priority == 'high' || item.priority == 'urgent' %>
                      <span class="badge bg-danger ms-1"><%= item.priority.capitalize %></span>
                    <% end %>
                  </h6>
                  <p class="mb-1 text-muted small inbox-item-summary">
                    <%= truncate(item.summary, length: 150) if item.summary %>
                  </p>
                  <div class="inbox-item-meta small text-muted">
                    <span class="me-2"><%= item.agent_name %></span>
                    <span><%= item.time_ago %></span>
                  </div>
                </div>
                <div class="inbox-item-actions d-flex align-items-center gap-1">
                  <%# Feedback buttons with proper attribution %>
                  <% feedbackable_type, feedbackable_id = if item.agent_plugin_execution_id
                    ['AgentPluginExecution', item.agent_plugin_execution_id]
                  elsif item.scheduled_task_run_id
                    ['ScheduledTaskRun', item.scheduled_task_run_id]
                  else
                    ['AgentWorkItem', item.id]
                  end %>
                  <div class="feedback-mini d-flex gap-1" data-work-item-id="<%= item.id %>">
                    <button class="btn btn-sm btn-link text-muted feedback-btn" 
                            data-action="feedback" 
                            data-rating="1"
                            data-feedbackable-type="<%= feedbackable_type %>"
                            data-feedbackable-id="<%= feedbackable_id %>"
                            title="Helpful">
                      <i data-lucide="thumbs-up" style="width: 14px; height: 14px;"></i>
                    </button>
                    <button class="btn btn-sm btn-link text-muted feedback-btn" 
                            data-action="feedback" 
                            data-rating="-1"
                            data-feedbackable-type="<%= feedbackable_type %>"
                            data-feedbackable-id="<%= feedbackable_id %>"
                            title="Not helpful">
                      <i data-lucide="thumbs-down" style="width: 14px; height: 14px;"></i>
                    </button>
                  </div>
                  <button class="btn btn-sm btn-link text-muted star-btn" data-item-id="<%= item.id %>" title="Star">
                    <i data-lucide="<%= item.starred? ? 'star' : 'star' %>" 
                       class="<%= 'text-warning' if item.starred? %>"
                       style="width: 16px; height: 16px;"></i>
                  </button>
                  <button class="btn btn-sm btn-link text-muted archive-btn" data-item-id="<%= item.id %>" title="Archive">
                    <i data-lucide="archive" style="width: 16px; height: 16px;"></i>
                  </button>
                </div>
              </div>
            </div>
          </div>
        </div>
      <% end %>
    <% else %>
      <div class="empty-inbox text-center py-5">
        <i data-lucide="check-circle" class="mb-3 text-success" style="width: 48px; height: 48px;"></i>
        <h5>All caught up!</h5>
        <p class="text-muted">No unread items in your inbox.</p>
      </div>
    <% end %>
  </div>
</div>

<style>
  .work-inbox-canvas {
    height: 100%;
    overflow-y: auto;
    padding: 20px;
  }

  .inbox-items {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .inbox-item {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 8px;
    padding: 16px;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .inbox-item:hover {
    background: rgba(255, 255, 255, 0.1);
    border-color: rgba(255, 255, 255, 0.2);
  }

  .inbox-item.unread {
    background: rgba(13, 110, 253, 0.1);
    border-left: 3px solid #0d6efd;
  }

  .inbox-item.starred {
    background: rgba(255, 193, 7, 0.1);
  }

  .inbox-item.action-required {
    border-left: 3px solid #ffc107;
  }

  .inbox-item-icon {
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(255, 255, 255, 0.1);
    border-radius: 8px;
  }

  .icon-emoji {
    font-size: 20px;
  }

  .inbox-item-title {
    color: #fff;
    font-weight: 500;
  }

  .inbox-item-summary {
    color: rgba(255, 255, 255, 0.7);
  }

  .inbox-item-meta {
    color: rgba(255, 255, 255, 0.5);
  }

  .inbox-item-actions {
    opacity: 0;
    transition: opacity 0.2s ease;
  }

  .inbox-item:hover .inbox-item-actions {
    opacity: 1;
  }

  .empty-inbox {
    color: rgba(255, 255, 255, 0.7);
  }

  .btn-group .btn.active {
    background: rgba(255, 255, 255, 0.2);
  }
  
  /* Expanded inbox item */
  .inbox-item.expanded {
    background: rgba(99, 102, 241, 0.15);
    border-color: rgba(99, 102, 241, 0.4);
  }
  
  /* Work Item Detail Panel - Inline Expansion */
  .work-item-detail-panel {
    position: relative;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(99, 102, 241, 0.3);
    border-top: none;
    border-radius: 0 0 12px 12px;
    margin-top: -8px;
    margin-bottom: 8px;
    overflow: hidden;
    max-height: 0;
    opacity: 0;
    transition: max-height 0.3s ease, opacity 0.2s ease;
  }
  
  .detail-panel-header-inline {
    padding: 12px 16px;
    background: rgba(99, 102, 241, 0.1);
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }
  
  .detail-panel-header-inline h5 {
    color: #fff;
    margin: 0;
    font-size: 1rem;
  }
  
  .detail-panel-content {
    padding: 16px;
    color: #fff;
    max-height: 50vh;
    overflow-y: auto;
  }
  
  .detail-panel-content a {
    color: #6ea8fe !important;
    text-decoration: none;
    cursor: pointer;
  }
  
  .detail-panel-content a:hover {
    color: #9ec5fe !important;
    text-decoration: underline;
  }
  
  /* Floating Close Button */
  .floating-close-btn {
    position: sticky;
    bottom: 12px;
    left: calc(100% - 48px);
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: rgba(99, 102, 241, 0.9);
    border: none;
    color: #fff;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.3);
    transition: all 0.2s ease;
    z-index: 10;
    margin-left: auto;
    margin-right: 12px;
  }
  
  .floating-close-btn:hover {
    background: rgba(99, 102, 241, 1);
    transform: scale(1.1);
  }
</style>

<script>
(function() {
  console.log('📥 Initializing Work Inbox canvas');

  // Listen for work inbox updates and refresh
  window.addEventListener('work-inbox-update', function(e) {
    console.log('📥 Work inbox update received, refreshing...', e.detail);
    
    // Debounce the refresh to avoid multiple reloads
    if (window.workInboxRefreshTimeout) {
      clearTimeout(window.workInboxRefreshTimeout);
    }
    
    window.workInboxRefreshTimeout = setTimeout(function() {
      // Reload the work inbox canvas
      if (typeof window.scoutLoadCanvas === 'function') {
        window.scoutLoadCanvas('work_inbox', {}, true); // force refresh
      }
    }, 1000); // Wait 1 second for any additional updates
  });

  // Helper function to send message to Scout
  function sendToScout(message) {
    console.log('📤 Sending to Scout:', message);
    // Try global function first (most reliable)
    if (typeof window.scoutSendMessage === 'function') {
      window.scoutSendMessage(message);
    } else {
      // Fallback to custom event
      window.dispatchEvent(new CustomEvent('scout:send-message', {
        detail: { message: message }
      }));
    }
  }

  // Filter buttons - filter locally without chat
  document.querySelectorAll('[data-filter]').forEach(btn => {
    btn.addEventListener('click', function() {
      document.querySelectorAll('[data-filter]').forEach(b => b.classList.remove('active'));
      this.classList.add('active');
      
      const filter = this.dataset.filter;
      console.log('📋 Filtering inbox:', filter);
      
      // Filter items locally
      let visibleCount = 0;
      document.querySelectorAll('.inbox-item').forEach(item => {
        const isUnread = item.classList.contains('unread');
        const isStarred = item.classList.contains('starred');
        const isAction = item.classList.contains('action-required');
        
        let show = false;
        switch(filter) {
          case 'all':
            show = true;
            break;
          case 'unread':
            show = isUnread;
            break;
          case 'starred':
            show = isStarred;
            break;
          case 'action':
            show = isAction;
            break;
          default:
            show = true;
        }
        
        if (show) {
          item.style.display = '';
          visibleCount++;
        } else {
          item.style.display = 'none';
        }
      });
      
      console.log('📋 Visible items after filter:', visibleCount);
      
      // Show/hide empty state based on visible items
      const emptyState = document.querySelector('.empty-inbox');
      if (emptyState) {
        emptyState.style.display = visibleCount === 0 ? 'block' : 'none';
      }
      
      // Create a temporary empty message if needed and no existing empty state
      if (visibleCount === 0 && !emptyState) {
        const inboxItems = document.getElementById('inboxItems');
        let tempEmpty = inboxItems.querySelector('.temp-empty-state');
        if (!tempEmpty) {
          tempEmpty = document.createElement('div');
          tempEmpty.className = 'temp-empty-state text-center py-4';
          tempEmpty.innerHTML = `
            <i data-lucide="filter" class="mb-2" style="width: 32px; height: 32px; opacity: 0.5;"></i>
            <p class="text-muted mb-0">No ${filter} items</p>
          `;
          inboxItems.appendChild(tempEmpty);
          if (typeof lucide !== 'undefined') lucide.createIcons();
        }
        tempEmpty.style.display = 'block';
      } else {
        const tempEmpty = document.querySelector('.temp-empty-state');
        if (tempEmpty) tempEmpty.style.display = 'none';
      }
    });
  });

  // Track currently expanded item
  let currentlyExpandedItem = null;
  
  // Click on item to view details
  document.querySelectorAll('.inbox-item').forEach(item => {
    item.addEventListener('click', function(e) {
      if (e.target.closest('.inbox-item-actions')) return;
      if (e.target.closest('.close-detail-btn')) return;
      
      const itemId = this.dataset.itemId;
      console.log('👁️ Viewing item:', itemId);
      
      // Mark as read visually
      this.classList.remove('unread');
      
      // Load the work item detail inline
      loadWorkItemDetail(itemId, this);
    });
  });
  
  // Load work item detail - show inline below the clicked item
  window.loadWorkItemDetail = function(itemId, clickedElement) {
    console.log('📄 Loading work item detail:', itemId);
    
    // Mark as read via API (fire and forget)
    fetch(`/api/work_items/${itemId}/mark_read`, {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]')?.content
      }
    }).catch(err => console.error('Mark read failed:', err));
    
    // Fetch the work item content
    fetch(`/api/work_items/${itemId}/content`, {
      method: 'GET',
      headers: {
        'Accept': 'application/json',
        'Content-Type': 'application/json',
        'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]')?.content
      }
    })
    .then(response => {
      console.log('📄 API response status:', response.status);
      if (!response.ok) {
        throw new Error(`HTTP error! status: ${response.status}`);
      }
      return response.json();
    })
    .then(data => {
      console.log('📄 API response data:', data);
      
      if (data.success) {
        // Show detail panel inline below the clicked item
        showWorkItemDetailPanel(data, clickedElement);
      } else {
        console.error('❌ API returned success: false', data);
        sendToScout(`Show me the details for work item #${itemId}`);
      }
    })
    .catch(err => {
      console.error('❌ Failed to load work item:', err);
      sendToScout(`Show me the details for work item #${itemId}`);
    });
  };
  
  // Collapse any expanded item
  window.collapseWorkItemDetail = function() {
    const existingPanel = document.querySelector('.work-item-detail-panel');
    if (existingPanel) {
      existingPanel.style.maxHeight = '0';
      existingPanel.style.opacity = '0';
      setTimeout(() => existingPanel.remove(), 200);
    }
    if (currentlyExpandedItem) {
      currentlyExpandedItem.classList.remove('expanded');
      currentlyExpandedItem = null;
    }
  };
  
  // Show work item detail inline below the clicked item
  function showWorkItemDetailPanel(data, clickedElement) {
    // Collapse any existing expanded item
    collapseWorkItemDetail();
    
    // Mark this item as expanded
    clickedElement.classList.add('expanded');
    currentlyExpandedItem = clickedElement;
    
    // Create detail panel
    const panel = document.createElement('div');
    panel.className = 'work-item-detail-panel';
    panel.innerHTML = `
      <div class="detail-panel-content">
        <div class="detail-panel-header-inline">
          <div>
            <h5 class="mb-1">${data.title || 'Work Item'}</h5>
            <small class="text-muted">${data.subtitle || ''}</small>
          </div>
        </div>
        ${data.html_content || '<p class="text-muted">No content available</p>'}
      </div>
      <button class="floating-close-btn" onclick="collapseWorkItemDetail()" title="Collapse">
        <i data-lucide="x" style="width: 16px; height: 16px;"></i>
      </button>
    `;
    
    // Insert directly after the clicked item
    clickedElement.insertAdjacentElement('afterend', panel);
    
    // Animate open
    requestAnimationFrame(() => {
      panel.style.maxHeight = panel.scrollHeight + 'px';
      panel.style.opacity = '1';
    });
    
    // Re-init Lucide icons
    if (typeof lucide !== 'undefined') lucide.createIcons();
  }

  // Star button
  document.querySelectorAll('.star-btn').forEach(btn => {
    btn.addEventListener('click', function(e) {
      e.stopPropagation();
      const itemId = this.dataset.itemId;
      const icon = this.querySelector('i');
      const isStarred = icon.classList.contains('text-warning');
      
      // Toggle visual state
      icon.classList.toggle('text-warning');
      
      // Update via API
      fetch(`/api/work_items/${itemId}/toggle_star`, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]')?.content
        }
      }).catch(err => console.error('Star toggle failed:', err));
    });
  });

  // Archive button
  document.querySelectorAll('.archive-btn').forEach(btn => {
    btn.addEventListener('click', function(e) {
      e.stopPropagation();
      const itemId = this.dataset.itemId;
      const item = this.closest('.inbox-item');
      
      // Visual feedback
      item.style.opacity = '0.5';
      item.style.transform = 'translateX(20px)';
      item.style.transition = 'all 0.3s ease';
      
      // Archive via API
      fetch(`/api/work_items/${itemId}/archive`, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]')?.content
        }
      }).then(() => {
        setTimeout(() => item.remove(), 300);
      }).catch(err => {
        console.error('Archive failed:', err);
        item.style.opacity = '1';
        item.style.transform = 'translateX(0)';
      });
    });
  });

  // Feedback buttons
  document.querySelectorAll('.feedback-btn[data-action="feedback"]').forEach(btn => {
    btn.addEventListener('click', function(e) {
      e.stopPropagation();
      
      const rating = parseInt(this.dataset.rating);
      const feedbackableType = this.dataset.feedbackableType;
      const feedbackableId = this.dataset.feedbackableId;
      const container = this.closest('.feedback-mini');
      
      // Visual feedback
      this.classList.add(rating > 0 ? 'text-success' : 'text-danger');
      
      // Submit feedback
      fetch('/scout/feedback', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]')?.content
        },
        body: JSON.stringify({
          feedback: {
            feedbackable_type: feedbackableType,
            feedbackable_id: feedbackableId,
            rating: rating,
            metadata: {
              source: 'work_inbox',
              work_item_id: container.dataset.workItemId
            }
          }
        })
      })
      .then(res => res.json())
      .then(data => {
        if (data.success) {
          // Replace buttons with thank you
          container.innerHTML = `<span class="text-success small"><i data-lucide="check" style="width: 14px; height: 14px;"></i></span>`;
          if (typeof lucide !== 'undefined') lucide.createIcons();
        }
      })
      .catch(err => {
        console.error('Feedback failed:', err);
        this.classList.remove('text-success', 'text-danger');
      });
    });
  });

  // Initialize lucide icons
  if (typeof lucide !== 'undefined') lucide.createIcons();
})();
</script>

