<div class="dynamic-canvas">
  <%# Action buttons bar - title is shown in Scout template header %>
  <div class="dynamic-toolbar">
    <div class="dynamic-toolbar-spacer"></div>
    <div class="dynamic-toolbar-actions">
      <button class="btn btn-sm btn-primary" onclick="saveDynamicCanvas()" title="Save this dashboard">
        <i data-lucide="save" style="width: 16px; height: 16px;"></i>
        <span class="ms-1">Save</span>
      </button>
      <button class="btn btn-sm btn-outline-secondary" onclick="toggleDynamicFullscreen()" title="Toggle fullscreen">
        <i data-lucide="maximize-2" style="width: 16px; height: 16px;"></i>
      </button>
      <button class="btn btn-sm btn-outline-secondary" onclick="refreshDynamicCanvas()" title="Refresh">
        <i data-lucide="refresh-cw" style="width: 16px; height: 16px;"></i>
      </button>
    </div>
  </div>

  <%# Only show subtitle here if present %>
  <% if canvas_data['subtitle'].present? %>
    <div class="dynamic-canvas-subtitle mb-3">
      <small class="text-muted"><%= canvas_data['subtitle'] %></small>
    </div>
  <% end %>
  
  <!-- Dynamic Content Area -->
  <div id="dynamicCanvasContent">
    <% if canvas_data['html_content'].present? %>
      <%= raw canvas_data['html_content'] %>
    <% elsif canvas_data['content'].present? %>
      <% # Handle markdown/html content using existing helper %>
      <% content = canvas_data['content'] %>
      <% format = canvas_data['format'] || 'markdown' %>
      <% if format == 'markdown' %>
        <div class="markdown-content">
          <%= markdown(content) %>
        </div>
      <% elsif format == 'html' %>
        <%= sanitize_html(content) %>
      <% else %>
        <pre class="text-white"><%= content %></pre>
      <% end %>
    <% else %>
      <div class="text-center py-5">
        <i data-lucide="wand-2" class="icon-3x text-muted mb-3" aria-hidden="true"></i>
        <h6>Ask Amos to analyze your data</h6>
        <p class="text-muted">Amos can create custom visualizations, reports, and insights based on your questions.</p>
      </div>
    <% end %>
  </div>
</div>

<style>
  .dynamic-canvas {
    height: 100%;
    overflow-y: auto;
    overflow-x: auto; /* allow horizontal scroll when many columns */
    color: var(--text-primary) !important;
  }

  #dynamicCanvasContent {
    padding: 20px;
    color: var(--text-primary) !important;
  }

  /* Use theme-aware text color for all elements - use !important to override AI-generated inline styles */
  #dynamicCanvasContent * {
    color: var(--text-primary) !important;
  }

  #dynamicCanvasContent h1,
  #dynamicCanvasContent h2,
  #dynamicCanvasContent h3,
  #dynamicCanvasContent h4,
  #dynamicCanvasContent h5,
  #dynamicCanvasContent h6 {
    color: var(--text-primary) !important;
    font-weight: bold;
  }

  #dynamicCanvasContent table th,
  #dynamicCanvasContent table td {
    color: var(--text-primary) !important;
  }

  #dynamicCanvasContent p,
  #dynamicCanvasContent div,
  #dynamicCanvasContent span,
  #dynamicCanvasContent li {
    color: var(--text-primary) !important;
  }
  
  /* Ensure wide tables are scrollable and not cut off */
  .dynamic-canvas .table-responsive {
    overflow-x: auto;
  }
  .dynamic-canvas table.table {
    width: 100%;            /* fill container */
    table-layout: fixed;    /* enable responsive column shrinking */
  }
  .dynamic-canvas table.table th,
  .dynamic-canvas table.table td {
    overflow: hidden;
    text-overflow: ellipsis; /* truncate long text */
    white-space: nowrap;     /* keep single line for compact view */
    max-width: 320px;        /* reasonable per-column cap */
  }
  
  /* Default styles for AI-generated content */
  .ai-metric-card {
    background: var(--bg-secondary);
    border-radius: 8px;
    padding: 20px;
    margin-bottom: 20px;
    border: 1px solid var(--border-color);
  }

  .ai-metric-value {
    font-size: 2.5rem;
    font-weight: bold;
    color: var(--text-primary);
  }

  .ai-metric-label {
    color: var(--text-secondary) !important;
    font-size: 0.875rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  /* Use theme-aware text color on all metric elements */
  #dynamicCanvasContent .metric-card,
  #dynamicCanvasContent .metric-card * {
    color: var(--text-primary);
  }

  #dynamicCanvasContent .metric-label {
    color: var(--text-secondary);
  }

  #dynamicCanvasContent .metric-value {
    color: var(--text-primary);
  }
  
  .ai-chart-container {
    background: var(--bg-secondary);
    border-radius: 8px;
    padding: 20px;
    box-shadow: 0 0.125rem 0.25rem rgba(0,0,0,0.1);
    margin-bottom: 20px;
    border: 1px solid var(--border-color);
  }

  .ai-insight-box {
    background: rgba(124, 58, 237, 0.1);
    border-left: 4px solid var(--purple);
    padding: 15px;
    margin: 20px 0;
    border-radius: 4px;
    color: var(--text-primary);
  }

  .ai-recommendation {
    background: rgba(34, 197, 94, 0.1);
    border-left: 4px solid #22c55e;
    padding: 15px;
    margin: 20px 0;
    border-radius: 4px;
    color: var(--text-primary);
  }

  .ai-warning {
    background: rgba(234, 179, 8, 0.1);
    border-left: 4px solid #eab308;
    padding: 15px;
    margin: 20px 0;
    border-radius: 4px;
    color: var(--text-primary);
  }

  /* Markdown content styles */
  .markdown-content {
    line-height: 1.7;
  }

  .markdown-content h1 {
    font-size: 2rem;
    margin-top: 1.5rem;
    margin-bottom: 1rem;
    padding-bottom: 0.5rem;
    border-bottom: 2px solid var(--border-color);
  }

  .markdown-content h2 {
    font-size: 1.5rem;
    margin-top: 1.5rem;
    margin-bottom: 0.75rem;
    padding-bottom: 0.3rem;
    border-bottom: 1px solid var(--border-color);
  }

  .markdown-content h3 {
    font-size: 1.25rem;
    margin-top: 1.25rem;
    margin-bottom: 0.5rem;
  }

  .markdown-content h4 {
    font-size: 1.1rem;
    margin-top: 1rem;
    margin-bottom: 0.5rem;
  }

  .markdown-content p {
    margin-bottom: 1rem;
  }

  .markdown-content ul, .markdown-content ol {
    margin-bottom: 1rem;
    padding-left: 1.5rem;
  }

  .markdown-content li {
    margin-bottom: 0.5rem;
  }

  .markdown-content blockquote {
    border-left: 4px solid var(--border-color);
    padding-left: 1rem;
    margin: 1rem 0;
    font-style: italic;
    color: var(--text-secondary) !important;
  }

  .markdown-content code {
    background: var(--bg-tertiary);
    padding: 0.2rem 0.4rem;
    border-radius: 4px;
    font-family: 'Monaco', 'Menlo', monospace;
    font-size: 0.9em;
  }

  .markdown-content pre {
    background: var(--bg-tertiary);
    padding: 1rem;
    border-radius: 8px;
    overflow-x: auto;
    margin: 1rem 0;
  }

  .markdown-content pre code {
    background: transparent;
    padding: 0;
  }

  .markdown-content table {
    width: 100%;
    border-collapse: collapse;
    margin: 1rem 0;
  }

  .markdown-content th, .markdown-content td {
    border: 1px solid var(--border-color);
    padding: 0.75rem;
    text-align: left;
  }

  .markdown-content th {
    background: var(--bg-tertiary);
    font-weight: bold;
  }

  .markdown-content hr {
    border: none;
    border-top: 1px solid var(--border-color);
    margin: 2rem 0;
  }

  .markdown-content a {
    color: #6ea8fe !important;
    text-decoration: underline;
  }

  .markdown-content a:hover {
    color: #9ec5fe !important;
  }

  .markdown-content strong {
    font-weight: bold;
    color: var(--text-primary);
  }

  .markdown-content em {
    font-style: italic;
  }
  
  /* Toolbar styles */
  .dynamic-toolbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 8px 12px;
    background: var(--bg-secondary);
    border-bottom: 1px solid var(--border-color);
    flex-shrink: 0;
  }
  
  .dynamic-toolbar-spacer {
    flex: 1;
  }
  
  .dynamic-toolbar-actions {
    display: flex;
    gap: 8px;
    align-items: center;
  }
  
  .dynamic-toolbar-actions .btn {
    padding: 6px 12px;
    display: flex;
    align-items: center;
    gap: 4px;
  }
  
  .dynamic-toolbar-actions .btn-primary {
    background: linear-gradient(135deg, #7c3aed 0%, #5b21b6 100%);
    border: none;
    color: white;
  }
  
  .dynamic-toolbar-actions .btn-primary:hover {
    background: linear-gradient(135deg, #8b5cf6 0%, #6d28d9 100%);
  }
  
  /* Fullscreen mode */
  .dynamic-canvas.fullscreen {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 9999;
    background: var(--bg-primary);
  }
  
  /* Save toast notification */
  .dynamic-save-toast {
    position: fixed;
    bottom: 100px;
    left: 50%;
    transform: translateX(-50%) translateY(20px);
    background: var(--bg-secondary, #1a1a2e);
    color: var(--text-primary, #fff);
    padding: 12px 20px;
    border-radius: 8px;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.3);
    border: 1px solid var(--border-color, #374151);
    display: flex;
    align-items: center;
    gap: 10px;
    z-index: 10000;
    opacity: 0;
    transition: opacity 0.3s ease, transform 0.3s ease;
    max-width: 90%;
    font-size: 14px;
  }
  
  .dynamic-save-toast.show {
    opacity: 1;
    transform: translateX(-50%) translateY(0);
  }
  
  .dynamic-save-toast i {
    color: var(--purple, #7c3aed);
    flex-shrink: 0;
  }
</style>

<script>
// Fullscreen toggle for dynamic canvas
function toggleDynamicFullscreen() {
  const canvas = document.querySelector('.dynamic-canvas');
  if (canvas) {
    if (canvas.classList.contains('fullscreen')) {
      canvas.classList.remove('fullscreen');
    } else {
      canvas.classList.add('fullscreen');
    }
  }
}

// Refresh dynamic canvas - reloads the current canvas
function refreshDynamicCanvas() {
  // Trigger a canvas refresh via turbo or page reload
  if (window.Turbo && window.Turbo.visit) {
    window.Turbo.visit(window.location.href, { action: 'replace' });
  } else {
    window.location.reload();
  }
}

// Save dynamic canvas - calls API directly to save with canvas content
function saveDynamicCanvas() {
  console.log('💾 Save button clicked');
  
  const titleEl = document.querySelector('.canvas-title, .dynamic-canvas h2, .dashboard-header h2');
  const title = titleEl ? titleEl.textContent.trim() : 'Custom Dashboard';
  console.log('💾 Dashboard title:', title);
  
  // Get the actual canvas HTML content
  const canvasContent = document.getElementById('dynamicCanvasContent');
  const htmlContent = canvasContent ? canvasContent.innerHTML : '';
  
  if (!htmlContent) {
    showDynamicSaveToast('No content to save');
    return;
  }
  
  // Save directly via API with the actual content
  fetch('/scout/save_visualization', {
    method: 'POST',
    headers: {
      'Content-Type': 'application/json',
      'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]')?.content
    },
    body: JSON.stringify({
      title: title,
      content_type: 'visualization',
      content: {
        html_content: htmlContent,
        artifact_type: 'visualization',
        canvas_type: 'dynamic_canvas'
      },
      description: 'Saved dashboard visualization'
    })
  })
  .then(response => response.json())
  .then(data => {
    if (data.success) {
      showDynamicSaveToast('✅ Dashboard saved! Find it in your bookmarks.');
      // Also add a message to chat
      const addMessageFn = window.addMessage || window.scoutAddMessage;
      if (addMessageFn) {
        addMessageFn(`💾 Saved "${title}" to your bookmarks.`, 'assistant');
      }
    } else {
      showDynamicSaveToast('Failed to save: ' + (data.error || 'Unknown error'));
    }
  })
  .catch(error => {
    console.error('Save failed:', error);
    showDynamicSaveToast('Failed to save dashboard');
  });
}

function showDynamicSaveToast(message) {
  // Remove any existing toasts
  document.querySelectorAll('.dynamic-save-toast').forEach(t => t.remove());
  
  // Create a toast notification
  const toast = document.createElement('div');
  toast.className = 'dynamic-save-toast';
  toast.innerHTML = `
    <i data-lucide="info" style="width: 18px; height: 18px;"></i>
    <span>${message}</span>
  `;
  document.body.appendChild(toast);
  
  // Initialize the icon
  if (window.lucide) {
    window.lucide.createIcons({ nodes: [toast] });
  }
  
  // Animate in
  requestAnimationFrame(() => {
    toast.classList.add('show');
  });
  
  // Remove after 5 seconds
  setTimeout(() => {
    toast.classList.remove('show');
    setTimeout(() => toast.remove(), 300);
  }, 5000);
}

// Initialize Lucide icons for the toolbar
document.addEventListener('turbo:load', function() {
  if (window.lucide) {
    window.lucide.createIcons();
  }
});

// Also run on DOMContentLoaded for non-turbo loads
if (document.readyState === 'loading') {
  document.addEventListener('DOMContentLoaded', function() {
    if (window.lucide) {
      window.lucide.createIcons();
    }
  });
} else {
  if (window.lucide) {
    window.lucide.createIcons();
  }
}
</script>
