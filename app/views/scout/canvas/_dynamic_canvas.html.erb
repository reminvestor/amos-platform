<div class="dynamic-canvas">
  <% if canvas_data['title'].present? %>
    <div class="card shadow-sm mb-3">
      <div class="card-header bg-white">
        <h5 class="mb-0">
          <i data-lucide="trending-up" class="text-primary me-2" aria-hidden="true"></i>
          <%= canvas_data['title'] %>
        </h5>
        <% if canvas_data['subtitle'].present? %>
          <small class="text-muted"><%= canvas_data['subtitle'] %></small>
        <% end %>
      </div>
    </div>
  <% end %>
  
  <!-- Dynamic Content Area -->
  <div id="dynamicCanvasContent">
    <% if canvas_data['html_content'].present? %>
      <%= raw canvas_data['html_content'] %>
    <% else %>
      <div class="text-center py-5">
        <i data-lucide="wand-2" class="icon-3x text-muted mb-3" aria-hidden="true"></i>
        <h6>Ask Scout to analyze your data</h6>
        <p class="text-muted">Scout can create custom visualizations, reports, and insights based on your questions.</p>
      </div>
    <% end %>
  </div>
</div>

<style>
  .dynamic-canvas {
    height: 100%;
    overflow-y: auto;
    overflow-x: auto; /* allow horizontal scroll when many columns */
    color: #FFFFFF !important;
  }

  #dynamicCanvasContent {
    padding: 20px;
    color: #FFFFFF !important;
  }

  /* Force white text for all elements on dark background */
  #dynamicCanvasContent * {
    color: #FFFFFF !important;
  }

  #dynamicCanvasContent h1,
  #dynamicCanvasContent h2,
  #dynamicCanvasContent h3,
  #dynamicCanvasContent h4,
  #dynamicCanvasContent h5,
  #dynamicCanvasContent h6 {
    color: #FFFFFF !important;
    font-weight: bold !important;
  }

  #dynamicCanvasContent table th,
  #dynamicCanvasContent table td {
    color: #FFFFFF !important;
  }

  #dynamicCanvasContent p,
  #dynamicCanvasContent div,
  #dynamicCanvasContent span,
  #dynamicCanvasContent li {
    color: #FFFFFF !important;
  }
  
  /* Ensure wide tables are scrollable and not cut off */
  .dynamic-canvas .table-responsive {
    overflow-x: auto;
  }
  .dynamic-canvas table.table {
    width: 100%;            /* fill container */
    table-layout: fixed;    /* enable responsive column shrinking */
  }
  .dynamic-canvas table.table th,
  .dynamic-canvas table.table td {
    overflow: hidden;
    text-overflow: ellipsis; /* truncate long text */
    white-space: nowrap;     /* keep single line for compact view */
    max-width: 320px;        /* reasonable per-column cap */
  }
  
  /* Default styles for AI-generated content */
  .ai-metric-card {
    background: rgba(255, 255, 255, 0.1);
    border-radius: 8px;
    padding: 20px;
    margin-bottom: 20px;
    border: 1px solid rgba(255, 255, 255, 0.2);
  }

  .ai-metric-value {
    font-size: 2.5rem;
    font-weight: bold;
    color: #FFFFFF !important;
  }

  .ai-metric-label {
    color: rgba(255, 255, 255, 0.8) !important;
    font-size: 0.875rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  /* Force white text on all metric elements */
  #dynamicCanvasContent .metric-card,
  #dynamicCanvasContent .metric-card * {
    color: #FFFFFF !important;
  }

  #dynamicCanvasContent .metric-label {
    color: rgba(255, 255, 255, 0.8) !important;
  }

  #dynamicCanvasContent .metric-value {
    color: #FFFFFF !important;
  }
  
  .ai-chart-container {
    background: rgba(255, 255, 255, 0.1);
    border-radius: 8px;
    padding: 20px;
    box-shadow: 0 0.125rem 0.25rem rgba(0,0,0,0.3);
    margin-bottom: 20px;
  }

  .ai-insight-box {
    background: rgba(13, 110, 253, 0.2);
    border-left: 4px solid #0d6efd;
    padding: 15px;
    margin: 20px 0;
    border-radius: 4px;
    color: #FFFFFF !important;
  }

  .ai-recommendation {
    background: rgba(40, 167, 69, 0.2);
    border-left: 4px solid #28a745;
    padding: 15px;
    margin: 20px 0;
    border-radius: 4px;
    color: #FFFFFF !important;
  }

  .ai-warning {
    background: rgba(255, 193, 7, 0.2);
    border-left: 4px solid #ffc107;
    padding: 15px;
    margin: 20px 0;
    border-radius: 4px;
    color: #FFFFFF !important;
  }
</style>
