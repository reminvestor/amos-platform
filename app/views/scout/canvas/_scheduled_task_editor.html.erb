<script>
(function() {
  console.log('📝 Initializing Scheduled Task Editor canvas');
  
  // Helper to navigate back to tasks list
  window.loadScheduledTasksCanvas = function() {
    if (typeof window.scoutLoadCanvas === 'function') {
      window.scoutLoadCanvas('scheduled_tasks', {}, true);
    } else {
      // Fallback - shouldn't happen but just in case
      window.scoutSendMessage('Show my scheduled tasks');
    }
  };
  
  const form = document.getElementById('task-editor-form');
  const scheduleType = document.getElementById('schedule-type');
  const timeField = document.getElementById('time-field-container');
  const dayField = document.getElementById('day-field-container');
  const daySelect = document.getElementById('day-select');
  const modeCards = document.querySelectorAll('.mode-card');
  const agentSelection = document.getElementById('agent-selection');
  const toolSelection = document.getElementById('tool-selection');
  const fallbackOption = document.getElementById('fallback-option');
  
  // Schedule type change handler
  function updateScheduleFields() {
    const type = scheduleType.value;
    
    // Show/hide time field
    if (['daily', 'weekly', 'monthly'].includes(type)) {
      timeField.style.display = 'block';
    } else {
      timeField.style.display = 'none';
    }
    
    // Show/hide and populate day field
    if (['weekly', 'monthly'].includes(type)) {
      dayField.style.display = 'block';
      
      // Populate options based on type
      daySelect.innerHTML = '<option value="">Select...</option>';
      
      if (type === 'weekly') {
        const days = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'];
        days.forEach((day, i) => {
          daySelect.innerHTML += `<option value="${i}">${day}</option>`;
        });
      } else if (type === 'monthly') {
        for (let i = 1; i <= 31; i++) {
          const suffix = i === 1 ? 'st' : i === 2 ? 'nd' : i === 3 ? 'rd' : 'th';
          daySelect.innerHTML += `<option value="${i}">${i}${suffix}</option>`;
        }
      }
    } else {
      dayField.style.display = 'none';
    }
  }
  
  if (scheduleType) {
    scheduleType.addEventListener('change', updateScheduleFields);
    // Set initial day value if editing
    const currentDay = '<%= task.run_on_day %>';
    if (currentDay) {
      setTimeout(() => {
        updateScheduleFields();
        daySelect.value = currentDay;
      }, 100);
    }
  }
  
  // Execution mode selection
  modeCards.forEach(card => {
    card.addEventListener('click', function() {
      modeCards.forEach(c => c.classList.remove('selected'));
      this.classList.add('selected');
      this.querySelector('.mode-radio').checked = true;
      
      const mode = this.dataset.mode;
      agentSelection.style.display = mode === 'agent_only' ? 'block' : 'none';
      toolSelection.style.display = mode === 'tool_only' ? 'block' : 'none';
      fallbackOption.style.display = ['agent_only', 'tool_only'].includes(mode) ? 'block' : 'none';
    });
  });
  
  // Tool management
  window.addSelectedTool = function() {
    const select = document.getElementById('tool-select');
    const tool = select.value;
    if (!tool) return;
    
    const container = document.getElementById('selected-tools');
    const input = document.getElementById('required-tools-input');
    const currentTools = input.value ? input.value.split(',') : [];
    
    if (!currentTools.includes(tool)) {
      currentTools.push(tool);
      input.value = currentTools.join(',');
      
      const chip = document.createElement('span');
      chip.className = 'tool-chip';
      chip.dataset.tool = tool;
      chip.innerHTML = `${tool}<button type="button" class="chip-remove" onclick="removeTool('${tool}')">&times;</button>`;
      container.appendChild(chip);
    }
    
    select.value = '';
  };
  
  window.removeTool = function(tool) {
    const input = document.getElementById('required-tools-input');
    const currentTools = input.value.split(',').filter(t => t !== tool);
    input.value = currentTools.join(',');
    
    const chip = document.querySelector(`.tool-chip[data-tool="${tool}"]`);
    if (chip) chip.remove();
  };
  
  // Form submission - save directly via API
  if (form) {
    form.addEventListener('submit', async function(e) {
      e.preventDefault();
      
      const formData = new FormData(form);
      const taskId = formData.get('task_id');
      const isNew = !taskId || taskId === '';
      
      // Build JSON payload
      const payload = {
        name: formData.get('name'),
        description: formData.get('description'),
        task_type: formData.get('task_type'),
        prompt: formData.get('prompt'),
        schedule_type: formData.get('schedule_type'),
        run_at_time: formData.get('run_at_time'),
        run_on_day: formData.get('run_on_day'),
        timezone: formData.get('timezone'),
        enabled: formData.get('enabled') === 'on',
        output_method: formData.get('output_method'),
        max_runs: formData.get('max_runs'),
        execution_mode: formData.get('execution_mode'),
        required_agent_slug: formData.get('required_agent_slug'),
        required_tools: formData.get('required_tools'),
        allow_fallback: formData.get('allow_fallback') === 'on'
      };
      
      const submitBtn = form.querySelector('button[type="submit"]');
      const originalText = submitBtn.innerHTML;
      submitBtn.disabled = true;
      submitBtn.innerHTML = '<i data-lucide="loader" class="spin" style="width: 14px; height: 14px;"></i> Saving...';
      
      try {
        const csrfToken = document.querySelector('meta[name="csrf-token"]')?.content;
        const url = isNew ? '/scheduled_tasks/api_create' : `/scheduled_tasks/${taskId}/api_update`;
        
        const response = await fetch(url, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'Accept': 'application/json',
            'X-CSRF-Token': csrfToken
          },
          body: JSON.stringify(payload)
        });
        
        const data = await response.json();
        
        if (data.success) {
          // Show success message
          showToast('success', data.message || 'Task saved successfully');
          
          // Navigate back to tasks list
          setTimeout(() => {
            loadScheduledTasksCanvas();
          }, 500);
        } else {
          showToast('error', data.errors?.join(', ') || 'Failed to save task');
          submitBtn.disabled = false;
          submitBtn.innerHTML = originalText;
        }
      } catch (err) {
        console.error('Save error:', err);
        showToast('error', 'Failed to save task. Please try again.');
        submitBtn.disabled = false;
        submitBtn.innerHTML = originalText;
      }
      
      if (typeof lucide !== 'undefined') lucide.createIcons();
    });
  }
  
  // Simple toast notification
  function showToast(type, message) {
    const toast = document.createElement('div');
    toast.className = `toast-notification toast-${type}`;
    toast.innerHTML = `
      <i data-lucide="${type === 'success' ? 'check-circle' : 'alert-circle'}" style="width: 18px; height: 18px;"></i>
      <span>${message}</span>
    `;
    toast.style.cssText = `
      position: fixed;
      top: 20px;
      right: 20px;
      padding: 12px 20px;
      background: ${type === 'success' ? '#10B981' : '#EF4444'};
      color: white;
      border-radius: 8px;
      display: flex;
      align-items: center;
      gap: 10px;
      z-index: 10000;
      animation: slideIn 0.3s ease;
    `;
    document.body.appendChild(toast);
    if (typeof lucide !== 'undefined') lucide.createIcons();
    
    setTimeout(() => {
      toast.style.animation = 'slideOut 0.3s ease';
      setTimeout(() => toast.remove(), 300);
    }, 3000);
  }
  
  // Delete task via API
  window.deleteTask = async function(taskId) {
    if (!await showConfirm('Are you sure you want to delete this scheduled task? This cannot be undone.', { title: 'Delete Task', dangerous: true })) {
      return;
    }
    
    try {
      const csrfToken = document.querySelector('meta[name="csrf-token"]')?.content;
      const response = await fetch(`/scheduled_tasks/${taskId}/api_destroy`, {
        method: 'DELETE',
        headers: {
          'Accept': 'application/json',
          'X-CSRF-Token': csrfToken
        }
      });
      
      const data = await response.json();
      
      if (data.success) {
        showToast('success', data.message || 'Task deleted');
        loadScheduledTasksCanvas();
      } else {
        showToast('error', 'Failed to delete task');
      }
    } catch (err) {
      console.error('Delete error:', err);
      showToast('error', 'Failed to delete task');
    }
  };
  
  // Agent search functionality
  const agentSearchInput = document.getElementById('agent-search-input');
  const agentSelect = document.getElementById('agent-select');
  const agentPreview = document.getElementById('selected-agent-preview');
  
  if (agentSearchInput && agentSelect) {
    // Store all options for filtering
    const allOptions = [];
    const optgroups = agentSelect.querySelectorAll('optgroup');
    
    optgroups.forEach(group => {
      const groupOptions = [];
      group.querySelectorAll('option').forEach(opt => {
        groupOptions.push({
          value: opt.value,
          text: opt.textContent,
          description: opt.dataset.description || '',
          role: opt.dataset.role || '',
          selected: opt.selected
        });
      });
      allOptions.push({
        label: group.label,
        options: groupOptions
      });
    });
    
    // Also capture the placeholder
    const placeholder = agentSelect.querySelector('option[value=""]');
    
    // Search handler
    agentSearchInput.addEventListener('input', function() {
      const query = this.value.toLowerCase().trim();
      
      // Clear and rebuild select
      agentSelect.innerHTML = '';
      
      // Always add placeholder
      if (placeholder) {
        agentSelect.appendChild(placeholder.cloneNode(true));
      }
      
      if (query === '') {
        // No search - show all grouped
        allOptions.forEach(group => {
          if (group.options.length > 0) {
            const optgroup = document.createElement('optgroup');
            optgroup.label = group.label;
            group.options.forEach(opt => {
              const option = document.createElement('option');
              option.value = opt.value;
              option.textContent = opt.text;
              option.dataset.description = opt.description;
              option.dataset.role = opt.role;
              if (opt.selected) option.selected = true;
              optgroup.appendChild(option);
            });
            agentSelect.appendChild(optgroup);
          }
        });
      } else {
        // Search - show flat filtered results
        const matches = [];
        allOptions.forEach(group => {
          group.options.forEach(opt => {
            const searchText = (opt.text + ' ' + opt.description + ' ' + opt.role).toLowerCase();
            if (searchText.includes(query)) {
              matches.push(opt);
            }
          });
        });
        
        if (matches.length > 0) {
          const optgroup = document.createElement('optgroup');
          optgroup.label = `🔍 Search Results (${matches.length})`;
          matches.forEach(opt => {
            const option = document.createElement('option');
            option.value = opt.value;
            option.textContent = opt.text;
            option.dataset.description = opt.description;
            if (opt.selected) option.selected = true;
            optgroup.appendChild(option);
          });
          agentSelect.appendChild(optgroup);
        } else {
          const noResults = document.createElement('option');
          noResults.value = '';
          noResults.textContent = 'No agents found matching your search';
          noResults.disabled = true;
          agentSelect.appendChild(noResults);
        }
      }
    });
    
    // Show preview on selection
    agentSelect.addEventListener('change', function() {
      const selected = this.options[this.selectedIndex];
      if (selected && selected.value) {
        const name = selected.textContent.split(' - ')[0].trim();
        const desc = selected.dataset.description || selected.textContent.split(' - ')[1] || '';
        
        if (agentPreview) {
          agentPreview.querySelector('.agent-preview-name').textContent = name;
          agentPreview.querySelector('.agent-preview-desc').textContent = desc;
          agentPreview.style.display = 'block';
        }
      } else {
        if (agentPreview) agentPreview.style.display = 'none';
      }
    });
    
    // Trigger change to show initial preview if agent is selected
    if (agentSelect.value) {
      agentSelect.dispatchEvent(new Event('change'));
    }
  }
  
  // Initialize icons
  if (typeof lucide !== 'undefined') lucide.createIcons();
})();
</script>

