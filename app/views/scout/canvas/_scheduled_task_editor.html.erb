  padding: 20px;
  max-height: 100%;
  overflow-y: auto;
}

.editor-section {
  background: rgba(255, 255, 255, 0.03);
  border: 1px solid rgba(255, 255, 255, 0.1);
  border-radius: 12px;
  overflow: hidden;
