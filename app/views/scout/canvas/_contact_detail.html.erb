<%# Contact Detail Canvas - Shows contact info, CRM data, timeline, and quick actions %>
<div class="scout-canvas canvas-container contact-detail">
  <!-- Page Header -->
  <div class="canvas-header-row">
    <div class="canvas-header-left">
      <button onclick="contactDetailBack()" class="canvas-btn secondary sm" style="margin-right: 1rem;">
        <i data-lucide="arrow-left"></i>
        Back
      </button>
      <div class="contact-header-info">
        <div class="contact-avatar-large">
          <%= contact.first_name&.first&.upcase || contact.email&.first&.upcase || 'C' %>
        </div>
        <div>
          <h1 class="canvas-page-title" style="margin-bottom: 0;">
            <%= contact.full_name.presence || 'No Name' %>
          </h1>
          <p class="canvas-page-subtitle"><%= contact.email %></p>
        </div>
      </div>
    </div>
    <div class="canvas-header-actions">
      <button onclick="contactDetailLogCall('<%= contact.id %>')" class="canvas-btn secondary">
        <i data-lucide="phone"></i>
        Log Call
      </button>
      <button onclick="contactDetailSendEmail('<%= contact.id %>')" class="canvas-btn secondary">
        <i data-lucide="mail"></i>
        Send Email
      </button>
      <button onclick="contactDetailCreateTask('<%= contact.id %>')" class="canvas-btn secondary">
        <i data-lucide="check-square"></i>
        Create Task
      </button>
      <button onclick="contactDetailCreateOpportunity('<%= contact.id %>')" class="canvas-btn primary">
        <i data-lucide="target"></i>
        Create Opportunity
      </button>
    </div>
  </div>

  <div class="contact-detail-grid">
    <!-- Left Column - Contact Info & CRM Data -->
    <div class="contact-detail-sidebar">
      <!-- Contact Info Card -->
      <div class="canvas-card">
        <div class="canvas-card-header">
          <h6><i data-lucide="user"></i> Contact Information</h6>
          <button onclick="contactDetailEdit('<%= contact.id %>')" class="canvas-btn outline-purple sm">
            <i data-lucide="pencil"></i>
          </button>
        </div>
        <div class="canvas-card-body">
          <div class="contact-info-row">
            <span class="contact-info-label">Email</span>
            <a href="mailto:<%= contact.email %>" class="canvas-link"><%= contact.email %></a>
          </div>
          <% if contact.metadata&.dig('phone').present? %>
            <div class="contact-info-row">
              <span class="contact-info-label">Phone</span>
              <span><%= contact.metadata['phone'] %></span>
            </div>
          <% end %>
          <% if contact.metadata&.dig('company').present? %>
            <div class="contact-info-row">
              <span class="contact-info-label">Company</span>
              <span><%= contact.metadata['company'] %></span>
            </div>
          <% end %>
          <div class="contact-info-row">
            <span class="contact-info-label">Source</span>
            <span><%= contact.lead_source || contact.metadata&.dig('source') || 'Unknown' %></span>
          </div>
          <div class="contact-info-row">
            <span class="contact-info-label">Added</span>
            <span><%= contact.created_at.strftime('%b %d, %Y') %></span>
          </div>
          <% if contact.tags.present? %>
            <div class="contact-info-row">
              <span class="contact-info-label">Tags</span>
              <div class="contact-tags">
                <% contact.tags.split(',').map(&:strip).each do |tag| %>
                  <span class="canvas-badge purple"><%= tag %></span>
                <% end %>
              </div>
            </div>
          <% end %>
        </div>
      </div>

      <!-- CRM Status Card -->
      <div class="canvas-card">
        <div class="canvas-card-header">
          <h6><i data-lucide="trending-up"></i> CRM Status</h6>
        </div>
        <div class="canvas-card-body">
          <div class="contact-info-row">
            <span class="contact-info-label">Lifecycle Stage</span>
            <span class="lifecycle-badge <%= contact.lifecycle_stage %>">
              <%= Contact::LIFECYCLE_STAGES[contact.lifecycle_stage]&.dig(:label) || contact.lifecycle_stage&.titleize || 'Subscriber' %>
            </span>
          </div>
          <div class="contact-info-row">
            <span class="contact-info-label">Lead Score</span>
            <div class="lead-score-display">
              <div class="lead-score-bar">
                <div class="lead-score-fill" style="width: <%= [contact.lead_score || 0, 100].min %>%;"></div>
              </div>
              <span class="lead-score-value"><%= contact.lead_score || 0 %></span>
            </div>
          </div>
          <% if contact.assigned_user.present? %>
            <div class="contact-info-row">
              <span class="contact-info-label">Assigned To</span>
              <span><%= contact.assigned_user.name %></span>
            </div>
          <% elsif contact.assigned_agent.present? %>
            <div class="contact-info-row">
              <span class="contact-info-label">Assigned Agent</span>
              <span class="canvas-badge cyan"><i data-lucide="bot" style="width: 12px; height: 12px;"></i> <%= contact.assigned_agent.name %></span>
            </div>
          <% end %>
          <% if contact.last_activity_at.present? %>
            <div class="contact-info-row">
              <span class="contact-info-label">Last Activity</span>
              <span><%= time_ago_in_words(contact.last_activity_at) %> ago</span>
            </div>
          <% end %>
          <% if contact.next_follow_up_at.present? %>
            <div class="contact-info-row">
              <span class="contact-info-label">Next Follow-up</span>
              <span class="<%= contact.next_follow_up_at < Time.current ? 'text-danger' : '' %>">
                <%= contact.next_follow_up_at.strftime('%b %d, %Y at %l:%M %p') %>
              </span>
            </div>
          <% end %>
        </div>
        <div class="canvas-card-footer">
          <button onclick="contactDetailPromoteLifecycle('<%= contact.id %>')" class="canvas-btn outline-green sm">
            <i data-lucide="arrow-up-right"></i>
            Promote Stage
          </button>
          <button onclick="contactDetailAssign('<%= contact.id %>')" class="canvas-btn outline-purple sm">
            <i data-lucide="user-plus"></i>
            Assign
          </button>
        </div>
      </div>

      <!-- Opportunities Card -->
      <div class="canvas-card">
        <div class="canvas-card-header">
          <h6><i data-lucide="target"></i> Opportunities (<%= opportunities.count %>)</h6>
          <button onclick="contactDetailCreateOpportunity('<%= contact.id %>')" class="canvas-btn outline-cyan sm">
            <i data-lucide="plus"></i>
          </button>
        </div>
        <div class="canvas-card-body">
          <% if opportunities.any? %>
            <% opportunities.each do |opp| %>
              <div class="opportunity-mini-card" onclick="contactDetailViewOpportunity('<%= opp.id %>')">
                <div class="opportunity-mini-header">
                  <span class="opportunity-mini-name"><%= truncate(opp.name, length: 25) %></span>
                  <span class="opportunity-mini-value"><%= number_to_currency(opp.value, precision: 0) if opp.value %></span>
                </div>
                <div class="opportunity-mini-footer">
                  <span class="stage-badge <%= opp.stage %>"><%= opp.stage_label %></span>
                  <span class="opportunity-mini-date"><%= opp.expected_close_date&.strftime('%b %d') %></span>
                </div>
              </div>
            <% end %>
          <% else %>
            <p class="text-muted text-center py-3">No opportunities yet</p>
          <% end %>
        </div>
      </div>
    </div>

    <!-- Right Column - Activity Timeline -->
    <div class="contact-detail-main">
      <!-- Quick Actions -->
      <div class="timeline-quick-actions">
        <button onclick="contactDetailLogNote('<%= contact.id %>')" class="quick-action-btn">
          <i data-lucide="file-text"></i>
          Note
        </button>
        <button onclick="contactDetailLogCall('<%= contact.id %>')" class="quick-action-btn">
          <i data-lucide="phone"></i>
          Call
        </button>
        <button onclick="contactDetailLogEmail('<%= contact.id %>')" class="quick-action-btn">
          <i data-lucide="mail"></i>
          Email
        </button>
        <button onclick="contactDetailCreateTask('<%= contact.id %>')" class="quick-action-btn">
          <i data-lucide="check-square"></i>
          Task
        </button>
        <button onclick="contactDetailScheduleMeeting('<%= contact.id %>')" class="quick-action-btn">
          <i data-lucide="calendar"></i>
          Meeting
        </button>
      </div>

      <!-- Timeline -->
      <div class="canvas-card">
        <div class="canvas-card-header">
          <h6><i data-lucide="activity"></i> Activity Timeline</h6>
          <div class="timeline-filters">
            <select id="activityTypeFilter" class="canvas-select sm" onchange="filterTimeline()">
              <option value="">All Activities</option>
              <option value="note">Notes</option>
              <option value="call">Calls</option>
              <option value="email">Emails</option>
              <option value="task">Tasks</option>
              <option value="meeting">Meetings</option>
            </select>
          </div>
        </div>
        <div class="canvas-card-body timeline-container">
          <% if activities.any? %>
            <div class="activity-timeline">
              <% activities.each do |activity| %>
                <div class="timeline-item <%= activity.activity_type %>" data-type="<%= activity.activity_type %>">
                  <div class="timeline-icon <%= activity.activity_type %>">
                    <% case activity.activity_type %>
                    <% when 'note' %>
                      <i data-lucide="file-text"></i>
                    <% when 'call' %>
                      <i data-lucide="phone"></i>
                    <% when 'email' %>
                      <i data-lucide="mail"></i>
                    <% when 'task' %>
                      <i data-lucide="check-square"></i>
                    <% when 'meeting' %>
                      <i data-lucide="calendar"></i>
                    <% else %>
                      <i data-lucide="activity"></i>
                    <% end %>
                  </div>
                  <div class="timeline-content">
                    <div class="timeline-header">
                      <span class="timeline-title"><%= activity.subject || activity.activity_type.titleize %></span>
                      <span class="timeline-time"><%= time_ago_in_words(activity.created_at) %> ago</span>
                    </div>
                    <% if activity.description.present? %>
                      <p class="timeline-description"><%= truncate(activity.description, length: 200) %></p>
                    <% end %>
                    <div class="timeline-meta">
                      <% if activity.outcome.present? %>
                        <span class="timeline-outcome"><%= activity.outcome %></span>
                      <% end %>
                      <% if activity.performed_by_agent.present? %>
                        <span class="timeline-performer">
                          <i data-lucide="bot" style="width: 12px; height: 12px;"></i>
                          <%= activity.performed_by_agent.name %>
                        </span>
                      <% elsif activity.user.present? %>
                        <span class="timeline-performer">
                          <i data-lucide="user" style="width: 12px; height: 12px;"></i>
                          <%= activity.user.name %>
                        </span>
                      <% end %>
                      <% if activity.status == 'pending' && activity.due_at.present? %>
                        <span class="timeline-due <%= activity.due_at < Time.current ? 'overdue' : '' %>">
                          Due: <%= activity.due_at.strftime('%b %d') %>
                        </span>
                      <% end %>
                    </div>
                    <% if activity.status == 'pending' && activity.activity_type == 'task' %>
                      <div class="timeline-actions">
                        <button onclick="contactDetailCompleteTask('<%= activity.id %>')" class="canvas-btn outline-green sm">
                          <i data-lucide="check"></i>
                          Complete
                        </button>
                      </div>
                    <% end %>
                  </div>
                </div>
              <% end %>
            </div>
          <% else %>
            <div class="timeline-empty">
              <i data-lucide="inbox"></i>
              <p>No activities yet</p>
              <p class="text-muted">Log your first interaction with this contact</p>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
/* Contact Detail Styles */
.contact-detail-grid {
  display: grid;
  grid-template-columns: 350px 1fr;
  gap: 1.5rem;
  margin-top: 1.5rem;
}

.contact-header-info {
  display: flex;
  align-items: center;
  gap: 1rem;
}

.contact-avatar-large {
  width: 60px;
  height: 60px;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--purple), var(--cyan));
  color: white;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 1.5rem;
  font-weight: 600;
}

.contact-info-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  padding: 0.75rem 0;
  border-bottom: 1px solid var(--border-color);
}

.contact-info-row:last-child {
  border-bottom: none;
}

.contact-info-label {
  color: var(--text-muted);
  font-size: 0.875rem;
}

.contact-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 0.25rem;
  justify-content: flex-end;
}

/* Lifecycle Badge */
.lifecycle-badge {
  padding: 0.25rem 0.75rem;
  border-radius: 1rem;
  font-size: 0.75rem;
  font-weight: 500;
}

.lifecycle-badge.subscriber { background: var(--bg-muted); color: var(--text-muted); }
.lifecycle-badge.lead { background: rgba(59, 130, 246, 0.1); color: #3b82f6; }
.lifecycle-badge.mql { background: rgba(168, 85, 247, 0.1); color: #a855f7; }
.lifecycle-badge.sql { background: rgba(236, 72, 153, 0.1); color: #ec4899; }
.lifecycle-badge.opportunity { background: rgba(245, 158, 11, 0.1); color: #f59e0b; }
.lifecycle-badge.customer { background: rgba(34, 197, 94, 0.1); color: #22c55e; }
.lifecycle-badge.evangelist { background: rgba(6, 182, 212, 0.1); color: #06b6d4; }

/* Lead Score */
.lead-score-display {
  display: flex;
  align-items: center;
  gap: 0.5rem;
}

.lead-score-bar {
  flex: 1;
  height: 8px;
  background: var(--bg-muted);
  border-radius: 4px;
  overflow: hidden;
}

.lead-score-fill {
  height: 100%;
  background: linear-gradient(90deg, #22c55e, #f59e0b, #ef4444);
  transition: width 0.3s ease;
}

.lead-score-value {
  font-weight: 600;
  min-width: 30px;
  text-align: right;
}

/* Opportunity Mini Cards */
.opportunity-mini-card {
  background: var(--bg-muted);
  border-radius: 0.5rem;
  padding: 0.75rem;
  margin-bottom: 0.5rem;
  cursor: pointer;
  transition: background 0.2s;
}

.opportunity-mini-card:hover {
  background: var(--bg-hover);
}

.opportunity-mini-header {
  display: flex;
  justify-content: space-between;
  margin-bottom: 0.5rem;
}

.opportunity-mini-name {
  font-weight: 500;
}

.opportunity-mini-value {
  color: var(--green);
  font-weight: 600;
}

.opportunity-mini-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.stage-badge {
  font-size: 0.7rem;
  padding: 0.125rem 0.5rem;
  border-radius: 1rem;
}

.stage-badge.lead { background: rgba(107, 114, 128, 0.1); color: #6b7280; }
.stage-badge.qualified { background: rgba(59, 130, 246, 0.1); color: #3b82f6; }
.stage-badge.proposal { background: rgba(168, 85, 247, 0.1); color: #a855f7; }
.stage-badge.negotiation { background: rgba(245, 158, 11, 0.1); color: #f59e0b; }
.stage-badge.closed_won { background: rgba(34, 197, 94, 0.1); color: #22c55e; }
.stage-badge.closed_lost { background: rgba(239, 68, 68, 0.1); color: #ef4444; }

.opportunity-mini-date {
  font-size: 0.75rem;
  color: var(--text-muted);
}

/* Quick Actions */
.timeline-quick-actions {
  display: flex;
  gap: 0.5rem;
  margin-bottom: 1rem;
}

.quick-action-btn {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 0.25rem;
  padding: 0.75rem;
  background: var(--bg-card);
  border: 1px solid var(--border-color);
  border-radius: 0.5rem;
  color: var(--text-secondary);
  cursor: pointer;
  transition: all 0.2s;
  font-size: 0.75rem;
}

.quick-action-btn:hover {
  background: var(--bg-hover);
  border-color: var(--purple);
  color: var(--purple);
}

.quick-action-btn i {
  width: 20px;
  height: 20px;
}

/* Timeline */
.timeline-container {
  max-height: 600px;
  overflow-y: auto;
}

.activity-timeline {
  position: relative;
  padding-left: 2rem;
}

.activity-timeline::before {
  content: '';
  position: absolute;
  left: 0.75rem;
  top: 0;
  bottom: 0;
  width: 2px;
  background: var(--border-color);
}

.timeline-item {
  position: relative;
  padding-bottom: 1.5rem;
}

.timeline-icon {
  position: absolute;
  left: -2rem;
  width: 1.5rem;
  height: 1.5rem;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--bg-card);
  border: 2px solid var(--border-color);
}

.timeline-icon i {
  width: 12px;
  height: 12px;
}

.timeline-icon.note { border-color: #6b7280; color: #6b7280; }
.timeline-icon.call { border-color: #22c55e; color: #22c55e; }
.timeline-icon.email { border-color: #3b82f6; color: #3b82f6; }
.timeline-icon.task { border-color: #f59e0b; color: #f59e0b; }
.timeline-icon.meeting { border-color: #a855f7; color: #a855f7; }

.timeline-content {
  background: var(--bg-muted);
  border-radius: 0.5rem;
  padding: 0.75rem 1rem;
}

.timeline-header {
  display: flex;
  justify-content: space-between;
  margin-bottom: 0.5rem;
}

.timeline-title {
  font-weight: 500;
}

.timeline-time {
  font-size: 0.75rem;
  color: var(--text-muted);
}

.timeline-description {
  color: var(--text-secondary);
  font-size: 0.875rem;
  margin-bottom: 0.5rem;
}

.timeline-meta {
  display: flex;
  gap: 1rem;
  font-size: 0.75rem;
  color: var(--text-muted);
}

.timeline-outcome {
  background: var(--bg-card);
  padding: 0.125rem 0.5rem;
  border-radius: 0.25rem;
}

.timeline-performer {
  display: flex;
  align-items: center;
  gap: 0.25rem;
}

.timeline-due {
  color: var(--text-muted);
}

.timeline-due.overdue {
  color: #ef4444;
  font-weight: 500;
}

.timeline-actions {
  margin-top: 0.5rem;
  padding-top: 0.5rem;
  border-top: 1px solid var(--border-color);
}

.timeline-empty {
  text-align: center;
  padding: 3rem;
  color: var(--text-muted);
}

.timeline-empty i {
  width: 3rem;
  height: 3rem;
  margin-bottom: 1rem;
}

@media (max-width: 1024px) {
  .contact-detail-grid {
    grid-template-columns: 1fr;
  }
  
  .timeline-quick-actions {
    flex-wrap: wrap;
  }
  
  .quick-action-btn {
    min-width: calc(33% - 0.5rem);
  }
}
</style>

<!-- ═══ Activity Quick-Entry Modal ═══ -->
<div id="activityModal" class="canvas-modal" style="display: none;">
  <div class="canvas-modal-backdrop" onclick="closeActivityModal()"></div>
  <div class="canvas-modal-content" style="max-width: 480px;">
    <div class="canvas-modal-header">
      <h3 id="activityModalTitle">
        <i data-lucide="file-text"></i>
        Log Activity
      </h3>
      <button class="canvas-modal-close" onclick="closeActivityModal()">
        <i data-lucide="x"></i>
      </button>
    </div>
    <div class="canvas-modal-body">
      <input type="hidden" id="activityContactId">
      <input type="hidden" id="activityType">

      <!-- Subject (tasks, meetings, emails) -->
      <div id="activitySubjectGroup" class="mb-3" style="display: none;">
        <label class="form-label small fw-semibold">Subject</label>
        <input type="text" id="activitySubject" class="form-control form-control-sm" placeholder="Brief subject line">
      </div>

      <!-- Description / Notes (all types) -->
      <div class="mb-3">
        <label class="form-label small fw-semibold" id="activityDescLabel">Notes</label>
        <textarea id="activityDescription" class="form-control form-control-sm" rows="3" placeholder="Add details..."></textarea>
      </div>

      <!-- Outcome (calls only) -->
      <div id="activityOutcomeGroup" class="mb-3" style="display: none;">
        <label class="form-label small fw-semibold">Outcome</label>
        <select id="activityOutcome" class="form-select form-select-sm">
          <option value="connected">Connected</option>
          <option value="left_voicemail">Left Voicemail</option>
          <option value="no_answer">No Answer</option>
          <option value="busy">Busy</option>
          <option value="wrong_number">Wrong Number</option>
        </select>
      </div>

      <!-- Due date (tasks, meetings) -->
      <div id="activityDueGroup" class="mb-3" style="display: none;">
        <label class="form-label small fw-semibold" id="activityDueLabel">Due Date</label>
        <input type="datetime-local" id="activityDueAt" class="form-control form-control-sm">
      </div>
    </div>
    <div class="canvas-modal-footer">
      <button onclick="closeActivityModal()" class="canvas-btn secondary">Cancel</button>
      <button onclick="submitActivity()" id="activitySubmitBtn" class="canvas-btn primary">
        <i data-lucide="check"></i>
        <span id="activitySubmitLabel">Save</span>
      </button>
    </div>
  </div>
</div>

<!-- ═══ Lifecycle Promote Modal ═══ -->
<div id="promoteModal" class="canvas-modal" style="display: none;">
  <div class="canvas-modal-backdrop" onclick="closePromoteModal()"></div>
  <div class="canvas-modal-content" style="max-width: 400px;">
    <div class="canvas-modal-header">
      <h3><i data-lucide="arrow-up-right"></i> Promote Lifecycle Stage</h3>
      <button class="canvas-modal-close" onclick="closePromoteModal()"><i data-lucide="x"></i></button>
    </div>
    <div class="canvas-modal-body">
      <label class="form-label small fw-semibold">New Stage</label>
      <select id="promoteStage" class="form-select form-select-sm">
        <option value="subscriber">Subscriber</option>
        <option value="lead">Lead</option>
        <option value="mql">MQL</option>
        <option value="sql">SQL</option>
        <option value="opportunity">Opportunity</option>
        <option value="customer">Customer</option>
        <option value="evangelist">Evangelist</option>
      </select>
    </div>
    <div class="canvas-modal-footer">
      <button onclick="closePromoteModal()" class="canvas-btn secondary">Cancel</button>
      <button onclick="submitPromote()" id="promoteSubmitBtn" class="canvas-btn primary">
        <i data-lucide="arrow-up-right"></i> Promote
      </button>
    </div>
  </div>
</div>

<script>
const csrfToken = document.querySelector('meta[name="csrf-token"]')?.getAttribute('content');
const apiHeaders = { 'Content-Type': 'application/json', 'X-CSRF-Token': csrfToken };

// ── Navigation ──
function contactDetailBack() {
  window.scoutLoadCanvas?.('contact_viewer');
}

function contactDetailEdit(contactId) {
  // Reload the contact detail canvas in edit mode (future: inline editing)
  window.scoutLoadCanvas?.('contact_detail', { contact_id: contactId, edit: true });
}

function contactDetailViewOpportunity(opportunityId) {
  window.scoutLoadCanvas?.('pipeline_viewer', { opportunity_id: opportunityId });
}

// ── Activity Modal System ──
function openActivityModal(contactId, type, title, icon) {
  document.getElementById('activityContactId').value = contactId;
  document.getElementById('activityType').value = type;
  document.getElementById('activityModalTitle').innerHTML = `<i data-lucide="${icon}"></i> ${title}`;
  document.getElementById('activityDescription').value = '';
  document.getElementById('activitySubject').value = '';

  // Show/hide fields based on type
  const showSubject = ['email', 'task', 'meeting'].includes(type);
  const showOutcome = type === 'call';
  const showDue = ['task', 'meeting'].includes(type);
  document.getElementById('activitySubjectGroup').style.display = showSubject ? '' : 'none';
  document.getElementById('activityOutcomeGroup').style.display = showOutcome ? '' : 'none';
  document.getElementById('activityDueGroup').style.display = showDue ? '' : 'none';
  document.getElementById('activityDueLabel').textContent = type === 'meeting' ? 'Date & Time' : 'Due Date';

  // Set defaults
  if (showDue) {
    const tomorrow = new Date();
    tomorrow.setDate(tomorrow.getDate() + 1);
    tomorrow.setHours(9, 0, 0, 0);
    document.getElementById('activityDueAt').value = tomorrow.toISOString().slice(0, 16);
  }

  const labels = { note: 'Log Note', call: 'Log Call', email: 'Log Email', task: 'Create Task', meeting: 'Schedule' };
  document.getElementById('activitySubmitLabel').textContent = labels[type] || 'Save';
  document.getElementById('activityDescLabel').textContent = type === 'note' ? 'Note' : 'Details';

  document.getElementById('activityModal').style.display = 'flex';
  if (typeof lucide !== 'undefined') lucide.createIcons();
  document.getElementById(showSubject ? 'activitySubject' : 'activityDescription').focus();
}

function closeActivityModal() {
  document.getElementById('activityModal').style.display = 'none';
}

async function submitActivity() {
  const contactId = document.getElementById('activityContactId').value;
  const type = document.getElementById('activityType').value;
  const description = document.getElementById('activityDescription').value;
  const subject = document.getElementById('activitySubject').value;
  const outcome = document.getElementById('activityOutcome').value;
  const dueAt = document.getElementById('activityDueAt').value;
  const btn = document.getElementById('activitySubmitBtn');

  btn.disabled = true;

  const endpoints = {
    note:    '/api/v1/activities/log_note',
    call:    '/api/v1/activities/log_call',
    email:   '/api/v1/activities/log_email',
    task:    '/api/v1/activities/create_task',
    meeting: '/api/v1/activities/schedule_meeting'
  };

  const body = { contact_id: contactId, description: description };
  if (subject) body.subject = subject;
  if (type === 'call') body.outcome = outcome;
  if (dueAt && ['task', 'meeting'].includes(type)) body.due_at = dueAt;
  if (type === 'meeting') body.scheduled_at = dueAt;

  try {
    const resp = await fetch(endpoints[type], {
      method: 'POST',
      headers: apiHeaders,
      body: JSON.stringify(body)
    });
    const data = await resp.json();
    if (data.success || resp.ok) {
      closeActivityModal();
      // Refresh the contact detail to show the new activity in the timeline
      window.scoutLoadCanvas?.('contact_detail', { contact_id: contactId }, true);
    } else {
      alert(data.message || data.errors?.join(', ') || 'Failed to save activity');
    }
  } catch (e) {
    alert('Error: ' + e.message);
  } finally {
    btn.disabled = false;
  }
}

// ── Activity button wrappers ──
function contactDetailLogNote(contactId)        { openActivityModal(contactId, 'note',    'Log Note',         'file-text'); }
function contactDetailLogCall(contactId)        { openActivityModal(contactId, 'call',    'Log Call',         'phone'); }
function contactDetailLogEmail(contactId)       { openActivityModal(contactId, 'email',   'Log Email',        'mail'); }
function contactDetailCreateTask(contactId)     { openActivityModal(contactId, 'task',    'Create Task',      'check-square'); }
function contactDetailScheduleMeeting(contactId){ openActivityModal(contactId, 'meeting', 'Schedule Meeting', 'calendar'); }

function contactDetailSendEmail(contactId) {
  // Send email opens the campaign editor pre-targeted at this contact
  window.scoutLoadCanvas?.('campaign_editor', { contact_id: contactId });
}

function contactDetailCreateOpportunity(contactId) {
  window.scoutLoadCanvas?.('pipeline_viewer', { action: 'create', contact_id: contactId });
}

// ── Complete Task — direct API call ──
async function contactDetailCompleteTask(activityId) {
  try {
    const resp = await fetch(`/api/v1/activities/${activityId}/complete`, {
      method: 'POST',
      headers: apiHeaders
    });
    const data = await resp.json();
    if (data.success || resp.ok) {
      // Refresh to update timeline
      const contactId = document.getElementById('activityContactId')?.value ||
                        document.querySelector('[data-contact-id]')?.dataset?.contactId;
      const contactIdFromUrl = '<%= contact.id %>';
      window.scoutLoadCanvas?.('contact_detail', { contact_id: contactIdFromUrl }, true);
    } else {
      alert(data.message || 'Failed to complete task');
    }
  } catch (e) {
    alert('Error: ' + e.message);
  }
}

// ── Promote Lifecycle — modal + API ──
function contactDetailPromoteLifecycle(contactId) {
  document.getElementById('promoteModal').style.display = 'flex';
  if (typeof lucide !== 'undefined') lucide.createIcons();
}

function closePromoteModal() {
  document.getElementById('promoteModal').style.display = 'none';
}

async function submitPromote() {
  const stage = document.getElementById('promoteStage').value;
  const contactId = '<%= contact.id %>';
  const btn = document.getElementById('promoteSubmitBtn');
  btn.disabled = true;

  try {
    const resp = await fetch(`/api/v1/contacts_list/${contactId}`, {
      method: 'PATCH',
      headers: apiHeaders,
      body: JSON.stringify({ lifecycle_stage: stage })
    });
    if (resp.ok) {
      closePromoteModal();
      window.scoutLoadCanvas?.('contact_detail', { contact_id: contactId }, true);
    } else {
      const data = await resp.json().catch(() => ({}));
      alert(data.errors?.join(', ') || 'Failed to update lifecycle stage');
    }
  } catch (e) {
    alert('Error: ' + e.message);
  } finally {
    btn.disabled = false;
  }
}

// ── Assign Contact ──
function contactDetailAssign(contactId) {
  // For now load the detail in assign mode; future: inline team picker
  window.scoutLoadCanvas?.('contact_detail', { contact_id: contactId, action: 'assign' });
}

// ── Timeline Filter ──
function filterTimeline() {
  const filter = document.getElementById('activityTypeFilter').value;
  const items = document.querySelectorAll('.timeline-item');
  items.forEach(item => {
    item.style.display = (!filter || item.dataset.type === filter) ? '' : 'none';
  });
}

document.addEventListener('DOMContentLoaded', function() {
  if (typeof lucide !== 'undefined') lucide.createIcons();
});
</script>
