<%# Website Page Editor Canvas — inline editing for individual website pages
    Uses the shared inline editor component for text formatting.
%>

<%
  page_title = website_page.name rescue 'Untitled Page'
  page_content = website_page.html_content rescue ''
  page_status = website_page.respond_to?(:status) ? website_page.status : 'draft'
  website_name = website.name rescue 'Website'
  save_url = "/scout/update_website_page"
%>

<div id="websitePageEditor" class="h-100 d-flex flex-column" style="background: #0d0d1a; color: #e0e0e8; overflow: hidden;">
  
  <!-- Top Bar -->
  <div class="d-flex align-items-center justify-content-between px-3 py-2 border-bottom" style="border-color: #2d2d44 !important; background: #12122a; flex-shrink: 0;">
    <div class="d-flex align-items-center gap-2">
      <button type="button" class="btn btn-sm btn-outline-secondary" id="backToWebsite" title="Back to website">
        <i data-lucide="arrow-left" style="width: 14px; height: 14px;"></i>
      </button>
      <div>
        <span class="text-muted" style="font-size: 0.7rem;"><%= website_name %> /</span>
        <span class="fw-semibold" style="font-size: 0.9rem;"><%= page_title %></span>
      </div>
    </div>
    <div class="d-flex align-items-center gap-2">
      <span id="saveStatus" class="text-muted" style="font-size: 0.75rem;">No changes</span>
      <button type="button" class="btn btn-sm btn-outline-info" id="previewBtn">
        <i data-lucide="eye" style="width: 14px; height: 14px;" class="me-1"></i>Preview
      </button>
      <button type="button" class="btn btn-sm btn-primary" id="saveBtn" disabled>
        <i data-lucide="save" style="width: 14px; height: 14px;" class="me-1"></i>Save
      </button>
    </div>
  </div>

  <!-- Content Area -->
  <div id="websitePageContent" class="flex-grow-1" style="overflow-y: auto; padding: 20px;">
    <div id="pageEditableContent" style="max-width: 900px; margin: 0 auto; background: #fff; color: #333; border-radius: 8px; padding: 40px; min-height: 400px;">
      <% if page_content.present? %>
        <%= page_content.html_safe %>
      <% else %>
        <div contenteditable="true" style="min-height: 200px; padding: 20px;">
          <h1>Page Title</h1>
          <p>Start editing your page content...</p>
        </div>
      <% end %>
    </div>
  </div>
</div>

<!-- Include the universal inline editor -->
<%= render 'shared/inline_editor', content_container_id: 'pageEditableContent', on_change_callback: 'markPageChanged' %>

<script>
(function() {
  const websiteId = '<%= website.id %>';
  const pageId = '<%= website_page.id %>';
  let hasChanges = false;

  function markPageChanged() {
    hasChanges = true;
    const saveBtn = document.getElementById('saveBtn');
    const saveStatus = document.getElementById('saveStatus');
    if (saveBtn) saveBtn.disabled = false;
    if (saveStatus) {
      saveStatus.textContent = 'Unsaved changes';
      saveStatus.classList.remove('text-muted', 'text-success');
      saveStatus.classList.add('text-warning');
    }
  }

  // Make editable
  const editableContent = document.getElementById('pageEditableContent');
  if (editableContent) {
    // Make all text elements contenteditable
    editableContent.querySelectorAll('h1, h2, h3, h4, h5, h6, p, li, td, th, span, a, blockquote, figcaption').forEach(function(el) {
      if (!el.closest('[contenteditable="true"]')) {
        el.setAttribute('contenteditable', 'true');
      }
    });

    // Listen for changes
    editableContent.addEventListener('input', markPageChanged);

    // Initialize the universal inline editor
    setupInlineTextToolbar('pageEditableContent', markPageChanged);
  }

  // Save button
  const saveBtn = document.getElementById('saveBtn');
  if (saveBtn) {
    saveBtn.addEventListener('click', async function() {
      if (!hasChanges) return;
      const content = editableContent.innerHTML;
      const csrfToken = document.querySelector('meta[name="csrf-token"]')?.content ||
                        window.parent?.document?.querySelector('meta[name="csrf-token"]')?.content;

      saveBtn.disabled = true;
      saveBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Saving...';

      try {
        // Send save via postMessage to parent (scout controller handles it)
        window.parent.postMessage({
          type: 'save_website_page',
          website_id: websiteId,
          page_id: pageId,
          html_content: content
        }, '*');

        hasChanges = false;
        document.getElementById('saveStatus').textContent = 'Saved';
        document.getElementById('saveStatus').className = 'text-success';
        saveBtn.innerHTML = '<i data-lucide="save" style="width: 14px; height: 14px;" class="me-1"></i>Saved!';
        setTimeout(function() {
          saveBtn.innerHTML = '<i data-lucide="save" style="width: 14px; height: 14px;" class="me-1"></i>Save';
          if (typeof lucide !== 'undefined') lucide.createIcons({ node: saveBtn });
        }, 2000);
      } catch (err) {
        console.error('Save failed:', err);
        saveBtn.disabled = false;
        saveBtn.innerHTML = '<i data-lucide="save" style="width: 14px; height: 14px;" class="me-1"></i>Save';
      }
    });
  }

  // Back button
  const backBtn = document.getElementById('backToWebsite');
  if (backBtn) {
    backBtn.addEventListener('click', function() {
      if (hasChanges && !confirm('You have unsaved changes. Leave anyway?')) return;
      window.parent.postMessage({
        type: 'load_canvas',
        canvas_name: 'my_creations',
        canvas_data: { type: 'website' }
      }, '*');
    });
  }

  // Preview button
  const previewBtn = document.getElementById('previewBtn');
  if (previewBtn) {
    previewBtn.addEventListener('click', function() {
      const content = editableContent.innerHTML;
      const win = window.open('', '_blank');
      win.document.write(`<!DOCTYPE html><html><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title>Preview: ${document.title}</title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet"></head><body>${content}</body></html>`);
      win.document.close();
    });
  }

  if (typeof lucide !== 'undefined') lucide.createIcons();
})();
</script>
