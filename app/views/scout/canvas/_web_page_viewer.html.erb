<%# Web Page Viewer Canvas
    Displays external web pages via iframe or screenshot capture

    canvas_data:
      - url: The web page URL
      - request_id: Unique ID for tracking async captures
      - display_mode: "iframe" or "screenshot"
      - status: "ready", "capturing", "complete", "error"
      - screenshot_url: URL of captured screenshot (when status=complete)
      - title: Page title (from capture)
      - text_content: Extracted text (from capture)
      - error: Error message (when status=error)
%>

<%
  url = canvas_data['url'] || canvas_data[:url]
  request_id = canvas_data['request_id'] || canvas_data[:request_id] || SecureRandom.uuid
  display_mode = canvas_data['display_mode'] || canvas_data[:display_mode] || 'iframe'
  status = canvas_data['status'] || canvas_data[:status] || 'ready'
  screenshot_url = canvas_data['screenshot_url'] || canvas_data[:screenshot_url]
  page_title = canvas_data['title'] || canvas_data[:title]
  text_content = canvas_data['text_content'] || canvas_data[:text_content]
  error_message = canvas_data['error'] || canvas_data[:error]
  show_fallback = canvas_data['show_fallback_option'] || canvas_data[:show_fallback_option]
  proxy_url = canvas_data['proxy_url'] || canvas_data[:proxy_url] || "/web_proxy?url=#{CGI.escape(url.to_s)}"
  handoff = canvas_data['handoff'] || canvas_data[:handoff] || {}
  handoff_session_id = handoff['session_id'] || handoff[:session_id]
  handoff_proxy_host = handoff['proxy_host'] || handoff[:proxy_host]

  domain = begin
    URI.parse(url).host
  rescue
    url
  end
%>

<div class="web-page-viewer"
     data-controller="web-page-viewer"
     data-web-page-viewer-url-value="<%= url %>"
     data-web-page-viewer-request-id-value="<%= request_id %>"
     data-web-page-viewer-display-mode-value="<%= display_mode %>"
     data-web-page-viewer-proxy-url-value="<%= proxy_url %>">

  <!-- Header Bar -->
  <div class="wpv-header">
    <a href="<%= url %>" target="_blank" rel="noopener noreferrer" class="wpv-url-bar" title="Open <%= domain %> in new tab">
      <i data-lucide="globe" class="wpv-icon" aria-hidden="true"></i>
      <span class="wpv-domain"><%= domain %></span>
      <i data-lucide="external-link" class="wpv-icon-sm wpv-external-link" aria-hidden="true"></i>
    </a>
    <div class="wpv-actions">
      <button type="button" class="wpv-btn wpv-btn-primary wpv-share-btn"
              data-action="click->web-page-viewer#shareWithAmos"
              title="Let Amos see this page">
        <i data-lucide="bot" class="wpv-icon-sm" aria-hidden="true"></i>
        <span>Share with Amos</span>
      </button>
      <button type="button" class="wpv-btn wpv-btn-secondary"
              data-action="click->web-page-viewer#refresh"
              title="Refresh">
        <i data-lucide="refresh-cw" class="wpv-icon-sm" aria-hidden="true"></i>
      </button>
    </div>
  </div>

  <!-- Content Area -->
  <div class="wpv-content" data-web-page-viewer-target="content">

    <% if status == 'capturing' %>
      <!-- Loading State -->
      <div class="wpv-loading" data-web-page-viewer-target="loading">
        <div class="wpv-spinner"></div>
        <p class="wpv-loading-text">Capturing screenshot...</p>
        <p class="wpv-loading-subtext">This may take a few seconds</p>
      </div>

    <% elsif status == 'error' %>
      <!-- Error State -->
      <div class="wpv-error" data-web-page-viewer-target="error">
        <i data-lucide="alert-circle" class="wpv-error-icon" aria-hidden="true"></i>
        <h4>Unable to load page</h4>
        <p><%= error_message || "The page could not be loaded or captured." %></p>
        <div class="wpv-error-actions">
          <button type="button" class="wpv-btn wpv-btn-primary"
                  data-action="click->web-page-viewer#captureScreenshot">
            <i data-lucide="camera" class="wpv-icon-sm" aria-hidden="true"></i>
            Try Screenshot Capture
          </button>
          <a href="<%= url %>" target="_blank" rel="noopener noreferrer" class="wpv-btn wpv-btn-secondary">
            <i data-lucide="external-link" class="wpv-icon-sm" aria-hidden="true"></i>
            Open in New Tab
          </a>
        </div>
      </div>

    <% elsif status == 'complete' && screenshot_url.present? %>
      <!-- Screenshot View -->
      <div class="wpv-screenshot-container" data-web-page-viewer-target="screenshot">
        <% if page_title.present? %>
          <div class="wpv-page-info">
            <h4 class="wpv-page-title"><%= page_title %></h4>
          </div>
        <% end %>

        <div class="wpv-screenshot-wrapper">
          <img src="<%= screenshot_url %>"
               alt="Screenshot of <%= domain %>"
               class="wpv-screenshot-img"
               data-action="click->web-page-viewer#toggleZoom"
               data-web-page-viewer-target="screenshotImg" />
        </div>

        <% if text_content.present? %>
          <details class="wpv-text-content">
            <summary>
              <i data-lucide="file-text" class="wpv-icon-sm" aria-hidden="true"></i>
              Page Content (extracted text)
            </summary>
            <div class="wpv-text-body">
              <%= simple_format(text_content.truncate(5000)) %>
            </div>
          </details>
        <% end %>
      </div>

    <% elsif display_mode == 'interactive' %>
      <!-- Interactive Browser Session - Proxied Iframe -->
      <div class="wpv-interactive-container" data-web-page-viewer-target="interactive">
        <% if handoff_session_id.present? && handoff_proxy_host.present? %>
          <div class="alert alert-info d-flex flex-wrap align-items-start justify-content-between gap-2 m-2" role="alert">
            <div class="me-auto">
              <div class="fw-semibold">User handoff</div>
              <div class="small">Complete the login (or any required step) here. Then choose to continue with the agent or take over manually.</div>
            </div>
            <div class="d-flex gap-2">
              <button type="button"
                      class="btn btn-sm btn-primary"
                      onclick="window.requestBrowserSessionSyncLogin?.('<%= j(handoff_session_id.to_s) %>', '<%= j(handoff_proxy_host.to_s) %>')">
                Continue agent
              </button>
              <button type="button"
                      class="btn btn-sm btn-outline-secondary"
                      onclick="window.requestBrowserSessionTakeOver?.('<%= j(handoff_session_id.to_s) %>')">
                Take over
              </button>
            </div>
          </div>
        <% end %>
        <div class="wpv-interactive-toolbar">
          <div class="wpv-mode-badge">
            <i data-lucide="monitor-play" class="wpv-icon-sm" aria-hidden="true"></i>
            <span>Interactive Mode</span>
          </div>
          <div class="wpv-interactive-actions">
            <button type="button" class="wpv-btn wpv-btn-sm"
                    data-action="click->web-page-viewer#refreshInteractive"
                    title="Refresh">
              <i data-lucide="refresh-cw" class="wpv-icon-sm" aria-hidden="true"></i>
            </button>
            <a href="<%= url %>" target="_blank" rel="noopener noreferrer" 
               class="wpv-btn wpv-btn-sm" title="Open in New Tab">
              <i data-lucide="external-link" class="wpv-icon-sm" aria-hidden="true"></i>
            </a>
            <button type="button" class="wpv-btn wpv-btn-secondary wpv-btn-sm"
                    data-action="click->web-page-viewer#switchToScreenshot"
                    title="Take a Screenshot Instead">
              <i data-lucide="camera" class="wpv-icon-sm" aria-hidden="true"></i>
              Screenshot
            </button>
          </div>
        </div>

        <!-- Interactive Session Loading (absolute positioned overlay) -->
        <div class="wpv-interactive-loading-overlay" data-web-page-viewer-target="interactiveLoading">
          <div class="wpv-spinner"></div>
          <p class="wpv-loading-text">Loading page...</p>
          <p class="wpv-loading-subtext">You'll be able to click and navigate</p>
        </div>

        <!-- Interactive Session Frame (proxied content) -->
        <div class="wpv-interactive-frame-container" data-web-page-viewer-target="interactiveFrame">
          <iframe class="wpv-interactive-frame"
                  src="<%= proxy_url %>"
                  data-web-page-viewer-target="proxyFrame"
                  referrerpolicy="no-referrer-when-downgrade"
                  data-action="load->web-page-viewer#onProxyFrameLoad">
          </iframe>
        </div>

        <!-- Interactive Session Error -->
        <div class="wpv-interactive-error hidden" data-web-page-viewer-target="interactiveError">
          <i data-lucide="alert-circle" class="wpv-error-icon" aria-hidden="true"></i>
          <h4>Couldn't load page</h4>
          <p>Some pages may not work in interactive mode.</p>
          <div class="wpv-error-actions">
            <button type="button" class="wpv-btn wpv-btn-primary"
                    data-action="click->web-page-viewer#captureScreenshot">
              <i data-lucide="camera" class="wpv-icon-sm" aria-hidden="true"></i>
              Try Screenshot Instead
            </button>
            <a href="<%= url %>" target="_blank" rel="noopener noreferrer" class="wpv-btn wpv-btn-secondary">
              <i data-lucide="external-link" class="wpv-icon-sm" aria-hidden="true"></i>
              Open in New Tab
            </a>
          </div>
        </div>
      </div>

    <% elsif display_mode == 'iframe' %>
      <!-- Iframe View -->
      <div class="wpv-iframe-container" data-web-page-viewer-target="iframe">
        <iframe src="<%= url %>"
                sandbox="allow-scripts allow-same-origin allow-forms allow-popups"
                referrerpolicy="no-referrer"
                loading="lazy"
                class="wpv-iframe"
                data-web-page-viewer-target="frame"
                data-action="load->web-page-viewer#onIframeLoad error->web-page-viewer#onIframeError">
        </iframe>

        <!-- Iframe Loading Overlay -->
        <div class="wpv-iframe-loading" data-web-page-viewer-target="iframeLoading">
          <div class="wpv-spinner"></div>
          <p>Loading page...</p>
        </div>

        <!-- Iframe Blocked Message (shown if iframe fails) -->
        <div class="wpv-iframe-blocked hidden" data-web-page-viewer-target="iframeBlocked">
          <i data-lucide="shield-x" class="wpv-blocked-icon" aria-hidden="true"></i>
          <h4>This site blocks embedding</h4>
          <p>Many websites don't allow embedding for security reasons.</p>
          <div class="wpv-blocked-actions">
            <button type="button" class="wpv-btn wpv-btn-primary"
                    data-action="click->web-page-viewer#captureScreenshot">
              <i data-lucide="camera" class="wpv-icon-sm" aria-hidden="true"></i>
              Capture Screenshot Instead
            </button>
            <a href="<%= url %>" target="_blank" rel="noopener noreferrer" class="wpv-btn wpv-btn-secondary">
              <i data-lucide="external-link" class="wpv-icon-sm" aria-hidden="true"></i>
              Open in New Tab
            </a>
          </div>
        </div>
      </div>

    <% else %>
      <!-- Fallback: Just show loading -->
      <div class="wpv-loading" data-web-page-viewer-target="loading">
        <div class="wpv-spinner"></div>
        <p class="wpv-loading-text">Loading...</p>
      </div>
    <% end %>

  </div>
</div>

<style>
  .web-page-viewer {
    display: flex;
    flex-direction: column;
    height: 100%;
    background: var(--bg-primary);
    border-radius: 8px;
    overflow: hidden;
  }

  /* Header Bar */
  .wpv-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 12px 16px;
    background: var(--bg-secondary);
    border-bottom: 1px solid var(--border-color);
    flex-shrink: 0;
  }

  .wpv-url-bar {
    display: flex;
    align-items: center;
    gap: 8px;
    background: var(--bg-tertiary);
    padding: 8px 12px;
    border-radius: 6px;
    flex: 1;
    max-width: 500px;
    text-decoration: none;
    cursor: pointer;
    transition: background 0.2s, border-color 0.2s;
    border: 1px solid transparent;
  }

  .wpv-url-bar:hover {
    background: var(--bg-secondary);
    border-color: var(--border-color);
  }

  .wpv-url-bar:hover .wpv-external-link {
    opacity: 1;
    color: var(--purple);
  }

  .wpv-domain {
    color: var(--text-primary);
    font-size: 0.875rem;
    font-family: monospace;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .wpv-external-link {
    color: var(--text-secondary);
    margin-left: auto;
    opacity: 0.7;
    transition: opacity 0.2s, color 0.2s;
  }

  .wpv-actions {
    display: flex;
    gap: 8px;
  }

  .wpv-icon {
    width: 16px;
    height: 16px;
    color: var(--text-secondary);
  }

  .wpv-icon-sm {
    width: 14px;
    height: 14px;
  }

  /* Buttons */
  .wpv-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 8px 12px;
    border-radius: 6px;
    font-size: 0.875rem;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.2s;
    border: none;
    text-decoration: none;
  }

  .wpv-btn-primary {
    background: var(--purple);
    color: white;
  }

  .wpv-btn-primary:hover {
    background: var(--purple-hover, #6d28d9);
    transform: translateY(-1px);
  }
  
  .wpv-share-btn {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 1rem;
    font-weight: 500;
  }
  
  .wpv-share-btn:disabled {
    opacity: 0.7;
    cursor: wait;
  }
  
  .wpv-share-btn .spinner-border {
    width: 1rem;
    height: 1rem;
    border-width: 2px;
  }

  .wpv-btn-secondary {
    background: var(--bg-tertiary);
    color: var(--text-primary);
    border: 1px solid var(--border-color);
  }

  .wpv-btn-secondary:hover {
    background: var(--bg-secondary);
    border-color: var(--text-secondary);
  }

  /* Content Area */
  .wpv-content {
    flex: 1;
    overflow: hidden;
    position: relative;
    display: flex;
    flex-direction: column;
    min-height: 0; /* Allow flex shrinking */
  }

  /* Loading State */
  .wpv-loading {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    height: 100%;
    padding: 40px;
    text-align: center;
  }

  .wpv-spinner {
    width: 40px;
    height: 40px;
    border: 3px solid var(--border-color);
    border-top-color: var(--purple);
    border-radius: 50%;
    animation: wpv-spin 1s linear infinite;
  }

  @keyframes wpv-spin {
    to { transform: rotate(360deg); }
  }

  .wpv-loading-text {
    margin-top: 16px;
    color: var(--text-primary);
    font-weight: 500;
  }

  .wpv-loading-subtext {
    margin-top: 4px;
    color: var(--text-secondary);
    font-size: 0.875rem;
  }

  /* Error State */
  .wpv-error {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    height: 100%;
    padding: 40px;
    text-align: center;
  }

  .wpv-error-icon {
    width: 48px;
    height: 48px;
    color: #ef4444;
    margin-bottom: 16px;
  }

  .wpv-error h4 {
    color: var(--text-primary);
    margin: 0 0 8px 0;
  }

  .wpv-error p {
    color: var(--text-secondary);
    margin: 0 0 24px 0;
  }

  .wpv-error-actions {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    justify-content: center;
  }

  /* Iframe Container */
  .wpv-iframe-container {
    position: relative;
    height: 100%;
    width: 100%;
  }

  .wpv-iframe {
    width: 100%;
    height: 100%;
    border: none;
    background: white;
  }

  .wpv-iframe-loading {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background: var(--bg-primary);
    z-index: 10;
  }

  .wpv-iframe-loading p {
    margin-top: 16px;
    color: var(--text-secondary);
  }

  .wpv-iframe-blocked {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background: var(--bg-primary);
    padding: 40px;
    text-align: center;
    z-index: 10;
  }

  .wpv-iframe-blocked.hidden {
    display: none;
  }

  .wpv-blocked-icon {
    width: 48px;
    height: 48px;
    color: var(--text-secondary);
    margin-bottom: 16px;
  }

  .wpv-iframe-blocked h4 {
    color: var(--text-primary);
    margin: 0 0 8px 0;
  }

  .wpv-iframe-blocked p {
    color: var(--text-secondary);
    margin: 0 0 24px 0;
  }

  .wpv-blocked-actions {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    justify-content: center;
  }

  /* Interactive Mode */
  .wpv-interactive-container {
    flex: 1;
    display: flex;
    flex-direction: column;
    position: relative;
    height: 100%;
    min-height: 0; /* Allow flex shrinking */
  }

  .wpv-interactive-toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 8px 12px;
    background: linear-gradient(135deg, rgba(139, 92, 246, 0.1), rgba(59, 130, 246, 0.1));
    border-bottom: 1px solid var(--border-color);
  }

  .wpv-mode-badge {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 4px 10px;
    background: linear-gradient(135deg, var(--purple), var(--blue));
    color: white;
    border-radius: 12px;
    font-size: 0.75rem;
    font-weight: 600;
  }

  .wpv-interactive-actions {
    display: flex;
    gap: 6px;
  }

  .wpv-btn-sm {
    padding: 4px 8px;
    font-size: 0.75rem;
  }

  .wpv-interactive-loading-overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 40px;
    text-align: center;
    background: var(--bg-primary);
    z-index: 10;
  }

  .wpv-interactive-loading-overlay.hidden {
    display: none;
  }

  .wpv-interactive-frame-container {
    flex: 1;
    display: flex;
    position: relative;
    min-height: 0; /* Allow flex shrinking */
    height: 100%;
  }

  .wpv-interactive-frame-container.hidden {
    display: none;
  }

  .wpv-interactive-frame {
    width: 100%;
    height: 100%;
    border: none;
    background: white;
    flex: 1;
    min-height: 0;
  }

  .wpv-interactive-error {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 40px;
    text-align: center;
  }

  .wpv-interactive-error.hidden {
    display: none;
  }

  .wpv-interactive-error h4 {
    color: var(--text-primary);
    margin: 16px 0 8px 0;
  }

  .wpv-interactive-error p {
    color: var(--text-secondary);
    margin: 0 0 24px 0;
  }

  /* Screenshot View */
  .wpv-screenshot-container {
    padding: 16px;
    overflow-y: auto;
    height: 100%;
    flex: 1;
  }

  .wpv-page-info {
    margin-bottom: 16px;
  }

  .wpv-page-title {
    color: var(--text-primary);
    margin: 0;
    font-size: 1.125rem;
  }

  .wpv-screenshot-wrapper {
    background: var(--bg-secondary);
    border-radius: 8px;
    overflow: hidden;
    border: 1px solid var(--border-color);
  }

  .wpv-screenshot-img {
    width: 100%;
    height: auto;
    display: block;
    cursor: zoom-in;
    transition: transform 0.3s;
  }

  .wpv-screenshot-img.zoomed {
    cursor: zoom-out;
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    object-fit: contain;
    background: rgba(0, 0, 0, 0.9);
    z-index: 9999;
    padding: 20px;
    box-sizing: border-box;
  }

  /* Text Content Accordion */
  .wpv-text-content {
    margin-top: 16px;
    background: var(--bg-secondary);
    border-radius: 8px;
    border: 1px solid var(--border-color);
  }

  .wpv-text-content summary {
    padding: 12px 16px;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--text-primary);
    font-weight: 500;
    user-select: none;
  }

  .wpv-text-content summary:hover {
    background: var(--bg-tertiary);
  }

  .wpv-text-body {
    padding: 16px;
    border-top: 1px solid var(--border-color);
    color: var(--text-secondary);
    font-size: 0.875rem;
    line-height: 1.6;
    max-height: 400px;
    overflow-y: auto;
  }

  .wpv-text-body p {
    margin: 0 0 12px 0;
  }

  .wpv-text-body p:last-child {
    margin-bottom: 0;
  }
</style>

<script>
  // Initialize Lucide icons for this canvas
  if (typeof lucide !== 'undefined') {
    lucide.createIcons();
  }

  // Set up iframe load detection with auto-screenshot fallback
  (function() {
    const container = document.querySelector('.web-page-viewer');
    if (!container) return;

    const iframe = container.querySelector('.wpv-iframe');
    const loadingOverlay = container.querySelector('.wpv-iframe-loading');
    const blockedMessage = container.querySelector('.wpv-iframe-blocked');
    const url = container.dataset.webPageViewerUrlValue;
    const requestId = container.dataset.webPageViewerRequestIdValue;

    // If no iframe (screenshot mode), exit early
    if (!iframe) {
      console.log('[WebPageViewer] Screenshot mode - no iframe detection needed');
      return;
    }

    if (!loadingOverlay) return;

    console.log('[WebPageViewer] Setting up iframe load detection with auto-capture fallback');

    let loadHandled = false;
    let captureTriggered = false;

    // Capture state tracking
    let captureStartTime = null;
    let progressTimer = null;
    let timeoutTimer = null;

    // Function to update loading message based on elapsed time
    function updateLoadingProgress() {
      if (!loadingOverlay || !captureStartTime) return;

      const elapsed = Math.floor((Date.now() - captureStartTime) / 1000);
      const statusText = loadingOverlay.querySelector('.wpv-capture-status');
      const subText = loadingOverlay.querySelector('.wpv-capture-subtext');

      if (elapsed >= 20 && statusText) {
        statusText.textContent = 'Still working...';
        if (subText) subText.textContent = 'Complex pages can take up to 45 seconds';
      } else if (elapsed >= 10 && statusText) {
        statusText.textContent = 'Taking longer than expected...';
        if (subText) subText.textContent = 'The page may have a lot of content to load';
      }
    }

    // Function to trigger automatic screenshot capture
    async function triggerAutoCapture() {
      if (captureTriggered) return;
      captureTriggered = true;
      captureStartTime = Date.now();

      console.log('[WebPageViewer] Auto-triggering screenshot capture for:', url);

      // Update UI to show capturing state with explanation
      if (loadingOverlay) {
        loadingOverlay.classList.remove('hidden');
        loadingOverlay.innerHTML = `
          <div class="wpv-spinner"></div>
          <p class="wpv-capture-status" style="margin-top: 16px; color: var(--text-primary); font-weight: 500;">Capturing screenshot...</p>
          <p class="wpv-capture-subtext" style="margin-top: 8px; color: var(--text-secondary); font-size: 0.875rem; max-width: 300px; text-align: center;">
            This site blocks embedded previews. Taking a screenshot instead.
          </p>
          <div class="wpv-capture-timer" style="margin-top: 12px; font-size: 0.75rem; color: var(--text-tertiary);"></div>
        `;
      }
      if (blockedMessage) {
        blockedMessage.classList.add('hidden');
      }

      // Hide the blocked iframe
      if (iframe) {
        iframe.style.display = 'none';
      }

      // Start progress timer - update message every 5 seconds
      progressTimer = setInterval(updateLoadingProgress, 5000);

      // Set timeout for 60 seconds - show error if capture takes too long
      timeoutTimer = setTimeout(() => {
        console.log('[WebPageViewer] Capture timeout - showing error');
        clearInterval(progressTimer);
        showError('Screenshot capture timed out. The page may be too complex or slow to load.', true);
      }, 60000);

      try {
        const csrfToken = document.querySelector('meta[name="csrf-token"]')?.getAttribute('content') || '';
        const response = await fetch('/scout/capture_web_page', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'X-CSRF-Token': csrfToken
          },
          body: JSON.stringify({ url: url, request_id: requestId })
        });

        const data = await response.json();
        console.log('[WebPageViewer] Capture response:', data);

        if (!data.success) {
          clearInterval(progressTimer);
          clearTimeout(timeoutTimer);
          showError(data.error || 'Failed to capture screenshot', true);
        }
        // Success case: the screenshot will arrive via ActionCable canvas update
        // Timer will be cleared in showScreenshotResult
      } catch (error) {
        console.error('[WebPageViewer] Capture request failed:', error);
        clearInterval(progressTimer);
        clearTimeout(timeoutTimer);
        showError('Failed to capture screenshot. Please try again.', true);
      }
    }

    // Function to show error state with optional retry button
    function showError(message, showRetry = false) {
      if (loadingOverlay) loadingOverlay.classList.add('hidden');

      const content = container.querySelector('.wpv-content');
      if (!content) return;

      let retryHtml = '';
      if (showRetry) {
        retryHtml = `
          <div style="margin-top: 20px; display: flex; gap: 12px; flex-wrap: wrap; justify-content: center;">
            <button type="button" class="wpv-btn wpv-btn-primary" onclick="location.reload()">
              <i data-lucide="refresh-cw" class="wpv-icon-sm" aria-hidden="true"></i>
              Try Again
            </button>
            <a href="${url}" target="_blank" rel="noopener noreferrer" class="wpv-btn wpv-btn-secondary">
              <i data-lucide="external-link" class="wpv-icon-sm" aria-hidden="true"></i>
              Open in New Tab
            </a>
          </div>
        `;
      }

      content.innerHTML = `
        <div class="wpv-error">
          <i data-lucide="alert-circle" class="wpv-error-icon" aria-hidden="true"></i>
          <h4>Unable to capture page</h4>
          <p>${escapeHtml(message)}</p>
          ${retryHtml}
        </div>
      `;

      // Re-init icons
      if (typeof lucide !== 'undefined') {
        lucide.createIcons();
      }
    }

    // Function to check if iframe is blocked (appears empty/blank)
    function checkIfBlocked() {
      try {
        // Try to access iframe content - if blocked, this will throw or return null
        const doc = iframe.contentDocument || iframe.contentWindow?.document;

        // If we can access the document and it has content, it loaded successfully
        if (doc && doc.body && doc.body.innerHTML.length > 100) {
          console.log('[WebPageViewer] Iframe has content, appears to have loaded');
          return false;
        }

        // If document is mostly empty, likely blocked
        if (doc && doc.body && doc.body.innerHTML.length < 100) {
          console.log('[WebPageViewer] Iframe appears empty/blocked');
          return true;
        }
      } catch (e) {
        // Cross-origin - can't access content due to security restrictions
        // Most major sites block embedding, so assume blocked for cross-origin
        console.log('[WebPageViewer] Cross-origin iframe - assuming blocked (cannot verify content)');
        return true; // Assume blocked for cross-origin since we can't verify
      }

      // Visual check: if iframe dimensions are very small or zero, likely blocked
      const rect = iframe.getBoundingClientRect();
      if (rect.width < 50 || rect.height < 50) {
        console.log('[WebPageViewer] Iframe has tiny dimensions, likely blocked');
        return true;
      }

      return false;
    }

    // Listen for CSP violation events (fires when embedding is blocked by CSP)
    document.addEventListener('securitypolicyviolation', function(e) {
      if (e.blockedURI && url && e.blockedURI.includes(new URL(url).hostname)) {
        console.log('[WebPageViewer] CSP violation detected for:', e.blockedURI);
        loadHandled = true;
        triggerAutoCapture();
      }
    });

    // Listen for iframe load
    iframe.addEventListener('load', function() {
      console.log('[WebPageViewer] Iframe load event fired');

      // Wait a moment then check if content actually loaded
      setTimeout(function() {
        if (loadHandled) return;
        loadHandled = true;

        const isBlocked = checkIfBlocked();

        if (isBlocked) {
          console.log('[WebPageViewer] Iframe loaded but appears blocked');
          triggerAutoCapture();
        } else {
          console.log('[WebPageViewer] Iframe loaded successfully');
          loadingOverlay.classList.add('hidden');
        }
      }, 500); // Small delay to let content render
    });

    // Listen for iframe error
    iframe.addEventListener('error', function() {
      console.log('[WebPageViewer] Iframe error event fired');
      if (loadHandled) return;
      loadHandled = true;
      triggerAutoCapture();
    });

    // Timeout fallback - if neither event fires in 8 seconds, auto-capture
    setTimeout(function() {
      if (!loadHandled) {
        console.log('[WebPageViewer] Timeout - auto-capturing');
        loadHandled = true;
        triggerAutoCapture();
      }
    }, 8000);

    // Listen for canvas updates from background job (screenshot results)
    document.addEventListener('scout:canvas-update', function(event) {
      const { canvas, canvas_data: data } = event.detail || {};

      if (canvas !== 'web_page_viewer') return;
      if (data?.request_id !== requestId) return;

      console.log('[WebPageViewer] Received canvas update via ActionCable:', data);

      // Clear timers on any response
      clearInterval(progressTimer);
      clearTimeout(timeoutTimer);

      if (data.status === 'complete' && data.screenshot_url) {
        // Show the screenshot
        showScreenshotResult(data);
      } else if (data.status === 'error') {
        showError(data.error || 'Failed to capture screenshot', true);
      }
    });

    // Function to display screenshot result
    function showScreenshotResult(data) {
      // Clear timers
      clearInterval(progressTimer);
      clearTimeout(timeoutTimer);

      const content = container.querySelector('.wpv-content');
      if (!content) return;

      let html = '<div class="wpv-screenshot-container">';

      if (data.title) {
        html += `
          <div class="wpv-page-info">
            <h4 class="wpv-page-title">${escapeHtml(data.title)}</h4>
          </div>
        `;
      }

      html += `
        <div class="wpv-screenshot-wrapper">
          <img src="${data.screenshot_url}"
               alt="Screenshot"
               class="wpv-screenshot-img"
               onclick="this.classList.toggle('zoomed')" />
        </div>
      `;

      if (data.text_content) {
        html += `
          <details class="wpv-text-content">
            <summary>
              <i data-lucide="file-text" class="wpv-icon-sm" aria-hidden="true"></i>
              Page Content (extracted text)
            </summary>
            <div class="wpv-text-body">
              ${escapeHtml(data.text_content.substring(0, 5000))}
            </div>
          </details>
        `;
      }

      html += '</div>';

      content.innerHTML = html;

      // Re-init icons
      if (typeof lucide !== 'undefined') {
        lucide.createIcons();
      }
    }

    // Helper to escape HTML
    function escapeHtml(text) {
      const div = document.createElement('div');
      div.textContent = text || '';
      return div.innerHTML;
    }
  })();
</script>
