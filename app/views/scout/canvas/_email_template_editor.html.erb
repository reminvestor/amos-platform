<div class="email-template-editor canvas-container" data-template-id="<%= email_template.id %>" style="min-height: 100vh; padding: 2rem;">
  <!-- Page Header -->
  <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 2rem; flex-wrap: wrap; gap: 1rem;">
    <div>
      <h1 class="canvas-page-title" style="display: flex; align-items: center; gap: 1rem;">
        <i data-lucide="mail" style="width: 2rem; height: 2rem;"></i>
        <%= email_template.name %>
      </h1>
      <p class="canvas-page-subtitle" style="margin-bottom: 0;">Last updated <%= time_ago_in_words(email_template.updated_at) %> ago</p>
    </div>
    <div style="display: flex; gap: 0.5rem; flex-wrap: wrap;">
      <button id="saveTemplateChanges" onclick="saveTemplateChanges()" aria-label="Save template changes" style="background: var(--status-success-text); color: var(--bg-primary); border: none; padding: 0.5rem 1rem; border-radius: 0.375rem; cursor: pointer; display: inline-flex; align-items: center; gap: 0.5rem; font-weight: 500;">
        <i data-lucide="save" style="width: 1rem; height: 1rem;"></i>
        Save Changes
      </button>
      <button onclick="sendTestEmail()" aria-label="Send test email" class="canvas-btn primary">
        <i data-lucide="send" class="canvas-icon-sm"></i>
        Send Test
      </button>
      <button onclick="window.scoutSendMessage?.('Improve this email template to be more engaging and professional')" aria-label="Improve template with AI" class="canvas-btn" style="background: var(--status-warning-text); color: var(--text-primary);">
        <i data-lucide="wand-2" class="canvas-icon-sm"></i>
        Improve with AI
      </button>
      <button onclick="window.scoutLoadCanvas?.('email_template_viewer', {})" aria-label="Back to template list" class="canvas-btn secondary">
        <i data-lucide="arrow-left" class="canvas-icon-sm"></i>
        Back to List
      </button>
    </div>
  </div>

  <!-- Instructions Alert -->
  <div class="canvas-info-box" style="background: linear-gradient(135deg, var(--accent-purple-start) 0.5%, var(--bg-card) 100%); border: 1px solid var(--border-primary); border-radius: 0.75rem; padding: 1.5rem; margin-bottom: 2rem;">
    <div style="display: flex; gap: 1rem;">
      <div style="width: 3rem; height: 3rem; background: rgba(124, 58, 237, 0.2); border-radius: 0.75rem; display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
        <i data-lucide="info" class="canvas-icon-md canvas-icon-purple"></i>
      </div>
      <div>
        <h5 style="color: var(--text-primary); font-weight: 600; margin-bottom: 0.5rem;">Email Template Editor</h5>
        <ul style="color: var(--text-muted); margin: 0; padding-left: 1.5rem; font-size: 0.875rem;">
          <li>Edit the subject line and email content below</li>
          <li>Use <strong>{{first_name}}</strong>, <strong>{{last_name}}</strong>, <strong>{{email}}</strong> for personalization</li>
          <li>Click "Improve with AI" to enhance your content</li>
          <li>Send a test email to preview before using in campaigns</li>
        </ul>
      </div>
    </div>
  </div>

  <!-- Email Template Form -->
  <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 2rem;">
    <!-- Left Column: Editor -->
    <div>
      <div class="canvas-card" style="overflow: hidden;">
        <div style="padding: 1.5rem;">
          <!-- Subject Line -->
          <div style="margin-bottom: 1.5rem;">
            <label for="templateSubject" style="color: var(--text-primary); font-weight: 600; display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.5rem;">
              <i data-lucide="heading" style="width: 1rem; height: 1rem;"></i>
              Subject Line
            </label>
            <input type="text"
                   id="templateSubject"
                   value="<%= email_template.subject %>"
                   placeholder="Enter email subject..."
                   aria-label="Email subject line"
                   class="canvas-input" style="width: 100%; padding: 0.75rem; font-size: 0.875rem;">
          </div>

          <!-- Email Body -->
          <div style="margin-bottom: 1.5rem;">
            <label style="color: var(--text-primary); font-weight: 600; display: flex; align-items: center; justify-content: space-between; gap: 1rem; margin-bottom: 0.75rem;">
              <span style="display: flex; align-items: center; gap: 0.5rem;">
                <i data-lucide="file-text" style="width: 1rem; height: 1rem;"></i>
                Email Content
              </span>
              <div style="display: flex; gap: 0.25rem;">
                <button type="button" id="wysiwygMode" onclick="switchToWysiwyg()" aria-label="Visual editor mode" class="canvas-btn primary" style="font-size: 0.875rem;">
                  <i data-lucide="eye" class="canvas-icon-sm"></i>
                  Visual
                </button>
                <button type="button" id="htmlMode" onclick="switchToHtml()" aria-label="HTML editor mode" class="canvas-btn secondary" style="font-size: 0.875rem;">
                  <i data-lucide="code" class="canvas-icon-sm"></i>
                  HTML
                </button>
              </div>
            </label>

            <!-- WYSIWYG Editor -->
            <div id="wysiwygEditor" style="display: block;">
              <!-- Formatting Toolbar -->
              <div style="background: var(--bg-secondary); border: 1px solid var(--border-primary); border-radius: 0.375rem; padding: 0.75rem; margin-bottom: 0.5rem; display: flex; gap: 0.5rem; flex-wrap: wrap;">
                <div style="display: flex; gap: 0.25rem; border-right: 1px solid var(--border-primary); padding-right: 0.5rem;">
                  <button type="button" onclick="formatText('bold')" aria-label="Bold" class="canvas-btn secondary" style="padding: 0.375rem 0.5rem;">
                    <i data-lucide="bold" class="canvas-icon-sm"></i>
                  </button>
                  <button type="button" onclick="formatText('italic')" aria-label="Italic" class="canvas-btn secondary" style="padding: 0.375rem 0.5rem;">
                    <i data-lucide="italic" class="canvas-icon-sm"></i>
                  </button>
                  <button type="button" onclick="formatText('underline')" aria-label="Underline" class="canvas-btn secondary" style="padding: 0.375rem 0.5rem;">
                    <i data-lucide="underline" class="canvas-icon-sm"></i>
                  </button>
                </div>
                <div style="display: flex; gap: 0.25rem; border-right: 1px solid var(--border-primary); padding-right: 0.5rem;">
                  <button type="button" onclick="formatText('justifyLeft')" aria-label="Align left" class="canvas-btn secondary" style="padding: 0.375rem 0.5rem;">
                    <i data-lucide="align-left" class="canvas-icon-sm"></i>
                  </button>
                  <button type="button" onclick="formatText('justifyCenter')" aria-label="Align center" class="canvas-btn secondary" style="padding: 0.375rem 0.5rem;">
                    <i data-lucide="align-center" class="canvas-icon-sm"></i>
                  </button>
                  <button type="button" onclick="formatText('justifyRight')" aria-label="Align right" class="canvas-btn secondary" style="padding: 0.375rem 0.5rem;">
                    <i data-lucide="align-right" class="canvas-icon-sm"></i>
                  </button>
                </div>
                <div style="display: flex; gap: 0.25rem; border-right: 1px solid var(--border-primary); padding-right: 0.5rem;">
                  <button type="button" onclick="formatText('insertUnorderedList')" aria-label="Bullet list" class="canvas-btn secondary" style="padding: 0.375rem 0.5rem;">
                    <i data-lucide="list" class="canvas-icon-sm"></i>
                  </button>
                  <button type="button" onclick="formatText('insertOrderedList')" aria-label="Numbered list" class="canvas-btn secondary" style="padding: 0.375rem 0.5rem;">
                    <i data-lucide="list-ordered" class="canvas-icon-sm"></i>
                  </button>
                </div>
                <div style="display: flex; gap: 0.25rem; border-right: 1px solid var(--border-primary); padding-right: 0.5rem;">
                  <select onchange="formatText('formatBlock', this.value); this.value='';" aria-label="Select heading level" class="canvas-select" style="padding: 0.375rem; border-radius: 0.25rem; font-size: 0.875rem;">
                    <option value="">Heading...</option>
                    <option value="h1">Heading 1</option>
                    <option value="h2">Heading 2</option>
                    <option value="h3">Heading 3</option>
                    <option value="p">Normal</option>
                  </select>
                </div>
                <div style="display: flex; gap: 0.25rem;">
                  <button type="button" onclick="insertLink()" aria-label="Insert link" class="canvas-btn secondary" style="padding: 0.375rem 0.5rem;">
                    <i data-lucide="link" class="canvas-icon-sm"></i>
                  </button>
                </div>
              </div>

              <!-- Content Editable Area -->
              <div id="wysiwygContent"
                   contenteditable="true"
                   style="background: var(--bg-secondary); border: 1px solid var(--border-primary); border-radius: 0.375rem; min-height: 300px; overflow-y: auto; padding: 1rem; color: var(--text-primary); font-size: 0.875rem; line-height: 1.6;"
                   placeholder="Write your email content here..."><%= raw email_template.body %></div>
            </div>

            <!-- HTML Editor -->
            <div id="htmlEditor" style="display: none;">
              <textarea id="templateBody"
                        rows="15"
                        placeholder="Write your email HTML here..."
                        class="canvas-html-textarea" style="width: 100%; padding: 1rem; font-family: 'Courier New', monospace; font-size: 0.875rem;"><%= email_template.body %></textarea>
            </div>
          </div>

          <!-- Variable Helper -->
          <div style="background: var(--accent-glow); border: 1px solid var(--border-primary); border-radius: 0.375rem; padding: 1rem;">
            <h6 style="color: var(--text-primary); font-weight: 600; margin-bottom: 0.75rem; display: flex; align-items: center; gap: 0.5rem;">
              <i data-lucide="variable" class="canvas-icon-sm canvas-icon-purple"></i>
              Quick Insert Variables
            </h6>
            <div style="display: flex; gap: 0.5rem; flex-wrap: wrap;">
              <button type="button" onclick="insertVariable('{{first_name}}')" class="canvas-btn secondary" style="font-size: 0.875rem;">
                {{first_name}}
              </button>
              <button type="button" onclick="insertVariable('{{last_name}}')" class="canvas-btn secondary" style="font-size: 0.875rem;">
                {{last_name}}
              </button>
              <button type="button" onclick="insertVariable('{{full_name}}')" class="canvas-btn secondary" style="font-size: 0.875rem;">
                {{full_name}}
              </button>
              <button type="button" onclick="insertVariable('{{email}}')" class="canvas-btn secondary" style="font-size: 0.875rem;">
                {{email}}
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Right Column: Preview -->
    <div>
      <!-- Live Preview -->
      <div class="canvas-card" style="overflow: hidden; margin-bottom: 1.5rem;">
        <div style="background: var(--bg-secondary); border-bottom: 1px solid var(--border-primary); padding: 1rem; display: flex; align-items: center; gap: 0.5rem;">
          <i data-lucide="eye" class="canvas-icon-sm canvas-icon-cyan"></i>
          <h6 style="color: var(--text-primary); font-weight: 600; margin: 0; font-size: 0.875rem;">Live Preview</h6>
        </div>
        <div style="padding: 1.5rem;">
          <!-- Email Preview -->
          <div style="background: var(--bg-secondary); border: 1px solid var(--border-primary); border-radius: 0.375rem; padding: 1.5rem; min-height: 400px;">
            <div style="margin-bottom: 1.5rem;">
              <p style="color: var(--text-muted); margin: 0; font-size: 0.75rem;">Subject:</p>
              <div id="previewSubject" style="color: var(--text-primary); font-weight: 600;"></div>
            </div>
            <hr style="border: none; border-top: 1px solid var(--border-primary); margin: 1rem 0;">
            <div id="previewBody" style="color: var(--text-primary); line-height: 1.6; font-size: 0.875rem;"></div>
          </div>
        </div>
      </div>

      <!-- Template Info -->
      <div class="canvas-card" style="overflow: hidden;">
        <div style="background: var(--bg-secondary); border-bottom: 1px solid var(--border-primary); padding: 1rem; display: flex; align-items: center; gap: 0.5rem;">
          <i data-lucide="info" class="canvas-icon-sm canvas-icon-cyan"></i>
          <h6 style="color: var(--text-primary); font-weight: 600; margin: 0; font-size: 0.875rem;">Template Information</h6>
        </div>
        <div style="padding: 1.5rem;">
          <div style="margin-bottom: 1rem;">
            <p style="color: var(--text-muted); margin: 0; font-size: 0.75rem;">Template ID</p>
            <p style="color: var(--text-primary); margin: 0; font-weight: 500;">#<%= email_template.id %></p>
          </div>

          <div style="margin-bottom: 1rem;">
            <p style="color: var(--text-muted); margin: 0; font-size: 0.75rem;">Created</p>
            <p style="color: var(--text-primary); margin: 0; font-weight: 500;"><%= email_template.created_at.strftime('%B %d, %Y') %></p>
          </div>

          <div>
            <p style="color: var(--text-muted); margin: 0; font-size: 0.75rem;">Used in Campaigns</p>
            <% campaign_count = email_template.campaigns.count %>
            <% if campaign_count > 0 %>
              <span class="canvas-badge canvas-badge-success" style="padding: 0.25rem 0.75rem; font-size: 0.75rem; font-weight: 600; display: inline-block;">
                <%= pluralize(campaign_count, 'campaign') %>
              </span>
            <% else %>
              <span class="canvas-badge canvas-badge-muted" style="padding: 0.25rem 0.75rem; font-size: 0.75rem; font-weight: 600; display: inline-block;">
                Not used yet
              </span>
            <% end %>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  #wysiwygContent {
    font-size: 14px;
  }

  #wysiwygContent:focus {
    outline: none;
    border-color: var(--accent-purple-end);
    box-shadow: 0 0 0 0.25rem rgba(167, 139, 250, 0.25);
  }

  #wysiwygContent[contenteditable]:empty::before {
    content: attr(placeholder);
    color: var(--text-muted);
  }

  #templateBody:focus {
    outline: none;
    border-color: var(--accent-purple-end);
    box-shadow: 0 0 0 0.25rem rgba(167, 139, 250, 0.25);
  }

  #templateSubject:focus {
    outline: none;
    border-color: var(--accent-purple-end);
    box-shadow: 0 0 0 0.25rem rgba(167, 139, 250, 0.25);
  }
</style>

<script>
  // Track current editor mode
  let currentMode = 'wysiwyg';

  // Switch between editors
  function switchToWysiwyg() {
    // Get current HTML content
    const htmlContent = document.getElementById('templateBody').value;
    document.getElementById('wysiwygContent').innerHTML = htmlContent;

    // Show/hide editors
    document.getElementById('wysiwygEditor').style.display = 'block';
    document.getElementById('htmlEditor').style.display = 'none';

    // Update button states
    const purpleStart = getComputedStyle(document.documentElement).getPropertyValue('--accent-purple-start').trim() || '#7C3AED';
    const purpleEnd = getComputedStyle(document.documentElement).getPropertyValue('--accent-purple-end').trim() || '#A78BFA';
    const bgPrimary = getComputedStyle(document.documentElement).getPropertyValue('--bg-primary').trim() || '#FFFFFF';
    const cyan = getComputedStyle(document.documentElement).getPropertyValue('--accent-cyan').trim() || '#22D3EE';
    
    document.getElementById('wysiwygMode').style.background = `linear-gradient(135deg, ${purpleStart} 0%, ${purpleEnd} 100%)`;
    document.getElementById('wysiwygMode').style.color = bgPrimary;
    document.getElementById('wysiwygMode').style.border = 'none';

    document.getElementById('htmlMode').style.background = 'transparent';
    document.getElementById('htmlMode').style.color = cyan;
    document.getElementById('htmlMode').style.border = `1px solid ${cyan}`;

    currentMode = 'wysiwyg';
    updatePreview();
  }

  function switchToHtml() {
    // Get current WYSIWYG content
    const wysiwygContent = document.getElementById('wysiwygContent').innerHTML;
    document.getElementById('templateBody').value = wysiwygContent;

    // Show/hide editors
    document.getElementById('wysiwygEditor').style.display = 'none';
    document.getElementById('htmlEditor').style.display = 'block';

    // Update button states
    const purpleStart = getComputedStyle(document.documentElement).getPropertyValue('--accent-purple-start').trim() || '#7C3AED';
    const purpleEnd = getComputedStyle(document.documentElement).getPropertyValue('--accent-purple-end').trim() || '#A78BFA';
    const bgPrimary = getComputedStyle(document.documentElement).getPropertyValue('--bg-primary').trim() || '#FFFFFF';
    const cyan = getComputedStyle(document.documentElement).getPropertyValue('--accent-cyan').trim() || '#22D3EE';
    
    document.getElementById('wysiwygMode').style.background = 'transparent';
    document.getElementById('wysiwygMode').style.color = cyan;
    document.getElementById('wysiwygMode').style.border = `1px solid ${cyan}`;

    document.getElementById('htmlMode').style.background = `linear-gradient(135deg, ${purpleStart} 0%, ${purpleEnd} 100%)`;
    document.getElementById('htmlMode').style.color = bgPrimary;
    document.getElementById('htmlMode').style.border = 'none';

    currentMode = 'html';
    updatePreview();
  }

  // Format text in WYSIWYG editor
  function formatText(command, value = null) {
    document.execCommand(command, false, value);
    document.getElementById('wysiwygContent').focus();
    updatePreview();
  }

  // Insert link
  function insertLink() {
    const url = prompt('Enter URL:', 'https://');
    if (url) {
      formatText('createLink', url);
    }
  }

  // Initialize preview
  function updatePreview() {
    const subject = document.getElementById('templateSubject').value;
    const body = currentMode === 'wysiwyg'
      ? document.getElementById('wysiwygContent').innerHTML
      : document.getElementById('templateBody').value;

    // Update preview with sample data
    const previewData = {
      '{{first_name}}': 'John',
      '{{last_name}}': 'Doe',
      '{{full_name}}': 'John Doe',
      '{{email}}': 'john.doe@example.com'
    };

    let previewSubject = subject;
    let previewBody = body;

    // Replace variables with sample data
    Object.keys(previewData).forEach(key => {
      const regex = new RegExp(key.replace(/[.*+?^${}()|[\]\\]/g, '\\$&'), 'g');
      previewSubject = previewSubject.replace(regex, previewData[key]);
      previewBody = previewBody.replace(regex, previewData[key]);
    });

    // Simple HTML sanitization - allow only basic formatting tags
    const allowedTags = ['p', 'br', 'strong', 'b', 'em', 'i', 'u', 'a', 'ul', 'ol', 'li', 'h1', 'h2', 'h3', 'h4', 'h5', 'h6', 'div', 'span'];
    const tempDiv = document.createElement('div');
    tempDiv.innerHTML = previewBody;

    // Remove any script tags and dangerous attributes
    const scripts = tempDiv.querySelectorAll('script, style');
    scripts.forEach(el => el.remove());

    // Remove dangerous attributes
    const allElements = tempDiv.querySelectorAll('*');
    allElements.forEach(el => {
      // Remove all attributes except href for links
      Array.from(el.attributes).forEach(attr => {
        if (attr.name !== 'href' || el.tagName !== 'A') {
          el.removeAttribute(attr.name);
        }
      });
    });

    document.getElementById('previewSubject').textContent = previewSubject || '(No subject)';
    document.getElementById('previewBody').innerHTML = tempDiv.innerHTML || '(No content)';
  }

  // Insert variable at cursor position
  function insertVariable(variable) {
    if (currentMode === 'wysiwyg') {
      // Insert into contenteditable
      document.getElementById('wysiwygContent').focus();
      document.execCommand('insertText', false, variable);
    } else {
      // Insert into textarea
      const textarea = document.getElementById('templateBody');
      const start = textarea.selectionStart;
      const end = textarea.selectionEnd;
      const text = textarea.value;

      textarea.value = text.substring(0, start) + variable + text.substring(end);
      textarea.selectionStart = textarea.selectionEnd = start + variable.length;
      textarea.focus();
    }

    updatePreview();
  }

  // Save template changes
  function saveTemplateChanges() {
    const templateId = <%= email_template.id %>;
    const subject = document.getElementById('templateSubject').value;
    const body = currentMode === 'wysiwyg'
      ? document.getElementById('wysiwygContent').innerHTML
      : document.getElementById('templateBody').value;

    if (!subject.trim()) {
      showWarning('Please enter a subject line');
      return;
    }

    if (!body.trim()) {
      showWarning('Please enter email content');
      return;
    }

    // Show loading state
    const saveBtn = document.getElementById('saveTemplateChanges');
    const originalText = saveBtn.innerHTML;
    saveBtn.innerHTML = '<i data-lucide="loader-circle" class="icon-spin me-1" aria-hidden="true"></i> Saving...';
    saveBtn.disabled = true;

    // Re-initialize Lucide for the new icon
    if (typeof lucide !== 'undefined') {
      lucide.createIcons();
    }

    // Make API call to save
    fetch(`/email_templates/${templateId}`, {
      method: 'PATCH',
      headers: {
        'Content-Type': 'application/json',
        'Accept': 'application/json',
        'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]')?.content ||
                        parent.document.querySelector('meta[name="csrf-token"]')?.content ||
                        '<%= form_authenticity_token %>'
      },
      body: JSON.stringify({
        email_template: {
          subject: subject,
          body: body
        }
      })
    })
    .then(response => {
      if (!response.ok && response.status !== 302) {
        throw new Error(`HTTP error! status: ${response.status}`);
      }
      // If we get a redirect (302), consider it a success since the template was saved
      if (response.status === 302 || response.redirected) {
        return { success: true };
      }
      return response.json();
    })
    .then(data => {
      // Show success message
      // Show inline success notification instead of chat message
      const notice = document.createElement('div');
      notice.className = 'alert alert-success alert-dismissible fade show';
      notice.style.cssText = 'position:fixed;top:1rem;right:1rem;z-index:9999;min-width:250px;';
      notice.innerHTML = '<strong>Saved!</strong> Email template saved successfully. <button type="button" class="btn-close" data-bs-dismiss="alert"></button>';
      document.body.appendChild(notice);
      setTimeout(() => notice.remove(), 3000);

      // If in HTML mode, sync the content back to WYSIWYG
      if (currentMode === 'html') {
        document.getElementById('wysiwygContent').innerHTML = body;
      }
    })
    .catch(error => {
      showError('Error saving template: ' + error.message);
    })
    .finally(() => {
      // Restore button state
      saveBtn.innerHTML = originalText;
      saveBtn.disabled = false;
    });
  }

  // Send test email
  function sendTestEmail() {
    const templateId = <%= email_template.id %>;
    const email = prompt('Enter email address to send test to:', '<%= current_user.email %>');

    if (!email) return;

    // Direct API call to send test email
    fetch(`/api/v1/campaigns`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]')?.content },
      body: JSON.stringify({ email_template_id: templateId, test_email: email, send_test: true })
    }).then(r => r.json()).then(d => {
      alert(d.success ? 'Test email sent!' : (d.message || 'Failed to send test'));
    }).catch(e => alert('Error: ' + e.message));
  }

  // Add event listeners
  document.getElementById('templateSubject').addEventListener('input', updatePreview);
  document.getElementById('templateBody').addEventListener('input', updatePreview);
  document.getElementById('wysiwygContent').addEventListener('input', updatePreview);

  // Sync content when switching tabs (in case user made changes)
  document.getElementById('wysiwygContent').addEventListener('blur', function() {
    if (currentMode === 'wysiwyg') {
      document.getElementById('templateBody').value = this.innerHTML;
    }
  });

  // Initial preview
  updatePreview();

  // Lucide icon initialization
  document.addEventListener('turbo:load', () => {
    if (typeof lucide !== 'undefined') {
      lucide.createIcons();
    }
  });

  document.addEventListener('DOMContentLoaded', () => {
    if (typeof lucide !== 'undefined') {
      lucide.createIcons();
    }
  });
</script>
