<div class="email-template-editor" data-template-id="<%= email_template.id %>">
  <!-- Header with template info and actions -->
  <div class="card shadow-sm mb-3">
    <div class="card-header bg-white d-flex justify-content-between align-items-center">
      <div>
        <h5 class="mb-0">
          <i data-lucide="mail" class="text-primary me-2" aria-hidden="true"></i>
          <%= email_template.name %>
        </h5>
        <small class="text-muted">
          Last updated <%= time_ago_in_words(email_template.updated_at) %> ago
        </small>
      </div>
      <div class="d-flex gap-2">
        <button class="btn btn-success btn-sm" id="saveTemplateChanges" onclick="saveTemplateChanges()" aria-label="Save template changes">
          <i data-lucide="save" class="me-1" aria-hidden="true"></i> Save Changes
        </button>
        <button class="btn btn-primary btn-sm" onclick="sendTestEmail()" aria-label="Send test email">
          <i data-lucide="send" class="me-1" aria-hidden="true"></i> Send Test
        </button>
        <button class="btn btn-warning btn-sm" onclick="window.scoutSendMessage?.('Improve this email template to be more engaging and professional')" aria-label="Improve template with AI">
          <i data-lucide="wand-2" class="me-1" aria-hidden="true"></i> Improve with AI
        </button>
        <button class="btn btn-outline-secondary btn-sm" onclick="window.scoutLoadCanvas?.('email_template_viewer', {})" aria-label="Back to template list">
          <i data-lucide="arrow-left" class="me-1" aria-hidden="true"></i> Back to List
        </button>
      </div>
    </div>
  </div>

  <!-- Instructions -->
  <div class="alert alert-info alert-dismissible fade show" role="alert" style="background-color: #d1ecf1; border-color: #bee5eb; color: #0c5460;">
    <strong><i data-lucide="info" class="me-2" aria-hidden="true"></i>Email Template Editor</strong>
    <ul class="mb-0 mt-2 small" style="color: #0c5460;">
      <li>Edit the subject line and email content below</li>
      <li>Use <strong>{{first_name}}</strong>, <strong>{{last_name}}</strong>, <strong>{{email}}</strong> for personalization</li>
      <li>Click "Improve with AI" to enhance your content</li>
      <li>Send a test email to preview before using in campaigns</li>
    </ul>
    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
  </div>

  <!-- Email Template Form -->
  <div class="row">
    <!-- Left Column: Editor -->
    <div class="col-lg-7">
      <div class="card shadow">
        <div class="card-body">
          <!-- Subject Line -->
          <div class="mb-3">
            <label for="templateSubject" class="form-label fw-bold">
              <i data-lucide="heading" class="me-1" aria-hidden="true"></i> Subject Line
            </label>
            <input type="text"
                   class="form-control"
                   id="templateSubject"
                   value="<%= email_template.subject %>"
                   placeholder="Enter email subject..."
                   aria-label="Email subject line">
          </div>

          <!-- Email Body -->
          <div class="mb-3">
            <label for="templateBody" class="form-label fw-bold d-flex justify-content-between align-items-center">
              <span><i data-lucide="file-text" class="me-1" aria-hidden="true"></i> Email Content</span>
              <div class="btn-group btn-group-sm" role="group" aria-label="Editor mode">
                <button type="button" class="btn btn-outline-secondary active" id="wysiwygMode" onclick="switchToWysiwyg()" aria-label="Visual editor mode">
                  <i data-lucide="eye" aria-hidden="true"></i> Visual
                </button>
                <button type="button" class="btn btn-outline-secondary" id="htmlMode" onclick="switchToHtml()" aria-label="HTML editor mode">
                  <i data-lucide="code" aria-hidden="true"></i> HTML
                </button>
              </div>
            </label>
            
            <!-- WYSIWYG Editor -->
            <div id="wysiwygEditor" style="display: block;">
              <!-- Formatting Toolbar -->
              <div class="btn-toolbar mb-2" role="toolbar" aria-label="Text formatting toolbar">
                <div class="btn-group btn-group-sm me-2" role="group" aria-label="Text style">
                  <button type="button" class="btn btn-outline-secondary" onclick="formatText('bold')" aria-label="Bold">
                    <i data-lucide="bold" aria-hidden="true"></i>
                  </button>
                  <button type="button" class="btn btn-outline-secondary" onclick="formatText('italic')" aria-label="Italic">
                    <i data-lucide="italic" aria-hidden="true"></i>
                  </button>
                  <button type="button" class="btn btn-outline-secondary" onclick="formatText('underline')" aria-label="Underline">
                    <i data-lucide="underline" aria-hidden="true"></i>
                  </button>
                </div>
                <div class="btn-group btn-group-sm me-2" role="group" aria-label="Text alignment">
                  <button type="button" class="btn btn-outline-secondary" onclick="formatText('justifyLeft')" aria-label="Align left">
                    <i data-lucide="align-left" aria-hidden="true"></i>
                  </button>
                  <button type="button" class="btn btn-outline-secondary" onclick="formatText('justifyCenter')" aria-label="Align center">
                    <i data-lucide="align-center" aria-hidden="true"></i>
                  </button>
                  <button type="button" class="btn btn-outline-secondary" onclick="formatText('justifyRight')" aria-label="Align right">
                    <i data-lucide="align-right" aria-hidden="true"></i>
                  </button>
                </div>
                <div class="btn-group btn-group-sm me-2" role="group" aria-label="Lists">
                  <button type="button" class="btn btn-outline-secondary" onclick="formatText('insertUnorderedList')" aria-label="Bullet list">
                    <i data-lucide="list" aria-hidden="true"></i>
                  </button>
                  <button type="button" class="btn btn-outline-secondary" onclick="formatText('insertOrderedList')" aria-label="Numbered list">
                    <i data-lucide="list-ordered" aria-hidden="true"></i>
                  </button>
                </div>
                <div class="btn-group btn-group-sm me-2" role="group">
                  <select class="form-select form-select-sm" onchange="formatText('formatBlock', this.value); this.value='';" aria-label="Select heading level">
                    <option value="">Heading...</option>
                    <option value="h1">Heading 1</option>
                    <option value="h2">Heading 2</option>
                    <option value="h3">Heading 3</option>
                    <option value="p">Normal</option>
                  </select>
                </div>
                <div class="btn-group btn-group-sm" role="group">
                  <button type="button" class="btn btn-outline-secondary" onclick="insertLink()" aria-label="Insert link">
                    <i data-lucide="link" aria-hidden="true"></i>
                  </button>
                </div>
              </div>
              
              <!-- Content Editable Area -->
              <div id="wysiwygContent" 
                   contenteditable="true" 
                   class="form-control" 
                   style="min-height: 300px; overflow-y: auto;"
                   placeholder="Write your email content here..."><%= raw email_template.body %></div>
            </div>
            
            <!-- HTML Editor -->
            <div id="htmlEditor" style="display: none;">
              <textarea class="form-control" 
                        id="templateBody" 
                        rows="15"
                        placeholder="Write your email HTML here..."><%= email_template.body %></textarea>
            </div>
          </div>

          <!-- Variable Helper -->
          <div class="alert alert-light" style="background-color: #f8f9fa; border-color: #dee2e6; color: #212529;">
            <strong>Quick Insert Variables:</strong>
            <div class="btn-group btn-group-sm mt-2" role="group">
              <button type="button" class="btn btn-outline-primary" onclick="insertVariable('{{first_name}}')">
                {{first_name}}
              </button>
              <button type="button" class="btn btn-outline-primary" onclick="insertVariable('{{last_name}}')">
                {{last_name}}
              </button>
              <button type="button" class="btn btn-outline-primary" onclick="insertVariable('{{full_name}}')">
                {{full_name}}
              </button>
              <button type="button" class="btn btn-outline-primary" onclick="insertVariable('{{email}}')">
                {{email}}
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Right Column: Preview -->
    <div class="col-lg-5">
      <div class="card shadow">
        <div class="card-header bg-light">
          <h6 class="mb-0">
            <i data-lucide="eye" class="me-1" aria-hidden="true"></i> Live Preview
          </h6>
        </div>
        <div class="card-body">
          <!-- Email Preview -->
          <div class="email-preview">
            <div class="mb-3">
              <small class="text-muted" style="color: #6c757d !important;">Subject:</small>
              <div class="fw-bold" id="previewSubject" style="color: #212529;"></div>
            </div>
            <hr>
            <div id="previewBody" style="line-height: 1.6; color: #212529;"></div>
          </div>
        </div>
      </div>

      <!-- Template Info -->
      <div class="card shadow mt-3">
        <div class="card-header bg-light">
          <h6 class="mb-0">
            <i data-lucide="info" class="me-1" aria-hidden="true"></i> Template Information
          </h6>
        </div>
        <div class="card-body">
          <dl class="row mb-0">
            <dt class="col-sm-5">Template ID:</dt>
            <dd class="col-sm-7">#<%= email_template.id %></dd>
            
            <dt class="col-sm-5">Created:</dt>
            <dd class="col-sm-7"><%= email_template.created_at.strftime('%B %d, %Y') %></dd>
            
            <dt class="col-sm-5">Used in Campaigns:</dt>
            <dd class="col-sm-7">
              <% campaign_count = email_template.campaigns.count %>
              <% if campaign_count > 0 %>
                <span class="badge bg-success"><%= campaign_count %> campaigns</span>
              <% else %>
                <span class="badge bg-secondary">Not used yet</span>
              <% end %>
            </dd>
          </dl>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .email-preview {
    background: #f8f9fa;
    border: 1px solid #dee2e6;
    border-radius: 0.375rem;
    padding: 1.5rem;
    min-height: 400px;
    color: #212529;
  }
  
  #templateBody {
    font-family: 'Courier New', monospace;
    font-size: 14px;
  }
  
  #wysiwygContent {
    font-size: 14px;
  }
  
  #wysiwygContent:focus {
    outline: none;
    border-color: #86b7fe;
    box-shadow: 0 0 0 0.25rem rgba(13, 110, 253, 0.25);
  }
  
  #wysiwygContent[contenteditable]:empty::before {
    content: attr(placeholder);
    color: #6c757d;
  }
</style>

<script>
  // Track current editor mode
  let currentMode = 'wysiwyg';
  
  // Switch between editors
  function switchToWysiwyg() {
    // Get current HTML content
    const htmlContent = document.getElementById('templateBody').value;
    document.getElementById('wysiwygContent').innerHTML = htmlContent;
    
    // Show/hide editors
    document.getElementById('wysiwygEditor').style.display = 'block';
    document.getElementById('htmlEditor').style.display = 'none';
    
    // Update button states
    document.getElementById('wysiwygMode').classList.add('active');
    document.getElementById('htmlMode').classList.remove('active');
    
    currentMode = 'wysiwyg';
    updatePreview();
  }
  
  function switchToHtml() {
    // Get current WYSIWYG content
    const wysiwygContent = document.getElementById('wysiwygContent').innerHTML;
    document.getElementById('templateBody').value = wysiwygContent;
    
    // Show/hide editors
    document.getElementById('wysiwygEditor').style.display = 'none';
    document.getElementById('htmlEditor').style.display = 'block';
    
    // Update button states
    document.getElementById('wysiwygMode').classList.remove('active');
    document.getElementById('htmlMode').classList.add('active');
    
    currentMode = 'html';
    updatePreview();
  }
  
  // Format text in WYSIWYG editor
  function formatText(command, value = null) {
    document.execCommand(command, false, value);
    document.getElementById('wysiwygContent').focus();
    updatePreview();
  }
  
  // Insert link
  function insertLink() {
    const url = prompt('Enter URL:', 'https://');
    if (url) {
      formatText('createLink', url);
    }
  }
  
  // Initialize preview
  function updatePreview() {
    const subject = document.getElementById('templateSubject').value;
    const body = currentMode === 'wysiwyg' 
      ? document.getElementById('wysiwygContent').innerHTML 
      : document.getElementById('templateBody').value;
    
    // Update preview with sample data
    const previewData = {
      '{{first_name}}': 'John',
      '{{last_name}}': 'Doe',
      '{{full_name}}': 'John Doe',
      '{{email}}': 'john.doe@example.com'
    };
    
    let previewSubject = subject;
    let previewBody = body;
    
    // Replace variables with sample data
    Object.keys(previewData).forEach(key => {
      const regex = new RegExp(key.replace(/[.*+?^${}()|[\]\\]/g, '\\$&'), 'g');
      previewSubject = previewSubject.replace(regex, previewData[key]);
      previewBody = previewBody.replace(regex, previewData[key]);
    });
    
    // Simple HTML sanitization - allow only basic formatting tags
    const allowedTags = ['p', 'br', 'strong', 'b', 'em', 'i', 'u', 'a', 'ul', 'ol', 'li', 'h1', 'h2', 'h3', 'h4', 'h5', 'h6', 'div', 'span'];
    const tempDiv = document.createElement('div');
    tempDiv.innerHTML = previewBody;
    
    // Remove any script tags and dangerous attributes
    const scripts = tempDiv.querySelectorAll('script, style');
    scripts.forEach(el => el.remove());
    
    // Remove dangerous attributes
    const allElements = tempDiv.querySelectorAll('*');
    allElements.forEach(el => {
      // Remove all attributes except href for links
      Array.from(el.attributes).forEach(attr => {
        if (attr.name !== 'href' || el.tagName !== 'A') {
          el.removeAttribute(attr.name);
        }
      });
    });
    
    document.getElementById('previewSubject').textContent = previewSubject || '(No subject)';
    document.getElementById('previewBody').innerHTML = tempDiv.innerHTML || '(No content)';
  }
  
  // Insert variable at cursor position
  function insertVariable(variable) {
    if (currentMode === 'wysiwyg') {
      // Insert into contenteditable
      document.getElementById('wysiwygContent').focus();
      document.execCommand('insertText', false, variable);
    } else {
      // Insert into textarea
      const textarea = document.getElementById('templateBody');
      const start = textarea.selectionStart;
      const end = textarea.selectionEnd;
      const text = textarea.value;
      
      textarea.value = text.substring(0, start) + variable + text.substring(end);
      textarea.selectionStart = textarea.selectionEnd = start + variable.length;
      textarea.focus();
    }
    
    updatePreview();
  }
  
  // Save template changes
  function saveTemplateChanges() {
    const templateId = <%= email_template.id %>;
    const subject = document.getElementById('templateSubject').value;
    const body = currentMode === 'wysiwyg' 
      ? document.getElementById('wysiwygContent').innerHTML 
      : document.getElementById('templateBody').value;
    
    if (!subject.trim()) {
      alert('Please enter a subject line');
      return;
    }
    
    if (!body.trim()) {
      alert('Please enter email content');
      return;
    }
    
    // Show loading state
    const saveBtn = document.getElementById('saveTemplateChanges');
    const originalText = saveBtn.innerHTML;
    saveBtn.innerHTML = '<i data-lucide="loader-circle" class="icon-spin me-1" aria-hidden="true"></i> Saving...';
    saveBtn.disabled = true;

    // Re-initialize Lucide for the new icon
    if (typeof lucide !== 'undefined') {
      lucide.createIcons();
    }
    
    // Make API call to save
    fetch(`/email_templates/${templateId}`, {
      method: 'PATCH',
      headers: {
        'Content-Type': 'application/json',
        'Accept': 'application/json',
        'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]')?.content || 
                        parent.document.querySelector('meta[name="csrf-token"]')?.content ||
                        '<%= form_authenticity_token %>'
      },
      body: JSON.stringify({
        email_template: {
          subject: subject,
          body: body
        }
      })
    })
    .then(response => {
      if (!response.ok && response.status !== 302) {
        throw new Error(`HTTP error! status: ${response.status}`);
      }
      // If we get a redirect (302), consider it a success since the template was saved
      if (response.status === 302 || response.redirected) {
        return { success: true };
      }
      return response.json();
    })
    .then(data => {
      // Show success message
      window.scoutSendMessage?.('✅ Email template saved successfully!');
      
      // If in HTML mode, sync the content back to WYSIWYG
      if (currentMode === 'html') {
        document.getElementById('wysiwygContent').innerHTML = body;
      }
    })
    .catch(error => {
      alert('Error saving template: ' + error.message);
    })
    .finally(() => {
      // Restore button state
      saveBtn.innerHTML = originalText;
      saveBtn.disabled = false;
    });
  }
  
  // Send test email
  function sendTestEmail() {
    const templateId = <%= email_template.id %>;
    const email = prompt('Enter email address to send test to:', '<%= current_user.email %>');
    
    if (!email) return;
    
    window.scoutSendMessage?.(`Send a test email for template ${templateId} to ${email}`);
  }
  
  // Add event listeners
  document.getElementById('templateSubject').addEventListener('input', updatePreview);
  document.getElementById('templateBody').addEventListener('input', updatePreview);
  document.getElementById('wysiwygContent').addEventListener('input', updatePreview);
  
  // Sync content when switching tabs (in case user made changes)
  document.getElementById('wysiwygContent').addEventListener('blur', function() {
    if (currentMode === 'wysiwyg') {
      document.getElementById('templateBody').value = this.innerHTML;
    }
  });
  
  // Initial preview
  updatePreview();
</script>
