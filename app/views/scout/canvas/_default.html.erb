<div class="scout-canvas default-canvas">
  <!-- Hero Section -->
  <div class="canvas-hero">
    <div class="canvas-hero-icon">
      <i data-lucide="bot" aria-hidden="true"></i>
    </div>
    <h2 class="canvas-hero-title">Welcome to Amos AI</h2>
    <p class="canvas-hero-subtitle">
      Your AI business automation assistant. I can help you manage operations, analyze data, create content,<br>
      handle integrations, and automate workflows across your entire business.
    </p>
  </div>

  <!-- Quick Actions Grid -->
  <div class="canvas-content">
    <h3 class="canvas-section-title">What would you like to do today?</h3>

    <div class="canvas-grid">
      <!-- Landing Pages -->
      <div class="canvas-action-card" onclick="scoutQuickAction('landing_pages')" role="button" aria-label="View landing pages">
        <div class="canvas-card-icon icon-gradient">
          <i data-lucide="globe" aria-hidden="true"></i>
        </div>
        <div class="canvas-card-content">
          <h6 class="canvas-card-title">Landing Pages</h6>
          <p class="canvas-card-description">Create and manage marketing pages</p>
        </div>
        <i data-lucide="chevron-right" class="canvas-card-chevron" aria-hidden="true"></i>
      </div>

      <!-- Create Landing Page -->
      <div class="canvas-action-card" onclick="scoutCreateLandingPage()" role="button" aria-label="Create new landing page">
        <div class="canvas-card-icon icon-success">
          <i data-lucide="circle-plus" aria-hidden="true"></i>
        </div>
        <div class="canvas-card-content">
          <h6 class="canvas-card-title">Create Landing Page</h6>
          <p class="canvas-card-description">Build a new marketing page with AI</p>
        </div>
        <i data-lucide="chevron-right" class="canvas-card-chevron" aria-hidden="true"></i>
      </div>

      <!-- Contacts -->
      <div class="canvas-action-card" onclick="scoutQuickAction('contacts')" role="button" aria-label="View contacts">
        <div class="canvas-card-icon icon-info">
          <i data-lucide="users" aria-hidden="true"></i>
        </div>
        <div class="canvas-card-content">
          <h6 class="canvas-card-title">Contacts</h6>
          <p class="canvas-card-description">Manage your customer database</p>
        </div>
        <i data-lucide="chevron-right" class="canvas-card-chevron" aria-hidden="true"></i>
      </div>

      <!-- Integrations -->
      <div class="canvas-action-card" onclick="scoutQuickAction('integrations')" role="button" aria-label="View integrations">
        <div class="canvas-card-icon icon-warning">
          <i data-lucide="plug" aria-hidden="true"></i>
        </div>
        <div class="canvas-card-content">
          <h6 class="canvas-card-title">Integrations</h6>
          <p class="canvas-card-description">Connect external apps & data</p>
        </div>
        <i data-lucide="chevron-right" class="canvas-card-chevron" aria-hidden="true"></i>
      </div>

      <!-- Data Analysis -->
      <div class="canvas-action-card" onclick="sendScoutMessage('Analyze my business data')" role="button" aria-label="Analyze business data">
        <div class="canvas-card-icon icon-gradient">
          <i data-lucide="trending-up" aria-hidden="true"></i>
        </div>
        <div class="canvas-card-content">
          <h6 class="canvas-card-title">Data Analysis</h6>
          <p class="canvas-card-description">Get insights from your data</p>
        </div>
        <i data-lucide="chevron-right" class="canvas-card-chevron" aria-hidden="true"></i>
      </div>

      <!-- Campaigns -->
      <div class="canvas-action-card" onclick="scoutQuickAction('campaigns')" role="button" aria-label="View campaigns">
        <div class="canvas-card-icon icon-danger">
          <i data-lucide="megaphone" aria-hidden="true"></i>
        </div>
        <div class="canvas-card-content">
          <h6 class="canvas-card-title">Campaigns</h6>
          <p class="canvas-card-description">Email marketing campaigns</p>
        </div>
        <i data-lucide="chevron-right" class="canvas-card-chevron" aria-hidden="true"></i>
      </div>
    </div>

    <!-- Example Prompts -->
    <div class="canvas-prompts">
      <h6 class="canvas-prompts-title">Or try asking me something like:</h6>
      <div class="canvas-prompts-grid">
        <div class="canvas-prompt" onclick="sendScoutMessage(this.textContent)">
          "Show me my Stripe revenue for this month"
        </div>
        <div class="canvas-prompt" onclick="sendScoutMessage(this.textContent)">
          "Create a landing page for my new product"
        </div>
        <div class="canvas-prompt" onclick="sendScoutMessage(this.textContent)">
          "Analyze my top performing campaigns"
        </div>
        <div class="canvas-prompt" onclick="sendScoutMessage(this.textContent)">
          "Help me segment my contact list"
        </div>
      </div>
    </div>

    <!-- Entity Info -->
    <div class="canvas-info-box">
      <p class="canvas-info-label">Current Workspace</p>
      <div class="canvas-info-content">
        <div class="canvas-info-avatar">
          <%= entity.name.first.upcase %>
        </div>
        <span class="canvas-info-name"><%= entity.name %></span>
      </div>
    </div>
  </div>
</div>

<script>
function scoutQuickAction(action) {
  switch(action) {
    case 'landing_pages':
      window.scoutLoadCanvas?.('landing_page_viewer');
      break;
    case 'contacts':
      window.scoutLoadCanvas?.('contact_viewer');
      break;
    case 'campaigns':
      window.scoutLoadCanvas?.('campaign_viewer');
      break;
    case 'integrations':
      window.scoutController?.sendScoutMessage('Show me my integrations');
      break;
  }
}

function scoutCreateLandingPage() {
  window.scoutController?.sendScoutMessage('Create a new landing page');
}

function sendScoutMessage(message) {
  window.scoutController?.sendScoutMessage(message);
}

document.addEventListener('turbo:load', () => {
  if (typeof lucide !== 'undefined') {
    lucide.createIcons();
  }
});

document.addEventListener('DOMContentLoaded', () => {
  if (typeof lucide !== 'undefined') {
    lucide.createIcons();
  }
});
</script>
