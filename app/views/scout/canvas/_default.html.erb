<% 
  # Gather stats for the dashboard
  # agent_count removed - agents now abstracted as loadouts
  tool_count = ToolDefinition.where(entity_id: entity.id).or(ToolDefinition.where(created_by_id: user.id)).distinct.count rescue 0
  integration_count = entity.connections.count rescue 0
  scheduled_task_count = ScheduledAgentTask.where(entity: entity).count rescue 0
  app_count = entity.app_modules.active.count rescue 0
  landing_page_count = entity.landing_pages.count rescue 0
  contact_count = entity.contacts.count rescue 0
  
  # Check if user is new (completed onboarding in last 24 hours or has very little activity)
  is_new_user = user.updated_at > 24.hours.ago && (landing_page_count + contact_count + app_count) < 3
  
  # Get usage type preference
  usage_type = user.space_preference&.active_space || 'work'
  is_personal = usage_type == 'personal'
  
  # Get time of day for greeting (use user's timezone setting, default to Central/Texas)
  user_timezone = (user.timezone.presence if user.respond_to?(:timezone)) || 'America/Chicago'
  local_time = Time.current.in_time_zone(user_timezone)
  hour = local_time.hour
  greeting = if hour < 12
    "Good morning"
  elsif hour < 17
    "Good afternoon"
  else
    "Good evening"
  end
  
  # Analytics data - AI usage stats
  messages_today = ScoutMessage.where(user: user).where('created_at >= ?', Time.current.beginning_of_day).count rescue 0
  messages_this_week = ScoutMessage.where(user: user).where('created_at >= ?', 7.days.ago).count rescue 0
  messages_last_week = ScoutMessage.where(user: user).where(created_at: 14.days.ago..7.days.ago).count rescue 0
  
  # Calculate trend (% change from last week)
  message_trend = messages_last_week > 0 ? ((messages_this_week - messages_last_week).to_f / messages_last_week * 100).round : 0
  
  # Activity stats (if applicable)
  activity_stats = Activity.activity_stats(entity, period: 7.days) rescue { total: 0, open_tasks: 0, completed_today: 0, by_performer: { ai: 0, human: 0 } }
  open_tasks = activity_stats[:open_tasks] || 0
  completed_today = activity_stats[:completed_today] || 0
  ai_actions = activity_stats[:by_performer][:ai] || 0
  
  # Recent activities for feed
  recent_activities = Activity.where(entity: entity).recent.limit(5) rescue []
  
  # Work items requiring attention
  pending_work_items = AgentWorkItem.where(entity: entity, user: user).pending.count rescue 0
%>

