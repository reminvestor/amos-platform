<div class="scout-canvas default-canvas">
  <div class="canvas-header text-center mb-5">
    <div class="canvas-hero">
      <div class="hero-icon mb-3">
        <i data-lucide="bot" class="text-primary icon-4x" aria-hidden="true"></i>
      </div>
      <h4 class="mb-2">Welcome to Amos AI</h4>
      <p class="text-muted mb-4">
        Your AI business automation assistant. I can help you manage operations, analyze data, create content,<br>
        handle integrations, and automate workflows across your entire business.
      </p>
    </div>
  </div>
  
  <!-- Quick Actions Grid -->
  <div class="row mb-5">
    <div class="col-lg-10 mx-auto">
      <h5 class="text-center mb-4">What would you like to do today?</h5>
      <div class="row g-3">
        
        <!-- Landing Pages -->
        <div class="col-md-6 col-lg-4 mb-3">
          <div class="action-card h-100" onclick="scoutQuickAction('landing_pages')" role="button" aria-label="View landing pages">
            <div class="action-icon">
              <i data-lucide="globe" class="text-primary" aria-hidden="true"></i>
            </div>
            <div class="action-content">
              <h6 class="mb-1">Landing Pages</h6>
              <p class="text-muted small mb-0">Create and manage marketing pages</p>
            </div>
            <div class="action-arrow">
              <i data-lucide="chevron-right" aria-hidden="true"></i>
            </div>
          </div>
        </div>

        <!-- Create Landing Page -->
        <div class="col-md-6 col-lg-4 mb-3">
          <div class="action-card h-100" onclick="scoutCreateLandingPage()" role="button" aria-label="Create new landing page">
            <div class="action-icon">
              <i data-lucide="circle-plus" class="text-success" aria-hidden="true"></i>
            </div>
            <div class="action-content">
              <h6 class="mb-1">Create Landing Page</h6>
              <p class="text-muted small mb-0">Build a new marketing page with AI</p>
            </div>
            <div class="action-arrow">
              <i data-lucide="chevron-right" aria-hidden="true"></i>
            </div>
          </div>
        </div>

        <!-- Contacts -->
        <div class="col-md-6 col-lg-4 mb-3">
          <div class="action-card h-100" onclick="scoutQuickAction('contacts')" role="button" aria-label="View contacts">
            <div class="action-icon">
              <i data-lucide="users" class="text-info" aria-hidden="true"></i>
            </div>
            <div class="action-content">
              <h6 class="mb-1">Contacts</h6>
              <p class="text-muted small mb-0">Manage your customer database</p>
            </div>
            <div class="action-arrow">
              <i data-lucide="chevron-right" aria-hidden="true"></i>
            </div>
          </div>
        </div>

        <!-- Integrations -->
        <div class="col-md-6 col-lg-4 mb-3">
          <div class="action-card h-100" onclick="scoutQuickAction('integrations')" role="button" aria-label="View integrations">
            <div class="action-icon">
              <i data-lucide="plug" class="text-warning" aria-hidden="true"></i>
            </div>
            <div class="action-content">
              <h6 class="mb-1">Integrations</h6>
              <p class="text-muted small mb-0">Connect external apps & data</p>
            </div>
            <div class="action-arrow">
              <i data-lucide="chevron-right" aria-hidden="true"></i>
            </div>
          </div>
        </div>

        <!-- Data Analysis -->
        <div class="col-md-6 col-lg-4 mb-3">
          <div class="action-card h-100" onclick="sendScoutMessage('Analyze my business data')" role="button" aria-label="Analyze business data">
            <div class="action-icon">
              <i data-lucide="trending-up" class="text-primary" aria-hidden="true"></i>
            </div>
            <div class="action-content">
              <h6 class="mb-1">Data Analysis</h6>
              <p class="text-muted small mb-0">Get insights from your data</p>
            </div>
            <div class="action-arrow">
              <i data-lucide="chevron-right" aria-hidden="true"></i>
            </div>
          </div>
        </div>

        <!-- Campaigns -->
        <div class="col-md-6 col-lg-4 mb-3">
          <div class="action-card h-100" onclick="scoutQuickAction('campaigns')" role="button" aria-label="View campaigns">
            <div class="action-icon">
              <i data-lucide="megaphone" class="text-danger" aria-hidden="true"></i>
            </div>
            <div class="action-content">
              <h6 class="mb-1">Campaigns</h6>
              <p class="text-muted small mb-0">Email marketing campaigns</p>
            </div>
            <div class="action-arrow">
              <i data-lucide="chevron-right" aria-hidden="true"></i>
            </div>
          </div>
        </div>
        
      </div>
    </div>
  </div>

  <!-- Example Prompts -->
  <div class="row">
    <div class="col-lg-10 mx-auto">
      <h6 class="text-muted mb-3 text-center">Or try asking me something like:</h6>
      <div class="row g-2">
        <div class="col-md-6 mb-2">
          <div class="example-prompt" onclick="sendScoutMessage(this.textContent)">
            "Show me my Stripe revenue for this month"
          </div>
        </div>
        <div class="col-md-6 mb-2">
          <div class="example-prompt" onclick="sendScoutMessage(this.textContent)">
            "Create a landing page for my new product"
          </div>
        </div>
        <div class="col-md-6 mb-2">
          <div class="example-prompt" onclick="sendScoutMessage(this.textContent)">
            "Analyze my top performing campaigns"
          </div>
        </div>
        <div class="col-md-6 mb-2">
          <div class="example-prompt" onclick="sendScoutMessage(this.textContent)">
            "Help me segment my contact list"
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Entity Info -->
  <div class="row mt-5">
    <div class="col-lg-6 mx-auto">
      <div class="entity-info text-center">
        <h6 class="text-muted mb-2">Current Workspace</h6>
        <div class="d-flex align-items-center justify-content-center">
          <div class="entity-avatar bg-primary text-white rounded-circle d-flex align-items-center justify-content-center me-2" 
               style="width: 32px; height: 32px; font-size: 14px;">
            <%= entity.name.first.upcase %>
          </div>
          <span class="fw-medium"><%= entity.name %></span>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
function scoutQuickAction(action) {
  switch(action) {
    case 'landing_pages':
      window.scoutLoadCanvas?.('landing_page_viewer');
      break;
    case 'contacts':
      window.scoutLoadCanvas?.('contact_viewer');
      break;
    case 'campaigns':
      window.scoutLoadCanvas?.('campaign_viewer');
      break;
    case 'integrations':
      window.scoutController?.sendScoutMessage('Show me my integrations');
      break;
  }
}

function sendScoutMessage(message) {
  window.scoutController?.sendScoutMessage(message);
}
</script>

<style>
.default-canvas {
  padding: 2rem;
  height: 100%;
  overflow-y: auto;
}

.canvas-hero {
  max-width: 600px;
  margin: 0 auto;
}

.action-card {
  background: white;
  border: 1px solid #e9ecef;
  border-radius: 12px;
  padding: 1.5rem;
  cursor: pointer;
  transition: all 0.2s ease;
  display: flex;
  align-items: center;
  gap: 1rem;
}

.action-card:hover {
  border-color: #007bff;
  transform: translateY(-2px);
  box-shadow: 0 4px 12px rgba(0,123,255,0.15);
}

.action-icon {
  font-size: 1.5rem;
  flex-shrink: 0;
}

.action-content {
  flex-grow: 1;
}

.action-arrow {
  font-size: 0.875rem;
  color: #6c757d;
  flex-shrink: 0;
}

.example-prompt {
  background: #f8f9fa;
  border: 1px solid #e9ecef;
  border-radius: 8px;
  padding: 0.75rem 1rem;
  cursor: pointer;
  transition: all 0.2s ease;
  font-style: italic;
  color: #6c757d;
}

.example-prompt:hover {
  background: #e9ecef;
  border-color: #dee2e6;
  color: #495057;
}

.entity-info {
  padding: 1rem;
  background: #f8f9fa;
  border-radius: 0.5rem;
}

.entity-avatar {
  font-weight: 600;
  flex-shrink: 0;
}

@media (max-width: 768px) {
  .default-canvas {
    padding: 1rem;
  }
  
  .canvas-hero h4 {
    font-size: 1.5rem;
  }
  
  .canvas-hero p {
    font-size: 0.9rem;
  }
  
  .action-card {
    padding: 1rem;
  }
  
  .action-icon {
    font-size: 1.25rem;
  }
}
</style>