<%# 
  Agent Marketplace Canvas
  Uses dynamic canvas system - queries own data via TieredDiscoveryService
  Locals available: canvas_data, user, entity
%>
<%
  # Get user's favorites for highlighting
  favorited_agent_ids = defined?(UserFavorite) ? UserFavorite.favorited_ids_for(current_user, 'AgentPlugin') : []
  
  # Get search query from canvas_data (for RAG search)
  search_query = canvas_data&.dig('query') || canvas_data&.dig(:query) || ''
  
  # Use TieredDiscoveryService for RAG-based discovery when searching
  if search_query.present? && defined?(TieredDiscoveryService)
    discovery = TieredDiscoveryService.new(user: current_user, entity: current_entity, prompt: search_query)
    discovered = discovery.discover_agents(limit: 50)
    
    agents = discovered.map do |agent_data|
      agent_data.merge(is_favorite: favorited_agent_ids.include?(agent_data[:id]))
    end
  else
    # Default: Show all available agents in tiers
    # 1. User's own agents (highest priority)
    own_agents = AgentPlugin.where(user: current_user).active.limit(20)
    
    # 2. Entity agents
    entity_agents = AgentPlugin.where(entity: current_entity).where.not(user: current_user).active.limit(20)
    
    # 3. System agents (no user, no entity)
    system_agents = AgentPlugin.where(user_id: nil, entity_id: nil).active.limit(20)
    
    # 4. Public approved agents
    public_agents = AgentPlugin.where(is_public: true)
                               .where("publish_status = 'approved' OR publish_status IS NULL")
                               .where.not(id: own_agents.pluck(:id) + entity_agents.pluck(:id) + system_agents.pluck(:id))
                               .active.limit(30)
    
    # Combine into a single list with metadata
    agents = (own_agents + entity_agents + system_agents + public_agents).uniq.map do |agent|
      {
        id: agent.id,
        slug: agent.slug,
        name: agent.name,
        role: agent.role,
        description: agent.description,
        capabilities: agent.agent_capabilities.map(&:capability_name),
        icon: agent.try(:icon) || '🤖',
        is_public: agent.is_public,
        tier: if agent.user_id.nil? && agent.entity_id.nil?
                'system'
              elsif agent.user_id == current_user&.id
                'user'
              elsif agent.is_public
                'public'
              else
                'entity'
              end,
        reputation_score: agent.respond_to?(:combined_reputation_score) ? agent.combined_reputation_score : nil,
        usage_count: agent.try(:usage_count) || 0,
        is_favorite: favorited_agent_ids.include?(agent.id)
      }
    end
  end
%>

<div class="agent-marketplace-canvas">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <div>
      <h4 class="mb-1">
        <i data-lucide="store" class="me-2"></i>
        Agent Marketplace
      </h4>
      <p class="text-muted mb-0 small">
        Discover and use AI agents created by the community
      </p>
    </div>
    <div class="d-flex gap-2">
      <div class="input-group input-group-sm" style="width: 250px;">
        <span class="input-group-text bg-transparent border-end-0">
          <i data-lucide="search" style="width: 14px; height: 14px;"></i>
        </span>
        <input type="text" class="form-control border-start-0" id="agentSearch" 
               placeholder="Search agents..." autocomplete="off">
      </div>
      <div class="btn-group btn-group-sm">
        <button type="button" class="btn btn-outline-light active" data-filter="all">All</button>
        <button type="button" class="btn btn-outline-light" data-filter="favorites">⭐ Favorites</button>
        <button type="button" class="btn btn-outline-light" data-filter="popular">🔥 Popular</button>
      </div>
    </div>
  </div>

  <%# Category filter pills %>
  <div class="category-pills mb-4">
    <button class="category-pill active" data-category="all">All Categories</button>
    <% categories = agents.map { |a| a[:role] }.compact.uniq.sort %>
    <% categories.each do |category| %>
      <button class="category-pill" data-category="<%= category %>"><%= category.titleize %></button>
    <% end %>
  </div>

  <div id="agentGrid" class="agent-grid">
    <% if agents.present? %>
      <% agents.each do |agent| %>
        <div class="agent-card" 
             data-agent-id="<%= agent[:id] %>"
             data-agent-slug="<%= agent[:slug] %>"
             data-category="<%= agent[:role] %>"
             data-favorite="<%= agent[:is_favorite] %>">
          <div class="agent-card-header">
            <div class="agent-icon">
              <%= agent[:icon] || '🤖' %>
            </div>
            <div class="agent-badges">
              <% if agent[:is_favorite] %>
                <span class="badge bg-warning text-dark">⭐ Favorite</span>
              <% end %>
              <% if agent[:tier] == 'system' %>
                <span class="badge bg-primary">System</span>
              <% elsif agent[:is_public] %>
                <span class="badge bg-success">Public</span>
              <% end %>
            </div>
          </div>
          
          <div class="agent-card-body">
            <h6 class="agent-name"><%= agent[:name] %></h6>
            <p class="agent-role text-muted small"><%= agent[:role]&.titleize %></p>
            <p class="agent-description"><%= truncate(agent[:description], length: 100) %></p>
            
            <% if agent[:capabilities].present? %>
              <div class="agent-capabilities">
                <% agent[:capabilities].first(3).each do |cap| %>
                  <span class="capability-tag"><%= cap %></span>
                <% end %>
                <% if agent[:capabilities].size > 3 %>
                  <span class="capability-tag">+<%= agent[:capabilities].size - 3 %></span>
                <% end %>
              </div>
            <% end %>
          </div>
          
          <div class="agent-card-footer">
            <div class="agent-stats">
              <% if agent[:reputation_score] %>
                <span class="stat" title="Reputation Score">
                  <i data-lucide="star" style="width: 12px; height: 12px;"></i>
                  <%= (agent[:reputation_score] * 100).round %>%
                </span>
              <% end %>
              <% if agent[:usage_count] && agent[:usage_count] > 0 %>
                <span class="stat" title="Times Used">
                  <i data-lucide="activity" style="width: 12px; height: 12px;"></i>
                  <%= agent[:usage_count] %>
                </span>
              <% end %>
            </div>
            <div class="agent-actions">
              <button class="btn btn-sm btn-outline-light favorite-btn" 
                      data-agent-id="<%= agent[:id] %>"
                      data-agent-slug="<%= agent[:slug] %>"
                      title="<%= agent[:is_favorite] ? 'Remove from favorites' : 'Add to favorites' %>">
                <i data-lucide="<%= agent[:is_favorite] ? 'star' : 'star' %>" 
                   class="<%= 'text-warning' if agent[:is_favorite] %>"
                   style="width: 14px; height: 14px;"></i>
              </button>
              <button class="btn btn-sm btn-primary use-agent-btn"
                      data-agent-slug="<%= agent[:slug] %>"
                      data-agent-name="<%= agent[:name] %>">
                Use Agent
              </button>
            </div>
          </div>
        </div>
      <% end %>
    <% else %>
      <div class="empty-state text-center py-5">
        <i data-lucide="users" class="mb-3" style="width: 48px; height: 48px; opacity: 0.5;"></i>
        <h5>No Agents Available</h5>
        <p class="text-muted">Public agents will appear here once they're published.</p>
      </div>
    <% end %>
  </div>
</div>

<style>
  .agent-marketplace-canvas {
    height: 100%;
    overflow-y: auto;
    padding: 20px;
  }

  .category-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .category-pill {
    padding: 6px 14px;
    border-radius: 20px;
    border: 1px solid rgba(255, 255, 255, 0.2);
    background: transparent;
    color: rgba(255, 255, 255, 0.7);
    font-size: 0.85rem;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .category-pill:hover, .category-pill.active {
    background: rgba(255, 255, 255, 0.15);
    border-color: rgba(255, 255, 255, 0.4);
    color: #fff;
  }

  .agent-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 16px;
  }

  .agent-card {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 12px;
    overflow: hidden;
    transition: all 0.2s ease;
    display: flex;
    flex-direction: column;
  }

  .agent-card:hover {
    background: rgba(255, 255, 255, 0.08);
    border-color: rgba(255, 255, 255, 0.2);
    transform: translateY(-2px);
  }

  .agent-card-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    padding: 16px 16px 8px;
  }

  .agent-icon {
    width: 48px;
    height: 48px;
    background: rgba(255, 255, 255, 0.1);
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 24px;
  }

  .agent-badges {
    display: flex;
    gap: 4px;
    flex-wrap: wrap;
  }

  .agent-card-body {
    padding: 0 16px 12px;
    flex-grow: 1;
  }

  .agent-name {
    color: #fff;
    font-weight: 600;
    margin-bottom: 2px;
  }

  .agent-role {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    margin-bottom: 8px;
  }

  .agent-description {
    color: rgba(255, 255, 255, 0.7);
    font-size: 0.875rem;
    line-height: 1.4;
    margin-bottom: 12px;
  }

  .agent-capabilities {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
  }

  .capability-tag {
    padding: 2px 8px;
    background: rgba(13, 110, 253, 0.2);
    border-radius: 10px;
    font-size: 0.7rem;
    color: #6ea8fe;
  }

  .agent-card-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 12px 16px;
    background: rgba(0, 0, 0, 0.2);
    border-top: 1px solid rgba(255, 255, 255, 0.05);
  }

  .agent-stats {
    display: flex;
    gap: 12px;
  }

  .agent-stats .stat {
    display: flex;
    align-items: center;
    gap: 4px;
    font-size: 0.75rem;
    color: rgba(255, 255, 255, 0.6);
  }

  .agent-actions {
    display: flex;
    gap: 8px;
  }

  .use-agent-btn {
    font-size: 0.8rem;
    padding: 4px 12px;
  }

  .empty-state {
    grid-column: 1 / -1;
    color: rgba(255, 255, 255, 0.5);
  }

  /* Hide cards based on filters */
  .agent-card.hidden {
    display: none;
  }
</style>

<script>
(function() {
  console.log('🏪 Initializing Agent Marketplace canvas');

  // Helper to send message to Scout
  function sendToScout(message) {
    if (typeof window.scoutSendMessage === 'function') {
      window.scoutSendMessage(message);
    } else {
      window.dispatchEvent(new CustomEvent('scout:send-message', {
        detail: { message: message }
      }));
    }
  }

  // Search functionality - uses RAG for semantic search
  const searchInput = document.getElementById('agentSearch');
  let searchTimeout;
  
  if (searchInput) {
    // Local filtering for immediate feedback
    searchInput.addEventListener('input', function() {
      filterAgents(); // Instant local filter
      
      // Debounced RAG search for deeper semantic matching
      clearTimeout(searchTimeout);
      const query = this.value.trim();
      
      if (query.length >= 3) {
        searchTimeout = setTimeout(() => {
          console.log('🔍 Triggering RAG search for:', query);
          // Reload canvas with search query for server-side RAG
          if (window.scoutLoadCanvas) {
            window.scoutLoadCanvas('agent_marketplace', { query: query }, true);
          }
        }, 500); // 500ms debounce
      }
    });
  }

  // Category filter
  document.querySelectorAll('.category-pill').forEach(pill => {
    pill.addEventListener('click', function() {
      document.querySelectorAll('.category-pill').forEach(p => p.classList.remove('active'));
      this.classList.add('active');
      filterAgents();
    });
  });

  // Type filter (All/Favorites/Popular)
  document.querySelectorAll('[data-filter]').forEach(btn => {
    btn.addEventListener('click', function() {
      document.querySelectorAll('[data-filter]').forEach(b => b.classList.remove('active'));
      this.classList.add('active');
      filterAgents();
    });
  });

  function filterAgents() {
    const searchQuery = document.getElementById('agentSearch')?.value.toLowerCase() || '';
    const activeCategory = document.querySelector('.category-pill.active')?.dataset.category || 'all';
    const activeFilter = document.querySelector('[data-filter].active')?.dataset.filter || 'all';

    document.querySelectorAll('.agent-card').forEach(card => {
      const name = card.querySelector('.agent-name')?.textContent.toLowerCase() || '';
      const description = card.querySelector('.agent-description')?.textContent.toLowerCase() || '';
      const category = card.dataset.category || '';
      const isFavorite = card.dataset.favorite === 'true';

      let show = true;

      // Search filter
      if (searchQuery && !name.includes(searchQuery) && !description.includes(searchQuery)) {
        show = false;
      }

      // Category filter
      if (activeCategory !== 'all' && category !== activeCategory) {
        show = false;
      }

      // Type filter
      if (activeFilter === 'favorites' && !isFavorite) {
        show = false;
      }

      card.classList.toggle('hidden', !show);
    });
  }

  // Favorite button
  document.querySelectorAll('.favorite-btn').forEach(btn => {
    btn.addEventListener('click', function(e) {
      e.stopPropagation();
      const agentId = this.dataset.agentId;
      const agentSlug = this.dataset.agentSlug;
      const icon = this.querySelector('i');
      const card = this.closest('.agent-card');

      fetch('/scout/favorites/toggle', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]')?.content
        },
        body: JSON.stringify({
          type: 'AgentPlugin',
          id: agentId
        })
      })
      .then(res => res.json())
      .then(data => {
        if (data.success) {
          icon.classList.toggle('text-warning', data.favorited);
          card.dataset.favorite = data.favorited ? 'true' : 'false';
          
          // Update badge
          const badges = card.querySelector('.agent-badges');
          const existingBadge = badges.querySelector('.badge.bg-warning');
          if (data.favorited && !existingBadge) {
            const badge = document.createElement('span');
            badge.className = 'badge bg-warning text-dark';
            badge.textContent = '⭐ Favorite';
            badges.prepend(badge);
          } else if (!data.favorited && existingBadge) {
            existingBadge.remove();
          }
        }
      });
    });
  });

  // Use Agent button
  document.querySelectorAll('.use-agent-btn').forEach(btn => {
    btn.addEventListener('click', function(e) {
      e.stopPropagation();
      const agentSlug = this.dataset.agentSlug;
      const agentName = this.dataset.agentName;
      
      // Send a direct delegation request - Scout should delegate immediately
      // and let the agent ask its own questions through the question queue
      sendToScout(`Please delegate a task to the ${agentName} agent (slug: ${agentSlug}). The agent will ask me any questions it needs through the question queue.`);
    });
  });

  // Click on card to view details
  document.querySelectorAll('.agent-card').forEach(card => {
    card.addEventListener('click', function(e) {
      if (e.target.closest('.agent-actions')) return;
      
      const agentSlug = this.dataset.agentSlug;
      const agentId = this.dataset.agentId;
      
      // Load agent detail canvas
      if (typeof window.scoutLoadCanvas === 'function') {
        window.scoutLoadCanvas('agent_detail', { agent_id: agentId, agent_slug: agentSlug });
      }
    });
  });

  // Initialize icons
  if (typeof lucide !== 'undefined') lucide.createIcons();
})();
</script>

