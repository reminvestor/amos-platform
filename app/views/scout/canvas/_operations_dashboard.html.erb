<div class="operations-dashboard p-4" id="operations-dashboard-canvas" data-canvas-type="operations_dashboard">
  <!-- Header -->
  <div class="dashboard-header mb-4">
    <div class="row align-items-center">
      <div class="col-md-8">
        <h2 class="mb-1">
          <i data-lucide="radar" class="me-2"></i>
          Command Center
        </h2>
        <p class="text-muted mb-0">Real-time system health, notifications, and job monitoring</p>
      </div>
      <div class="col-md-4 text-end">
        <button class="btn btn-outline-secondary btn-sm me-2" onclick="refreshOperationsDashboard()">
          <i data-lucide="refresh-cw" style="width: 14px; height: 14px;"></i> Refresh
        </button>
        <button class="btn btn-primary btn-sm" onclick="markAllNotificationsRead()">
          <i data-lucide="check-check" style="width: 14px; height: 14px;"></i> Mark All Read
        </button>
      </div>
    </div>
  </div>

  <%
    # ── Notifications ──
    notification_service = SystemNotificationService.new(entity: current_entity, user: current_user) rescue nil
    stats = notification_service&.stats(since: 24.hours.ago) || {}
    unread_count = notification_service&.unread_count || 0
    recent_notifications = notification_service&.recent_notifications(limit: 15) || []

    # ── Automations ──
    automation_total = AutomationCode.for_entity(current_entity).count rescue 0
    automation_active = AutomationCode.for_entity(current_entity).active.count rescue 0
    automation_errors_24h = AutomationExecution.for_entity(current_entity)
                                                .failed
                                                .where('created_at > ?', 24.hours.ago)
                                                .count rescue 0
    automation_runs_24h = AutomationExecution.for_entity(current_entity)
                                              .where('created_at > ?', 24.hours.ago)
                                              .count rescue 0

    # ── Integrations ──
    connections_active = current_entity.connections.active.count rescue 0
    connections_failing = current_entity.connections.failing.count rescue 0
    connections_total = current_entity.connections.count rescue 0

    # ── Landing Pages ──
    lp_published = LandingPage.by_entity(current_entity.id).published.count rescue 0
    lp_draft = LandingPage.by_entity(current_entity.id).drafts.count rescue 0
    lp_submissions_week = LandingPageSubmission.joins(:landing_page)
                                                .where(landing_pages: { entity_id: current_entity.id })
                                                .where('landing_page_submissions.created_at > ?', 7.days.ago)
                                                .count rescue 0

    # ── Campaigns ──
    campaigns_active = current_entity.campaigns.active.count rescue 0
    campaigns_completed = current_entity.campaigns.completed.count rescue 0
    emails_sent_24h = EmailDelivery.joins(:campaign)
                                    .where(campaigns: { entity_id: current_entity.id })
                                    .sent
                                    .where('email_deliveries.created_at > ?', 24.hours.ago)
                                    .count rescue 0

    # ── Custom Domains ──
    domains_total = current_entity.custom_domains.count rescue 0
    domains_verified = current_entity.custom_domains.verified.count rescue 0
    domains_pending = current_entity.custom_domains.where(web_status: 'pending').count rescue 0

    # ── Scheduled Tasks ──
    scheduled_active = ScheduledAgentTask.where(entity: current_entity).active.count rescue 0
    scheduled_due = ScheduledAgentTask.where(entity: current_entity).due_now.count rescue 0

    # ── Workflows (24h) ──
    workflows_completed_24h = WorkflowExecution.where(entity: current_entity)
                                                .status_completed
                                                .where('created_at > ?', 24.hours.ago)
                                                .count rescue 0
    workflows_failed_24h = WorkflowExecution.where(entity: current_entity)
                                             .status_failed
                                             .where('created_at > ?', 24.hours.ago)
                                             .count rescue 0
    workflows_total_24h = workflows_completed_24h + workflows_failed_24h
    workflow_success_rate = workflows_total_24h > 0 ? ((workflows_completed_24h.to_f / workflows_total_24h) * 100).round(1) : 100
  %>

  <!-- Quick Stats -->
  <div class="row g-3 mb-4">
    <div class="col-md-3">
      <div class="stat-card <%= unread_count > 0 ? 'has-alert' : '' %>">
        <div class="stat-icon"><i data-lucide="bell" style="width: 24px; height: 24px;"></i></div>
        <div class="stat-content">
          <div class="stat-value"><%= unread_count %></div>
          <div class="stat-label">Unread Notifications</div>
        </div>
      </div>
    </div>
    <div class="col-md-3">
      <div class="stat-card <%= automation_active > 0 ? 'is-active' : '' %>">
        <div class="stat-icon"><i data-lucide="zap" style="width: 24px; height: 24px;"></i></div>
        <div class="stat-content">
          <div class="stat-value"><%= automation_active %><small class="fw-normal text-muted"> / <%= automation_total %></small></div>
          <div class="stat-label">Active Automations</div>
        </div>
      </div>
    </div>
    <div class="col-md-3">
      <div class="stat-card <%= workflow_success_rate < 80 ? 'has-warning' : '' %>">
        <div class="stat-icon"><i data-lucide="trending-up" style="width: 24px; height: 24px;"></i></div>
        <div class="stat-content">
          <div class="stat-value"><%= workflow_success_rate %>%</div>
          <div class="stat-label">Success Rate (24h)</div>
        </div>
      </div>
    </div>
    <div class="col-md-3">
      <div class="stat-card <%= (automation_errors_24h + workflows_failed_24h + connections_failing) > 0 ? 'has-alert' : '' %>">
        <div class="stat-icon"><i data-lucide="alert-triangle" style="width: 24px; height: 24px;"></i></div>
        <div class="stat-content">
          <div class="stat-value"><%= automation_errors_24h + workflows_failed_24h %></div>
          <div class="stat-label">Errors (24h)</div>
        </div>
      </div>
    </div>
  </div>

  <!-- System Health Summary -->
  <div class="row g-3 mb-4">
    <!-- Left: Automations & Workflows -->
    <div class="col-md-4">
      <div class="health-panel">
        <h5 class="mb-3"><i data-lucide="workflow" class="me-2" style="width: 18px; height: 18px;"></i> Automations & Tasks</h5>
        <div class="health-items">
          <div class="health-item clickable" onclick="document.dispatchEvent(new CustomEvent('scout:load-canvas', { detail: { canvas: 'automation_dashboard', data: {} } }))">
            <span class="health-label">Active Automations</span>
            <span class="health-value text-success"><%= automation_active %></span>
          </div>
          <div class="health-item">
            <span class="health-label">Runs (24h)</span>
            <span class="health-value text-primary"><%= automation_runs_24h %></span>
          </div>
          <div class="health-item">
            <span class="health-label">Errors (24h)</span>
            <span class="health-value <%= automation_errors_24h > 0 ? 'text-danger' : 'text-muted' %>"><%= automation_errors_24h %></span>
          </div>
          <div class="health-item">
            <span class="health-label">Scheduled Tasks</span>
            <span class="health-value text-primary"><%= scheduled_active %></span>
          </div>
          <% if scheduled_due > 0 %>
            <div class="health-item">
              <span class="health-label">Tasks Due Now</span>
              <span class="health-value text-warning"><%= scheduled_due %></span>
            </div>
          <% end %>
        </div>
      </div>
    </div>

    <!-- Center: Integrations & Domains -->
    <div class="col-md-4">
      <div class="health-panel">
        <h5 class="mb-3"><i data-lucide="plug" class="me-2" style="width: 18px; height: 18px;"></i> Integrations & Domains</h5>
        <div class="health-items">
          <div class="health-item clickable" onclick="document.dispatchEvent(new CustomEvent('scout:load-canvas', { detail: { canvas: 'integrations', data: {} } }))">
            <span class="health-label">Connected Integrations</span>
            <span class="health-value text-success"><%= connections_active %><small class="text-muted fw-normal"> / <%= connections_total %></small></span>
          </div>
          <% if connections_failing > 0 %>
            <div class="health-item">
              <span class="health-label">Failing Connections</span>
              <span class="health-value text-danger"><%= connections_failing %></span>
            </div>
          <% end %>
          <div class="health-item clickable" onclick="document.dispatchEvent(new CustomEvent('scout:load-canvas', { detail: { canvas: 'custom_domains', data: {} } }))">
            <span class="health-label">Custom Domains</span>
            <span class="health-value <%= domains_verified > 0 ? 'text-success' : 'text-muted' %>"><%= domains_verified %><small class="text-muted fw-normal"> verified</small></span>
          </div>
          <% if domains_pending > 0 %>
            <div class="health-item">
              <span class="health-label">Domains Pending</span>
              <span class="health-value text-warning"><%= domains_pending %></span>
            </div>
          <% end %>
        </div>
      </div>
    </div>

    <!-- Right: Content & Campaigns -->
    <div class="col-md-4">
      <div class="health-panel">
        <h5 class="mb-3"><i data-lucide="layout" class="me-2" style="width: 18px; height: 18px;"></i> Content & Campaigns</h5>
        <div class="health-items">
          <div class="health-item clickable" onclick="document.dispatchEvent(new CustomEvent('scout:load-canvas', { detail: { canvas: 'my_creations', data: { type: 'landing_page' } } }))">
            <span class="health-label">Landing Pages</span>
            <span class="health-value text-success"><%= lp_published %> <small class="text-muted fw-normal">published</small></span>
          </div>
          <% if lp_draft > 0 %>
            <div class="health-item">
              <span class="health-label">Drafts</span>
              <span class="health-value text-muted"><%= lp_draft %></span>
            </div>
          <% end %>
          <div class="health-item">
            <span class="health-label">Form Submissions (7d)</span>
            <span class="health-value text-primary"><%= lp_submissions_week %></span>
          </div>
          <div class="health-item">
            <span class="health-label">Active Campaigns</span>
            <span class="health-value <%= campaigns_active > 0 ? 'text-success' : 'text-muted' %>"><%= campaigns_active %></span>
          </div>
          <div class="health-item">
            <span class="health-label">Emails Sent (24h)</span>
            <span class="health-value text-primary"><%= emails_sent_24h %></span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Notifications Feed -->
  <div class="notifications-section">
    <div class="d-flex justify-content-between align-items-center mb-3">
      <h5 class="mb-0">
        <i data-lucide="inbox" class="me-2" style="width: 18px; height: 18px;"></i>
        Recent Notifications
        <% if unread_count > 0 %>
          <span class="badge bg-danger ms-2"><%= unread_count %> new</span>
        <% end %>
      </h5>
      <div class="btn-group btn-group-sm">
        <button class="btn btn-outline-secondary active" data-filter="all">All</button>
        <button class="btn btn-outline-secondary" data-filter="unread">Unread</button>
        <button class="btn btn-outline-danger" data-filter="errors">Errors</button>
      </div>
    </div>

    <div class="notifications-list" id="notifications-list">
      <% if recent_notifications.any? %>
        <% recent_notifications.each do |notification| %>
          <div class="notification-card <%= notification.severity %> <%= notification.unread? ? 'unread' : '' %>" 
               data-notification-id="<%= notification.id %>"
               data-severity="<%= notification.severity %>">
            <div class="notification-icon">
              <% case notification.severity %>
              <% when 'critical' %>
                <i data-lucide="alert-octagon" style="width: 20px; height: 20px; color: #EF4444;"></i>
              <% when 'error' %>
                <i data-lucide="x-circle" style="width: 20px; height: 20px; color: #EF4444;"></i>
              <% when 'warning' %>
                <i data-lucide="alert-triangle" style="width: 20px; height: 20px; color: #F59E0B;"></i>
              <% else %>
                <i data-lucide="info" style="width: 20px; height: 20px; color: #3B82F6;"></i>
              <% end %>
            </div>
            <div class="notification-content">
              <div class="notification-header">
                <span class="notification-title"><%= notification.title %></span>
                <span class="notification-time"><%= notification.age_in_words %></span>
              </div>
              <p class="notification-message"><%= notification.message.truncate(200) %></p>
              <div class="notification-footer">
                <span class="notification-category badge bg-secondary"><%= notification.category.titleize %></span>
                <% if notification.actionable && notification.action_path %>
                  <a href="<%= notification.action_path %>" class="btn btn-sm btn-link p-0">
                    <%= notification.action_label || 'View' %> →
                  </a>
                <% end %>
              </div>
            </div>
            <div class="notification-actions">
              <% if notification.unread? %>
                <button class="btn btn-sm btn-link mark-read-btn" data-id="<%= notification.id %>" title="Mark as read">
                  <i data-lucide="check" style="width: 16px; height: 16px;"></i>
                </button>
              <% end %>
              <button class="btn btn-sm btn-link dismiss-btn" data-id="<%= notification.id %>" title="Dismiss">
                <i data-lucide="x" style="width: 16px; height: 16px;"></i>
              </button>
            </div>
          </div>
        <% end %>
      <% else %>
        <div class="empty-state text-center py-5">
          <i data-lucide="check-circle" class="mb-3" style="width: 48px; height: 48px; color: rgba(16, 185, 129, 0.5);"></i>
          <h5>All Clear!</h5>
          <p class="text-muted">No recent notifications. Your system is running smoothly.</p>
        </div>
      <% end %>
    </div>
  </div>
</div>

<style>
