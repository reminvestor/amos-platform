<%# Browser Session Canvas
    Displays live browser view for computer use agent
    Shows screenshots after each action, URL bar, and action history

    canvas_data:
      - session_id: Browser session identifier
      - url: Current URL
      - title: Page title
      - screenshot: Base64 screenshot data
      - action: Last action performed
      - message: Status message
      - interactive_elements: Clickable elements on page (for reference)
      - action_history: Recent actions taken
%>

<%
  session_id = canvas_data['session_id'] || canvas_data[:session_id]
  current_url = canvas_data['url'] || canvas_data[:url] || ''
  page_title = canvas_data['title'] || canvas_data[:title] || 'Browser Session'
  screenshot = canvas_data['screenshot'] || canvas_data[:screenshot]
  screenshot_url = canvas_data['screenshot_url'] || canvas_data[:screenshot_url]
  last_action = canvas_data['action'] || canvas_data[:action]
  message = canvas_data['message'] || canvas_data[:message]
  status = canvas_data['status'] || canvas_data[:status] || 'ready'
  interactive_elements = canvas_data['interactive_elements'] || canvas_data[:interactive_elements] || []
  action_history = canvas_data['action_history'] || canvas_data[:action_history] || []
  login_required = canvas_data['login_required'] || canvas_data[:login_required]
  proxy_host = canvas_data['proxy_host'] || canvas_data[:proxy_host]

  domain = begin
    URI.parse(current_url).host if current_url.present?
  rescue
    current_url
  end

  proxy_host ||= domain
%>

<div class="browser-session"
     data-controller="browser-session"
     data-browser-session-session-id-value="<%= session_id %>"
     data-browser-session-url-value="<%= current_url %>">

  <!-- Header Bar -->
  <div class="bs-header">
    <div class="bs-mode-badge">
      <i data-lucide="bot" class="bs-icon-sm" aria-hidden="true"></i>
      <span>Computer Use Agent</span>
    </div>
    
    <% if current_url.present? %>
      <div class="bs-url-bar">
        <i data-lucide="globe" class="bs-icon-sm" aria-hidden="true"></i>
        <span class="bs-url" data-browser-session-target="urlDisplay"><%= domain %></span>
        <a href="<%= current_url %>" target="_blank" rel="noopener noreferrer" class="bs-external-link" title="Open in new tab">
          <i data-lucide="external-link" class="bs-icon-sm" aria-hidden="true"></i>
        </a>
      </div>
    <% end %>

    <div class="bs-actions">
      <% if status == 'active' %>
        <span class="bs-status bs-status-active">
          <span class="bs-status-dot"></span>
          Active
        </span>
      <% end %>
    </div>
  </div>

  <!-- Content Area -->
  <div class="bs-content" data-browser-session-target="content">
    
    <% if screenshot_url.present? || screenshot.present? %>
      <!-- Screenshot View -->
      <div class="bs-screenshot-container" data-browser-session-target="screenshotContainer">
        <% if login_required %>
          <div class="alert alert-warning d-flex flex-wrap align-items-start justify-content-between gap-2 mb-2" role="alert">
            <div class="me-auto">
              <div class="fw-semibold">Login required</div>
              <div class="small">Open interactive login, sign in, then click “Continue after login” so the agent can sync your session and proceed.</div>
            </div>
            <div class="d-flex gap-2">
              <button type="button"
                      class="btn btn-sm btn-outline-primary"
                      onclick="window.requestBrowserSessionInteractiveLogin?.('<%= j(session_id.to_s) %>', '<%= j(current_url.to_s) %>')">
                Open interactive login
              </button>
              <button type="button"
                      class="btn btn-sm btn-primary"
                      onclick="window.requestBrowserSessionSyncLogin?.('<%= j(session_id.to_s) %>', '<%= j(proxy_host.to_s) %>')">
                Continue after login
              </button>
            </div>
          </div>
        <% end %>

        <% if message.present? %>
          <div class="bs-action-message">
            <i data-lucide="check-circle" class="bs-icon-sm bs-success-icon" aria-hidden="true"></i>
            <span><%= message %></span>
          </div>
        <% end %>

        <div class="bs-screenshot-wrapper">
          <img src="<%= screenshot_url.presence || (screenshot.start_with?('data:') ? screenshot : "data:image/png;base64,#{screenshot}") %>"
               alt="Browser screenshot"
               class="bs-screenshot-img"
               onerror="setTimeout(function(){window.refreshBrowserSessionScreenshot && window.refreshBrowserSessionScreenshot('<%= j(session_id.to_s) %>')},0)"
               data-browser-session-target="screenshot"
               data-action="click->browser-session#toggleZoom" />
        </div>

        <% if page_title.present? %>
          <div class="bs-page-title">
            <i data-lucide="file-text" class="bs-icon-sm" aria-hidden="true"></i>
            <span><%= page_title %></span>
          </div>
        <% end %>
      </div>

      <!-- Interactive Elements Reference -->
      <% if interactive_elements.any? %>
        <details class="bs-elements-panel">
          <summary>
            <i data-lucide="mouse-pointer-click" class="bs-icon-sm" aria-hidden="true"></i>
            Interactive Elements (<%= interactive_elements.length %>)
          </summary>
          <div class="bs-elements-list">
            <% interactive_elements.first(15).each do |el| %>
              <div class="bs-element-item">
                <span class="bs-element-type"><%= el['type'] || el[:type] %></span>
                <span class="bs-element-text"><%= (el['text'] || el[:text] || el['id'] || el[:id] || 'unnamed').truncate(40) %></span>
              </div>
            <% end %>
            <% if interactive_elements.length > 15 %>
              <div class="bs-element-more">+ <%= interactive_elements.length - 15 %> more elements</div>
            <% end %>
          </div>
        </details>
      <% end %>

    <% elsif status == 'loading' || status == 'navigating' %>
      <!-- Loading State -->
      <div class="bs-loading">
        <div class="bs-spinner"></div>
        <p class="bs-loading-text"><%= message || 'Loading...' %></p>
      </div>

    <% else %>
      <!-- Initial State - No Screenshot Yet -->
      <div class="bs-empty-state">
        <div class="bs-empty-icon">
          <i data-lucide="monitor" aria-hidden="true"></i>
        </div>
        <h4>Browser Session Ready</h4>
        <p>Ask the AI to navigate to a website or perform actions.</p>
        <div class="bs-examples">
          <p class="bs-examples-label">Try saying:</p>
          <ul>
            <li>"Go to stripe.com"</li>
            <li>"Navigate to github.com and click on Sign In"</li>
            <li>"Fill out the contact form on example.com"</li>
          </ul>
        </div>
      </div>
    <% end %>

  </div>

  <!-- Action History (collapsible) -->
  <% if action_history.any? %>
    <details class="bs-history-panel">
      <summary>
        <i data-lucide="history" class="bs-icon-sm" aria-hidden="true"></i>
        Action History (<%= action_history.length %>)
      </summary>
      <div class="bs-history-list">
        <% action_history.reverse.each do |action| %>
          <div class="bs-history-item">
            <span class="bs-history-action"><%= action['action'] || action[:action] %></span>
            <span class="bs-history-details">
              <% if (action['details'] || action[:details]).present? %>
                <%= (action['details'] || action[:details]).to_json.truncate(50) %>
              <% end %>
            </span>
          </div>
        <% end %>
      </div>
    </details>
  <% end %>

</div>

<style>
  .browser-session {
    display: flex;
    flex-direction: column;
    height: 100%;
    background: var(--bg-primary);
    border-radius: 8px;
    overflow: hidden;
  }

  /* Header */
  .bs-header {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 16px;
    background: linear-gradient(135deg, rgba(139, 92, 246, 0.1), rgba(59, 130, 246, 0.1));
    border-bottom: 1px solid var(--border-color);
    flex-shrink: 0;
  }

  .bs-mode-badge {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 6px 12px;
    background: linear-gradient(135deg, var(--purple), var(--blue));
    color: white;
    border-radius: 16px;
    font-size: 0.75rem;
    font-weight: 600;
    white-space: nowrap;
  }

  .bs-url-bar {
    display: flex;
    align-items: center;
    gap: 8px;
    background: var(--bg-tertiary);
    padding: 6px 12px;
    border-radius: 6px;
    flex: 1;
    max-width: 400px;
    border: 1px solid var(--border-color);
  }

  .bs-url {
    color: var(--text-primary);
    font-size: 0.875rem;
    font-family: monospace;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .bs-external-link {
    color: var(--text-secondary);
    opacity: 0.7;
    transition: opacity 0.2s, color 0.2s;
  }

  .bs-external-link:hover {
    opacity: 1;
    color: var(--purple);
  }

  .bs-actions {
    margin-left: auto;
  }

  .bs-status {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 0.75rem;
    padding: 4px 10px;
    border-radius: 12px;
  }

  .bs-status-active {
    background: rgba(34, 197, 94, 0.1);
    color: #22c55e;
  }

  .bs-status-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: currentColor;
    animation: bs-pulse 2s ease-in-out infinite;
  }

  @keyframes bs-pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.5; }
  }

  .bs-icon-sm {
    width: 14px;
    height: 14px;
  }

  /* Content Area */
  .bs-content {
    flex: 1;
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    min-height: 0;
  }

  /* Screenshot Container */
  .bs-screenshot-container {
    flex: 1;
    display: flex;
    flex-direction: column;
    padding: 16px;
    gap: 12px;
  }

  .bs-action-message {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 10px 14px;
    background: rgba(34, 197, 94, 0.1);
    border: 1px solid rgba(34, 197, 94, 0.2);
    border-radius: 8px;
    color: #22c55e;
    font-size: 0.875rem;
  }

  .bs-success-icon {
    color: #22c55e;
  }

  .bs-screenshot-wrapper {
    flex: 1;
    background: var(--bg-secondary);
    border-radius: 8px;
    overflow: hidden;
    border: 1px solid var(--border-color);
    min-height: 300px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .bs-screenshot-img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    cursor: zoom-in;
    transition: transform 0.3s;
  }

  .bs-screenshot-img.zoomed {
    cursor: zoom-out;
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    max-width: none;
    max-height: none;
    object-fit: contain;
    background: rgba(0, 0, 0, 0.9);
    z-index: 9999;
    padding: 20px;
    box-sizing: border-box;
  }

  .bs-page-title {
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--text-secondary);
    font-size: 0.875rem;
  }

  /* Interactive Elements Panel */
  .bs-elements-panel {
    margin: 0 16px 16px;
    background: var(--bg-secondary);
    border-radius: 8px;
    border: 1px solid var(--border-color);
  }

  .bs-elements-panel summary {
    padding: 10px 14px;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--text-primary);
    font-size: 0.875rem;
    font-weight: 500;
    user-select: none;
  }

  .bs-elements-panel summary:hover {
    background: var(--bg-tertiary);
  }

  .bs-elements-list {
    padding: 0 14px 14px;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .bs-element-item {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 6px 10px;
    background: var(--bg-tertiary);
    border-radius: 4px;
    font-size: 0.75rem;
  }

  .bs-element-type {
    color: var(--purple);
    font-family: monospace;
    font-weight: 500;
  }

  .bs-element-text {
    color: var(--text-secondary);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .bs-element-more {
    color: var(--text-tertiary);
    font-size: 0.75rem;
    font-style: italic;
    padding: 4px 10px;
  }

  /* Loading State */
  .bs-loading {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 40px;
  }

  .bs-spinner {
    width: 40px;
    height: 40px;
    border: 3px solid var(--border-color);
    border-top-color: var(--purple);
    border-radius: 50%;
    animation: bs-spin 1s linear infinite;
  }

  @keyframes bs-spin {
    to { transform: rotate(360deg); }
  }

  .bs-loading-text {
    margin-top: 16px;
    color: var(--text-secondary);
    font-size: 0.875rem;
  }

  /* Empty State */
  .bs-empty-state {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 40px;
    text-align: center;
  }

  .bs-empty-icon {
    width: 64px;
    height: 64px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, rgba(139, 92, 246, 0.1), rgba(59, 130, 246, 0.1));
    border-radius: 16px;
    margin-bottom: 16px;
  }

  .bs-empty-icon svg {
    width: 32px;
    height: 32px;
    color: var(--purple);
  }

  .bs-empty-state h4 {
    color: var(--text-primary);
    margin: 0 0 8px;
  }

  .bs-empty-state > p {
    color: var(--text-secondary);
    margin: 0 0 24px;
  }

  .bs-examples {
    background: var(--bg-secondary);
    border-radius: 8px;
    padding: 16px;
    text-align: left;
    max-width: 300px;
  }

  .bs-examples-label {
    color: var(--text-secondary);
    font-size: 0.75rem;
    margin: 0 0 8px;
  }

  .bs-examples ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .bs-examples li {
    padding: 6px 0;
    color: var(--text-primary);
    font-size: 0.875rem;
    font-style: italic;
  }

  .bs-examples li::before {
    content: '"';
    color: var(--purple);
  }

  .bs-examples li::after {
    content: '"';
    color: var(--purple);
  }

  /* History Panel */
  .bs-history-panel {
    margin: 0;
    background: var(--bg-secondary);
    border-top: 1px solid var(--border-color);
    flex-shrink: 0;
  }

  .bs-history-panel summary {
    padding: 10px 16px;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--text-secondary);
    font-size: 0.75rem;
    font-weight: 500;
    user-select: none;
  }

  .bs-history-panel summary:hover {
    background: var(--bg-tertiary);
  }

  .bs-history-list {
    max-height: 150px;
    overflow-y: auto;
    padding: 0 16px 12px;
  }

  .bs-history-item {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 6px 0;
    font-size: 0.75rem;
    border-bottom: 1px solid var(--border-color);
  }

  .bs-history-item:last-child {
    border-bottom: none;
  }

  .bs-history-action {
    color: var(--purple);
    font-family: monospace;
    font-weight: 500;
  }

  .bs-history-details {
    color: var(--text-tertiary);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
</style>

<script>
  // Initialize Lucide icons for this canvas
  if (typeof lucide !== 'undefined') {
    lucide.createIcons();
  }

  // Hybrid login helpers:
  // - "Open interactive login" asks Scout to load the interactive web view (proxy-backed) so the user can sign in.
  // - "Continue after login" asks Scout to sync proxy cookies into the automation browser session.
  window.requestBrowserSessionInteractiveLogin = window.requestBrowserSessionInteractiveLogin || function(proxySessionId, url) {
    const safeUrl = (url || '').trim();
    const psid = (typeof proxySessionId === 'string') ? proxySessionId : String(proxySessionId || '');
    const host = (() => { try { return new URL(safeUrl).host } catch { return '' } })();

    if (!safeUrl) return;

    // Prefer loading the interactive proxy viewer canvas directly (no AI / no tokens).
    if (typeof window.scoutLoadCanvas === 'function') {
      const proxyUrl = `/web_proxy?psid=${encodeURIComponent(psid)}&url=${encodeURIComponent(safeUrl)}`;
      window.scoutLoadCanvas('web_page_viewer', {
        url: safeUrl,
        display_mode: 'interactive',
        proxy_url: proxyUrl,
        handoff: { session_id: psid, proxy_host: host },
        status: 'loading',
        message: `Loading ${safeUrl} in interactive mode...`
      }, true);
      return;
    }

    // Fallback: open proxied page in a new tab
    window.open(`/web_proxy?psid=${encodeURIComponent(psid)}&url=${encodeURIComponent(safeUrl)}`, '_blank', 'noopener,noreferrer');
  };

  window.requestBrowserSessionSyncLogin = window.requestBrowserSessionSyncLogin || function(proxySessionId, proxyHost) {
    const host = (proxyHost || '').trim();
    const psid = (typeof proxySessionId === 'string') ? proxySessionId : String(proxySessionId || '');
    if (!host) return;

    const container = document.querySelector('.browser-session');
    const currentUrl = (container && container.dataset && container.dataset.browserSessionUrlValue) ? container.dataset.browserSessionUrlValue : '';

    const csrfToken = document.querySelector('meta[name="csrf-token"]')?.content;

    fetch('/scout/browser_session_sync_proxy', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        ...(csrfToken ? { 'X-CSRF-Token': csrfToken } : {})
      },
      body: JSON.stringify({
        session_id: psid,
        proxy_session_id: psid,
        proxy_host: host,
        current_url: currentUrl
      })
    })
      .then(async (resp) => {
        const data = await resp.json().catch(() => ({}));
        if (!resp.ok || !data.success) {
          const msg = data.error || 'Failed to sync login session';
          console.warn('[BrowserSession] Sync proxy session failed:', msg);
          showError(msg);
          return;
        }
        console.log('[BrowserSession] Sync proxy session success');
      })
      .catch((err) => {
        console.warn('[BrowserSession] Sync proxy session request failed:', err);
        showError('Failed to sync login session');
      });
  };

  // "Take over": closes the agent browser session so the user can continue manually.
  window.requestBrowserSessionTakeOver = window.requestBrowserSessionTakeOver || function(sessionId) {
    const csrfToken = document.querySelector('meta[name="csrf-token"]')?.content;
    fetch('/scout/browser_session_close', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        ...(csrfToken ? { 'X-CSRF-Token': csrfToken } : {})
      },
      body: JSON.stringify({ session_id: sessionId })
    }).catch(() => {});
  };

  // If the screenshot URL token 404s, fetch a fresh one and retry.
  window.refreshBrowserSessionScreenshot = window.refreshBrowserSessionScreenshot || function(sessionId) {
    window.__bsScreenshotRefreshAttempts = window.__bsScreenshotRefreshAttempts || {}
    const now = Date.now()
    const attempt = window.__bsScreenshotRefreshAttempts[sessionId] || { count: 0, ts: now }
    // Reset window every 10s
    if (now - attempt.ts > 10000) {
      attempt.count = 0
      attempt.ts = now
    }
    attempt.count += 1
    window.__bsScreenshotRefreshAttempts[sessionId] = attempt
    if (attempt.count > 3) return

    const container = document.querySelector('.browser-session');
    const img = container ? container.querySelector('.bs-screenshot-img') : null;
    if (!img) return;

    const csrfToken = document.querySelector('meta[name="csrf-token"]')?.content;
    fetch('/scout/browser_session_screenshot_refresh', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        ...(csrfToken ? { 'X-CSRF-Token': csrfToken } : {})
      },
      body: JSON.stringify({ session_id: sessionId })
    })
      .then(async (resp) => {
        const data = await resp.json().catch(() => ({}));
        if (!resp.ok || !data.success || !data.screenshot_url) return;
        img.src = data.screenshot_url;
      })
      .catch(() => {});
  };

  // Set up ActionCable listener for browser state updates
  ;(function() {
    const container = document.querySelector('.browser-session');
    if (!container) return;

    console.log('[BrowserSession] Canvas initialized');

    // Listen for browser state updates from the computer use tool
    document.addEventListener('scout:browser-state', function(event) {
      const data = event.detail || {};
      console.log('[BrowserSession] Received browser state update:', data);
      updateBrowserState(data);
    });

    // Also listen for ActionCable messages
    document.addEventListener('scout:canvas-update', function(event) {
      const { canvas, canvas_data: data } = event.detail || {};
      if (canvas !== 'browser_session') return;
      console.log('[BrowserSession] Received canvas update:', data);
      updateBrowserState(data);
    });

    function updateBrowserState(data) {
      const sessionId =
        (container.dataset && container.dataset.browserSessionSessionIdValue) ||
        data.session_id ||
        '';

      // Keep the container's dataset session id in sync so other helpers can reuse it.
      try {
        if (sessionId && container.dataset) container.dataset.browserSessionSessionIdValue = String(sessionId)
      } catch {}

      // Update URL display
      const urlDisplay = container.querySelector('[data-browser-session-target="urlDisplay"]');
      if (urlDisplay && data.url) {
        try {
          urlDisplay.textContent = new URL(data.url).host;
        } catch {
          urlDisplay.textContent = data.url;
        }
        try {
          if (container.dataset) container.dataset.browserSessionUrlValue = String(data.url)
        } catch {}
      }

      // Auto-handoff: if login is needed, open interactive mode (once per URL).
      try {
        window.__browserSessionHandoffOpened = window.__browserSessionHandoffOpened || {}
        const key = `${sessionId}:${data.url || ''}`
        if (data.login_required && data.url && !window.__browserSessionHandoffOpened[key]) {
          window.__browserSessionHandoffOpened[key] = true
          window.requestBrowserSessionInteractiveLogin?.(sessionId, data.url)
        }
      } catch {}

      // Update screenshot
      if (data.screenshot_url || data.screenshot) {
        const content = container.querySelector('[data-browser-session-target="content"]');
        if (content) {
          const screenshotSrc = data.screenshot_url
            ? data.screenshot_url
            : (data.screenshot.startsWith('data:')
              ? data.screenshot
              : `data:image/png;base64,${data.screenshot}`);
          
          let screenshotContainer = content.querySelector('.bs-screenshot-container');
          const loginBanner = data.login_required ? `
            <div class="alert alert-warning d-flex flex-wrap align-items-start justify-content-between gap-2 mb-2" role="alert">
              <div class="me-auto">
                <div class="fw-semibold">Login required</div>
                <div class="small">Open interactive login, sign in, then click “Continue after login” so the agent can sync your session and proceed.</div>
              </div>
              <div class="d-flex gap-2">
                <button type="button"
                        class="btn btn-sm btn-outline-primary"
                        onclick="window.requestBrowserSessionInteractiveLogin?.(${JSON.stringify(sessionId)}, ${JSON.stringify(data.url || '')})">
                  Open interactive login
                </button>
                <button type="button"
                        class="btn btn-sm btn-primary"
                        onclick="window.requestBrowserSessionSyncLogin?.(${JSON.stringify(sessionId)}, ${JSON.stringify(data.proxy_host || '')})">
                  Continue after login
                </button>
              </div>
            </div>
          ` : '';
          
          if (screenshotContainer) {
            // Update existing screenshot
            const img = screenshotContainer.querySelector('.bs-screenshot-img');
            if (img) {
              img.onerror = () => window.refreshBrowserSessionScreenshot?.(sessionId)
              img.src = screenshotSrc;
            }
            
            // Update message
            const msgEl = screenshotContainer.querySelector('.bs-action-message span');
            if (msgEl && data.message) msgEl.textContent = data.message;

            // Update / insert login banner
            const existingBanner = screenshotContainer.querySelector('.alert.alert-warning');
            if (existingBanner && !data.login_required) {
              existingBanner.remove()
            } else if (!existingBanner && data.login_required) {
              screenshotContainer.insertAdjacentHTML('afterbegin', loginBanner)
            } else if (existingBanner && data.login_required) {
              // Keep banner text/buttons fresh
              existingBanner.outerHTML = loginBanner
            }
          } else {
            // Create screenshot view
            content.innerHTML = `
              <div class="bs-screenshot-container">
                ${loginBanner}
                ${data.message ? `
                  <div class="bs-action-message">
                    <i data-lucide="check-circle" class="bs-icon-sm bs-success-icon" aria-hidden="true"></i>
                    <span>${escapeHtml(data.message)}</span>
                  </div>
                ` : ''}
                <div class="bs-screenshot-wrapper">
                  <img src="${screenshotSrc}"
                       alt="Browser screenshot"
                       class="bs-screenshot-img"
                       onclick="this.classList.toggle('zoomed')" />
                </div>
                ${data.title ? `
                  <div class="bs-page-title">
                    <i data-lucide="file-text" class="bs-icon-sm" aria-hidden="true"></i>
                    <span>${escapeHtml(data.title)}</span>
                  </div>
                ` : ''}
              </div>
            `;
            
            if (typeof lucide !== 'undefined') {
              lucide.createIcons();
            }
          }
        }
      }
    }

    function escapeHtml(text) {
      const div = document.createElement('div');
      div.textContent = text || '';
      return div.innerHTML;
    }
  })();
</script>
