<%# 
  Reminders Canvas
  Uses dynamic canvas system - queries own data
  Locals available: canvas_data, user, entity
%>
<%
  overdue = current_user.reminders.overdue rescue []
  today = current_user.reminders.today rescue []
  upcoming = current_user.reminders.upcoming.where.not(id: today.pluck(:id)).limit(10) rescue []
  completed_count = current_user.reminders.completed.count rescue 0
%>

<div class="reminders-canvas">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <div>
      <h4 class="mb-1">
        <i data-lucide="bell" class="me-2" style="color: var(--accent-primary);"></i>
        Reminders
      </h4>
      <p class="text-muted mb-0 small">
        Keep track of important tasks and events
      </p>
    </div>
    <div class="d-flex gap-2">
      <button class="btn btn-primary btn-sm" id="new-reminder-btn">
        <i data-lucide="plus" style="width: 14px; height: 14px;" class="me-1"></i>
        New Reminder
      </button>
      <a href="/reminders" class="btn btn-sm btn-outline-primary" target="_blank">
        <i data-lucide="external-link" style="width: 14px; height: 14px;" class="me-1"></i>
        Full View
      </a>
    </div>
  </div>

  <%# Stats Row %>
  <div class="reminder-stats mb-4">
    <div class="stat-pill stat-danger">
      <i data-lucide="alert-circle" style="width: 14px; height: 14px;"></i>
      <span><%= overdue.count %> Overdue</span>
    </div>
    <div class="stat-pill stat-warning">
      <i data-lucide="calendar" style="width: 14px; height: 14px;"></i>
      <span><%= today.count %> Today</span>
    </div>
    <div class="stat-pill stat-info">
      <i data-lucide="clock" style="width: 14px; height: 14px;"></i>
      <span><%= upcoming.count %> Upcoming</span>
    </div>
  </div>

  <% if overdue.any? || today.any? || upcoming.any? %>
    <%# Overdue Section %>
    <% if overdue.any? %>
      <div class="reminder-section mb-4">
        <h6 class="section-title text-danger">
          <i data-lucide="alert-circle" style="width: 14px; height: 14px;" class="me-1"></i>
          Overdue
        </h6>
        <div class="reminder-list">
          <% overdue.each do |reminder| %>
            <%= render partial: 'scout/canvas/reminder_item', locals: { reminder: reminder, is_overdue: true } %>
          <% end %>
        </div>
      </div>
    <% end %>

    <%# Today Section %>
    <% if today.any? %>
      <div class="reminder-section mb-4">
        <h6 class="section-title text-warning">
          <i data-lucide="calendar" style="width: 14px; height: 14px;" class="me-1"></i>
          Due Today
        </h6>
        <div class="reminder-list">
          <% today.each do |reminder| %>
            <%= render partial: 'scout/canvas/reminder_item', locals: { reminder: reminder, is_overdue: false } %>
          <% end %>
        </div>
      </div>
    <% end %>

    <%# Upcoming Section %>
    <% if upcoming.any? %>
      <div class="reminder-section">
        <h6 class="section-title text-info">
          <i data-lucide="clock" style="width: 14px; height: 14px;" class="me-1"></i>
          Upcoming
        </h6>
        <div class="reminder-list">
          <% upcoming.each do |reminder| %>
            <%= render partial: 'scout/canvas/reminder_item', locals: { reminder: reminder, is_overdue: false } %>
          <% end %>
        </div>
      </div>
    <% end %>
  <% else %>
    <div class="empty-section text-center py-5">
      <i data-lucide="bell" class="mb-3" style="width: 48px; height: 48px; opacity: 0.3;"></i>
      <h5 class="mb-2">No Reminders</h5>
      <p class="text-muted mb-3">Create reminders to stay on top of important tasks</p>
      <button class="btn btn-primary" id="empty-new-reminder-btn">
        <i data-lucide="plus" style="width: 16px; height: 16px;" class="me-1"></i>
        Create Your First Reminder
      </button>
    </div>
  <% end %>
</div>

<style>
  .reminders-canvas {
    height: 100%;
    overflow-y: auto;
    padding: 20px;
  }

  .reminder-stats {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }

  .stat-pill {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 6px 12px;
    border-radius: 20px;
    font-size: 0.8rem;
    font-weight: 500;
  }

  .stat-pill.stat-danger {
    background: rgba(239, 68, 68, 0.15);
    color: #EF4444;
  }

  .stat-pill.stat-warning {
    background: rgba(245, 158, 11, 0.15);
    color: #F59E0B;
  }

  .stat-pill.stat-info {
    background: rgba(59, 130, 246, 0.15);
    color: #3B82F6;
  }

  .reminder-section .section-title {
    font-size: 0.85rem;
    font-weight: 600;
    margin-bottom: 12px;
    display: flex;
    align-items: center;
  }

  .reminder-list {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .empty-section {
    color: var(--text-muted);
  }
</style>

<script>
(function() {
  console.log('🔔 Initializing Reminders canvas');

  const newReminderBtn = document.getElementById('new-reminder-btn');
  const emptyNewReminderBtn = document.getElementById('empty-new-reminder-btn');

  function openNewReminder() {
    window.open('/reminders/new', '_blank');
  }

  if (newReminderBtn) {
    newReminderBtn.addEventListener('click', openNewReminder);
  }

  if (emptyNewReminderBtn) {
    emptyNewReminderBtn.addEventListener('click', openNewReminder);
  }

  if (typeof lucide !== 'undefined') lucide.createIcons();
})();
</script>
