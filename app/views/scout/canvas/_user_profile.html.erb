<div class="canvas-header d-flex justify-content-between align-items-center mb-4">
  <div>
    <h2 class="mb-1">👤 My Profile</h2>
    <p class="text-muted mb-0">Update your personal information and preferences</p>
  </div>
  <div class="d-flex gap-2">
    <button class="btn btn-outline-secondary" onclick="scoutSendMessage('Please help me reset my password')" aria-label="Change password">
      <i data-lucide="key" aria-hidden="true"></i> Change Password
    </button>
  </div>
</div>

<div class="row g-4">
  <div class="col-lg-8">
    <div class="card h-100">
      <div class="card-header">
        <h5 class="mb-0"><i data-lucide="user-pen" aria-hidden="true"></i> Personal Information</h5>
      </div>
      <div class="card-body">
        <%= form_with model: user, url: user_path(user), method: :patch, local: false, class: "row g-3", id: "user-profile-form", data: { turbo: false } do |f| %>
          <div class="col-md-6">
            <%= f.label :first_name, class: "form-label" %>
            <%= f.text_field :first_name, class: "form-control", placeholder: "Enter your first name" %>
          </div>
          
          <div class="col-md-6">
            <%= f.label :last_name, class: "form-label" %>
            <%= f.text_field :last_name, class: "form-control", placeholder: "Enter your last name" %>
          </div>
          
          <div class="col-12">
            <%= f.label :email, class: "form-label" %>
            <%= f.email_field :email, class: "form-control", placeholder: "Enter your email address" %>
            <div class="form-text">Your email is used for login and important notifications.</div>
          </div>

          <% if user.respond_to?(:phone) %>
          <div class="col-md-6">
            <%= f.label :phone, class: "form-label" %>
            <%= f.telephone_field :phone, class: "form-control", placeholder: "Enter your phone number" %>
          </div>
          <% end %>

          <% if user.respond_to?(:timezone) %>
          <div class="col-md-6">
            <%= f.label :timezone, class: "form-label" %>
            <%= f.select :timezone, options_for_select([
              ['Eastern Time', 'America/New_York'],
              ['Central Time', 'America/Chicago'], 
              ['Mountain Time', 'America/Denver'],
              ['Pacific Time', 'America/Los_Angeles'],
              ['UTC', 'UTC']
            ], user.timezone), { prompt: 'Select timezone' }, { class: "form-select" } %>
          </div>
          <% end %>

          <% if user.respond_to?(:bio) %>
          <div class="col-12">
            <%= f.label :bio, "Bio/About", class: "form-label" %>
            <%= f.text_area :bio, class: "form-control", rows: 3, placeholder: "Tell us a bit about yourself..." %>
          </div>
          <% end %>
          
          <div class="col-12">
            <button type="submit" class="btn btn-primary" aria-label="Save profile changes">
              <i data-lucide="save" aria-hidden="true"></i> Save Changes
            </button>
            <button type="button" class="btn btn-outline-secondary ms-2" onclick="window.scoutRefreshCanvas()" aria-label="Reset form to original values">
              <i data-lucide="rotate-ccw" aria-hidden="true"></i> Reset
            </button>
          </div>
        <% end %>
      </div>
    </div>
  </div>

  <div class="col-lg-4">
    <div class="card mb-4">
      <div class="card-header">
        <h5 class="mb-0"><i data-lucide="info" aria-hidden="true"></i> Account Info</h5>
      </div>
      <div class="card-body">
        <div class="mb-3">
          <label class="form-label text-muted">Account Created</label>
          <div><%= user.created_at.strftime("%B %d, %Y") %></div>
        </div>
        
        <div class="mb-3">
          <label class="form-label text-muted">Last Updated</label>
          <div><%= user.updated_at.strftime("%B %d, %Y") %></div>
        </div>

        <% if user.entity.present? %>
        <div class="mb-3">
          <label class="form-label text-muted">Company</label>
          <div class="d-flex align-items-center gap-2">
            <i data-lucide="building-2" aria-hidden="true" style="width: 1rem; height: 1rem;"></i>
            <strong><%= user.entity.name %></strong>
          </div>
        </div>
        <% end %>

        <% if user.respond_to?(:onboarded?) %>
        <div class="mb-3">
          <label class="form-label text-muted">Onboarding Status</label>
          <div>
            <% if user.onboarded? %>
              <span class="badge bg-success"><i data-lucide="check" aria-hidden="true"></i> Complete</span>
            <% else %>
              <span class="badge bg-warning"><i data-lucide="clock" aria-hidden="true"></i> In Progress</span>
            <% end %>
          </div>
        </div>
        <% end %>

        <hr>
        
        <div class="d-grid gap-2">
          <button class="btn btn-outline-primary btn-sm" onclick="scoutSendMessage('Please help me change my password')" aria-label="Change password">
            <i data-lucide="key" aria-hidden="true"></i> Change Password
          </button>
          <button class="btn btn-outline-secondary btn-sm" onclick="scoutSendMessage('Please help me review my security settings')" aria-label="Review security settings">
            <i data-lucide="shield-check" aria-hidden="true"></i> Security Settings
          </button>
          <button class="btn btn-outline-warning btn-sm" onclick="scoutSendMessage('Please help me download my data')" aria-label="Download my data">
            <i data-lucide="download" aria-hidden="true"></i> Download My Data
          </button>
        </div>
      </div>
    </div>

    <%# Voice Settings Card (in same column) %>
    <div class="card">
      <div class="card-header">
        <h5 class="mb-0"><i data-lucide="mic" aria-hidden="true" style="color: #A78BFA;"></i> Voice Settings</h5>
      </div>
      <div class="card-body">
        <div data-controller="voice-settings">
          <%= form_with url: api_tts_preferences_path, method: :patch, local: false, data: { action: "submit->voice-settings#saveSettings" } do |f| %>
            
            <div class="form-check mb-3">
              <%= check_box_tag :enabled, "true", current_user.tts_preferences&.dig('enabled') != false,
                  class: "form-check-input",
                  id: "tts_enabled",
                  data: { action: "change->voice-settings#togglePreview" } %>
              <label class="form-check-label" for="tts_enabled">
                <strong>Enable text-to-speech</strong> for AI responses
              </label>
            </div>

            <div class="row g-3" data-voice-settings-target="settings">
              <div class="col-12 mb-3">
                <label for="voice_id" class="form-label">Voice</label>
                <% voice_groups = {
                  'US English Voices' => [
                    ['Aria (Female - Conversational)', 'Aria'],
                    ['Joanna (Female - Expressive)', 'Joanna'],
                    ['Kendra (Female - Professional)', 'Kendra'],
                    ['Kimberly (Female - Soothing)', 'Kimberly'],
                    ['Salli (Female - Youthful)', 'Salli'],
                    ['Ivy (Female - Clear)', 'Ivy'],
                    ['Ruth (Female - Pleasant)', 'Ruth'],
                    ['Joey (Male - Natural)', 'Joey'],
                    ['Justin (Male - Friendly)', 'Justin'],
                    ['Kevin (Male - Youthful)', 'Kevin'],
                    ['Matthew (Male - Professional)', 'Matthew']
                  ],
                  'UK English Voices' => [
                    ['Amy (British Female - Neural)', 'Amy'],
                    ['Emma (British Female - Classic)', 'Emma'],
                    ['Brian (British Male - Neural)', 'Brian'],
                    ['Arthur (British Male - Distinguished)', 'Arthur']
                  ],
                  'Australian English Voice' => [
                    ['Olivia (Australian Female - Neural)', 'Olivia']
                  ],
                  'Other Languages' => [
                    ['Léa (French Female - Neural)', 'Lea'],
                    ['Mathieu (French Male - Neural)', 'Mathieu'],
                    ['Celine (French Female)', 'Celine'],
                    ['Vicki (German Female - Neural)', 'Vicki'],
                    ['Hans (German Male - Neural)', 'Hans'],
                    ['Bianca (Italian Female - Neural)', 'Bianca'],
                    ['Adriano (Italian Male - Neural)', 'Adriano'],
                    ['Lucia (Spanish Female - Neural)', 'Lucia'],
                    ['Sergio (Spanish Male - Neural)', 'Sergio'],
                    ['Conchita (Spanish Female)', 'Conchita'],
                    ['Lupe (US Spanish Female - Neural)', 'Lupe'],
                    ['Mia (Mexican Spanish Female - Neural)', 'Mia'],
                    ['Andrés (Mexican Spanish Male - Neural)', 'Andres'],
                    ['Camila (Portuguese Female - Neural)', 'Camila'],
                    ['Ricardo (Portuguese Male - Neural)', 'Ricardo'],
                    ['Vitória (Brazilian Portuguese Female - Neural)', 'Vitoria'],
                    ['Thiago (Brazilian Portuguese Male - Neural)', 'Thiago']
                  ]
                } %>
                <%= select_tag :voice_id,
                    grouped_options_for_select(voice_groups, current_user.tts_preferences&.dig('voice_id') || 'Matthew'),
                    class: "form-select",
                    id: "voice_id",
                    data: { action: "change->voice-settings#updatePreview" } %>
                <small class="form-text text-muted">Select a voice to hear a preview</small>
              </div>

              <div class="col-12 mb-3">
                <label for="speed" class="form-label d-flex justify-content-between align-items-center">
                  <span>Speaking Speed</span>
                  <span class="badge bg-secondary" data-voice-settings-target="speedLabel" style="min-width: 3rem;">
                    <%= current_user.tts_preferences&.dig('speed') || '1.0' %>x
                  </span>
                </label>
                <%= range_field_tag :speed,
                    current_user.tts_preferences&.dig('speed') || 1.0,
                    min: 0.5, max: 2.0, step: 0.1,
                    class: "form-range",
                    id: "speed",
                    data: { action: "input->voice-settings#updateSpeedLabel" } %>
              </div>

              <div class="col-12 mb-3">
                <label for="volume" class="form-label d-flex justify-content-between align-items-center">
                  <span>Volume</span>
                  <span class="badge bg-secondary" data-voice-settings-target="volumeLabel" style="min-width: 3rem;">
                    <%= ((current_user.tts_preferences&.dig('volume') || 1.0) * 100).to_i %>%
                  </span>
                </label>
                <%= range_field_tag :volume,
                    current_user.tts_preferences&.dig('volume') || 1.0,
                    min: 0, max: 1, step: 0.1,
                    class: "form-range",
                    id: "volume",
                    data: { action: "input->voice-settings#updateVolumeLabel" } %>
              </div>
            </div>

            <div class="d-grid gap-2 mt-3">
              <button type="button" class="btn btn-outline-primary btn-sm" data-action="click->voice-settings#testVoice">
                <i data-lucide="play" aria-hidden="true"></i> Test Voice
              </button>
              <%= f.submit "Save Settings", class: "btn btn-primary" %>
            </div>
          <% end %>

          <div class="alert alert-success mt-3 d-none" data-voice-settings-target="successMessage">
            <i data-lucide="check-circle" aria-hidden="true"></i>
            Settings saved!
          </div>
        </div>
      </div>
    </div>
  </div>
</div><!-- End row --> 