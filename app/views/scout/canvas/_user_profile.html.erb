<div class="canvas-header mb-4">
  <h2 class="mb-1">👤 My Profile</h2>
  <p class="text-muted mb-0">Update your personal information and preferences</p>
</div>

<div class="row g-4">
  <!-- Personal Information - Full Width on Top -->
  <div class="col-12">
    <div class="card">
      <div class="card-header">
        <h5 class="mb-0"><i data-lucide="user-pen" aria-hidden="true"></i> Personal Information</h5>
      </div>
      <div class="card-body">
        <%= form_with model: user, url: user_path(user), method: :patch, local: false, class: "row g-3", id: "user-profile-form", data: { turbo: false } do |f| %>
          <div class="col-md-6">
            <%= f.label :first_name, class: "form-label" %>
            <%= f.text_field :first_name, class: "form-control", placeholder: "Enter your first name" %>
          </div>
          
          <div class="col-md-6">
            <%= f.label :last_name, class: "form-label" %>
            <%= f.text_field :last_name, class: "form-control", placeholder: "Enter your last name" %>
          </div>
          
          <div class="col-md-6">
            <%= f.label :email, class: "form-label" %>
            <%= f.email_field :email, class: "form-control", placeholder: "Enter your email address" %>
            <div class="form-text">Your email is used for login and important notifications.</div>
          </div>

          <% if user.respond_to?(:phone) %>
          <div class="col-md-6">
            <%= f.label :phone, class: "form-label" %>
            <%= f.telephone_field :phone, class: "form-control", placeholder: "Enter your phone number" %>
          </div>
          <% end %>

          <% if user.respond_to?(:timezone) %>
          <div class="col-md-6">
            <%= f.label :timezone, class: "form-label" %>
            <%= f.select :timezone, options_for_select([
              ['Eastern Time', 'America/New_York'],
              ['Central Time', 'America/Chicago'], 
              ['Mountain Time', 'America/Denver'],
              ['Pacific Time', 'America/Los_Angeles'],
              ['UTC', 'UTC']
            ], user.timezone), { prompt: 'Select timezone' }, { class: "form-select" } %>
          </div>
          <% end %>

          <% if user.respond_to?(:bio) %>
          <div class="col-12">
            <%= f.label :bio, "Bio/About", class: "form-label" %>
            <%= f.text_area :bio, class: "form-control", rows: 3, placeholder: "Tell us a bit about yourself..." %>
          </div>
          <% end %>
          
          <div class="col-12">
            <button type="submit" class="btn btn-primary" aria-label="Save profile changes">
              <i data-lucide="save" aria-hidden="true"></i> Save Changes
            </button>
          </div>
        <% end %>
      </div>
    </div>
  </div>

  <!-- Account Info and Voice Settings - Side by Side Below -->
  <div class="col-lg-6">
    <div class="card h-100">
      <div class="card-header">
        <h5 class="mb-0"><i data-lucide="info" aria-hidden="true"></i> Account Info</h5>
      </div>
      <div class="card-body">
        <div class="row">
          <div class="col-sm-6 mb-3">
            <label class="form-label text-muted small">Account Created</label>
            <div><%= user.created_at.strftime("%B %d, %Y") %></div>
          </div>
          
          <div class="col-sm-6 mb-3">
            <label class="form-label text-muted small">Last Updated</label>
            <div><%= user.updated_at.strftime("%B %d, %Y") %></div>
          </div>

          <% if user.entity.present? %>
          <div class="col-sm-6 mb-3">
            <label class="form-label text-muted small">Company</label>
            <div class="d-flex align-items-center gap-2">
              <i data-lucide="building-2" aria-hidden="true" style="width: 1rem; height: 1rem;"></i>
              <strong><%= user.entity.name %></strong>
            </div>
          </div>
          <% end %>

          <% if user.respond_to?(:onboarded?) %>
          <div class="col-sm-6 mb-3">
            <label class="form-label text-muted small">Onboarding Status</label>
            <div>
              <% if user.onboarded? %>
                <span class="badge bg-success"><i data-lucide="check" aria-hidden="true"></i> Complete</span>
              <% else %>
                <span class="badge bg-warning"><i data-lucide="clock" aria-hidden="true"></i> In Progress</span>
              <% end %>
            </div>
          </div>
          <% end %>
        </div>

      </div>
    </div>
  </div>

  <!-- Voice Settings - Same row as Account Info -->
  <div class="col-lg-6">
    <div class="card h-100">
      <div class="card-header">
        <h5 class="mb-0"><i data-lucide="mic" aria-hidden="true" style="color: #A78BFA;"></i> Voice Settings</h5>
      </div>
      <div class="card-body">
        <div data-controller="voice-settings">
          <%= form_with url: api_tts_preferences_path, method: :patch, local: false, data: { action: "submit->voice-settings#saveSettings" } do |f| %>
            
            <p class="text-muted small mb-3">Configure your preferred voice for AI responses. Enable voice mode anytime using the microphone button in the chat input.</p>

            <div class="row g-3">
              <%# Provider Selection %>
              <div class="col-sm-6">
                <label for="provider" class="form-label small">Voice Provider</label>
                <%= select_tag :provider,
                    options_for_select([
                      ['Eleven Labs (Recommended)', 'eleven_labs'],
                      ['Amazon Polly', 'polly']
                    ], current_user.tts_preferences&.dig('provider') || 'eleven_labs'),
                    class: "form-select form-select-sm",
                    id: "provider",
                    data: { action: "change->voice-settings#switchProvider" } %>
              </div>

              <%# Eleven Labs Voices %>
              <div class="col-sm-6" id="eleven_labs_voices_container" style="<%= (current_user.tts_preferences&.dig('provider') || 'eleven_labs') == 'eleven_labs' ? '' : 'display: none;' %>">
                <label for="eleven_labs_voice_id" class="form-label small">AI Voice</label>
                <% eleven_labs_voice_groups = {
                  'American' => [
                    ['Rachel (Female - Calm)', 'Rachel'],
                    ['Drew (Male - News)', 'Drew'],
                    ['Clyde (Male - Deep)', 'Clyde'],
                    ['Nicole (Female - Whisper)', 'Nicole'],
                    ['Emily (Female - Calm)', 'Emily']
                  ],
                  'British' => [
                    ['George (Male - Warm)', 'George']
                  ],
                  'Australian' => [
                    ['Mimi (Female - Child)', 'Mimi'],
                    ['Charlie (Male - Casual)', 'Charlie']
                  ],
                  'Irish' => [
                    ['Fin (Male - Energetic)', 'Fin']
                  ]
                } %>
                <%= select_tag :eleven_labs_voice_id,
                    grouped_options_for_select(eleven_labs_voice_groups, current_user.tts_preferences&.dig('eleven_labs_voice_id') || 'George'),
                    class: "form-select form-select-sm",
                    id: "eleven_labs_voice_id",
                    data: { action: "change->voice-settings#updatePreview" } %>
              </div>

              <%# Polly Voices %>
              <div class="col-sm-6" id="polly_voices_container" style="<%= (current_user.tts_preferences&.dig('provider') || 'eleven_labs') == 'polly' ? '' : 'display: none;' %>">
                <label for="voice_id" class="form-label small">AI Voice</label>
                <% voice_groups = {
                  'US English' => [
                    ['Aria (Female)', 'Aria'],
                    ['Joanna (Female)', 'Joanna'],
                    ['Matthew (Male)', 'Matthew'],
                    ['Joey (Male)', 'Joey']
                  ],
                  'UK English' => [
                    ['Amy (Female)', 'Amy'],
                    ['Brian (Male)', 'Brian']
                  ],
                  'Australian' => [
                    ['Olivia (Female)', 'Olivia']
                  ]
                } %>
                <%= select_tag :voice_id,
                    grouped_options_for_select(voice_groups, current_user.tts_preferences&.dig('voice_id') || 'Matthew'),
                    class: "form-select form-select-sm",
                    id: "voice_id",
                    data: { action: "change->voice-settings#updatePreview" } %>
              </div>

              <div class="col-sm-6">
                <label for="speed" class="form-label small d-flex justify-content-between align-items-center">
                  <span>Speed</span>
                  <span class="badge bg-secondary" data-voice-settings-target="speedLabel" style="font-size: 0.7rem;">
                    <%= current_user.tts_preferences&.dig('speed') || '1.0' %>x
                  </span>
                </label>
                <%= range_field_tag :speed,
                    current_user.tts_preferences&.dig('speed') || 1.0,
                    min: 0.5, max: 2.0, step: 0.1,
                    class: "form-range",
                    id: "speed",
                    data: { action: "input->voice-settings#updateSpeedLabel" } %>
              </div>

              <div class="col-sm-6">
                <label for="volume" class="form-label small d-flex justify-content-between align-items-center">
                  <span>Volume</span>
                  <span class="badge bg-secondary" data-voice-settings-target="volumeLabel" style="font-size: 0.7rem;">
                    <%= ((current_user.tts_preferences&.dig('volume') || 1.0) * 100).to_i %>%
                  </span>
                </label>
                <%= range_field_tag :volume,
                    current_user.tts_preferences&.dig('volume') || 1.0,
                    min: 0, max: 1, step: 0.1,
                    class: "form-range",
                    id: "volume",
                    data: { action: "input->voice-settings#updateVolumeLabel" } %>
              </div>
            </div>

            <div class="d-flex gap-2 mt-3">
              <button type="button" class="btn btn-outline-primary btn-sm" data-action="click->voice-settings#testVoice">
                <i data-lucide="play" aria-hidden="true"></i> Test Voice
              </button>
              <%= f.submit "Save Settings", class: "btn btn-primary btn-sm" %>
            </div>
          <% end %>

          <div class="alert alert-success mt-3 d-none" data-voice-settings-target="successMessage">
            <i data-lucide="check-circle" aria-hidden="true"></i>
            Settings saved!
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
