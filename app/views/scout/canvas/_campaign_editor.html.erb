<% data = canvas_data || {} %>
<div class="scout-canvas campaign-editor">
  <% campaign = data[:campaign] %>
  <% contact_groups = data[:contact_groups] || current_entity.contact_groups %>
  <% email_templates = data[:email_templates] || current_entity.email_templates %>
  
  <% if campaign.nil? %>
    <div class="alert alert-danger">
      <i data-lucide="alert-triangle" class="me-2" aria-hidden="true"></i>
      Campaign not found. Please try loading a different campaign.
    </div>
  <% else %>
    <div class="canvas-header d-flex justify-content-between align-items-center mb-4">
      <div>
        <h4 class="mb-1">
          <i data-lucide="mail" class="me-2" aria-hidden="true"></i>
          <%= campaign.persisted? ? 'Edit Campaign' : 'New Campaign' %>
        </h4>
        <p class="text-muted mb-0">
          <%= campaign.persisted? ? "Editing: #{campaign.name}" : "Create a new email campaign" %>
        </p>
      </div>
      <div class="d-flex gap-2">
        <button class="btn btn-outline-secondary" onclick="window.scoutLoadCanvas?.('campaign_viewer')" aria-label="Back to campaigns">
          <i data-lucide="arrow-left" class="me-1" aria-hidden="true"></i>
          Back to Campaigns
        </button>
      </div>
    </div>

    <div class="row">
      <!-- Campaign Form -->
      <div class="col-lg-8">
        <div class="card">
          <div class="card-body">
            <form id="campaign-editor-form">
              <input type="hidden" name="campaign_id" value="<%= campaign.id %>">
              
              <!-- Campaign Name -->
              <div class="mb-3">
                <label class="form-label">Campaign Name</label>
                <input type="text" class="form-control" name="name" 
                       value="<%= campaign.name %>" 
                       placeholder="Enter campaign name" required>
              </div>

              <!-- Email Template -->
              <div class="mb-3">
                <label class="form-label">Email Template</label>
                <select class="form-select" name="email_template_id">
                  <option value="">Select a template...</option>
                  <% email_templates.each do |template| %>
                    <option value="<%= template.id %>" 
                            <%= 'selected' if campaign.email_template_id == template.id %>>
                      <%= template.name %> - <%= template.subject %>
                    </option>
                  <% end %>
                </select>
                <small class="form-text text-muted">
                  <a href="#" onclick="window.scoutLoadCanvas?.('email_template_editor', {}); return false;">
                    Create a new template
                  </a>
                </small>
              </div>

              <!-- Contact Groups -->
              <div class="mb-3">
                <label class="form-label">Target Audience</label>
                <div class="contact-groups-selection">
                  <% contact_groups.each do |group| %>
                    <div class="form-check">
                      <input class="form-check-input" type="checkbox" 
                             name="contact_group_ids[]" 
                             value="<%= group.id %>"
                             id="group_<%= group.id %>"
                             <%= 'checked' if campaign.contact_group_ids.include?(group.id) %>>
                      <label class="form-check-label" for="group_<%= group.id %>">
                        <%= group.name %> (<%= group.contacts_count %> contacts)
                      </label>
                    </div>
                  <% end %>
                </div>
                <small class="form-text text-muted">
                  <a href="#" onclick="window.scoutLoadCanvas?.('contact_viewer', { action: 'create_group' }); return false;">
                    Create a new group
                  </a>
                </small>
              </div>

              <!-- Description -->
              <div class="mb-3">
                <label class="form-label">Description (optional)</label>
                <textarea class="form-control" name="description" rows="3" 
                          placeholder="Add notes about this campaign..."><%= campaign.description %></textarea>
              </div>

              <!-- Action Buttons -->
              <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary" aria-label="<%= campaign.persisted? ? 'Update campaign' : 'Create campaign' %>">
                  <i data-lucide="save" class="me-1" aria-hidden="true"></i>
                  <%= campaign.persisted? ? 'Update Campaign' : 'Create Campaign' %>
                </button>

                <% if campaign.persisted? && campaign.status == 'draft' %>
                  <button type="button" class="btn btn-success"
                          onclick="saveThenSendTest()"
                          aria-label="Send test email">
                    <i data-lucide="send" class="me-1" aria-hidden="true"></i>
                    Send Test
                  </button>

                  <button type="button" class="btn btn-info"
                          onclick="saveThenSchedule()"
                          aria-label="Schedule campaign">
                    <i data-lucide="clock" class="me-1" aria-hidden="true"></i>
                    Schedule
                  </button>
                <% end %>
              </div>
            </form>
          </div>
        </div>
      </div>

      <!-- Campaign Info & Preview -->
      <div class="col-lg-4">
        <% if campaign.persisted? %>
          <!-- Campaign Status -->
          <div class="card mb-3">
            <div class="card-body">
              <h6 class="card-title">Campaign Status</h6>
              <div class="d-flex align-items-center mb-2">
                <span class="badge bg-<%= campaign_status_color(campaign.status) %> me-2">
                  <%= campaign.status.humanize %>
                </span>
                <% if campaign.scheduled_at.present? %>
                  <small class="text-muted">
                    Scheduled for <%= campaign.scheduled_at.strftime('%b %d at %l:%M %p') %>
                  </small>
                <% end %>
              </div>
              
              <% if campaign.sent? %>
                <div class="small text-muted">
                  <div>Sent: <%= campaign.sent_count %></div>
                  <div>Opened: <%= campaign.email_deliveries.opened.count %> (<%= campaign.open_rate %>%)</div>
                  <div>Clicked: <%= campaign.email_deliveries.clicked.count %> (<%= campaign.click_rate %>%)</div>
                </div>
              <% end %>
            </div>
          </div>
        <% end %>

        <!-- Email Preview -->
        <div class="card">
          <div class="card-header">
            <h6 class="mb-0">Email Preview</h6>
          </div>
          <div class="card-body">
            <div id="email-preview" class="email-preview-container">
              <% if campaign.email_template %>
                <div class="mb-2">
                  <strong>Subject:</strong> <%= campaign.email_template.subject %>
                </div>
                <div class="mb-2">
                  <strong>From:</strong> <%= campaign.from_name || current_entity.name %> 
                  &lt;<%= campaign.from_email || current_entity.email %>&gt;
                </div>
                <hr>
                <div class="email-content">
                  <%= campaign.email_template.body.html_safe %>
                </div>
              <% else %>
                <p class="text-muted text-center">
                  Select an email template to see preview
                </p>
              <% end %>
            </div>
          </div>
        </div>
      </div>
    </div>
  <% end %>
</div>

<style>
.campaign-editor .contact-groups-selection {
  max-height: 200px;
  overflow-y: auto;
  border: 1px solid #dee2e6;
  border-radius: 0.375rem;
  padding: 0.5rem;
}

.campaign-editor .email-preview-container {
  max-height: 400px;
  overflow-y: auto;
  font-size: 0.9rem;
}

.campaign-editor .email-content {
  line-height: 1.6;
}
</style>

<script>
// Helper function to get campaign status color
function campaign_status_color(status) {
  const colors = {
    'draft': 'secondary',
    'scheduled': 'info',
    'in_progress': 'warning',
    'sent': 'success',
    'completed': 'success',
    'paused': 'warning',
    'stopped': 'danger'
  };
  return colors[status] || 'secondary';
}

const csrfToken = document.querySelector('meta[name="csrf-token"]')?.getAttribute('content');
const apiHeaders = { 'Content-Type': 'application/json', 'X-CSRF-Token': csrfToken };

// Build form data as JSON
function getCampaignFormData() {
  const form = document.getElementById('campaign-editor-form');
  const formData = new FormData(form);
  return {
    name: formData.get('name'),
    email_template_id: formData.get('email_template_id') || null,
    contact_group_ids: formData.getAll('contact_group_ids[]'),
    description: formData.get('description')
  };
}

// Form submission — direct API call
document.getElementById('campaign-editor-form')?.addEventListener('submit', async function(e) {
  e.preventDefault();
  const campaignId = new FormData(this).get('campaign_id');
  const data = getCampaignFormData();
  const isUpdate = !!campaignId;
  const submitBtn = this.querySelector('button[type="submit"]');
  submitBtn.disabled = true;

  try {
    const resp = await fetch(isUpdate ? `/api/v1/campaigns/${campaignId}` : '/api/v1/campaigns', {
      method: isUpdate ? 'PATCH' : 'POST',
      headers: apiHeaders,
      body: JSON.stringify(data)
    });
    const result = await resp.json();
    if (resp.ok || result.success) {
      const newId = result.id || result.data?.id || campaignId;
      window.scoutLoadCanvas?.('campaign_editor', { campaign_id: newId }, true);
    } else {
      alert(result.errors?.join(', ') || result.message || 'Failed to save campaign');
    }
  } catch (err) { alert('Error: ' + err.message); }
  finally { submitBtn.disabled = false; }
});

// Save then send test — API call
async function saveThenSendTest() {
  const campaignId = new FormData(document.getElementById('campaign-editor-form')).get('campaign_id');
  if (!campaignId) { alert('Please save the campaign first before sending a test'); return; }
  try {
    const resp = await fetch(`/api/v1/campaigns/${campaignId}/send_test`, {
      method: 'POST', headers: apiHeaders
    });
    const data = await resp.json();
    if (data.success || resp.ok) {
      alert('Test email sent successfully!');
    } else {
      alert(data.message || data.error || 'Failed to send test');
    }
  } catch (e) { alert('Error: ' + e.message); }
}

// Save then schedule — API call
async function saveThenSchedule() {
  const campaignId = new FormData(document.getElementById('campaign-editor-form')).get('campaign_id');
  if (!campaignId) { alert('Please save the campaign first before scheduling'); return; }
  const scheduledAt = prompt('Schedule for (YYYY-MM-DD HH:MM):');
  if (!scheduledAt) return;
  try {
    const resp = await fetch(`/api/v1/campaigns/${campaignId}/schedule`, {
      method: 'POST', headers: apiHeaders,
      body: JSON.stringify({ scheduled_at: scheduledAt })
    });
    const data = await resp.json();
    if (data.success || resp.ok) {
      window.scoutLoadCanvas?.('campaign_editor', { campaign_id: campaignId }, true);
    } else {
      alert(data.message || data.error || 'Failed to schedule');
    }
  } catch (e) { alert('Error: ' + e.message); }
}

// Update preview when template changes — load template editor
document.querySelector('select[name="email_template_id"]')?.addEventListener('change', function() {
  // Preview is already shown via the select; no action needed
});
</script>

<% 
# Helper method for status colors (in case it's not available)
def campaign_status_color(status)
  case status
  when 'draft' then 'secondary'
  when 'scheduled' then 'info'
  when 'in_progress', 'paused' then 'warning'
  when 'sent', 'completed' then 'success'
  when 'stopped' then 'danger'
  else 'secondary'
  end
end
%>
