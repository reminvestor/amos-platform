<div class="task-progress-container p-4">
  <% if task_list.present? && task_list[:tasks].present? %>
    <% 
      total_tasks = task_list[:tasks].size
      completed_tasks = task_list[:tasks].count { |t| (t[:status] || t['status']) == 'completed' }
      failed_tasks = task_list[:tasks].count { |t| (t[:status] || t['status']) == 'failed' }
      in_progress_tasks = task_list[:tasks].count { |t| (t[:status] || t['status']) == 'in_progress' }
      pending_tasks = task_list[:tasks].count { |t| (t[:status] || t['status']) == 'pending' }
      # Only show working status if there are pending or in-progress tasks
      is_working = in_progress_tasks > 0 || pending_tasks > 0
    %>
    
    <div class="task-header">
      <h2><%= task_list[:title] || "Task Progress" %></h2>
      <div class="timestamp">
        Started <%= task_list[:created_at] ? time_ago_in_words(task_list[:created_at]) + " ago" : "recently" %>
      </div>
    </div>
    
    <% 
      # Already calculated above
      progress_percentage = total_tasks > 0 ? (completed_tasks.to_f / total_tasks * 100).round : 0
    %>
    
    <div class="progress-bar-container">
      <div class="progress-stats">
        <span><%= completed_tasks %> of <%= total_tasks %> tasks completed</span>
        <span><%= progress_percentage %>%</span>
      </div>
      <div class="progress">
        <div class="progress-bar" style="width: <%= progress_percentage %>%">
          <% if progress_percentage > 10 %>
            <%= progress_percentage %>%
          <% end %>
        </div>
      </div>
    </div>
    
    <div class="task-list">
      <% task_list[:tasks].each do |task| %>
        <div class="task-item">
          <% task_status = task[:status] || task['status'] %>
          <div class="task-status-icon <%= task_status %>">
            <% case task_status %>
            <% when 'pending' %>
              <i data-lucide="circle" aria-hidden="true"></i>
            <% when 'in_progress' %>
              <i data-lucide="loader-circle" class="icon-spin" aria-hidden="true"></i>
            <% when 'completed' %>
              <i data-lucide="check" aria-hidden="true"></i>
            <% when 'failed' %>
              <i data-lucide="x" aria-hidden="true"></i>
            <% when 'skipped' %>
              <i data-lucide="skip-forward" aria-hidden="true"></i>
            <% end %>
          </div>
          
          <div class="task-content">
            <div class="task-description">
              <%= task[:description] || task['description'] %>
            </div>
            <% task_details = task[:details] || task['details'] %>
            <% if task_details.present? %>
              <div class="task-details">
                <%= task_details %>
              </div>
            <% end %>
          </div>
          
          <div class="task-timestamp">
            <% task_completed_at = task[:completed_at] || task['completed_at'] %>
            <% task_failed_at = task[:failed_at] || task['failed_at'] %>
            <% if task_completed_at %>
              Completed <%= time_ago_in_words(task_completed_at) %> ago
            <% elsif task_failed_at %>
              Failed <%= time_ago_in_words(task_failed_at) %> ago
            <% elsif task_status == 'in_progress' %>
              In progress...
            <% end %>
          </div>
          
          <%# Feedback buttons for completed/failed tasks %>
          <% if task_status == 'completed' || task_status == 'failed' %>
            <% 
              # Try to get execution context for attribution
              execution_id = task[:execution_id] || task['execution_id'] || task_list[:execution_id]
              agent_id = task[:agent_id] || task['agent_id'] || task_list[:agent_id]
              task_run_id = task[:task_run_id] || task['task_run_id'] || task_list[:task_run_id]
              
              # Determine feedbackable type and ID
              if execution_id
                feedbackable_type = 'AgentPluginExecution'
                feedbackable_id = execution_id
              elsif task_run_id
                feedbackable_type = 'ScheduledTaskRun'
                feedbackable_id = task_run_id
              else
                feedbackable_type = 'AgentPlugin'
                feedbackable_id = agent_id || 0
              end
            %>
            <div class="task-feedback d-flex align-items-center gap-1" data-task-idx="<%= task[:idx] || task['idx'] %>">
              <button class="btn btn-sm btn-link text-muted task-feedback-btn" 
                      data-rating="1"
                      data-feedbackable-type="<%= feedbackable_type %>"
                      data-feedbackable-id="<%= feedbackable_id %>"
                      title="This task result was helpful">
                <i data-lucide="thumbs-up" style="width: 14px; height: 14px;"></i>
              </button>
              <button class="btn btn-sm btn-link text-muted task-feedback-btn" 
                      data-rating="-1"
                      data-feedbackable-type="<%= feedbackable_type %>"
                      data-feedbackable-id="<%= feedbackable_id %>"
                      title="This task result was not helpful">
                <i data-lucide="thumbs-down" style="width: 14px; height: 14px;"></i>
              </button>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>
    
    <% if is_working %>
      <div class="working-status">
        <i data-lucide="settings" aria-hidden="true"></i>
        <span>Scout is working on your request...</span>
      </div>
    <% end %>
  <% else %>
    <div class="empty-state">
      <i data-lucide="list-checks" aria-hidden="true"></i>
      <h3>No Active Tasks</h3>
      <p>Task progress will appear here when Scout creates a task list for complex operations.</p>
    </div>
  <% end %>
</div>

<style>
  .task-feedback {
    margin-left: auto;
    opacity: 0.6;
    transition: opacity 0.2s ease;
  }
  
  .task-item:hover .task-feedback {
    opacity: 1;
  }
  
  .task-feedback-btn {
    padding: 2px 4px !important;
  }
  
  .task-feedback-btn:hover {
    transform: scale(1.1);
  }
  
  .task-feedback-btn.text-success i {
    stroke: var(--accent-green);
  }
  
  .task-feedback-btn.text-danger i {
    stroke: var(--status-error-text);
  }
</style>

<script>
(function() {
  // Task feedback buttons
  document.querySelectorAll('.task-feedback-btn').forEach(btn => {
    btn.addEventListener('click', function(e) {
      e.stopPropagation();
      
      const rating = parseInt(this.dataset.rating);
      const feedbackableType = this.dataset.feedbackableType;
      const feedbackableId = this.dataset.feedbackableId;
      const container = this.closest('.task-feedback');
      
      // Skip if no valid feedbackable
      if (!feedbackableId || feedbackableId === '0') {
        console.warn('No feedbackable ID available for this task');
        container.innerHTML = '<span class="text-muted small">N/A</span>';
        return;
      }
      
      // Visual feedback
      this.classList.add(rating > 0 ? 'text-success' : 'text-danger');
      
      // Submit feedback
      fetch('/scout/feedback', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]')?.content
        },
        body: JSON.stringify({
          feedback: {
            feedbackable_type: feedbackableType,
            feedbackable_id: feedbackableId,
            rating: rating,
            metadata: {
              source: 'task_progress',
              task_idx: container.dataset.taskIdx
            }
          }
        })
      })
      .then(res => res.json())
      .then(data => {
        if (data.success) {
          container.innerHTML = `<span class="${rating > 0 ? 'text-success' : 'text-warning'} small"><i data-lucide="check" style="width: 14px; height: 14px;"></i></span>`;
          if (typeof lucide !== 'undefined') lucide.createIcons();
        }
      })
      .catch(err => {
        console.error('Task feedback failed:', err);
        this.classList.remove('text-success', 'text-danger');
      });
    });
  });
  
  // Initialize icons
  if (typeof lucide !== 'undefined') lucide.createIcons();
})();
</script>
