<div class="scout-canvas contact-viewer">
  <div class="canvas-header d-flex justify-content-between align-items-center mb-4">
    <div>
      <h4 class="mb-1">
        <i data-lucide="users" class="text-primary me-2" aria-hidden="true"></i>
        Contacts
      </h4>
      <p class="text-muted mb-0">Manage your customer database</p>
    </div>
    <div class="d-flex gap-2">
      <button class="btn btn-outline-secondary" onclick="scoutImportContacts()" aria-label="Import contacts">
        <i data-lucide="upload" class="me-1" aria-hidden="true"></i>
        Import
      </button>
      <button class="btn btn-primary" onclick="scoutCreateContact()" aria-label="Add new contact">
        <i data-lucide="plus" class="me-1" aria-hidden="true"></i>
        Add Contact
      </button>
    </div>
  </div>
  
  <!-- Quick Stats -->
  <div class="row mb-4">
    <div class="col-md-3">
      <div class="stat-card bg-light border-0 h-100">
        <div class="stat-card-body p-3">
          <div class="d-flex align-items-center">
            <div class="stat-icon bg-primary bg-opacity-10 rounded-circle p-2 me-3">
              <i data-lucide="users" class="text-primary" aria-hidden="true"></i>
            </div>
            <div>
              <div class="stat-number h5 mb-0"><%= number_with_delimiter(stats[:total_contacts]) %></div>
              <div class="stat-label text-muted small">Total Contacts</div>
            </div>
          </div>
        </div>
      </div>
    </div>
    <div class="col-md-3">
      <div class="stat-card bg-light border-0 h-100">
        <div class="stat-card-body p-3">
          <div class="d-flex align-items-center">
            <div class="stat-icon bg-success bg-opacity-10 rounded-circle p-2 me-3">
              <i data-lucide="user-plus" class="text-success" aria-hidden="true"></i>
            </div>
            <div>
              <div class="stat-number h5 mb-0"><%= number_with_delimiter(stats[:recent_contacts]) %></div>
              <div class="stat-label text-muted small">This Week</div>
            </div>
          </div>
        </div>
      </div>
    </div>
    <div class="col-md-3">
      <div class="stat-card bg-light border-0 h-100">
        <div class="stat-card-body p-3">
          <div class="d-flex align-items-center">
            <div class="stat-icon bg-info bg-opacity-10 rounded-circle p-2 me-3">
              <i data-lucide="layers" class="text-info" aria-hidden="true"></i>
            </div>
            <div>
              <div class="stat-number h5 mb-0"><%= number_with_delimiter(stats[:contact_groups]) %></div>
              <div class="stat-label text-muted small">Contact Groups</div>
            </div>
          </div>
        </div>
      </div>
    </div>
    <div class="col-md-3">
      <div class="stat-card bg-light border-0 h-100">
        <div class="stat-card-body p-3">
          <div class="d-flex align-items-center">
            <div class="stat-icon bg-warning bg-opacity-10 rounded-circle p-2 me-3">
              <i data-lucide="star" class="text-warning" aria-hidden="true"></i>
            </div>
            <div>
              <div class="stat-number h5 mb-0"><%= contacts.where.not(tags: [nil, '']).count %></div>
              <div class="stat-label text-muted small">Tagged</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
  
  <!-- Search and Filters -->
  <div class="row mb-4">
    <div class="col-md-6">
      <div class="input-group">
        <span class="input-group-text"><i data-lucide="search" aria-hidden="true"></i></span>
        <input type="text" class="form-control" id="contactSearch"
               placeholder="Search contacts by name, email, or company"
               aria-label="Search contacts by name, email, or company">
      </div>
    </div>
    <div class="col-md-3">
      <select class="form-select" id="contactGroupFilter">
        <option value="">All Groups</option>
        <% entity.contact_groups.each do |group| %>
          <option value="<%= group.id %>"><%= group.name %></option>
        <% end %>
      </select>
    </div>
    <div class="col-md-3">
      <select class="form-select" id="contactSourceFilter">
        <option value="">All Sources</option>
        <option value="website">Website</option>
        <option value="manual">Manual Entry</option>
        <option value="import">Import</option>
        <option value="landing_page">Landing Page</option>
      </select>
    </div>
  </div>
  
  <% if contacts.any? %>
    <!-- Contacts Table -->
    <div class="card border-0 shadow-sm">
      <div class="card-header bg-light d-flex justify-content-between align-items-center">
        <h6 class="mb-0">
          <i data-lucide="list" class="me-2" aria-hidden="true"></i>
          Recent Contacts
        </h6>
        <div class="d-flex gap-2">
          <button class="btn btn-sm btn-outline-secondary" onclick="scoutSelectAllContacts()" aria-label="Select all contacts">
            <i data-lucide="check-square" class="me-1" aria-hidden="true"></i>
            Select All
          </button>
          <button class="btn btn-sm btn-outline-primary" onclick="scoutExportContacts()" aria-label="Export contacts">
            <i data-lucide="download" class="me-1" aria-hidden="true"></i>
            Export
          </button>
        </div>
      </div>
      <div class="table-responsive">
        <table class="table table-hover mb-0" id="contactsTable">
          <thead class="table-light">
            <tr>
              <th width="40">
                <input type="checkbox" class="form-check-input" id="selectAllCheckbox" 
                       onchange="scoutToggleAllContacts(this)">
              </th>
              <th>Name</th>
              <th>Email</th>
              <th>Company</th>
              <th>Source</th>
              <th>Groups</th>
              <th>Added</th>
              <th width="120">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% contacts.each do |contact| %>
              <tr data-contact-id="<%= contact.id %>">
                <td class="ps-2">
                  <input 
                    type="checkbox" 
                    class="form-check-input contact-checkbox" 
                    value="<%= contact.id %>">
                </td>
                <td>
                  <div class="d-flex align-items-center">
                    <div class="contact-avatar me-3">
                      <%= contact.first_name&.first&.upcase || contact.email&.first&.upcase || 'C' %>
                    </div>
                    <div>
                      <div class="fw-medium mb-1">
                        <%= "#{contact.first_name} #{contact.last_name}".strip.presence || 'No Name' %>
                      </div>
                      <small class="text-muted">Contact</small>
                    </div>
                  </div>
                </td>
                <td>
                  <a href="mailto:<%= contact.email %>" class="text-decoration-none">
                    <%= contact.email %>
                  </a>
                </td>
                <td>
                  <span class="text-muted">-</span>
                </td>
                <td>
                  <span class="text-muted">unknown</span>
                </td>
                <td>
                  <% if contact.contact_groups.any? %>
                    <% contact.contact_groups.limit(2).each do |group| %>
                      <span class="badge bg-primary me-1"><%= group.name %></span>
                    <% end %>
                    <% if contact.contact_groups.count > 2 %>
                      <span class="badge bg-light text-dark">+<%= contact.contact_groups.count - 2 %></span>
                    <% end %>
                  <% else %>
                    <span class="text-muted">No groups</span>
                  <% end %>
                </td>
                <td>
                  <small class="text-muted">
                    <%= time_ago_in_words(contact.created_at) %> ago
                  </small>
                </td>
                <td>
                  <div class="dropdown">
                    <button
                      class="btn btn-sm btn-outline-secondary"
                      onclick="scoutViewContact(<%= contact.id %>)"
                      aria-label="View contact <%= "#{contact.first_name} #{contact.last_name}".strip.presence || contact.email %>">
                      <i data-lucide="eye" aria-hidden="true"></i>
                    </button>
                    <button
                      class="btn btn-sm btn-outline-primary ms-1"
                      onclick="scoutEditContact(<%= contact.id %>)"
                      aria-label="Edit contact <%= "#{contact.first_name} #{contact.last_name}".strip.presence || contact.email %>">
                      <i data-lucide="pencil" aria-hidden="true"></i>
                    </button>

                    <button class="btn btn-sm btn-outline-secondary dropdown-toggle ms-1" type="button" data-bs-toggle="dropdown" aria-label="More actions for <%= "#{contact.first_name} #{contact.last_name}".strip.presence || contact.email %>">
                      <i data-lucide="more-horizontal" aria-hidden="true"></i>
                    </button>
                    <ul class="dropdown-menu">
                      <li><a class="dropdown-item" href="#" onclick="scoutAddToGroup(<%= contact.id %>)">
                        <i data-lucide="users" class="me-2" aria-hidden="true"></i>Add to Group
                      </a></li>
                      <li><a class="dropdown-item" href="#" onclick="scoutSendEmail(<%= contact.id %>)">
                        <i data-lucide="mail" class="me-2" aria-hidden="true"></i>Send Email
                      </a></li>
                      <li><hr class="dropdown-divider"></li>
                      <li><a class="dropdown-item text-danger" href="#" onclick="scoutDeleteContact(<%= contact.id %>)">
                        <i data-lucide="trash-2" class="me-2" aria-hidden="true"></i>Delete
                      </a></li>
                    </ul>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
      <div class="card-footer bg-light">
        <div class="d-flex justify-content-between align-items-center">
          <small class="text-muted">
            Showing <%= contacts.count %> of <%= stats[:total_contacts] %> contacts
          </small>
          <div class="d-flex gap-2">
            <button class="btn btn-sm btn-outline-secondary" onclick="scoutLoadMoreContacts()" aria-label="Load more contacts">
              Load More
            </button>
            <button class="btn btn-sm btn-primary" onclick="scoutCreateContact()" aria-label="Add new contact">
              <i data-lucide="plus" class="me-1" aria-hidden="true"></i>
              Add Contact
            </button>
          </div>
        </div>
      </div>
    </div>
  <% else %>
    <!-- Empty State -->
    <div class="empty-state text-center py-5">
      <div class="empty-icon mb-3">
        <i data-lucide="users" class="text-muted icon-4x" aria-hidden="true"></i>
      </div>
      <h5 class="text-muted">No contacts yet</h5>
      <p class="text-muted mb-4">
        Start building your customer database by adding your first contact.<br>
        You can add contacts manually, import from a file, or capture them through landing pages.
      </p>
      <div class="d-flex gap-2 justify-content-center">
        <button class="btn btn-primary" onclick="scoutCreateContact()" aria-label="Add your first contact">
          <i data-lucide="plus" class="me-2" aria-hidden="true"></i>
          Add Your First Contact
        </button>
        <button class="btn btn-outline-secondary" onclick="scoutImportContacts()" aria-label="Import contacts">
          <i data-lucide="upload" class="me-2" aria-hidden="true"></i>
          Import Contacts
        </button>
      </div>
    </div>
  <% end %>
</div>

<script>
// Contact viewer functionality
function scoutCreateContact() {
  window.scoutLoadCanvas?.('contact_generator');
}

function scoutViewContact(contactId) {
  window.scoutSendMessage?.(`Show me details for contact ${contactId}`);
}

function scoutEditContact(contactId) {
  window.scoutSendMessage?.(`Edit contact ${contactId}`);
}

function scoutDeleteContact(contactId) {
  if (confirm('Are you sure you want to delete this contact?')) {
    window.scoutSendMessage?.(`Delete contact ${contactId}`);
  }
}

function scoutAddToGroup(contactId) {
  window.scoutSendMessage?.(`Add contact ${contactId} to a group`);
}

function scoutSendEmail(contactId) {
  window.scoutSendMessage?.(`Create an email campaign for contact ${contactId}`);
}

function scoutImportContacts() {
  window.scoutSendMessage?.("Help me import contacts from a file");
}

function scoutExportContacts() {
  const selectedContacts = getSelectedContacts();
  if (selectedContacts.length > 0) {
    window.scoutSendMessage?.(`Export ${selectedContacts.length} selected contacts`);
  } else {
    window.scoutSendMessage?.("Export all contacts to a file");
  }
}

function scoutSelectAllContacts() {
  const checkboxes = document.querySelectorAll('.contact-checkbox');
  const selectAllChecked = document.getElementById('selectAllCheckbox').checked;
  
  checkboxes.forEach(checkbox => {
    checkbox.checked = !selectAllChecked;
  });
  
  document.getElementById('selectAllCheckbox').checked = !selectAllChecked;
}

function scoutToggleAllContacts(checkbox) {
  const checkboxes = document.querySelectorAll('.contact-checkbox');
  checkboxes.forEach(cb => cb.checked = checkbox.checked);
}

function scoutLoadMoreContacts() {
  window.scoutSendMessage?.("Load more contacts");
}

function getSelectedContacts() {
  const checkboxes = document.querySelectorAll('.contact-checkbox:checked');
  return Array.from(checkboxes).map(cb => cb.value);
}

// Search and filter functionality
document.addEventListener('DOMContentLoaded', function() {
  const searchInput = document.getElementById('contactSearch');
  const groupFilter = document.getElementById('contactGroupFilter');
  const sourceFilter = document.getElementById('contactSourceFilter');
  
  if (searchInput) {
    searchInput.addEventListener('input', debounce(filterContacts, 300));
  }
  
  if (groupFilter) {
    groupFilter.addEventListener('change', filterContacts);
  }
  
  if (sourceFilter) {
    sourceFilter.addEventListener('change', filterContacts);
  }
});

function filterContacts() {
  const searchTerm = document.getElementById('contactSearch')?.value.toLowerCase() || '';
  const groupFilter = document.getElementById('contactGroupFilter')?.value || '';
  const sourceFilter = document.getElementById('contactSourceFilter')?.value || '';
  const rows = document.querySelectorAll('#contactsTable tbody tr');
  
  rows.forEach(row => {
    const name = row.querySelector('td:nth-child(2)')?.textContent.toLowerCase() || '';
    const email = row.querySelector('td:nth-child(3)')?.textContent.toLowerCase() || '';
    const company = row.querySelector('td:nth-child(4)')?.textContent.toLowerCase() || '';
    const source = row.querySelector('td:nth-child(5)')?.textContent.toLowerCase() || '';
    
    const matchesSearch = !searchTerm || 
                         name.includes(searchTerm) || 
                         email.includes(searchTerm) || 
                         company.includes(searchTerm);
                         
    const matchesSource = !sourceFilter || source.includes(sourceFilter.toLowerCase());
    
    // For group filter, we'd need more complex logic to check if contact is in selected group
    const matchesGroup = !groupFilter; // Simplified for now
    
    if (matchesSearch && matchesSource && matchesGroup) {
      row.style.display = '';
    } else {
      row.style.display = 'none';
    }
  });
}

function debounce(func, wait) {
  let timeout;
  return function executedFunction(...args) {
    const later = () => {
      clearTimeout(timeout);
      func(...args);
    };
    clearTimeout(timeout);
    timeout = setTimeout(later, wait);
  };
}
</script>

<style>
.contact-avatar {
  font-weight: 600;
  flex-shrink: 0;
}

.contact-checkbox:checked + td {
  background-color: rgba(13, 110, 253, 0.1);
}

.stat-card {
  transition: transform 0.2s ease;
  cursor: pointer;
}

.stat-card:hover {
  transform: translateY(-2px);
}

.table tbody tr {
  transition: background-color 0.2s ease;
}

.table tbody tr:hover {
  background-color: rgba(0, 0, 0, 0.02);
}

.empty-state {
  max-width: 600px;
  margin: 0 auto;
}
</style> 