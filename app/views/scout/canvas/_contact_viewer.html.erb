<div class="scout-canvas canvas-container contact-viewer">
  <!-- Page Header -->
  <div class="canvas-page-header">
    <h1 class="canvas-page-title">
      <i data-lucide="users"></i>
      Contacts
    </h1>
    <p class="canvas-page-subtitle">Manage your customer database</p>
  </div>

  <div class="canvas-actions-bar">
    <div></div>
    <div class="canvas-actions">
      <button onclick="scoutImportContacts()" 
              aria-label="Import contacts"
              class="canvas-btn secondary">
        <i data-lucide="upload"></i>
        Import
      </button>
      <button onclick="scoutCreateContact()" 
              aria-label="Add new contact"
              class="canvas-btn primary">
        <i data-lucide="plus"></i>
        Add Contact
      </button>
    </div>
  </div>
  
  <!-- Quick Stats -->
  <div class="canvas-stats-grid">
    <div class="canvas-stat-card purple">
      <div>
        <p class="canvas-stat-label">Total Contacts</p>
        <p class="canvas-stat-value"><%= number_with_delimiter(stats[:total_contacts]) %></p>
      </div>
      <div class="canvas-stat-icon purple">
        <i data-lucide="users"></i>
      </div>
    </div>

    <div class="canvas-stat-card green">
      <div>
        <p class="canvas-stat-label">This Week</p>
        <p class="canvas-stat-value"><%= number_with_delimiter(stats[:recent_contacts]) %></p>
      </div>
      <div class="canvas-stat-icon green">
        <i data-lucide="user-plus"></i>
      </div>
    </div>

    <div class="canvas-stat-card cyan">
      <div>
        <p class="canvas-stat-label">Contact Groups</p>
        <p class="canvas-stat-value"><%= number_with_delimiter(stats[:contact_groups]) %></p>
      </div>
      <div class="canvas-stat-icon cyan">
        <i data-lucide="layers"></i>
      </div>
    </div>

    <div class="canvas-stat-card yellow">
      <div>
        <p class="canvas-stat-label">Tagged</p>
        <p class="canvas-stat-value"><%= contacts.where.not(tags: [nil, '']).count %></p>
      </div>
      <div class="canvas-stat-icon yellow">
        <i data-lucide="star"></i>
      </div>
    </div>
  </div>
  
  <!-- Search and Filters -->
  <div class="canvas-filters-grid">
    <div class="canvas-search-wrapper">
      <i data-lucide="search"></i>
      <input type="text" 
             id="contactSearch"
             placeholder="Search contacts..."
             class="canvas-search-input"
             aria-label="Search contacts by name, email, or company">
    </div>
    <select id="contactGroupFilter" class="canvas-select">
      <option value="">All Groups</option>
      <% entity.contact_groups.each do |group| %>
        <option value="<%= group.id %>"><%= group.name %></option>
      <% end %>
    </select>
    <select id="contactSourceFilter" class="canvas-select">
      <option value="">All Sources</option>
      <option value="website">Website</option>
      <option value="manual">Manual Entry</option>
      <option value="import">Import</option>
      <option value="landing_page">Landing Page</option>
    </select>
  </div>
  
  <% if contacts.any? %>
    <!-- Contacts Table -->
    <div class="canvas-card">
      <div class="canvas-card-header">
        <h6>
          <i data-lucide="list"></i>
          Recent Contacts
        </h6>
        <div class="canvas-actions">
          <button onclick="scoutSelectAllContacts()" 
                  aria-label="Select all contacts"
                  class="canvas-btn secondary sm">
            <i data-lucide="check-square"></i>
            Select All
          </button>
          <button onclick="scoutExportContacts()" 
                  aria-label="Export contacts"
                  class="canvas-btn outline-cyan sm">
            <i data-lucide="download"></i>
            Export
          </button>
        </div>
      </div>
      <div class="canvas-table-wrapper">
        <table class="canvas-table">
          <thead>
            <tr>
              <th style="width: 40px;">
                <input type="checkbox" 
                       id="selectAllCheckbox" 
                       onchange="scoutToggleAllContacts(this)"
                       class="canvas-checkbox">
              </th>
              <th>Name</th>
              <th>Email</th>
              <th>Company</th>
              <th>Source</th>
              <th>Groups</th>
              <th>Added</th>
              <th style="width: 120px;">Actions</th>
            </tr>
          </thead>
          <tbody id="contactsTable">
            <% contacts.each do |contact| %>
              <tr data-contact-id="<%= contact.id %>">
                <td>
                  <input 
                    type="checkbox" 
                    class="contact-checkbox canvas-checkbox" 
                    value="<%= contact.id %>">
                </td>
                <td>
                  <div class="d-flex align-items-center gap-3">
                    <div class="canvas-avatar">
                      <%= contact.first_name&.first&.upcase || contact.email&.first&.upcase || 'C' %>
                    </div>
                    <div>
                      <div class="fw-semibold">
                        <%= "#{contact.first_name} #{contact.last_name}".strip.presence || 'No Name' %>
                      </div>
                      <small class="text-muted">Contact</small>
                    </div>
                  </div>
                </td>
                <td>
                  <a href="mailto:<%= contact.email %>" class="canvas-link">
                    <%= contact.email %>
                  </a>
                </td>
                <td>
                  <span class="text-muted">-</span>
                </td>
                <td>
                  <span class="text-muted">unknown</span>
                </td>
                <td>
                  <% if contact.contact_groups.any? %>
                    <div class="d-flex flex-wrap gap-1">
                      <% contact.contact_groups.limit(2).each do |group| %>
                        <span class="canvas-badge purple"><%= group.name %></span>
                      <% end %>
                      <% if contact.contact_groups.count > 2 %>
                        <span class="canvas-badge gray">+<%= contact.contact_groups.count - 2 %></span>
                      <% end %>
                    </div>
                  <% else %>
                    <span class="text-muted">No groups</span>
                  <% end %>
                </td>
                <td>
                  <small class="text-muted">
                    <%= time_ago_in_words(contact.created_at) %> ago
                  </small>
                </td>
                <td>
                  <div class="d-flex gap-1">
                    <button onclick="scoutViewContact(<%= contact.id %>)"
                            aria-label="View contact <%= "#{contact.first_name} #{contact.last_name}".strip.presence || contact.email %>"
                            class="canvas-btn outline-cyan sm">
                      <i data-lucide="eye"></i>
                    </button>
                    <button onclick="scoutEditContact(<%= contact.id %>)"
                            aria-label="Edit contact <%= "#{contact.first_name} #{contact.last_name}".strip.presence || contact.email %>"
                            class="canvas-btn outline-purple sm">
                      <i data-lucide="pencil"></i>
                    </button>
                    <div class="dropdown">
                      <button class="canvas-btn secondary sm"
                              data-bs-toggle="dropdown"
                              aria-label="More actions for <%= "#{contact.first_name} #{contact.last_name}".strip.presence || contact.email %>">
                        <i data-lucide="more-horizontal"></i>
                      </button>
                      <ul class="dropdown-menu canvas-dropdown-menu">
                        <li><a class="dropdown-item" href="#" onclick="scoutAddToGroup(<%= contact.id %>)">
                          <i data-lucide="users" class="me-2"></i>Add to Group
                        </a></li>
                        <li><a class="dropdown-item" href="#" onclick="scoutSendEmail(<%= contact.id %>)">
                          <i data-lucide="mail" class="me-2"></i>Send Email
                        </a></li>
                        <li><hr class="dropdown-divider"></li>
                        <li><a class="dropdown-item danger" href="#" onclick="scoutDeleteContact(<%= contact.id %>)">
                          <i data-lucide="trash-2" class="me-2"></i>Delete
                        </a></li>
                      </ul>
                    </div>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
      <div class="canvas-card-footer">
        <small>
          Showing <%= contacts.count %> of <%= stats[:total_contacts] %> contacts
        </small>
        <div class="canvas-actions">
          <button onclick="scoutLoadMoreContacts()" 
                  aria-label="Load more contacts"
                  class="canvas-btn secondary sm">
            Load More
          </button>
          <button onclick="scoutCreateContact()" 
                  aria-label="Add new contact"
                  class="canvas-btn primary sm">
            <i data-lucide="plus"></i>
            Add Contact
          </button>
        </div>
      </div>
    </div>
  <% else %>
    <!-- Empty State -->
    <div class="canvas-empty-state">
      <i data-lucide="users"></i>
      <h5>No contacts yet</h5>
      <p>
        Start building your customer database by adding your first contact.<br>
        You can add contacts manually, import from a file, or capture them through landing pages.
      </p>
      <div class="canvas-empty-actions">
        <button onclick="scoutCreateContact()" 
                aria-label="Add your first contact"
                class="canvas-btn primary">
          <i data-lucide="plus"></i>
          Add Your First Contact
        </button>
        <button onclick="scoutImportContacts()" 
                aria-label="Import contacts"
                class="canvas-btn secondary">
          <i data-lucide="upload"></i>
          Import Contacts
        </button>
      </div>
    </div>
  <% end %>
</div>

<script>
// Contact viewer functionality
function scoutCreateContact() {
  window.scoutLoadCanvas?.('contact_generator');
}

function scoutViewContact(contactId) {
  window.scoutSendMessage?.(`Show me details for contact ${contactId}`);
}

function scoutEditContact(contactId) {
  window.scoutSendMessage?.(`Edit contact ${contactId}`);
}

function scoutDeleteContact(contactId) {
  if (confirm('Are you sure you want to delete this contact?')) {
    window.scoutSendMessage?.(`Delete contact ${contactId}`);
  }
}

function scoutAddToGroup(contactId) {
  window.scoutSendMessage?.(`Add contact ${contactId} to a group`);
}

function scoutSendEmail(contactId) {
  window.scoutSendMessage?.(`Create an email campaign for contact ${contactId}`);
}

function scoutImportContacts() {
  window.scoutSendMessage?.("Help me import contacts from a file");
}

function scoutExportContacts() {
  const selectedContacts = getSelectedContacts();
  if (selectedContacts.length > 0) {
    window.scoutSendMessage?.(`Export ${selectedContacts.length} selected contacts`);
  } else {
    window.scoutSendMessage?.("Export all contacts to a file");
  }
}

function scoutSelectAllContacts() {
  const checkboxes = document.querySelectorAll('.contact-checkbox');
  const selectAllChecked = document.getElementById('selectAllCheckbox').checked;
  
  checkboxes.forEach(checkbox => {
    checkbox.checked = !selectAllChecked;
  });
  
  document.getElementById('selectAllCheckbox').checked = !selectAllChecked;
}

function scoutToggleAllContacts(checkbox) {
  const checkboxes = document.querySelectorAll('.contact-checkbox');
  checkboxes.forEach(cb => cb.checked = checkbox.checked);
}

function scoutLoadMoreContacts() {
  window.scoutSendMessage?.("Load more contacts");
}

function getSelectedContacts() {
  const checkboxes = document.querySelectorAll('.contact-checkbox:checked');
  return Array.from(checkboxes).map(cb => cb.value);
}

// Search and filter functionality
document.addEventListener('DOMContentLoaded', function() {
  const searchInput = document.getElementById('contactSearch');
  const groupFilter = document.getElementById('contactGroupFilter');
  const sourceFilter = document.getElementById('contactSourceFilter');
  
  if (searchInput) {
    searchInput.addEventListener('input', debounce(filterContacts, 300));
  }
  
  if (groupFilter) {
    groupFilter.addEventListener('change', filterContacts);
  }
  
  if (sourceFilter) {
    sourceFilter.addEventListener('change', filterContacts);
  }
  
  if (typeof lucide !== 'undefined') {
    lucide.createIcons();
  }
});

function filterContacts() {
  const searchTerm = document.getElementById('contactSearch')?.value.toLowerCase() || '';
  const groupFilter = document.getElementById('contactGroupFilter')?.value || '';
  const sourceFilter = document.getElementById('contactSourceFilter')?.value || '';
  const rows = document.querySelectorAll('#contactsTable tr');
  
  rows.forEach(row => {
    const name = row.querySelector('td:nth-child(2)')?.textContent.toLowerCase() || '';
    const email = row.querySelector('td:nth-child(3)')?.textContent.toLowerCase() || '';
    const company = row.querySelector('td:nth-child(4)')?.textContent.toLowerCase() || '';
    const source = row.querySelector('td:nth-child(5)')?.textContent.toLowerCase() || '';
    
    const matchesSearch = !searchTerm || 
                         name.includes(searchTerm) || 
                         email.includes(searchTerm) || 
                         company.includes(searchTerm);
                         
    const matchesSource = !sourceFilter || source.includes(sourceFilter.toLowerCase());
    
    // For group filter, we'd need more complex logic to check if contact is in selected group
    const matchesGroup = !groupFilter; // Simplified for now
    
    if (matchesSearch && matchesSource && matchesGroup) {
      row.style.display = '';
    } else {
      row.style.display = 'none';
    }
  });
}

function debounce(func, wait) {
  let timeout;
  return function executedFunction(...args) {
    const later = () => {
      clearTimeout(timeout);
      func(...args);
    };
    clearTimeout(timeout);
    timeout = setTimeout(later, wait);
  };
}

document.addEventListener('turbo:load', () => {
  if (typeof lucide !== 'undefined') {
    lucide.createIcons();
  }
});
</script>
