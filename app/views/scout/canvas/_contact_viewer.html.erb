<div class="scout-canvas canvas-container contact-viewer">
  <!-- Page Header with Actions -->
  <div class="canvas-header-row">
    <div class="canvas-header-left">
    <h1 class="canvas-page-title">
      <i data-lucide="users"></i>
      Contacts
    </h1>
    <p class="canvas-page-subtitle">Manage your customer database</p>
  </div>
    <div class="canvas-header-actions">
      <button onclick="scoutImportContacts()" 
              aria-label="Import contacts"
              class="canvas-btn secondary">
        <i data-lucide="upload"></i>
        Import
      </button>
      <button onclick="scoutCreateContact()" 
              aria-label="Add new contact"
              class="canvas-btn primary">
        <i data-lucide="plus"></i>
        Add Contact
      </button>
    </div>
  </div>
  
  <!-- Quick Stats -->
  <div class="canvas-stats-grid">
    <div class="canvas-stat-card purple">
      <div>
        <p class="canvas-stat-label">Total Contacts</p>
        <p class="canvas-stat-value"><%= number_with_delimiter(stats[:total_contacts]) %></p>
      </div>
      <div class="canvas-stat-icon purple">
        <i data-lucide="users"></i>
      </div>
    </div>

    <div class="canvas-stat-card green">
      <div>
        <p class="canvas-stat-label">This Week</p>
        <p class="canvas-stat-value"><%= number_with_delimiter(stats[:recent_contacts]) %></p>
      </div>
      <div class="canvas-stat-icon green">
        <i data-lucide="user-plus"></i>
      </div>
    </div>

    <div class="canvas-stat-card cyan">
      <div>
        <p class="canvas-stat-label">Contact Groups</p>
        <p class="canvas-stat-value"><%= number_with_delimiter(stats[:contact_groups]) %></p>
      </div>
      <div class="canvas-stat-icon cyan">
        <i data-lucide="layers"></i>
      </div>
    </div>

    <div class="canvas-stat-card yellow">
      <div>
        <p class="canvas-stat-label">Tagged</p>
        <p class="canvas-stat-value"><%= contacts.where.not(tags: [nil, '']).count %></p>
      </div>
      <div class="canvas-stat-icon yellow">
        <i data-lucide="star"></i>
      </div>
    </div>
  </div>
  
  <!-- Search and Filters -->
  <div class="canvas-filters-grid">
    <div class="canvas-search-wrapper">
      <i data-lucide="search"></i>
      <input type="text" 
             id="contactSearch"
             placeholder="Search contacts..."
             class="canvas-search-input"
             aria-label="Search contacts by name, email, or company">
    </div>
    <select id="contactGroupFilter" class="canvas-select">
      <option value="">All Groups</option>
      <% entity.contact_groups.each do |group| %>
        <option value="<%= group.id %>"><%= group.name %></option>
      <% end %>
    </select>
    <select id="contactSourceFilter" class="canvas-select">
      <option value="">All Sources</option>
      <option value="website">Website</option>
      <option value="manual">Manual Entry</option>
      <option value="import">Import</option>
      <option value="landing_page">Landing Page</option>
    </select>
  </div>
  
  <% if contacts.any? %>
    <!-- Contacts Table -->
    <div class="canvas-card">
      <div class="canvas-card-header">
        <h6>
          <i data-lucide="list"></i>
          Recent Contacts
        </h6>
        <div class="canvas-actions">
          <button onclick="scoutSelectAllContacts()" 
                  aria-label="Select all contacts"
                  class="canvas-btn secondary sm">
            <i data-lucide="check-square"></i>
            Select All
          </button>
          <button onclick="scoutExportContacts()" 
                  aria-label="Export contacts"
                  class="canvas-btn outline-cyan sm">
            <i data-lucide="download"></i>
            Export
          </button>
        </div>
      </div>
      <div class="canvas-table-wrapper">
        <table class="canvas-table">
          <thead>
            <tr>
              <th style="width: 40px;">
                <input type="checkbox" 
                       id="selectAllCheckbox" 
                       onchange="scoutToggleAllContacts(this)"
                       class="canvas-checkbox">
              </th>
              <th>Name</th>
              <th>Email</th>
              <th>Company</th>
              <th>Source</th>
              <th>Groups</th>
              <th>Added</th>
              <th style="width: 120px;">Actions</th>
            </tr>
          </thead>
          <tbody id="contactsTable">
            <% contacts.each do |contact| %>
              <tr data-contact-id="<%= contact.id %>">
                <td>
                  <input 
                    type="checkbox" 
                    class="contact-checkbox canvas-checkbox" 
                    value="<%= contact.id %>">
                </td>
                <td>
                  <div class="d-flex align-items-center gap-3">
                    <div class="canvas-avatar">
                      <%= contact.first_name&.first&.upcase || contact.email&.first&.upcase || 'C' %>
                    </div>
                    <div>
                      <div class="fw-semibold">
                        <%= "#{contact.first_name} #{contact.last_name}".strip.presence || 'No Name' %>
                      </div>
                      <small class="text-muted">Contact</small>
                    </div>
                  </div>
                </td>
                <td>
                  <a href="mailto:<%= contact.email %>" class="canvas-link">
                    <%= contact.email %>
                  </a>
                </td>
                <td>
                  <span class="text-muted">-</span>
                </td>
                <td>
                  <span class="text-muted">unknown</span>
                </td>
                <td>
                  <% if contact.contact_groups.any? %>
                    <div class="d-flex flex-wrap gap-1">
                      <% contact.contact_groups.limit(2).each do |group| %>
                        <span class="canvas-badge purple"><%= group.name %></span>
                      <% end %>
                      <% if contact.contact_groups.count > 2 %>
                        <span class="canvas-badge gray">+<%= contact.contact_groups.count - 2 %></span>
                      <% end %>
                    </div>
                  <% else %>
                    <span class="text-muted">No groups</span>
                  <% end %>
                </td>
                <td>
                  <small class="text-muted">
                    <%= time_ago_in_words(contact.created_at) %> ago
                  </small>
                </td>
                <td>
                  <div class="d-flex gap-1">
                    <button onclick="scoutViewContact(<%= contact.id %>)"
                            aria-label="View contact <%= "#{contact.first_name} #{contact.last_name}".strip.presence || contact.email %>"
                            class="canvas-btn outline-cyan sm">
                      <i data-lucide="eye"></i>
                    </button>
                    <button onclick="scoutEditContact(<%= contact.id %>)"
                            aria-label="Edit contact <%= "#{contact.first_name} #{contact.last_name}".strip.presence || contact.email %>"
                            class="canvas-btn outline-purple sm">
                      <i data-lucide="pencil"></i>
                    </button>
                    <div class="dropdown">
                      <button class="canvas-btn secondary sm"
                              data-bs-toggle="dropdown"
                              aria-label="More actions for <%= "#{contact.first_name} #{contact.last_name}".strip.presence || contact.email %>">
                        <i data-lucide="more-horizontal"></i>
                      </button>
                      <ul class="dropdown-menu canvas-dropdown-menu">
                        <li><a class="dropdown-item" href="#" onclick="scoutAddToGroup(<%= contact.id %>)">
                          <i data-lucide="users" class="me-2"></i>Add to Group
                        </a></li>
                        <li><a class="dropdown-item" href="#" onclick="scoutSendEmail(<%= contact.id %>)">
                          <i data-lucide="mail" class="me-2"></i>Send Email
                        </a></li>
                        <li><hr class="dropdown-divider"></li>
                        <li><a class="dropdown-item danger" href="#" onclick="scoutDeleteContact(<%= contact.id %>)">
                          <i data-lucide="trash-2" class="me-2"></i>Delete
                        </a></li>
                      </ul>
                    </div>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
      <div class="canvas-card-footer">
        <small>
          Showing <%= contacts.count %> of <%= stats[:total_contacts] %> contacts
        </small>
        <div class="canvas-actions">
          <button onclick="scoutLoadMoreContacts()" 
                  aria-label="Load more contacts"
                  class="canvas-btn secondary sm">
            Load More
          </button>
          <button onclick="scoutCreateContact()" 
                  aria-label="Add new contact"
                  class="canvas-btn primary sm">
            <i data-lucide="plus"></i>
            Add Contact
          </button>
        </div>
      </div>
    </div>
  <% else %>
    <!-- Empty State -->
    <div class="canvas-empty-state">
      <i data-lucide="users"></i>
      <h5>No contacts yet</h5>
      <p>
        Start building your customer database by adding your first contact.<br>
        You can add contacts manually, import from a file, or capture them through landing pages.
      </p>
      <div class="canvas-empty-actions">
        <button onclick="scoutCreateContact()" 
                aria-label="Add your first contact"
                class="canvas-btn primary">
          <i data-lucide="plus"></i>
          Add Your First Contact
        </button>
        <button onclick="scoutImportContacts()" 
                aria-label="Import contacts"
                class="canvas-btn secondary">
          <i data-lucide="upload"></i>
          Import Contacts
        </button>
      </div>
    </div>
  <% end %>
</div>

<!-- Import Contacts Modal -->
<div id="importContactsModal" class="canvas-modal" style="display: none;">
  <div class="canvas-modal-backdrop" onclick="closeImportModal()"></div>
  <div class="canvas-modal-content">
    <div class="canvas-modal-header">
      <h3>
        <i data-lucide="upload"></i>
        Import Contacts
      </h3>
      <button class="canvas-modal-close" onclick="closeImportModal()">
        <i data-lucide="x"></i>
      </button>
    </div>
    <div class="canvas-modal-body">
      <p class="text-muted mb-3">Upload a CSV or Excel file with your contacts. The file should have columns for email, first_name, and last_name.</p>
      
      <div class="import-dropzone" id="importDropzone" onclick="document.getElementById('importFile').click()">
        <i data-lucide="file-up" style="width: 3rem; height: 3rem; color: var(--text-muted); margin-bottom: 1rem;"></i>
        <p><strong>Click to upload</strong> or drag and drop</p>
        <p class="text-muted small">CSV or Excel files (.csv, .xlsx, .xls)</p>
        <input type="file" id="importFile" accept=".csv,.xlsx,.xls" style="display: none;" onchange="handleFileSelect(this)">
      </div>

      <div id="selectedFileInfo" class="selected-file-info" style="display: none;">
        <i data-lucide="file-spreadsheet"></i>
        <span id="selectedFileName"></span>
        <button type="button" class="remove-file-btn" onclick="clearSelectedFile()">
          <i data-lucide="x"></i>
        </button>
      </div>

      <div class="import-template-section mt-4">
        <h6>Need a template?</h6>
        <p class="text-muted small mb-2">Download our sample CSV template with the correct column headers.</p>
        <button onclick="downloadTemplate()" class="canvas-btn secondary sm">
          <i data-lucide="download"></i>
          Download Template
        </button>
      </div>

      <div id="importProgress" class="import-progress" style="display: none;">
        <div class="progress-bar-container">
          <div class="progress-bar-fill" id="importProgressBar"></div>
        </div>
        <p id="importProgressText" class="text-muted small mt-2">Importing contacts...</p>
      </div>

      <div id="importResult" class="import-result" style="display: none;"></div>
    </div>
    <div class="canvas-modal-footer">
      <button onclick="closeImportModal()" class="canvas-btn secondary">Cancel</button>
      <button onclick="submitImport()" id="importSubmitBtn" class="canvas-btn primary" disabled>
        <i data-lucide="upload"></i>
        Import Contacts
      </button>
    </div>
  </div>
</div>

<!-- Delete Confirmation Modal -->
<div id="deleteContactModal" class="canvas-modal" style="display: none;">
  <div class="canvas-modal-backdrop" onclick="closeDeleteModal()"></div>
  <div class="canvas-modal-content" style="max-width: 420px;">
    <div class="canvas-modal-header">
      <h3>
        <i data-lucide="trash-2"></i>
        Delete Contact
      </h3>
      <button class="canvas-modal-close" onclick="closeDeleteModal()">
        <i data-lucide="x"></i>
      </button>
    </div>
    <div class="canvas-modal-body">
      <p>Are you sure you want to delete <strong id="deleteContactName"></strong>?</p>
      <p class="text-muted small">This action cannot be undone. All associated data will be permanently removed.</p>
    </div>
    <div class="canvas-modal-footer">
      <button onclick="closeDeleteModal()" class="canvas-btn secondary">Cancel</button>
      <button onclick="confirmDeleteContact()" id="deleteConfirmBtn" class="canvas-btn" style="background: #ef4444; color: white;">
        <i data-lucide="trash-2"></i>
        Delete
      </button>
    </div>
  </div>
</div>

<script>
// Contact viewer functionality
function scoutCreateContact() {
  window.scoutLoadCanvas?.('contact_generator');
}

function scoutViewContact(contactId) {
  window.scoutLoadCanvas?.('contact_detail', { contact_id: contactId });
}

function scoutEditContact(contactId) {
  window.scoutLoadCanvas?.('contact_detail', { contact_id: contactId, edit: true });
}

// ── Delete: modal confirmation → direct API call ──
let pendingDeleteContactId = null;

function scoutDeleteContact(contactId) {
  pendingDeleteContactId = contactId;
  // Find contact name from the table row
  const row = document.querySelector(`tr[data-contact-id="${contactId}"]`);
  const name = row?.querySelector('td:nth-child(2) .fw-semibold')?.textContent?.trim() || 'this contact';
  document.getElementById('deleteContactName').textContent = name;
  document.getElementById('deleteContactModal').style.display = 'flex';
  if (typeof lucide !== 'undefined') lucide.createIcons();
}

function closeDeleteModal() {
  document.getElementById('deleteContactModal').style.display = 'none';
  pendingDeleteContactId = null;
}

async function confirmDeleteContact() {
  if (!pendingDeleteContactId) return;
  const contactId = pendingDeleteContactId;
  const btn = document.getElementById('deleteConfirmBtn');
  btn.disabled = true;
  btn.innerHTML = '<i data-lucide="loader"></i> Deleting...';
  if (typeof lucide !== 'undefined') lucide.createIcons();

  try {
    const response = await fetch(`/api/v1/contacts_list/${contactId}`, {
      method: 'DELETE',
      headers: {
        'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]')?.getAttribute('content'),
        'Content-Type': 'application/json'
      }
    });

    if (response.ok || response.status === 204) {
      // Remove the row from the table with a fade
      const row = document.querySelector(`tr[data-contact-id="${contactId}"]`);
      if (row) {
        row.style.transition = 'opacity 0.3s ease';
        row.style.opacity = '0';
        setTimeout(() => row.remove(), 300);
      }
      closeDeleteModal();
    } else {
      const data = await response.json().catch(() => ({}));
      alert(data.message || data.error || 'Failed to delete contact');
    }
  } catch (error) {
    alert('Failed to delete contact: ' + error.message);
  } finally {
    btn.disabled = false;
    btn.innerHTML = '<i data-lucide="trash-2"></i> Delete';
    if (typeof lucide !== 'undefined') lucide.createIcons();
  }
}

function scoutAddToGroup(contactId) {
  window.scoutLoadCanvas?.('contact_detail', { contact_id: contactId, action: 'add_to_group' });
}

function scoutSendEmail(contactId) {
  window.scoutLoadCanvas?.('contact_detail', { contact_id: contactId, action: 'send_email' });
}

function scoutImportContacts() {
  document.getElementById('importContactsModal').style.display = 'flex';
  if (typeof lucide !== 'undefined') {
    lucide.createIcons();
  }
}

function closeImportModal() {
  document.getElementById('importContactsModal').style.display = 'none';
  clearSelectedFile();
  document.getElementById('importResult').style.display = 'none';
  document.getElementById('importProgress').style.display = 'none';
}

function handleFileSelect(input) {
  const file = input.files[0];
  if (file) {
    document.getElementById('selectedFileName').textContent = file.name;
    document.getElementById('selectedFileInfo').style.display = 'flex';
    document.getElementById('importDropzone').style.display = 'none';
    document.getElementById('importSubmitBtn').disabled = false;
    if (typeof lucide !== 'undefined') {
      lucide.createIcons();
    }
  }
}

function clearSelectedFile() {
  document.getElementById('importFile').value = '';
  document.getElementById('selectedFileInfo').style.display = 'none';
  document.getElementById('importDropzone').style.display = 'flex';
  document.getElementById('importSubmitBtn').disabled = true;
}

function downloadTemplate() {
  const csvContent = "email,first_name,last_name,tags\njohn@example.com,John,Doe,customer\njane@example.com,Jane,Smith,lead";
  const blob = new Blob([csvContent], { type: 'text/csv' });
  const url = window.URL.createObjectURL(blob);
  const a = document.createElement('a');
  a.href = url;
  a.download = 'contacts_template.csv';
  a.click();
  window.URL.revokeObjectURL(url);
}

async function submitImport() {
  const fileInput = document.getElementById('importFile');
  const file = fileInput.files[0];
  
  if (!file) {
    showWarning('Please select a file first');
    return;
  }

  const formData = new FormData();
  formData.append('file', file);

  // Show progress
  document.getElementById('importProgress').style.display = 'block';
  document.getElementById('importResult').style.display = 'none';
  document.getElementById('importSubmitBtn').disabled = true;
  document.getElementById('importProgressText').textContent = 'Uploading and processing...';

  try {
    const response = await fetch('/contacts/import', {
      method: 'POST',
      headers: {
        'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]')?.getAttribute('content')
      },
      body: formData
    });

    const result = await response.json();
    document.getElementById('importProgress').style.display = 'none';

    const resultDiv = document.getElementById('importResult');
    if (result.success) {
      resultDiv.innerHTML = `
        <div class="import-success">
          <i data-lucide="check-circle"></i>
          <div>
            <strong>${result.message}</strong>
            ${result.errors?.length > 0 ? `<p class="text-muted small mt-1">Issues: ${result.errors.slice(0, 3).join(', ')}${result.errors.length > 3 ? '...' : ''}</p>` : ''}
          </div>
        </div>
      `;
      // Refresh the page after successful import
      setTimeout(() => {
        window.scoutLoadCanvas?.('contact_viewer');
      }, 2000);
    } else {
      resultDiv.innerHTML = `
        <div class="import-error">
          <i data-lucide="alert-circle"></i>
          <div>
            <strong>Import failed</strong>
            <p class="text-muted small mt-1">${result.error}</p>
          </div>
        </div>
      `;
      document.getElementById('importSubmitBtn').disabled = false;
    }
    resultDiv.style.display = 'block';
    if (typeof lucide !== 'undefined') {
      lucide.createIcons();
    }
  } catch (error) {
    document.getElementById('importProgress').style.display = 'none';
    document.getElementById('importResult').innerHTML = `
      <div class="import-error">
        <i data-lucide="alert-circle"></i>
        <div>
          <strong>Import failed</strong>
          <p class="text-muted small mt-1">${error.message}</p>
        </div>
      </div>
    `;
    document.getElementById('importResult').style.display = 'block';
    document.getElementById('importSubmitBtn').disabled = false;
    if (typeof lucide !== 'undefined') {
      lucide.createIcons();
    }
  }
}

// Drag and drop support
const dropzone = document.getElementById('importDropzone');
if (dropzone) {
  dropzone.addEventListener('dragover', (e) => {
    e.preventDefault();
    dropzone.classList.add('dragover');
  });
  
  dropzone.addEventListener('dragleave', () => {
    dropzone.classList.remove('dragover');
  });
  
  dropzone.addEventListener('drop', (e) => {
    e.preventDefault();
    dropzone.classList.remove('dragover');
    const file = e.dataTransfer.files[0];
    if (file) {
      document.getElementById('importFile').files = e.dataTransfer.files;
      handleFileSelect(document.getElementById('importFile'));
    }
  });
}

// ── Export: direct client-side CSV download ──
function scoutExportContacts() {
  const selectedIds = getSelectedContacts();
  const rows = document.querySelectorAll('#contactsTable tr');
  const csvRows = [['Name', 'Email', 'Company', 'Source', 'Groups', 'Added']];

  rows.forEach(row => {
    const contactId = row.dataset.contactId;
    // If contacts are selected, only export those; otherwise export all visible
    if (selectedIds.length > 0 && !selectedIds.includes(contactId)) return;
    if (row.style.display === 'none') return;

    const name = row.querySelector('td:nth-child(2) .fw-semibold')?.textContent?.trim() || '';
    const email = row.querySelector('td:nth-child(3)')?.textContent?.trim() || '';
    const company = row.querySelector('td:nth-child(4)')?.textContent?.trim() || '';
    const source = row.querySelector('td:nth-child(5)')?.textContent?.trim() || '';
    const groups = Array.from(row.querySelectorAll('td:nth-child(6) .canvas-badge'))
                        .map(b => b.textContent.trim()).join('; ');
    const added = row.querySelector('td:nth-child(7)')?.textContent?.trim() || '';

    csvRows.push([name, email, company, source, groups, added].map(v =>
      '"' + (v || '').replace(/"/g, '""') + '"'
    ));
  });

  const csv = csvRows.map(r => r.join(',')).join('\n');
  const blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a');
  a.href = url;
  a.download = `contacts_export_${new Date().toISOString().slice(0,10)}.csv`;
  a.click();
  URL.revokeObjectURL(url);
}

function scoutSelectAllContacts() {
  const checkboxes = document.querySelectorAll('.contact-checkbox');
  const selectAllChecked = document.getElementById('selectAllCheckbox').checked;
  
  checkboxes.forEach(checkbox => {
    checkbox.checked = !selectAllChecked;
  });
  
  document.getElementById('selectAllCheckbox').checked = !selectAllChecked;
}

function scoutToggleAllContacts(checkbox) {
  const checkboxes = document.querySelectorAll('.contact-checkbox');
  checkboxes.forEach(cb => cb.checked = checkbox.checked);
}

function scoutLoadMoreContacts() {
  // Reload the contact viewer with a higher page/limit
  window.scoutLoadCanvas?.('contact_viewer', { page: 2 }, true);
}

function getSelectedContacts() {
  const checkboxes = document.querySelectorAll('.contact-checkbox:checked');
  return Array.from(checkboxes).map(cb => cb.value);
}

// Search and filter functionality
document.addEventListener('DOMContentLoaded', function() {
  const searchInput = document.getElementById('contactSearch');
  const groupFilter = document.getElementById('contactGroupFilter');
  const sourceFilter = document.getElementById('contactSourceFilter');
  
  if (searchInput) {
    searchInput.addEventListener('input', debounce(filterContacts, 300));
  }
  
  if (groupFilter) {
    groupFilter.addEventListener('change', filterContacts);
  }
  
  if (sourceFilter) {
    sourceFilter.addEventListener('change', filterContacts);
  }
  
  if (typeof lucide !== 'undefined') {
    lucide.createIcons();
  }
});

function filterContacts() {
  const searchTerm = document.getElementById('contactSearch')?.value.toLowerCase() || '';
  const groupFilter = document.getElementById('contactGroupFilter')?.value || '';
  const sourceFilter = document.getElementById('contactSourceFilter')?.value || '';
  const rows = document.querySelectorAll('#contactsTable tr');
  
  rows.forEach(row => {
    const name = row.querySelector('td:nth-child(2)')?.textContent.toLowerCase() || '';
    const email = row.querySelector('td:nth-child(3)')?.textContent.toLowerCase() || '';
    const company = row.querySelector('td:nth-child(4)')?.textContent.toLowerCase() || '';
    const source = row.querySelector('td:nth-child(5)')?.textContent.toLowerCase() || '';
    
    const matchesSearch = !searchTerm || 
                         name.includes(searchTerm) || 
                         email.includes(searchTerm) || 
                         company.includes(searchTerm);
                         
    const matchesSource = !sourceFilter || source.includes(sourceFilter.toLowerCase());
    
    // For group filter, we'd need more complex logic to check if contact is in selected group
    const matchesGroup = !groupFilter; // Simplified for now
    
    if (matchesSearch && matchesSource && matchesGroup) {
      row.style.display = '';
    } else {
      row.style.display = 'none';
    }
  });
}

function debounce(func, wait) {
  let timeout;
  return function executedFunction(...args) {
    const later = () => {
      clearTimeout(timeout);
      func(...args);
    };
    clearTimeout(timeout);
    timeout = setTimeout(later, wait);
  };
}

document.addEventListener('turbo:load', () => {
  if (typeof lucide !== 'undefined') {
    lucide.createIcons();
  }
});
</script>
