<div style="background-color: #0A0E1A; color: #FFFFFF; min-height: 100vh; padding: 2rem;">
  <!-- Page Header -->
  <div style="margin-bottom: 2rem;">
    <h1 style="color: #FFFFFF; font-size: 2rem; font-weight: 700; margin-bottom: 0.5rem; display: flex; align-items: center; gap: 1rem;">
      <i data-lucide="users" style="width: 2rem; height: 2rem;"></i>
      Contacts
    </h1>
    <p style="color: #94A3B8; margin-bottom: 0;">Manage your customer database</p>
  </div>

  <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem;">
    <div></div>
    <div style="display: flex; gap: 0.5rem;">
      <button onclick="scoutImportContacts()" 
              aria-label="Import contacts"
              style="background: transparent; color: #94A3B8; border: 1px solid #1E293B; padding: 0.5rem 1rem; border-radius: 0.375rem; cursor: pointer; display: inline-flex; align-items: center; gap: 0.5rem; font-size: 0.875rem; font-weight: 500;">
        <i data-lucide="upload" style="width: 1rem; height: 1rem;"></i>
        Import
      </button>
      <button onclick="scoutCreateContact()" 
              aria-label="Add new contact"
              style="background: linear-gradient(135deg, #7C3AED 0%, #A78BFA 100%); color: white; border: none; padding: 0.5rem 1rem; border-radius: 0.375rem; cursor: pointer; display: inline-flex; align-items: center; gap: 0.5rem; font-size: 0.875rem; font-weight: 500;">
        <i data-lucide="plus" style="width: 1rem; height: 1rem;"></i>
        Add Contact
      </button>
    </div>
  </div>
  
  <!-- Quick Stats -->
  <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1rem; margin-bottom: 2rem;">
    <div style="background: linear-gradient(135deg, rgba(124, 58, 237, 0.2) 0%, rgba(167, 139, 250, 0.05) 100%); border: 1px solid rgba(124, 58, 237, 0.3); border-radius: 0.75rem; padding: 1.5rem;">
      <div style="display: flex; align-items: center; justify-content: space-between;">
        <div>
          <p style="color: #94A3B8; font-size: 0.875rem; margin: 0 0 0.5rem 0;">Total Contacts</p>
          <p style="color: #FFFFFF; font-size: 1.75rem; font-weight: 700; margin: 0;"><%= number_with_delimiter(stats[:total_contacts]) %></p>
        </div>
        <div style="width: 2.5rem; height: 2.5rem; border-radius: 0.5rem; background: rgba(124, 58, 237, 0.2); display: flex; align-items: center; justify-content: center;">
          <i data-lucide="users" style="width: 1.25rem; height: 1.25rem; color: #A78BFA;"></i>
        </div>
      </div>
    </div>

    <div style="background: linear-gradient(135deg, rgba(74, 222, 128, 0.2) 0%, rgba(74, 222, 128, 0.05) 100%); border: 1px solid rgba(74, 222, 128, 0.3); border-radius: 0.75rem; padding: 1.5rem;">
      <div style="display: flex; align-items: center; justify-content: space-between;">
        <div>
          <p style="color: #94A3B8; font-size: 0.875rem; margin: 0 0 0.5rem 0;">This Week</p>
          <p style="color: #FFFFFF; font-size: 1.75rem; font-weight: 700; margin: 0;"><%= number_with_delimiter(stats[:recent_contacts]) %></p>
        </div>
        <div style="width: 2.5rem; height: 2.5rem; border-radius: 0.5rem; background: rgba(74, 222, 128, 0.2); display: flex; align-items: center; justify-content: center;">
          <i data-lucide="user-plus" style="width: 1.25rem; height: 1.25rem; color: #4ade80;"></i>
        </div>
      </div>
    </div>

    <div style="background: linear-gradient(135deg, rgba(34, 211, 238, 0.2) 0%, rgba(34, 211, 238, 0.05) 100%); border: 1px solid rgba(34, 211, 238, 0.3); border-radius: 0.75rem; padding: 1.5rem;">
      <div style="display: flex; align-items: center; justify-content: space-between;">
        <div>
          <p style="color: #94A3B8; font-size: 0.875rem; margin: 0 0 0.5rem 0;">Contact Groups</p>
          <p style="color: #FFFFFF; font-size: 1.75rem; font-weight: 700; margin: 0;"><%= number_with_delimiter(stats[:contact_groups]) %></p>
        </div>
        <div style="width: 2.5rem; height: 2.5rem; border-radius: 0.5rem; background: rgba(34, 211, 238, 0.2); display: flex; align-items: center; justify-content: center;">
          <i data-lucide="layers" style="width: 1.25rem; height: 1.25rem; color: #22D3EE;"></i>
        </div>
      </div>
    </div>

    <div style="background: linear-gradient(135deg, rgba(250, 204, 21, 0.2) 0%, rgba(250, 204, 21, 0.05) 100%); border: 1px solid rgba(250, 204, 21, 0.3); border-radius: 0.75rem; padding: 1.5rem;">
      <div style="display: flex; align-items: center; justify-content: space-between;">
        <div>
          <p style="color: #94A3B8; font-size: 0.875rem; margin: 0 0 0.5rem 0;">Tagged</p>
          <p style="color: #FFFFFF; font-size: 1.75rem; font-weight: 700; margin: 0;"><%= contacts.where.not(tags: [nil, '']).count %></p>
        </div>
        <div style="width: 2.5rem; height: 2.5rem; border-radius: 0.5rem; background: rgba(250, 204, 21, 0.2); display: flex; align-items: center; justify-content: center;">
          <i data-lucide="star" style="width: 1.25rem; height: 1.25rem; color: #facc15;"></i>
        </div>
      </div>
    </div>
  </div>
  
  <!-- Search and Filters -->
  <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1rem; margin-bottom: 2rem;">
    <div style="position: relative;">
      <i data-lucide="search" style="position: absolute; left: 1rem; top: 50%; transform: translateY(-50%); width: 1.25rem; height: 1.25rem; color: #64748B; pointer-events: none;"></i>
      <input type="text" 
             id="contactSearch"
             placeholder="Search contacts..."
             style="width: 100%; padding: 0.75rem 1rem 0.75rem 2.75rem; background-color: #1A1F35; border: 1px solid #1E293B; border-radius: 0.5rem; color: #FFFFFF; font-size: 0.875rem;"
             aria-label="Search contacts by name, email, or company">
    </div>
    <select id="contactGroupFilter" style="width: 100%; padding: 0.75rem 1rem; background-color: #1A1F35; border: 1px solid #1E293B; border-radius: 0.5rem; color: #FFFFFF; font-size: 0.875rem;">
      <option value="">All Groups</option>
      <% entity.contact_groups.each do |group| %>
        <option value="<%= group.id %>"><%= group.name %></option>
      <% end %>
    </select>
    <select id="contactSourceFilter" style="width: 100%; padding: 0.75rem 1rem; background-color: #1A1F35; border: 1px solid #1E293B; border-radius: 0.5rem; color: #FFFFFF; font-size: 0.875rem;">
      <option value="">All Sources</option>
      <option value="website">Website</option>
      <option value="manual">Manual Entry</option>
      <option value="import">Import</option>
      <option value="landing_page">Landing Page</option>
    </select>
  </div>
  
  <% if contacts.any? %>
    <!-- Contacts Table -->
    <div style="background: #1A1F35; border: 1px solid #1E293B; border-radius: 0.75rem; overflow: hidden;">
      <div style="background: #0A0E1A; border-bottom: 1px solid #1E293B; padding: 1rem 1.5rem; display: flex; justify-content: space-between; align-items: center;">
        <h6 style="color: #FFFFFF; margin: 0; font-weight: 600; display: flex; align-items: center; gap: 0.5rem;">
          <i data-lucide="list" style="width: 1rem; height: 1rem;"></i>
          Recent Contacts
        </h6>
        <div style="display: flex; gap: 0.5rem;">
          <button onclick="scoutSelectAllContacts()" 
                  aria-label="Select all contacts"
                  style="background: transparent; color: #94A3B8; border: 1px solid #1E293B; padding: 0.375rem 0.75rem; border-radius: 0.375rem; cursor: pointer; display: inline-flex; align-items: center; gap: 0.25rem; font-size: 0.875rem; font-weight: 500;">
            <i data-lucide="check-square" style="width: 0.875rem; height: 0.875rem;"></i>
            Select All
          </button>
          <button onclick="scoutExportContacts()" 
                  aria-label="Export contacts"
                  style="background: transparent; color: #22D3EE; border: 1px solid #22D3EE; padding: 0.375rem 0.75rem; border-radius: 0.375rem; cursor: pointer; display: inline-flex; align-items: center; gap: 0.25rem; font-size: 0.875rem; font-weight: 500;">
            <i data-lucide="download" style="width: 0.875rem; height: 0.875rem;"></i>
            Export
          </button>
        </div>
      </div>
      <div style="overflow-x: auto;">
        <table style="width: 100%; border-collapse: collapse;">
          <thead>
            <tr style="background: #0A0E1A; border-bottom: 1px solid #1E293B;">
              <th style="padding: 1rem; text-align: left; color: #94A3B8; font-weight: 600; font-size: 0.875rem; width: 40px;">
                <input type="checkbox" 
                       id="selectAllCheckbox" 
                       onchange="scoutToggleAllContacts(this)"
                       style="width: 1rem; height: 1rem; cursor: pointer;">
              </th>
              <th style="padding: 1rem; text-align: left; color: #94A3B8; font-weight: 600; font-size: 0.875rem;">Name</th>
              <th style="padding: 1rem; text-align: left; color: #94A3B8; font-weight: 600; font-size: 0.875rem;">Email</th>
              <th style="padding: 1rem; text-align: left; color: #94A3B8; font-weight: 600; font-size: 0.875rem;">Company</th>
              <th style="padding: 1rem; text-align: left; color: #94A3B8; font-weight: 600; font-size: 0.875rem;">Source</th>
              <th style="padding: 1rem; text-align: left; color: #94A3B8; font-weight: 600; font-size: 0.875rem;">Groups</th>
              <th style="padding: 1rem; text-align: left; color: #94A3B8; font-weight: 600; font-size: 0.875rem;">Added</th>
              <th style="padding: 1rem; text-align: left; color: #94A3B8; font-weight: 600; font-size: 0.875rem; width: 120px;">Actions</th>
            </tr>
          </thead>
          <tbody id="contactsTable">
            <% contacts.each do |contact| %>
              <tr data-contact-id="<%= contact.id %>" style="border-bottom: 1px solid #1E293B; transition: background-color 0.2s ease;" onmouseover="this.style.backgroundColor='#0A0E1A';" onmouseout="this.style.backgroundColor='';">
                <td style="padding: 1rem;">
                  <input 
                    type="checkbox" 
                    class="contact-checkbox" 
                    value="<%= contact.id %>"
                    style="width: 1rem; height: 1rem; cursor: pointer;">
                </td>
                <td style="padding: 1rem;">
                  <div style="display: flex; align-items: center; gap: 0.75rem;">
                    <div style="width: 2.5rem; height: 2.5rem; border-radius: 50%; background: linear-gradient(135deg, #7C3AED 0%, #A78BFA 100%); display: flex; align-items: center; justify-content: center; color: #FFFFFF; font-weight: 600; font-size: 0.875rem; flex-shrink: 0;">
                      <%= contact.first_name&.first&.upcase || contact.email&.first&.upcase || 'C' %>
                    </div>
                    <div>
                      <div style="color: #FFFFFF; font-weight: 600; margin-bottom: 0.25rem;">
                        <%= "#{contact.first_name} #{contact.last_name}".strip.presence || 'No Name' %>
                      </div>
                      <small style="color: #64748B; font-size: 0.75rem;">Contact</small>
                    </div>
                  </div>
                </td>
                <td style="padding: 1rem;">
                  <a href="mailto:<%= contact.email %>" style="color: #22D3EE; text-decoration: none;">
                    <%= contact.email %>
                  </a>
                </td>
                <td style="padding: 1rem;">
                  <span style="color: #64748B;">-</span>
                </td>
                <td style="padding: 1rem;">
                  <span style="color: #64748B;">unknown</span>
                </td>
                <td style="padding: 1rem;">
                  <% if contact.contact_groups.any? %>
                    <div style="display: flex; flex-wrap: wrap; gap: 0.25rem;">
                      <% contact.contact_groups.limit(2).each do |group| %>
                        <span style="background: rgba(124, 58, 237, 0.2); color: #A78BFA; padding: 0.25rem 0.5rem; border-radius: 0.375rem; font-size: 0.75rem;">
                          <%= group.name %>
                        </span>
                      <% end %>
                      <% if contact.contact_groups.count > 2 %>
                        <span style="background: rgba(100, 116, 139, 0.2); color: #64748B; padding: 0.25rem 0.5rem; border-radius: 0.375rem; font-size: 0.75rem;">
                          +<%= contact.contact_groups.count - 2 %>
                        </span>
                      <% end %>
                    </div>
                  <% else %>
                    <span style="color: #64748B;">No groups</span>
                  <% end %>
                </td>
                <td style="padding: 1rem;">
                  <small style="color: #64748B;">
                    <%= time_ago_in_words(contact.created_at) %> ago
                  </small>
                </td>
                <td style="padding: 1rem;">
                  <div style="display: flex; gap: 0.25rem;">
                    <button onclick="scoutViewContact(<%= contact.id %>)"
                            aria-label="View contact <%= "#{contact.first_name} #{contact.last_name}".strip.presence || contact.email %>"
                            style="background: transparent; color: #22D3EE; border: 1px solid #22D3EE; padding: 0.375rem 0.75rem; border-radius: 0.375rem; cursor: pointer; display: inline-flex; align-items: center; gap: 0.25rem;">
                      <i data-lucide="eye" style="width: 0.875rem; height: 0.875rem;"></i>
                    </button>
                    <button onclick="scoutEditContact(<%= contact.id %>)"
                            aria-label="Edit contact <%= "#{contact.first_name} #{contact.last_name}".strip.presence || contact.email %>"
                            style="background: transparent; color: #A78BFA; border: 1px solid #A78BFA; padding: 0.375rem 0.75rem; border-radius: 0.375rem; cursor: pointer; display: inline-flex; align-items: center; gap: 0.25rem;">
                      <i data-lucide="pencil" style="width: 0.875rem; height: 0.875rem;"></i>
                    </button>
                    <div class="dropdown">
                      <button class="btn btn-sm"
                              data-bs-toggle="dropdown"
                              aria-label="More actions for <%= "#{contact.first_name} #{contact.last_name}".strip.presence || contact.email %>"
                              style="background: transparent; color: #94A3B8; border: 1px solid #1E293B; padding: 0.375rem 0.75rem; border-radius: 0.375rem;">
                        <i data-lucide="more-horizontal" style="width: 0.875rem; height: 0.875rem;"></i>
                      </button>
                      <ul class="dropdown-menu" style="background: #1A1F35; border: 1px solid #1E293B;">
                        <li><a class="dropdown-item" href="#" onclick="scoutAddToGroup(<%= contact.id %>)" style="color: #FFFFFF;">
                          <i data-lucide="users" style="width: 0.875rem; height: 0.875rem; margin-right: 0.5rem;"></i>Add to Group
                        </a></li>
                        <li><a class="dropdown-item" href="#" onclick="scoutSendEmail(<%= contact.id %>)" style="color: #FFFFFF;">
                          <i data-lucide="mail" style="width: 0.875rem; height: 0.875rem; margin-right: 0.5rem;"></i>Send Email
                        </a></li>
                        <li><hr class="dropdown-divider" style="border-color: #1E293B;"></li>
                        <li><a class="dropdown-item" href="#" onclick="scoutDeleteContact(<%= contact.id %>)" style="color: rgb(248, 113, 113);">
                          <i data-lucide="trash-2" style="width: 0.875rem; height: 0.875rem; margin-right: 0.5rem;"></i>Delete
                        </a></li>
                      </ul>
                    </div>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
      <div style="background: #0A0E1A; border-top: 1px solid #1E293B; padding: 1rem 1.5rem; display: flex; justify-content: space-between; align-items: center;">
        <small style="color: #64748B;">
          Showing <%= contacts.count %> of <%= stats[:total_contacts] %> contacts
        </small>
        <div style="display: flex; gap: 0.5rem;">
          <button onclick="scoutLoadMoreContacts()" 
                  aria-label="Load more contacts"
                  style="background: transparent; color: #94A3B8; border: 1px solid #1E293B; padding: 0.375rem 0.75rem; border-radius: 0.375rem; cursor: pointer; font-size: 0.875rem; font-weight: 500;">
            Load More
          </button>
          <button onclick="scoutCreateContact()" 
                  aria-label="Add new contact"
                  style="background: linear-gradient(135deg, #7C3AED 0%, #A78BFA 100%); color: white; border: none; padding: 0.375rem 0.75rem; border-radius: 0.375rem; cursor: pointer; display: inline-flex; align-items: center; gap: 0.25rem; font-size: 0.875rem; font-weight: 500;">
            <i data-lucide="plus" style="width: 0.875rem; height: 0.875rem;"></i>
            Add Contact
          </button>
        </div>
      </div>
    </div>
  <% else %>
    <!-- Empty State -->
    <div style="text-align: center; padding: 3rem 0; max-width: 600px; margin: 0 auto;">
      <div style="margin-bottom: 1.5rem;">
        <i data-lucide="users" style="width: 4rem; height: 4rem; color: #64748B;"></i>
      </div>
      <h5 style="color: #94A3B8; margin-bottom: 1rem;">No contacts yet</h5>
      <p style="color: #64748B; margin-bottom: 2rem;">
        Start building your customer database by adding your first contact.<br>
        You can add contacts manually, import from a file, or capture them through landing pages.
      </p>
      <div style="display: flex; gap: 0.5rem; justify-content: center;">
        <button onclick="scoutCreateContact()" 
                aria-label="Add your first contact"
                style="background: linear-gradient(135deg, #7C3AED 0%, #A78BFA 100%); color: white; border: none; padding: 0.75rem 1.5rem; border-radius: 0.375rem; cursor: pointer; display: inline-flex; align-items: center; gap: 0.5rem; font-weight: 500;">
          <i data-lucide="plus" style="width: 1rem; height: 1rem;"></i>
          Add Your First Contact
        </button>
        <button onclick="scoutImportContacts()" 
                aria-label="Import contacts"
                style="background: transparent; color: #94A3B8; border: 1px solid #1E293B; padding: 0.75rem 1.5rem; border-radius: 0.375rem; cursor: pointer; display: inline-flex; align-items: center; gap: 0.5rem; font-weight: 500;">
          <i data-lucide="upload" style="width: 1rem; height: 1rem;"></i>
          Import Contacts
        </button>
      </div>
    </div>
  <% end %>
</div>

<script>
// Contact viewer functionality
function scoutCreateContact() {
  window.scoutLoadCanvas?.('contact_generator');
}

function scoutViewContact(contactId) {
  window.scoutSendMessage?.(`Show me details for contact ${contactId}`);
}

function scoutEditContact(contactId) {
  window.scoutSendMessage?.(`Edit contact ${contactId}`);
}

function scoutDeleteContact(contactId) {
  if (confirm('Are you sure you want to delete this contact?')) {
    window.scoutSendMessage?.(`Delete contact ${contactId}`);
  }
}

function scoutAddToGroup(contactId) {
  window.scoutSendMessage?.(`Add contact ${contactId} to a group`);
}

function scoutSendEmail(contactId) {
  window.scoutSendMessage?.(`Create an email campaign for contact ${contactId}`);
}

function scoutImportContacts() {
  window.scoutSendMessage?.("Help me import contacts from a file");
}

function scoutExportContacts() {
  const selectedContacts = getSelectedContacts();
  if (selectedContacts.length > 0) {
    window.scoutSendMessage?.(`Export ${selectedContacts.length} selected contacts`);
  } else {
    window.scoutSendMessage?.("Export all contacts to a file");
  }
}

function scoutSelectAllContacts() {
  const checkboxes = document.querySelectorAll('.contact-checkbox');
  const selectAllChecked = document.getElementById('selectAllCheckbox').checked;
  
  checkboxes.forEach(checkbox => {
    checkbox.checked = !selectAllChecked;
  });
  
  document.getElementById('selectAllCheckbox').checked = !selectAllChecked;
}

function scoutToggleAllContacts(checkbox) {
  const checkboxes = document.querySelectorAll('.contact-checkbox');
  checkboxes.forEach(cb => cb.checked = checkbox.checked);
}

function scoutLoadMoreContacts() {
  window.scoutSendMessage?.("Load more contacts");
}

function getSelectedContacts() {
  const checkboxes = document.querySelectorAll('.contact-checkbox:checked');
  return Array.from(checkboxes).map(cb => cb.value);
}

// Search and filter functionality
document.addEventListener('DOMContentLoaded', function() {
  const searchInput = document.getElementById('contactSearch');
  const groupFilter = document.getElementById('contactGroupFilter');
  const sourceFilter = document.getElementById('contactSourceFilter');
  
  if (searchInput) {
    searchInput.addEventListener('input', debounce(filterContacts, 300));
  }
  
  if (groupFilter) {
    groupFilter.addEventListener('change', filterContacts);
  }
  
  if (sourceFilter) {
    sourceFilter.addEventListener('change', filterContacts);
  }
  
  if (typeof lucide !== 'undefined') {
    lucide.createIcons();
  }
});

function filterContacts() {
  const searchTerm = document.getElementById('contactSearch')?.value.toLowerCase() || '';
  const groupFilter = document.getElementById('contactGroupFilter')?.value || '';
  const sourceFilter = document.getElementById('contactSourceFilter')?.value || '';
  const rows = document.querySelectorAll('#contactsTable tr');
  
  rows.forEach(row => {
    const name = row.querySelector('td:nth-child(2)')?.textContent.toLowerCase() || '';
    const email = row.querySelector('td:nth-child(3)')?.textContent.toLowerCase() || '';
    const company = row.querySelector('td:nth-child(4)')?.textContent.toLowerCase() || '';
    const source = row.querySelector('td:nth-child(5)')?.textContent.toLowerCase() || '';
    
    const matchesSearch = !searchTerm || 
                         name.includes(searchTerm) || 
                         email.includes(searchTerm) || 
                         company.includes(searchTerm);
                         
    const matchesSource = !sourceFilter || source.includes(sourceFilter.toLowerCase());
    
    // For group filter, we'd need more complex logic to check if contact is in selected group
    const matchesGroup = !groupFilter; // Simplified for now
    
    if (matchesSearch && matchesSource && matchesGroup) {
      row.style.display = '';
    } else {
      row.style.display = 'none';
    }
  });
}

function debounce(func, wait) {
  let timeout;
  return function executedFunction(...args) {
    const later = () => {
      clearTimeout(timeout);
      func(...args);
    };
    clearTimeout(timeout);
    timeout = setTimeout(later, wait);
  };
}

document.addEventListener('turbo:load', () => {
  if (typeof lucide !== 'undefined') {
    lucide.createIcons();
  }
});
</script>
