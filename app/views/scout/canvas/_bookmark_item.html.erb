<div class="bookmark-item" data-bookmark-id="<%= bookmark.id %>">
  <div class="bookmark-icon">
    <i data-lucide="<%= bookmark.icon %>" style="width: 20px; height: 20px;"></i>
  </div>
  <div class="bookmark-info">
    <h6 class="bookmark-name"><%= bookmark.title %></h6>
    <% if bookmark.description.present? %>
      <p class="bookmark-desc"><%= truncate(bookmark.description, length: 100) %></p>
    <% end %>
    <div class="bookmark-meta">
      <span class="badge bg-secondary"><%= bookmark.content_type&.titleize || 'Saved' %></span>
      <span class="text-muted"><%= time_ago_in_words(bookmark.created_at) %> ago</span>
      <% if bookmark.shareable? %>
        <span class="badge bg-info">Shared</span>
      <% end %>
    </div>
  </div>
  <div class="bookmark-actions">
    <a href="/bookmarks/<%= bookmark.id %>" class="btn btn-sm btn-outline-primary" target="_blank" title="View">
      <i data-lucide="eye" style="width: 14px; height: 14px;"></i>
    </a>
    <button class="btn btn-sm btn-outline-danger delete-bookmark-btn" 
            data-bookmark-id="<%= bookmark.id %>"
            title="Delete">
      <i data-lucide="trash-2" style="width: 14px; height: 14px;"></i>
    </button>
  </div>
</div>

<style>
  .bookmark-item {
    display: flex;
    align-items: flex-start;
    gap: 16px;
    padding: 16px;
    background: var(--bg-tertiary);
    border: 1px solid var(--border-primary);
    border-radius: 12px;
    transition: all 0.2s ease;
  }

  .bookmark-item:hover {
    background: var(--bg-input);
    border-color: var(--accent-primary);
  }

  .bookmark-icon {
    width: 40px;
    height: 40px;
    background: var(--bg-secondary);
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--accent-primary);
    flex-shrink: 0;
  }

  .bookmark-info {
    flex-grow: 1;
    min-width: 0;
  }

  .bookmark-name {
    color: var(--text-primary);
    font-weight: 500;
    margin-bottom: 4px;
  }

  .bookmark-desc {
    color: var(--text-secondary);
    font-size: 0.875rem;
    margin-bottom: 8px;
    overflow: hidden;
    text-overflow: ellipsis;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
  }

  .bookmark-meta {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.75rem;
  }

  .bookmark-actions {
    display: flex;
    gap: 8px;
    flex-shrink: 0;
    opacity: 0;
    transition: opacity 0.2s ease;
  }

  .bookmark-item:hover .bookmark-actions {
    opacity: 1;
  }

  .bookmark-item.removing {
    opacity: 0.5;
    transform: translateX(20px);
    transition: all 0.3s ease;
  }
</style>

<script>
(function() {
  // Only attach once
  if (window._bookmarkItemsInitialized) return;
  window._bookmarkItemsInitialized = true;

  document.addEventListener('click', async function(e) {
    const deleteBtn = e.target.closest('.delete-bookmark-btn');
    if (!deleteBtn) return;

    const bookmarkId = deleteBtn.dataset.bookmarkId;
    const item = deleteBtn.closest('.bookmark-item');

    if (!await showConfirm('Delete this bookmark?', { title: 'Delete Bookmark', dangerous: true })) return;

    item.classList.add('removing');

    fetch(`/bookmarks/${bookmarkId}`, {
      method: 'DELETE',
      headers: {
        'Content-Type': 'application/json',
        'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]')?.content
      }
    })
    .then(res => {
      if (res.ok) {
        setTimeout(() => item.remove(), 300);
      } else {
        item.classList.remove('removing');
      }
    })
    .catch(() => {
      item.classList.remove('removing');
    });
  });
})();
</script>
