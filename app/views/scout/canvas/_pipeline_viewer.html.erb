<script>
// Pipeline Viewer JavaScript
let draggedCard = null;

function pipelineAllowDrop(event) {
  event.preventDefault();
  event.currentTarget.classList.add('drag-over');
}

function pipelineDragStart(event, opportunityId) {
  draggedCard = event.target.closest('.pipeline-card');
  draggedCard.classList.add('dragging');
  event.dataTransfer.setData('text/plain', opportunityId);
  event.dataTransfer.effectAllowed = 'move';
}

function pipelineDragEnd(event) {
  if (draggedCard) {
    draggedCard.classList.remove('dragging');
  }
  document.querySelectorAll('.pipeline-column-cards').forEach(col => {
    col.classList.remove('drag-over');
  });
}

function pipelineDrop(event, newStage) {
  event.preventDefault();
  event.currentTarget.classList.remove('drag-over');
  
  const opportunityId = event.dataTransfer.getData('text/plain');
  if (!opportunityId || !draggedCard) return;
  
  const currentStage = draggedCard.closest('.pipeline-column-cards').dataset.stage;
  if (currentStage === newStage) return;
  
  // Move card visually
  event.currentTarget.appendChild(draggedCard);
  
  // Update via API
  pipelineMoveStage(opportunityId, newStage);
}

async function pipelineMoveStage(opportunityId, newStage) {
  try {
    const response = await fetch(`/api/v1/opportunities/${opportunityId}/move_stage`, {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]')?.content
      },
      body: JSON.stringify({ stage: newStage })
    });
    
    const data = await response.json();
    if (data.success) {
      showPipelineNotification(`Moved to ${data.opportunity.stage_label}`, 'success');
      updatePipelineCounts();
    } else {
      showPipelineNotification(data.message || 'Failed to move opportunity', 'error');
      pipelineRefresh();
    }
  } catch (error) {
    console.error('Pipeline move error:', error);
    showPipelineNotification('Failed to move opportunity', 'error');
    pipelineRefresh();
  }
}

function pipelineRefresh() {
  window.scoutLoadCanvas?.('pipeline_viewer', {}, true);
}

function pipelineCreateOpportunity() {
  // Open the modal instead of sending a chat message
  const modal = document.getElementById('new-opportunity-modal');
  if (modal) {
    modal.style.display = 'flex';
    // Reset form
    document.getElementById('new-opportunity-form').reset();
    // Focus first input
    setTimeout(() => {
      modal.querySelector('input[name="name"]')?.focus();
    }, 100);
    // Initialize icons
    if (typeof lucide !== 'undefined') lucide.createIcons();
  }
}

function closeOpportunityModal() {
  const modal = document.getElementById('new-opportunity-modal');
  if (modal) {
    modal.style.display = 'none';
  }
}

async function submitOpportunity(event) {
  event.preventDefault();
  const form = event.target;
  const submitBtn = document.getElementById('submit-opportunity-btn');
  
  // Disable button while submitting
  submitBtn.disabled = true;
  submitBtn.textContent = 'Creating...';
  
  const formData = new FormData(form);
  const data = {
    name: formData.get('name'),
    value: parseFloat(formData.get('value')) || 0,
    probability: parseInt(formData.get('probability')) || 20,
    stage: formData.get('stage') || 'lead',
    expected_close_date: formData.get('expected_close_date') || null,
    description: formData.get('description') || ''
  };
  
  try {
    const response = await fetch('/api/v1/opportunities', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]')?.content
      },
      body: JSON.stringify({ opportunity: data })
    });
    
    const result = await response.json();
    
    if (result.success || response.ok) {
      showPipelineNotification('Opportunity created successfully!', 'success');
      closeOpportunityModal();
      pipelineRefresh();
    } else {
      showPipelineNotification(result.message || result.error || 'Failed to create opportunity', 'error');
    }
  } catch (error) {
    console.error('Create opportunity error:', error);
    showPipelineNotification('Failed to create opportunity', 'error');
  } finally {
    submitBtn.disabled = false;
    submitBtn.textContent = 'Create Opportunity';
  }
}

function pipelineViewOpportunity(id) {
  // Load pipeline viewer focused on this opportunity (future: opportunity detail canvas)
  window.scoutLoadCanvas?.('pipeline_viewer', { opportunity_id: id, expanded: true }, true);
}

async function pipelineCloseWon(id, name) {
  if (await showConfirm(`Mark "${name}" as Won?`, { title: 'Mark as Won' })) {
    fetch(`/api/v1/opportunities/${id}/close_won`, {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]')?.content
      }
    })
    .then(r => r.json())
    .then(data => {
      if (data.success) {
        showPipelineNotification('🎉 ' + data.message, 'success');
        pipelineRefresh();
      } else {
        showPipelineNotification(data.message, 'error');
      }
    });
  }
}

function pipelineCloseLost(id, name) {
  const reason = prompt(`Why was "${name}" lost?\n\nOptions: price, competitor, no_budget, timing, no_decision, lost_contact, product_fit, went_silent, other`);
  if (reason) {
    fetch(`/api/v1/opportunities/${id}/close_lost`, {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]')?.content
      },
      body: JSON.stringify({ reason: reason })
    })
    .then(r => r.json())
    .then(data => {
      if (data.success) {
        showPipelineNotification(data.message, 'success');
        pipelineRefresh();
      } else {
        showPipelineNotification(data.message, 'error');
      }
    });
  }
}

function toggleClosedLost() {
  const cards = document.getElementById('closed-lost-cards');
  const icon = document.getElementById('closed-lost-icon');
  if (cards.style.display === 'none') {
    cards.style.display = 'flex';
    icon.setAttribute('data-lucide', 'chevron-up');
  } else {
    cards.style.display = 'none';
    icon.setAttribute('data-lucide', 'chevron-down');
  }
  if (typeof lucide !== 'undefined') lucide.createIcons();
}

function updatePipelineCounts() {
  fetch('/api/v1/opportunities/pipeline')
    .then(r => r.json())
    .then(data => {
      if (data.success) {
        // Update counts
        Object.keys(data.pipeline).forEach(stage => {
          const countEl = document.getElementById(`count-${stage}`);
          const valueEl = document.getElementById(`value-${stage}`);
          if (countEl) countEl.textContent = data.pipeline[stage].count;
          if (valueEl) valueEl.textContent = '$' + (data.pipeline[stage].total_value || 0).toLocaleString();
        });
        
        // Update stats
        document.getElementById('stat-total-open').textContent = data.stats.total_open;
        document.getElementById('stat-total-value').textContent = '$' + (data.stats.total_value || 0).toLocaleString();
        document.getElementById('stat-weighted-value').textContent = '$' + Math.round(data.stats.weighted_value || 0).toLocaleString();
        document.getElementById('stat-win-rate').textContent = data.stats.win_rate + '%';
      }
    });
}

function showPipelineNotification(message, type = 'info') {
  // Use Scout's notification system if available
  if (window.showNotification) {
    window.showNotification(message, type);
  } else {
    showInfo(message);
  }
}

// Initialize drag events
document.addEventListener('DOMContentLoaded', function() {
  document.querySelectorAll('.pipeline-card').forEach(card => {
    card.addEventListener('dragend', pipelineDragEnd);
  });
  
  document.querySelectorAll('.pipeline-column-cards').forEach(col => {
    col.addEventListener('dragleave', function(e) {
      if (!e.currentTarget.contains(e.relatedTarget)) {
        e.currentTarget.classList.remove('drag-over');
      }
    });
  });
  
  if (typeof lucide !== 'undefined') lucide.createIcons();
});
</script>
