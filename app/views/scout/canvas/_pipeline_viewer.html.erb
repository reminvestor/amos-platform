<div class="scout-canvas canvas-container pipeline-viewer" data-controller="pipeline">
  <!-- Page Header with Actions -->
  <div class="canvas-header-row">
    <div class="canvas-header-left">
      <h1 class="canvas-page-title">
        <i data-lucide="git-branch"></i>
        Sales Pipeline
      </h1>
      <p class="canvas-page-subtitle">Manage opportunities through your sales process</p>
    </div>
    <div class="canvas-header-actions">
      <button onclick="pipelineRefresh()" class="canvas-btn secondary">
        <i data-lucide="refresh-cw"></i>
        Refresh
      </button>
      <button onclick="pipelineCreateOpportunity()" class="canvas-btn primary">
        <i data-lucide="plus"></i>
        New Opportunity
      </button>
    </div>
  </div>

  <!-- Quick Stats -->
  <div class="canvas-stats-grid">
    <div class="canvas-stat-card purple">
      <div>
        <p class="canvas-stat-label">Open Opportunities</p>
        <p class="canvas-stat-value" id="stat-total-open"><%= stats[:total_open] %></p>
      </div>
      <div class="canvas-stat-icon purple">
        <i data-lucide="briefcase"></i>
      </div>
    </div>

    <div class="canvas-stat-card green">
      <div>
        <p class="canvas-stat-label">Total Value</p>
        <p class="canvas-stat-value" id="stat-total-value"><%= number_to_currency(stats[:total_value], precision: 0) %></p>
      </div>
      <div class="canvas-stat-icon green">
        <i data-lucide="dollar-sign"></i>
      </div>
    </div>

    <div class="canvas-stat-card cyan">
      <div>
        <p class="canvas-stat-label">Weighted Value</p>
        <p class="canvas-stat-value" id="stat-weighted-value"><%= number_to_currency(stats[:weighted_value], precision: 0) %></p>
      </div>
      <div class="canvas-stat-icon cyan">
        <i data-lucide="trending-up"></i>
      </div>
    </div>

    <div class="canvas-stat-card yellow">
      <div>
        <p class="canvas-stat-label">Win Rate</p>
        <p class="canvas-stat-value" id="stat-win-rate"><%= stats[:win_rate] %>%</p>
      </div>
      <div class="canvas-stat-icon yellow">
        <i data-lucide="target"></i>
      </div>
    </div>
  </div>

  <!-- Kanban Board -->
  <div class="pipeline-kanban" id="pipeline-board">
    <% Opportunity::STAGES.each do |stage_key, stage_info| %>
      <% next if stage_key == 'closed_lost' # Show at end %>
      <div class="pipeline-column" data-stage="<%= stage_key %>">
        <div class="pipeline-column-header" style="border-top: 3px solid <%= stage_info[:color] %>;">
          <div class="pipeline-column-title">
            <span class="pipeline-column-name"><%= stage_info[:label] %></span>
            <span class="pipeline-column-count" id="count-<%= stage_key %>">
              <%= pipeline[stage_key]&.dig(:count) || 0 %>
            </span>
          </div>
          <div class="pipeline-column-value" id="value-<%= stage_key %>">
            <%= number_to_currency(pipeline[stage_key]&.dig(:total_value) || 0, precision: 0) %>
          </div>
        </div>
        <div class="pipeline-column-cards" 
             data-stage="<%= stage_key %>"
             ondragover="pipelineAllowDrop(event)"
             ondrop="pipelineDrop(event, '<%= stage_key %>')">
          <% (pipeline[stage_key]&.dig(:opportunities) || []).each do |opp| %>
            <%= render partial: 'scout/canvas/pipeline_card', locals: { opportunity: opp } %>
          <% end %>
          <% if (pipeline[stage_key]&.dig(:opportunities) || []).empty? %>
            <div class="pipeline-empty-state">
              <i data-lucide="inbox"></i>
              <p>No opportunities</p>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>
    
    <!-- Closed Lost Column (collapsible) -->
    <div class="pipeline-column pipeline-column-closed" data-stage="closed_lost">
      <div class="pipeline-column-header" style="border-top: 3px solid #EF4444;">
        <div class="pipeline-column-title">
          <span class="pipeline-column-name">Closed Lost</span>
          <span class="pipeline-column-count" id="count-closed_lost">
            <%= pipeline['closed_lost']&.dig(:count) || 0 %>
          </span>
        </div>
        <button onclick="toggleClosedLost()" class="pipeline-toggle-btn">
          <i data-lucide="chevron-down" id="closed-lost-icon"></i>
        </button>
      </div>
      <div class="pipeline-column-cards pipeline-closed-cards" 
           id="closed-lost-cards"
           data-stage="closed_lost"
           style="display: none;">
        <% (pipeline['closed_lost']&.dig(:opportunities) || []).each do |opp| %>
          <%= render partial: 'scout/canvas/pipeline_card', locals: { opportunity: opp, closed: true } %>
        <% end %>
      </div>
    </div>
  </div>
</div>

<!-- New Opportunity Modal -->
<div id="new-opportunity-modal" class="pipeline-modal-overlay" style="display: none;" onclick="if(event.target === this) closeOpportunityModal()">
  <div class="pipeline-modal">
    <div class="pipeline-modal-header">
      <h2 class="pipeline-modal-title">New Opportunity</h2>
      <button class="pipeline-modal-close" onclick="closeOpportunityModal()">
        <i data-lucide="x"></i>
      </button>
    </div>
    <form id="new-opportunity-form" onsubmit="submitOpportunity(event)">
      <div class="pipeline-modal-body">
        <div class="pipeline-form-group">
          <label class="pipeline-form-label">Opportunity Name *</label>
          <input type="text" name="name" class="pipeline-form-input" placeholder="e.g., Enterprise Deal - Acme Corp" required>
        </div>
        
        <div class="pipeline-form-row">
          <div class="pipeline-form-group">
            <label class="pipeline-form-label">Value ($)</label>
            <input type="number" name="value" class="pipeline-form-input" placeholder="10000" min="0" step="0.01">
          </div>
          <div class="pipeline-form-group">
            <label class="pipeline-form-label">Probability (%)</label>
            <input type="number" name="probability" class="pipeline-form-input" placeholder="20" min="0" max="100" value="20">
          </div>
        </div>
        
        <div class="pipeline-form-group">
          <label class="pipeline-form-label">Stage</label>
          <select name="stage" class="pipeline-form-select">
            <option value="lead">Lead</option>
            <option value="qualified">Qualified</option>
            <option value="proposal">Proposal</option>
            <option value="negotiation">Negotiation</option>
            <option value="closed_won">Closed Won</option>
          </select>
        </div>
        
        <div class="pipeline-form-group">
          <label class="pipeline-form-label">Expected Close Date</label>
          <input type="date" name="expected_close_date" class="pipeline-form-input">
        </div>
        
        <div class="pipeline-form-group">
          <label class="pipeline-form-label">Description</label>
          <textarea name="description" class="pipeline-form-textarea" placeholder="Additional details about this opportunity..."></textarea>
        </div>
      </div>
      <div class="pipeline-modal-footer">
        <button type="button" class="pipeline-btn pipeline-btn-secondary" onclick="closeOpportunityModal()">Cancel</button>
        <button type="submit" class="pipeline-btn pipeline-btn-primary" id="submit-opportunity-btn">Create Opportunity</button>
      </div>
    </form>
  </div>
</div>

