<div class="scout-canvas landing-page-details">
  <div class="canvas-header d-flex justify-content-between align-items-center mb-4">
    <div>
      <button class="btn btn-outline-secondary me-3" onclick="window.scoutBackToLandingPages()" aria-label="Back to landing pages">
        <i data-lucide="arrow-left" class="me-1" aria-hidden="true"></i>
        Back to Landing Pages
      </button>
      <div class="d-inline-block">
        <h4 class="mb-1">
          <i data-lucide="globe" class="text-primary me-2" aria-hidden="true"></i>
          <%= landing_page.title.present? ? landing_page.title : "Untitled Landing Page" %>
        </h4>
        <p class="text-muted mb-0">Landing Page Details</p>
      </div>
    </div>
    <div class="btn-group" role="group">
      <button class="btn btn-outline-success" onclick="scoutPreviewLandingPageInTab(<%= landing_page.id %>)" aria-label="Preview landing page">
        <i data-lucide="eye" class="me-1" aria-hidden="true"></i>
        Preview
      </button>
      <% if landing_page.status == 'published' %>
        <a class="btn btn-outline-info" href="<%= landing_page.full_url(request.base_url) %>" target="_blank" aria-label="View live landing page">
          <i data-lucide="external-link" class="me-1" aria-hidden="true"></i>
          View Live
        </a>
        <button class="btn btn-outline-warning" onclick="togglePublishStatus(<%= landing_page.id %>, 'draft')" aria-label="Unpublish landing page">
          <i data-lucide="eye-off" class="me-1" aria-hidden="true"></i>
          Unpublish
        </button>
      <% else %>
        <button class="btn btn-success" onclick="togglePublishStatus(<%= landing_page.id %>, 'published')" aria-label="Publish landing page">
          <i data-lucide="globe" class="me-1" aria-hidden="true"></i>
          Publish
        </button>
      <% end %>
    </div>
  </div>

  <!-- Expandable Sections at Top -->
  <div class="row mb-3">
    <div class="col-12">
      <!-- Basic Information (Collapsible) -->
      <div class="card border-0 shadow-sm mb-2">
        <div class="card-header bg-light py-2" style="cursor: pointer;" data-bs-toggle="collapse" data-bs-target="#basicInfoCollapse">
          <div class="d-flex justify-content-between align-items-center">
            <h6 class="mb-0">
              <i data-lucide="info" class="me-2" aria-hidden="true"></i>
              Basic Information
              <span class="badge bg-<%= landing_page.status == 'published' ? 'success' : landing_page.status == 'draft' ? 'secondary' : 'warning' %> ms-2">
                <%= landing_page.status.titleize %>
              </span>
            </h6>
            <i data-lucide="chevron-down" aria-hidden="true"></i>
          </div>
        </div>
        <div class="collapse" id="basicInfoCollapse">
          <div class="card-body">
            <div class="row">
              <div class="col-md-6">
                <div class="mb-3">
                  <label class="form-label text-muted small">Title</label>
                  <div class="fw-medium">
                    <%= landing_page.title.present? ? landing_page.title : "Untitled Landing Page" %>
                  </div>
                </div>
                
                <% if landing_page.slug.present? %>
                  <div class="mb-3">
                    <label class="form-label text-muted small">URL Slug</label>
                    <div class="font-monospace small bg-light p-2 rounded">
                      <%= landing_page.slug %>
                    </div>
                  </div>
                <% end %>
                
                <% if landing_page.description.present? %>
                  <div class="mb-3">
                    <label class="form-label text-muted small">Description</label>
                    <div>
                      <%= landing_page.description %>
                    </div>
                  </div>
                <% end %>
              </div>
              
              <div class="col-md-6">
                <% if landing_page.status == 'published' && landing_page.slug.present? %>
                  <div class="mb-3">
                    <label class="form-label text-muted small">Public URL</label>
                    <div class="input-group">
                      <input type="text" class="form-control font-monospace small" 
                             value="<%= request.protocol + request.host_with_port.sub(/^www\./, '') + '/landing/' + landing_page.slug %>" 
                             readonly onclick="this.select()">
                      <button class="btn btn-outline-secondary" type="button"
                              onclick="window.open('<%= request.protocol + request.host_with_port.sub(/^www\./, '') + '/landing/' + landing_page.slug %>', '_blank', 'noopener,noreferrer')"
                              aria-label="Open public page">
                        <i data-lucide="external-link" aria-hidden="true"></i>
                      </button>
                      <button class="btn btn-outline-secondary" type="button"
                              onclick="copyPublicUrl(this)"
                              aria-label="Copy URL">
                        <i data-lucide="copy" aria-hidden="true"></i>
                      </button>
                    </div>
                    <small class="text-muted">Public URL accessible without login</small>
                  </div>
                <% end %>
                
                <div class="mb-3">
                  <label class="form-label text-muted small">Created</label>
                  <div>
                    <%= landing_page.created_at.strftime("%b %d, %Y at %I:%M %p") %>
                    <small class="text-muted">(<%= time_ago_in_words(landing_page.created_at) %> ago)</small>
                  </div>
                </div>
                
                <div class="mb-3">
                  <label class="form-label text-muted small">Last Updated</label>
                  <div>
                    <%= landing_page.updated_at.strftime("%b %d, %Y at %I:%M %p") %>
                    <small class="text-muted">(<%= time_ago_in_words(landing_page.updated_at) %> ago)</small>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Technical Details (Collapsible) -->
      <div class="card border-0 shadow-sm mb-2">
        <div class="card-header bg-light py-2" style="cursor: pointer;" data-bs-toggle="collapse" data-bs-target="#technicalDetailsCollapse">
          <div class="d-flex justify-content-between align-items-center">
            <h6 class="mb-0">
              <i data-lucide="trending-up" class="me-2" aria-hidden="true"></i>
              Technical Details & Analytics
            </h6>
            <i data-lucide="chevron-down" aria-hidden="true"></i>
          </div>
        </div>
        <div class="collapse" id="technicalDetailsCollapse">
          <div class="card-body">
            <div class="row">
              <div class="col-md-3">
                <div class="text-center">
                  <div class="h4 mb-1 text-primary">0</div>
                  <div class="small text-muted">Page Views</div>
                </div>
              </div>
              <div class="col-md-3">
                <div class="text-center">
                  <div class="h4 mb-1 text-success">0</div>
                  <div class="small text-muted">Conversions</div>
                </div>
              </div>
              <div class="col-md-3">
                <div class="text-center">
                  <div class="h4 mb-1 text-info">0%</div>
                  <div class="small text-muted">Conversion Rate</div>
                </div>
              </div>
              <div class="col-md-3">
                <div class="text-center">
                  <div class="h4 mb-1 text-warning"><%= number_to_human_size(landing_page.html_content&.bytesize || 0) %></div>
                  <div class="small text-muted">Page Size</div>
                </div>
              </div>
            </div>
            <hr>
            <div class="row">
              <div class="col-md-6">
                <strong class="small">Technical Info:</strong>
                <ul class="list-unstyled small mt-2">
                  <li><strong>ID:</strong> <%= landing_page.id %></li>
                  <li><strong>Entity:</strong> <%= landing_page.entity.name %></li>
                  <li><strong>Generated:</strong> <%= landing_page.html_content.present? ? 'Yes' : 'In Progress' %></li>
                  <li><strong>SEO Ready:</strong> <%= landing_page.html_content&.include?('meta') ? 'Yes' : 'No' %></li>
                </ul>
              </div>
              <div class="col-md-6">
                <strong class="small">Performance:</strong>
                <ul class="list-unstyled small mt-2">
                  <li><strong>Mobile Optimized:</strong> <%= landing_page.html_content&.include?('viewport') ? 'Yes' : 'No' %></li>
                  <li><strong>Bootstrap:</strong> <%= landing_page.html_content&.include?('bootstrap') ? 'Yes' : 'No' %></li>
                  <li><strong>Contact Form:</strong> <%= landing_page.html_content&.include?('/api/v1/contacts') ? 'Yes' : 'No' %></li>
                  <li><strong>Last Generated:</strong> <%= landing_page.updated_at.strftime("%I:%M %p") %></li>
                </ul>
              </div>
            </div>
            
            <% if landing_page.landing_page_versions.any? %>
              <hr>
              <div class="row">
                <div class="col-12">
                  <strong class="small">Version History:</strong>
                  <div class="mt-2">
                    <div class="small text-muted mb-2">
                      <%= pluralize(landing_page.landing_page_versions.count, 'version') %> available
                    </div>
                    <% recent_versions = landing_page.landing_page_versions.where("content->>'html_content' IS NOT NULL").order(created_at: :desc).limit(3) %>
                    <% if recent_versions.any? %>
                      <% recent_versions.each do |version| %>
                        <div class="d-flex justify-content-between align-items-center py-1 border-bottom">
                          <div class="small">
                            <strong><%= version.created_at.strftime("%m/%d %I:%M %p") %></strong>
                            <br>
                            <span class="text-muted"><%= version.description&.truncate(50) || "Version backup" %></span>
                          </div>
                          <button class="btn btn-sm btn-outline-warning"
                                  onclick="revertToVersion(<%= landing_page.id %>, <%= version.id %>)"
                                  aria-label="Revert to version from <%= version.created_at.strftime('%m/%d %I:%M %p') %>">
                            <i data-lucide="rotate-ccw" class="me-1" aria-hidden="true"></i>Revert
                          </button>
                        </div>
                      <% end %>
                      <div class="mt-2">
                        <button class="btn btn-sm btn-outline-secondary"
                                onclick="window.scoutLoadCanvas?.('version_history', { landing_page_id: '<%= landing_page.id %>' })"
                                aria-label="View all versions">
                          <i data-lucide="history" class="me-1" aria-hidden="true"></i>View All Versions
                        </button>
                      </div>
                    <% else %>
                      <div class="small text-muted">No versions with content available for revert</div>
                    <% end %>
                  </div>
                </div>
              </div>
            <% else %>
              <hr>
              <div class="row">
                <div class="col-12">
                  <strong class="small">Version History:</strong>
                  <div class="small text-muted mt-2">No backup versions created yet</div>
                </div>
              </div>
            <% end %>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Main Content Preview (Full Canvas) -->
  <div class="row flex-grow-1">
    <div class="col-12 d-flex flex-column">
      <div class="card border-0 shadow-sm h-100">
        <div class="card-header bg-white d-flex justify-content-between align-items-center">
          <h6 class="mb-0">
            <i data-lucide="code" class="me-2" aria-hidden="true"></i>
            Content Preview
          </h6>
          <div class="btn-group btn-group-sm" role="group">
            <button type="button" class="btn btn-primary" id="visual-mode-btn" onclick="switchToVisualMode()" aria-label="Switch to visual mode">
              <i data-lucide="eye" class="me-1" aria-hidden="true"></i>
              Visual
            </button>

            <button type="button" class="btn btn-outline-primary" id="html-mode-btn" onclick="switchToHtmlMode()" aria-label="Switch to HTML mode">
              <i data-lucide="code" class="me-1" aria-hidden="true"></i>
              HTML
            </button>
          </div>
        </div>
        <div class="card-body p-0 d-flex flex-column flex-grow-1">
          <% if landing_page.html_content.present? %>
            <div id="visual-preview" class="flex-grow-1">
              <iframe 
                src="/landing_pages/<%= landing_page.id %>/preview" 
                class="w-100 h-100 border-0"
                style="min-height: 700px;">
              </iframe>
            </div>
            <div id="html-preview" class="flex-grow-1 d-none p-2">
              <div class="d-flex justify-content-between align-items-center mb-2">
                <small class="text-muted">Edit HTML directly (changes are not automatically saved)</small>
                <button class="btn btn-sm btn-success" onclick="saveHtmlChanges(<%= landing_page.id %>)" aria-label="Save HTML changes">
                  <i data-lucide="save" class="me-1" aria-hidden="true"></i>
                  Save Changes
                </button>
              </div>
              <textarea 
                id="html-editor"
                class="form-control h-100 font-monospace small" 
                style="resize: none; border: 1px solid #dee2e6; min-height: 600px;"
                placeholder="HTML content will appear here..."><%= html_escape(landing_page.html_content) %></textarea>
            </div>
          <% else %>
            <div class="d-flex align-items-center justify-content-center flex-grow-1 text-center p-5">
              <div>
                <div class="spinner-border text-primary mb-3" role="status">
                  <span class="visually-hidden">Loading...</span>
                </div>
                <h5 class="text-muted">AI Generation in Progress</h5>
                <p class="text-muted mb-4">Your landing page content is being generated using advanced AI. This typically takes 30-60 seconds.</p>
                <div class="progress mb-3" style="height: 10px;">
                  <div class="progress-bar progress-bar-striped progress-bar-animated" role="progressbar" style="width: 45%"></div>
                </div>
                <button class="btn btn-outline-primary" onclick="window.scoutRefreshCanvas()" aria-label="Check generation progress">
                  <i data-lucide="refresh-cw" class="me-2" aria-hidden="true"></i>
                  Check Progress
                </button>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
// Landing page action functions
function scoutPreviewLandingPageInTab(pageId) {
  window.open(`/landing_pages/${pageId}/preview`, '_blank');
}

function copyPublicUrl(button) {
  const urlInput = button.previousElementSibling.previousElementSibling;
  
  // Use modern clipboard API with fallback
  if (navigator.clipboard && window.isSecureContext) {
    navigator.clipboard.writeText(urlInput.value).then(() => {
      showCopySuccess(button);
    }).catch(() => {
      fallbackCopyText(urlInput, button);
    });
  } else {
    fallbackCopyText(urlInput, button);
  }
}

function fallbackCopyText(input, button) {
  input.select();
  input.setSelectionRange(0, 99999); // For mobile devices
  try {
    document.execCommand('copy');
    showCopySuccess(button);
  } catch (err) {
    console.error('Failed to copy text: ', err);
    button.innerHTML = '<i data-lucide="alert-triangle" aria-hidden="true"></i> Error';
    if (typeof lucide !== 'undefined') {
      lucide.createIcons();
    }
    setTimeout(() => {
      button.innerHTML = '<i data-lucide="copy" aria-hidden="true"></i>';
      if (typeof lucide !== 'undefined') {
        lucide.createIcons();
      }
    }, 2000);
  }
}

function showCopySuccess(button) {
  const originalHtml = button.innerHTML;
  button.innerHTML = '<i data-lucide="check" class="text-success" aria-hidden="true"></i> Copied!';
  button.classList.add('btn-success');
  button.classList.remove('btn-outline-secondary');
  if (typeof lucide !== 'undefined') {
    lucide.createIcons();
  }

  setTimeout(() => {
    button.innerHTML = '<i data-lucide="copy" aria-hidden="true"></i>';
    button.classList.remove('btn-success');
    button.classList.add('btn-outline-secondary');
    if (typeof lucide !== 'undefined') {
      lucide.createIcons();
    }
  }, 2000);
}

async function revertToVersion(landingPageId, versionId) {
  if (!await showConfirm('Are you sure you want to revert to this version? This will create a backup of the current content.', { title: 'Revert Version', dangerous: true })) {
    return;
  }
  
  console.log(`🔄 Reverting landing page ${landingPageId} to version ${versionId}`);
  
  // Send message to Scout to revert the landing page
  const message = `Revert landing page ${landingPageId} to version ${versionId}`;
  
  if (window.scoutLoadCanvas) {
    window.scoutLoadCanvas('landing_page_details', { landing_page_id: landingPageId, revert_to: versionId }, true);
  } else {
    console.error('Scout loadCanvas function not available');
    showError('Unable to revert: Scout communication not available');
  }
}

function togglePublishStatus(pageId, newStatus) {
  const action = newStatus === 'published' ? 'publish' : 'unpublish';
  const confirmMsg = newStatus === 'published' 
    ? 'Publish this landing page? It will be publicly accessible.'
    : 'Unpublish this landing page? It will no longer be publicly accessible.';
  
  if (!await showConfirm(confirmMsg)) return;
  
  fetch(`/landing_pages/${pageId}/${action}`, {
    method: 'POST',
    headers: {
      'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]')?.getAttribute('content'),
      'Accept': 'application/json'
    }
  })
  .then(response => {
    if (response.ok || response.redirected) {
      showNotification(`Landing page ${action}ed successfully!`, 'success');
      // Reload the canvas to reflect the new status
      setTimeout(() => {
        window.scoutLoadCanvas?.('landing_page_details', { landing_page_id: pageId });
      }, 500);
    } else {
      throw new Error(`Failed to ${action} landing page`);
    }
  })
  .catch(error => {
    console.error(`Error ${action}ing landing page:`, error);
    showNotification(`Error: ${error.message}`, 'error');
  });
}

function showNotification(message, type = 'info') {
  const alertClass = {
    'success': 'alert-success',
    'error': 'alert-danger',
    'warning': 'alert-warning',
    'info': 'alert-info'
  }[type] || 'alert-info';
  
  const alert = document.createElement('div');
  alert.className = `alert ${alertClass} alert-dismissible fade show position-fixed top-0 start-50 translate-middle-x mt-3`;
  alert.style.zIndex = '1050';
  alert.innerHTML = `
    ${message}
    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
  `;
  document.body.appendChild(alert);
  
  setTimeout(() => {
    alert.remove();
  }, 3000);
}

// Auto-refresh disabled - using real-time WebSocket updates instead
<% unless landing_page.html_content.present? %>
console.log('🔄 Landing page content pending - will update via WebSocket when generation completes');
<% end %>

// Initialize the canvas
console.log('Landing page details canvas loaded');
console.log('Toggle functions available:', {
  switchToVisualMode: typeof window.switchToVisualMode,
  switchToHtmlMode: typeof window.switchToHtmlMode,
  saveHtmlChanges: typeof window.saveHtmlChanges,
  revertToVersion: typeof revertToVersion
});
</script>

<style>
.scout-canvas {
  padding: 1rem;
  height: 100%;
  overflow-y: auto;
}

.preview-container {
  max-height: 600px;
  overflow-y: auto;
}

.code-preview {
  background: #f8f9fa;
  border-radius: 0;
  font-family: 'Courier New', monospace;
  font-size: 0.875rem;
  line-height: 1.4;
  white-space: pre-wrap;
  word-wrap: break-word;
  max-height: 600px;
  overflow-y: auto;
}

.badge.fs-6 {
  font-size: 0.875rem !important;
}
</style> 