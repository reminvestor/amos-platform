<div class="scout-canvas landing-page-details">
  <div class="canvas-header d-flex justify-content-between align-items-center mb-4">
    <div>
      <button class="btn btn-outline-secondary me-3" onclick="window.scoutBackToLandingPages()">
        <i class="fas fa-arrow-left me-1"></i>
        Back to Landing Pages
      </button>
      <div class="d-inline-block">
        <h4 class="mb-1">
          <i class="fas fa-globe text-primary me-2"></i>
          <%= landing_page.title.present? ? landing_page.title : "Untitled Landing Page" %>
        </h4>
        <p class="text-muted mb-0">Landing Page Details</p>
      </div>
    </div>
    <div class="btn-group" role="group">
      <button class="btn btn-outline-success" onclick="scoutPreviewLandingPageInTab(<%= landing_page.id %>)">
        <i class="fas fa-eye me-1"></i>
        Preview
      </button>
      <% if landing_page.status == 'published' %>
        <a class="btn btn-outline-info" href="<%= landing_page.full_url(request.base_url) %>" target="_blank">
          <i class="fas fa-external-link-alt me-1"></i>
          View Live
        </a>
      <% end %>
    </div>
  </div>

  <!-- Expandable Sections at Top -->
  <div class="row mb-3">
    <div class="col-12">
      <!-- Basic Information (Collapsible) -->
      <div class="card border-0 shadow-sm mb-2">
        <div class="card-header bg-light py-2" style="cursor: pointer;" data-bs-toggle="collapse" data-bs-target="#basicInfoCollapse">
          <div class="d-flex justify-content-between align-items-center">
            <h6 class="mb-0">
              <i class="fas fa-info-circle me-2"></i>
              Basic Information
              <span class="badge bg-<%= landing_page.status == 'published' ? 'success' : landing_page.status == 'draft' ? 'secondary' : 'warning' %> ms-2">
                <%= landing_page.status.titleize %>
              </span>
            </h6>
            <i class="fas fa-chevron-down"></i>
          </div>
        </div>
        <div class="collapse" id="basicInfoCollapse">
          <div class="card-body">
            <div class="row">
              <div class="col-md-6">
                <div class="mb-3">
                  <label class="form-label text-muted small">Title</label>
                  <div class="fw-medium">
                    <%= landing_page.title.present? ? landing_page.title : "Untitled Landing Page" %>
                  </div>
                </div>
                
                <% if landing_page.slug.present? %>
                  <div class="mb-3">
                    <label class="form-label text-muted small">URL Slug</label>
                    <div class="font-monospace small bg-light p-2 rounded">
                      <%= landing_page.slug %>
                    </div>
                  </div>
                <% end %>
                
                <% if landing_page.description.present? %>
                  <div class="mb-3">
                    <label class="form-label text-muted small">Description</label>
                    <div>
                      <%= landing_page.description %>
                    </div>
                  </div>
                <% end %>
              </div>
              
              <div class="col-md-6">
                <% if landing_page.status == 'published' && landing_page.slug.present? %>
                  <div class="mb-3">
                    <label class="form-label text-muted small">Public URL</label>
                    <div class="input-group">
                      <input type="text" class="form-control font-monospace small" 
                             value="<%= request.protocol + request.host_with_port.sub(/^www\./, '') + '/landing/' + landing_page.slug %>" 
                             readonly onclick="this.select()">
                      <button class="btn btn-outline-secondary" type="button" 
                              onclick="window.open('<%= request.protocol + request.host_with_port.sub(/^www\./, '') + '/landing/' + landing_page.slug %>', '_blank')"
                              title="Open public page">
                        <i class="fas fa-external-link-alt"></i>
                      </button>
                      <button class="btn btn-outline-secondary" type="button" 
                              onclick="copyPublicUrl(this)"
                              title="Copy URL">
                        <i class="fas fa-copy"></i>
                      </button>
                    </div>
                    <small class="text-muted">Public URL accessible without login</small>
                  </div>
                <% end %>
                
                <div class="mb-3">
                  <label class="form-label text-muted small">Created</label>
                  <div>
                    <%= landing_page.created_at.strftime("%b %d, %Y at %I:%M %p") %>
                    <small class="text-muted">(<%= time_ago_in_words(landing_page.created_at) %> ago)</small>
                  </div>
                </div>
                
                <div class="mb-3">
                  <label class="form-label text-muted small">Last Updated</label>
                  <div>
                    <%= landing_page.updated_at.strftime("%b %d, %Y at %I:%M %p") %>
                    <small class="text-muted">(<%= time_ago_in_words(landing_page.updated_at) %> ago)</small>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Technical Details (Collapsible) -->
      <div class="card border-0 shadow-sm mb-2">
        <div class="card-header bg-light py-2" style="cursor: pointer;" data-bs-toggle="collapse" data-bs-target="#technicalDetailsCollapse">
          <div class="d-flex justify-content-between align-items-center">
            <h6 class="mb-0">
              <i class="fas fa-chart-line me-2"></i>
              Technical Details & Analytics
            </h6>
            <i class="fas fa-chevron-down"></i>
          </div>
        </div>
        <div class="collapse" id="technicalDetailsCollapse">
          <div class="card-body">
            <div class="row">
              <div class="col-md-3">
                <div class="text-center">
                  <div class="h4 mb-1 text-primary">0</div>
                  <div class="small text-muted">Page Views</div>
                </div>
              </div>
              <div class="col-md-3">
                <div class="text-center">
                  <div class="h4 mb-1 text-success">0</div>
                  <div class="small text-muted">Conversions</div>
                </div>
              </div>
              <div class="col-md-3">
                <div class="text-center">
                  <div class="h4 mb-1 text-info">0%</div>
                  <div class="small text-muted">Conversion Rate</div>
                </div>
              </div>
              <div class="col-md-3">
                <div class="text-center">
                  <div class="h4 mb-1 text-warning"><%= number_to_human_size(landing_page.html_content&.bytesize || 0) %></div>
                  <div class="small text-muted">Page Size</div>
                </div>
              </div>
            </div>
            <hr>
            <div class="row">
              <div class="col-md-6">
                <strong class="small">Technical Info:</strong>
                <ul class="list-unstyled small mt-2">
                  <li><strong>ID:</strong> <%= landing_page.id %></li>
                  <li><strong>Entity:</strong> <%= landing_page.entity.name %></li>
                  <li><strong>Generated:</strong> <%= landing_page.html_content.present? ? 'Yes' : 'In Progress' %></li>
                  <li><strong>SEO Ready:</strong> <%= landing_page.html_content&.include?('meta') ? 'Yes' : 'No' %></li>
                </ul>
              </div>
              <div class="col-md-6">
                <strong class="small">Performance:</strong>
                <ul class="list-unstyled small mt-2">
                  <li><strong>Mobile Optimized:</strong> <%= landing_page.html_content&.include?('viewport') ? 'Yes' : 'No' %></li>
                  <li><strong>Bootstrap:</strong> <%= landing_page.html_content&.include?('bootstrap') ? 'Yes' : 'No' %></li>
                  <li><strong>Contact Form:</strong> <%= landing_page.html_content&.include?('/api/v1/contacts') ? 'Yes' : 'No' %></li>
                  <li><strong>Last Generated:</strong> <%= landing_page.updated_at.strftime("%I:%M %p") %></li>
                </ul>
              </div>
            </div>
            
            <% if landing_page.landing_page_versions.any? %>
              <hr>
              <div class="row">
                <div class="col-12">
                  <strong class="small">Version History:</strong>
                  <div class="mt-2">
                    <div class="small text-muted mb-2">
                      <%= pluralize(landing_page.landing_page_versions.count, 'version') %> available
                    </div>
                    <% recent_versions = landing_page.landing_page_versions.where("content->>'html_content' IS NOT NULL").order(created_at: :desc).limit(3) %>
                    <% if recent_versions.any? %>
                      <% recent_versions.each do |version| %>
                        <div class="d-flex justify-content-between align-items-center py-1 border-bottom">
                          <div class="small">
                            <strong><%= version.created_at.strftime("%m/%d %I:%M %p") %></strong>
                            <br>
                            <span class="text-muted"><%= version.description&.truncate(50) || "Version backup" %></span>
                          </div>
                          <button class="btn btn-sm btn-outline-warning" 
                                  onclick="revertToVersion(<%= landing_page.id %>, <%= version.id %>)"
                                  title="Revert to this version">
                            <i class="fas fa-undo me-1"></i>Revert
                          </button>
                        </div>
                      <% end %>
                      <div class="mt-2">
                        <button class="btn btn-sm btn-outline-secondary" 
                                onclick="window.scoutSendMessage?.('Show me all versions for landing page <%= landing_page.id %>')"
                                title="View all versions">
                          <i class="fas fa-history me-1"></i>View All Versions
                        </button>
                      </div>
                    <% else %>
                      <div class="small text-muted">No versions with content available for revert</div>
                    <% end %>
                  </div>
                </div>
              </div>
            <% else %>
              <hr>
              <div class="row">
                <div class="col-12">
                  <strong class="small">Version History:</strong>
                  <div class="small text-muted mt-2">No backup versions created yet</div>
                </div>
              </div>
            <% end %>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Main Content Preview (Full Canvas) -->
  <div class="row flex-grow-1">
    <div class="col-12 d-flex flex-column">
      <div class="card border-0 shadow-sm h-100">
        <div class="card-header bg-white d-flex justify-content-between align-items-center">
          <h6 class="mb-0">
            <i class="fas fa-code me-2"></i>
            Content Preview
          </h6>
          <div class="btn-group btn-group-sm" role="group">
            <button type="button" class="btn btn-primary" id="visual-mode-btn" onclick="switchToVisualMode()">
              <i class="fas fa-eye me-1"></i>
              Visual
            </button>
            
            <button type="button" class="btn btn-outline-primary" id="html-mode-btn" onclick="switchToHtmlMode()">
              <i class="fas fa-code me-1"></i>
              HTML
            </button>
          </div>
        </div>
        <div class="card-body p-0 d-flex flex-column flex-grow-1">
          <% if landing_page.html_content.present? %>
            <div id="visual-preview" class="flex-grow-1">
              <iframe 
                src="/landing_pages/<%= landing_page.id %>/preview" 
                class="w-100 h-100 border-0"
                style="min-height: 700px;">
              </iframe>
            </div>
            <div id="html-preview" class="flex-grow-1 d-none p-2">
              <div class="d-flex justify-content-between align-items-center mb-2">
                <small class="text-muted">Edit HTML directly (changes are not automatically saved)</small>
                <button class="btn btn-sm btn-success" onclick="saveHtmlChanges(<%= landing_page.id %>)">
                  <i class="fas fa-save me-1"></i>
                  Save Changes
                </button>
              </div>
              <textarea 
                id="html-editor"
                class="form-control h-100 font-monospace small" 
                style="resize: none; border: 1px solid #dee2e6; min-height: 600px;"
                placeholder="HTML content will appear here..."><%= html_escape(landing_page.html_content) %></textarea>
            </div>
          <% else %>
            <div class="d-flex align-items-center justify-content-center flex-grow-1 text-center p-5">
              <div>
                <div class="spinner-border text-primary mb-3" role="status">
                  <span class="visually-hidden">Loading...</span>
                </div>
                <h5 class="text-muted">AI Generation in Progress</h5>
                <p class="text-muted mb-4">Your landing page content is being generated using advanced AI. This typically takes 30-60 seconds.</p>
                <div class="progress mb-3" style="height: 10px;">
                  <div class="progress-bar progress-bar-striped progress-bar-animated" role="progressbar" style="width: 45%"></div>
                </div>
                <button class="btn btn-outline-primary" onclick="window.scoutRefreshCanvas()">
                  <i class="fas fa-sync me-2"></i>
                  Check Progress
                </button>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
// Landing page action functions
function scoutPreviewLandingPageInTab(pageId) {
  window.open(`/landing_pages/${pageId}/preview`, '_blank');
}

function copyPublicUrl(button) {
  const urlInput = button.previousElementSibling.previousElementSibling;
  
  // Use modern clipboard API with fallback
  if (navigator.clipboard && window.isSecureContext) {
    navigator.clipboard.writeText(urlInput.value).then(() => {
      showCopySuccess(button);
    }).catch(() => {
      fallbackCopyText(urlInput, button);
    });
  } else {
    fallbackCopyText(urlInput, button);
  }
}

function fallbackCopyText(input, button) {
  input.select();
  input.setSelectionRange(0, 99999); // For mobile devices
  try {
    document.execCommand('copy');
    showCopySuccess(button);
  } catch (err) {
    console.error('Failed to copy text: ', err);
    button.innerHTML = '<i class="fas fa-exclamation-triangle"></i> Error';
    setTimeout(() => {
      button.innerHTML = '<i class="fas fa-copy"></i>';
    }, 2000);
  }
}

function showCopySuccess(button) {
  const originalHtml = button.innerHTML;
  button.innerHTML = '<i class="fas fa-check text-success"></i> Copied!';
  button.classList.add('btn-success');
  button.classList.remove('btn-outline-secondary');
  
  setTimeout(() => {
    button.innerHTML = '<i class="fas fa-copy"></i>';
    button.classList.remove('btn-success');
    button.classList.add('btn-outline-secondary');
  }, 2000);
}

function revertToVersion(landingPageId, versionId) {
  if (!confirm('Are you sure you want to revert to this version? This will create a backup of the current content.')) {
    return;
  }
  
  console.log(`🔄 Reverting landing page ${landingPageId} to version ${versionId}`);
  
  // Send message to Scout to revert the landing page
  const message = `Revert landing page ${landingPageId} to version ${versionId}`;
  
  if (window.scoutSendMessage) {
    window.scoutSendMessage(message);
  } else {
    console.error('Scout sendMessage function not available');
    alert('Unable to revert: Scout communication not available');
  }
}

// Auto-refresh disabled - using real-time WebSocket updates instead
<% unless landing_page.html_content.present? %>
console.log('🔄 Landing page content pending - will update via WebSocket when generation completes');
<% end %>

// Initialize the canvas
console.log('Landing page details canvas loaded');
console.log('Toggle functions available:', {
  switchToVisualMode: typeof window.switchToVisualMode,
  switchToHtmlMode: typeof window.switchToHtmlMode,
  saveHtmlChanges: typeof window.saveHtmlChanges,
  revertToVersion: typeof revertToVersion
});
</script>

<style>
.scout-canvas {
  padding: 1rem;
  height: 100%;
  overflow-y: auto;
}

.preview-container {
  max-height: 600px;
  overflow-y: auto;
}

.code-preview {
  background: #f8f9fa;
  border-radius: 0;
  font-family: 'Courier New', monospace;
  font-size: 0.875rem;
  line-height: 1.4;
  white-space: pre-wrap;
  word-wrap: break-word;
  max-height: 600px;
  overflow-y: auto;
}

.badge.fs-6 {
  font-size: 0.875rem !important;
}
</style> 