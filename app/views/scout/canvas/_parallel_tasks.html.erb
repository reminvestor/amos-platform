<div style="background-color: #0A0E1A; color: #FFFFFF; min-height: 100vh; padding: 2rem;">
  <!-- Page Header -->
  <div style="margin-bottom: 2rem;">
    <h1 style="color: #FFFFFF; font-size: 2rem; font-weight: 700; margin-bottom: 0.5rem; display: flex; align-items: center; gap: 1rem;">
      <i data-lucide="layers" class="icon-2x" style="color: #A78BFA;"></i>
      Task Monitor
    </h1>
    <p style="color: #94A3B8; margin-bottom: 0;">Monitor active background tasks and agent workflows</p>
  </div>

  <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem;">
    <div style="display: flex; align-items: center; gap: 0.75rem;">
      <span style="background: #7C3AED; color: white; padding: 0.25rem 0.625rem; border-radius: 9999px; font-size: 0.875rem; font-weight: 600;">
        <span id="task-count">0</span> Active
      </span>
    </div>
    <button onclick="refreshTasks()" title="Refresh" 
            style="background: transparent; color: #94A3B8; border: 1px solid #1E293B; padding: 0.5rem 1rem; border-radius: 0.375rem; cursor: pointer; display: inline-flex; align-items: center; gap: 0.5rem; font-size: 0.875rem; font-weight: 500;">
      <i data-lucide="refresh-cw" class="icon-md"></i>
      Refresh
    </button>
  </div>

  <div id="parallel-tasks-panel" class="parallel-tasks-panel" data-conversation-id="<%= raw (@session_id || @canvas_data&.dig('session_id')) %>" data-canvas-loaded="<%= Time.now.to_i %>" data-canvas-type="parallel_tasks">
    <div class="tasks-container" id="parallel-tasks-list">
      <!-- Tasks will be dynamically added here -->
      <div class="empty-state" id="empty-state">
        <i data-lucide="inbox" class="icon-3x empty-icon"></i>
        <p>No active tasks</p>
        <span>Tasks will appear here when agents start working</span>
      </div>
    </div>
  </div>
</div>

<style>
.parallel-tasks-panel {
  display: flex;
  flex-direction: column;
  background: #1A1F35;
  border: 1px solid #1E293B;
  border-radius: 12px;
  overflow: hidden;
  transition: all 0.3s ease;
  min-height: calc(100vh - 12rem);
}

.refresh-btn {
  background: transparent;
  border: 1px solid #1E293B;
  color: #94A3B8;
  padding: 0.5rem 1rem;
  border-radius: 6px;
  cursor: pointer;
  transition: all 0.2s ease;
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  font-size: 0.875rem;
  font-weight: 500;
}

/* Hover effect removed for simplicity */

/* Icon sizing is handled by icon classes */

.tasks-container {
  flex: 1;
  padding: 1.5rem;
  overflow-y: auto;
  background: transparent;
}

.tasks-container::-webkit-scrollbar {
  width: 8px;
}

.tasks-container::-webkit-scrollbar-track {
  background: #0F1522;
  border-radius: 4px;
}

.tasks-container::-webkit-scrollbar-thumb {
  background: #1E293B;
  border-radius: 4px;
}

.tasks-container::-webkit-scrollbar-thumb:hover {
  background: #7C3AED;
}

.empty-state {
  text-align: center;
  padding: 4rem 2rem;
  color: #94A3B8;
}

.empty-icon {
  display: block;
  margin: 0 auto 1rem;
  opacity: 0.3;
  color: #94A3B8;
}

.empty-state p {
  margin: 0;
  font-size: 1.125rem;
  font-weight: 500;
  color: #FFFFFF;
}

.empty-state span {
  display: block;
  margin-top: 0.5rem;
  font-size: 0.875rem;
  color: #94A3B8;
}

.task-item {
  background: #1A1F35;
  color: #FFFFFF;
  border: 1px solid #1E293B;
  border-radius: 8px;
  padding: 1.25rem;
  margin-bottom: 0.75rem;
  transition: all 0.3s ease;
  cursor: pointer;
  position: relative;
  overflow: hidden;
}

.task-item::before {
  content: '';
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 4px;
  background: #64748B;
  transition: background 0.3s ease;
}

.task-item.running::before,
.task-item.active::before,
.task-item.processing::before {
  background: #7C3AED;
}

.task-item.completed::before {
  background: #10b981;
}

.task-item.failed::before {
  background: #ef4444;
}

.task-item.waiting_for_input::before {
  background: #f59e0b;
}

/* Hover effect removed for simplicity */

.task-item.new {
  animation: slideIn 0.4s ease;
}

@keyframes slideIn {
  from {
    opacity: 0;
    transform: translateY(-10px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.task-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 0.75rem;
}

.task-info {
  flex: 1;
  margin-right: 1rem;
}

.task-type {
  font-size: 0.75rem;
  font-weight: 600;
  text-transform: uppercase;
  color: #94A3B8;
  letter-spacing: 0.05em;
  margin-bottom: 0.25rem;
}

.task-title {
  font-size: 0.875rem;
  color: #FFFFFF;
  font-weight: 500;
  line-height: 1.4;
}

.task-status {
  display: inline-flex;
  align-items: center;
  gap: 0.375rem;
  font-size: 0.75rem;
  font-weight: 600;
  padding: 0.25rem 0.75rem;
  border-radius: 9999px;
  white-space: nowrap;
  border: 1px solid transparent;
}

.status-icon {
  /* Icon sizing handled by icon classes */
}

.task-status.queued,
.task-status.pending {
  background: rgba(100, 116, 139, 0.1);
  border-color: #64748B;
  color: #94A3B8;
}

.task-status.running,
.task-status.active,
.task-status.processing {
  background: rgba(124, 58, 237, 0.1);
  border-color: #7C3AED;
  color: #A78BFA;
}

.task-status.running .status-icon,
.task-status.processing .status-icon {
  animation: spin 1s linear infinite;
}

@keyframes spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

.task-status.completed {
  background: rgba(16, 185, 129, 0.1);
  border-color: #10b981;
  color: #10b981;
}

.task-status.failed {
  background: rgba(239, 68, 68, 0.1);
  border-color: #ef4444;
  color: #ef4444;
}

.task-status.waiting_for_input {
  background: rgba(245, 158, 11, 0.1);
  border-color: #f59e0b;
  color: #f59e0b;
}

.task-status.canceling,
.task-status.canceled {
  background: rgba(100, 116, 139, 0.1);
  border-color: #64748B;
  color: #94A3B8;
}

.task-status.canceling .status-icon {
  animation: spin 1s linear infinite;
}

.progress-section {
  margin-bottom: 0.75rem;
}

.progress-info {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 0.375rem;
}

.progress-label {
  font-size: 0.75rem;
  color: #94A3B8;
}

.progress-value {
  font-size: 0.75rem;
  font-weight: 600;
  color: #FFFFFF;
}

.progress-bar-container {
  width: 100%;
  height: 6px;
  background: #0F1522;
  border-radius: 3px;
  overflow: hidden;
  position: relative;
}

.progress-bar {
  height: 100%;
  background: #7C3AED;
  border-radius: 3px;
  transition: width 0.4s ease;
  position: relative;
  overflow: hidden;
}

.task-item.running .progress-bar::after,
.task-item.processing .progress-bar::after {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  bottom: 0;
  right: 0;
  background: linear-gradient(
    90deg,
    transparent,
    rgba(255, 255, 255, 0.2),
    transparent
  );
  animation: shimmer 1.5s infinite;
}

@keyframes shimmer {
  0% { transform: translateX(-100%); }
  100% { transform: translateX(100%); }
}

.task-message {
  font-size: 0.8125rem;
  color: #94A3B8;
  line-height: 1.4;
  margin-top: 0.5rem;
}

.task-item.failed .task-message {
  color: #ef4444;
}

.task-details {
  margin-top: 1rem;
  padding-top: 1rem;
  border-top: 1px solid #1E293B;
  display: none;
  animation: fadeIn 0.3s ease;
}

.task-item.expanded .task-details {
  display: block;
}

@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

.detail-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 0.75rem;
  margin-bottom: 0.75rem;
}

.detail-item {
  display: flex;
  flex-direction: column;
  gap: 0.25rem;
}

.detail-label {
  font-size: 0.75rem;
  color: #94A3B8;
  font-weight: 500;
}

.detail-value {
  font-size: 0.8125rem;
  color: #FFFFFF;
}

.expand-indicator {
  margin-left: 0.5rem;
  transition: transform 0.3s ease;
  display: inline-block;
  opacity: 0.8;
  color: #94A3B8;
}

.task-item.expanded .expand-indicator {
  transform: rotate(180deg);
}

.task-actions {
  margin-top: 0.75rem;
  display: flex;
  gap: 0.5rem;
}

.task-action-btn {
  padding: 0.375rem 0.75rem;
  font-size: 0.75rem;
  font-weight: 500;
  border-radius: 6px;
  border: 1px solid #1E293B;
  background: #0F1522;
  color: #FFFFFF;
  cursor: pointer;
  transition: all 0.2s ease;
}

/* Hover effect removed for simplicity */

.cancel-btn {
  background: rgba(239, 68, 68, 0.1);
  border-color: #ef4444;
  color: #ef4444;
  display: inline-flex;
  align-items: center;
  gap: 0.375rem;
}

.cancel-btn:hover {
  background: rgba(239, 68, 68, 0.2);
}

/* Agent-specific styling */
.task-item[data-agent-type="landing_page_agent"] .task-type {
  color: #A78BFA;
}

.task-item[data-agent-type="landing_page_agent"]::before {
  background: #7C3AED;
}

.task-item[data-agent-type="email_campaign_agent"] .task-type {
  color: #3b82f6;
}

.task-item[data-agent-type="email_campaign_agent"]::before {
  background: #3b82f6;
}

.task-item[data-agent-type="contact_enrichment_agent"] .task-type {
  color: #10b981;
}

.task-item[data-agent-type="contact_enrichment_agent"]::before {
  background: #10b981;
}

/* Pulse animation for active tasks */
.task-item.running::before,
.task-item.processing::before {
  animation: pulse 2s ease-in-out infinite;
}

@keyframes pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.6; }
}

/* Refresh animation */
.refresh-btn.spinning i {
  animation: spin 0.5s ease;
}
</style>

<script>
// Initialize immediately since this is a canvas
console.log('🚀 Initializing improved parallel tasks canvas');

// Track active tasks count
let activeTasksCount = 0;

// Update task count in header
function updateTaskCount() {
  const tasks = document.querySelectorAll('.task-item');
  const activeTasks = document.querySelectorAll('.task-item.running, .task-item.processing, .task-item.waiting_for_input');
  const countElement = document.getElementById('task-count');
  if (countElement) {
    countElement.textContent = activeTasks.length;
    activeTasksCount = activeTasks.length;
  }
}

// Refresh tasks (placeholder for future functionality)
function refreshTasks() {
  const btn = event.currentTarget;
  btn.classList.add('spinning');
  setTimeout(() => {
    btn.classList.remove('spinning');
  }, 500);
  
  console.log('🔄 Refreshing tasks...');
  // Could trigger a refresh from the server here
}

// Get status icon based on status
function getStatusIcon(status) {
  const icons = {
    queued: 'clock',
    pending: 'clock',
    running: 'loader-2',
    active: 'loader-2',
    processing: 'loader-2',
    completed: 'check-circle',
    failed: 'x-circle',
    waiting_for_input: 'message-circle',
    canceling: 'loader-2',
    canceled: 'ban'
  };
  return icons[status] || 'circle';
}

// Format agent type for display
function formatAgentType(type) {
  if (!type) return 'Task';
  return type.replace(/_agent$/, '')
    .split('_')
    .map(word => word.charAt(0).toUpperCase() + word.slice(1))
    .join(' ');
}

// Add or update task
window.addOrUpdateTask = function addOrUpdateTask(taskData, isInitialLoad = false) {
  console.log('🔧 addOrUpdateTask called with:', taskData, 'Initial load:', isInitialLoad);
  const container = document.getElementById('parallel-tasks-list');
  if (!container) {
    console.error('❌ Container #parallel-tasks-list not found!');
    return;
  }
  
  // Remove empty state if it exists
  const emptyState = document.getElementById('empty-state');
  if (emptyState) {
    emptyState.remove();
  }
  
  let taskElement = container.querySelector(`[data-task-id="${taskData.task_id}"]`);
  const isNew = !taskElement;
  console.log(`Task ${taskData.task_id} is ${isNew ? 'new' : 'existing'}`);
  
  if (isNew) {
    taskElement = document.createElement('div');
    taskElement.className = 'task-item new';
    taskElement.setAttribute('data-task-id', taskData.task_id);
    if (taskData.task_type || taskData.agent_type) {
      taskElement.setAttribute('data-agent-type', taskData.task_type || taskData.agent_type);
    }
    
    // For initial load, append to preserve order. For real-time updates, prepend to show at top
    if (isInitialLoad) {
      container.appendChild(taskElement);
      console.log('✅ New task element appended to container (initial load)');
    } else {
      container.insertBefore(taskElement, container.firstChild);
      console.log('✅ New task element prepended to container (real-time update)');
    }
  }
  
  // Update status
  const status = (taskData.status || 'queued').toLowerCase();
  taskElement.className = `task-item ${isNew ? 'new' : ''} ${status}`;
  
  // Store or update description
  if (taskData.description) {
    taskElement.dataset.description = taskData.description;
  }
  const description = taskData.description || taskElement.dataset.description || 'Task ' + taskData.task_id;
  
  // Store task data on element
  taskElement.taskData = taskData;
  
  // Calculate elapsed time
  const startTime = taskData.started_at || taskElement.dataset.startedAt || new Date().toISOString();
  if (!taskElement.dataset.startedAt) {
    taskElement.dataset.startedAt = startTime;
  }
  
  // Format progress
  const progress = taskData.progress || 0;
  const showProgress = status === 'running' || status === 'processing' || status === 'active';
  
  // Create HTML
  taskElement.innerHTML = `
    <div class="task-header">
      <div class="task-info">
        <div class="task-type">${formatAgentType(taskData.task_type || taskData.agent_type)}</div>
        <div class="task-title" onclick="window.toggleTaskExpand('${taskData.task_id}')">
          ${description}
          <span class="expand-indicator">▼</span>
        </div>
      </div>
      <span class="task-status ${status}">
        <i data-lucide="${getStatusIcon(status)}" class="icon-sm status-icon"></i>
        ${status.replace(/_/g, ' ')}
      </span>
    </div>
    ${showProgress ? `
      <div class="progress-section">
        <div class="progress-info">
          <span class="progress-label">Progress</span>
          <span class="progress-value">${progress}%</span>
        </div>
        <div class="progress-bar-container">
          <div class="progress-bar" style="width: ${progress}%"></div>
        </div>
      </div>
    ` : ''}
    ${taskData.message ? `<div class="task-message">${taskData.message}</div>` : ''}
    <div class="task-details">
      <div class="detail-grid">
        <div class="detail-item">
          <span class="detail-label">Task ID</span>
          <span class="detail-value">${String(taskData.task_id).substring(0, 8)}...</span>
        </div>
        <div class="detail-item">
          <span class="detail-label">Started</span>
          <span class="detail-value">${new Date(startTime).toLocaleTimeString()}</span>
        </div>
        ${taskData.agent_name ? `
          <div class="detail-item">
            <span class="detail-label">Agent</span>
            <span class="detail-value">${taskData.agent_name}</span>
          </div>
        ` : ''}
        <div class="detail-item">
          <span class="detail-label">Duration</span>
          <span class="detail-value" data-start-time="${startTime}">${calculateDuration(startTime)}</span>
        </div>
      </div>
      ${taskData.error ? `
        <div class="task-message" style="color: #ef4444; margin-top: 0.75rem;">
          <strong>Error:</strong> ${taskData.error}
        </div>
      ` : ''}
      ${(status === 'running' || status === 'processing' || status === 'waiting_for_input' || status === 'queued' || status === 'pending') ? `
        <div class="task-actions">
          <button class="task-action-btn cancel-btn" onclick="cancelTask('${taskData.task_id}')">
            <i data-lucide="x-circle" class="icon-sm"></i>
            Cancel Task
          </button>
        </div>
      ` : ''}
    </div>
  `;
  
  // Reinitialize lucide icons
  if (typeof lucide !== 'undefined') {
    lucide.createIcons();
  }
  
  // Update task count
  updateTaskCount();
  
  // Remove 'new' class after animation
  if (isNew) {
    setTimeout(() => {
      taskElement.classList.remove('new');
    }, 400);
  }
  
  // Auto-expand failed tasks
  if (status === 'failed' && !taskElement.classList.contains('expanded')) {
    taskElement.classList.add('expanded');
  }
};

// Calculate duration from start time
function calculateDuration(startTime) {
  const start = new Date(startTime);
  const now = new Date();
  const diff = Math.floor((now - start) / 1000);
  
  if (diff < 60) return `${diff}s`;
  if (diff < 3600) return `${Math.floor(diff / 60)}m ${diff % 60}s`;
  return `${Math.floor(diff / 3600)}h ${Math.floor((diff % 3600) / 60)}m`;
}

// Toggle task expand/collapse
window.toggleTaskExpand = function(taskId) {
  const taskElement = document.querySelector(`[data-task-id="${taskId}"]`);
  if (taskElement) {
    taskElement.classList.toggle('expanded');
  }
};

// Handle canvas updates
window.handleCanvasUpdate = function(data) {
  console.log("📨 CANVAS: Processing update:", data);
  
  // Handle different message types
  switch(data.type) {
    case 'task_progress':
      console.log(`📊 CANVAS: Task ${data.task_id} progress: ${data.progress}% - ${data.message}`);
      console.log('📊 CANVAS: Full task data:', data);
      addOrUpdateTask({
        task_id: data.task_id,
        task_type: data.task_type || data.agent_type,
        agent_type: data.agent_type || data.task_type,
        description: data.description || 'Processing task...',
        status: data.status || 'running',
        progress: data.progress || 0,
        message: data.message || 'Working...',
        started_at: data.started_at || new Date().toISOString()
      });
      break;
      
    case 'task_completed':
      console.log(`✅ CANVAS: Task ${data.task_id} completed`);
      addOrUpdateTask({
        task_id: data.task_id,
        description: data.description,
        status: 'completed',
        progress: 100,
        message: data.message || 'Task completed successfully'
      });
      break;
      
    case 'task_failed':
      console.log(`❌ CANVAS: Task ${data.task_id} failed: ${data.error}`);
      addOrUpdateTask({
        task_id: data.task_id,
        description: data.description,
        status: 'failed',
        progress: data.progress || 0,
        message: data.error || 'Task failed',
        error: data.error
      });
      break;
      
    default:
      console.log("Unknown message type:", data.type);
  }
};

// Update durations every second
setInterval(() => {
  document.querySelectorAll('[data-start-time]').forEach(el => {
    const startTime = el.getAttribute('data-start-time');
    if (startTime) {
      el.textContent = calculateDuration(startTime);
    }
  });
}, 1000);

// Cancel task function
window.cancelTask = function(taskId) {
  if (!confirm('Are you sure you want to cancel this task?')) {
    return;
  }
  
  console.log(`🚫 Canceling task: ${taskId}`);
  
  // Extract the actual job ID (remove 'amos-' prefix if present)
  const jobId = taskId.startsWith('amos-') ? taskId.substring(5) : taskId;
  
  // Update UI immediately to show canceling status
  const taskElement = document.querySelector(`[data-task-id="${taskId}"]`);
  if (taskElement) {
    taskElement.className = 'task-item canceling';
    const statusElement = taskElement.querySelector('.task-status');
    if (statusElement) {
      statusElement.className = 'task-status canceling';
      statusElement.innerHTML = '<i data-lucide="loader-2" class="icon-sm status-icon"></i> Canceling...';
      lucide.createIcons();
    }
  }
  
  // Send cancel request to server
  fetch('/scout/cancel_job', {
    method: 'POST',
    headers: {
      'Content-Type': 'application/json',
      'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]')?.content || ''
    },
    body: JSON.stringify({ job_id: jobId })
  })
  .then(response => response.json())
  .then(data => {
    if (data.success) {
      console.log(`✅ Task ${taskId} canceled successfully`);
      // Update task status to canceled
      addOrUpdateTask({
        task_id: taskId,
        status: 'canceled',
        message: 'Task was canceled',
        progress: 0
      });
    } else {
      console.error(`❌ Failed to cancel task: ${data.error}`);
      alert(`Failed to cancel task: ${data.error || 'Unknown error'}`);
      // Restore previous status if cancellation failed
      if (taskElement && taskElement.taskData) {
        addOrUpdateTask(taskElement.taskData);
      }
    }
  })
  .catch(error => {
    console.error('❌ Error canceling task:', error);
    alert('Failed to cancel task. Please try again.');
    // Restore previous status
    if (taskElement && taskElement.taskData) {
      addOrUpdateTask(taskElement.taskData);
    }
  });
};

// Make functions globally available
window.toggleTaskExpand = toggleTaskExpand;
window.refreshTasks = refreshTasks;
window.addOrUpdateTask = addOrUpdateTask;
window.handleCanvasUpdate = handleCanvasUpdate;
window.cancelTask = cancelTask;

// Keep track of all subscriptions for different sessions
window.parallelTaskSubscriptions = window.parallelTaskSubscriptions || new Map();

// Subscribe to current session for updates
const currentSessionId = '<%= raw (@session_id || @canvas_data&.dig('session_id')) %>';
if (currentSessionId) {
  console.log('🔌 Session ID for subscription:', currentSessionId);
  
  // The parent Scout controller should already have the subscription
  // We just need to ensure our handler is called
  if (window.handleParallelTaskUpdate) {
    console.log('✅ Found parent handleParallelTaskUpdate function');
  }
}

// Initialize canvas
function initializeParallelTasksCanvas() {
  console.log('🎯 Improved Parallel Tasks Canvas initialized');
  console.log('📊 Canvas data:', <%= raw @canvas_data.to_json %>);

  // Initialize tasks from canvas data if available
  <% if @canvas_data && @canvas_data['tasks'] %>
    console.log('📦 Initializing tasks from canvas data - found', <%= raw @canvas_data['tasks'].length.to_json %>, 'tasks');
    
    <% @canvas_data['tasks'].each do |task| %>
      console.log('➕ Adding task', <%= raw task.to_json %>);
      addOrUpdateTask({
        task_id: <%= raw (task['id'] || task['job_id']).to_json %>,
        task_type: <%= raw (task['type'] || task['agent_type']).to_json %>,
        agent_type: <%= raw (task['agent_type'] || task['type']).to_json %>,
        description: <%= raw (task['description'] || task['task']).to_json %>,
        status: <%= raw task['status'].to_json %>,
        progress: <%= raw (task['progress'] || 0).to_json %>,
        message: <%= raw task['status_message'].to_json %>,
        started_at: <%= raw task['created_at'].to_json %>
      }, true);  // Pass true for initial load
    <% end %>
  <% else %>
    console.log('📦 No initial tasks to display');
  <% end %>
  
  // Also load Amos jobs from server data
  <% if @amos_jobs.present? %>
    console.log('📦 Loading <%= @amos_jobs.count %> Amos jobs...');
    // Iterate through jobs in order (already sorted desc by created_at)
    <% @amos_jobs.each do |job| %>
      addOrUpdateTask({
        task_id: 'amos-<%= job.job_id %>',
        task_type: '<%= job.agent_type %>',
        agent_type: '<%= job.agent_type %>',
        description: <%= raw (job.input_data&.dig('task') || job.agent_type.humanize).to_json %>,
        status: '<%= job.status %>',
        progress: <%= job.progress || 0 %>,
        message: <%= raw (job.status_message || '').to_json %>,
        started_at: '<%= job.created_at.iso8601 %>'
      }, true);  // Pass true for initial load
    <% end %>
  <% end %>
  
  // Initialize lucide icons
  if (typeof lucide !== 'undefined') {
    lucide.createIcons();
  }
  
  // Update initial count
  updateTaskCount();
}

// Initialize immediately
initializeParallelTasksCanvas();

// Debug function
window.debugParallelTasks = function() {
  const panel = document.getElementById('parallel-tasks-panel');
  const container = document.getElementById('parallel-tasks-list');
  const tasks = container ? container.querySelectorAll('.task-item') : [];
  console.log('Panel exists:', !!panel);
  console.log('Container exists:', !!container);
  console.log('Tasks count:', tasks.length);
  console.log('Active tasks:', activeTasksCount);
  return { panel, container, tasks };
};
