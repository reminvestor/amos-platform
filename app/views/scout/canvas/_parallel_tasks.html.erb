<div class="container-fluid p-0" style="min-height: 100vh;">
  <!-- Header -->
  <div class="d-flex justify-content-between align-items-center mb-3 p-3 bg-dark border-bottom border-secondary rounded-top">
    <div class="d-flex align-items-center gap-2">
      <i data-lucide="layers" class="text-primary icon-md"></i>
      <div>
        <h5 class="mb-0 text-white fw-bold">Task Monitor</h5>
        <small class="text-muted">Active background tasks</small>
      </div>
    </div>
    <div class="d-flex align-items-center gap-2">
      <span class="badge bg-primary rounded-pill">
        <span id="task-count">0</span> Active
      </span>
      <button onclick="purgeOldTasks()" title="Clear completed and failed tasks" class="btn btn-outline-secondary btn-sm icon-btn">
        <i data-lucide="trash-2" class="icon-sm"></i>
      </button>
      <button onclick="refreshTasks()" title="Refresh" class="btn btn-outline-secondary btn-sm icon-btn">
        <i data-lucide="refresh-cw" class="icon-sm"></i>
      </button>
    </div>
  </div>

  <div id="parallel-tasks-panel" class="parallel-tasks-panel" data-conversation-id="<%= raw (@session_id || @canvas_data&.dig('session_id')) %>" data-canvas-loaded="<%= Time.now.to_i %>" data-canvas-type="parallel_tasks">
    <div class="list-group list-group-flush" id="parallel-tasks-list">
      <!-- Tasks will be dynamically added here -->
      <div class="empty-state text-center p-5" id="empty-state">
        <i data-lucide="inbox" class="icon-3x text-muted mb-3"></i>
        <p class="text-muted mb-1">No active tasks</p>
        <small class="text-secondary">Tasks will appear here when agents start working</small>
      </div>
    </div>
  </div>

  <!-- Custom Modal -->
  <div class="modal fade" id="task-modal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content bg-dark text-white border-secondary">
        <div class="modal-header border-secondary">
          <h5 class="modal-title" id="modal-title">Confirm</h5>
          <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
        <div class="modal-body">
        <p id="modal-message">Are you sure?</p>
      </div>
        <div class="modal-footer border-secondary" id="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
          <button type="button" class="btn btn-primary" id="modal-confirm-btn">Confirm</button>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  /* Force isolation from global styles */
  #parallel-tasks-list {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  /* Explicit card styling */
  .task-card {
    display: flex !important;
    flex-direction: column !important;
    background-color: #1A1F35 !important;
    border: 1px solid #2D3748 !important;
    border-radius: 0.5rem !important;
    padding: 1rem !important;
    width: 100% !important;
    box-sizing: border-box !important;
    position: relative !important;
    overflow: hidden !important;
  }
  
  .task-card:hover {
    background-color: #232942 !important;
    border-color: #4A5568 !important;
  }

  /* Header Row */
  .task-header-row {
    display: flex !important;
    flex-direction: row !important;
    justify-content: space-between !important;
    align-items: center !important;
    margin-bottom: 0.75rem !important;
    width: 100% !important;
  }

  .task-header-left {
    display: flex !important;
    align-items: center !important;
    gap: 0.75rem !important;
    flex: 1 !important;
    min-width: 0 !important; /* Allow text truncation */
  }

  /* Status Dot */
  .status-dot {
    width: 8px !important;
    height: 8px !important;
    border-radius: 50% !important;
    flex-shrink: 0 !important;
  }

  /* Status Colors */
  .dot-running { background-color: #3B82F6 !important; box-shadow: 0 0 8px rgba(59, 130, 246, 0.5); animation: pulse 2s infinite; }
  .dot-completed { background-color: #10B981 !important; }
  .dot-failed { background-color: #EF4444 !important; }
  .dot-queued { background-color: #F59E0B !important; }
  .dot-waiting_for_input { background-color: #8B5CF6 !important; animation: pulse 1s infinite; }
  .dot-canceled { background-color: #6B7280 !important; }

  @keyframes pulse {
    0% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.7; transform: scale(1.2); }
    100% { opacity: 1; transform: scale(1); }
  }

  /* Typography */
  .task-id {
    color: #fff !important;
    font-weight: 700 !important;
    font-size: 0.9rem !important;
    margin: 0 !important;
  }

  .agent-badge {
    background-color: rgba(0, 0, 0, 0.3) !important;
    border: 1px solid #4A5568 !important;
    color: #A0AEC0 !important;
    padding: 2px 8px !important;
    border-radius: 4px !important;
    font-size: 0.75rem !important;
    white-space: nowrap !important;
  }

  .status-badge {
    font-size: 0.75rem !important;
    padding: 2px 8px !important;
    border-radius: 99px !important;
    font-weight: 600 !important;
    text-transform: uppercase !important;
    letter-spacing: 0.5px !important;
  }

  .badge-running { background-color: rgba(59, 130, 246, 0.1) !important; color: #60A5FA !important; border: 1px solid rgba(59, 130, 246, 0.2) !important; }
  .badge-completed { background-color: rgba(16, 185, 129, 0.1) !important; color: #34D399 !important; border: 1px solid rgba(16, 185, 129, 0.2) !important; }
  .badge-failed { background-color: rgba(239, 68, 68, 0.1) !important; color: #F87171 !important; border: 1px solid rgba(239, 68, 68, 0.2) !important; }
  .badge-queued { background-color: rgba(245, 158, 11, 0.1) !important; color: #FBBF24 !important; border: 1px solid rgba(245, 158, 11, 0.2) !important; }
  .badge-waiting { background-color: rgba(139, 92, 246, 0.1) !important; color: #A78BFA !important; border: 1px solid rgba(139, 92, 246, 0.2) !important; }
  .badge-canceled { background-color: rgba(107, 114, 128, 0.1) !important; color: #9CA3AF !important; border: 1px solid rgba(107, 114, 128, 0.2) !important; }

  /* Description */
  .task-desc {
    color: #CBD5E0 !important;
    font-size: 0.9rem !important;
    line-height: 1.5 !important;
    margin-bottom: 1rem !important;
    word-break: break-word !important;
  }

  /* Progress Bar */
  .progress-container {
    width: 100% !important;
    margin-bottom: 0.5rem !important;
  }
  
  .progress-labels {
    display: flex !important;
    justify-content: space-between !important;
    margin-bottom: 0.25rem !important;
    color: #718096 !important;
    font-size: 0.75rem !important;
  }

  .progress-track {
    width: 100% !important;
    height: 6px !important;
    background-color: #2D3748 !important;
    border-radius: 99px !important;
    overflow: hidden !important;
  }

  .progress-fill {
    height: 100% !important;
    transition: width 0.5s ease !important;
  }

  .fill-running { background-color: #3B82F6 !important; }
  .fill-completed { background-color: #10B981 !important; }
  .fill-failed { background-color: #EF4444 !important; }
  .fill-queued { background-color: #F59E0B !important; }
  .fill-waiting { background-color: #8B5CF6 !important; }
  .fill-canceled { background-color: #6B7280 !important; }

  /* Footer */
  .task-footer {
    display: flex !important;
    justify-content: space-between !important;
    align-items: center !important;
    border-top: 1px solid #2D3748 !important;
    padding-top: 0.75rem !important;
    margin-top: 0.5rem !important;
  }

  .task-time {
    color: #718096 !important;
    font-size: 0.8rem !important;
    display: flex !important;
    align-items: center !important;
    gap: 0.25rem !important;
  }

  .task-actions button {
    background: none !important;
    border: none !important;
    color: #FC8181 !important; /* Red-300 */
    font-size: 0.8rem !important;
    padding: 0 !important;
    cursor: pointer !important;
    display: flex !important;
    align-items: center !important;
    gap: 0.25rem !important;
  }
  .task-actions button:hover {
    color: #F56565 !important; /* Red-400 */
    text-decoration: underline !important;
  }
</style>

<script>
// Initialize immediately since this is a canvas
console.log('🚀 Initializing improved parallel tasks canvas (Refactored v3)');

// ... (keep helpers) ...
// Track active tasks count
let activeTasksCount = 0;

// Update task count in header
function updateTaskCount() {
  const activeTasks = document.querySelectorAll('.task-card[data-status="running"], .task-card[data-status="processing"], .task-card[data-status="waiting_for_input"]');
  const countElement = document.getElementById('task-count');
  if (countElement) {
    countElement.textContent = activeTasks.length;
    activeTasksCount = activeTasks.length;
  }
}

function refreshTasks(event) {
  if (event) {
    const btn = event.currentTarget;
    const icon = btn.querySelector('i');
    if (icon) icon.classList.add('spin');
    setTimeout(() => { if (icon) icon.classList.remove('spin'); }, 500);
  }
  console.log('🔄 Refreshing tasks...');
}

function formatAgentType(type) {
  if (!type) return 'System';
  return type.replace(/_agent$/, '').split('_').map(w => w.charAt(0).toUpperCase() + w.slice(1)).join(' ');
}

function calculateDuration(startTime) {
  if (!startTime) return '--';
  const start = new Date(startTime);
  const now = new Date();
  const diff = Math.floor((now - start) / 1000);
  if (diff < 60) return `${diff}s`;
  if (diff < 3600) return `${Math.floor(diff / 60)}m ${diff % 60}s`;
  return `${Math.floor(diff / 3600)}h ${Math.floor((diff % 3600) / 60)}m`;
}

// Add or update task
window.addOrUpdateTask = function addOrUpdateTask(taskData, isInitialLoad = false) {
  console.log('🔧 addOrUpdateTask v3:', taskData);
  const container = document.getElementById('parallel-tasks-list');
  if (!container) return;
  
  const emptyState = document.getElementById('empty-state');
  if (emptyState) emptyState.remove();
  
  const taskId = String(taskData.task_id || taskData.id);
  let taskElement = container.querySelector(`[data-task-id="${taskId}"]`);
  const isNew = !taskElement;
  
  const status = (taskData.status || 'queued').toLowerCase();
  const agentType = formatAgentType(taskData.task_type || taskData.agent_type || taskData.type);
  const description = taskData.message || taskData.description || taskData.task || 'Processing...';
  const progress = taskData.progress || 0;
  const startTime = taskData.started_at || (taskElement ? taskElement.dataset.startedAt : new Date().toISOString());
  const error = taskData.error || (status === 'failed' ? (taskData.message || 'Unknown error') : null);
  
  const statusLabel = {
    queued: 'Queued', pending: 'Pending', running: 'Running', processing: 'Processing',
    completed: 'Completed', failed: 'Failed', waiting_for_input: 'Waiting Input',
    canceling: 'Canceling', canceled: 'Canceled'
  }[status] || status;

  const styleSuffix = {
    queued: 'queued', pending: 'queued', running: 'running', processing: 'running',
    completed: 'completed', failed: 'failed', waiting_for_input: 'waiting',
    canceling: 'canceled', canceled: 'canceled'
  }[status] || 'queued';

  // Completely new DOM structure using specific classes
  const htmlContent = `
    <div class="task-header-row">
      <div class="task-header-left">
        <div class="status-dot dot-${styleSuffix}"></div>
        <h6 class="task-id">#${taskId.substring(0, 8)}</h6>
        <span class="agent-badge">${agentType}</span>
      </div>
      <span class="status-badge badge-${styleSuffix}">${statusLabel}</span>
    </div>

    <div class="task-desc">
      ${description}
      ${error ? `<div style="color: #FC8181; margin-top: 0.5rem; font-size: 0.85rem;"><i data-lucide="alert-triangle" style="width:14px; display:inline; vertical-align:middle"></i> ${error}</div>` : ''}
    </div>

    <div class="progress-container">
      <div class="progress-labels">
        <span>Progress</span>
        <span>${progress}%</span>
      </div>
      <div class="progress-track">
        <div class="progress-fill fill-${styleSuffix}" style="width: ${progress}%"></div>
      </div>
    </div>

    <div class="task-footer">
      <div class="task-time">
        <i data-lucide="clock" style="width:12px;"></i>
        <span class="duration-timer" data-start-time="${startTime}">${calculateDuration(startTime)}</span>
      </div>
      <div class="task-actions">
        ${['running', 'processing', 'waiting_for_input', 'queued'].includes(status) ? `
          <button onclick="cancelTask('${taskId}')">
            <i data-lucide="x-circle" style="width:14px;"></i> Cancel
          </button>
        ` : ''}
      </div>
    </div>
  `;
  
  if (isNew) {
    taskElement = document.createElement('div');
    // Remove bootstrap classes to avoid interference
    taskElement.className = 'task-card'; 
    taskElement.setAttribute('data-task-id', taskId);
    taskElement.setAttribute('data-status', status);
    taskElement.dataset.startedAt = startTime;
    
    // Add transition animation manually
    taskElement.style.opacity = '0';
    taskElement.style.transform = 'translateY(-10px)';
    taskElement.style.transition = 'opacity 0.3s, transform 0.3s';
    
    if (isInitialLoad) {
      container.appendChild(taskElement);
    } else {
      container.insertBefore(taskElement, container.firstChild);
    }
    
    // Trigger animation
    requestAnimationFrame(() => {
      taskElement.style.opacity = '1';
      taskElement.style.transform = 'translateY(0)';
    });
  } else {
    taskElement.setAttribute('data-status', status);
    if (!taskElement.dataset.startedAt) taskElement.dataset.startedAt = startTime;
  }
  
  taskElement.innerHTML = htmlContent;
  
  // Store data
  taskElement.taskData = taskData;

  if (typeof lucide !== 'undefined') lucide.createIcons();
  updateTaskCount();
};

// ... existing duration interval ...
setInterval(() => {
  document.querySelectorAll('.duration-timer').forEach(el => {
    const startTime = el.dataset.startTime;
    const taskItem = el.closest('.task-card');
    const status = taskItem?.getAttribute('data-status');
    if (['running', 'processing', 'waiting_for_input', 'queued'].includes(status)) {
       el.textContent = calculateDuration(startTime);
    }
  });
}, 1000);

// ... existing message handlers ...
window.handleCanvasUpdate = function(data) {
  // ... same implementation ...
  const taskId = data.task_id || data.job_id || data.id;
  if (!taskId) return;

  let updateData = {
    task_id: taskId,
    status: data.status,
    message: data.message || data.status_message,
    progress: data.progress
  };

  switch(data.type) {
    case 'task_progress': break;
    case 'task_completed':
      updateData.status = 'completed';
      updateData.progress = 100;
      updateData.completed_at = data.completed_at || new Date().toISOString();
      break;
    case 'task_failed':
      updateData.status = 'failed';
      updateData.error = data.error;
      updateData.completed_at = data.completed_at || new Date().toISOString();
      break;
    case 'user_input_required':
        updateData.status = 'waiting_for_input';
        updateData.message = data.question || "Waiting for user input...";
        break;
  }
  addOrUpdateTask(updateData);
};

// ... init ...
function initializeParallelTasksCanvas() {
  const tasks = <%= raw (@canvas_data && @canvas_data['tasks'] ? @canvas_data['tasks'].to_json : '[]') %>;
  if (tasks.length > 0) {
    tasks.forEach(task => {
      addOrUpdateTask({
        task_id: task.id,
        task_type: task.type,
        agent_type: task.type,
        description: task.description,
        status: task.status,
        progress: task.progress,
        message: task.message || task.description,
        started_at: task.created_at,
        completed_at: task.metadata?.completed_at,
        error: task.metadata?.error
      }, true);
    });
  }
  if (typeof lucide !== 'undefined') lucide.createIcons();
  updateTaskCount();
}

initializeParallelTasksCanvas();

// ... modals ...
window.showTaskModal = function(title, message, confirmText, confirmCallback) {
  // ... (keep same) ...
  const modalEl = document.getElementById('task-modal');
  const modalTitle = document.getElementById('modal-title');
  const modalBody = document.getElementById('modal-message');
  const confirmBtn = document.getElementById('modal-confirm-btn');

  modalTitle.textContent = title;
  modalBody.innerHTML = message;
  confirmBtn.textContent = confirmText || 'Confirm';
  confirmBtn.onclick = () => {
    if (confirmCallback) confirmCallback();
    const modalInstance = bootstrap.Modal.getInstance(modalEl);
    modalInstance.hide();
  };
  
  const modal = new bootstrap.Modal(modalEl);
  modal.show();
};

window.cancelTask = function(taskId) {
  showTaskModal(
    'Cancel Task',
    'Are you sure you want to cancel this task? This cannot be undone.',
    'Yes, Cancel',
    () => {
      const cleanId = String(taskId).replace('amos-', '').replace('plugin-', '');
      fetch('/scout/cancel_job', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]')?.content
        },
        body: JSON.stringify({ job_id: cleanId })
      })
      .then(r => r.json())
      .then(data => {
        if(data.success) {
          addOrUpdateTask({ task_id: taskId, status: 'canceled', message: 'Task canceled by user' });
        }
      });
    }
  );
};

window.purgeOldTasks = function() {
  showTaskModal(
    'Purge History',
    'Clear completed and failed tasks older than 24 hours?',
    'Clear History',
    () => {
      fetch('/admin/agent_plugins/purge_executions', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]')?.content },
        body: JSON.stringify({ older_than: 24 })
      }).then(() => location.reload());
    }
  );
};
</script>
    taskElement = document.createElement('div');
    taskElement.className = `list-group-item task-item p-3 mb-2 rounded border-0`;
    taskElement.setAttribute('data-task-id', taskId);
    taskElement.setAttribute('data-status', status);
    taskElement.dataset.startedAt = startTime;
    
    if (isInitialLoad) {
      container.appendChild(taskElement);
    } else {
      taskElement.classList.add('new');
      container.insertBefore(taskElement, container.firstChild);
      setTimeout(() => taskElement.classList.remove('new'), 500);
    }
  } else {
    taskElement.setAttribute('data-status', status);
    if (!taskElement.dataset.startedAt) taskElement.dataset.startedAt = startTime;
  }
  
  taskElement.innerHTML = htmlContent;
  
  // Store data
  taskElement.taskData = taskData;

  // Re-init icons
  if (typeof lucide !== 'undefined') lucide.createIcons();
  
  updateTaskCount();
};

// Update durations periodically
setInterval(() => {
  document.querySelectorAll('.duration-timer').forEach(el => {
    const startTime = el.dataset.startTime;
    // Only update if task is active
    const taskItem = el.closest('.task-item');
    const status = taskItem?.getAttribute('data-status');
    if (['running', 'processing', 'waiting_for_input', 'queued'].includes(status)) {
       el.textContent = calculateDuration(startTime);
    }
  });
}, 1000);

// Handle canvas updates (from ActionCable)
window.handleCanvasUpdate = function(data) {
  console.log("📨 CANVAS: Processing update:", data);
  
  // Extract ID
  const taskId = data.task_id || data.job_id || data.id;
  if (!taskId) return;

  // Map event types to data structure
  let updateData = {
    task_id: taskId,
    status: data.status,
    message: data.message || data.status_message,
    progress: data.progress
  };

  switch(data.type) {
    case 'task_progress':
      // Basic update
      break;
    case 'task_completed':
      updateData.status = 'completed';
      updateData.progress = 100;
      updateData.completed_at = data.completed_at || new Date().toISOString();
      break;
    case 'task_failed':
      updateData.status = 'failed';
      updateData.error = data.error;
      updateData.completed_at = data.completed_at || new Date().toISOString();
      break;
    case 'user_input_required':
        updateData.status = 'waiting_for_input';
        updateData.message = data.question || "Waiting for user input...";
        break;
  }
  
  addOrUpdateTask(updateData);
};

// Initialize with server data
function initializeParallelTasksCanvas() {
  const tasks = <%= raw (@canvas_data && @canvas_data['tasks'] ? @canvas_data['tasks'].to_json : '[]') %>;
  console.log('📦 Initializing tasks:', tasks.length);
  
  if (tasks.length > 0) {
    tasks.forEach(task => {
      // Adapter for server-side format to client format
      addOrUpdateTask({
        task_id: task.id,
        task_type: task.type,
        agent_type: task.type,
        description: task.description,
        status: task.status,
        progress: task.progress,
        message: task.message || task.description,
        started_at: task.created_at,
        completed_at: task.metadata?.completed_at,
        error: task.metadata?.error
      }, true);
    });
  }
  
  if (typeof lucide !== 'undefined') lucide.createIcons();
  updateTaskCount();
}

// Start
initializeParallelTasksCanvas();

// Modal helpers (Bootstrap 5)
window.showTaskModal = function(title, message, confirmText, confirmCallback) {
  const modalEl = document.getElementById('task-modal');
  const modalTitle = document.getElementById('modal-title');
  const modalBody = document.getElementById('modal-message');
  const confirmBtn = document.getElementById('modal-confirm-btn');

  modalTitle.textContent = title;
  modalBody.innerHTML = message;
  confirmBtn.textContent = confirmText || 'Confirm';
  confirmBtn.onclick = () => {
    if (confirmCallback) confirmCallback();
    const modalInstance = bootstrap.Modal.getInstance(modalEl);
    modalInstance.hide();
  };
  
  const modal = new bootstrap.Modal(modalEl);
  modal.show();
};

window.cancelTask = function(taskId) {
  showTaskModal(
    'Cancel Task',
    'Are you sure you want to cancel this task? This cannot be undone.',
    'Yes, Cancel',
    () => {
      console.log('Canceling task', taskId);
      // Extract ID (handle amos- prefix)
      const cleanId = String(taskId).replace('amos-', '').replace('plugin-', '');
      
  fetch('/scout/cancel_job', {
    method: 'POST',
    headers: {
      'Content-Type': 'application/json',
          'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]')?.content
    },
        body: JSON.stringify({ job_id: cleanId })
  })
      .then(r => r.json())
  .then(data => {
        if(data.success) {
          addOrUpdateTask({ task_id: taskId, status: 'canceled', message: 'Task canceled by user' });
        } else {
          alert('Failed to cancel: ' + data.error);
        }
      });
    }
  );
};

window.purgeOldTasks = function() {
  showTaskModal(
    'Purge History',
    'Clear completed and failed tasks older than 24 hours?',
    'Clear History',
    () => {
      fetch('/admin/agent_plugins/purge_executions', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]')?.content },
        body: JSON.stringify({ older_than: 24 })
      }).then(() => location.reload());
    }
  );
};
</script>
