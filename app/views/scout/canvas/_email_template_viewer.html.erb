<%= turbo_stream_from "entity_#{current_entity.id}_email_templates" %>

<div class="email-template-viewer scout-canvas canvas-container">
  <!-- Page Header -->
  <div class="canvas-page-header">
    <div>
      <h1 class="canvas-page-title">
        <i data-lucide="mail" class="canvas-title-icon"></i>
        Email Templates
      </h1>
      <p class="canvas-page-subtitle">Manage your email templates</p>
    </div>
    <div class="canvas-header-actions">
      <button onclick="window.scoutSendMessage?.('Create a new email template')" aria-label="Create a new email template" class="canvas-btn primary">
        <i data-lucide="plus" class="canvas-icon-sm"></i>
        Create Template
      </button>
    </div>
  </div>

  <!-- Stats Summary -->
  <% if stats[:total_templates] > 0 %>
    <div class="canvas-stats-grid">
      <!-- Total Templates -->
      <div class="canvas-stat-card purple">
        <div>
          <p class="canvas-stat-label">Total Templates</p>
          <p class="canvas-stat-value"><%= stats[:total_templates] %></p>
        </div>
        <div class="canvas-stat-icon purple">
          <i data-lucide="mail"></i>
        </div>
      </div>

      <!-- Active Templates -->
      <div class="canvas-stat-card green">
        <div>
          <p class="canvas-stat-label">Active Templates</p>
          <p class="canvas-stat-value"><%= stats[:active_templates] %></p>
        </div>
        <div class="canvas-stat-icon green">
          <i data-lucide="check-circle"></i>
        </div>
      </div>

      <!-- Used in Campaigns -->
      <div class="canvas-stat-card cyan">
        <div>
          <p class="canvas-stat-label">Used in Campaigns</p>
          <p class="canvas-stat-value"><%= stats[:used_templates] %></p>
        </div>
        <div class="canvas-stat-icon cyan">
          <i data-lucide="trending-up"></i>
        </div>
      </div>

      <!-- Unused Templates -->
      <div class="canvas-stat-card yellow">
        <div>
          <p class="canvas-stat-label">Unused Templates</p>
          <p class="canvas-stat-value"><%= stats[:unused_templates] %></p>
        </div>
        <div class="canvas-stat-icon yellow">
          <i data-lucide="alert-circle"></i>
        </div>
      </div>
    </div>
  <% end %>

  <!-- Templates Table -->
  <div class="canvas-card">
    <% if templates.any? %>
      <div class="canvas-table-wrapper">
        <table class="canvas-table">
          <thead>
            <tr>
              <th>Template Name</th>
              <th>Subject</th>
              <th>Created</th>
              <th>Used In</th>
              <th class="text-end">Actions</th>
            </tr>
          </thead>
          <tbody id="email-templates-tbody">
            <% templates.each do |template| %>
              <tr id="email_template_<%= template.id %>" class="<%= 'newly-created' if template.created_at > 10.seconds.ago %>">
                <td class="fw-semibold">
                  <%= template.name.presence || "Untitled Template" %>
                </td>
                <td class="text-truncate" style="max-width: 300px;">
                  <%= template.subject.presence || "(No subject)" %>
                </td>
                <td>
                  <%= template.created_at.strftime('%b %d, %Y') %>
                </td>
                <td>
                  <% campaign_count = template.campaigns.count %>
                  <% if campaign_count > 0 %>
                    <span class="canvas-badge success">
                      <%= pluralize(campaign_count, 'campaign') %>
                    </span>
                  <% else %>
                    <span class="canvas-badge muted">
                      Not used
                    </span>
                  <% end %>
                </td>
                <td class="text-end">
                  <div class="canvas-action-buttons">
                    <button onclick="window.scoutLoadCanvas?.('email_template_editor', { template_id: <%= template.id %> })" 
                            aria-label="Edit <%= template.name.presence || 'template' %>" 
                            class="canvas-btn icon-only secondary" 
                            title="Edit">
                      <i data-lucide="pencil"></i>
                    </button>
                    <button onclick="window.scoutSendMessage?.('Send a test email for template <%= template.id %>')" 
                            aria-label="Send test email" 
                            class="canvas-btn icon-only secondary" 
                            title="Send Test">
                      <i data-lucide="send"></i>
                    </button>
                    <button onclick="window.scoutSendMessage?.('Create a copy of email template <%= template.id %>')" 
                            aria-label="Duplicate" 
                            class="canvas-btn icon-only secondary" 
                            title="Duplicate">
                      <i data-lucide="copy"></i>
                    </button>
                    <button onclick="event.preventDefault(); showConfirm('Are you sure you want to delete this template?', { title: 'Delete Template', dangerous: true }).then(ok => { if (ok) window.scoutSendMessage?.('Delete email template <%= template.id %>') }" 
                            aria-label="Delete" 
                            class="canvas-btn icon-only outline-danger" 
                            title="Delete">
                      <i data-lucide="trash-2"></i>
                    </button>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <!-- Empty State -->
      <div class="canvas-empty-state">
        <div class="canvas-empty-icon">
          <i data-lucide="mail"></i>
        </div>
        <h3>No Email Templates Yet</h3>
        <p>Create your first email template to start sending campaigns.</p>
        <button onclick="window.scoutSendMessage?.('Create a new email template')" aria-label="Create your first email template" class="canvas-btn primary">
          <i data-lucide="plus" class="canvas-icon-sm"></i>
          Create Your First Template
        </button>
      </div>
    <% end %>
  </div>
</div>

<script>
  document.addEventListener('turbo:load', () => {
    if (typeof lucide !== 'undefined') {
      lucide.createIcons();
    }
  });

  document.addEventListener('DOMContentLoaded', () => {
    if (typeof lucide !== 'undefined') {
      lucide.createIcons();
    }
  });
  
  // Initialize icons immediately
  if (typeof lucide !== 'undefined') {
    lucide.createIcons();
  }
</script>
