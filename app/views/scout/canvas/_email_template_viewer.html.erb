<%= turbo_stream_from "entity_#{current_entity.id}_email_templates" %>

<div class="email-template-viewer" style="background-color: #0A0E1A; color: #FFFFFF; min-height: 100vh; padding: 2rem;">
  <!-- Page Header -->
  <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 2rem; flex-wrap: wrap; gap: 1rem;">
    <div>
      <h1 style="color: #FFFFFF; font-size: 2rem; font-weight: 700; margin-bottom: 0.5rem; display: flex; align-items: center; gap: 1rem;">
        <i data-lucide="mail" style="width: 2rem; height: 2rem;"></i>
        Email Templates
      </h1>
      <p style="color: #94A3B8; margin-bottom: 0;">Manage your email templates</p>
    </div>
    <button onclick="window.scoutSendMessage?.('Create a new email template')" aria-label="Create a new email template" style="background: linear-gradient(135deg, #7C3AED 0%, #A78BFA 100%); color: white; border: none; padding: 0.5rem 1rem; border-radius: 0.375rem; cursor: pointer; display: flex; align-items: center; gap: 0.5rem; font-weight: 500;">
      <i data-lucide="plus" style="width: 1rem; height: 1rem;"></i>
      Create Template
    </button>
  </div>

  <!-- Templates Table -->
  <div style="background: #1A1F35; border: 1px solid #1E293B; border-radius: 0.75rem; overflow: hidden;">
    <% if templates.any? %>
      <div style="overflow-x: auto;">
        <table style="width: 100%; border-collapse: collapse;">
          <thead>
            <tr style="background: #0F172A; border-bottom: 1px solid #1E293B;">
              <th style="padding: 1rem; text-align: left; color: #94A3B8; font-weight: 600; font-size: 0.875rem;">Template Name</th>
              <th style="padding: 1rem; text-align: left; color: #94A3B8; font-weight: 600; font-size: 0.875rem;">Subject</th>
              <th style="padding: 1rem; text-align: left; color: #94A3B8; font-weight: 600; font-size: 0.875rem;">Created</th>
              <th style="padding: 1rem; text-align: left; color: #94A3B8; font-weight: 600; font-size: 0.875rem;">Used In</th>
              <th style="padding: 1rem; text-align: right; color: #94A3B8; font-weight: 600; font-size: 0.875rem;">Actions</th>
            </tr>
          </thead>
          <tbody id="email-templates-tbody">
            <% templates.each do |template| %>
              <tr id="email_template_<%= template.id %>" style="border-bottom: 1px solid #1E293B; <%= 'background: rgba(34, 197, 94, 0.05);' if template.created_at > 10.seconds.ago %>">
                <td style="padding: 1rem; color: #FFFFFF; font-weight: 600;">
                  <%= template.name.presence || "Untitled Template" %>
                </td>
                <td style="padding: 1rem; color: #94A3B8; max-width: 300px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                  <%= template.subject.presence || "(No subject)" %>
                </td>
                <td style="padding: 1rem; color: #94A3B8;">
                  <%= template.created_at.strftime('%b %d, %Y') %>
                </td>
                <td style="padding: 1rem;">
                  <% campaign_count = template.campaigns.count %>
                  <% if campaign_count > 0 %>
                    <span style="background: rgba(34, 197, 94, 0.2); color: rgb(74, 222, 128); padding: 0.25rem 0.75rem; border-radius: 0.375rem; font-size: 0.75rem; font-weight: 600;">
                      <%= pluralize(campaign_count, 'campaign') %>
                    </span>
                  <% else %>
                    <span style="background: rgba(108, 117, 125, 0.2); color: #94A3B8; padding: 0.25rem 0.75rem; border-radius: 0.375rem; font-size: 0.75rem; font-weight: 600;">
                      Not used
                    </span>
                  <% end %>
                </td>
                <td style="padding: 1rem; text-align: right;">
                  <div style="display: inline-flex; gap: 0.5rem;">
                    <button onclick="window.scoutLoadCanvas?.('email_template_editor', { template_id: <%= template.id %> })" aria-label="Edit <%= template.name.presence || 'template' %>" style="background: transparent; color: #22D3EE; border: 1px solid #22D3EE; padding: 0.375rem 0.75rem; border-radius: 0.375rem; cursor: pointer; display: inline-flex; align-items: center; gap: 0.25rem;">
                      <i data-lucide="pencil" style="width: 0.875rem; height: 0.875rem;"></i>
                    </button>
                    <button onclick="window.scoutSendMessage?.('Send a test email for template <%= template.id %>')" aria-label="Send test email for <%= template.name.presence || 'template' %>" style="background: transparent; color: #22D3EE; border: 1px solid #22D3EE; padding: 0.375rem 0.75rem; border-radius: 0.375rem; cursor: pointer; display: inline-flex; align-items: center; gap: 0.25rem;">
                      <i data-lucide="send" style="width: 0.875rem; height: 0.875rem;"></i>
                    </button>
                    <button onclick="window.scoutSendMessage?.('Create a copy of email template <%= template.id %>')" aria-label="Duplicate <%= template.name.presence || 'template' %>" style="background: transparent; color: #22D3EE; border: 1px solid #22D3EE; padding: 0.375rem 0.75rem; border-radius: 0.375rem; cursor: pointer; display: inline-flex; align-items: center; gap: 0.25rem;">
                      <i data-lucide="copy" style="width: 0.875rem; height: 0.875rem;"></i>
                    </button>
                    <button onclick="if(confirm('Are you sure you want to delete this template?')) { window.scoutSendMessage?.('Delete email template <%= template.id %>') }" aria-label="Delete <%= template.name.presence || 'template' %>" style="background: transparent; color: rgb(248, 113, 113); border: 1px solid rgb(248, 113, 113); padding: 0.375rem 0.75rem; border-radius: 0.375rem; cursor: pointer; display: inline-flex; align-items: center; gap: 0.25rem;">
                      <i data-lucide="trash-2" style="width: 0.875rem; height: 0.875rem;"></i>
                    </button>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <!-- Empty State -->
      <div style="text-align: center; padding: 3rem 2rem;">
        <div style="width: 4rem; height: 4rem; background: linear-gradient(135deg, #7C3AED 0%, #A78BFA 100%); border-radius: 1rem; display: flex; align-items: center; justify-content: center; margin: 0 auto 1.5rem;">
          <i data-lucide="mail" style="width: 2rem; height: 2rem; color: white;"></i>
        </div>
        <h3 style="color: #FFFFFF; font-size: 1.25rem; font-weight: 600; margin-bottom: 0.5rem;">No Email Templates Yet</h3>
        <p style="color: #94A3B8; margin-bottom: 1.5rem;">Create your first email template to start sending campaigns.</p>
        <button onclick="window.scoutSendMessage?.('Create a new email template')" aria-label="Create your first email template" style="background: linear-gradient(135deg, #7C3AED 0%, #A78BFA 100%); color: white; border: none; padding: 0.5rem 1rem; border-radius: 0.375rem; cursor: pointer; display: inline-flex; align-items: center; gap: 0.5rem; font-weight: 500;">
          <i data-lucide="plus" style="width: 1rem; height: 1rem;"></i>
          Create Your First Template
        </button>
      </div>
    <% end %>
  </div>

  <!-- Stats Summary -->
  <% if stats[:total_templates] > 0 %>
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1.5rem; margin-top: 2rem;">
      <!-- Total Templates -->
      <div style="background: #1A1F35; border: 1px solid #1E293B; border-radius: 0.75rem; padding: 1.5rem;">
        <div style="display: flex; align-items: center; gap: 1rem;">
          <div style="width: 3rem; height: 3rem; background: linear-gradient(135deg, #7C3AED 0%, #A78BFA 100%); border-radius: 0.75rem; display: flex; align-items: center; justify-content: center;">
            <i data-lucide="mail" style="width: 1.5rem; height: 1.5rem; color: white;"></i>
          </div>
          <div>
            <p style="color: #94A3B8; font-size: 0.875rem; margin: 0;">Total Templates</p>
            <h3 style="color: white; font-size: 1.875rem; font-weight: 600; margin: 0;"><%= stats[:total_templates] %></h3>
          </div>
        </div>
      </div>

      <!-- Active Templates -->
      <div style="background: #1A1F35; border: 1px solid #1E293B; border-radius: 0.75rem; padding: 1.5rem;">
        <div style="display: flex; align-items: center; gap: 1rem;">
          <div style="width: 3rem; height: 3rem; background: rgba(34, 197, 94, 0.1); border: 1px solid rgba(34, 197, 94, 0.2); border-radius: 0.75rem; display: flex; align-items: center; justify-content: center;">
            <i data-lucide="check-circle" style="width: 1.5rem; height: 1.5rem; color: rgb(74, 222, 128);"></i>
          </div>
          <div>
            <p style="color: #94A3B8; font-size: 0.875rem; margin: 0;">Active Templates</p>
            <h3 style="color: white; font-size: 1.875rem; font-weight: 600; margin: 0;"><%= stats[:active_templates] %></h3>
          </div>
        </div>
      </div>

      <!-- Used in Campaigns -->
      <div style="background: #1A1F35; border: 1px solid #1E293B; border-radius: 0.75rem; padding: 1.5rem;">
        <div style="display: flex; align-items: center; gap: 1rem;">
          <div style="width: 3rem; height: 3rem; background: rgba(34, 211, 238, 0.1); border: 1px solid rgba(34, 211, 238, 0.2); border-radius: 0.75rem; display: flex; align-items: center; justify-content: center;">
            <i data-lucide="trending-up" style="width: 1.5rem; height: 1.5rem; color: #22D3EE;"></i>
          </div>
          <div>
            <p style="color: #94A3B8; font-size: 0.875rem; margin: 0;">Used in Campaigns</p>
            <h3 style="color: white; font-size: 1.875rem; font-weight: 600; margin: 0;"><%= stats[:used_templates] %></h3>
          </div>
        </div>
      </div>

      <!-- Unused Templates -->
      <div style="background: #1A1F35; border: 1px solid #1E293B; border-radius: 0.75rem; padding: 1.5rem;">
        <div style="display: flex; align-items: center; gap: 1rem;">
          <div style="width: 3rem; height: 3rem; background: rgba(250, 204, 21, 0.1); border: 1px solid rgba(250, 204, 21, 0.2); border-radius: 0.75rem; display: flex; align-items: center; justify-content: center;">
            <i data-lucide="alert-circle" style="width: 1.5rem; height: 1.5rem; color: rgb(250, 204, 21);"></i>
          </div>
          <div>
            <p style="color: #94A3B8; font-size: 0.875rem; margin: 0;">Unused Templates</p>
            <h3 style="color: white; font-size: 1.875rem; font-weight: 600; margin: 0;"><%= stats[:unused_templates] %></h3>
          </div>
        </div>
      </div>
    </div>
  <% end %>
</div>

<script>
  document.addEventListener('turbo:load', () => {
    if (typeof lucide !== 'undefined') {
      lucide.createIcons();
    }
  });

  document.addEventListener('DOMContentLoaded', () => {
    if (typeof lucide !== 'undefined') {
      lucide.createIcons();
    }
  });
</script>
