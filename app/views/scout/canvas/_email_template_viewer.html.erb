<div class="email-template-viewer">
  <div class="card shadow-sm">
    <div class="card-header bg-white d-flex justify-content-between align-items-center">
      <div>
        <h5 class="mb-0">
          <i class="fas fa-envelope text-primary me-2"></i>
          Email Templates
        </h5>
        <small class="text-muted">Manage your email templates</small>
      </div>
      <button class="btn btn-primary btn-sm" onclick="window.scoutSendMessage?.('Create a new email template')">
        <i class="fas fa-plus me-1"></i> Create Template
      </button>
    </div>
    <div class="card-body">
      <% if templates.any? %>
        <div class="table-responsive">
          <table class="table table-hover">
            <thead>
              <tr>
                <th>Template Name</th>
                <th>Subject</th>
                <th>Created</th>
                <th>Used In</th>
                <th class="text-end">Actions</th>
              </tr>
            </thead>
            <tbody>
              <% templates.each do |template| %>
                <tr>
                  <td>
                    <div class="fw-medium">
                      <%= template.name.presence || "Untitled Template" %>
                    </div>
                  </td>
                  <td>
                    <div class="text-truncate" style="max-width: 300px;">
                      <%= template.subject.presence || "(No subject)" %>
                    </div>
                  </td>
                  <td>
                    <%= template.created_at.strftime('%b %d, %Y') %>
                  </td>
                  <td>
                    <% campaign_count = template.campaigns.count %>
                    <% if campaign_count > 0 %>
                      <span class="badge bg-success">
                        <%= pluralize(campaign_count, 'campaign') %>
                      </span>
                    <% else %>
                      <span class="badge bg-secondary">Not used</span>
                    <% end %>
                  </td>
                  <td class="text-end">
                    <div class="btn-group btn-group-sm" role="group">
                      <button class="btn btn-outline-primary" 
                              onclick="window.scoutLoadCanvas?.('email_template_editor', { template_id: <%= template.id %> })"
                              title="Edit Template">
                        <i class="fas fa-edit"></i>
                      </button>
                      <button class="btn btn-outline-info" 
                              onclick="window.scoutSendMessage?.('Send a test email for template <%= template.id %>')"
                              title="Send Test">
                        <i class="fas fa-paper-plane"></i>
                      </button>
                      <button class="btn btn-outline-warning" 
                              onclick="window.scoutSendMessage?.('Create a copy of email template <%= template.id %>')"
                              title="Duplicate">
                        <i class="fas fa-copy"></i>
                      </button>
                      <button class="btn btn-outline-danger" 
                              onclick="if(confirm('Are you sure you want to delete this template?')) { window.scoutSendMessage?.('Delete email template <%= template.id %>') }"
                              title="Delete">
                        <i class="fas fa-trash"></i>
                      </button>
                    </div>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% else %>
        <div class="text-center py-5">
          <i class="fas fa-envelope fa-3x text-muted mb-3"></i>
          <h6>No Email Templates Yet</h6>
          <p class="text-muted">Create your first email template to start sending campaigns.</p>
          <button class="btn btn-primary" onclick="window.scoutSendMessage?.('Create a new email template')">
            <i class="fas fa-plus me-1"></i> Create Your First Template
          </button>
        </div>
      <% end %>
    </div>
  </div>

  <!-- Stats Summary -->
  <% if stats[:total_templates] > 0 %>
    <div class="row mt-3">
      <div class="col-md-3">
        <div class="card bg-primary text-white">
          <div class="card-body">
            <h6 class="card-title">Total Templates</h6>
            <h3 class="mb-0"><%= stats[:total_templates] %></h3>
          </div>
        </div>
      </div>
      <div class="col-md-3">
        <div class="card bg-success text-white">
          <div class="card-body">
            <h6 class="card-title">Active Templates</h6>
            <h3 class="mb-0"><%= stats[:active_templates] %></h3>
          </div>
        </div>
      </div>
      <div class="col-md-3">
        <div class="card bg-info text-white">
          <div class="card-body">
            <h6 class="card-title">Used in Campaigns</h6>
            <h3 class="mb-0"><%= stats[:used_templates] %></h3>
          </div>
        </div>
      </div>
      <div class="col-md-3">
        <div class="card bg-warning text-dark">
          <div class="card-body">
            <h6 class="card-title">Unused Templates</h6>
            <h3 class="mb-0"><%= stats[:unused_templates] %></h3>
          </div>
        </div>
      </div>
    </div>
  <% end %>
</div>
