  // Upload files helper function
  async function uploadFiles(files) {
    const formData = new FormData();
    files.forEach((file, index) => {
      formData.append(`files[${index}]`, file);
    });
    
    try {
      const response = await fetch('/scout/upload_files', {
        method: 'POST',
        headers: {
          'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]')?.content
        },
        body: formData
      });
      
      if (!response.ok) {
        throw new Error('File upload failed');
      }
      
      const result = await response.json();
      return result.urls || [];
    } catch (error) {
      console.error('File upload error:', error);
      addMessage('Failed to upload files. Please try again.', 'assistant');
      return [];
    }
  }
  
  // Handle interactive workflow chat
  async function handleInteractiveChat(message, context = null, files = []) {
    const csrfToken = document.querySelector('meta[name="csrf-token"]')?.content;
    
    // Upload files first if any
    let fileUrls = [];
    if (files && files.length > 0) {
      fileUrls = await uploadFiles(files);
    }
    
    try {
      const response = await fetch('/scout/chat_interactive', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'X-CSRF-Token': csrfToken
        },
        body: JSON.stringify({
          message: message,
          context: context,
          file_urls: fileUrls
        })
      });
      
      const data = await response.json();
      
      if (data.success) {
        // Add assistant message
        if (data.message) {
          addMessage(data.message, 'assistant');
        }
        
        // Load appropriate canvas
        if (data.canvas && data.canvas !== 'conversation') {
          // Use the same pattern as in streaming to load canvas
          if (window.scoutController && window.scoutController.loadScoutCanvas) {
            window.scoutController.loadScoutCanvas(data.canvas, data.canvas_data || {});
          } else {
            // Try to find the controller through the DOM
            const scoutElement = document.querySelector('[data-controller="scout"]');
            if (scoutElement && scoutElement._scoutController) {
              scoutElement._scoutController.loadScoutCanvas(data.canvas, data.canvas_data || {});
            } else {
              // Dispatch a custom event as fallback
              const event = new CustomEvent('scout:load-canvas', {
                detail: { canvas: data.canvas, data: data.canvas_data || {} }
              });
              document.dispatchEvent(event);
            }
          }
        }
        
        // Handle different workflow states
        if (data.awaiting_input) {
          console.log('Workflow awaiting user input');
        } else if (data.workflow_completed) {
          console.log('Workflow completed successfully');
        } else if (data.step_completed) {
          console.log('Workflow step completed, continuing...');
        }
        
      } else {
        addMessage(data.message || 'An error occurred', 'assistant');
      }
      
    } catch (error) {
      console.error('Interactive chat error:', error);
      addMessage('Sorry, I encountered an error. Please try again.', 'assistant');
    } finally {
      // Re-enable form
      const messageInput = document.querySelector('#message-input');
      const sendButton = document.querySelector('#send-button');
      if (messageInput) messageInput.disabled = false;
      if (sendButton) sendButton.disabled = false;
      hideTypingIndicator();
    }
  }

  // Handle streaming chat
  async function handleStreamingChat(message, context = null) {
    const csrfToken = document.querySelector('meta[name="csrf-token"]')?.content;
    
    // Abort any existing stream before starting a new one
    if (window.currentStreamAbortController) {
      console.log('🛑 Aborting previous stream to handle new message');
      window.currentStreamAbortController.abort();
      window.currentStreamAbortController = null;
    }
    
    // Create new abort controller for this request
    window.currentStreamAbortController = new AbortController();
    const signal = window.currentStreamAbortController.signal;
    
    // Track streaming state
    let streamingMessage = null;
    let streamingContent = '';
    
    // Add timeout fallback to prevent getting stuck
    const timeoutId = setTimeout(() => {
      console.warn('Streaming timeout - cleaning up UI');
      messageInput.disabled = false;
      sendButton.disabled = false;
      if (messageInput && messageInput.focus) {
        messageInput.focus();
      }
      // toolActivity.style.display = 'none';
      hideStreamingStatus();
      hideTypingIndicator();
      
      // Clear abort controller
      if (window.currentStreamAbortController) {
        window.currentStreamAbortController.abort();
        window.currentStreamAbortController = null;
      }
    }, 120000); // 120 second timeout
    
    try {
      const response = await fetch('/scout/chat_stream', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'X-CSRF-Token': csrfToken || ''
        },
        body: JSON.stringify({ message: message, context: context }),
        signal: signal // Pass abort signal to fetch
      });

      if (!response.body) {
        throw new Error('Streaming not supported');
      }

      const reader = response.body.getReader();
      const decoder = new TextDecoder();

      while (true) {
        const { done, value } = await reader.read();
        
        if (done) break;

        const chunk = decoder.decode(value);
        const lines = chunk.split('\n');

        for (const line of lines) {
          if (line.startsWith('data: ')) {
            try {
              const data = JSON.parse(line.slice(6));
              
              if (data.type === 'update') {
                // Route status updates to unified chat only
                // No legacy streaming UI elements
                if (data.message === '💬 streaming') {
                  // Initialize streaming for unified chat
                  console.log('💬 Initializing streaming message');
                  if (!streamingMessage) {
                    streamingMessage = addMessage('', 'assistant');
                    streamingContent = '';
                    console.log('✅ Created streaming message element:', streamingMessage);
                  }
                }
              } else if (data.type === 'content') {
                // Route content chunks to unified chat message
                console.log('📝 Content chunk received:', data.content?.substring(0, 50) + '...');
                if (streamingMessage && data.content) {
                  streamingContent += data.content;
                  const messageContent = streamingMessage.querySelector('.message-content');
                  if (messageContent) {
                    messageContent.innerHTML = parseMarkdown(streamingContent);
                    scrollToBottom();
                    console.log('✅ Updated streaming message with', streamingContent.length, 'chars');
                  } else {
                    console.error('❌ No message-content element found in streaming message');
                  }
                } else {
                  console.warn('⚠️ No streaming message element or no content:', { streamingMessage: !!streamingMessage, content: !!data.content });
                }
              } else if (data.type === 'intermediate_message') {
                // Add intermediate message that was saved before tool usage
                // But only if it wasn't already streamed to prevent duplicates
                if (data.content && data.content.trim() !== '') {
                  const contentHash = data.content.trim();
                  
                  // Check both streamedContent Set AND existing messages in the chat
                  const existingMessages = Array.from(chatMessages.querySelectorAll('.message-content')).map(el => el.textContent.trim());
                  const alreadyExists = streamedContent.has(contentHash) || existingMessages.includes(contentHash);
                  
                  if (!alreadyExists) {
                    console.log('📝 Adding intermediate message:', contentHash.substring(0, 50) + '...');
                    addMessage(data.content, data.role || 'assistant');
                    streamedContent.add(contentHash); // Track it immediately
                    scrollToBottom();
                  } else {
                    console.log('⚠️ Skipping duplicate intermediate message (already in chat):', contentHash.substring(0, 50) + '...');
                  }
                }
              } else if (data.type === 'add_tool_message') {
                // Add tool message to chat UI
                const toolMessage = buildToolMessageElement({
                  content: `tool:${data.tool_name}`,
                  metadata: {
                    type: 'tool_call',
                    tool_name: data.tool_name,
                    tool_id: data.tool_id
                  }
                });
                chatMessages.appendChild(toolMessage);

                // Initialize Lucide icons for tool message
                if (typeof lucide !== 'undefined') {
                  lucide.createIcons();
                }

                scrollToBottom();
                updateMessageCount();
                
                // Track any accumulated content before resetting
                if (streamingContent.trim()) {
                  streamedContent.add(streamingContent.trim());
                  console.log('📝 Tracked streamed content before tool:', streamingContent.trim().substring(0, 50) + '...');
                }
                
                // Reset streaming message so the next content creates a new message
                streamingMessage = null;
                streamingContent = '';
              } else if (data.type === 'transient') {
                // Handle transient progress messages (tool usage, phase progress, etc.)
                console.log('🔄 Transient update:', data.message);
                showTransientMessage(data.message);
              } else if (data.type === 'load_canvas') {
                // Immediately load a canvas (e.g., task progress)
                console.log('🎨 Received canvas load request:', data.canvas, 'at', new Date().toISOString());
                console.log('🎨 Canvas data keys:', data.canvas_data ? Object.keys(data.canvas_data) : 'no data');
                if (data.canvas) {
                  // For task_progress, load immediately without delay
                  const loadDelay = data.canvas === 'task_progress' ? 0 : 100;
                  
                  setTimeout(() => {
                    // Method 1: Use window.scoutController if available
                    if (window.scoutController && window.scoutController.loadScoutCanvas) {
                      console.log('📋 Loading canvas via scoutController:', data.canvas);
                      window.scoutController.loadScoutCanvas(data.canvas, data.canvas_data || {});
                    } 
                    // Method 2: Find the controller through Stimulus
                    else {
                      const scoutElement = document.querySelector('[data-controller="scout"]');
                      if (scoutElement && scoutElement._scoutController) {
                        scoutElement._scoutController.loadScoutCanvas(data.canvas, data.canvas_data || {});
                      }
                      // Method 3: Dispatch a custom event that the controller can listen to
                      else {
                        console.log('🎯 Dispatching canvas load event');
                        const event = new CustomEvent('scout:load-canvas', {
                          detail: { canvas: data.canvas, data: data.canvas_data || {} }
                        });
                        document.dispatchEvent(event);
                      }
                    }
                  }, loadDelay); // Use dynamic delay based on canvas type
                }
              } else if (data.type === 'tool_detected') {
                // Tool detected during streaming
                console.log('🔧 Tool detected:', data.name);
                // Tool messages are now saved to database and shown via add_tool_message event
                
                // Track in tool panel if not already tracked
                if (!currentToolCallId || data.tool_id !== currentToolCallId) {
                  currentToolCallId = data.tool_id || addToolCall(data.name, 'Detected, preparing to execute...');
                }
              } else if (data.type === 'tool_start') {
                // Tool execution starting
                if (data.name && data.arguments) {
                  const toolId = addToolCall(data.name, 'Executing with arguments...');
                  updateToolCall(toolId, 'running', `Running ${getToolDisplayName(data.name)}...`, JSON.stringify(data.arguments, null, 2));
                  currentToolCallId = toolId;
                  // Update inline indicator
                  updateInlineToolIndicator(data.name, 'running');
                }
              } else if (data.type === 'response') {
                hideStreamingStatus();
                hideTypingIndicator();
                
                if (data.data.error) {
                  addMessage('Sorry, I encountered an error. Please try again.', 'assistant');
                } else {
                  // For advisor mode with streaming, we've already added the content
                  // Only add a new message if we weren't streaming
                  if (!streamingMessage && data.data.message) {
                  addMessage(data.data.message, 'assistant');
                  }

                  // Display source citations if available
                  if (data.data.sources && data.data.sources.length > 0) {
                    addSourceCitations(data.data.sources);
                  }

                  // Show tool usage info
                  if (data.data.tools_used && data.data.tools_list?.length > 0) {
                    console.log('Tools used:', data.data.tools_list);
                    console.log('Success count:', data.data.success_count);
                  }
                  
                  // Debug the response structure
                  console.log('📦 Full response structure:', data);
                  console.log('📦 data.canvas:', data.canvas);
                  console.log('📦 data.data:', data.data);
                  console.log('📦 data.data?.canvas:', data.data?.canvas);
                  
                  // Load canvas if suggested - check both possible locations
                  const canvasName = data.data?.canvas || data.canvas;
                  const canvasData = data.data?.canvas_data || data.canvas_data || {};
                  
                  console.log('🎨 Canvas check - name:', canvasName, 'controller:', window.scoutController);
                  if (canvasName) {
                    console.log('🎨 Loading canvas:', canvasName);
                    
                    // Try multiple ways to load the canvas
                    setTimeout(() => {
                      // Method 1: Use window.scoutController if available
                      if (window.scoutController && window.scoutController.loadScoutCanvas) {
                        window.scoutController.loadScoutCanvas(canvasName, canvasData);
                      } 
                      // Method 2: Find the controller through Stimulus
                      else {
                        const scoutElement = document.querySelector('[data-controller="scout"]');
                        if (scoutElement && scoutElement._scoutController) {
                          scoutElement._scoutController.loadScoutCanvas(canvasName, canvasData);
                        }
                        // Method 3: Dispatch a custom event that the controller can listen to
                        else {
                          console.log('🎯 Dispatching canvas load event');
                          const event = new CustomEvent('scout:load-canvas', {
                            detail: { canvas: canvasName, data: canvasData }
                          });
                          document.dispatchEvent(event);
                        }
                      }
                    }, 1000);
                  }
                }
                
                // CRITICAL FIX: Re-enable input after successful streaming response
                clearTimeout(timeoutId);
                messageInput.disabled = false;
                sendButton.disabled = false;
                if (messageInput && messageInput.focus) {
                  messageInput.focus();
                }
                // toolActivity.style.display = 'none';
                hideStreamingStatus();
                
                // Clear abort controller - stream completed successfully
                window.currentStreamAbortController = null;
                
                // Track the final streamed content to prevent duplicates
                if (streamingContent.trim()) {
                  streamedContent.add(streamingContent.trim());
                  console.log('📝 Tracked streamed content:', streamingContent.trim().substring(0, 50) + '...');
                }
                
                // Reset streaming state
                streamingMessage = null;
                streamingContent = '';
                
                return; // Done processing
              }
            } catch (e) {
              console.warn('Failed to parse streaming data:', line);
            }
          }
        }
      }
    } catch (error) {
      console.error('Streaming error:', error);
      clearTimeout(timeoutId); // Clear timeout on error
      
      // Clear abort controller on error
      window.currentStreamAbortController = null;
      
      // Check if this was an intentional abort (interruption)
      if (error.name === 'AbortError') {
        console.log('🛑 Stream was aborted (likely due to interruption)');
        return; // Don't throw, just return silently
      }
      
      throw error; // Re-throw other errors to fallback to regular chat
    }
  }

  // ============================
  // History pagination (load older on scroll-up)
  // ============================
  const historyState = { isLoading: false, hasMore: true, oldestId: null };

  function getOldestRenderedId() {
    const first = chatMessages.querySelector('.message');
    return first ? first.dataset.messageId || null : null;
  }

  async function loadMoreHistory(initial = false) {
    if (historyState.isLoading || (!historyState.hasMore && !initial)) return;
    historyState.isLoading = true;
    try {
      const beforeId = initial ? null : (historyState.oldestId || getOldestRenderedId());
      const url = new URL('/scout/history', window.location.origin);
      if (beforeId) url.searchParams.set('before_id', beforeId);
      url.searchParams.set('limit', initial ? '10' : '20');
      const res = await fetch(url.toString());
      if (!res.ok) throw new Error('Failed to load history');
      const data = await res.json();
      if (Array.isArray(data.messages) && data.messages.length > 0) {
        // Normalize to the structure buildMessageElement expects
        const items = data.messages.map(m => ({ 
          id: m.id, 
          role: m.role, 
          content: m.content, 
          timestamp: m.timestamp,
          metadata: m.metadata 
        }));
        prependMessages(items);
        historyState.oldestId = items[0].id;
      } else if (initial) {
        // No history exists, create welcome message
        const welcomeMessage = {
          id: 'welcome-' + Date.now(),
          role: 'assistant',
          content: "Welcome! I'm Amos, your AI business automation assistant. I can help you manage operations, create landing pages, analyze data, handle integrations, and automate workflows across your entire business. What would you like to work on today?",
          timestamp: new Date().toISOString(),
          metadata: {}
        };
        prependMessages([welcomeMessage]);
      }
      historyState.hasMore = !!data.has_more;
    } catch (e) {
      console.warn('History load failed:', e);
    } finally {
      historyState.isLoading = false;
    }
  }

  // Check for saved canvas state and restore it
  function restoreCanvasState() {
    const savedCanvas = localStorage.getItem('scout_canvas_state');
    if (savedCanvas) {
      try {
        const canvasState = JSON.parse(savedCanvas);
        console.log('🔄 Restoring canvas state:', canvasState);
        
        // Load the saved canvas
        if (window.scoutController && window.scoutController.loadScoutCanvas) {
          window.scoutController.loadScoutCanvas(canvasState.type, canvasState.data);
        }
        return true;
      } catch (e) {
        console.error('❌ Failed to restore canvas state:', e);
        localStorage.removeItem('scout_canvas_state');
      }
    }
    return false;
  }

  // Initial fetch of recent history when page loads
  loadMoreHistory(true).then(() => {
    // Don't auto-restore canvas state on login - let user choose what to do
    // Clear any stale canvas state from previous sessions
    localStorage.removeItem('scout_canvas_state');
    const canvasRestored = false;

    // Add buttons to the first welcome message
    if (!canvasRestored) {
      setTimeout(() => {
        const messages = chatMessages.querySelectorAll('.message.ai-message');
        if (messages.length > 0) {
          const firstMessage = messages[0];
          const messageContent = firstMessage.querySelector('.message-bubble');
          
          // Check if this is a welcome message and doesn't already have buttons
          if (messageContent && messageContent.textContent.includes('Scout') && 
              messageContent.textContent.includes('marketing assistant') &&
              !firstMessage.querySelector('.message-suggestions')) {
            
            // Add the suggestion buttons
            const suggestionsDiv = document.createElement('div');
            suggestionsDiv.className = 'message-suggestions';
            suggestionsDiv.style.marginTop = '12px';
            suggestionsDiv.innerHTML = `
              <button class="suggestion-btn" data-suggestion="Create a landing page for my product">
                Create a landing page
              </button>
              <button class="suggestion-btn" data-suggestion="Show me my email campaigns">
                View campaigns
              </button>
              <button class="suggestion-btn" data-suggestion="Analyze my marketing performance">
                Analytics dashboard
              </button>
            `;
            messageContent.appendChild(suggestionsDiv);
            
            // Add click handlers to suggestion buttons
            suggestionsDiv.querySelectorAll('.suggestion-btn').forEach(btn => {
              btn.addEventListener('click', function() {
                const suggestion = this.dataset.suggestion;
                messageInput.value = suggestion;
                messageForm.dispatchEvent(new Event('submit'));
              });
            });
          }
        }
      }, 100); // Small delay to ensure DOM is updated
    }
  });

  // Attach scroll-up listener to load older history
  chatMessages.addEventListener('scroll', function() {
    if (chatMessages.scrollTop <= 20) {
      loadMoreHistory(false);
    }
  });

  // File attachment handling
  const attachButton = document.getElementById('attach-button');
  const fileInput = document.getElementById('file-input');
  const attachedFilesContainer = document.getElementById('attached-files');
  let attachedFiles = [];

  console.log('📎 File upload initialization:', {
    attachButton: !!attachButton,
    fileInput: !!fileInput,
    attachedFilesContainer: !!attachedFilesContainer
  });

  if (!attachButton || !fileInput) {
    console.error('❌ File upload elements not found!');
  }

  attachButton.addEventListener('click', function() {
    console.log('📎 Attach button clicked');
    fileInput.click();
  });
  
  fileInput.addEventListener('change', function(e) {
    console.log('📎 File input changed, files selected:', e.target.files.length);
    const files = Array.from(e.target.files);
    console.log('📎 Files:', files.map(f => ({ name: f.name, size: f.size, type: f.type })));

    files.forEach(file => {
      if (!attachedFiles.find(f => f.name === file.name)) {
        console.log('📎 Adding file:', file.name);
        attachedFiles.push(file);
        displayAttachedFile(file);
      } else {
        console.log('📎 File already attached:', file.name);
      }
    });
    fileInput.value = ''; // Reset input
    console.log('📎 Total attached files:', attachedFiles.length);
  });
  
  function displayAttachedFile(file) {
    console.log('📎 Displaying attached file:', file.name);
    console.log('📎 Container display before:', attachedFilesContainer.style.display);

    if (attachedFiles.length > 0 && attachedFilesContainer.style.display === 'none') {
      attachedFilesContainer.style.display = 'block';
      console.log('📎 Container display after:', attachedFilesContainer.style.display);
    }
    
    const fileDiv = document.createElement('div');
    fileDiv.className = 'attached-file';
    
    const icon = document.createElement('i');
    icon.className = getFileIcon(file.type);
    icon.classList.add('file-icon');
    
    const name = document.createElement('span');
    name.textContent = file.name;
    
    const remove = document.createElement('span');
    remove.className = 'remove';
    remove.innerHTML = '&times;';
    remove.onclick = () => removeFile(file, fileDiv);
    
    fileDiv.appendChild(icon);
    fileDiv.appendChild(name);
    fileDiv.appendChild(remove);
    attachedFilesContainer.appendChild(fileDiv);
  }
  
  function getFileIcon(fileType) {
    if (fileType.startsWith('image/')) return 'fas fa-image';
    if (fileType === 'application/pdf') return 'fas fa-file-pdf';
    if (fileType.includes('word') || fileType.includes('document')) return 'fas fa-file-word';
    return 'fas fa-file';
  }
  
  function removeFile(file, fileDiv) {
    attachedFiles = attachedFiles.filter(f => f.name !== file.name);
    fileDiv.remove();
    if (attachedFiles.length === 0) {
      attachedFilesContainer.style.display = 'none';
    }
  }
  
  // Handle form submission
  messageForm.addEventListener('submit', async function(e) {
    e.preventDefault();

    const message = messageInput.value.trim();

    // Interrupt TTS if speaking
    if (ttsManager && ttsManager.isPlaying) {
      ttsManager.interrupt();
    }

    // Allow submission if there are attached files even without a message
    if (!message && attachedFiles.length === 0) {
      console.log('⚠️ No message and no files, returning early');
      return;
    }

    // If there are files but no message, use a default message
    const finalMessage = message || 'Please process these files';
    console.log('📤 Submitting with message:', finalMessage, 'and', attachedFiles.length, 'files');

    // If files are attached, show storage choice modal first
    if (attachedFiles.length > 0) {
      console.log('📎 Files attached, showing storage choice modal');

      // Store the continuation function
      window.pendingFileUpload = async function() {
        console.log('📤 Proceeding with upload, storage choice:', window.documentStorageChoice);

        // Add user message
        addMessage(finalMessage, 'user');
        messageInput.value = '';
        messageInput.style.height = '42px';

        // Disable input while processing
        messageInput.disabled = true;
        sendButton.disabled = true;

        try {
          const currentCanvas = getCurrentCanvasContext();

          if (shouldUseInteractiveMode(finalMessage)) {
            console.log('🎯 Using interactive mode for:', finalMessage);
            await handleInteractiveChat(finalMessage, currentCanvas, attachedFiles);
          } else {
            console.log('⚡ Using streaming mode for:', finalMessage);
            if (window.scoutController && window.scoutController.processMessage) {
              await window.scoutController.processMessage(finalMessage, attachedFiles);
            } else {
              console.error('❌ Scout controller not available!');
              addMessage('Sorry, the chat system is not ready. Please refresh the page.', 'assistant');
              throw new Error('Scout controller not available');
            }
          }

          // Clear attached files after sending
          attachedFiles = [];
          attachedFilesContainer.innerHTML = '';
          attachedFilesContainer.style.display = 'none';
        } catch (error) {
          console.error('Error sending message:', error);
          hideStreamingStatus();
          hideTypingIndicator();
          addMessage('Sorry, I encountered an error. Please try again.', 'assistant');

          // Re-enable form
          messageInput.disabled = false;
          sendButton.disabled = false;
          if (messageInput && messageInput.focus) {
            messageInput.focus();
          }
        }
      };

      // Show the modal
      const storageModal = new bootstrap.Modal(document.getElementById('document-storage-modal'));
      storageModal.show();
      return; // Wait for user choice
    }

    // No files - proceed normally
    addMessage(finalMessage, 'user');
    messageInput.value = '';
    messageInput.style.height = '42px';
    messageInput.disabled = true;
    sendButton.disabled = true;

    try {
      const currentCanvas = getCurrentCanvasContext();

      if (shouldUseInteractiveMode(finalMessage)) {
        await handleInteractiveChat(finalMessage, currentCanvas, []);
      } else {
        if (window.scoutController && window.scoutController.processMessage) {
          await window.scoutController.processMessage(finalMessage, []);
        } else {
          console.error('❌ Scout controller not available!');
          addMessage('Sorry, the chat system is not ready. Please refresh the page.', 'assistant');
          throw new Error('Scout controller not available');
        }
      }
    } catch (error) {
      console.error('Error sending message:', error);
      hideStreamingStatus();
      hideTypingIndicator();
      addMessage('Sorry, I encountered an error. Please try again.', 'assistant');

      messageInput.disabled = false;
      sendButton.disabled = false;
      if (messageInput && messageInput.focus) {
        messageInput.focus();
      }
    }
  });

  // Handle enter key (send on Enter, new line on Shift+Enter)
  messageInput.addEventListener('keydown', function(e) {
    if (e.key === 'Enter' && !e.shiftKey) {
      e.preventDefault();
      messageForm.dispatchEvent(new Event('submit'));
    }
  });

}); // End turbo:load

// Global functions that need to be accessible outside turbo:load
window.pendingConfirmation = window.pendingConfirmation || null;

// Global function for canvas actions to send messages
window.scoutSendMessage = async function(message) {
  console.log('📨 scoutSendMessage called with:', message);
  
  // We need to wait for DOM to be ready
  const waitForDOM = () => {
    const messageInput = document.getElementById('message-input');
    const messageForm = document.getElementById('message-form');
    
    if (messageInput && messageForm) {
      // Set the input value and submit the form
      messageInput.value = message;
      messageForm.dispatchEvent(new Event('submit'));
    } else {
      // If DOM not ready, try again in 100ms
      setTimeout(waitForDOM, 100);
    }
  };
  
  waitForDOM();
};

function showConfirmationDialog(message, onConfirm) {
  const dialog = document.getElementById('confirmation-dialog');
  const messageEl = document.getElementById('confirmation-message');
  const proceedBtn = document.getElementById('confirmation-proceed');
  
  messageEl.innerHTML = message;
  window.pendingConfirmation = onConfirm;
  
  // Show the dialog using Bootstrap modal
  const modal = new bootstrap.Modal(dialog);
  modal.show();
}

// Handle document storage modal
document.addEventListener('turbo:load', function() {
  // Storage choice modal handlers
  const storageModal = document.getElementById('document-storage-modal');
  const confirmBtn = document.getElementById('confirm-storage-choice');
  const storageOptions = document.querySelectorAll('.storage-option');
  const radioButtons = document.querySelectorAll('input[name="storageChoice"]');

  // Make entire card clickable
  storageOptions.forEach(option => {
    option.addEventListener('click', function() {
      const radio = this.querySelector('input[type="radio"]');
      radio.checked = true;
      confirmBtn.disabled = false;

      // Visual feedback
      storageOptions.forEach(opt => opt.classList.remove('border-primary'));
      this.classList.add('border-primary');
    });
  });

  // Radio button change
  radioButtons.forEach(radio => {
    radio.addEventListener('change', function() {
      confirmBtn.disabled = false;
    });
  });

  // Store the selected choice globally for the upload handler
  window.documentStorageChoice = null;
  window.pendingFileUpload = null;

  confirmBtn?.addEventListener('click', function() {
    const selectedRadio = document.querySelector('input[name="storageChoice"]:checked');
    if (selectedRadio) {
      window.documentStorageChoice = selectedRadio.value;
      console.log('📝 Storage choice:', window.documentStorageChoice);

      // Hide modal
      const modalInstance = bootstrap.Modal.getInstance(storageModal);
      modalInstance.hide();

      // Proceed with the pending upload
      if (window.pendingFileUpload) {
        window.pendingFileUpload();
        window.pendingFileUpload = null;
      }
    }
  });

  // Reset modal when closed
  storageModal?.addEventListener('hidden.bs.modal', function() {
    radioButtons.forEach(radio => radio.checked = false);
    storageOptions.forEach(opt => opt.classList.remove('border-primary'));
    confirmBtn.disabled = true;
    window.documentStorageChoice = null;
    window.pendingFileUpload = null;
  });

  // Handle confirmation proceed
  document.getElementById('confirmation-proceed')?.addEventListener('click', function() {
    if (window.pendingConfirmation) {
      window.pendingConfirmation();
      window.pendingConfirmation = null;
    }

    // Hide the modal
    const dialog = document.getElementById('confirmation-dialog');
    const modal = bootstrap.Modal.getInstance(dialog);
    modal.hide();
  });

  // Handle auto-load parameters
  <% if @auto_load_canvas == 'integrations' %>
    // Auto-load integrations on page load
    setTimeout(() => {
      console.log('Auto-loading integrations canvas...');
      if (window.scoutSendMessage) {
        window.scoutSendMessage('Show me my integration connections');
      }
    }, 1000); // Small delay to ensure Scout is fully loaded
  <% elsif @auto_load_canvas == 'default' %>
    // Auto-load default canvas for new conversations
    setTimeout(() => {
      console.log('Auto-loading default canvas for new conversation...');
      if (window.scoutController && window.scoutController.loadScoutCanvas) {
        window.scoutController.loadScoutCanvas('default');
      }
    }, 500); // Shorter delay for default canvas since it's local content
  <% end %>
});
</script> 

<!-- Document Storage Choice Modal -->
<div id="document-storage-modal" class="modal fade" tabindex="-1" role="dialog">
  <div class="modal-dialog modal-dialog-centered" role="document">
    <div class="modal-content">
      <div class="modal-header border-0">
        <h5 class="modal-title">How should I use this document?</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body px-4 py-3">
        <div class="storage-option mb-3 p-3 border rounded" style="cursor: pointer;" data-storage-type="short-term">
          <div class="form-check">
            <input class="form-check-input" type="radio" name="storageChoice" id="shortTermRadio" value="short-term">
            <label class="form-check-label w-100" for="shortTermRadio" style="cursor: pointer;">
              <div class="d-flex align-items-start">
                <div class="me-3 mt-1">
                  <i class="fas fa-clock fa-2x text-primary"></i>
                </div>
                <div>
                  <h6 class="mb-1">Just for this conversation</h6>
                  <small class="text-muted">Temporary access for current chat session only. Document will be removed when you close this conversation.</small>
                </div>
              </div>
            </label>
          </div>
        </div>

        <div class="storage-option p-3 border rounded" style="cursor: pointer;" data-storage-type="long-term">
          <div class="form-check">
            <input class="form-check-input" type="radio" name="storageChoice" id="longTermRadio" value="long-term">
            <label class="form-check-label w-100" for="longTermRadio" style="cursor: pointer;">
              <div class="d-flex align-items-start">
                <div class="me-3 mt-1">
                  <i class="fas fa-database fa-2x text-success"></i>
                </div>
                <div>
                  <h6 class="mb-1">Add to my knowledge base</h6>
                  <small class="text-muted">Permanent storage. I'll remember this document across all future conversations and can reference it anytime.</small>
                </div>
              </div>
            </label>
          </div>
        </div>
      </div>
      <div class="modal-footer border-0">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="button" class="btn btn-primary" id="confirm-storage-choice" disabled>Continue</button>
      </div>
    </div>
  </div>
</div>

<!-- Confirmation Dialog -->
<div id="confirmation-dialog" class="modal fade" tabindex="-1" role="dialog">
  <div class="modal-dialog" role="document">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">Confirmation Required</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body" id="confirmation-message">
        <!-- Dynamic content will be inserted here -->
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="button" class="btn btn-primary" id="confirmation-proceed">Proceed</button>
      </div>
    </div>
  </div>
</div> 