  // FRESH START (Clear context, keep memory)
  // ═══════════════════════════════════════════════════════════════
  
  freshStartBtn.addEventListener('click', function() {
    // Check if we're in agent DM mode via hub sidebar
    const hubSidebar = window.hubSidebarController;
    const isAgentDm = hubSidebar?.currentMode === 'agent_dm' && hubSidebar?.currentAgentId;
    
    if (isAgentDm) {
      // AGENT FRESH START: Clear agent DM thread, not Amos
      const agentName = hubSidebar.currentAgentName || 'this agent';
      if (!confirm(`Start fresh with ${agentName}? This will clear your current conversation with this agent.`)) {
        return;
      }
      
      console.log('🔄 Fresh start for agent:', hubSidebar.currentAgentId);
      
      // Clear streamedContent to prevent duplicates
      streamedContent.clear();
      
      // Call the fresh start method which clears chat and shows welcome message
      hubSidebar.freshStartAgentChat();
      return;
    }
    
    // AMOS FRESH START: Original behavior
    // Confirm with user
    if (!confirm('Start fresh? This will clear the current view but your memory and saved items are preserved.')) {
      return;
    }
    
    // Prevent history loading during fresh start (race condition prevention)
    historyState.freshStartPending = true;
    
    // Clear local storage canvas state
    localStorage.removeItem('scout_canvas_state');
    
    // Call fresh start endpoint (clears working context, NOT memory)
    fetch('/scout/fresh_start', { method: 'POST', headers: { 'X-CSRF-Token': csrfToken } })
      .then(response => response.json())
      .then(data => {
        console.log('Fresh start:', data);
        
        // CRITICAL: Update session ID in DOM and re-subscribe ActionCable
        if (data.session_id) {
          const newSessionId = data.session_id;
          console.log('🔄 Updating session to:', newSessionId);
          
          // Update the DOM attribute
          const workspace = document.querySelector('[data-scout-session-id]');
          if (workspace) {
            workspace.dataset.scoutSessionId = newSessionId;
            console.log('✅ Updated data-scout-session-id attribute');
          }
          
          // Re-initialize ScoutChannel with new session
          if (window.scoutChannelSubscription) {
            console.log('🔄 Cleaning up old ScoutChannel subscription');
            window.scoutChannelSubscription.unsubscribe();
          }
          
          if (typeof App !== 'undefined' && App.cable) {
            console.log('🔄 Creating new ScoutChannel subscription for:', newSessionId);
            window.scoutChannelSubscription = App.cable.subscriptions.create({
              channel: "ScoutChannel",
              session_id: newSessionId
            }, {
              connected() {
                console.log("✅ ScoutChannel: Reconnected for new session:", newSessionId);
              },
              disconnected() {
                console.log("❌ ScoutChannel: Disconnected");
              },
              received(data) {
                // Dispatch to the existing handler
                if (window.handleScoutChannelMessage) {
                  window.handleScoutChannelMessage(data);
                } else {
                  // Fallback: dispatch custom event
                  window.dispatchEvent(new CustomEvent('scout-channel-message', { detail: data }));
                }
              }
            });
          }
          
          // Notify QuestionQueueController of new session
          window.dispatchEvent(new CustomEvent('session-changed', { 
            detail: { sessionId: newSessionId } 
          }));
        }
        
        // Clear the chat messages visually
        chatMessages.innerHTML = '';
        streamedContent.clear();
        
        // Reset history pagination state so we don't reload old messages
        historyState.isLoading = false;
        historyState.hasMore = true; // Allow loading NEW messages going forward
        historyState.oldestId = null;
        historyState.freshStartPending = false; // Allow history loading again
        
        // Add a fresh start message
        addMessage("🔄 **Fresh Start!**\n\nI've cleared our active context. I still remember everything from our past conversations - just ask if you need to recall something!\n\nWhat would you like to work on?", 'assistant');
        
        // Show the quick action pills
        showQuickActions();
        
        // Drop the canvas — go to clean conversation mode
        if (window.scoutController) {
          window.scoutController.goToConversation();
        }
      })
      .catch(error => {
        console.error('Fresh start failed:', error);
        // Still clear visually even on error
        chatMessages.innerHTML = '';
        historyState.freshStartPending = false; // Reset flag on error
        addMessage("🔄 Starting fresh! What would you like to work on?", 'assistant');
        showQuickActions();
      });
  });
  
