      <div class="tool-call-details" id="${toolCallId}-details">
        <pre id="${toolCallId}-details-content">Initializing...</pre>
      </div>
    `;
    
    toolCallsList.appendChild(toolCallItem);
    return toolCallId;
  }
  
  function updateToolCall(toolCallId, status, message, details) {
    const toolCall = toolCalls.get(toolCallId);
    if (!toolCall) return;
    
    toolCall.status = status;
    if (message) toolCall.message = message;
    if (details) toolCall.details.push(details);
    
    // Update UI
    const icon = document.getElementById(`${toolCallId}-icon`);
    const statusEl = document.getElementById(`${toolCallId}-status`);
    const detailsContent = document.getElementById(`${toolCallId}-details-content`);
    
    if (icon) {
      icon.className = `tool-call-icon ${status}`;
      switch(status) {
        case 'running':
          icon.innerHTML = '<i class="fas fa-sync-alt"></i>';
          break;
        case 'success':
          icon.innerHTML = '<i class="fas fa-check"></i>';
          break;
        case 'error':
          icon.innerHTML = '<i class="fas fa-times"></i>';
          break;
        default:
          icon.innerHTML = '<i class="fas fa-clock"></i>';
      }
    }
    
    if (statusEl && message) {
      statusEl.textContent = message;
    }
    
    if (detailsContent && toolCall.details.length > 0) {
      detailsContent.textContent = toolCall.details.join('\n');
    }
  }
  
  function toggleToolCallDetails(toolCallId) {
    const details = document.getElementById(`${toolCallId}-details`);
    const toggle = document.getElementById(`${toolCallId}-toggle`);
    
    if (details && toggle) {
      details.classList.toggle('show');
      toggle.classList.toggle('expanded');
    }
  }
  
  window.toggleToolCallDetails = toggleToolCallDetails; // Make it globally accessible
  
