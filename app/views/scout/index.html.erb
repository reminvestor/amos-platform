<div id="workspace" class="workspace conversation-mode <%= 'collab-sidebar-mode' if @show_collab_sidebar %> <%= 'personal-mode' if @in_personal_mode %> <%= "#{@current_space&.slug}-space" %>" data-controller="scout" data-scout-session-id="<%= @session_id %>" data-scout-user-id="<%= current_user.id %>" data-show-collab-sidebar="<%= @show_collab_sidebar %>" data-current-space="<%= @current_space&.slug || 'operations' %>">
  <% if @current_space&.slug == 'design' %>
    <%# Design Mode: Use the same hub sidebar as Operations %>
    <%# The landing_page_editor canvas has its own component panel inside the iframe %>
    <%= render 'scout/hub_sidebar' %>
  <% elsif @show_collab_sidebar %>
    <%# Operations: Show Collaboration Sidebar (Slack-like) %>
    <%# Sidebar collapses to slim icon-only mode, click collapse button again to expand %>
    <%= render 'scout/hub_sidebar' %>
  <% elsif @in_personal_mode %>
    <%# Personal Mode: No sidebar at all - just chat + canvas %>
    <!-- No sidebar in Personal mode - just you and Amos -->
  <% else %>
    <!-- Fallback: Collapsed Side Navigation -->
    <button class="mobile-menu-btn" data-action="click->scout#toggleSideNav" aria-label="Open menu">
      <i data-lucide="menu" aria-hidden="true"></i>
    </button>
    <%= render 'scout/sidebar' %>
  <% end %>

  <!-- Main Content Area -->
  <main class="main-content">
    <!-- Chat Area (Full screen in conversation mode, sidebar in work mode) -->
    <section class="chat-area" data-scout-target="chatArea">
      <div class="chat-header">
        <div class="chat-header-content">
          <% if @show_collab_sidebar || @current_space&.slug == 'design' %>
            <%# Operations: Show conversation context with sidebar %>
            <div class="hub-chat-context" data-hub-sidebar-target="chatContext" data-avatar-type="amos">
              <div class="hub-chat-avatar" data-hub-sidebar-target="chatAvatar">
                <%= image_tag 'Logo_pfp_2.png', class: 'avatar-icon amos-avatar-img', alt: 'Amos', style: 'width: 100%; height: 100%; object-fit: cover; border-radius: 8px;' %>
                <i data-lucide="sparkles" class="avatar-icon avatar-icon-fallback" style="display: none;"></i>
                <span class="avatar-initials" style="display: none;"></span>
              </div>
              <div class="hub-chat-info">
                <h2 class="chat-header-title" data-hub-sidebar-target="chatTitle">AMOS</h2>
                <span class="hub-chat-subtitle" data-hub-sidebar-target="chatSubtitle">Business Assistant</span>
              </div>
            </div>
            
            <%# Space Switcher removed - users now stay in Operations mode with loadouts %>
          <% else %>
            <%# Fallback mode %>
            <h2 class="chat-header-title">AMOS</h2>
          <% end %>

          <div class="chat-header-actions">
            <%# Canvas Toggle Button - switches between close (X) and home based on mode %>
            <button class="header-icon-btn canvas-toggle-btn home-mode" 
                    id="canvas-toggle-btn"
                    data-scout-target="canvasToggleBtn"
                    data-action="click->scout#toggleCanvasMode" 
                    title="Dashboard"
                    aria-label="Toggle canvas">
              <i data-lucide="layout-dashboard" class="toggle-icon-home" aria-hidden="true"></i>
              <i data-lucide="x" class="toggle-icon-close" aria-hidden="true" style="display: none;"></i>
            </button>

            <div class="header-divider"></div>

            <button class="header-icon-btn" id="fresh-start-btn" title="Fresh Start - clear context but keep memory" aria-label="Start fresh">
              <i data-lucide="rotate-ccw" aria-hidden="true"></i>
            </button>

            <button class="header-icon-btn" id="bookmarks-btn" title="Saved Items" aria-label="View saved items">
              <i data-lucide="bookmark" aria-hidden="true"></i>
            </button>

            <button class="header-icon-btn text-muted" id="tts-toggle-btn" title="Voice Mode OFF (click to turn on)" aria-label="Toggle voice output">
              <i data-lucide="volume-x" aria-hidden="true"></i>
            </button>
            <%# Ellipsis menu removed - Advanced Mode moved to user dropdown in sidebar %>

            <!-- Bookmarks dropdown panel -->
            <div class="bookmarks-dropdown d-none" id="bookmarks-dropdown">
              <div class="dropdown-header d-flex justify-content-between align-items-center">
                <h4 class="mb-0">📌 Saved Items</h4>
                <button class="btn btn-sm btn-link text-muted p-0" id="close-bookmarks-btn">
                  <i data-lucide="x" style="width: 16px; height: 16px;"></i>
                </button>
              </div>
              <div class="bookmarks-list" id="bookmarks-list">
                <div class="text-center text-muted py-3">
                  <i data-lucide="loader" class="spin" style="width: 20px; height: 20px;"></i>
                  <p class="small mt-2 mb-0">Loading saved items...</p>
                </div>
              </div>
              <div class="dropdown-footer text-center py-2 border-top">
                <small class="text-muted">Ask Amos to "save this" or "bookmark this" to add items</small>
              </div>
            </div>
          </div>
        </div>
      </div>
      
      <div class="chat-messages" id="chat-messages" data-scout-target="chatMessages">
        <!-- Messages will be loaded here from history -->
      </div>
      
      <!-- Tool activity panel removed - now part of task progress canvas -->
      
      <!-- Quick action suggestions — shown only on fresh start / empty welcome -->
      <div id="quick-actions" class="quick-actions-bar" style="display:none;">
        <button class="qa-pill" data-prompt="Create a landing page for my business">
          <i data-lucide="file-text"></i> Landing Page
        </button>
        <button class="qa-pill" data-prompt="Create an email drip campaign sequence">
          <i data-lucide="mail"></i> Email Sequence
        </button>
        <button class="qa-pill" data-prompt="I need deep research on a topic">
          <i data-lucide="search"></i> Deep Research
        </button>
        <button class="qa-pill" data-prompt="Help me connect an external app integration">
          <i data-lucide="plug"></i> Connect an App
        </button>
        <button class="qa-pill" data-prompt="Build me a custom app module">
          <i data-lucide="boxes"></i> Build an App
        </button>
        <button class="qa-pill" data-prompt="" data-focus-input="true">
          <i data-lucide="message-circle"></i> Just Ask
        </button>
      </div>

      <div class="chat-input-area" data-controller="voice-assistant">
        <form id="message-form" data-scout-target="chatForm" enctype="multipart/form-data">
          <%= hidden_field_tag :authenticity_token, form_authenticity_token %>
          <div class="attached-files d-none" id="attached-files">
            <!-- Attached files will be shown here -->
          </div>

          <!-- Model Selector with Brain Icon -->
          <div class="model-selector-container">
            <div class="model-selector-trigger">
              <button type="button" id="model-selector-btn" class="model-brain-btn" title="Model Selection" aria-label="Select AI model">
                <div class="brain-icon-wrapper">
                  <i data-lucide="brain" class="brain-outline"></i>
                  <div class="brain-fill">
                    <i data-lucide="brain" class="brain-filled"></i>
                  </div>
                </div>
                <div class="power-dots">
                  <div class="power-dot"></div>
                  <div class="power-dot"></div>
                </div>
              </button>

              <!-- Model Selector Popover -->
              <div id="model-selector-popover" class="model-popover d-none">
                <div class="model-popover-content">
                  <div class="model-header">
                    <div class="model-header-icon">
                      <div class="brain-icon-wrapper">
                        <i data-lucide="brain" class="brain-outline-lg"></i>
                        <div class="brain-fill-lg">
                          <i data-lucide="brain" class="brain-filled-lg"></i>
                        </div>
                      </div>
                    </div>
                    <div class="model-header-text">
                      <h3>Model Selection</h3>
                      <p id="current-model-name">Auto (Recommended)</p>
                    </div>
                  </div>

                  <!-- Simple Mode Slider (Default) - Thinking Depth -->
                  <div class="model-mode-slider mb-4" id="model-mode-section">
                    <label class="admin-label text-xs uppercase text-muted mb-2 d-block" style="font-size: 0.75rem; letter-spacing: 0.05em;">Thinking Depth</label>
                    <div class="mode-slider-container">
                      <input type="range" min="0" max="3" value="0" class="mode-slider" id="model-mode-slider">
                      <div class="mode-labels">
                        <span class="mode-label" data-mode="auto">
                          <i data-lucide="sparkles" style="width: 14px; height: 14px;"></i>
                          Auto
                        </span>
                        <span class="mode-label" data-mode="light">
                          <i data-lucide="zap" style="width: 14px; height: 14px;"></i>
                          Light
                        </span>
                        <span class="mode-label" data-mode="medium">
                          <i data-lucide="scale" style="width: 14px; height: 14px;"></i>
                          Medium
                        </span>
                        <span class="mode-label" data-mode="deep">
                          <i data-lucide="brain" style="width: 14px; height: 14px;"></i>
                          Deep
                        </span>
                      </div>
                    </div>
                    <p class="mode-description text-muted small mt-2" id="mode-description">
                      <strong>Auto:</strong> Intelligently adjusts thinking depth based on your request.
                    </p>
                  </div>

                  <!-- Advanced Model Selection - Premium Claude Models -->
                  <div class="advanced-model-section mt-3 pt-3" style="border-top: 1px solid var(--bs-border-color);">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                      <label class="admin-label text-xs uppercase text-muted d-block" style="font-size: 0.75rem; letter-spacing: 0.05em;">
                        <i data-lucide="crown" style="width: 12px; height: 12px; margin-right: 4px;"></i>
                        Premium Models
                      </label>
                      <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" id="premium-mode-toggle" role="switch">
                        <label class="form-check-label small text-muted" for="premium-mode-toggle">Enable</label>
                      </div>
                    </div>
                    
                    <!-- Premium Model Selection (hidden by default) -->
                    <div id="premium-models-section" class="d-none">
                      <div class="premium-info-banner mb-2 p-2 rounded" style="background: linear-gradient(135deg, rgba(139, 92, 246, 0.1), rgba(59, 130, 246, 0.1)); border: 1px solid rgba(139, 92, 246, 0.2);">
                        <p class="mb-0 small" style="color: var(--bs-body-color);">
                          <i data-lucide="zap" style="width: 12px; height: 12px; margin-right: 4px; color: #8b5cf6;"></i>
                          <strong>Claude models</strong> deliver exceptional quality. Usage billed at cost + 20%.
                        </p>
                      </div>
                      
                      <select id="premium-model-select" class="form-select form-select-sm" style="font-size: 0.875rem;">
                        <optgroup label="Claude Latest">
                          <option value="claude-opus-4-6" data-desc="Latest frontier model - enhanced reasoning, coding, and vision" data-cost="high">Claude Opus 4.6 👑</option>
                        </optgroup>
                        <optgroup label="Claude 4.5 Series">
                          <option value="claude-sonnet-4-5" data-desc="Best for everyday tasks - fast, accurate, and cost-effective" data-cost="medium">Claude Sonnet 4.5 ⭐</option>
                          <option value="claude-haiku-4-5" data-desc="Ultra-fast for quick responses - most budget-friendly premium" data-cost="low">Claude Haiku 4.5</option>
                          <option value="claude-opus-4-5" data-desc="Maximum intelligence for complex reasoning and coding" data-cost="high">Claude Opus 4.5</option>
                        </optgroup>
                        <optgroup label="Claude 3.5 Series">
                          <option value="claude-3-5-sonnet" data-desc="Reliable all-rounder for writing, research, and analysis" data-cost="medium">Claude 3.5 Sonnet</option>
                          <option value="claude-3-5-haiku" data-desc="Fast responses for simple questions and basic tasks" data-cost="low">Claude 3.5 Haiku</option>
                        </optgroup>
                      </select>
                      <p class="premium-model-desc text-muted small mt-1" id="premium-model-desc">
                        Best for everyday tasks - fast, accurate, and cost-effective
                      </p>
                    </div>
                    
                    <!-- Open Source Default Info -->
                    <div id="opensource-info" class="text-muted small">
                      <p class="mb-0">
                        <i data-lucide="cpu" style="width: 12px; height: 12px; margin-right: 4px;"></i>
                        Default: Open-source models (Qwen, DeepSeek) - included free with your plan
                      </p>
                    </div>
                  </div>
                </div>
              </div>
            </div>

          </div>

          <!-- Input Container - Stacked layout -->
          <div class="input-container">
            <input type="file"
              id="file-input"
              multiple
              accept="image/*,.pdf,.doc,.docx,.txt,.csv"
              class="d-none"
              data-scout-target="fileInput">

            <!-- Textarea on top -->
            <textarea
              class="chat-input"
              id="message-input"
              placeholder="Type your message..."
              data-scout-target="chatInput"
              autocomplete="off"
              rows="2"
              aria-label="Message input"
            ></textarea>

            <!-- Buttons row below -->
            <div class="input-buttons-row">
              <button type="button" class="attach-btn" id="attach-button" title="Attach files" aria-label="Attach files">
                <i data-lucide="paperclip" aria-hidden="true"></i>
              </button>
              
              <% if @in_team_space %>
                <button type="button" class="emoji-btn" id="emoji-button" title="Add emoji" aria-label="Add emoji">
                  <i data-lucide="smile" aria-hidden="true"></i>
                </button>
                
                <button type="button" class="gif-btn" id="gif-button" title="Add GIF" aria-label="Add GIF">
                  <i data-lucide="image" aria-hidden="true"></i>
                </button>
              <% end %>

              <button type="button"
                      class="voice-btn"
                      data-action="click->voice-assistant#toggleVoice"
                      data-voice-assistant-target="button"
                      title="Voice input"
                      aria-label="Start voice input">
                <i data-lucide="mic" aria-hidden="true"></i>
              </button>

              <button type="submit" class="send-btn" id="send-button" aria-label="Send message">
                <i data-lucide="send" aria-hidden="true"></i>
              </button>
              
              <!-- Stop button - appears when Amos is streaming -->
              <button type="button" class="stop-btn d-none" id="stop-button" aria-label="Stop response" title="Stop Amos">
                <i data-lucide="square" aria-hidden="true"></i>
              </button>
            </div>
          </div>
        </form>
        <div data-voice-assistant-target="status" class="voice-status"></div>
        
        <% if @in_team_space %>
        <!-- Emoji Picker Popover (Team Space Only) -->
        <div id="emoji-picker-popover" class="emoji-picker-popover d-none">
          <div class="emoji-picker-header">
            <span class="emoji-picker-title">Pick an emoji</span>
            <button type="button" class="emoji-picker-close" onclick="closeEmojiPicker()">×</button>
          </div>
          <div class="emoji-picker-search">
            <input type="text" placeholder="Search emojis..." id="emoji-search-input" oninput="filterEmojis(this.value)">
          </div>
          <div class="emoji-picker-content" id="emoji-picker-content">
            <!-- Emoji categories -->
            <div class="emoji-category">
              <div class="emoji-category-title">Smileys & Emotion</div>
              <div class="emoji-grid">
                <button class="emoji-item" onclick="insertEmoji('😀')">😀</button>
                <button class="emoji-item" onclick="insertEmoji('😃')">😃</button>
