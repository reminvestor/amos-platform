  // Update voice transcription display
  function updateVoiceTranscription(text, isFinal) {
    const transcriptionText = document.querySelector('.voice-transcription-text');
    const transcriptionContainer = document.querySelector('.voice-transcription');
    if (!transcriptionText) return;
    
    if (!text || text.trim() === '') {
      transcriptionText.textContent = 'Listening...';
      transcriptionText.classList.remove('active');
      // Add listening pulse animation
      if (transcriptionContainer) {
        transcriptionContainer.classList.add('listening');
      }
    } else {
      // Remove listening pulse when we have text
      if (transcriptionContainer) {
        transcriptionContainer.classList.remove('listening');
      }
      
      transcriptionText.textContent = `"${text}"`;
      if (isFinal) {
        transcriptionText.classList.add('active');
        // Remove active state after a moment
        setTimeout(() => {
          transcriptionText.classList.remove('active');
          transcriptionText.textContent = 'Listening...';
          if (transcriptionContainer) {
            transcriptionContainer.classList.add('listening');
          }
        }, 2000);
      } else {
        transcriptionText.classList.add('active');
      }
    }
  }
  
