  function getModelFromPower(power) {
    if (power <= 25) return MODEL_MAP[0];
    if (power <= 75) return MODEL_MAP[50];
    return MODEL_MAP[100];
  }

  // Update brain fill based on power
  function updateBrainFill(power) {
    const fillPercent = 100 - power; // Invert for clip-path
    const brainFills = document.querySelectorAll('.brain-fill, .brain-fill-lg');
    brainFills.forEach(fill => {
      fill.style.clipPath = `inset(${fillPercent}% 0 0 0)`;
    });

    // Update power dots
    const dots = document.querySelectorAll('.power-dot');
    dots[0].classList.toggle('active', power >= 33);
    dots[1].classList.toggle('active', power >= 66);
  }

  // Load saved model power or default to 50%
  let currentPower = parseInt(localStorage.getItem('scout_model_power') || '50');
  updateBrainFill(currentPower);
  if (modelSlider) modelSlider.value = currentPower;
  if (powerPercent) powerPercent.textContent = `${currentPower}%`;

  // Update model select and name
  const currentModel = getModelFromPower(currentPower);
  if (modelSelect) modelSelect.value = currentModel.model;
  if (currentModelName) currentModelName.textContent = currentModel.name;

  // Toggle popover
  if (modelSelectorBtn) {
    modelSelectorBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      const isOpen = modelPopover.style.display === 'block';
      modelPopover.style.display = isOpen ? 'none' : 'block';

      // Re-initialize Lucide icons in popover
      if (!isOpen && typeof lucide !== 'undefined') {
