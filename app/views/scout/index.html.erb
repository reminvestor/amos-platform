    try {
      // Intelligent routing: check if message suggests interactive workflow
      if (shouldUseInteractiveMode(message)) {
        console.log('🎯 Using interactive mode for:', message);
        await handleInteractiveChat(message);
      } else {
        console.log('⚡ Using streaming mode for:', message);
        await handleStreamingChat(message);
      }
