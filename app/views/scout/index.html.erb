  // Tool call tracking
  const toolCalls = new Map();
  let toolActivityPanel = null;
  
  function addToolCall(toolName, message) {
    const toolCallId = `tool-${Date.now()}-${Math.random().toString(36).substr(2, 9)}`;
    const toolCall = {
      id: toolCallId,
      name: toolName,
