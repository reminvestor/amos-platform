      if (content) {
        streamedContent.add(content);
      }
    });
    console.log(`📝 Initialized streamedContent with ${streamedContent.size} existing messages`);
  }
  
  // Initialize after DOM is ready
  setTimeout(initializeStreamedContent, 100);
  const newConversationBtn = document.getElementById('new-conversation-btn');

  // Auto-focus on input (with defensive check)
  if (messageInput && messageInput.focus) {
    messageInput.focus();
  }

  // Track message count
  let messageCount = 0;
  
  // Get CSRF token
  const csrfToken = document.querySelector('meta[name="csrf-token"]')?.content;
  
  // Update message count display
  function updateMessageCount() {
    const messages = chatMessages.querySelectorAll('.message:not(.welcome-message)');
    messageCount = messages.length;
    // Message count element removed, just track the count
  }
  
  // Toggle conversation dropdown
  conversationSelector.addEventListener('click', function(e) {
    e.stopPropagation();
    conversationDropdown.style.display = conversationDropdown.style.display === 'none' ? 'block' : 'none';
    loadRecentConversations();
  });
  
  // Close dropdown when clicking outside
  document.addEventListener('click', function(e) {
    if (!conversationDropdown.contains(e.target) && e.target !== conversationSelector) {
      conversationDropdown.style.display = 'none';
    }
  });
  
  // Load recent conversations
  async function loadRecentConversations() {
    try {
      const response = await fetch('/scout/conversations');
      const conversations = await response.json();
      
      conversationList.innerHTML = conversations.map(conv => `
        <div class="conversation-item" data-session-id="${conv.session_id}">
          <div class="conversation-item-title">${conv.first_message || 'Untitled Conversation'}</div>
          <div class="conversation-item-meta">
            <span>${conv.message_count} messages</span>
            <span>${formatTimeAgo(conv.created_at)}</span>
          </div>
        </div>
      `).join('');
      
      // Add click handlers
      conversationList.querySelectorAll('.conversation-item').forEach(item => {
        item.addEventListener('click', function() {
          const sessionId = this.dataset.sessionId;
          loadConversation(sessionId);
          conversationDropdown.style.display = 'none';
        });
      });
    } catch (error) {
      console.error('Failed to load conversations:', error);
    }
  }
  
  // Load a specific conversation
  async function loadConversation(sessionId) {
    // Clear current messages
    chatMessages.innerHTML = '';
    
    // Load messages for this session
    try {
      const response = await fetch(`/scout/conversation/${sessionId}`);
      const messages = await response.json();
      
      messages.forEach(msg => {
        addMessage(msg.content, msg.role === 'user' ? 'user' : 'assistant', msg.created_at);
      });
      
      updateMessageCount();
    } catch (error) {
      console.error('Failed to load conversation:', error);
    }
  }
  
  // Start new conversation
  newConversationBtn.addEventListener('click', function() {
    // Clear any saved canvas state
    localStorage.removeItem('scout_canvas_state');
    
    // Reset session and reload page
    fetch('/scout/new_session', { method: 'POST', headers: { 'X-CSRF-Token': csrfToken } })
      .then(response => response.json())
      .then(data => {
        console.log('New session started:', data.session_id);
        // Reload the page to get fresh session context
        window.location.reload();
      })
      .catch(error => {
        console.error('Failed to start new session:', error);
        // Clear canvas state even on error
        localStorage.removeItem('scout_canvas_state');
        // Fallback: just reload anyway
        window.location.reload();
      });
  });
  
  // Format time ago
  function formatTimeAgo(dateString) {
    const date = new Date(dateString);
    const now = new Date();
    const seconds = Math.floor((now - date) / 1000);
    
    if (seconds < 60) return 'just now';
    if (seconds < 3600) return `${Math.floor(seconds / 60)}m ago`;
    if (seconds < 86400) return `${Math.floor(seconds / 3600)}h ago`;
    if (seconds < 604800) return `${Math.floor(seconds / 86400)}d ago`;
    return date.toLocaleDateString();
  }
  
  // Get Scout controller reference - wait for Stimulus to initialize
  function getScoutController() {
    const element = document.querySelector('[data-controller="scout"]');
    if (element && window.Stimulus) {
