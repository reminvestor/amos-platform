      updateBrainFill(power);
      powerPercent.textContent = `${power}%`;

      // Update model
      const model = getModelFromPower(power);
      currentModelName.textContent = model.name;
      if (modelSelect) modelSelect.value = model.model;

      // Update active preset
      presetBtns.forEach(btn => {
        const presetPower = parseInt(btn.dataset.power);
        const isActive = Math.abs(power - presetPower) < 26;
