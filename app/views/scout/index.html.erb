  // Simple markdown parser for messages
  function parseSimpleMarkdown(text) {
    console.log('📝 Parsing markdown:', text);
    
    // Check for rich HTML content (Bootstrap components, tables, complex layouts)
    // This indicates AMOS outputted HTML directly instead of using create_freeform_canvas
    const richHtmlPatterns = [
      /<div[^>]*class\s*=\s*['"][^'"]*(?:container|card|row|col-|alert|mb-|mt-|py-|px-)[^'"]*['"][^>]*>/i,
      /<table[^>]*>/i,
      /<(section|article|header|footer|nav|main|aside)[^>]*>/i,
      /class\s*=\s*['"][^'"]*(?:btn|badge|form-|input-|d-flex|justify-|align-)[^'"]*['"][^>]*>/i,
    ];
    
    const isRichHtml = richHtmlPatterns.some(pattern => pattern.test(text));
    
    if (isRichHtml) {
      // AMOS outputted complex HTML - extract text content and add note
      console.log('⚠️ Detected rich HTML in message, extracting text content');
      const div = document.createElement('div');
      div.innerHTML = text;
      
      // Extract meaningful text content
      let textContent = div.textContent || div.innerText || '';
      textContent = textContent.replace(/\s+/g, ' ').trim();
      
      // If we got meaningful text, use it; otherwise show a fallback
      if (textContent.length > 20) {
        // Truncate if too long and add note
        const displayText = textContent.length > 500 
          ? textContent.substring(0, 500) + '...'
          : textContent;
        return `<p>${displayText}</p><p class="text-muted small"><em>📊 Rich content detected - I should display this in a canvas for better formatting.</em></p>`;
      } else {
        return '<p><em>📊 I\'ve prepared some data for you. Let me display it properly...</em></p>';
      }
    }
    
    // Check if the text contains simple HTML formatting tags
    const hasSimpleHtmlTags = /<(strong|em|b|i|ul|ol|li|h[1-6]|p|br|a|span|div)[\s>]/i.test(text);
    
    if (hasSimpleHtmlTags) {
      // Text has HTML - sanitize it but preserve safe formatting tags
      const div = document.createElement('div');
      div.innerHTML = text;
      
      // Extended list of allowed tags for chat display
      const allowedTags = ['strong', 'em', 'b', 'i', 'ul', 'ol', 'li', 'h1', 'h2', 'h3', 'h4', 'h5', 'h6', 'br', 'p', 'a', 'span', 'code', 'pre'];
      const elements = div.querySelectorAll('*');
      elements.forEach(el => {
        const tagName = el.tagName.toLowerCase();
        if (!allowedTags.includes(tagName)) {
          // Replace complex tags with their text content
          el.replaceWith(document.createTextNode(el.textContent));
        } else {
          // Remove potentially dangerous attributes from allowed tags
          const allowedAttrs = ['href', 'target', 'rel'];
          Array.from(el.attributes).forEach(attr => {
            if (!allowedAttrs.includes(attr.name)) {
              el.removeAttribute(attr.name);
            }
          });
          // Add safe attributes for links
          if (tagName === 'a' && el.hasAttribute('href')) {
            el.setAttribute('target', '_blank');
            el.setAttribute('rel', 'noopener noreferrer');
          }
        }
      });
      
      // Convert newlines to <br> outside of tags
      let html = div.innerHTML;
      html = html.replace(/\n/g, '<br>');
      
      console.log('📝 Parsed HTML (with existing tags):', html);
      return html;
    } else {
      // No HTML tags, treat as markdown
      // Escape HTML first for security
      const div = document.createElement('div');
      div.textContent = text;
      let html = div.innerHTML;
      
      // Convert markdown images ![alt](url) to <img> tags
      // Do this FIRST before any other processing
      const imageMatches = html.match(/!\[([^\]]*)\]\(([^)]+)\)/g);
      if (imageMatches) {
        console.log('🖼️ Found markdown images:', imageMatches);
      }
      
      html = html.replace(/!\[([^\]]*)\]\(([^)]+)\)/g, (match, alt, url) => {
        console.log('🖼️ Converting image markdown:', { match, alt, url });
        // Check if it's a GIF
        const isGif = url.toLowerCase().includes('.gif');
        if (isGif) {
          const replacement = `<div class="message-gif" style="max-width: 400px; border-radius: 0.5rem; overflow: hidden; margin: 0.5rem 0;">
                    <img src="${url}" alt="${alt}" style="width: 100%; display: block; border-radius: 0.5rem;">
                  </div>`;
          console.log('🖼️ Replaced with GIF div');
          return replacement;
        } else {
          return `<img src="${url}" alt="${alt}" style="max-width: 100%; border-radius: 0.5rem; margin: 0.5rem 0;">`;
        }
      });
      
      // Convert markdown bold **text** to <strong>
      html = html.replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>');
      
      // Convert markdown headers
      html = html.replace(/^### (.+)$/gm, '<h3>$1</h3>');
      html = html.replace(/^## (.+)$/gm, '<h2>$1</h2>');
      
      // Convert markdown lists (simple version)
      html = html.replace(/^- (.+)$/gm, '<li>$1</li>');
      html = html.replace(/(<li>.*<\/li>\s*)+/g, '<ul>$&</ul>');
      
      // Convert newlines to <br>
      html = html.replace(/\n/g, '<br>');
      
      console.log('📝 Parsed markdown:', html);
      return html;
    }
  }

  // Build a tool message element
  function buildToolMessageElement({ id, content, metadata }) {
    const toolMessage = document.createElement('div');
    toolMessage.className = 'message tool-message';
    if (id) toolMessage.dataset.messageId = id;
    
    const toolName = metadata.tool_name || content.replace('tool:', '');
    const displayName = getToolDisplayName(toolName);
    const hasDetails = metadata && (metadata.tool_id || metadata.arguments || metadata.result);
    const collapseId = `tool-details-${Date.now()}-${Math.random().toString(36).slice(2,7)}`;
    
    toolMessage.innerHTML = `
      <div class="message-content">
        <div class="message-bubble">
          <div class="tool-bubble d-flex align-items-center">
            <span class="tool-name">Utilizing ${displayName} tool</span>
            ${hasDetails ? `
              <button class="btn btn-link btn-sm p-0 ms-2 align-baseline text-white-50" type="button" 
                      data-bs-toggle="collapse" data-bs-target="#${collapseId}" aria-expanded="false" aria-controls="${collapseId}"
                      title="Show details">
                <i data-lucide="chevron-down"></i>
              </button>
            ` : ''}
          </div>
          ${hasDetails ? `
            <div id="${collapseId}" class="collapse mt-2">
              <pre class="mt-2 mb-0 pre-wrapped">${escapeForPre(JSON.stringify(metadata, null, 2))}</pre>
            </div>
          ` : ''}
        </div>
      </div>
    `;
    
    return toolMessage;
  }

  // Build a message DOM element (optionally tagged with DB id)
  function buildMessageElement({ id = null, content, role, timestamp = null, metadata = null }) {
    // Check if this is a tool message
    if (metadata && metadata.type === 'tool_call') {
      return buildToolMessageElement({ id, content, metadata });
    }
    
    // Also check if content indicates a tool message (for backward compatibility)
    if (role === 'assistant' && typeof content === 'string' && content.startsWith('tool:')) {
      const toolName = content.replace('tool:', '');
      return buildToolMessageElement({ 
        id, 
        content, 
        metadata: { tool_name: toolName, type: 'tool_call' } 
      });
    }
    
    const wrapper = document.createElement('div');
    wrapper.className = `message ${role === 'user' ? 'user-message' : 'ai-message'}`;
    if (id) wrapper.dataset.messageId = id;

    // Parse markdown for both user and assistant messages
    let processedContent = content;
    
    if (role === 'assistant') {
      // If content is a JSON string, parse it first
      if (typeof processedContent === 'string' && processedContent.trim().startsWith('{')) {
        try {
          const parsed = JSON.parse(processedContent);
          processedContent = parsed.message || processedContent;
        } catch (e) {
          // Not valid JSON, use as-is
        }
      }
      
      // Decode HTML entities first (convert &lt; back to <)
      const textarea = document.createElement('textarea');
      textarea.innerHTML = processedContent;
      processedContent = textarea.value;
      
      // Now parse as markdown
      processedContent = parseSimpleMarkdown(processedContent);
    } else {
      // User messages: Check for markdown images (GIFs), then convert newlines
      console.log('👤 Processing user message:', processedContent.substring(0, 100));
      
      if (processedContent.includes('![') && processedContent.includes('](')) {
        console.log('🖼️ User message contains markdown image, parsing...');
        // Escape HTML first for security but keep markdown
        const div = document.createElement('div');
        div.textContent = processedContent;
        let escaped = div.innerHTML;
        
        // Convert markdown images ![alt](url) to <img> tags
        escaped = escaped.replace(/!\[([^\]]*)\]\(([^)]+)\)/g, (match, alt, url) => {
          console.log('🖼️ Found image in user message:', { alt, url });
          const isGif = url.toLowerCase().includes('.gif');
          if (isGif) {
            return `<div class="message-gif" style="max-width: 400px; border-radius: 0.5rem; overflow: hidden; margin: 0.5rem 0;">
                      <img src="${url}" alt="${alt}" style="width: 100%; display: block; border-radius: 0.5rem;">
                    </div>`;
          } else {
            return `<img src="${url}" alt="${alt}" style="max-width: 100%; border-radius: 0.5rem; margin: 0.5rem 0;">`;
          }
        });
        
        processedContent = escaped;
        console.log('🖼️ Processed user message with image:', processedContent.substring(0, 100));
      } else {
        // Just convert newlines
      processedContent = content.replace(/\n/g, '<br>');
      }
    }
    
    const avatar = role === 'assistant'
      ? '<i data-lucide="bot"></i>'
      : '<i data-lucide="user"></i>';

    // Generate unique ID for feedback
    const feedbackId = id || `msg-${Date.now()}-${Math.random().toString(36).substr(2, 9)}`;
    
    // Get session ID from workspace element
    const currentSessionId = document.getElementById('workspace')?.dataset?.scoutSessionId || '';
    
    // Feedback buttons for assistant messages
    const feedbackHtml = role === 'assistant' ? `
      <div class="message-feedback d-flex align-items-center gap-2 mt-2 pt-2 border-top border-secondary-subtle"
           data-controller="feedback"
           data-feedback-feedbackable-type-value="ScoutMessage"
           data-feedback-feedbackable-id-value="${feedbackId}"
           data-feedback-session-id-value="${currentSessionId}"
           data-feedback-submitted-value="false">
        <span class="text-muted small">Was this helpful?</span>
        <div class="btn-group btn-group-sm" role="group">
          <button type="button" class="btn btn-sm btn-outline-success feedback-btn"
                  data-action="click->feedback#submit"
                  data-feedback-rating-param="1"
                  title="Helpful">
            <i class="bi bi-hand-thumbs-up"></i>
          </button>
          <button type="button" class="btn btn-sm btn-outline-danger feedback-btn"
                  data-action="click->feedback#submit"
                  data-feedback-rating-param="-1"
                  title="Not helpful">
            <i class="bi bi-hand-thumbs-down"></i>
          </button>
        </div>
        <div class="feedback-success d-none text-success small">
          <i class="bi bi-check-circle me-1"></i>
          <span class="feedback-message">Thanks!</span>
        </div>
      </div>
    ` : '';
    
    wrapper.innerHTML = `
      <div class="message-content">
        <div class="message-avatar">
          ${avatar}
        </div>
        <div class="message-bubble">
          ${processedContent}
          ${feedbackHtml}
        </div>
      </div>
    `;
    return wrapper;
  }

  // Local escape helper for history rendering
  function escapeForPre(text) {
    return (text || '').replace(/</g, '&lt;').replace(/>/g, '&gt;');
  }

  function appendMessage(content, role, timestamp = null, id = null, metadata = null) {
    const el = buildMessageElement({ id, content, role, timestamp, metadata });
    chatMessages.appendChild(el);

    // Initialize Lucide icons for newly added message
    if (typeof lucide !== 'undefined') {
      lucide.createIcons();
    }

    scrollToBottom();
  }

  function prependMessages(list) {
    // Preserve scroll position when prepending
    const prevScrollHeight = chatMessages.scrollHeight;
    const fragment = document.createDocumentFragment();
    list.forEach(msg => fragment.appendChild(buildMessageElement(msg)));
    chatMessages.insertBefore(fragment, chatMessages.firstChild);
    const newScrollHeight = chatMessages.scrollHeight;
    chatMessages.scrollTop = newScrollHeight - prevScrollHeight + chatMessages.scrollTop;

    // Initialize Lucide icons for prepended messages
    if (typeof lucide !== 'undefined') {
      lucide.createIcons();
    }
  }

  // Backward-compatible helper
  function addMessage(content, role, timestamp = null) {
    console.log('🎯 addMessage called with:', { content: content, role: role, contentType: typeof content });
    
    // If content is a JSON object, extract the message
    let messageContent = content;
    if (typeof content === 'object' && content.message) {
      console.log('📦 Content is object with message property');
      messageContent = content.message;
    } else if (typeof content === 'string' && content.trim().startsWith('{')) {
      console.log('📦 Content is JSON string, attempting to parse');
      try {
        const parsed = JSON.parse(content);
        messageContent = parsed.message || content;
        console.log('✅ Parsed message:', messageContent);
      } catch (e) {
        console.log('❌ Failed to parse JSON string');
      }
    }
    
    // Don't add empty messages
    if (!messageContent || messageContent.toString().trim() === '') {
      console.log('⚠️ Skipping empty message');
      return null;
    }
    
    const el = buildMessageElement({ content: messageContent, role, timestamp, metadata: null });
    chatMessages.appendChild(el);

    // Initialize Lucide icons for newly added message
    if (typeof lucide !== 'undefined') {
      lucide.createIcons();
    }

    // Track the content to prevent future duplicates
    streamedContent.add(messageContent.toString().trim());
    
    // Speak AI messages with TTS if enabled
    console.log('🔊 TTS Check:', {
      role: role,
      ttsManager: !!ttsManager,
      isEnabled: ttsManager?.isEnabled,
      messageLength: messageContent.toString().length
    });
    
    if (role === 'assistant' && ttsManager && ttsManager.isEnabled) {
      console.log('🎤 Speaking message:', messageContent.toString().substring(0, 50) + '...');
      
      // Give element an ID for highlighting
      const messageId = `msg-${Date.now()}`;
      el.id = messageId;
      
      // Speak the message
      ttsManager.speak(messageContent.toString(), {
        messageId: messageId,
        immediate: false // Queue normally
      });
    }
    
    // Dispatch event for other components to listen to
    document.dispatchEvent(new CustomEvent('scout:message-added', {
      detail: {
        content: messageContent,
        role: role,
        timestamp: timestamp,
        element: el
      }
    }));
    
    scrollToBottom();
    updateMessageCount();
    return el; // Return the element for streaming updates
  }

