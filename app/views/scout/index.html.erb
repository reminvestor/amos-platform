  // Load bookmarks from server
  async function loadBookmarks() {
    try {
      const response = await fetch('/scout/bookmarks');
      const bookmarks = await response.json();
      
      // Content type badge colors
      const contentTypeBadges = {
        'conversation': { color: 'primary', label: 'Chat' },
        'context_block': { color: 'info', label: 'Context' },
        'visualization': { color: 'success', label: 'Chart' },
        'report': { color: 'warning', label: 'Report' },
        'document': { color: 'secondary', label: 'Document' },
        'data_export': { color: 'dark', label: 'Export' },
        'insight': { color: 'purple', label: 'Insight' },
        'response': { color: 'primary', label: 'Response' }
      };
      
      if (bookmarks.length === 0) {
        bookmarksList.innerHTML = `
          <div class="text-center text-muted py-4">
            <i data-lucide="bookmark" style="width: 32px; height: 32px; opacity: 0.5;"></i>
            <p class="small mt-2 mb-0">No saved items yet</p>
            <p class="small text-muted">Ask Amos to "save this" or "bookmark this"</p>
          </div>
        `;
      } else {
        bookmarksList.innerHTML = bookmarks.map(bookmark => {
          const typeBadge = contentTypeBadges[bookmark.content_type] || { color: 'secondary', label: bookmark.content_type };
          const iconName = bookmark.icon || 'bookmark';
          
          return `
            <div class="bookmark-item" data-bookmark-id="${bookmark.id}">
              <div class="bookmark-header d-flex align-items-center gap-2">
                <i data-lucide="${iconName}" style="width: 16px; height: 16px; flex-shrink: 0;"></i>
                <div class="bookmark-title flex-grow-1">${escapeHtml(bookmark.title)}</div>
                <span class="badge bg-${typeBadge.color}" style="font-size: 10px;">${typeBadge.label}</span>
              </div>
              <div class="bookmark-preview">${escapeHtml((bookmark.description || bookmark.message_preview || '').substring(0, 80))}${(bookmark.description || bookmark.message_preview || '').length > 80 ? '...' : ''}</div>
              <div class="bookmark-meta">
                <span>${formatTimeAgo(bookmark.created_at)}</span>
                ${bookmark.shareable ? '<span class="badge bg-info ms-2">Shared</span>' : ''}
              </div>
              <div class="bookmark-actions mt-2">
                <button class="btn btn-sm btn-outline-primary load-bookmark-btn" data-bookmark-id="${bookmark.id}">
                  <i data-lucide="eye" style="width: 12px; height: 12px;"></i> View
                </button>
                ${bookmark.share_url ? `<button class="btn btn-sm btn-outline-secondary copy-link-btn" data-share-url="${bookmark.share_url}">
                  <i data-lucide="link" style="width: 12px; height: 12px;"></i> Copy Link
                </button>` : ''}
              </div>
            </div>
          `;
        }).join('');
        
        // Add click handlers for view buttons
        bookmarksList.querySelectorAll('.load-bookmark-btn').forEach(btn => {
          btn.addEventListener('click', function(e) {
            e.stopPropagation();
            const bookmarkId = this.dataset.bookmarkId;
            loadBookmarkContext(bookmarkId);
            bookmarksDropdown.classList.add('d-none');
          });
        });
        
        // Add click handlers for copy link buttons
        bookmarksList.querySelectorAll('.copy-link-btn').forEach(btn => {
          btn.addEventListener('click', function(e) {
            e.stopPropagation();
            const shareUrl = this.dataset.shareUrl;
            navigator.clipboard.writeText(window.location.origin + shareUrl).then(() => {
              this.innerHTML = '<i data-lucide="check" style="width: 12px; height: 12px;"></i> Copied!';
              setTimeout(() => {
                this.innerHTML = '<i data-lucide="link" style="width: 12px; height: 12px;"></i> Copy Link';
                if (typeof lucide !== 'undefined') lucide.createIcons();
              }, 2000);
            });
          });
        });
      }
      
      // Re-initialize icons
      if (typeof lucide !== 'undefined') lucide.createIcons();
    } catch (error) {
      console.error('Failed to load bookmarks:', error);
      bookmarksList.innerHTML = `
        <div class="text-center text-danger py-3">
          <p class="small mb-0">Failed to load saved items</p>
        </div>
      `;
    }
  }
  
  // Load bookmark context into chat or canvas
  async function loadBookmarkContext(bookmarkId) {
    try {
      const response = await fetch(`/scout/bookmarks/${bookmarkId}`);
      const bookmark = await response.json();
      
      console.log('📌 Loading bookmark:', bookmark.title, 'content_type:', bookmark.content_type);
      console.log('📌 Content keys:', bookmark.content ? Object.keys(bookmark.content) : 'none');
      
      // Handle different content types appropriately
      if (bookmark.content_type === 'visualization') {
        // For visualizations, load the canvas
        addMessage(`📌 **Loaded: ${bookmark.title}**`, 'assistant');
        
        // Get the scout controller and load the canvas
        const scoutController = document.querySelector('[data-controller="scout"]');
        if (scoutController && window.Stimulus) {
          const controller = window.Stimulus.getControllerForElementAndIdentifier(scoutController, 'scout');
          if (controller && typeof controller.loadScoutCanvas === 'function') {
            const canvasData = bookmark.content || {};
            
            // Detect canvas type based on content structure
            // Freeform canvas has: html, css, javascript fields
            // Dynamic canvas has: html_content field
            const isFreeformCanvas = canvasData.html !== undefined || 
                                     canvasData.css !== undefined || 
                                     canvasData.javascript !== undefined;
            
            if (isFreeformCanvas) {
              // Load as freeform canvas
              console.log('📌 Loading as freeform_canvas');
              controller.loadScoutCanvas('freeform_canvas', {
                title: bookmark.title,
                html: canvasData.html || '',
                css: canvasData.css || '',
                javascript: canvasData.javascript || '',
                library_css: canvasData.library_css || '',
                library_scripts: canvasData.library_scripts || '',
                data_script: canvasData.data_script || '',
                artifact_type: 'visualization'
              });
            } else {
              // Load as dynamic canvas
              console.log('📌 Loading as dynamic_canvas');
              controller.loadScoutCanvas('dynamic_canvas', {
                title: bookmark.title,
                html_content: canvasData.html_content || canvasData.content || '',
                artifact_type: 'visualization'
              });
            }
          } else {
            console.error('Scout controller or loadScoutCanvas not found');
            addMessage('Sorry, I couldn\'t load the visualization. Please refresh and try again.', 'assistant');
          }
        }
      } else {
        // For text-based content (conversation, context_block, insight, etc.)
        let contentText = '';
        
        if (typeof bookmark.content === 'string') {
          contentText = bookmark.content;
        } else if (bookmark.content && typeof bookmark.content === 'object') {
          // Handle object content - try to get text property or stringify nicely
          contentText = bookmark.content.text || bookmark.content.message || 
                       bookmark.content.summary || JSON.stringify(bookmark.content, null, 2);
        }
        
        addMessage(`📌 **Loaded Saved Item: ${bookmark.title}**\n\n${contentText}`, 'assistant');
      }
      
    } catch (error) {
      console.error('Failed to load bookmark:', error);
      addMessage('Sorry, I couldn\'t load that saved item.', 'assistant');
    }
  }
  
