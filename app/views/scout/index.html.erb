  function updateToolCall(toolCallId, status, message, details) {
    const toolCall = toolCalls.get(toolCallId);
    if (!toolCall) return;
    
    toolCall.status = status;
    if (message) toolCall.message = message;
    if (details) toolCall.details.push(details);
    
    // Update UI
    const icon = document.getElementById(`${toolCallId}-icon`);
    const statusEl = document.getElementById(`${toolCallId}-status`);
    const detailsContent = document.getElementById(`${toolCallId}-details-content`);
    
    if (icon) {
      icon.className = `tool-call-icon ${status}`;
      switch(status) {
        case 'running':
          icon.innerHTML = '<i data-lucide="loader-circle"></i>'; lucide.createIcons();
          break;
        case 'success':
          icon.innerHTML = '<i data-lucide="check"></i>'; lucide.createIcons();
          break;
        case 'error':
          icon.innerHTML = '<i data-lucide="x"></i>'; lucide.createIcons();
          break;
        default:
          icon.innerHTML = '<i data-lucide="clock"></i>';
      }
    }
    
    if (statusEl && message) {
      statusEl.textContent = message;
    }
    
    if (detailsContent && toolCall.details.length > 0) {
      detailsContent.textContent = toolCall.details.join('\n');
    }
  }
  
