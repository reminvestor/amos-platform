  const conversationDropdown = document.getElementById('conversation-dropdown');
  const conversationList = document.getElementById('conversation-list');
  
  // Track streamed content to prevent duplicates
  let streamedContent = new Set();
  
  // Populate streamedContent with existing messages on page load
  function initializeStreamedContent() {
    const existingMessages = document.querySelectorAll('#chat-messages .message-content');
    existingMessages.forEach(messageEl => {
