  // Model power to Claude model mapping
  const MODEL_MAP = {
    0: { model: 'claude-3-haiku', name: 'Claude 3.5 Haiku' },
    50: { model: 'claude-3-5-sonnet', name: 'Claude 3.5 Sonnet' },
