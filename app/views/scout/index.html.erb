      </div>
      <div class="modal-body px-4 py-3">
        <div class="storage-option mb-3 p-3 border rounded cursor-pointer" data-storage-type="short-term">
          <div class="form-check">
            <input class="form-check-input" type="radio" name="storageChoice" id="shortTermRadio" value="short-term">
            <label class="form-check-label w-100 cursor-pointer" for="shortTermRadio">
