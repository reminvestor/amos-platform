  // File attachment handling
  const attachButton = document.getElementById('attach-button');
  const fileInput = document.getElementById('file-input');
  const attachedFilesContainer = document.getElementById('attached-files');
  
  // Expose attachedFiles globally so Hub can access it
  window.attachedFiles = window.attachedFiles || [];
  let attachedFiles = window.attachedFiles;

  console.log('📎 File upload initialization:', {
    attachButton: !!attachButton,
    fileInput: !!fileInput,
    attachedFilesContainer: !!attachedFilesContainer
  });

  if (!attachButton || !fileInput) {
    console.error('❌ File upload elements not found!');
  } else {
    attachButton.addEventListener('click', function() {
      console.log('📎 Attach button clicked');
      fileInput.click();
    });
    
    fileInput.addEventListener('change', function(e) {
      console.log('📎 File input changed, files selected:', e.target.files.length);
      const files = Array.from(e.target.files);
      console.log('📎 Files:', files.map(f => ({ name: f.name, size: f.size, type: f.type })));
      console.log('📎 attachedFilesContainer exists?', !!attachedFilesContainer);
      console.log('📎 attachedFilesContainer display:', attachedFilesContainer?.style.display);

      files.forEach(file => {
        if (!attachedFiles.find(f => f.name === file.name)) {
          console.log('📎 Adding file:', file.name);
          attachedFiles.push(file);
          displayAttachedFile(file);
        } else {
          console.log('📎 File already attached:', file.name);
        }
      });
      fileInput.value = ''; // Reset input
      console.log('📎 Total attached files:', attachedFiles.length);
      console.log('📎 Container children:', attachedFilesContainer?.children.length);
    });

    // ═══════════════════════════════════════════════════════════════
    // PASTE-TO-UPLOAD: Handle pasting images directly from clipboard
    // ═══════════════════════════════════════════════════════════════
    messageInput.addEventListener('paste', function(e) {
      // Skip if we're in Team Space - Hub has its own paste handler
      const workspace = document.getElementById('workspace');
      if (workspace?.dataset?.inTeamSpace === 'true') {
        console.log('📸 In Team Space - using Hub paste handler');
        return;
      }
      
      const items = e.clipboardData?.items;
      if (!items) return;

      for (const item of items) {
        if (item.type.startsWith('image/')) {
          e.preventDefault();
          const file = item.getAsFile();
          if (file) {
            // Generate a unique filename for pasted images
            const timestamp = new Date().toISOString().replace(/[:.]/g, '-');
            const extension = file.type.split('/')[1] || 'png';
            const renamedFile = new File([file], `screenshot-${timestamp}.${extension}`, { type: file.type });
            
            console.log('📋 Pasted image:', renamedFile.name, renamedFile.type, renamedFile.size);
            
            // Add to attached files if not already there
            if (!attachedFiles.find(f => f.name === renamedFile.name)) {
              attachedFiles.push(renamedFile);
              displayAttachedFile(renamedFile);
              
              // Show visual feedback
              showPasteNotification('📸 Screenshot attached!');
            }
          }
          return; // Only process first image
        }
      }
    });
  } // Close the else block

  // Show a brief notification for paste success
