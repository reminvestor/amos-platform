<!-- JavaScript for Scout Chat -->
<script>
document.addEventListener('turbo:load', function() {
  // Clean up any previous event listeners to prevent duplicates
  if (window.scoutCleanup) {
    window.scoutCleanup();
  }

  // Store cleanup function
  window.scoutCleanup = function() {
    // This will be populated with cleanup tasks
  };

  // Initialize Lucide icons on page load
  function initializeLucideIcons() {
    if (typeof lucide !== 'undefined' && lucide.createIcons) {
      console.log('🎨 Initializing Lucide icons...');
      lucide.createIcons();
      console.log('✅ Lucide icons initialized');
    } else {
      console.warn('⚠️ Lucide not available, retrying in 100ms...');
      setTimeout(initializeLucideIcons, 100);
    }
  }
  initializeLucideIcons();
  
  // Handle task results streaming from parallel processing
  window.streamTaskResult = function(data) {
    console.log("📝 Streaming task result:", data);
    
    // Format the task result message
    const header = `### Task Completed: ${data.description}\n\n`;
    const content = header + (data.content || 'Task completed successfully');
    
    // Add to chat using the global addMessage function
    if (typeof addMessage === 'function') {
      addMessage(content, 'ai', new Date(data.timestamp));
    } else {
      console.error("Could not find addMessage function");
    }
  };
  
  // Track active tasks for badge update
  window.activeTasks = window.activeTasks || new Map();
  
  // Update task count badge
  function updateTaskBadge() {
    const badge = document.getElementById('active-task-count');
    if (badge) {
      const activeCount = Array.from(window.activeTasks.values()).filter(task => 
        task.status === 'active' || task.status === 'pending'
      ).length;
      
      badge.textContent = activeCount;
      badge.style.display = activeCount > 0 ? 'block' : 'none';
      
      // Pulse animation when tasks are active
      if (activeCount > 0) {
        badge.classList.add('pulse');
      } else {
        badge.classList.remove('pulse');
      }
    }
  }
  
  // Override handleParallelTaskUpdate to track active tasks
  const originalHandleUpdate = window.handleParallelTaskUpdate;
  window.handleParallelTaskUpdate = function(data) {
    // Track task status
    if (data.task_id) {
      if (data.type === 'task_completed' || data.type === 'task_failed') {
        window.activeTasks.delete(data.task_id);
      } else if (data.type === 'task_progress' || data.type === 'parallel_execution_start') {
        window.activeTasks.set(data.task_id, {
          status: data.status || 'active',
          description: data.description
        });
      }
      updateTaskBadge();
    }
    
    // Call original handler
    if (originalHandleUpdate) {
      originalHandleUpdate(data);
    }
  };
  
  // Handle workflow tasks that need user input
  window.handleTaskNeedsInput = function(data) {
    console.log("📋 Task needs user input:", data);
    
    // Add the message to chat with special styling
    const content = `### 📋 ${data.description || 'Workflow Task'}\n\n${data.message}`;
    
    // Add to chat
    if (typeof addMessage === 'function') {
      addMessage(content, 'ai', new Date(data.timestamp));
    }
    
    // Store the task ID for response routing
    window.activeWorkflowTask = data.task_id;
  };
  
  // Stream content from tasks to chat
  window.streamTaskContent = function(data) {
    console.log("📝 Streaming task content:", data);
    
    // Add content to chat
    if (typeof addMessage === 'function') {
      addMessage(data.content, data.role || 'ai', new Date(data.timestamp));
    }
  };

  const messageForm = document.getElementById('message-form');
  const messageInput = document.getElementById('message-input');
  const chatMessages = document.getElementById('chat-messages');
  const sendButton = document.getElementById('send-button');

  // Brain Icon Model Selector
  const modelSelectorBtn = document.getElementById('model-selector-btn');
  const modelPopover = document.getElementById('model-selector-popover');
  const currentModelName = document.getElementById('current-model-name');
  const modelSelect = document.getElementById('model-select'); // Hidden select
  const visibleModelSelect = document.getElementById('visible-model-select');
  const providerBtns = document.querySelectorAll('.provider-btn');

  // Provider -> Models mapping
  const MODELS_BY_PROVIDER = {
    anthropic: [
      { id: 'claude-opus-4-5', name: 'Claude Opus 4.5' },
      { id: 'claude-sonnet-4-5', name: 'Claude Sonnet 4.5' },
      { id: 'claude-opus-4-1', name: 'Claude Opus 4.1' },
      { id: 'claude-3-5-sonnet', name: 'Claude 3.5 Sonnet' },
      { id: 'claude-haiku-4-5-20251001', name: 'Claude Haiku 4.5' },
      { id: 'claude-3-haiku', name: 'Claude 3.5 Haiku' }
    ],
    meta: [
      { id: 'meta-llama-3-2-90b', name: 'Llama 3.2 90B Vision' },
      { id: 'meta-llama-3-3-70b', name: 'Llama 3.3 70B' }
    ],
    alibaba: [
      { id: 'qwen-3-32b', name: 'Qwen 3 32B' },
      { id: 'qwen-3-coder-30b', name: 'Qwen 3 Coder 30B' }
    ]
  };

  // Load saved state
  let currentProvider = localStorage.getItem('scout_provider') || 'anthropic';
  let currentModelId = localStorage.getItem('scout_selected_model') || 'claude-3-5-sonnet';

  // Update brain fill based on model
  function updateBrainFill(modelId) {
    let power = 50;
    if (modelId.includes('opus')) power = 100;
    else if (modelId.includes('sonnet')) power = 75;
    else if (modelId.includes('haiku')) power = 25;
    else if (modelId.includes('llama') || modelId.includes('qwen')) power = 60;
    
    const fillPercent = 100 - power;
    const brainFills = document.querySelectorAll('.brain-fill, .brain-fill-lg');
    brainFills.forEach(fill => {
      fill.style.clipPath = `inset(${fillPercent}% 0 0 0)`;
    });
