    if (!visibleModelSelect) return;
    
    visibleModelSelect.innerHTML = '';
    const models = MODELS_BY_PROVIDER[provider] || MODELS_BY_PROVIDER['anthropic'];
    
    models.forEach(m => {
      const option = document.createElement('option');
      option.value = m.id;
      option.textContent = m.name;
      visibleModelSelect.appendChild(option);
    });
    
    // Try to select current model if it exists in this provider list
    const exists = models.find(m => m.id === currentModelId);
    if (exists) {
      visibleModelSelect.value = currentModelId;
      updateGlobalModel(currentModelId, exists.name);
    } else {
      // Default to first
      visibleModelSelect.value = models[0].id;
      currentModelId = models[0].id;
      updateGlobalModel(currentModelId, models[0].name);
    }
