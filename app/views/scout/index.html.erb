                <button class="emoji-item" onclick="insertEmoji('😴')">😴</button>
              </div>
            </div>
            <div class="emoji-category">
              <div class="emoji-category-title">Gestures & Body</div>
              <div class="emoji-grid">
                <button class="emoji-item" onclick="insertEmoji('👍')">👍</button>
