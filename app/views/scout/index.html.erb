  // Add source citations to the last assistant message
  function addSourceCitations(sources) {
    console.log('📚 addSourceCitations called with:', sources);

    // Find the last assistant message
    const messages = chatMessages.querySelectorAll('.message.assistant');
    const lastMessage = messages[messages.length - 1];

    if (!lastMessage) {
      console.warn('⚠️ No assistant message found to attach sources');
      return;
    }

    // Check if sources already exist (prevent duplicates)
    if (lastMessage.querySelector('.source-citations')) {
      console.log('ℹ️ Sources already attached to this message');
      return;
    }

    // Build sources HTML
