        </div>
        
        <!-- GIF Picker Popover -->
        <div id="gif-picker-popover" class="gif-picker-popover d-none">
          <div class="gif-picker-header">
            <span class="gif-picker-title">Choose a GIF</span>
            <button type="button" class="gif-picker-close" onclick="closeGifPicker()">×</button>
          </div>
          <div class="gif-picker-search">
            <input type="text" placeholder="Search Giphy..." id="gif-search-input" oninput="searchGifs(this.value)">
          </div>
          <div class="gif-picker-content" id="gif-picker-content">
            <div class="gif-grid" id="gif-grid">
              <!-- GIFs will be loaded here -->
              <div class="gif-loading">
                <div class="spinner-border spinner-border-sm me-2"></div>
                Type to search for GIFs...
              </div>
