      </div>
    </section>

    <!-- Resize Handle - visible in collab-sidebar modes for resizing chat -->
    <div class="resize-handle" data-scout-target="resizeHandle" data-action="mousedown->scout#startResize">
      <div class="resize-line"></div>
    </div>

    <!-- Template View Area (Hidden in conversation mode, visible in work mode) -->
    <section class="template-area" data-scout-target="templateArea">
      
      <%# Header removed - each canvas has its own header now %>
      <h3 data-scout-target="templateTitle" class="d-none">Template</h3>
      
      <div class="template-content" data-scout-target="templateContent">
        <div class="template-placeholder">
          <div class="placeholder-icon">
            <i data-lucide="box"></i>
          </div>
          <p>No template loaded</p>
        </div>
      </div>
      
      <!-- Mobile floating voice button - visible over canvas overlay -->
      <div class="mobile-voice-float" data-controller="voice-assistant">
        <button type="button"
                class="voice-btn"
                data-action="click->voice-assistant#toggleVoice"
                data-voice-assistant-target="button"
                title="Voice input"
                aria-label="Start voice input">
          <i data-lucide="mic" aria-hidden="true"></i>
        </button>
        <div data-voice-assistant-target="status" class="voice-status"></div>
      </div>
    </section>
  </main>

  <!-- Loading Overlay -->
  <div class="loading-overlay" data-scout-target="loadingOverlay">
    <div class="loading-spinner">
      <div class="loading-icon-container">
        <i data-lucide="wand-2" class="loading-icon"></i>
      </div>
      <p class="loading-title">Amos is working...</p>
      <div class="loading-dots">
        <span></span>
        <span></span>
        <span></span>
      </div>
      <p class="loading-message"></p>
    </div>
  </div>

  <!-- Work Inbox Badge Controller (updates the nav-item badge) -->
  <%= render 'scout/work_inbox_badge' %>
  <%= render 'scout/hub_unread_badge' %>
  <%= render 'scout/system_notifications_badge' %>
  
  <!-- Agent Question Queue - Only show when NOT in collab sidebar mode (questions show in sidebar instead) -->
  <% unless @show_collab_sidebar %>
    <%= render 'scout/question_queue', pending_questions: @pending_questions || [] %>
  <% end %>
</div>

<!-- CSRF Token for AJAX requests -->
<%= csrf_meta_tags %>

<!-- JavaScript for Scout Chat -->
<script>
document.addEventListener('turbo:load', function() {
  // Clean up any previous event listeners to prevent duplicates
  if (window.scoutCleanup) {
    window.scoutCleanup();
  }

  // Store cleanup function
  window.scoutCleanup = function() {
    // This will be populated with cleanup tasks
  };

  // Initialize Lucide icons on page load
  function initializeLucideIcons() {
    if (typeof lucide !== 'undefined' && lucide.createIcons) {
      console.log('🎨 Initializing Lucide icons...');
      lucide.createIcons();
      console.log('✅ Lucide icons initialized');
    } else {
      console.warn('⚠️ Lucide not available, retrying in 100ms...');
      setTimeout(initializeLucideIcons, 100);
    }
  }
  initializeLucideIcons();

  // Initialize theme toggle
  function initializeThemeToggle() {
    // Priority: 1) Already set on DOM, 2) localStorage, 3) Cookie from server, 4) System preference
    const serverTheme = '<%= @initial_theme || "light" %>';
    const currentTheme = document.documentElement.getAttribute('data-theme') ||
                         localStorage.getItem('amos_theme_preference') ||
                         serverTheme;

    // Apply theme and sync to localStorage
    if (!document.documentElement.getAttribute('data-theme')) {
      document.documentElement.setAttribute('data-theme', currentTheme);
      localStorage.setItem('amos_theme_preference', currentTheme);
    }

    // Update theme toggle icon
    const themeIcon = document.querySelector('[data-theme-icon]');
    if (themeIcon) {
      themeIcon.setAttribute('data-lucide', currentTheme === 'dark' ? 'sun' : 'moon');
      if (typeof lucide !== 'undefined') {
        lucide.createIcons();
      }
    }

    // Add click handler for theme toggle - use global ThemeManager if available
    const themeToggle = document.querySelector('[data-theme-toggle]');
    if (themeToggle && !themeToggle.hasAttribute('data-theme-initialized')) {
      themeToggle.setAttribute('data-theme-initialized', 'true');
      themeToggle.style.cursor = 'pointer';
      themeToggle.addEventListener('click', function(e) {
        e.preventDefault();
        e.stopPropagation();
        
        // Use ThemeManager if available, otherwise fallback
        if (window.themeManager && typeof window.themeManager.toggleTheme === 'function') {
          window.themeManager.toggleTheme();
        } else {
          const current = document.documentElement.getAttribute('data-theme') || 'dark';
          const newTheme = current === 'light' ? 'dark' : 'light';
          document.documentElement.setAttribute('data-theme', newTheme);
          localStorage.setItem('amos_theme_preference', newTheme);

          // Update icon
          const icon = document.querySelector('[data-theme-icon]');
          if (icon) {
            icon.setAttribute('data-lucide', newTheme === 'dark' ? 'sun' : 'moon');
            if (typeof lucide !== 'undefined') {
              lucide.createIcons();
            }
          }
          console.log('🎨 Theme toggled to:', newTheme);
        }
      });
    }
    
  }
  setTimeout(initializeThemeToggle, 100);
  
  // Auto-load dashboard on entry (e.g., after completing onboarding)
  <% if @load_dashboard_on_entry %>
  (function() {
    const checkAndLoadDashboard = () => {
      if (window.scoutController && typeof window.scoutController.loadScoutCanvas === 'function') {
        console.log('🏠 Auto-loading dashboard after onboarding');
        window.scoutController.loadScoutCanvas('default', {});
      } else {
        // Controller not ready yet, retry
        setTimeout(checkAndLoadDashboard, 200);
      }
    };
    // Wait a bit for the controller to initialize
    setTimeout(checkAndLoadDashboard, 500);
  })();
  <% end %>
  
  // Handle task results streaming from parallel processing
  window.streamTaskResult = function(data) {
    console.log("📝 Streaming task result:", data);
    
    // Format the task result message
    const header = `### Task Completed: ${data.description}\n\n`;
    const content = header + (data.content || 'Task completed successfully');
    
    // Add to chat using the global addMessage function
    if (typeof addMessage === 'function') {
      addMessage(content, 'ai', new Date(data.timestamp));
    } else {
      console.error("Could not find addMessage function");
    }
  };
  
  // Track active tasks for badge update
  window.activeTasks = window.activeTasks || new Map();
  
  // Update task count badge
  function updateTaskBadge() {
    const badge = document.getElementById('active-task-count');
    if (badge) {
      const activeCount = Array.from(window.activeTasks.values()).filter(task => 
        task.status === 'active' || task.status === 'pending'
      ).length;
      
      badge.textContent = activeCount;
      badge.style.display = activeCount > 0 ? 'block' : 'none';
      
      // Pulse animation when tasks are active
      if (activeCount > 0) {
        badge.classList.add('pulse');
      } else {
        badge.classList.remove('pulse');
      }
    }
  }
  
  // Override handleParallelTaskUpdate to track active tasks
  const originalHandleUpdate = window.handleParallelTaskUpdate;
  window.handleParallelTaskUpdate = function(data) {
    // Track task status
    if (data.task_id) {
      if (data.type === 'task_completed' || data.type === 'task_failed') {
        window.activeTasks.delete(data.task_id);
      } else if (data.type === 'task_progress' || data.type === 'parallel_execution_start') {
        window.activeTasks.set(data.task_id, {
          status: data.status || 'active',
          description: data.description
        });
      }
      updateTaskBadge();
    }
    
    // Call original handler
    if (originalHandleUpdate) {
      originalHandleUpdate(data);
    }
  };
  
  // Handle workflow tasks that need user input
  window.handleTaskNeedsInput = function(data) {
    console.log("📋 Task needs user input:", data);
    
    // Add the message to chat with special styling
    const content = `### 📋 ${data.description || 'Workflow Task'}\n\n${data.message}`;
    
    // Add to chat
    if (typeof addMessage === 'function') {
      addMessage(content, 'ai', new Date(data.timestamp));
    }
    
    // Store the task ID for response routing
    window.activeWorkflowTask = data.task_id;
  };
  
  // Stream content from tasks to chat
  window.streamTaskContent = function(data) {
    console.log("📝 Streaming task content:", data);
    
    // Add content to chat
    if (typeof addMessage === 'function') {
      addMessage(data.content, data.role || 'ai', new Date(data.timestamp));
    }
  };

  const messageForm = document.getElementById('message-form');
  const messageInput = document.getElementById('message-input');
  const chatMessages = document.getElementById('chat-messages');
  const sendButton = document.getElementById('send-button');

  // Brain Icon Model Selector
  const modelSelectorBtn = document.getElementById('model-selector-btn');
  const modelPopover = document.getElementById('model-selector-popover');
  const currentModelName = document.getElementById('current-model-name');
  const modelSelect = document.getElementById('model-select'); // Hidden select
  const visibleModelSelect = document.getElementById('visible-model-select');
  const modelDescription = document.getElementById('model-description');
  const providerBtns = document.querySelectorAll('.provider-btn');

  // Provider -> Models mapping
  // NOTE: Order matters! First model is the fallback if saved model doesn't exist
  const MODELS_BY_PROVIDER = {
    anthropic: [
      { id: 'claude-sonnet-4-5', name: 'Claude Sonnet 4.5', desc: 'Best for everyday tasks - fast, accurate, and cost-effective' },
      { id: 'claude-haiku-4-5-20251001', name: 'Claude Haiku 4.5', desc: 'Best for quick responses - ultra-fast and budget-friendly' },
      { id: 'claude-3-5-sonnet', name: 'Claude 3.5 Sonnet', desc: 'Reliable all-rounder for writing, research, and analysis' },
      { id: 'claude-3-haiku', name: 'Claude 3.5 Haiku', desc: 'Fast responses for simple questions and basic tasks' },
      { id: 'claude-opus-4-5', name: 'Claude Opus 4.5', desc: 'Best for coding, debugging, and complex reasoning tasks' },
      { id: 'claude-opus-4-1', name: 'Claude Opus 4.1', desc: 'Premium model for detailed analysis and strategic planning' }
    ],
    meta: [
      { id: 'meta-llama-3-2-90b', name: 'Llama 3.2 90B Vision', desc: 'Best for image analysis and visual understanding' },
      { id: 'meta-llama-3-3-70b', name: 'Llama 3.3 70B', desc: 'Open-source powerhouse for general tasks and research' }
    ],
    alibaba: [
      { id: 'qwen-3-32b', name: 'Qwen 3 32B', desc: 'Versatile model with strong multilingual capabilities' },
      { id: 'qwen-3-coder-30b', name: 'Qwen 3 Coder 30B', desc: 'Specialized for coding assistance and technical tasks' }
    ]
  };

  // Load saved state - always default to Sonnet 4.5 for new users
  let currentProvider = localStorage.getItem('scout_provider') || 'anthropic';
  
  // One-time migration: Reset users who had Opus as default before we changed it
  // This ensures existing users get switched to the more cost-effective Sonnet 4.5
  const modelMigrationVersion = 'v2_sonnet_default';
  if (localStorage.getItem('scout_model_migration') !== modelMigrationVersion) {
    console.log('🧠 Running model migration - resetting to Sonnet 4.5 default');
    localStorage.setItem('scout_selected_model', 'claude-sonnet-4-5');
    localStorage.setItem('scout_model_migration', modelMigrationVersion);
  }
  
  // Default to Sonnet 4.5 - good balance of quality and cost
  let currentModelId = localStorage.getItem('scout_selected_model') || 'claude-sonnet-4-5';

  // Update brain fill based on model
  function updateBrainFill(modelId) {
    let power = 50;
    if (modelId.includes('opus')) power = 100;
    else if (modelId.includes('sonnet')) power = 75;
    else if (modelId.includes('haiku')) power = 25;
    else if (modelId.includes('llama') || modelId.includes('qwen')) power = 60;
    
    const fillPercent = 100 - power;
    const brainFills = document.querySelectorAll('.brain-fill, .brain-fill-lg');
    brainFills.forEach(fill => {
      fill.style.clipPath = `inset(${fillPercent}% 0 0 0)`;
    });
  }

  function updateGlobalModel(id, name, desc) {
    if (modelSelect) modelSelect.value = id;
    if (currentModelName) currentModelName.textContent = name || id;
    if (modelDescription) modelDescription.textContent = desc || '';
    localStorage.setItem('scout_selected_model', id);
    updateBrainFill(id);
  }

  // Function to populate models
  function populateModels(provider) {
    if (!visibleModelSelect) return;

    // Clear existing options safely
    while (visibleModelSelect.firstChild) {
      visibleModelSelect.removeChild(visibleModelSelect.firstChild);
    }
    const models = MODELS_BY_PROVIDER[provider] || MODELS_BY_PROVIDER['anthropic'];

    models.forEach(m => {
      const option = document.createElement('option');
      option.value = m.id;
      option.textContent = m.name;
      option.dataset.desc = m.desc || '';
      visibleModelSelect.appendChild(option);
    });

    // Try to select current model if it exists in this provider list
    const exists = models.find(m => m.id === currentModelId);
    if (exists) {
      visibleModelSelect.value = currentModelId;
      updateGlobalModel(currentModelId, exists.name, exists.desc);
    } else {
      // Default to first (Sonnet 4.5)
      visibleModelSelect.value = models[0].id;
      currentModelId = models[0].id;
      updateGlobalModel(currentModelId, models[0].name, models[0].desc);
    }
  }

  // Init
  if (visibleModelSelect) {
    populateModels(currentProvider);
    
    // Set active provider button
    providerBtns.forEach(btn => {
      if (btn.dataset.provider === currentProvider) btn.classList.add('active');
      else btn.classList.remove('active');
      
      btn.addEventListener('click', (e) => {
        e.preventDefault(); // Prevent form submit if inside form
        providerBtns.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        currentProvider = btn.dataset.provider;
        localStorage.setItem('scout_provider', currentProvider);
        populateModels(currentProvider);
      });
    });

    // Handle Model Change - switches to custom mode
    visibleModelSelect.addEventListener('change', (e) => {
      currentModelId = e.target.value;
      const selectedOption = e.target.options[e.target.selectedIndex];
      const name = selectedOption.text;
      const desc = selectedOption.dataset.desc || '';
      updateGlobalModel(currentModelId, name, desc);
      
      // Selecting a specific model enables custom mode
      enableCustomModelMode();
    });
  } else {
    // Fallback if new UI not rendered yet
    updateBrainFill(currentModelId);
  }

  // Toggle popover
  console.log('Model selector button found:', !!modelSelectorBtn);
  console.log('Model popover found:', !!modelPopover);

  if (modelSelectorBtn) {
    modelSelectorBtn.addEventListener('click', (e) => {
      e.preventDefault();
      e.stopPropagation();
      console.log('🧠 Model selector clicked');
      const isOpen = !modelPopover.classList.contains('d-none');
      modelPopover.classList.toggle('d-none');
      console.log('🧠 Popover is now:', isOpen ? 'closed' : 'open');

      // Re-initialize Lucide icons in popover when opening
      if (!isOpen && typeof lucide !== 'undefined') {
        setTimeout(() => lucide.createIcons(), 10);
      }
    });
  } else {
    console.error('❌ Model selector button not found!');
  }

  // Close popover when clicking outside
  document.addEventListener('click', (e) => {
    if (modelPopover && !modelPopover.contains(e.target) && e.target !== modelSelectorBtn) {
      modelPopover.classList.add('d-none');
    }
  });


  // ====================================
  // Thinking Depth Mode (Slider Only)
  // ====================================
  // Model selection now uses the Thinking Depth slider
  // Backend uses session[:model_mode] set by the slider

  // Helper function - always returns null (slider mode)
  window.getSelectedModel = function() {
    return null; // Backend uses the thinking depth from slider
  };

  // Helper to get the current model mode for display
  window.getCurrentModelMode = function() {
    return localStorage.getItem('scout_model_mode') || 'auto';
  };

  // Update mode display in header
  function updateModeIndicators() {
    const modeIndex = MODE_KEYS.indexOf(localStorage.getItem('scout_model_mode') || 'auto');
    if (currentModelName) {
      currentModelName.textContent = MODE_NAMES[modeIndex >= 0 ? modeIndex : 0];
    }
  }

  // ====================================
  // Thinking Depth Slider
  // ====================================
  const modelModeSlider = document.getElementById('model-mode-slider');
  const modeDescription = document.getElementById('mode-description');

  const MODE_DESCRIPTIONS = {
    0: '<strong>Auto:</strong> Intelligently adjusts thinking depth based on your request. Recommended for most users.',
    1: '<strong>Light:</strong> Fast responses (8k tokens). Best for simple questions.',
    2: '<strong>Medium:</strong> Balanced thinking (16k tokens). Good for everyday tasks.',
    3: '<strong>Deep:</strong> Enhanced reasoning (32k tokens). Best for complex problems.'
  };

  const MODE_NAMES = {
    0: 'Auto (Recommended)',
    1: 'Light',
    2: 'Medium',
    3: 'Deep'
  };

  const MODE_KEYS = ['auto', 'light', 'medium', 'deep'];

  // Load saved mode
  let currentMode = localStorage.getItem('scout_model_mode') || 'auto';
  let currentModeIndex = MODE_KEYS.indexOf(currentMode);
  if (currentModeIndex === -1) currentModeIndex = 0;

  // Initialize slider
  if (modelModeSlider) {
    modelModeSlider.value = currentModeIndex;
    updateModeDisplay(currentModeIndex);
    highlightActiveLabel(currentModeIndex);

    modelModeSlider.addEventListener('input', async (e) => {
      const index = parseInt(e.target.value);
      updateModeDisplay(index);
      highlightActiveLabel(index);
      await saveModelMode(MODE_KEYS[index]);
    });
  }

  function updateModeDisplay(index) {
    if (modeDescription) {
      modeDescription.innerHTML = MODE_DESCRIPTIONS[index];
    }
    if (currentModelName) {
      currentModelName.textContent = MODE_NAMES[index];
    }
    // Update brain fill based on mode
    const power = index === 0 ? 50 : (index * 33); // auto=50%, fast=33%, balanced=66%, powerful=100%
    updateBrainFill(null, power);
  }

  function highlightActiveLabel(index) {
    const labels = document.querySelectorAll('.mode-label');
    labels.forEach((label, i) => {
      if (i === index) {
        label.classList.add('active');
      } else {
        label.classList.remove('active');
      }
    });
  }

  async function saveModelMode(mode) {
    localStorage.setItem('scout_model_mode', mode);
    try {
      const csrfToken = document.querySelector('meta[name="csrf-token"]')?.content;
      await fetch('/scout/set_model_mode', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'X-CSRF-Token': csrfToken
        },
        body: JSON.stringify({ mode: mode })
      });
      console.log(`🧠 Model mode set to: ${mode}`);
    } catch (err) {
      console.warn('Failed to save model mode to server:', err);
    }
  }

  // Initialize mode indicators on page load
  updateModeIndicators();

  // ====================================
  // Premium Model Selection (Claude)
  // ====================================
  const premiumToggle = document.getElementById('premium-mode-toggle');
  const premiumModelsSection = document.getElementById('premium-models-section');
  const opensourceInfo = document.getElementById('opensource-info');
  const premiumModelSelect = document.getElementById('premium-model-select');
  const premiumModelDesc = document.getElementById('premium-model-desc');

  // Track premium mode state
  let isPremiumMode = localStorage.getItem('scout_premium_mode') === 'true';
  let selectedPremiumModel = localStorage.getItem('scout_premium_model') || 'claude-sonnet-4-5';

  // Initialize premium mode UI
  function initPremiumMode() {
    if (!premiumToggle) return;
    
    // Set initial state
    premiumToggle.checked = isPremiumMode;
    updatePremiumUI();
    
    // If premium mode, set the selected model
    if (isPremiumMode && premiumModelSelect) {
      premiumModelSelect.value = selectedPremiumModel;
      updatePremiumDescription();
    }
    
    // Toggle listener
    premiumToggle.addEventListener('change', async (e) => {
      isPremiumMode = e.target.checked;
      localStorage.setItem('scout_premium_mode', isPremiumMode);
      updatePremiumUI();
      
      // Save to server
      await savePremiumModel(isPremiumMode ? selectedPremiumModel : null);
      
      console.log(`👑 Premium mode: ${isPremiumMode ? 'ON - ' + selectedPremiumModel : 'OFF (open-source)'}`);
    });
    
    // Model select listener
    if (premiumModelSelect) {
      premiumModelSelect.addEventListener('change', async (e) => {
        selectedPremiumModel = e.target.value;
        localStorage.setItem('scout_premium_model', selectedPremiumModel);
        updatePremiumDescription();
        updateBrainFill(selectedPremiumModel);
        
        // Save to server
        await savePremiumModel(selectedPremiumModel);
        
        console.log(`👑 Premium model changed to: ${selectedPremiumModel}`);
      });
    }
  }
  
  function updatePremiumUI() {
    if (!premiumModelsSection || !opensourceInfo) return;
    
    // Get the thinking depth section to enable/disable
    const modelModeSection = document.getElementById('model-mode-section');
    const modelModeSliderEl = document.getElementById('model-mode-slider');
    
    if (isPremiumMode) {
      premiumModelsSection.classList.remove('d-none');
      opensourceInfo.classList.add('d-none');
      updateBrainFill(selectedPremiumModel);
      if (currentModelName) {
        const modelName = premiumModelSelect?.options[premiumModelSelect.selectedIndex]?.text || 'Claude';
        currentModelName.textContent = modelName;
      }
      
      // Disable thinking depth slider when premium model is selected
      // This makes it clear that premium model takes precedence
      if (modelModeSection) {
        modelModeSection.style.opacity = '0.4';
        modelModeSection.style.pointerEvents = 'none';
        modelModeSection.title = 'Thinking depth is controlled by your premium model selection';
      }
      if (modelModeSliderEl) {
        modelModeSliderEl.disabled = true;
      }
      // Update mode description to indicate premium override
      if (modeDescription) {
        modeDescription.innerHTML = '<i data-lucide="crown" style="width: 12px; height: 12px; margin-right: 4px; color: #8b5cf6;"></i><strong style="color: #8b5cf6;">Premium Model Active:</strong> Thinking depth is determined by your selected Claude model.';
        // Refresh lucide icons for the new crown icon
        if (typeof lucide !== 'undefined') lucide.createIcons();
      }
    } else {
      premiumModelsSection.classList.add('d-none');
      opensourceInfo.classList.remove('d-none');
      updateBrainFill(null, 50); // Reset to default
      updateModeIndicators(); // Show the depth mode name
      
      // Re-enable thinking depth slider when using auto mode
      if (modelModeSection) {
        modelModeSection.style.opacity = '1';
        modelModeSection.style.pointerEvents = 'auto';
        modelModeSection.title = '';
      }
      if (modelModeSliderEl) {
        modelModeSliderEl.disabled = false;
      }
      // Restore the thinking depth description using existing updateModeDisplay
      const currentSliderValue = modelModeSliderEl ? parseInt(modelModeSliderEl.value) : 0;
      updateModeDisplay(currentSliderValue);
    }
  }
  
  function updatePremiumDescription() {
    if (!premiumModelSelect || !premiumModelDesc) return;
    const selectedOption = premiumModelSelect.options[premiumModelSelect.selectedIndex];
    premiumModelDesc.textContent = selectedOption?.dataset?.desc || '';
  }
  
  async function savePremiumModel(model) {
    try {
      const csrfToken = document.querySelector('meta[name="csrf-token"]')?.content;
      await fetch('/scout/set_premium_model', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'X-CSRF-Token': csrfToken
        },
        body: JSON.stringify({ model: model })
      });
    } catch (err) {
      console.warn('Failed to save premium model to server:', err);
    }
  }
  
  // Expose function for getting selected model
  window.getSelectedModel = function() {
    if (isPremiumMode && selectedPremiumModel) {
      return selectedPremiumModel;
    }
    return null; // Backend uses open-source default
  };
  
  // Check if premium mode is active
  window.isPremiumModeActive = function() {
    return isPremiumMode;
  };
  
  // Initialize
  initPremiumMode();

  // Override updateBrainFill to accept optional power parameter
  const originalUpdateBrainFill = updateBrainFill;
  function updateBrainFill(modelId, power = null) {
    if (power === null) {
      if (modelId.includes('opus')) power = 100;
      else if (modelId.includes('sonnet')) power = 75;
      else if (modelId.includes('haiku')) power = 25;
      else if (modelId.includes('llama') || modelId.includes('qwen')) power = 60;
      else power = 50;
    }
    
    const brainFill = document.querySelector('.brain-fill');
    const powerDots = document.querySelectorAll('.power-dot');
    
    if (brainFill) {
      brainFill.style.clipPath = `inset(${100 - power}% 0 0 0)`;
    }
    
    powerDots.forEach((dot, i) => {
      if (i === 0) dot.classList.toggle('active', power >= 50);
      if (i === 1) dot.classList.toggle('active', power >= 75);
    });
  }
  const toolActivity = document.getElementById('tool-activity');
  
  // Initialize TTS
  let ttsManager = null;
  const ttsToggleBtn = document.getElementById('tts-toggle-btn');
  
  // Initialize TTS manager
  function initTTS() {
    console.log('🔍 initTTS called, checking window.TTSAudioManager:', !!window.TTSAudioManager);
    if (!ttsManager && window.TTSAudioManager) {
      console.log('📢 Creating new TTSAudioManager instance...');
      ttsManager = new window.TTSAudioManager();
