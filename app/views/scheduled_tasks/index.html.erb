<div class="container-fluid py-4">
  <div class="admin-page-header">
    <div class="header-left">
      <div class="header-icon">
        <i data-lucide="calendar-clock"></i>
      </div>
      <div class="header-text">
        <h1>Scheduled Tasks</h1>
        <p>Automate recurring tasks with AI agents</p>
      </div>
    </div>
    <div class="header-actions">
      <%= link_to new_scheduled_task_path, class: "admin-btn admin-btn-primary" do %>
        <i data-lucide="plus" aria-hidden="true"></i>
        <span>New Scheduled Task</span>
      <% end %>
    </div>
  </div>

  <div>
    <!-- Stats Cards -->
    <div class="row g-4 mb-4">
      <div class="col-md-3">
        <div class="admin-card">
          <div class="d-flex align-items-center gap-3">
            <div class="admin-icon-circle bg-success bg-opacity-10">
              <i data-lucide="play-circle" style="color: #10B981;"></i>
            </div>
            <div>
              <div class="admin-stat-value"><%= @active_tasks.count %></div>
              <div class="admin-stat-label">Active Tasks</div>
            </div>
          </div>
        </div>
      </div>
      <div class="col-md-3">
        <div class="admin-card">
          <div class="d-flex align-items-center gap-3">
            <div class="admin-icon-circle bg-warning bg-opacity-10">
              <i data-lucide="pause-circle" style="color: #F59E0B;"></i>
            </div>
            <div>
              <div class="admin-stat-value"><%= @paused_tasks.count %></div>
              <div class="admin-stat-label">Paused</div>
            </div>
          </div>
        </div>
      </div>
      <div class="col-md-3">
        <div class="admin-card">
          <div class="d-flex align-items-center gap-3">
            <div class="admin-icon-circle bg-primary bg-opacity-10">
              <i data-lucide="check-circle" style="color: #7C3AED;"></i>
            </div>
            <div>
              <div class="admin-stat-value"><%= @completed_tasks.count %></div>
              <div class="admin-stat-label">Completed</div>
            </div>
          </div>
        </div>
      </div>
      <div class="col-md-3">
        <div class="admin-card">
          <div class="d-flex align-items-center gap-3">
            <div class="admin-icon-circle bg-info bg-opacity-10">
              <i data-lucide="activity" style="color: #06B6D4;"></i>
            </div>
            <div>
              <div class="admin-stat-value"><%= @scheduled_tasks.sum(:run_count) %></div>
              <div class="admin-stat-label">Total Runs</div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Tasks List -->
    <div class="admin-card">
      <div class="admin-card-header">
        <h5 class="mb-0">
          <i data-lucide="list" class="me-2" style="color: #A78BFA;"></i>
          All Scheduled Tasks
        </h5>
      </div>
      <div class="admin-card-body p-0">
        <% if @scheduled_tasks.any? %>
          <div class="table-responsive">
            <table class="admin-table">
              <thead>
                <tr>
                  <th>Task</th>
                  <th>Type</th>
                  <th>Schedule</th>
                  <th>Next Run</th>
                  <th>Last Run</th>
                  <th>Status</th>
                  <th>Runs</th>
                  <th>Actions</th>
                </tr>
              </thead>
              <tbody>
                <% @scheduled_tasks.each do |task| %>
                  <tr>
                    <td>
                      <div class="d-flex align-items-center gap-2">
                        <span class="fs-5"><%= task.task_type_info[:icon] %></span>
                        <div>
                          <%= link_to task.name, scheduled_task_path(task), class: "task-name-link text-decoration-none fw-medium" %>
                          <% if task.deterministic? %>
                            <span class="badge bg-info ms-1" title="Deterministic mode">
                              <%= task.execution_mode == 'agent_only' ? '🤖' : '🔧' %>
                            </span>
                          <% end %>
                          <% if task.description.present? %>
                            <div class="small text-muted"><%= truncate(task.description, length: 50) %></div>
                          <% end %>
                        </div>
                      </div>
                    </td>
                    <td>
                      <span class="badge bg-secondary"><%= task.task_type_info[:name] %></span>
                    </td>
                    <td>
                      <% case task.schedule_type %>
                      <% when 'once' %>
                        <span class="text-muted">Once</span>
                      <% when 'daily' %>
                        Daily at <%= task.run_at_time&.strftime('%I:%M %p') %>
                      <% when 'weekly' %>
                        Weekly on <%= Date::DAYNAMES[task.run_on_day || 0] %>
                      <% when 'monthly' %>
                        Monthly on day <%= task.run_on_day %>
                      <% when 'cron' %>
                        <code><%= task.cron_expression %></code>
                      <% end %>
                    </td>
                    <td>
                      <% if task.next_run_at %>
                        <span title="<%= task.next_run_at.strftime('%Y-%m-%d %H:%M %Z') %>">
                          <%= time_ago_in_words(task.next_run_at) %> from now
                        </span>
                      <% else %>
                        <span class="text-muted">—</span>
                      <% end %>
                    </td>
                    <td>
                      <% if task.last_run_at %>
                        <span title="<%= task.last_run_at.strftime('%Y-%m-%d %H:%M %Z') %>">
                          <%= time_ago_in_words(task.last_run_at) %> ago
                        </span>
                      <% else %>
                        <span class="text-muted">Never</span>
                      <% end %>
                    </td>
                    <td>
                      <% case task.status %>
                      <% when 'active' %>
                        <span class="badge bg-success">Active</span>
                      <% when 'paused' %>
                        <span class="badge bg-warning text-dark">Paused</span>
                      <% when 'completed' %>
                        <span class="badge bg-info">Completed</span>
                      <% when 'failed' %>
                        <span class="badge bg-danger">Failed</span>
                      <% else %>
                        <span class="badge bg-secondary"><%= task.status.titleize %></span>
                      <% end %>
                      <% if task.consecutive_failures > 0 %>
                        <span class="badge bg-danger ms-1" title="<%= task.consecutive_failures %> consecutive failures">
                          <%= task.consecutive_failures %> fails
                        </span>
                      <% end %>
                    </td>
                    <td>
                      <span class="badge bg-secondary"><%= task.run_count %></span>
                      <% if task.failure_count > 0 %>
                        <span class="badge bg-danger ms-1"><%= task.failure_count %> failed</span>
                      <% end %>
                    </td>
                    <td>
                      <div class="btn-group btn-group-sm">
                        <% if task.status == 'active' %>
                          <%= button_to pause_scheduled_task_path(task), method: :post, class: "btn btn-outline-warning", title: "Pause", data: { turbo_confirm: "Pause this task?" } do %>
                            <i data-lucide="pause" style="width: 14px; height: 14px;"></i>
                          <% end %>
                        <% elsif task.status == 'paused' %>
                          <%= button_to resume_scheduled_task_path(task), method: :post, class: "btn btn-outline-success", title: "Resume" do %>
                            <i data-lucide="play" style="width: 14px; height: 14px;"></i>
                          <% end %>
                        <% end %>
                        <%= button_to run_now_scheduled_task_path(task), method: :post, class: "btn btn-outline-primary", title: "Run Now" do %>
                          <i data-lucide="zap" style="width: 14px; height: 14px;"></i>
                        <% end %>
                        <%= link_to edit_scheduled_task_path(task), class: "btn btn-outline-secondary", title: "Edit" do %>
                          <i data-lucide="edit" style="width: 14px; height: 14px;"></i>
                        <% end %>
                        <%= button_to scheduled_task_path(task), method: :delete, class: "btn btn-outline-danger", title: "Delete", data: { turbo_confirm: "Are you sure you want to delete this task?" } do %>
                          <i data-lucide="trash-2" style="width: 14px; height: 14px;"></i>
                        <% end %>
                      </div>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        <% else %>
          <div class="text-center py-5">
            <i data-lucide="calendar-clock" style="width: 48px; height: 48px; color: #64748B;" class="mb-3"></i>
            <h5 class="text-muted">No Scheduled Tasks Yet</h5>
            <p class="text-muted mb-4">Create your first scheduled task to automate recurring work.</p>
            <%= link_to new_scheduled_task_path, class: "admin-btn admin-btn-primary" do %>
              <i data-lucide="plus"></i>
              Create Your First Task
            <% end %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>

<style>
  .task-name-link {
    color: var(--text-primary);
  }
  
  .task-name-link:hover {
    color: var(--purple);
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    if (typeof lucide !== 'undefined') lucide.createIcons();
  });
</script>

