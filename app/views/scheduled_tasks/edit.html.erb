<div class="container-fluid">
  <nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb">
      <li class="breadcrumb-item"><%= link_to "Scheduled Tasks", scheduled_tasks_path %></li>
      <li class="breadcrumb-item"><%= link_to @scheduled_task.name, scheduled_task_path(@scheduled_task) %></li>
      <li class="breadcrumb-item active">Edit</li>
    </ol>
  </nav>
  
  <div class="mb-4">
    <h1 class="h3 mb-0 text-white">
      <i data-lucide="edit" style="color: #A78BFA;"></i>
      Edit Scheduled Task
    </h1>
    <p class="text-muted">Update the settings for "<%= @scheduled_task.name %>"</p>
  </div>

  <%= render 'form' %>
</div>

