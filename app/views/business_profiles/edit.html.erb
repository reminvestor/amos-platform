<div class="container-fluid">
  <div class="row mb-4">
    <div class="col-12">
      <div class="d-sm-flex align-items-center justify-content-between">
        <h1 class="h3 mb-0 text-gray-800">Business Profile Settings</h1>
        <div>
          <%= link_to scout_path, class: "btn btn-outline-secondary" do %>
            <i data-lucide="arrow-left" class="me-1"></i> Back to Dashboard
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <div class="row">
    <div class="col-12">
      <div class="card">
        <div class="card-header">
          <ul class="nav nav-tabs card-header-tabs" id="profileTabs" role="tablist">
            <li class="nav-item" role="presentation">
              <button class="nav-link active" id="basic-info-tab" data-bs-toggle="tab" data-bs-target="#basic-info" type="button" role="tab" aria-controls="basic-info" aria-selected="true">
                <i data-lucide="building" class="me-1"></i> Basic Info
              </button>
            </li>
            <li class="nav-item" role="presentation">
              <button class="nav-link" id="brand-tab" data-bs-toggle="tab" data-bs-target="#brand" type="button" role="tab" aria-controls="brand" aria-selected="false">
                <i data-lucide="paintbrush" class="me-1"></i> Brand & Voice
              </button>
            </li>
            <li class="nav-item" role="presentation">
              <button class="nav-link" id="knowledge-tab" data-bs-toggle="tab" data-bs-target="#knowledge" type="button" role="tab" aria-controls="knowledge" aria-selected="false">
                <i data-lucide="brain" class="me-1"></i> Knowledge Base
              </button>
            </li>
            <li class="nav-item" role="presentation">
              <button class="nav-link" id="style-tab" data-bs-toggle="tab" data-bs-target="#style" type="button" role="tab" aria-controls="style" aria-selected="false">
                <i data-lucide="palette" class="me-1"></i> Style Guidelines
              </button>
            </li>
          </ul>
        </div>
        <div class="card-body">
          <div class="tab-content" id="profileTabsContent">
            <!-- Basic Info Tab -->
            <div class="tab-pane fade show active" id="basic-info" role="tabpanel" aria-labelledby="basic-info-tab">
              <%= form_with(model: @business_profile, local: true) do |f| %>
                <% if @business_profile.errors.any? %>
                  <div class="alert alert-danger">
                    <h4><%= pluralize(@business_profile.errors.count, "error") %> prohibited this profile from being saved:</h4>
                    <ul>
                      <% @business_profile.errors.full_messages.each do |message| %>
                        <li><%= message %></li>
                      <% end %>
                    </ul>
                  </div>
                <% end %>

                <div class="row mb-3">
                  <div class="col-md-6">
                    <%= f.label :name, "Business Name", class: "form-label" %>
                    <%= f.text_field :name, class: "form-control", placeholder: "Your Business Name" %>
                  </div>
                  <div class="col-md-6">
                    <%= f.label :industry, class: "form-label" %>
                    <%= f.text_field :industry, class: "form-control", placeholder: "e.g. Technology, Healthcare, Finance" %>
                  </div>
                </div>

                <div class="mb-3">
                  <%= f.label :description, "Business Description", class: "form-label" %>
                  <%= f.text_area :description, class: "form-control", rows: 4, placeholder: "Describe your business, products, and services" %>
                </div>

                <div class="row mb-3">
                  <div class="col-md-6">
                    <%= f.label :founded_year, class: "form-label" %>
                    <%= f.number_field :founded_year, class: "form-control", placeholder: "e.g. 2010" %>
                  </div>
                  <div class="col-md-6">
                    <%= f.label :website, class: "form-label" %>
                    <%= f.url_field :website, class: "form-control", placeholder: "https://www.yourbusiness.com" %>
                  </div>
                </div>

                <div class="text-end">
                  <%= f.submit "Save Basic Info", class: "btn btn-primary" %>
                </div>
              <% end %>
            </div>

            <!-- Brand & Voice Tab -->
            <div class="tab-pane fade" id="brand" role="tabpanel" aria-labelledby="brand-tab">
              <%= form_with(model: @business_profile, local: true) do |f| %>
                <div class="mb-3">
                  <%= f.label :values, "Core Values & Mission", class: "form-label" %>
                  <%= f.text_area :values, class: "form-control", rows: 4, placeholder: "Describe your business values, mission, and what you stand for" %>
                </div>

                <div class="mb-3">
                  <%= f.label :target_audience, "Target Audience", class: "form-label" %>
                  <%= f.text_area :target_audience, class: "form-control", rows: 4, placeholder: "Describe your ideal customers or audience - demographics, interests, pain points" %>
                </div>

                <div class="mb-3">
                  <%= f.label :tone_of_voice, "Brand Voice", class: "form-label" %>
                  <%= f.text_area :tone_of_voice, class: "form-control", rows: 4, placeholder: "Describe how your brand communicates - formal/casual, serious/playful, professional/friendly" %>
                </div>

                <div class="text-end">
                  <%= f.submit "Save Brand Information", class: "btn btn-primary" %>
                </div>
              <% end %>
            </div>

            <!-- Knowledge Base Tab -->
            <div class="tab-pane fade" id="knowledge" role="tabpanel" aria-labelledby="knowledge-tab">
              <div class="mb-4">
                <h5>Add to Knowledge Base</h5>
                <p class="text-muted">
                  Add specific information about your business that will help generate better social media content.
                  This could include product details, services, event information, company milestones, etc.
                </p>

                <%= form_with(url: add_knowledge_business_profile_path, method: :post, local: true) do |f| %>
                  <div class="mb-3">
                    <%= f.label :section_name, "Section Name", class: "form-label" %>
                    <%= f.text_field :section_name, class: "form-control", placeholder: "e.g. Products, Services, Events, Milestones" %>
                    <div class="form-text">Give this knowledge section a descriptive name</div>
                  </div>

                  <div class="mb-3">
                    <%= f.label :content, "Content", class: "form-label" %>
                    <%= f.text_area :content, class: "form-control", rows: 6, placeholder: "Add detailed information about this aspect of your business" %>
                  </div>

                  <div class="text-end">
                    <%= f.submit "Add to Knowledge Base", class: "btn btn-success" %>
                  </div>
                <% end %>
              </div>

              <hr>

              <div class="mt-4">
                <h5>Current Knowledge Base</h5>
                
                <% if @business_profile.knowledge_base.present? && @business_profile.knowledge_base.any? %>
                  <div class="accordion" id="knowledgeAccordion">
                    <% @business_profile.knowledge_base.each_with_index do |(section, content), index| %>
                      <div class="accordion-item">
                        <h2 class="accordion-header" id="heading<%= index %>">
                          <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapse<%= index %>" aria-expanded="false" aria-controls="collapse<%= index %>">
                            <%= section %>
                          </button>
                        </h2>
                        <div id="collapse<%= index %>" class="accordion-collapse collapse" aria-labelledby="heading<%= index %>" data-bs-parent="#knowledgeAccordion">
                          <div class="accordion-body">
                            <p><%= simple_format(content) %></p>
                          </div>
                        </div>
                      </div>
                    <% end %>
                  </div>
                <% else %>
                  <div class="alert alert-info">
                    <p class="mb-0">Your knowledge base is empty. Add sections above to help generate better content.</p>
                  </div>
                <% end %>
              </div>
            </div>
            
            <!-- Style Guidelines Tab -->
            <div class="tab-pane fade" id="style" role="tabpanel" aria-labelledby="style-tab">
              <div class="mb-4">
                <h5>Landing Page Style Guidelines</h5>
                <p class="text-muted">
                  Define your brand's visual style for AI-generated landing pages. These will be automatically applied to all new landing pages.
                </p>

                <%= form_with(model: @business_profile, url: update_style_guidelines_business_profile_path, method: :patch, local: false, data: { turbo: false }) do |f| %>
                  <div class="row mb-3">
                    <div class="col-md-6">
                      <%= label_tag 'colors', "Brand Colors", class: "form-label" %>
                      <%= text_area_tag 'style_guidelines[colors][]', 
                          (@business_profile.style_guidelines&.dig('colors') || []).join("\n"),
                          class: "form-control font-monospace", 
                          rows: 4,
                          placeholder: "#667eea\n#764ba2\n#4F46E5\n(Enter hex codes, one per line)" %>
                      <div class="form-text">Hex color codes for your brand palette</div>
                    </div>
                    <div class="col-md-6">
                      <label class="form-label">Color Preview</label>
                      <div class="d-flex gap-2 flex-wrap" id="colorPreview">
                        <% (@business_profile.style_guidelines&.dig('colors') || []).each do |color| %>
                          <div style="width: 60px; height: 60px; background-color: <%= color %>; border-radius: 8px; border: 2px solid #dee2e6;" title="<%= color %>"></div>
                        <% end %>
                      </div>
                    </div>
                  </div>

                  <div class="mb-3">
                    <%= label_tag 'typography', "Typography Style", class: "form-label" %>
                    <%= text_field_tag 'style_guidelines[typography]', 
                        @business_profile.style_guidelines&.dig('typography'),
                        class: "form-control",
                        placeholder: "e.g. Modern sans-serif, Classic serif, Clean and minimal" %>
                    <div class="form-text">Describe your preferred typography style</div>
                  </div>

                  <div class="mb-3">
                    <%= label_tag 'aesthetic', "Overall Aesthetic", class: "form-label" %>
                    <%= text_field_tag 'style_guidelines[aesthetic]', 
                        @business_profile.style_guidelines&.dig('aesthetic'),
                        class: "form-control",
                        placeholder: "e.g. Professional and trustworthy, Bold and energetic, Calm and reassuring" %>
                    <div class="form-text">Describe the mood and feel of your brand</div>
                  </div>

                  <div class="mb-3">
                    <%= label_tag 'logo_url', "Logo URL (optional)", class: "form-label" %>
                    <%= text_field_tag 'style_guidelines[logo_url]', 
                        @business_profile.style_guidelines&.dig('logo_url'),
                        class: "form-control",
                        placeholder: "/assets/your-logo.png or https://..." %>
                    <div class="form-text">URL to your logo image</div>
                  </div>

                  <div class="alert alert-info">
                    <i data-lucide="lightbulb" class="me-2"></i>
                    <strong>Tip:</strong> These guidelines will be automatically used when generating landing pages. 
                    You can also upload screenshots for design inspiration when creating a new page!
                  </div>

                  <div class="text-end">
                    <%= f.submit "Save Style Guidelines", class: "btn btn-primary" %>
                  </div>
                <% end %>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
// Live color preview
document.addEventListener('DOMContentLoaded', function() {
  const colorInput = document.querySelector('textarea[name="style_guidelines[colors][]"]');
  const colorPreview = document.getElementById('colorPreview');
  
  if (colorInput && colorPreview) {
    colorInput.addEventListener('input', function() {
      const colors = this.value.split('\n').filter(c => c.trim().startsWith('#'));
      colorPreview.innerHTML = colors.map(color => 
        `<div style="width: 60px; height: 60px; background-color: ${color.trim()}; border-radius: 8px; border: 2px solid #dee2e6;" title="${color.trim()}"></div>`
      ).join('');
    });
  }
});
</script>
