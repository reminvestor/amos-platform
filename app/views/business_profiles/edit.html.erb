<div class="container-fluid py-4">
  <%# Page Header %>
  <div class="admin-page-header">
    <div class="header-left">
      <div class="header-icon">
        <i data-lucide="briefcase"></i>
      </div>
      <div class="header-text">
        <h1>Business Profile Settings</h1>
        <p>Manage your business information and brand guidelines</p>
      </div>
    </div>

    <div class="header-actions">
      <%= link_to chat_mode_path, class: "admin-btn admin-btn-outline" do %>
        <i data-lucide="arrow-left"></i>
        <span>Back to Chat</span>
      <% end %>
    </div>
  </div>

  <div class="row">
    <div class="col-12">
      <div class="admin-card">
        <style>
          /* Tab styling for admin dark theme */
          .nav-tabs {
            border-bottom: 1px solid #1E293B;
            margin-bottom: 2rem;
          }
          
          .nav-tabs .nav-link {
            color: #94A3B8;
            background: transparent;
            border: none;
            border-bottom: 2px solid transparent;
            padding: 0.75rem 1.5rem;
            font-size: 0.875rem;
            font-weight: 500;
            display: flex;
            align-items: center;
            gap: 0.5rem;
            transition: all 0.2s ease;
          }
          
          .nav-tabs .nav-link:hover {
            color: white;
            background: transparent;
            border-color: transparent;
          }
          
          .nav-tabs .nav-link.active {
            color: #A78BFA;
            background: transparent;
            border-color: #A78BFA;
          }
          
          .nav-tabs .nav-link i {
            width: 1rem;
            height: 1rem;
          }
          
          /* Alert styling */
          .alert-danger {
            background: rgba(239, 68, 68, 0.1);
            border: 1px solid rgba(239, 68, 68, 0.2);
            color: #EF4444;
          }
          
          .alert-info {
            background: rgba(124, 58, 237, 0.1);
            border: 1px solid rgba(124, 58, 237, 0.2);
            color: #A78BFA;
          }
        </style>
        
        <ul class="nav nav-tabs" id="profileTabs" role="tablist">
          <li class="nav-item" role="presentation">
            <button class="nav-link active" id="basic-info-tab" data-bs-toggle="tab" data-bs-target="#basic-info" type="button" role="tab" aria-controls="basic-info" aria-selected="true">
              <i data-lucide="building"></i>
              <span>Basic Info</span>
            </button>
          </li>
          <li class="nav-item" role="presentation">
            <button class="nav-link" id="brand-tab" data-bs-toggle="tab" data-bs-target="#brand" type="button" role="tab" aria-controls="brand" aria-selected="false">
              <i data-lucide="paintbrush"></i>
              <span>Brand & Voice</span>
            </button>
          </li>
          <li class="nav-item" role="presentation">
            <button class="nav-link" id="knowledge-tab" data-bs-toggle="tab" data-bs-target="#knowledge" type="button" role="tab" aria-controls="knowledge" aria-selected="false">
              <i data-lucide="brain"></i>
              <span>Knowledge Base</span>
            </button>
          </li>
          <li class="nav-item" role="presentation">
            <button class="nav-link" id="style-tab" data-bs-toggle="tab" data-bs-target="#style" type="button" role="tab" aria-controls="style" aria-selected="false">
              <i data-lucide="palette"></i>
              <span>Style Guidelines</span>
            </button>
          </li>
        </ul>
        
        <div class="tab-content" id="profileTabsContent">
            <!-- Basic Info Tab -->
            <div class="tab-pane fade show active" id="basic-info" role="tabpanel" aria-labelledby="basic-info-tab">
              <%= form_with(model: @business_profile, local: true) do |f| %>
                <% if @business_profile.errors.any? %>
                  <div class="alert alert-danger mb-4">
                    <h5 class="mb-2"><%= pluralize(@business_profile.errors.count, "error") %> prohibited this profile from being saved:</h5>
                    <ul class="mb-0" style="padding-left: 1.5rem;">
                      <% @business_profile.errors.full_messages.each do |message| %>
                        <li><%= message %></li>
                      <% end %>
                    </ul>
                  </div>
                <% end %>

                <div class="row mb-4">
                  <div class="col-md-6">
                    <div class="admin-form-group">
                      <%= f.label :name, "Business Name", class: "admin-label" %>
                      <%= f.text_field :name, class: "admin-input", placeholder: "Your Business Name" %>
                    </div>
                  </div>
                  <div class="col-md-6">
                    <div class="admin-form-group">
                      <%= f.label :industry, class: "admin-label" %>
                      <%= f.text_field :industry, class: "admin-input", placeholder: "e.g. Technology, Healthcare, Finance" %>
                    </div>
                  </div>
                </div>

                <div class="admin-form-group mb-4">
                  <%= f.label :description, "Business Description", class: "admin-label" %>
                  <%= f.text_area :description, class: "admin-input", rows: 4, placeholder: "Describe your business, products, and services" %>
                </div>

                <div class="row mb-4">
                  <div class="col-md-6">
                    <div class="admin-form-group">
                      <%= f.label :founded_year, class: "admin-label" %>
                      <%= f.number_field :founded_year, class: "admin-input", placeholder: "e.g. 2010" %>
                    </div>
                  </div>
                  <div class="col-md-6">
                    <div class="admin-form-group">
                      <%= f.label :website, class: "admin-label" %>
                      <%= f.url_field :website, class: "admin-input", placeholder: "https://www.yourbusiness.com" %>
                    </div>
                  </div>
                </div>

                <div class="text-end">
                  <%= f.submit "Save Basic Info", class: "admin-btn admin-btn-primary" %>
                </div>
              <% end %>
            </div>

            <!-- Brand & Voice Tab -->
            <div class="tab-pane fade" id="brand" role="tabpanel" aria-labelledby="brand-tab">
              <%= form_with(model: @business_profile, local: true) do |f| %>
                <div class="admin-form-group mb-4">
                  <%= f.label :values, "Core Values & Mission", class: "admin-label" %>
                  <%= f.text_area :values, class: "admin-input", rows: 4, placeholder: "Describe your business values, mission, and what you stand for" %>
                </div>

                <div class="admin-form-group mb-4">
                  <%= f.label :target_audience, "Target Audience", class: "admin-label" %>
                  <%= f.text_area :target_audience, class: "admin-input", rows: 4, placeholder: "Describe your ideal customers or audience - demographics, interests, pain points" %>
                </div>

                <div class="admin-form-group mb-4">
                  <%= f.label :tone_of_voice, "Brand Voice", class: "admin-label" %>
                  <%= f.text_area :tone_of_voice, class: "admin-input", rows: 4, placeholder: "Describe how your brand communicates - formal/casual, serious/playful, professional/friendly" %>
                </div>

                <div class="text-end">
                  <%= f.submit "Save Brand Information", class: "admin-btn admin-btn-primary" %>
                </div>
              <% end %>
            </div>

            <!-- Knowledge Base Tab -->
            <div class="tab-pane fade" id="knowledge" role="tabpanel" aria-labelledby="knowledge-tab">
              <div class="mb-4">
                <h5 style="color: white; margin-bottom: 1rem;">Add to Knowledge Base</h5>
                <p style="color: #94A3B8; font-size: 0.875rem;">Scout will use this information when creating marketing content.</p>
                
                <%= form_with url: add_knowledge_business_profile_path, method: :post, local: true do |f| %>
                  <div class="admin-form-group mb-3">
                    <%= f.text_field :section_name, class: "admin-input", placeholder: "Section Name (e.g., Product Features, Awards, Team)" %>
                  </div>
                  <div class="admin-form-group mb-3">
                    <%= f.text_area :content, class: "admin-input", rows: 5, placeholder: "Add detailed information about this section..." %>
                  </div>
                  <div class="text-end">
                    <%= f.submit "Add to Knowledge Base", class: "admin-btn admin-btn-primary" %>
                  </div>
                <% end %>
              </div>

              <% if @business_profile.business_knowledge.any? %>
                <div style="border-top: 1px solid #1E293B; padding-top: 2rem;">
                  <h5 style="color: white; margin-bottom: 1rem;">Existing Knowledge Base</h5>
                  <div style="max-height: 400px; overflow-y: auto;">
                    <% @business_profile.business_knowledge.each do |section_name, content| %>
                      <div class="admin-card" style="background: #0F172A; margin-bottom: 1rem;">
                        <h6 style="color: #A78BFA; margin-bottom: 0.75rem;"><%= section_name %></h6>
                        <div style="color: #94A3B8; font-size: 0.875rem; white-space: pre-wrap;"><%= content %></div>
                      </div>
                    <% end %>
                  </div>
                </div>
              <% else %>
                <div class="admin-empty-state" style="margin-top: 3rem;">
                  <div class="empty-icon">
                    <i data-lucide="book-open"></i>
                  </div>
                  <h5 style="color: white;">No Knowledge Base Entries Yet</h5>
                  <p style="color: #94A3B8;">Add information about your business that Scout can reference when creating content.</p>
                </div>
              <% end %>
            </div>

            <!-- Style Guidelines Tab -->
            <div class="tab-pane fade" id="style" role="tabpanel" aria-labelledby="style-tab">
              <div>
                <h5 style="color: white; margin-bottom: 1rem;">Visual Style Guidelines</h5>
                <p style="color: #94A3B8; font-size: 0.875rem; margin-bottom: 2rem;">Define your brand's visual identity for AI-generated content.</p>
                
                <%= form_with model: @business_profile, local: true do |f| %>
                  <div class="admin-form-group mb-4">
                    <%= label_tag 'colors', "Brand Colors", class: "admin-label" %>
                    <%= text_area_tag 'style_guidelines[colors][]', 
                        @business_profile.style_guidelines&.dig('colors')&.join("\n"),
                        class: "admin-input",
                        rows: 3,
                        placeholder: "#7C3AED\n#A78BFA\n#22C55E" %>
                    <small style="color: #64748B; display: block; margin-top: 0.25rem;">Enter one hex color per line</small>
                    <div id="colorPreview" style="display: flex; gap: 10px; margin-top: 10px; flex-wrap: wrap;">
                      <% if @business_profile.style_guidelines&.dig('colors').present? %>
                        <% @business_profile.style_guidelines['colors'].each do |color| %>
                          <div style="width: 60px; height: 60px; background-color: <%= color %>; border-radius: 8px; border: 2px solid #1E293B;" title="<%= color %>"></div>
                        <% end %>
                      <% end %>
                    </div>
                  </div>

                  <div class="admin-form-group mb-4">
                    <%= label_tag 'typography', "Typography Style", class: "admin-label" %>
                    <%= text_field_tag 'style_guidelines[typography]', 
                        @business_profile.style_guidelines&.dig('typography'),
                        class: "admin-input",
                        placeholder: "e.g. Modern sans-serif, Classic serif, Clean and minimal" %>
                    <small style="color: #64748B; display: block; margin-top: 0.25rem;">Describe your preferred typography style</small>
                  </div>

                  <div class="admin-form-group mb-4">
                    <%= label_tag 'aesthetic', "Overall Aesthetic", class: "admin-label" %>
                    <%= text_field_tag 'style_guidelines[aesthetic]', 
                        @business_profile.style_guidelines&.dig('aesthetic'),
                        class: "admin-input",
                        placeholder: "e.g. Professional and trustworthy, Bold and energetic, Calm and reassuring" %>
                    <small style="color: #64748B; display: block; margin-top: 0.25rem;">Describe the mood and feel of your brand</small>
                  </div>

                  <div class="admin-form-group mb-4">
                    <%= label_tag 'logo_url', "Logo URL (optional)", class: "admin-label" %>
                    <%= text_field_tag 'style_guidelines[logo_url]', 
                        @business_profile.style_guidelines&.dig('logo_url'),
                        class: "admin-input",
                        placeholder: "/assets/your-logo.png or https://..." %>
                    <small style="color: #64748B; display: block; margin-top: 0.25rem;">URL to your logo image</small>
                  </div>

                  <div class="alert alert-info">
                    <i data-lucide="lightbulb" style="width: 1.25rem; height: 1.25rem; display: inline-block; margin-right: 0.5rem;"></i>
                    <strong>Tip:</strong> These guidelines will be automatically used when generating landing pages. 
                    You can also upload screenshots for design inspiration when creating a new page!
                  </div>

                  <div class="text-end">
                    <%= f.submit "Save Style Guidelines", class: "admin-btn admin-btn-primary" %>
                  </div>
                <% end %>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
  // Initialize Lucide icons
  if (typeof lucide !== 'undefined') {
    lucide.createIcons();
  }

  // Live color preview
  const colorInput = document.querySelector('textarea[name="style_guidelines[colors][]"]');
  const colorPreview = document.getElementById('colorPreview');
  
  if (colorInput && colorPreview) {
    colorInput.addEventListener('input', function() {
      const colors = this.value.split('\n').filter(c => c.trim().startsWith('#'));
      colorPreview.innerHTML = colors.map(color => 
        `<div style="width: 60px; height: 60px; background-color: ${color.trim()}; border-radius: 8px; border: 2px solid #1E293B;" title="${color.trim()}"></div>`
      ).join('');
    });
  }
});

// Re-initialize icons on Turbo load
document.addEventListener('turbo:load', function() {
  if (typeof lucide !== 'undefined') {
    lucide.createIcons();
  }
});
</script>