
<div class="container-fluid py-4">
  <%# Page Header %>
  <div class="admin-page-header">
    <div class="header-left">
      <div class="header-icon" style="background: linear-gradient(135deg, #22D3EE 0%, #06B6D4 100%);">
        <i data-lucide="plug"></i>
      </div>
      <div class="header-text">
        <h1>Connected Accounts & Integrations</h1>
        <p>Manage your external application connections - Stripe, Mailgun, social media, and more</p>
      </div>
    </div>
  </div>

  <%# Active Connections %>
  <% if @connections.any? %>
    <div style="margin-bottom: 2.5rem;">
      <h5 style="color: #22D3EE; font-size: 1.125rem; font-weight: 600; margin-bottom: 1.5rem; display: flex; align-items: center; gap: 0.5rem;">
        <i data-lucide="check-circle" class="icon-lg"></i>
        <span>Your Active Connections (<%= @connections.count %>)</span>
      </h5>

      <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(400px, 1fr)); gap: 1.5rem;">
        <% @connections.each do |connection| %>
          <div class="admin-card">
            <div style="padding: 1.5rem;">
              <%# Integration Header %>
              <div style="display: flex; align-items: center; gap: 0.75rem; margin-bottom: 1rem;">
                <% if connection.integration.icon_url.present? %>
                  <img src="<%= connection.integration.icon_url %>"
                       alt="<%= connection.integration.name %>"
                       style="width: 2.5rem; height: 2.5rem; border-radius: 0.5rem;">
                <% else %>
                  <div style="width: 2.5rem; height: 2.5rem; border-radius: 0.5rem; background: rgba(34, 211, 238, 0.1); display: flex; align-items: center; justify-content: center;">
                    <i data-lucide="box" class="icon-lg text-info"></i>
                  </div>
                <% end %>
                <div style="flex: 1;">
                  <h6 class="card-title mb-0"><%= connection.integration.name %></h6>
                  <small style="color: #94A3B8;"><%= connection.name %></small>
                </div>
              </div>

              <%# Status Badges %>
              <div style="display: flex; gap: 0.5rem; margin-bottom: 1rem;">
                <span class="admin-badge admin-badge-<%= connection.status == 'connected' ? 'success' : 'warning' %>">
                  <i data-lucide="<%= connection.status == 'connected' ? 'check-circle' : 'alert-circle' %>" class="icon-sm"></i>
                  <span><%= connection.status.humanize %></span>
                </span>
                <% if connection.integration_credentials.present? %>
                  <span class="admin-badge admin-badge-info">
                    <i data-lucide="key" class="icon-sm"></i>
                    <span>Authenticated</span>
                  </span>
                <% end %>
              </div>

              <%# Connection Details %>
              <div style="color: #94A3B8; font-size: 0.875rem; margin-bottom: 1rem;">
                <div style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.25rem;">
                  <i data-lucide="calendar-plus" class="icon-sm"></i>
                  <span>Connected <%= time_ago_in_words(connection.created_at) %> ago</span>
                </div>
                <% last_log = connection.integration_logs.maximum(:created_at) %>
                <% if last_log %>
                  <div style="display: flex; align-items: center; gap: 0.5rem;">
                    <i data-lucide="clock" class="icon-sm"></i>
                    <span>Last used <%= time_ago_in_words(last_log) %> ago</span>
                  </div>
                <% end %>
              </div>

              <%# Action Buttons %>
              <div style="display: flex; gap: 0.5rem;">
                <button class="admin-btn admin-btn-sm admin-btn-outline" onclick="testConnection(<%= connection.id %>, '<%= connection.integration.name %>')">
                  <i data-lucide="check"></i>
                  <span>Test</span>
                </button>
                <%= link_to connection_path(connection), method: :delete, class: "admin-btn admin-btn-sm admin-btn-outline",
                    style: "border-color: #ef4444; color: #ef4444;",
                    data: { turbo_method: :delete, turbo_confirm: "Disconnect from #{connection.integration.name}? You can reconnect anytime." } do %>
                  <i data-lucide="link-2-off"></i>
                  <span>Disconnect</span>
                <% end %>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>

  <%# Available Integrations %>
  <div>
    <h5 style="color: #22D3EE; font-size: 1.125rem; font-weight: 600; margin-bottom: 1.5rem; display: flex; align-items: center; gap: 0.5rem;">
      <i data-lucide="grid-3x3" class="icon-lg"></i>
      <span>Available Integrations</span>
    </h5>

    <% @integrations.group_by(&:category).each do |category, integrations| %>
      <div style="margin-bottom: 2.5rem;">
        <h6 style="color: #A78BFA; font-size: 1rem; font-weight: 600; margin-bottom: 1rem; display: flex; align-items: center; gap: 0.5rem;">
          <i data-lucide="folder" class="icon-md"></i>
          <span><%= category&.humanize || 'Other' %></span>
        </h6>

        <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 1.5rem;">
          <% integrations.each do |integration| %>
            <% is_connected = @connections.any? { |c| c.integration_id == integration.id && c.status == 'connected' } %>
            <div class="admin-card" style="<%= 'border-color: rgb(74, 222, 128);' if is_connected %>">
              <div style="padding: 1.5rem;">
                <%# Integration Header %>
                <div style="display: flex; align-items-start; gap: 0.75rem; margin-bottom: 1rem;">
                  <% if integration.icon_url.present? %>
                    <img src="<%= integration.icon_url %>"
                         alt="<%= integration.name %>"
                         style="width: 2rem; height: 2rem; border-radius: 0.375rem;">
                  <% else %>
                    <div style="width: 2rem; height: 2rem; border-radius: 0.375rem; background: rgba(168, 139, 250, 0.1); display: flex; align-items: center; justify-content: center;">
                      <i data-lucide="puzzle" style="width: 1rem; height: 1rem; color: #A78BFA;"></i>
                    </div>
                  <% end %>
                  <div style="flex: 1;">
                    <h6 class="card-title mb-0 d-flex align-items-center gap-1">
                      <span><%= integration.name %></span>
                      <% if integration.is_verified %>
                        <i data-lucide="badge-check" style="width: 1rem; height: 1rem; color: rgb(74, 222, 128);" title="Verified"></i>
                      <% end %>
                    </h6>
                    <small style="color: #94A3B8;"><%= integration.auth_type&.humanize %></small>
                  </div>
                </div>

                <%# Description %>
                <% if integration.description.present? %>
                  <p style="color: #94A3B8; font-size: 0.875rem; margin-bottom: 1rem; line-height: 1.5;">
                    <%= truncate(integration.description, length: 100) %>
                  </p>
                <% end %>

                <%# Footer %>
                <div style="display: flex; justify-content: space-between; align-items: center;">
                  <small style="color: #64748B; display: flex; align-items: center; gap: 0.25rem;">
                    <i data-lucide="zap" class="icon-sm"></i>
                    <%= pluralize(integration.integration_operations.count, 'operation') %>
                  </small>
                  <% if is_connected %>
                    <span class="admin-badge admin-badge-success">
                      <i data-lucide="check" class="icon-sm"></i>
                      <span>Connected</span>
                    </span>
                  <% else %>
                    <%= link_to connect_integration_path(integration.slug), class: "admin-btn admin-btn-sm admin-btn-primary" do %>
                      <i data-lucide="plug"></i>
                      <span>Connect</span>
                    <% end %>
                  <% end %>
                </div>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
</div>

<script>
  function testConnection(connectionId, integrationName) {
    console.log('Testing connection:', connectionId, integrationName);
    showInfo('Testing connection to ' + integrationName + '...');
    // TODO: Implement actual connection test
  }

  document.addEventListener('turbo:load', () => {
    if (typeof lucide !== 'undefined') {
      lucide.createIcons();
    }
  });

  document.addEventListener('DOMContentLoaded', () => {
    if (typeof lucide !== 'undefined') {
      lucide.createIcons();
    }
  });
</script>
