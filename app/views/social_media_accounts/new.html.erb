<div class="container-fluid">
  <div class="row mb-4">
    <div class="col-12">
      <div class="d-flex align-items-center">
        <a href="<%= social_media_accounts_path %>" class="btn btn-outline-secondary me-3">
          <i data-lucide="arrow-left"></i>
        </a>
        <h1 class="h3 mb-0 text-gray-800">Connect <%= @platform.titleize %> Account</h1>
      </div>
    </div>
  </div>

  <div class="row">
    <div class="col-md-8 offset-md-2">
      <div class="card">
        <div class="card-body text-center py-5">
          <% case @platform %>
          <% when 'facebook' %>
            <i data-lucide="facebook" style="width: 5rem; height: 5rem; color: #0A66C2; margin-bottom: 1rem; display: inline-block;"></i>
            <h3>Connect Facebook</h3>
            <p class="mb-4">
              Connecting your Facebook account will allow you to post directly to your Facebook Page
              as well as schedule posts for later. Your login credentials are secure and never stored on our servers.
            </p>
          <% when 'instagram' %>
            <i data-lucide="instagram" style="width: 5rem; height: 5rem; color: #E4405F; margin-bottom: 1rem; display: inline-block;"></i>
            <h3>Connect Instagram</h3>
            <p class="mb-4">
              Connecting your Instagram account will allow you to post directly to your Instagram Business account
              as well as schedule posts for later. Your login credentials are secure and never stored on our servers.
            </p>
          <% when 'linkedin' %>
            <i data-lucide="linkedin" style="width: 5rem; height: 5rem; color: #0A66C2; margin-bottom: 1rem; display: inline-block;"></i>
            <h3>Connect LinkedIn</h3>
            <p class="mb-4">
              Connecting your LinkedIn account will allow you to post directly to your LinkedIn profile or company page
              as well as schedule posts for later. Your login credentials are secure and never stored on our servers.
            </p>
          <% when 'twitter' %>
            <i data-lucide="twitter" style="width: 5rem; height: 5rem; color: #1DA1F2; margin-bottom: 1rem; display: inline-block;"></i>
            <h3>Connect Twitter</h3>
            <p class="mb-4">
              Connecting your Twitter account will allow you to post directly to your Twitter timeline
              as well as schedule tweets for later. Your login credentials are secure and never stored on our servers.
            </p>
          <% end %>

          <a href="<%= @oauth_url %>" class="btn btn-lg btn-primary">
            <i data-lucide="<%= @platform.downcase %>" style="width: 1rem; height: 1rem; margin-right: 0.5rem; display: inline-block;"></i>
            Authorize <%= @platform.titleize %>
          </a>
          
          <div class="mt-4">
            <small class="text-muted">
              <i data-lucide="lock" class="me-1"></i>
              All authorization is done securely through the official <%= @platform.titleize %> authentication system.
            </small>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
