<!-- Forgot Password Page - Theme-Aware -->
<div class="auth-workspace">
  <!-- Theme Toggle Button (Top Right) -->
  <button class="auth-theme-toggle" data-theme-toggle aria-label="Toggle theme">
    <i data-lucide="moon" data-theme-icon></i>
  </button>
  
  <!-- Left Panel - Branding & Info -->
  <div class="auth-sidebar">
    <div class="auth-brand">
      <div class="brand-logo">
        <%= image_tag "amospurpleLogo.png", style: "height: 6rem; width: auto;", alt: "AMOS Labs" %>
      </div>
      <p class="brand-tagline" style="margin-top: 0.5rem;">Your AI Business Automation Platform</p>
    </div>

    <div class="auth-features">
      <div class="feature-list">
        <div class="feature-item">
          <i data-lucide="shield-check" class="text-success"></i>
          <div>
            <strong>Secure Reset Process</strong>
            <p>We'll send a secure link to your email address</p>
          </div>
        </div>
        <div class="feature-item">
          <i data-lucide="clock" class="text-info"></i>
          <div>
            <strong>Quick & Easy</strong>
            <p>Reset your password in just a few simple steps</p>
          </div>
        </div>
        <div class="feature-item">
          <i data-lucide="help-circle" class="text-warning"></i>
          <div>
            <strong>Need Help?</strong>
            <p>Contact support@amoslabs.com if you need assistance</p>
          </div>
        </div>
      </div>
              </div>
  </div>
  
  <!-- Right Panel - Reset Form -->
  <div class="auth-content">
    <div class="auth-form-container">
      <div class="auth-header">
        <h2 class="mb-2">Reset Password</h2>
        <p class="auth-subtitle">Enter your email address and we'll send you reset instructions</p>
            </div>

            <!-- Flash messages -->
            <% if flash[:alert] %>
        <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert">
                <%= flash[:alert] %>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
              </div>
            <% end %>

      <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post, class: "auth-form" }) do |f| %>
              <%= render "devise/shared/error_messages", resource: resource %>

        <div class="form-group">
          <%= f.label :email, "Email Address", class: "form-label" %>
          <%= f.email_field :email,
              autofocus: true,
              autocomplete: "email",
              class: "form-control",
              placeholder: "Enter your email address" %>
              </div>

        <div class="form-group">
          <%= f.submit "Send Reset Instructions", class: "btn btn-primary btn-lg w-100" %>
              </div>
            <% end %>

      <div class="auth-divider">
        <span>Remember your password?</span>
            </div>
            
      <div class="auth-signin">
        <%= link_to "Back to Sign In", new_session_path(resource_name), class: "btn btn-outline-primary btn-lg w-100" %>
        </div>
        
      <div class="auth-footer">
        <p class="auth-footer-text">
          Don't have an account?
          <%= link_to "Sign up here", new_registration_path(resource_name), class: "auth-link" %>
          </p>
      </div>
    </div>
  </div>
</div>

<style>
/* Auth Pages - Theme-Aware (Light/Dark) */
.auth-workspace {
  min-height: 100vh;
  display: flex;
  position: relative;
  background: var(--bg-primary);
  color: var(--text-primary);
  transition: background-color 0.3s ease, color 0.3s ease;
}

.auth-theme-toggle {
  position: absolute;
  top: 1.5rem;
  right: 1.5rem;
  z-index: 1000;
  background: var(--bg-secondary);
  border: 1px solid var(--border-primary);
  border-radius: 0.5rem;
  width: 2.5rem;
  height: 2.5rem;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  transition: all 0.2s ease;
  color: var(--text-secondary);
}

.auth-theme-toggle:hover {
  background: var(--bg-hover);
  color: var(--text-primary);
  transform: translateY(-1px);
  box-shadow: var(--shadow-md);
}

.auth-theme-toggle i {
  width: 1.25rem;
  height: 1.25rem;
}

.auth-sidebar {
  width: 450px;
  background: var(--bg-secondary);
  padding: 3rem 2rem;
  display: flex;
  flex-direction: column;
  justify-content: center;
  border-right: 1px solid var(--border-primary);
}

.auth-brand {
  text-align: center;
  margin-bottom: 3rem;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.brand-logo {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 0.75rem;
  font-size: 1.75rem;
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: 0;
}

.brand-logo i {
  font-size: 2.5rem;
  color: var(--accent-purple-end);
}

.brand-tagline {
  color: var(--text-muted);
  margin: 0;
  font-size: 1.1rem;
  text-align: center;
}

.auth-features h4 {
  color: var(--text-primary);
  font-weight: 600;
}

.feature-list {
  display: flex;
  flex-direction: column;
  gap: 2rem;
}

.feature-item {
  display: flex;
  align-items: flex-start;
  gap: 1rem;
}

.feature-item i {
  font-size: 1.5rem;
  margin-top: 0.25rem;
}

.feature-item strong {
  color: var(--text-primary);
  display: block;
  margin-bottom: 0.5rem;
  font-size: 1.1rem;
}

.feature-item p {
  color: var(--text-muted);
  margin: 0;
  line-height: 1.4;
}

.auth-content {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 2rem;
  background: var(--bg-primary);
}

.auth-form-container {
  width: 100%;
  max-width: 420px;
}

.auth-header {
  text-align: center;
  margin-bottom: 2.5rem;
}

.auth-header h2 {
  color: var(--text-primary);
  font-weight: 700;
  font-size: 2rem;
}

.auth-subtitle {
  color: var(--text-muted);
  margin: 0;
  font-size: 1rem;
}

.auth-form {
  margin-bottom: 2rem;
}

.form-group {
  margin-bottom: 1.5rem;
}

.form-label {
  color: var(--text-primary);
  font-weight: 500;
  margin-bottom: 0.5rem;
  display: block;
}

.form-control {
  background: var(--bg-input);
  border: 1px solid var(--border-primary);
  color: var(--text-primary);
  border-radius: 0.5rem;
  padding: 0.75rem 1rem;
  font-size: 1rem;
  width: 100%;
  transition: all 0.2s ease;
}

  .form-control:focus {
  background: var(--bg-input);
  border-color: var(--accent-purple-end);
  box-shadow: 0 0 0 0.2rem rgba(124, 58, 237, 0.25);
  color: var(--text-primary);
  outline: none;
  }
  
.form-control::placeholder {
  color: var(--text-muted);
}

.btn-primary {
  background: linear-gradient(135deg, var(--accent-purple-start), var(--accent-purple-end));
  border: none;
  color: white;
  font-weight: 600;
  padding: 0.875rem 1.5rem;
  border-radius: 0.5rem;
  transition: all 0.2s ease;
}

.btn-primary:hover {
  opacity: 0.9;
  transform: translateY(-1px);
  box-shadow: 0 4px 12px rgba(124, 58, 237, 0.3);
  color: white;
}

.btn-outline-primary {
  color: var(--accent-purple-end);
  border: 1px solid var(--accent-purple-end);
  background: transparent;
  font-weight: 600;
  padding: 0.875rem 1.5rem;
  border-radius: 0.5rem;
  transition: all 0.2s ease;
}

.btn-outline-primary:hover {
  background: var(--accent-purple-end);
  border-color: var(--accent-purple-end);
  color: white;
  transform: translateY(-1px);
  box-shadow: 0 4px 12px rgba(124, 58, 237, 0.3);
}

.auth-link {
  color: var(--accent-purple-end);
  text-decoration: none;
  font-weight: 500;
  font-size: 0.9rem;
}

.auth-link:hover {
  color: var(--accent-purple-start);
  text-decoration: underline;
}

.auth-divider {
  text-align: center;
  margin: 2rem 0 1.5rem 0;
  position: relative;
}

.auth-divider::before {
  content: '';
  position: absolute;
  top: 50%;
  left: 0;
  right: 0;
  height: 1px;
  background: var(--border-primary);
}

.auth-divider span {
  position: relative;
  z-index: 1;
  background: var(--bg-primary);
  padding: 0 1rem;
  color: var(--text-muted);
  font-size: 0.9rem;
}

.auth-footer {
  margin-top: 2rem;
}

.auth-footer-text {
  color: var(--text-muted);
  font-size: 0.875rem;
  text-align: center;
  margin: 0;
}

/* Responsive Design */
@media (max-width: 768px) {
  .auth-workspace {
    flex-direction: column;
  }

  .auth-sidebar {
    width: 100%;
    padding: 2rem 1.5rem;
  }

  .auth-features {
    display: none;
  }

  .auth-content {
    padding: 1.5rem;
  }

  .auth-form-container {
    max-width: 100%;
  }
  
  .auth-theme-toggle {
    top: 1rem;
    right: 1rem;
  }
  }
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
  if (typeof lucide !== 'undefined') {
    lucide.createIcons();
  }
});
</script>
