<!-- Sign In Page - Theme-Aware -->
<div class="auth-workspace">
  <!-- Theme Toggle Button (Top Right) -->
  <button class="auth-theme-toggle" data-theme-toggle aria-label="Toggle theme">
    <i data-lucide="moon" data-theme-icon></i>
  </button>
  
  <!-- Left Panel - Branding & Info -->
  <div class="auth-sidebar">
    <div class="auth-brand">
      <div class="brand-logo">
        <%= image_tag "amospurpleLogo.png", style: "height: 6rem; width: auto;", alt: "AMOS Labs" %>
      </div>
      <p class="brand-tagline" style="margin-top: 0.5rem;">Your AI Business Automation Platform</p>
    </div>

    <div class="auth-features">
      <div class="feature-list">
        <div class="feature-item">
          <i data-lucide="bot" class="text-primary"></i>
          <div>
            <strong>Meet Amos, Your AI Assistant</strong>
            <p>Your intelligent business partner - automates tasks and provides insights</p>
          </div>
        </div>
        <div class="feature-item">
          <i data-lucide="zap" class="text-success"></i>
          <div>
            <strong>Workflow Automation</strong>
            <p>Automate repetitive tasks and streamline your operations</p>
          </div>
        </div>
        <div class="feature-item">
          <i data-lucide="plug" class="text-info"></i>
          <div>
            <strong>Integrations</strong>
            <p>Connect your favorite tools - CRM, email, analytics, and more</p>
          </div>
        </div>
        <div class="feature-item">
          <i data-lucide="bar-chart" class="text-warning"></i>
          <div>
            <strong>Analytics & Insights</strong>
            <p>Track performance and get AI-powered recommendations</p>
          </div>
        </div>
      </div>
    </div>
  </div>
  
  <!-- Right Panel - Login Form -->
  <div class="auth-content">
    <div class="auth-form-container">
      <div class="auth-header">
        <h2 class="mb-2">Welcome Back</h2>
      </div>
      
      <%# Flash messages for login errors, OAuth failures, etc. %>
      <% if flash[:alert].present? %>
        <div class="alert alert-danger alert-dismissible fade show mb-3" role="alert">
          <i data-lucide="alert-circle" class="me-2" style="width: 18px; height: 18px;"></i>
          <%= flash[:alert] %>
          <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
      <% end %>
      <% if flash[:notice].present? %>
        <div class="alert alert-success alert-dismissible fade show mb-3" role="alert">
          <i data-lucide="check-circle" class="me-2" style="width: 18px; height: 18px;"></i>
          <%= flash[:notice] %>
          <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
      <% end %>
      
      <%= form_for(resource, as: resource_name, url: session_path(resource_name), local: true, html: { class: "auth-form", id: "login-form" }) do |f| %>
        <% if Rails.env.development? || Rails.env.test? %>
          <div class="form-group">
            <label class="form-label">
              <i data-lucide="flask-conical" class="text-warning icon-md"></i> Quick Login (Dev Only)
            </label>
            <select id="quick-login-selector" class="form-control">
              <option value="">-- Select a test user --</option>
              <% User.includes(:entity).limit(10).each do |user| %>
                <option value="<%= user.email %>"
                        data-password="<%= Rails.application.credentials.dig(:dev_password) || 'Password123!' %>"
                        data-entity="<%= user.entity&.name %>">
                  <%= user.email %> (<%= user.entity&.name || 'No Entity' %>)
                </option>
              <% end %>
            </select>
            <small class="form-text">
              Select a user to auto-fill login credentials
            </small>
          </div>

          <div class="auth-divider">
            <span>or enter manually</span>
          </div>
        <% end %>

        <div class="form-group">
          <%= f.label :email, "Email", class: "form-label" %>
          <%= f.email_field :email,
              autofocus: true,
              autocomplete: "email",
              class: "form-control",
              placeholder: "Enter your email address",
              id: "user_email_field" %>
        </div>

        <div class="form-group">
          <%= f.label :password, "Password", class: "form-label" %>
          <%= f.password_field :password,
              autocomplete: "current-password",
              class: "form-control",
              placeholder: "Enter your password",
              id: "user_password" %>
        </div>

        <% if devise_mapping.rememberable? %>
          <div class="form-group">
            <div class="form-check">
              <%= f.check_box :remember_me, class: "form-check-input" %>
              <%= f.label :remember_me, "Remember me", class: "form-check-label" %>
            </div>
          </div>
        <% end %>

        <div class="form-group">
          <%= f.submit "Sign In", class: "btn btn-primary btn-lg w-100" %>
        </div>
      <% end %>

      <div class="auth-links">
        <%= link_to "Forgot your password?", new_password_path(resource_name), class: "auth-link" %>
      </div>

      <div class="auth-divider">
        <span>or continue with</span>
      </div>

      <div class="oauth-buttons">
        <% if ENV['GOOGLE_OAUTH_CLIENT_ID'].present? %>
          <%= button_to user_google_omniauth_authorize_path, method: :post, class: "btn btn-google w-100", data: { turbo: false } do %>
            <svg class="google-icon" viewBox="0 0 24 24" width="20" height="20" xmlns="http://www.w3.org/2000/svg">
              <g transform="matrix(1, 0, 0, 1, 27.009001, -39.238998)">
                <path fill="#4285F4" d="M -3.264 51.509 C -3.264 50.719 -3.334 49.969 -3.454 49.239 L -14.754 49.239 L -14.754 53.749 L -8.284 53.749 C -8.574 55.229 -9.424 56.479 -10.684 57.329 L -10.684 60.329 L -6.824 60.329 C -4.564 58.239 -3.264 55.159 -3.264 51.509 Z"/>
                <path fill="#34A853" d="M -14.754 63.239 C -11.514 63.239 -8.804 62.159 -6.824 60.329 L -10.684 57.329 C -11.764 58.049 -13.134 58.489 -14.754 58.489 C -17.884 58.489 -20.534 56.379 -21.484 53.529 L -25.464 53.529 L -25.464 56.619 C -23.494 60.539 -19.444 63.239 -14.754 63.239 Z"/>
                <path fill="#FBBC05" d="M -21.484 53.529 C -21.734 52.809 -21.864 52.039 -21.864 51.239 C -21.864 50.439 -21.724 49.669 -21.484 48.949 L -21.484 45.859 L -25.464 45.859 C -26.284 47.479 -26.754 49.299 -26.754 51.239 C -26.754 53.179 -26.284 54.999 -25.464 56.619 L -21.484 53.529 Z"/>
                <path fill="#EA4335" d="M -14.754 43.989 C -12.984 43.989 -11.404 44.599 -10.154 45.789 L -6.734 42.369 C -8.804 40.429 -11.514 39.239 -14.754 39.239 C -19.444 39.239 -23.494 41.939 -25.464 45.859 L -21.484 48.949 C -20.534 46.099 -17.884 43.989 -14.754 43.989 Z"/>
              </g>
            </svg>
            <span>Continue with Google</span>
          <% end %>
        <% else %>
          <button type="button" class="btn btn-google w-100 disabled" disabled title="Google Sign-In coming soon">
            <svg class="google-icon" viewBox="0 0 24 24" width="20" height="20" xmlns="http://www.w3.org/2000/svg">
              <g transform="matrix(1, 0, 0, 1, 27.009001, -39.238998)">
                <path fill="#4285F4" d="M -3.264 51.509 C -3.264 50.719 -3.334 49.969 -3.454 49.239 L -14.754 49.239 L -14.754 53.749 L -8.284 53.749 C -8.574 55.229 -9.424 56.479 -10.684 57.329 L -10.684 60.329 L -6.824 60.329 C -4.564 58.239 -3.264 55.159 -3.264 51.509 Z"/>
                <path fill="#34A853" d="M -14.754 63.239 C -11.514 63.239 -8.804 62.159 -6.824 60.329 L -10.684 57.329 C -11.764 58.049 -13.134 58.489 -14.754 58.489 C -17.884 58.489 -20.534 56.379 -21.484 53.529 L -25.464 53.529 L -25.464 56.619 C -23.494 60.539 -19.444 63.239 -14.754 63.239 Z"/>
                <path fill="#FBBC05" d="M -21.484 53.529 C -21.734 52.809 -21.864 52.039 -21.864 51.239 C -21.864 50.439 -21.724 49.669 -21.484 48.949 L -21.484 45.859 L -25.464 45.859 C -26.284 47.479 -26.754 49.299 -26.754 51.239 C -26.754 53.179 -26.284 54.999 -25.464 56.619 L -21.484 53.529 Z"/>
                <path fill="#EA4335" d="M -14.754 43.989 C -12.984 43.989 -11.404 44.599 -10.154 45.789 L -6.734 42.369 C -8.804 40.429 -11.514 39.239 -14.754 39.239 C -19.444 39.239 -23.494 41.939 -25.464 45.859 L -21.484 48.949 C -20.534 46.099 -17.884 43.989 -14.754 43.989 Z"/>
              </g>
            </svg>
            <span>Continue with Google</span>
            <small class="d-block mt-1 opacity-75" style="font-size: 0.7rem;">Coming Soon</small>
          </button>
        <% end %>
      </div>

      <div class="auth-divider">
        <span>Don't have an account?</span>
      </div>

      <div class="auth-signup">
        <%= link_to "Create Account", new_registration_path(resource_name), class: "btn btn-outline-primary btn-lg w-100" %>
      </div>

      <div class="auth-footer">
        <p class="auth-footer-text">
          By signing in, you agree to our
          <%= link_to "Terms of Service", terms_of_service_path, class: "auth-link", target: "_blank" %> and
          <%= link_to "Privacy Policy", privacy_policy_path, class: "auth-link", target: "_blank" %>
        </p>
      </div>
    </div>
  </div>
</div>

<style>
/* Auth Pages - Theme-Aware (Light/Dark) */
.auth-workspace {
  min-height: 100vh;
  display: flex;
  position: relative;
  background: var(--bg-primary);
  color: var(--text-primary);
  transition: background-color 0.3s ease, color 0.3s ease;
}

.auth-theme-toggle {
  position: absolute;
  top: 1.5rem;
  right: 1.5rem;
  z-index: 1000;
  background: var(--bg-secondary);
  border: 1px solid var(--border-primary);
  border-radius: 0.5rem;
  width: 2.5rem;
  height: 2.5rem;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  transition: all 0.2s ease;
  color: var(--text-secondary);
}

.auth-theme-toggle:hover {
  background: var(--bg-hover);
  color: var(--text-primary);
  transform: translateY(-1px);
  box-shadow: var(--shadow-md);
}

.auth-theme-toggle i {
  width: 1.25rem;
  height: 1.25rem;
}

.auth-sidebar {
  width: 450px;
  background: var(--bg-secondary);
  padding: 3rem 2rem;
  display: flex;
  flex-direction: column;
  justify-content: center;
  border-right: 1px solid var(--border-primary);
}

.auth-brand {
  text-align: center;
  margin-bottom: 3rem;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.brand-logo {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 0.75rem;
  font-size: 1.75rem;
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: 0;
}

.brand-logo i {
  font-size: 2.5rem;
  color: var(--accent-purple-end);
}

.brand-tagline {
  color: var(--text-muted);
  margin: 0;
  font-size: 1.1rem;
  text-align: center;
}

.auth-features h4 {
  color: var(--text-primary);
  font-weight: 600;
}

.feature-list {
  display: flex;
  flex-direction: column;
  gap: 2rem;
}

.feature-item {
  display: flex;
  align-items: flex-start;
  gap: 1rem;
}

.feature-item i {
  font-size: 1.5rem;
  margin-top: 0.25rem;
}

.feature-item strong {
  color: var(--text-primary);
  display: block;
  margin-bottom: 0.5rem;
  font-size: 1.1rem;
}

.feature-item p {
  color: var(--text-muted);
  margin: 0;
  line-height: 1.4;
}

.auth-content {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 2rem;
  background: var(--bg-primary);
}

.auth-form-container {
  width: 100%;
  max-width: 420px;
}

.auth-header {
  text-align: center;
  margin-bottom: 2.5rem;
}

.auth-header h2 {
  color: var(--text-primary);
  font-weight: 700;
  font-size: 2rem;
}

.auth-subtitle {
  color: var(--text-muted);
  margin: 0;
  font-size: 1rem;
}

.auth-form {
  margin-bottom: 2rem;
}

.form-group {
  margin-bottom: 1.5rem;
}

.form-label {
  color: var(--text-primary);
  font-weight: 500;
  margin-bottom: 0.5rem;
  display: block;
}

.form-control {
  background: var(--bg-input);
  border: 1px solid var(--border-primary);
  color: var(--text-primary);
  border-radius: 0.5rem;
  padding: 0.75rem 1rem;
  font-size: 1rem;
  width: 100%;
  transition: all 0.2s ease;
}

.form-control:focus {
  background: var(--bg-input);
  border-color: var(--accent-purple-end);
  box-shadow: 0 0 0 0.2rem rgba(124, 58, 237, 0.25);
  color: var(--text-primary);
  outline: none;
}

.form-control::placeholder {
  color: var(--text-muted);
}

.form-text {
  color: var(--text-muted);
  font-size: 0.875rem;
  margin-top: 0.25rem;
  display: block;
}

.form-check-input {
  background-color: var(--bg-input);
  border-color: var(--border-primary);
}

.form-check-input:checked {
  background-color: var(--accent-purple-end);
  border-color: var(--accent-purple-end);
}

.form-check-label {
  color: var(--text-primary) !important;
}

.btn-primary {
  background: linear-gradient(135deg, var(--accent-purple-start), var(--accent-purple-end));
  border: none;
  color: white;
  font-weight: 600;
  padding: 0.875rem 1.5rem;
  border-radius: 0.5rem;
  transition: all 0.2s ease;
}

.btn-primary:hover {
  opacity: 0.9;
  transform: translateY(-1px);
  box-shadow: 0 4px 12px rgba(124, 58, 237, 0.3);
  color: white;
}

.btn-outline-primary {
  color: var(--accent-purple-end);
  border: 1px solid var(--accent-purple-end);
  background: transparent;
  font-weight: 600;
  padding: 0.875rem 1.5rem;
  border-radius: 0.5rem;
  transition: all 0.2s ease;
}

.btn-outline-primary:hover {
  background: var(--accent-purple-end);
  border-color: var(--accent-purple-end);
  color: white;
  transform: translateY(-1px);
  box-shadow: 0 4px 12px rgba(124, 58, 237, 0.3);
}

.auth-links {
  text-align: center;
  margin-bottom: 1.5rem;
}

.auth-link {
  color: var(--accent-purple-end);
  text-decoration: none;
  font-weight: 500;
  font-size: 0.9rem;
}

.auth-link:hover {
  color: var(--accent-purple-start);
  text-decoration: underline;
}

.auth-divider {
  text-align: center;
  margin: 2rem 0 1.5rem 0;
  position: relative;
}

.auth-divider::before {
  content: '';
  position: absolute;
  top: 50%;
  left: 0;
  right: 0;
  height: 1px;
  background: var(--border-primary);
}

.auth-divider span {
  position: relative;
  z-index: 1;
  background: var(--bg-primary);
  padding: 0 1rem;
  color: var(--text-muted);
  font-size: 0.9rem;
}

.auth-footer {
  margin-top: 2rem;
}

.auth-footer-text {
  color: var(--text-muted);
  font-size: 0.875rem;
  text-align: center;
  margin: 0;
}

/* Responsive Design */
@media (max-width: 768px) {
  .auth-workspace {
    flex-direction: column;
  }

  .auth-sidebar {
    width: 100%;
    padding: 2rem 1.5rem;
  }

  .auth-features {
    display: none;
  }

  .auth-content {
    padding: 1.5rem;
  }

  .auth-form-container {
    max-width: 100%;
  }
  
  .auth-theme-toggle {
    top: 1rem;
    right: 1rem;
  }
}

/* Google OAuth Button */
.oauth-buttons {
  margin-bottom: 1.5rem;
}

.btn-google {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 0.75rem;
  background: var(--bg-secondary);
  border: 1px solid var(--border-primary);
  color: var(--text-primary);
  font-weight: 500;
  padding: 0.875rem 1.5rem;
  border-radius: 0.5rem;
  transition: all 0.2s ease;
  cursor: pointer;
}

.btn-google:hover {
  background: var(--bg-hover);
  border-color: var(--border-secondary);
  transform: translateY(-1px);
  box-shadow: var(--shadow-md);
}

.google-icon {
  flex-shrink: 0;
}

/* Dev Quick Login */
#quick-login-selector {
  background-color: var(--bg-secondary);
  border-color: var(--accent-yellow);
  box-shadow: 0 0 0 2px rgba(251, 191, 36, 0.1);
}

.quick-login-success {
  border-color: #10b981 !important;
}

code {
  background: var(--bg-tertiary);
  padding: 0.2rem 0.4rem;
  border-radius: 0.25rem;
  color: var(--accent-yellow);
  font-size: 0.875rem;
}
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
  // Initialize Lucide icons
  if (typeof lucide !== 'undefined') {
    lucide.createIcons();
  }
  const selector = document.getElementById('quick-login-selector');
  const emailField = document.getElementById('user_email_field');
  const passwordField = document.getElementById('user_password');

  if (selector && emailField && passwordField) {
    selector.addEventListener('change', function() {
      const selectedOption = this.options[this.selectedIndex];

      if (selectedOption.value) {
        // Auto-fill email and password
        emailField.value = selectedOption.value;
        passwordField.value = selectedOption.dataset.password || 'Password123!';

        // Visual feedback
        emailField.classList.add('quick-login-success');
        passwordField.classList.add('quick-login-success');

        setTimeout(() => {
          emailField.classList.remove('quick-login-success');
          passwordField.classList.remove('quick-login-success');
        }, 1000);
      } else {
        // Clear fields if "Select a test user" is chosen
        emailField.value = '';
        passwordField.value = '';
      }
    });
  }
});
</script>