<!-- Sign In Page - Matching Main App Dark Theme -->
<div class="auth-workspace">
  <!-- Left Panel - Branding & Info -->
  <div class="auth-sidebar">
    <div class="auth-brand">
      <div class="brand-logo">
        <i data-lucide="box" class="text-primary"></i>
        <span class="brand-text">Amos</span>
      </div>
      <p class="brand-tagline">Your AI Marketing Agent</p>
    </div>

    <div class="auth-features">
      <h4 class="mb-4">Welcome back to Scout!</h4>
      <div class="feature-list">
        <div class="feature-item">
          <i data-lucide="bot" class="text-primary"></i>
          <div>
            <strong>AI-Powered Marketing</strong>
            <p>Scout learns your business and creates campaigns that convert</p>
          </div>
        </div>
        <div class="feature-item">
          <i data-lucide="globe" class="text-success"></i>
          <div>
            <strong>Landing Pages</strong>
            <p>Create beautiful, high-converting landing pages in minutes</p>
          </div>
        </div>
        <div class="feature-item">
          <i data-lucide="mail" class="text-info"></i>
          <div>
            <strong>Email Campaigns</strong>
            <p>Design and send targeted email campaigns that engage</p>
          </div>
        </div>
        <div class="feature-item">
          <i data-lucide="bar-chart" class="text-warning"></i>
          <div>
            <strong>Analytics Dashboard</strong>
            <p>Track performance and optimize your marketing strategy</p>
          </div>
        </div>
      </div>
    </div>
  </div>
  
  <!-- Right Panel - Login Form -->
  <div class="auth-content">
    <div class="auth-form-container">
      <div class="auth-header">
        <h2 class="mb-2">Welcome Back</h2>
        <p class="auth-subtitle">Sign in to continue to your AMOS dashboard</p>
      </div>
      
      <%= form_for(resource, as: resource_name, url: session_path(resource_name), local: true, html: { class: "auth-form", id: "login-form" }) do |f| %>
        <% if Rails.env.development? || Rails.env.test? %>
          <div class="form-group">
            <label class="form-label">
              <i data-lucide="flask-conical" class="text-warning" style="width: 1rem; height: 1rem; display: inline-block; vertical-align: middle;"></i> Quick Login (Dev Only)
            </label>
            <select id="quick-login-selector" class="form-control">
              <option value="">-- Select a test user --</option>
              <% User.includes(:entity).limit(10).each do |user| %>
                <option value="<%= user.email %>"
                        data-password="<%= Rails.application.credentials.dig(:dev_password) || 'password123' %>"
                        data-entity="<%= user.entity&.name %>">
                  <%= user.email %> (<%= user.entity&.name || 'No Entity' %>)
                </option>
              <% end %>
            </select>
            <small class="form-text">
              Select a user to auto-fill login credentials
            </small>
          </div>

          <div class="auth-divider">
            <span>or enter manually</span>
          </div>
        <% end %>

        <div class="form-group">
          <%= f.label :email, "Email Address", class: "form-label" %>
          <%= f.email_field :email,
              autofocus: true,
              autocomplete: "email",
              class: "form-control",
              placeholder: "Enter your email address",
              id: "user_email_field" %>
        </div>

        <div class="form-group">
          <%= f.label :password, "Password", class: "form-label" %>
          <%= f.password_field :password,
              autocomplete: "current-password",
              class: "form-control",
              placeholder: "Enter your password",
              id: "user_password" %>
        </div>

        <% if devise_mapping.rememberable? %>
          <div class="form-group">
            <div class="form-check">
              <%= f.check_box :remember_me, class: "form-check-input" %>
              <%= f.label :remember_me, "Remember me", class: "form-check-label" %>
            </div>
          </div>
        <% end %>

        <div class="form-group">
          <%= f.submit "Sign In", class: "btn btn-primary btn-lg w-100" %>
        </div>
      <% end %>

      <div class="auth-links">
        <%= link_to "Forgot your password?", new_password_path(resource_name), class: "auth-link" %>
      </div>

      <div class="auth-divider">
        <span>Don't have an account?</span>
      </div>

      <div class="auth-signup">
        <%= link_to "Create Account", new_registration_path(resource_name), class: "btn btn-outline-primary btn-lg w-100" %>
      </div>

      <div class="auth-footer">
        <p class="auth-footer-text">
          By signing in, you agree to our
          <a href="<%= marketing_terms_path %>" class="auth-link" target="_blank">Terms of Service</a> and
          <a href="<%= marketing_privacy_path %>" class="auth-link" target="_blank">Privacy Policy</a>
        </p>
      </div>
    </div>
  </div>
</div>

<style>
/* Auth Pages Dark Theme - Matching Main App */
.auth-workspace {
  min-height: 100vh;
  display: flex;
  background: var(--scout-bg, #1a1d23);
  color: var(--scout-text, #e9ecef);
}

.auth-sidebar {
  width: 450px;
  background: var(--scout-secondary, #2c3034);
  padding: 3rem 2rem;
  display: flex;
  flex-direction: column;
  justify-content: center;
  border-right: 1px solid var(--scout-border, #404448);
}

.auth-brand {
  text-align: center;
  margin-bottom: 3rem;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.brand-logo {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 0.75rem;
  font-size: 1.75rem;
  font-weight: 700;
  color: white;
  margin-bottom: 0.5rem;
}

.brand-logo i {
  font-size: 2.5rem;
  color: var(--scout-primary, #6366f1);
}

.brand-tagline {
  color: var(--scout-text-muted, #9ca3af);
  margin: 0;
  font-size: 1.1rem;
  text-align: center;
}

.auth-features h4 {
  color: white;
  font-weight: 600;
}

.feature-list {
  display: flex;
  flex-direction: column;
  gap: 2rem;
}

.feature-item {
  display: flex;
  align-items: flex-start;
  gap: 1rem;
}

.feature-item i {
  font-size: 1.5rem;
  margin-top: 0.25rem;
}

.feature-item strong {
  color: white;
  display: block;
  margin-bottom: 0.5rem;
  font-size: 1.1rem;
}

.feature-item p {
  color: var(--scout-text-muted, #9ca3af);
  margin: 0;
  line-height: 1.4;
}

.auth-content {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 2rem;
  background: var(--scout-bg, #1a1d23);
}

.auth-form-container {
  width: 100%;
  max-width: 420px;
}

.auth-header {
  text-align: center;
  margin-bottom: 2.5rem;
}

.auth-header h2 {
  color: white;
  font-weight: 700;
  font-size: 2rem;
}

.auth-subtitle {
  color: var(--scout-text-muted, #9ca3af);
  margin: 0;
  font-size: 1rem;
}

.auth-form {
  margin-bottom: 2rem;
}

.form-group {
  margin-bottom: 1.5rem;
}

.form-label {
  color: var(--scout-text, #e9ecef);
  font-weight: 500;
  margin-bottom: 0.5rem;
  display: block;
}

.form-control {
  background: var(--scout-secondary, #2c3034);
  border: 1px solid var(--scout-border, #404448);
  color: var(--scout-text, #e9ecef);
  border-radius: 0.5rem;
  padding: 0.75rem 1rem;
  font-size: 1rem;
  width: 100%;
  transition: all 0.2s ease;
}

.form-control:focus {
  background: var(--scout-secondary, #2c3034);
  border-color: var(--scout-primary, #6366f1);
  box-shadow: 0 0 0 0.2rem rgba(99, 102, 241, 0.25);
  color: var(--scout-text, #e9ecef);
  outline: none;
}

.form-control::placeholder {
  color: var(--scout-text-muted, #9ca3af);
}

.form-text {
  color: var(--scout-text-muted, #9ca3af);
  font-size: 0.875rem;
  margin-top: 0.25rem;
  display: block;
}

.form-check-input {
  background-color: var(--scout-secondary, #2c3034);
  border-color: var(--scout-border, #404448);
}

.form-check-input:checked {
  background-color: var(--scout-primary, #6366f1);
  border-color: var(--scout-primary, #6366f1);
}

.form-check-label {
  color: var(--scout-text, #e9ecef);
}

.btn-primary {
  background: var(--scout-primary, #6366f1);
  border-color: var(--scout-primary, #6366f1);
  font-weight: 600;
  padding: 0.875rem 1.5rem;
  border-radius: 0.5rem;
  transition: all 0.2s ease;
}

.btn-primary:hover {
  background: #5855eb;
  border-color: #5855eb;
  transform: translateY(-1px);
  box-shadow: 0 4px 12px rgba(99, 102, 241, 0.3);
}

.btn-outline-primary {
  color: var(--scout-primary, #6366f1);
  border-color: var(--scout-primary, #6366f1);
  background: transparent;
  font-weight: 600;
  padding: 0.875rem 1.5rem;
  border-radius: 0.5rem;
  transition: all 0.2s ease;
}

.btn-outline-primary:hover {
  background: var(--scout-primary, #6366f1);
  border-color: var(--scout-primary, #6366f1);
  color: white;
  transform: translateY(-1px);
  box-shadow: 0 4px 12px rgba(99, 102, 241, 0.3);
}

.auth-links {
  text-align: center;
  margin-bottom: 1.5rem;
}

.auth-link {
  color: var(--scout-primary, #6366f1);
  text-decoration: none;
  font-weight: 500;
  font-size: 0.9rem;
}

.auth-link:hover {
  color: #5855eb;
  text-decoration: underline;
}

.auth-divider {
  text-align: center;
  margin: 2rem 0 1.5rem 0;
  position: relative;
}

.auth-divider::before {
  content: '';
  position: absolute;
  top: 50%;
  left: 0;
  right: 0;
  height: 1px;
  background: var(--scout-border, #404448);
}

.auth-divider span {
  position: relative;
  z-index: 1;
  background: var(--scout-bg, #1a1d23);
  padding: 0 1rem;
  color: var(--scout-text-muted, #9ca3af);
  font-size: 0.9rem;
}

.auth-footer {
  margin-top: 2rem;
}

.auth-footer-text {
  color: var(--scout-text-muted, #9ca3af);
  font-size: 0.875rem;
  text-align: center;
  margin: 0;
}

/* Responsive Design */
@media (max-width: 768px) {
  .auth-workspace {
    flex-direction: column;
  }

  .auth-sidebar {
    width: 100%;
    padding: 2rem 1.5rem;
  }

  .auth-features {
    display: none;
  }

  .auth-content {
    padding: 1.5rem;
  }

  .auth-form-container {
    max-width: 100%;
  }
}

/* Dev Quick Login */
#quick-login-selector {
  background-color: #2c3034;
  border-color: #fbbf24;
  box-shadow: 0 0 0 2px rgba(251, 191, 36, 0.1);
}

code {
  background: #404448;
  padding: 0.2rem 0.4rem;
  border-radius: 0.25rem;
  color: #fbbf24;
  font-size: 0.875rem;
}
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
  // Initialize Lucide icons
  if (typeof lucide !== 'undefined') {
    lucide.createIcons();
  }
  const selector = document.getElementById('quick-login-selector');
  const emailField = document.getElementById('user_email_field');
  const passwordField = document.getElementById('user_password');

  if (selector && emailField && passwordField) {
    selector.addEventListener('change', function() {
      const selectedOption = this.options[this.selectedIndex];

      if (selectedOption.value) {
        // Auto-fill email and password
        emailField.value = selectedOption.value;
        passwordField.value = selectedOption.dataset.password || 'password123';

        // Visual feedback
        emailField.style.borderColor = '#10b981';
        passwordField.style.borderColor = '#10b981';

        setTimeout(() => {
          emailField.style.borderColor = '';
          passwordField.style.borderColor = '';
        }, 1000);
      } else {
        // Clear fields if "Select a test user" is chosen
        emailField.value = '';
        passwordField.value = '';
      }
    });
  }
});
</script>