<!-- Sign Up Page - Matching Main App Dark Theme -->
<div class="auth-workspace">
  <!-- Left Panel - Branding & Info -->
  <div class="auth-sidebar">
    <div class="auth-brand">
      <div class="brand-logo">
        <i class="fas fa-cube text-primary"></i>
        <span class="brand-text">Amos</span>
      </div>
      <p class="brand-tagline">Your AI Marketing Agent</p>
    </div>
    
    <div class="auth-features">
      <h4 class="mb-4">Get started with Scout!</h4>
      <div class="feature-list">
        <div class="feature-item">
          <i class="fas fa-robot text-primary"></i>
          <div>
            <strong>AI-Powered Marketing</strong>
            <p>Scout learns your business and creates campaigns that convert</p>
          </div>
        </div>
        <div class="feature-item">
          <i class="fas fa-globe text-success"></i>
          <div>
            <strong>Landing Pages</strong>
            <p>Create beautiful, high-converting landing pages in minutes</p>
          </div>
        </div>
        <div class="feature-item">
          <i class="fas fa-envelope text-info"></i>
          <div>
            <strong>Email Campaigns</strong>
            <p>Design and send targeted email campaigns that engage</p>
          </div>
        </div>
        <div class="feature-item">
          <i class="fas fa-chart-bar text-warning"></i>
          <div>
            <strong>Analytics Dashboard</strong>
            <p>Track performance and optimize your marketing strategy</p>
          </div>
        </div>
      </div>
    </div>
  </div>
  
  <!-- Right Panel - Signup Form -->
  <div class="auth-content">
    <div class="auth-form-container">
      <div class="auth-header">
        <h2 class="mb-2">Create Account</h2>
        <p class="text-muted">Join thousands of marketers using AMOS to grow their business</p>
      </div>
      
      <%= form_for(resource, as: resource_name, url: registration_path(resource_name), local: true, html: { class: "auth-form" }) do |f| %>
        <%= render "devise/shared/error_messages", resource: resource %>

        <div class="form-group">
          <label for="user_full_name" class="form-label">Full Name</label>
          <input type="text" 
                 name="user[full_name]" 
                 id="user_full_name"
                 autofocus 
                 class="form-control" 
                 placeholder="John Smith"
                 required>
        </div>

        <div class="form-group">
          <label for="user_business_name" class="form-label">
            Business Name 
            <span class="text-muted">(Optional)</span>
          </label>
          <input type="text" 
                 name="user[business_name]" 
                 id="user_business_name"
                 class="form-control" 
                 placeholder="Acme Corporation">
          <small class="form-text text-muted">
            If left blank, we'll use your name + "Inc" (e.g., "John Smith Inc")
          </small>
        </div>

        <div class="form-group">
          <%= f.label :email, "Email Address", class: "form-label" %>
          <%= f.email_field :email, 
              autocomplete: "email", 
              class: "form-control",
              placeholder: "john@company.com" %>
        </div>

        <!-- Hidden role field - default to marketer -->
        <%= f.hidden_field :role, value: "marketer" %>

        <div class="form-group">
          <%= f.label :password, "Password", class: "form-label" %>
          <% if @minimum_password_length %>
            <span class="text-muted">(<%= @minimum_password_length %> characters minimum)</span>
          <% end %>
          <%= f.password_field :password, 
              autocomplete: "new-password", 
              class: "form-control",
              placeholder: "Create a secure password" %>
        </div>

        <div class="form-group">
          <%= f.label :password_confirmation, "Confirm Password", class: "form-label" %>
          <%= f.password_field :password_confirmation, 
              autocomplete: "new-password", 
              class: "form-control",
              placeholder: "Confirm your password" %>
        </div>

        <div class="form-group">
          <%= f.submit "Create Account & Meet AMOS", class: "btn btn-primary btn-lg w-100" %>
        </div>
      <% end %>

      <div class="auth-divider">
        <span>Already have an account?</span>
      </div>
      
      <div class="auth-signin">
        <%= link_to "Sign In", new_session_path(resource_name), class: "btn btn-outline-primary btn-lg w-100" %>
      </div>
      
      <div class="auth-footer">
        <p class="text-muted small text-center">
          By creating an account, you agree to our 
          <a href="#" class="auth-link">Terms of Service</a> and 
          <a href="#" class="auth-link">Privacy Policy</a>
        </p>
      </div>
    </div>
  </div>
</div>

<style>
