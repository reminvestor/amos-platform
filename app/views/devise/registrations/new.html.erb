  width: 450px;
  background: var(--scout-secondary, #2c3034);
  padding: 3rem 2rem;
  display: flex;
  flex-direction: column;
  justify-content: center;
  border-right: 1px solid var(--scout-border, #404448);
}

.auth-brand {
  text-align: center;
  margin-bottom: 3rem;
}

.brand-logo {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 0.75rem;
  font-size: 1.75rem;
  font-weight: 700;
  color: white;
  margin-bottom: 0.5rem;
}

.brand-logo i {
  font-size: 2.5rem;
  color: var(--scout-primary, #6366f1);
}

.brand-tagline {
  color: var(--scout-text-muted, #9ca3af);
  margin: 0;
  font-size: 1.1rem;
}

.auth-features h4 {
  color: white;
  font-weight: 600;
}

.feature-list {
  display: flex;
  flex-direction: column;
  gap: 2rem;
}

.feature-item {
  display: flex;
  align-items: flex-start;
  gap: 1rem;
}

.feature-item i {
  font-size: 1.5rem;
  margin-top: 0.25rem;
}

.feature-item strong {
  color: white;
  display: block;
  margin-bottom: 0.5rem;
  font-size: 1.1rem;
}

.feature-item p {
  color: var(--scout-text-muted, #9ca3af);
  margin: 0;
  line-height: 1.4;
}

.auth-content {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 2rem;
  background: var(--scout-bg, #1a1d23);
}

.auth-form-container {
  width: 100%;
  max-width: 420px;
}

.auth-header {
  text-align: center;
  margin-bottom: 2.5rem;
}

.auth-header h2 {
  color: white;
  font-weight: 700;
  font-size: 2rem;
}

.auth-form {
  margin-bottom: 2rem;
}

.form-group {
  margin-bottom: 1.5rem;
}

.form-label {
  color: var(--scout-text, #e9ecef);
  font-weight: 500;
  margin-bottom: 0.5rem;
  display: block;
}

.form-control {
  background: var(--scout-secondary, #2c3034);
  border: 1px solid var(--scout-border, #404448);
  color: var(--scout-text, #e9ecef);
  border-radius: 0.5rem;
  padding: 0.75rem 1rem;
  font-size: 1rem;
  width: 100%;
  transition: all 0.2s ease;
}

.form-control:focus {
  background: var(--scout-secondary, #2c3034);
  border-color: var(--scout-primary, #6366f1);
  box-shadow: 0 0 0 0.2rem rgba(99, 102, 241, 0.25);
  color: var(--scout-text, #e9ecef);
  outline: none;
}

.form-control::placeholder {
  color: var(--scout-text-muted, #9ca3af);
}

.form-text {
  color: var(--scout-text-muted, #9ca3af);
  font-size: 0.875rem;
  margin-top: 0.25rem;
}

.form-check-input {
  background-color: var(--scout-secondary, #2c3034);
  border-color: var(--scout-border, #404448);
}

.form-check-input:checked {
  background-color: var(--scout-primary, #6366f1);
  border-color: var(--scout-primary, #6366f1);
}

.form-check-label {
  color: var(--scout-text, #e9ecef);
}

.btn-primary {
  background: var(--scout-primary, #6366f1);
  border-color: var(--scout-primary, #6366f1);
  font-weight: 600;
  padding: 0.875rem 1.5rem;
  border-radius: 0.5rem;
  transition: all 0.2s ease;
}

.btn-primary:hover {
  background: #5855eb;
  border-color: #5855eb;
  transform: translateY(-1px);
  box-shadow: 0 4px 12px rgba(99, 102, 241, 0.3);
}

.btn-outline-primary {
  color: var(--scout-primary, #6366f1);
  border-color: var(--scout-primary, #6366f1);
  background: transparent;
  font-weight: 600;
  padding: 0.875rem 1.5rem;
  border-radius: 0.5rem;
  transition: all 0.2s ease;
}

.btn-outline-primary:hover {
  background: var(--scout-primary, #6366f1);
  border-color: var(--scout-primary, #6366f1);
  color: white;
  transform: translateY(-1px);
  box-shadow: 0 4px 12px rgba(99, 102, 241, 0.3);
}

.auth-links {
  text-align: center;
  margin-bottom: 1.5rem;
}

.auth-link {
  color: var(--scout-primary, #6366f1);
  text-decoration: none;
  font-weight: 500;
  font-size: 0.9rem;
}

.auth-link:hover {
  color: #5855eb;
  text-decoration: underline;
}

.auth-divider {
  text-align: center;
  margin: 2rem 0 1.5rem 0;
  position: relative;
}

.auth-divider::before {
  content: '';
  position: absolute;
  top: 50%;
  left: 0;
  right: 0;
  height: 1px;
  background: var(--scout-border, #404448);
}

.auth-divider span {
  background: var(--scout-bg, #1a1d23);
  padding: 0 1rem;
  color: var(--scout-text-muted, #9ca3af);
  font-size: 0.9rem;
}

.auth-footer {
  margin-top: 2rem;
}

/* Responsive Design */
@media (max-width: 768px) {
  .auth-workspace {
    flex-direction: column;
  }
  
  .auth-sidebar {
    width: 100%;
    padding: 2rem 1.5rem;
  }
  
  .auth-features {
    display: none;
  }
  
  .auth-content {
    padding: 1.5rem;
  }
  
  .auth-form-container {
    max-width: 100%;
  }
}
</style>