<!-- Sign Up Page - Theme-Aware -->
<div class="auth-workspace">
  <!-- Theme Toggle Button (Top Right) -->
  <button class="auth-theme-toggle" data-theme-toggle aria-label="Toggle theme">
    <i data-lucide="moon" data-theme-icon></i>
  </button>
  
  <!-- Left Panel - Branding & Info -->
  <div class="auth-sidebar">
    <div class="auth-brand">
      <div class="brand-logo">
        <%= image_tag "amospurpleLogo.png", style: "height: 6rem; width: auto;", alt: "AMOS Labs" %>
      </div>
      <p class="brand-tagline" style="margin-top: 0.5rem;">Your AI Business Automation Platform</p>
    </div>

    <div class="auth-features">
      <div class="feature-list">
        <div class="feature-item">
          <i data-lucide="bot" class="text-primary"></i>
          <div>
            <strong>Meet Amos, Your AI Assistant</strong>
            <p>Your intelligent business partner - automates tasks and provides insights</p>
          </div>
        </div>
        <div class="feature-item">
          <i data-lucide="zap" class="text-success"></i>
          <div>
            <strong>Workflow Automation</strong>
            <p>Automate repetitive tasks and streamline your operations</p>
          </div>
        </div>
        <div class="feature-item">
          <i data-lucide="plug" class="text-info"></i>
          <div>
            <strong>Integrations</strong>
            <p>Connect your favorite tools - CRM, email, analytics, and more</p>
          </div>
        </div>
        <div class="feature-item">
          <i data-lucide="bar-chart" class="text-warning"></i>
          <div>
            <strong>Analytics & Insights</strong>
            <p>Track performance and get AI-powered recommendations</p>
          </div>
        </div>
      </div>
    </div>
  </div>
  
  <!-- Right Panel - Signup Form -->
  <div class="auth-content">
    <div class="auth-form-container">
      <div class="auth-header">
        <h2 class="mb-2">Create Account</h2>
      </div>
      
      <%= form_for(resource, as: resource_name, url: registration_path(resource_name), local: true, html: { class: "auth-form" }) do |f| %>
        <%= render "devise/shared/error_messages", resource: resource %>

        <div class="form-group">
          <label for="user_full_name" class="form-label">Full Name</label>
          <input type="text" 
                 name="user[full_name]" 
                 id="user_full_name"
                 autofocus 
                 class="form-control" 
                 placeholder="John Smith"
                 required>
        </div>

        <div class="form-group">
          <label for="user_business_name" class="form-label">
            Business Name
            <span class="form-optional">(Optional)</span>
          </label>
          <input type="text"
                 name="user[business_name]"
                 id="user_business_name"
                 class="form-control"
                 placeholder="Acme Corporation">
          <small class="form-text">
            If left blank, we'll use your name + "Inc" (e.g., "John Smith Inc")
          </small>
        </div>

        <div class="form-group">
          <%= f.label :email, "Email Address", class: "form-label" %>
          <%= f.email_field :email, 
              autocomplete: "email", 
              class: "form-control",
              placeholder: "john@company.com" %>
        </div>

        <!-- Hidden role field - new users creating their own entity are admins -->
        <%= f.hidden_field :role, value: "admin" %>

        <div class="form-group">
          <%= f.label :password, "Password", class: "form-label" %>
          <span class="form-optional">(10 characters minimum)</span>
          <%= f.password_field :password,
              autocomplete: "new-password",
              class: "form-control",
              id: "user_password",
              minlength: "10",
              placeholder: "Create a secure password (min 10 chars)" %>
        </div>

        <div class="form-group">
          <div class="password-confirm-group">
            <%= f.label :password_confirmation, "Confirm Password", class: "form-label" %>
            <span class="password-match-indicator" id="passwordMatchIndicator">
              <i data-lucide="check-circle" class="match-icon"></i>
              <span class="match-text">Passwords match</span>
            </span>
          </div>
          <div class="password-field-wrapper">
            <%= f.password_field :password_confirmation,
                autocomplete: "new-password",
                class: "form-control",
                id: "user_password_confirmation",
                placeholder: "Confirm your password" %>
            <span class="field-checkmark" id="fieldCheckmark">
              <i data-lucide="check" class="checkmark-icon"></i>
            </span>
          </div>
          <small class="form-text password-match-message" id="passwordMatchMessage" style="display: none;"></small>
        </div>

        <div class="form-group">
          <%= f.submit "Create Account & Meet Amos", class: "btn btn-primary btn-lg w-100", id: "signup-submit-btn" %>
        </div>
      <% end %>

      <% if ENV['GOOGLE_OAUTH_CLIENT_ID'].present? %>
        <div class="auth-divider">
          <span>or sign up with</span>
        </div>

        <div class="oauth-buttons" style="margin-bottom: 1.5rem;">
          <%= button_to user_google_omniauth_authorize_path, method: :post, class: "btn btn-google w-100", data: { turbo: false } do %>
            <svg class="google-icon" viewBox="0 0 24 24" width="20" height="20" xmlns="http://www.w3.org/2000/svg">
              <g transform="matrix(1, 0, 0, 1, 27.009001, -39.238998)">
                <path fill="#4285F4" d="M -3.264 51.509 C -3.264 50.719 -3.334 49.969 -3.454 49.239 L -14.754 49.239 L -14.754 53.749 L -8.284 53.749 C -8.574 55.229 -9.424 56.479 -10.684 57.329 L -10.684 60.329 L -6.824 60.329 C -4.564 58.239 -3.264 55.159 -3.264 51.509 Z"/>
                <path fill="#34A853" d="M -14.754 63.239 C -11.514 63.239 -8.804 62.159 -6.824 60.329 L -10.684 57.329 C -11.764 58.049 -13.134 58.489 -14.754 58.489 C -17.884 58.489 -20.534 56.379 -21.484 53.529 L -25.464 53.529 L -25.464 56.619 C -23.494 60.539 -19.444 63.239 -14.754 63.239 Z"/>
                <path fill="#FBBC05" d="M -21.484 53.529 C -21.734 52.809 -21.864 52.039 -21.864 51.239 C -21.864 50.439 -21.724 49.669 -21.484 48.949 L -21.484 45.859 L -25.464 45.859 C -26.284 47.479 -26.754 49.299 -26.754 51.239 C -26.754 53.179 -26.284 54.999 -25.464 56.619 L -21.484 53.529 Z"/>
                <path fill="#EA4335" d="M -14.754 43.989 C -12.984 43.989 -11.404 44.599 -10.154 45.789 L -6.734 42.369 C -8.804 40.429 -11.514 39.239 -14.754 39.239 C -19.444 39.239 -23.494 41.939 -25.464 45.859 L -21.484 48.949 C -20.534 46.099 -17.884 43.989 -14.754 43.989 Z"/>
              </g>
            </svg>
            <span>Continue with Google</span>
          <% end %>
        </div>
      <% end %>

      <div class="auth-divider">
        <span>Already have an account?</span>
      </div>
      
      <div class="auth-signin">
        <%= link_to "Sign In", new_session_path(resource_name), class: "btn btn-outline-primary btn-lg w-100" %>
      </div>
      
      <div class="auth-footer">
        <p class="auth-footer-text">
          By creating an account, you agree to our
          <%= link_to "Terms of Service", terms_of_service_path, class: "auth-link", target: "_blank" %> and
          <%= link_to "Privacy Policy", privacy_policy_path, class: "auth-link", target: "_blank" %>
        </p>
      </div>
    </div>
  </div>
</div>

<style>
/* Auth Pages - Theme-Aware (Light/Dark) */
.auth-workspace {
  min-height: 100vh;
  display: flex;
  position: relative;
  background: var(--bg-primary);
  color: var(--text-primary);
  transition: background-color 0.3s ease, color 0.3s ease;
}

.auth-theme-toggle {
  position: absolute;
  top: 1.5rem;
  right: 1.5rem;
  z-index: 1000;
  background: var(--bg-secondary);
  border: 1px solid var(--border-primary);
  border-radius: 0.5rem;
  width: 2.5rem;
  height: 2.5rem;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  transition: all 0.2s ease;
  color: var(--text-secondary);
}

.auth-theme-toggle:hover {
  background: var(--bg-hover);
  color: var(--text-primary);
  transform: translateY(-1px);
  box-shadow: var(--shadow-md);
}

.auth-theme-toggle i {
  width: 1.25rem;
  height: 1.25rem;
}

.auth-sidebar {
  width: 450px;
  background: var(--bg-secondary);
  padding: 3rem 2rem;
  display: flex;
  flex-direction: column;
  justify-content: center;
  border-right: 1px solid var(--border-primary);
}

.auth-brand {
  text-align: center;
  margin-bottom: 3rem;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.brand-logo {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 0.75rem;
  font-size: 1.75rem;
  font-weight: 700;
  color: white;
  margin-bottom: 0;
}

.brand-logo i {
  font-size: 2.5rem;
  color: var(--accent-purple-end);
}

.brand-tagline {
  color: var(--text-muted);
  margin: 0;
  font-size: 1.1rem;
  text-align: center;
}

.auth-features h4 {
  color: var(--text-primary);
  font-weight: 600;
}

.feature-list {
  display: flex;
  flex-direction: column;
  gap: 2rem;
}

.feature-item {
  display: flex;
  align-items: flex-start;
  gap: 1rem;
}

.feature-item i {
  font-size: 1.5rem;
  margin-top: 0.25rem;
}

.feature-item strong {
  color: var(--text-primary);
  display: block;
  margin-bottom: 0.5rem;
  font-size: 1.1rem;
}

.feature-item p {
  color: var(--text-muted);
  margin: 0;
  line-height: 1.4;
}

.auth-content {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 2rem;
  background: var(--bg-primary);
}

.auth-form-container {
  width: 100%;
  max-width: 420px;
}

.auth-header {
  text-align: center;
  margin-bottom: 2.5rem;
}

.auth-header h2 {
  color: var(--text-primary);
  font-weight: 700;
  font-size: 2rem;
}

.auth-subtitle {
  color: var(--text-muted);
  margin: 0;
  font-size: 1rem;
}

.auth-form {
  margin-bottom: 2rem;
}

.form-group {
  margin-bottom: 1.5rem;
}

.form-label {
  color: var(--text-primary);
  font-weight: 500;
  margin-bottom: 0.5rem;
  display: block;
}

.form-control {
  background: var(--bg-input);
  border: 1px solid var(--border-primary);
  color: var(--text-primary);
  border-radius: 0.5rem;
  padding: 0.75rem 1rem;
  font-size: 1rem;
  width: 100%;
  transition: all 0.2s ease;
}

.form-control:focus {
  background: var(--bg-input);
  border-color: var(--accent-purple-end);
  box-shadow: 0 0 0 0.2rem rgba(124, 58, 237, 0.25);
  color: var(--text-primary);
  outline: none;
}

/* Password field validation states */
#user_password.password-invalid {
  border-color: #ef4444;
  box-shadow: 0 0 0 0.2rem rgba(239, 68, 68, 0.15);
}

#user_password.password-valid {
  border-color: #10b981;
  box-shadow: 0 0 0 0.2rem rgba(16, 185, 129, 0.15);
}

#user_password_confirmation.password-invalid {
  border-color: #ef4444;
  box-shadow: 0 0 0 0.2rem rgba(239, 68, 68, 0.15);
}

#user_password_confirmation.password-valid {
  border-color: #10b981;
  box-shadow: 0 0 0 0.2rem rgba(16, 185, 129, 0.15), 0 0 8px rgba(16, 185, 129, 0.3);
  animation: successGlow 0.6s ease-out;
  padding-right: 2.75rem;
}

/* Checkmark icon on the password field */
.field-checkmark {
  position: absolute;
  right: 0.75rem;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 1.5rem;
  height: 1.5rem;
  color: #10b981;
  opacity: 0;
  transform: scale(0);
  transition: all 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
  pointer-events: none;
  z-index: 10;
}

.field-checkmark.show {
  opacity: 1;
  transform: scale(1);
}

.field-checkmark .checkmark-icon {
  width: 1.5rem;
  height: 1.5rem;
  flex-shrink: 0;
  filter: drop-shadow(0 2px 4px rgba(16, 185, 129, 0.3));
}

.form-control::placeholder {
  color: var(--text-muted);
}

.form-text {
  color: var(--text-muted);
  font-size: 0.875rem;
  margin-top: 0.25rem;
  display: block;
}

.form-optional {
  color: var(--text-muted);
  font-size: 0.875rem;
  font-weight: 400;
  margin-left: 0.25rem;
}

.password-confirm-group {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 0.5rem;
}

.password-field-wrapper {
  position: relative;
  display: flex;
  align-items: center;
}

.password-match-indicator {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  font-size: 0.875rem;
  padding: 0.25rem 0.75rem;
  border-radius: 0.375rem;
  opacity: 0;
  transition: all 0.3s ease;
  pointer-events: none;
}

.password-match-indicator.match {
  color: #10b981;
  background: rgba(16, 185, 129, 0.1);
  opacity: 1;
}

.password-match-indicator.no-match {
  color: #ef4444;
  background: rgba(239, 68, 68, 0.1);
  opacity: 1;
}

.password-match-indicator .match-icon {
  width: 1rem;
  height: 1rem;
  flex-shrink: 0;
}

.password-match-message {
  font-size: 0.85rem !important;
  margin-top: 0.25rem;
  transition: all 0.3s ease;
}

.password-match-message.error {
  color: #ef4444;
}

.password-match-message.success {
  color: #10b981;
  font-weight: 600;
  font-size: 0.95rem !important;
  animation: successPulse 0.6s ease-out;
}

@keyframes successPulse {
  0% {
    opacity: 0;
    transform: translateY(-5px);
  }
  50% {
    opacity: 1;
  }
  100% {
    opacity: 1;
    transform: translateY(0);
  }
}

/* Pulse animation for success indicator */
.password-match-indicator.match {
  animation: indicatorPulse 0.6s ease-out;
}

@keyframes indicatorPulse {
  0% {
    transform: scale(0.9);
    opacity: 0;
  }
  50% {
    opacity: 1;
  }
  100% {
    transform: scale(1);
    opacity: 1;
  }
}

@keyframes successGlow {
  0% {
    box-shadow: 0 0 0 0.2rem rgba(16, 185, 129, 0.15), 0 0 0 rgba(16, 185, 129, 0.5);
  }
  100% {
    box-shadow: 0 0 0 0.2rem rgba(16, 185, 129, 0.15), 0 0 8px rgba(16, 185, 129, 0.3);
  }
}

.form-check-input {
  background-color: var(--bg-input);
  border-color: var(--border-primary);
}

.form-check-input:checked {
  background-color: var(--accent-purple-end);
  border-color: var(--accent-purple-end);
}

.form-check-label {
  color: var(--text-primary);
}

.btn-primary {
  background: linear-gradient(135deg, var(--accent-purple-start), var(--accent-purple-end));
  border: none;
  color: white;
  font-weight: 600;
  padding: 0.875rem 1.5rem;
  border-radius: 0.5rem;
  transition: all 0.2s ease;
}

.btn-primary:hover {
  opacity: 0.9;
  transform: translateY(-1px);
  box-shadow: 0 4px 12px rgba(124, 58, 237, 0.3);
  color: white;
}

.btn-outline-primary {
  color: var(--accent-purple-end);
  border: 1px solid var(--accent-purple-end);
  background: transparent;
  font-weight: 600;
  padding: 0.875rem 1.5rem;
  border-radius: 0.5rem;
  transition: all 0.2s ease;
}

.btn-outline-primary:hover {
  background: var(--accent-purple-end);
  border-color: var(--accent-purple-end);
  color: white;
  transform: translateY(-1px);
  box-shadow: 0 4px 12px rgba(124, 58, 237, 0.3);
}

.auth-links {
  text-align: center;
  margin-bottom: 1.5rem;
}

.auth-link {
  color: var(--accent-purple-end);
  text-decoration: none;
  font-weight: 500;
  font-size: 0.9rem;
}

.auth-link:hover {
  color: var(--accent-purple-start);
  text-decoration: underline;
}

.auth-divider {
  text-align: center;
  margin: 2rem 0 1.5rem 0;
  position: relative;
}

.auth-divider::before {
  content: '';
  position: absolute;
  top: 50%;
  left: 0;
  right: 0;
  height: 1px;
  background: var(--border-primary);
}

.auth-divider span {
  position: relative;
  z-index: 1;
  background: var(--bg-primary);
  padding: 0 1rem;
  color: var(--text-muted);
  font-size: 0.9rem;
}

.auth-footer {
  margin-top: 2rem;
}

.auth-footer-text {
  color: var(--text-muted);
  font-size: 0.875rem;
  text-align: center;
  margin: 0;
}

/* Responsive Design */
@media (max-width: 768px) {
  .auth-workspace {
    flex-direction: column;
  }
  
  .auth-sidebar {
    width: 100%;
    padding: 2rem 1.5rem;
  }
  
  .auth-features {
    display: none;
  }
  
  .auth-content {
    padding: 1.5rem;
  }
  
  .auth-form-container {
    max-width: 100%;
  }
  
  .auth-theme-toggle {
    top: 1rem;
    right: 1rem;
  }
}
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
  // Initialize Lucide icons
  if (typeof lucide !== 'undefined') {
    lucide.createIcons();
  }

  // Password matching checker
  const passwordInput = document.getElementById('user_password');
  const passwordConfirmInput = document.getElementById('user_password_confirmation');
  const passwordMatchIndicator = document.getElementById('passwordMatchIndicator');
  const passwordMatchMessage = document.getElementById('passwordMatchMessage');
  const submitButton = document.getElementById('signup-submit-btn');
  const fieldCheckmark = document.getElementById('fieldCheckmark');

  function checkPasswordMatch() {
    const password = passwordInput.value;
    const passwordConfirm = passwordConfirmInput.value;
    const MIN_PASSWORD_LENGTH = 10;

    // Check password length validity
    const passwordLongEnough = password.length >= MIN_PASSWORD_LENGTH;
    const passwordsMatch = password === passwordConfirm;

    // Update password field styling (always show, even on first char)
    if (password.length > 0) {
      if (passwordLongEnough) {
        passwordInput.classList.remove('password-invalid');
        passwordInput.classList.add('password-valid');
      } else {
        passwordInput.classList.remove('password-valid');
        passwordInput.classList.add('password-invalid');
      }
    } else {
      passwordInput.classList.remove('password-invalid', 'password-valid');
    }

    // Only show full feedback if user has typed in confirmation field
    if (passwordConfirm.length === 0) {
      passwordConfirmInput.classList.remove('password-invalid', 'password-valid');
      passwordMatchIndicator.classList.remove('match', 'no-match');
      passwordMatchMessage.style.display = 'none';
      fieldCheckmark.classList.remove('show');
      submitButton.disabled = false;
      return;
    }

    const passwordsValid = password.length > 0 && passwordConfirm.length > 0;

    // Update confirmation field styling
    if (!passwordLongEnough || !passwordsMatch) {
      passwordConfirmInput.classList.remove('password-valid');
      passwordConfirmInput.classList.add('password-invalid');
    } else {
      passwordConfirmInput.classList.remove('password-invalid');
      passwordConfirmInput.classList.add('password-valid');
    }

    if (passwordsValid) {
      if (!passwordLongEnough) {
        // Password too short
        passwordMatchIndicator.classList.remove('match');
        passwordMatchIndicator.classList.add('no-match');
        passwordMatchMessage.textContent = `✗ Password must be at least ${MIN_PASSWORD_LENGTH} characters`;
        passwordMatchMessage.classList.remove('success');
        passwordMatchMessage.classList.add('error');
        passwordMatchMessage.style.display = 'block';
        fieldCheckmark.classList.remove('show');
        submitButton.disabled = true;
      } else if (passwordsMatch) {
        // Passwords match and length is valid
        passwordMatchIndicator.classList.remove('no-match');
        passwordMatchIndicator.classList.add('match');
        passwordMatchMessage.style.display = 'none';
        fieldCheckmark.classList.add('show');
        submitButton.disabled = false;
      } else {
        // Passwords don't match
        passwordMatchIndicator.classList.remove('match');
        passwordMatchIndicator.classList.add('no-match');
        passwordMatchMessage.textContent = '✗ Passwords do not match';
        passwordMatchMessage.classList.remove('success');
        passwordMatchMessage.classList.add('error');
        passwordMatchMessage.style.display = 'block';
        fieldCheckmark.classList.remove('show');
        submitButton.disabled = true;
      }
    }
  }

  // Add event listeners for real-time checking
  if (passwordInput && passwordConfirmInput) {
    passwordInput.addEventListener('input', checkPasswordMatch);
    passwordConfirmInput.addEventListener('input', checkPasswordMatch);
  }

  // Reinitialize Lucide icons when password match indicator or checkmark changes
  const observer = new MutationObserver(function() {
    if (typeof lucide !== 'undefined') {
      lucide.createIcons();
    }
  });

  if (passwordMatchIndicator) {
    observer.observe(passwordMatchIndicator, {
      attributes: true,
      attributeFilter: ['class']
    });
  }

  if (fieldCheckmark) {
    observer.observe(fieldCheckmark, {
      attributes: true,
      attributeFilter: ['class']
    });
  }
});
</script>