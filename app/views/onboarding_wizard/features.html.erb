<%# Progress bar is in the card already %>
<div class="wizard-progress">
  <div class="progress-bar" style="width: <%= (@current_step_index.to_f / @total_steps * 100).round %>%;"></div>
</div>

<div class="pt-4">
  <div class="text-center mb-4">
    <h1 class="wizard-title">Select Features</h1>
    <p class="wizard-subtitle">
      Choose which feature categories you'd like enabled
    </p>
  </div>

  <%= form_with url: onboarding_path(step: 'features'), method: :patch, data: { turbo: false } do %>
    <div class="row g-3 mb-4">
      <% @feature_categories.each do |category| %>
        <div class="col-12 col-sm-6">
          <label class="feature-card p-3 h-100 <%= 'selected' if (@selected_features & category[:features]).any? %>"
                 for="feature_<%= category[:slug] %>">
            <div class="d-flex align-items-start gap-3">
              <%= check_box_tag "features[]", category[:features].join(','), 
                  (@selected_features & category[:features]).any?,
                  class: "form-check-input mt-1", 
                  id: "feature_#{category[:slug]}" %>
              <div class="feature-icon">
                <i data-lucide="<%= category[:icon] %>" style="width: 22px; height: 22px;"></i>
              </div>
              <div class="flex-grow-1">
                <div class="feature-name"><%= category[:name] %></div>
                <div class="feature-desc"><%= category[:description] %></div>
              </div>
            </div>
          </label>
        </div>
      <% end %>
    </div>

    <div class="wizard-actions d-flex justify-content-between align-items-center">
      <%= link_to onboarding_path(step: 'use_cases'), class: "btn btn-outline-secondary" do %>
        <i data-lucide="arrow-left" style="width: 16px; height: 16px;" class="me-1"></i>
        Back
      <% end %>
      <%= submit_tag "Continue", class: "btn btn-primary" %>
    </div>
  <% end %>
</div>

<style>
  .feature-card { 
    display: block; 
    background: var(--bg-primary);
    border: 2px solid var(--border);
    border-radius: 10px;
    cursor: pointer; 
    transition: all 0.2s ease; 
  }
  
  .feature-card:hover { 
    border-color: rgba(124, 58, 237, 0.3);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
  }
  
  .feature-card.selected, 
  .feature-card:has(input:checked) { 
    border-color: var(--primary);
    background: linear-gradient(135deg, rgba(124, 58, 237, 0.04), rgba(59, 130, 246, 0.04));
  }
  
  .feature-icon {
    width: 36px;
    height: 36px;
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, rgba(124, 58, 237, 0.1), rgba(59, 130, 246, 0.1));
    color: var(--primary);
    flex-shrink: 0;
  }
  
  .feature-card:has(input:checked) .feature-icon {
    background: var(--gradient);
    color: white;
  }
  
  .feature-name {
    font-weight: 600;
    font-size: 0.9375rem;
    color: var(--text-primary);
    margin-bottom: 0.25rem;
  }
  
  .feature-desc {
    font-size: 0.8125rem;
    color: var(--text-secondary);
    line-height: 1.4;
  }
  
  .form-check-input {
    flex-shrink: 0;
  }
  
  .form-check-input:checked {
    background-color: var(--primary);
    border-color: var(--primary);
  }
</style>
