<div class="wizard-container">
  <div class="wizard-progress">
    <div class="progress-bar" style="width: <%= (@current_step_index.to_f / @total_steps * 100).round %>%;"></div>
  </div>

  <div class="wizard-content">
    <h1 class="wizard-title mb-2">Select Features</h1>
    <p class="wizard-subtitle text-muted mb-4">
      Choose which feature categories you'd like enabled
    </p>

    <%= form_with url: onboarding_wizard_path(step: 'features'), method: :patch, local: true do %>
      <div class="features-grid row">
        <% @feature_categories.each do |category| %>
          <div class="col-md-6 mb-3">
            <label class="feature-card p-4 rounded h-100 <%= 'selected' if (@selected_features & category[:features]).any? %>"
                   for="feature_<%= category[:slug] %>">
              <div class="d-flex align-items-center mb-3">
                <%= check_box_tag "features[]", category[:features].join(','), 
                    (@selected_features & category[:features]).any?,
                    class: "form-check-input me-3", 
                    id: "feature_#{category[:slug]}" %>
                <i data-lucide="<%= category[:icon] %>" style="width: 28px; height: 28px; color: #A78BFA;"></i>
              </div>
              <h5 class="mb-2"><%= category[:name] %></h5>
              <p class="text-muted small mb-0"><%= category[:description] %></p>
            </label>
          </div>
        <% end %>
      </div>

      <div class="wizard-actions d-flex justify-content-between mt-4">
        <%= link_to "← Back", onboarding_wizard_path(step: 'use_cases'), class: "btn btn-outline-secondary" %>
        <%= submit_tag "Continue →", class: "btn btn-primary" %>
      </div>
    <% end %>
  </div>
</div>

<style>
  .wizard-container { max-width: 800px; margin: 0 auto; padding: 2rem; }
  .wizard-progress { height: 4px; background: rgba(124, 58, 237, 0.2); border-radius: 2px; margin-bottom: 3rem; }
  .wizard-progress .progress-bar { height: 100%; background: linear-gradient(90deg, #7C3AED, #3B82F6); border-radius: 2px; }
  .wizard-title { font-size: 2rem; font-weight: 700; color: var(--text-primary); }
  .feature-card { display: block; background: var(--bg-tertiary, rgba(255,255,255,0.05)); border: 2px solid transparent; cursor: pointer; transition: all 0.2s ease; }
  .feature-card:hover { border-color: rgba(124, 58, 237, 0.3); }
  .feature-card.selected, .feature-card:has(input:checked) { border-color: #A78BFA; background: rgba(124, 58, 237, 0.1); }
</style>
