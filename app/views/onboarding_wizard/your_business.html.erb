<div class="wizard-container">
  <div class="wizard-progress">
    <div class="progress-bar" style="width: <%= (@current_step_index.to_f / @total_steps * 100).round %>%;"></div>
  </div>

  <div class="wizard-content">
    <h1 class="wizard-title mb-2">Your Business</h1>
    <p class="wizard-subtitle text-muted mb-4">
      Help Amos understand your business for better recommendations
    </p>

    <%= form_with model: @business_profile, url: onboarding_wizard_path(step: 'your_business'), method: :patch, local: true do |f| %>
      <div class="mb-3">
        <label class="form-label">Business Name</label>
        <%= f.text_field :name, class: "form-control", required: true, value: @business_profile.name || current_entity.name %>
      </div>

      <div class="mb-3">
        <label class="form-label">Industry</label>
        <%= f.select :industry, options_for_select([
          ['Technology', 'technology'],
          ['E-commerce / Retail', 'ecommerce'],
          ['Professional Services', 'professional_services'],
          ['Healthcare', 'healthcare'],
          ['Finance', 'finance'],
          ['Education', 'education'],
          ['Real Estate', 'real_estate'],
          ['Marketing / Agency', 'marketing'],
          ['Manufacturing', 'manufacturing'],
          ['Other', 'other']
        ], @business_profile.industry), { include_blank: 'Select your industry' }, class: "form-select" %>
      </div>

      <div class="mb-3">
        <label class="form-label">Company Size</label>
        <%= f.select :company_size, options_for_select([
          ['Just me', '1'],
          ['2-10 employees', '2-10'],
          ['11-50 employees', '11-50'],
          ['51-200 employees', '51-200'],
          ['200+ employees', '200+']
        ], @business_profile.company_size), { include_blank: 'Select company size' }, class: "form-select" %>
      </div>

      <div class="mb-4">
        <label class="form-label">Website <span class="text-muted">(optional)</span></label>
        <%= f.url_field :website, class: "form-control", placeholder: "https://yourcompany.com" %>
      </div>

      <div class="wizard-actions d-flex justify-content-between">
        <%= link_to "← Back", onboarding_wizard_path(step: 'about_you'), class: "btn btn-outline-secondary" %>
        <%= f.submit "Continue →", class: "btn btn-primary" %>
      </div>
    <% end %>
  </div>
</div>

<style>
  .wizard-container { max-width: 600px; margin: 0 auto; padding: 2rem; }
  .wizard-progress { height: 4px; background: rgba(124, 58, 237, 0.2); border-radius: 2px; margin-bottom: 3rem; }
  .wizard-progress .progress-bar { height: 100%; background: linear-gradient(90deg, #7C3AED, #3B82F6); border-radius: 2px; }
  .wizard-title { font-size: 2rem; font-weight: 700; color: var(--text-primary); }
</style>
