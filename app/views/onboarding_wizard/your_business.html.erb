<%# Progress bar is in the card already %>
<div class="wizard-progress">
  <div class="progress-bar" style="width: <%= (@current_step_index.to_f / @total_steps * 100).round %>%;"></div>
</div>

<div class="pt-4">
  <h1 class="wizard-title">Your Business</h1>
  <p class="wizard-subtitle">
    Help Amos understand your business for better recommendations
  </p>

  <% if session[:onboarding_website_data].present? && session[:onboarding_website_data]['business_name'].present? %>
    <div class="alert-info-custom d-flex align-items-start mb-4">
      <span style="font-size: 1.25rem; flex-shrink: 0;" class="me-3">✨</span>
      <div class="flex-grow-1">
        <strong style="color: var(--text-primary);">We've learned about your business!</strong>
        <p class="mb-0 mt-1" style="color: var(--text-secondary); font-size: 0.875rem;">
          We analyzed your website and stored key insights in AMOS's memory system.
        </p>
        
        <%# Show extracted insights %>
        <% if @website_insights.present? %>
          <div class="mt-3 pt-3" style="border-top: 1px solid rgba(124, 58, 237, 0.15);">
            <% if @website_insights[:tagline].present? %>
              <div class="d-flex align-items-start mb-2">
                <span style="flex-shrink: 0;" class="me-2">💬</span>
                <div>
                  <span style="font-size: 0.75rem; color: var(--text-muted);">Tagline:</span>
                  <span style="font-size: 0.8125rem; color: var(--text-primary); font-style: italic;">"<%= @website_insights[:tagline] %>"</span>
                </div>
              </div>
            <% end %>
            
            <% if @website_insights[:value_proposition].present? %>
              <div class="d-flex align-items-start mb-2">
                <span style="flex-shrink: 0;" class="me-2">🎯</span>
                <div>
                  <span style="font-size: 0.75rem; color: var(--text-muted);">What makes you unique:</span>
                  <span style="font-size: 0.8125rem; color: var(--text-primary);"><%= @website_insights[:value_proposition] %></span>
                </div>
              </div>
            <% end %>
            
            <% if @website_insights[:products_services].present? && @website_insights[:products_services].is_a?(Array) && @website_insights[:products_services].any? %>
              <div class="d-flex align-items-start">
                <span style="flex-shrink: 0;" class="me-2">📦</span>
                <div>
                  <span style="font-size: 0.75rem; color: var(--text-muted);">Products/Services:</span>
                  <div class="d-flex flex-wrap gap-1 mt-1">
                    <% @website_insights[:products_services].first(5).each do |item| %>
                      <span class="badge" style="background: rgba(124, 58, 237, 0.1); color: var(--primary); font-weight: 500; font-size: 0.7rem;"><%= item %></span>
                    <% end %>
                  </div>
                </div>
              </div>
            <% end %>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>

  <%= form_with model: @business_profile, url: onboarding_path(step: 'your_business'), method: :patch, data: { turbo: false } do |f| %>
    <div class="mb-3">
      <label class="form-label">
        Business Name
        <% if session.dig(:onboarding_website_data, 'business_name').present? %>
          <span class="badge-autofill">Auto-filled</span>
        <% end %>
      </label>
      <%= f.text_field :name, class: "form-control", required: true, 
          value: @business_profile.name || current_entity.name,
          placeholder: "Your company name" %>
    </div>

    <div class="row">
      <div class="col-md-6 mb-3">
        <label class="form-label">
          Industry
          <% if session.dig(:onboarding_website_data, 'industry').present? %>
            <span class="badge-autofill">Auto-filled</span>
          <% end %>
        </label>
        <%= f.select :industry, options_for_select([
          ['Technology', 'technology'],
          ['E-commerce / Retail', 'ecommerce'],
          ['Professional Services', 'professional_services'],
          ['Healthcare', 'healthcare'],
          ['Finance', 'finance'],
          ['Education', 'education'],
          ['Real Estate', 'real_estate'],
          ['Marketing / Agency', 'marketing'],
          ['Manufacturing', 'manufacturing'],
          ['Other', 'other']
        ], @business_profile.industry), { include_blank: 'Select your industry' }, class: "form-select" %>
      </div>

      <div class="col-md-6 mb-3">
        <label class="form-label">Company Size</label>
        <%= f.select :company_size, options_for_select([
          ['Just me', '1'],
          ['2-10 employees', '2-10'],
          ['11-50 employees', '11-50'],
          ['51-200 employees', '51-200'],
          ['200+ employees', '200+']
        ], @business_profile.company_size), { include_blank: 'Select company size' }, class: "form-select" %>
      </div>
    </div>

    <div class="mb-3">
      <label class="form-label">Website</label>
      <%= f.url_field :website, class: "form-control", 
          placeholder: "https://yourcompany.com", 
          value: @business_profile.website || session.dig(:onboarding_website_data, 'website') %>
    </div>

    <div class="mb-3">
      <label class="form-label">
        Business Description
        <% if session.dig(:onboarding_website_data, 'description').present? %>
          <span class="badge-autofill">Auto-filled</span>
        <% end %>
      </label>
      <%= f.text_area :description, class: "form-control", rows: 3, required: true,
          placeholder: "What does your business do? What products or services do you offer?" %>
      <div class="form-text">This helps Amos understand your business and provide better responses.</div>
    </div>

    <div class="row">
      <div class="col-md-6 mb-3">
        <label class="form-label">
          Target Audience
          <% if session.dig(:onboarding_website_data, 'target_audience').present? %>
            <span class="badge-autofill">Auto-filled</span>
          <% end %>
        </label>
        <%= f.text_field :target_audience, class: "form-control", 
            placeholder: "e.g., Small business owners" %>
      </div>

      <div class="col-md-6 mb-3">
        <label class="form-label">
          Tone of Voice
          <% if session.dig(:onboarding_website_data, 'tone_of_voice').present? %>
            <span class="badge-autofill">Auto-filled</span>
          <% end %>
        </label>
        <%= f.select :tone_of_voice, options_for_select([
          ['Professional & Formal', 'professional'],
          ['Friendly & Conversational', 'friendly'],
          ['Bold & Confident', 'bold'],
          ['Warm & Empathetic', 'warm'],
          ['Technical & Precise', 'technical'],
          ['Casual & Fun', 'casual'],
          ['Authoritative & Expert', 'authoritative']
        ], @business_profile.tone_of_voice), { include_blank: 'Select your brand voice' }, class: "form-select" %>
      </div>
    </div>

    <div class="mb-3">
      <label class="form-label">
        Brand Values
        <% if session.dig(:onboarding_website_data, 'values').present? %>
          <span class="badge-autofill">Auto-filled</span>
        <% end %>
        <span style="color: var(--text-muted); font-weight: 400;">(optional)</span>
      </label>
      <%= f.text_field :values, class: "form-control", 
          placeholder: "e.g., Innovation, Customer Focus, Integrity" %>
      <div class="form-text">Core values that define your brand (comma-separated)</div>
    </div>

    <div class="wizard-actions d-flex justify-content-between align-items-center">
      <%= link_to onboarding_path(step: 'website'), class: "btn btn-outline-secondary" do %>
        ← Back
      <% end %>
      <%= f.submit "Continue", class: "btn btn-primary" %>
    </div>
  <% end %>
</div>
