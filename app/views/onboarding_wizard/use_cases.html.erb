<div class="wizard-container">
  <div class="wizard-progress">
    <div class="progress-bar" style="width: <%= (@current_step_index.to_f / @total_steps * 100).round %>%;"></div>
  </div>

  <div class="wizard-content">
    <h1 class="wizard-title mb-2">How Will You Use Amos?</h1>
    <p class="wizard-subtitle text-muted mb-4">
      Select all that apply - this helps us customize your workspace
    </p>

    <%= form_with url: onboarding_path(step: 'use_cases'), method: :patch, data: { turbo: false } do %>
      <div class="use-cases-grid row">
        <% [
          { slug: 'landing_pages', name: 'Create Landing Pages', icon: 'layout', desc: 'Build professional landing pages' },
          { slug: 'email_marketing', name: 'Email Marketing', icon: 'mail', desc: 'Run email campaigns' },
          { slug: 'contact_management', name: 'Manage Contacts', icon: 'users', desc: 'Organize leads and customers' },
          { slug: 'automation', name: 'Automate Tasks', icon: 'zap', desc: 'Set up automated workflows' },
          { slug: 'analytics', name: 'Track Analytics', icon: 'bar-chart-2', desc: 'Monitor business metrics' },
          { slug: 'integrations', name: 'Connect Apps', icon: 'plug', desc: 'Integrate with other tools' },
          { slug: 'content', name: 'Generate Content', icon: 'edit-3', desc: 'AI-powered content creation' },
          { slug: 'team', name: 'Team Collaboration', icon: 'users', desc: 'Work with your team' }
        ].each do |use_case| %>
          <div class="col-md-6 mb-3">
            <label class="use-case-card d-flex align-items-center p-3 rounded h-100 <%= 'selected' if @selected_use_cases.include?(use_case[:slug]) %>"
                   for="use_case_<%= use_case[:slug] %>">
              <%= check_box_tag "use_cases[]", use_case[:slug], 
                  @selected_use_cases.include?(use_case[:slug]),
                  class: "form-check-input me-3", 
                  id: "use_case_#{use_case[:slug]}" %>
              <div class="use-case-icon me-3" style="color: #A78BFA;">
                <i data-lucide="<%= use_case[:icon] %>" style="width: 24px; height: 24px;"></i>
              </div>
              <div>
                <strong><%= use_case[:name] %></strong>
                <p class="text-muted small mb-0"><%= use_case[:desc] %></p>
              </div>
            </label>
          </div>
        <% end %>
      </div>

      <div class="wizard-actions d-flex justify-content-between mt-4">
        <% back_step = @usage_type == 'personal' ? 'usage_type' : 'your_business' %>
        <%= link_to "← Back", onboarding_path(step: back_step), class: "btn btn-outline-secondary" %>
        <%= submit_tag "Continue →", class: "btn btn-primary" %>
      </div>
    <% end %>
  </div>
</div>

<style>
  .wizard-container { max-width: 800px; margin: 0 auto; padding: 2rem; }
  .wizard-progress { height: 4px; background: rgba(124, 58, 237, 0.15); border-radius: 2px; margin-bottom: 3rem; }
  .wizard-progress .progress-bar { height: 100%; background: linear-gradient(90deg, #7C3AED, #3B82F6); border-radius: 2px; }
  .wizard-title { font-size: 2rem; font-weight: 700; color: #1E293B; }
  .wizard-subtitle { color: #64748B; }
  
  .use-case-card { 
    background: #fff; 
    border: 2px solid #E2E8F0; 
    cursor: pointer; 
    transition: all 0.2s ease; 
  }
  .use-case-card:hover { 
    border-color: rgba(124, 58, 237, 0.4); 
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
  }
  .use-case-card.selected, .use-case-card:has(input:checked) { 
    border-color: #7C3AED; 
    background: rgba(124, 58, 237, 0.05); 
  }
  .use-case-card strong { color: #1E293B; }
  
  .btn-primary { background: linear-gradient(135deg, #7C3AED, #3B82F6); border: none; font-weight: 600; }
  .btn-outline-secondary { border-color: #E2E8F0; color: #64748B; }
  .btn-outline-secondary:hover { background: #F1F5F9; border-color: #E2E8F0; color: #1E293B; }
</style>
