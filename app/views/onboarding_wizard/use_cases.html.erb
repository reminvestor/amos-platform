<%# Progress bar is in the card already %>
  <div class="wizard-progress">
    <div class="progress-bar" style="width: <%= (@current_step_index.to_f / @total_steps * 100).round %>%;"></div>
  </div>

<div class="pt-4">
  <div class="text-center mb-4">
    <h1 class="wizard-title">What would you like to do?</h1>
    <p class="wizard-subtitle">
      Select everything that interests you — we'll customize your workspace
    </p>
  </div>

    <%= form_with url: onboarding_path(step: 'use_cases'), method: :patch, data: { turbo: false } do %>
    <% if @usage_type == 'personal' %>
      <%# ========== PERSONAL USE CASES ========== %>
      
      <%# Productivity Category %>
      <div class="use-case-category">
        <div class="category-header">
          <span class="category-emoji">✅</span>
          <span>Productivity</span>
        </div>
        <div class="use-case-grid">
          <% [
            { slug: 'tasks', name: 'Tasks & To-dos', emoji: '☑️' },
            { slug: 'notes', name: 'Notes & Ideas', emoji: '📝' },
            { slug: 'reminders', name: 'Reminders', emoji: '🔔' },
            { slug: 'calendar', name: 'Calendar', emoji: '📅' }
          ].each do |use_case| %>
            <label class="use-case-chip <%= 'selected' if @selected_use_cases.include?(use_case[:slug]) %>"
                   for="use_case_<%= use_case[:slug] %>">
              <%= check_box_tag "use_cases[]", use_case[:slug], 
                  @selected_use_cases.include?(use_case[:slug]),
                  class: "use-case-checkbox", 
                  id: "use_case_#{use_case[:slug]}" %>
              <span class="chip-emoji"><%= use_case[:emoji] %></span>
              <span class="chip-text"><%= use_case[:name] %></span>
            </label>
          <% end %>
        </div>
      </div>

      <%# AI Assistant Category %>
      <div class="use-case-category">
        <div class="category-header">
          <span class="category-emoji">✨</span>
          <span>AI Assistant</span>
        </div>
        <div class="use-case-grid">
          <% [
            { slug: 'research', name: 'Research', emoji: '🔍' },
            { slug: 'writing', name: 'Writing Help', emoji: '✏️' },
            { slug: 'learning', name: 'Learning', emoji: '🎓' },
            { slug: 'brainstorm', name: 'Brainstorming', emoji: '💡' }
          ].each do |use_case| %>
            <label class="use-case-chip <%= 'selected' if @selected_use_cases.include?(use_case[:slug]) %>"
                   for="use_case_<%= use_case[:slug] %>">
              <%= check_box_tag "use_cases[]", use_case[:slug], 
                  @selected_use_cases.include?(use_case[:slug]),
                  class: "use-case-checkbox", 
                  id: "use_case_#{use_case[:slug]}" %>
              <span class="chip-emoji"><%= use_case[:emoji] %></span>
              <span class="chip-text"><%= use_case[:name] %></span>
            </label>
          <% end %>
        </div>
      </div>

      <%# Organization Category %>
      <div class="use-case-category">
        <div class="category-header">
          <span class="category-emoji">📁</span>
          <span>Organization</span>
        </div>
        <div class="use-case-grid">
          <% [
            { slug: 'documents', name: 'Documents', emoji: '📄' },
            { slug: 'bookmarks', name: 'Bookmarks', emoji: '🔖' },
            { slug: 'automation', name: 'Automation', emoji: '⚡' }
          ].each do |use_case| %>
            <label class="use-case-chip <%= 'selected' if @selected_use_cases.include?(use_case[:slug]) %>"
                   for="use_case_<%= use_case[:slug] %>">
              <%= check_box_tag "use_cases[]", use_case[:slug], 
                  @selected_use_cases.include?(use_case[:slug]),
                  class: "use-case-checkbox", 
                  id: "use_case_#{use_case[:slug]}" %>
              <span class="chip-emoji"><%= use_case[:emoji] %></span>
              <span class="chip-text"><%= use_case[:name] %></span>
            </label>
          <% end %>
        </div>
      </div>

    <% else %>
      <%# ========== BUSINESS/WORK USE CASES ========== %>
      
      <%# Marketing Category %>
      <div class="use-case-category">
        <div class="category-header">
          <span class="category-emoji">📢</span>
          <span>Marketing</span>
        </div>
        <div class="use-case-grid">
          <% [
            { slug: 'landing_pages', name: 'Landing Pages', emoji: '🌐' },
            { slug: 'email_marketing', name: 'Email Campaigns', emoji: '📧' },
            { slug: 'social_media', name: 'Social Media', emoji: '📱' },
            { slug: 'content', name: 'Content Creation', emoji: '✏️' }
        ].each do |use_case| %>
            <label class="use-case-chip <%= 'selected' if @selected_use_cases.include?(use_case[:slug]) %>"
                   for="use_case_<%= use_case[:slug] %>">
              <%= check_box_tag "use_cases[]", use_case[:slug], 
                  @selected_use_cases.include?(use_case[:slug]),
                  class: "use-case-checkbox", 
                  id: "use_case_#{use_case[:slug]}" %>
              <span class="chip-emoji"><%= use_case[:emoji] %></span>
              <span class="chip-text"><%= use_case[:name] %></span>
            </label>
          <% end %>
        </div>
              </div>

      <%# Sales & CRM Category %>
      <div class="use-case-category">
        <div class="category-header">
          <span class="category-emoji">👥</span>
          <span>Sales & CRM</span>
              </div>
        <div class="use-case-grid">
          <% [
            { slug: 'contacts', name: 'Contacts', emoji: '👤' },
            { slug: 'pipeline', name: 'Sales Pipeline', emoji: '📊' },
            { slug: 'analytics', name: 'Analytics', emoji: '📈' }
          ].each do |use_case| %>
            <label class="use-case-chip <%= 'selected' if @selected_use_cases.include?(use_case[:slug]) %>"
                   for="use_case_<%= use_case[:slug] %>">
              <%= check_box_tag "use_cases[]", use_case[:slug], 
                  @selected_use_cases.include?(use_case[:slug]),
                  class: "use-case-checkbox", 
                  id: "use_case_#{use_case[:slug]}" %>
              <span class="chip-emoji"><%= use_case[:emoji] %></span>
              <span class="chip-text"><%= use_case[:name] %></span>
            </label>
          <% end %>
        </div>
      </div>

      <%# Operations Category %>
      <div class="use-case-category">
        <div class="category-header">
          <span class="category-emoji">⚙️</span>
          <span>Operations</span>
          </div>
        <div class="use-case-grid">
          <% [
            { slug: 'automation', name: 'Automation', emoji: '⚡' },
            { slug: 'scheduling', name: 'Scheduling', emoji: '📅' },
            { slug: 'integrations', name: 'Integrations', emoji: '🔌' },
            { slug: 'documents', name: 'Documents', emoji: '📄' }
          ].each do |use_case| %>
            <label class="use-case-chip <%= 'selected' if @selected_use_cases.include?(use_case[:slug]) %>"
                   for="use_case_<%= use_case[:slug] %>">
              <%= check_box_tag "use_cases[]", use_case[:slug], 
                  @selected_use_cases.include?(use_case[:slug]),
                  class: "use-case-checkbox", 
                  id: "use_case_#{use_case[:slug]}" %>
              <span class="chip-emoji"><%= use_case[:emoji] %></span>
              <span class="chip-text"><%= use_case[:name] %></span>
            </label>
        <% end %>
        </div>
      </div>

      <%# Custom Apps Category %>
      <div class="use-case-category">
        <div class="category-header">
          <span class="category-emoji">📦</span>
          <span>Custom Apps</span>
        </div>
        <div class="use-case-grid">
          <% [
            { slug: 'custom_apps', name: 'Build Custom Apps', emoji: '✨' },
            { slug: 'inventory', name: 'Inventory', emoji: '📦' },
            { slug: 'projects', name: 'Projects', emoji: '📋' },
            { slug: 'custom_agents', name: 'AI Agents', emoji: '🤖' }
          ].each do |use_case| %>
            <label class="use-case-chip <%= 'selected' if @selected_use_cases.include?(use_case[:slug]) %>"
                   for="use_case_<%= use_case[:slug] %>">
              <%= check_box_tag "use_cases[]", use_case[:slug], 
                  @selected_use_cases.include?(use_case[:slug]),
                  class: "use-case-checkbox", 
                  id: "use_case_#{use_case[:slug]}" %>
              <span class="chip-emoji"><%= use_case[:emoji] %></span>
              <span class="chip-text"><%= use_case[:name] %></span>
            </label>
          <% end %>
        </div>
      </div>
    <% end %>

    <div class="wizard-actions d-flex justify-content-between align-items-center">
      <% back_step = @usage_type == 'personal' ? 'about_you' : 'your_business' %>
      <%= link_to onboarding_path(step: back_step), class: "btn btn-outline-secondary" do %>
        ← Back
      <% end %>
      <%= submit_tag "Continue", class: "btn btn-primary" %>
  </div>
  <% end %>
</div>

<style>
  /* Category styling */
  .use-case-category {
    margin-bottom: 1.5rem;
  }
  
  .category-header {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.75rem;
    font-weight: 600;
    font-size: 0.8125rem;
    color: var(--text-secondary);
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }
  
  .category-emoji {
    font-size: 1rem;
  }
  
  /* Grid of chips */
  .use-case-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  
  /* Chip styling */
  .use-case-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.625rem 1rem;
    background: var(--bg-primary);
    border: 1.5px solid var(--border);
    border-radius: 100px;
    cursor: pointer; 
    transition: all 0.2s ease; 
    font-size: 0.875rem;
    color: var(--text-primary);
  }
  
  .use-case-chip:hover {
    border-color: rgba(124, 58, 237, 0.4); 
    background: linear-gradient(135deg, rgba(124, 58, 237, 0.04), rgba(59, 130, 246, 0.04));
  }
  
  .use-case-chip.selected,
  .use-case-chip:has(input:checked) {
    background: linear-gradient(135deg, rgba(124, 58, 237, 0.1), rgba(59, 130, 246, 0.1));
    border-color: var(--primary);
    color: var(--primary);
  }
  
  .use-case-checkbox {
    display: none;
  }
  
  .chip-emoji {
    font-size: 1rem;
    flex-shrink: 0;
  }
  
  .chip-text {
    font-weight: 500;
    white-space: nowrap;
  }
  
  /* Responsive adjustments */
  @media (max-width: 480px) {
    .use-case-chip {
      padding: 0.5rem 0.875rem;
      font-size: 0.8125rem;
    }
  }
</style>
