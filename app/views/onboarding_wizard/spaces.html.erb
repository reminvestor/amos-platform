<%# Progress bar is in the card already %>
<div class="wizard-progress">
  <div class="progress-bar" style="width: <%= (@current_step_index.to_f / @total_steps * 100).round %>%;"></div>
</div>

<div class="pt-4">
  <div class="text-center mb-4">
    <h1 class="wizard-title">Customize Your Views</h1>
    <p class="wizard-subtitle">
      Organize your workflow with different views for different contexts
    </p>
  </div>

  <%= form_with url: onboarding_path(step: 'spaces'), method: :patch, data: { turbo: false } do |f| %>
    <%# Team Space - Always Enabled %>
    <div class="space-card-default p-3 rounded-3 mb-4" 
         style="background: linear-gradient(135deg, rgba(124, 58, 237, 0.06), rgba(59, 130, 246, 0.06)); border: 1px solid rgba(124, 58, 237, 0.15);">
      <div class="d-flex align-items-center">
        <div class="me-3" style="width: 44px; height: 44px; background: var(--gradient); border-radius: 10px; display: flex; align-items: center; justify-content: center;">
          <i data-lucide="users" style="width: 22px; height: 22px; color: white;"></i>
        </div>
        <div class="flex-grow-1">
          <div class="d-flex align-items-center gap-2">
            <strong style="color: var(--text-primary);">Team View</strong>
            <span class="badge" style="background: var(--gradient); font-size: 0.65rem; padding: 0.2rem 0.4rem;">Default</span>
          </div>
          <div style="font-size: 0.8125rem; color: var(--text-secondary);">Your main hub for interacting with agents</div>
        </div>
        <i data-lucide="check-circle" style="width: 20px; height: 20px; color: var(--primary);"></i>
      </div>
      <%= hidden_field_tag "enabled_spaces[]", 'team' %>
    </div>

    <%# Optional Spaces %>
    <div class="mb-3">
      <h6 style="color: var(--text-primary); font-weight: 600;" class="mb-2">Add Optional Views</h6>
      <p style="color: var(--text-muted); font-size: 0.8125rem;">You can always add or remove them later.</p>
    </div>
    
    <div class="row g-2 mb-4">
      <% ['personal', 'work'].each do |space_slug| %>
        <% space = @spaces.find { |s| s.slug == space_slug } %>
        <% next unless space %>
        <div class="col-6">
          <div class="space-card p-3 rounded-3 h-100 <%= 'selected' if @enabled_spaces.include?(space.slug) %>"
               data-space="<%= space.slug %>"
               onclick="toggleSpace('<%= space.slug %>')">
            <div class="d-flex align-items-start">
              <div class="form-check me-2">
                <%= check_box_tag "enabled_spaces[]", 
                    space.slug, 
                    @enabled_spaces.include?(space.slug),
                    class: "form-check-input space-checkbox",
                    id: "space_#{space.slug}" %>
              </div>
              <div class="space-icon me-3">
                <i data-lucide="<%= space.icon %>" style="width: 22px; height: 22px;"></i>
              </div>
              <div class="flex-grow-1">
                <div class="space-name"><%= space.name %></div>
                <div class="space-desc"><%= space.description %></div>
              </div>
            </div>
          </div>
        </div>
      <% end %>
    </div>

    <div class="wizard-actions d-flex justify-content-between align-items-center">
      <%= link_to onboarding_path(step: 'features'), class: "btn btn-outline-secondary" do %>
        <i data-lucide="arrow-left" style="width: 16px; height: 16px;" class="me-1"></i>
        Back
      <% end %>
      <%= submit_tag "Continue", class: "btn btn-primary" %>
    </div>
  <% end %>
</div>

<style>
  .space-card {
    background: var(--bg-primary);
    border: 2px solid var(--border);
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .space-card:hover {
    border-color: rgba(124, 58, 237, 0.3);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
  }

  .space-card.selected {
    border-color: var(--primary);
    background: linear-gradient(135deg, rgba(124, 58, 237, 0.04), rgba(59, 130, 246, 0.04));
  }
  
  .space-icon {
    width: 40px;
    height: 40px;
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, rgba(124, 58, 237, 0.1), rgba(59, 130, 246, 0.1));
    color: var(--primary);
    flex-shrink: 0;
  }
  
  .space-card.selected .space-icon {
    background: var(--gradient);
    color: white;
  }
  
  .space-name {
    font-weight: 600;
    font-size: 0.9375rem;
    color: var(--text-primary);
    margin-bottom: 0.25rem;
  }
  
  .space-desc {
    font-size: 0.8125rem;
    color: var(--text-secondary);
    line-height: 1.4;
  }
  
  .form-check-input {
    flex-shrink: 0;
  }
  
  .form-check-input:checked {
    background-color: var(--primary);
    border-color: var(--primary);
  }
</style>

<script>
  function toggleSpace(slug) {
    const checkbox = document.getElementById('space_' + slug);
    const card = document.querySelector(`[data-space="${slug}"]`);
    
    checkbox.checked = !checkbox.checked;
    card.classList.toggle('selected', checkbox.checked);
  }
</script>
