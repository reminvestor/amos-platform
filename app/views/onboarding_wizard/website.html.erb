<%# Progress bar is in the card already %>
<div class="wizard-progress">
  <div class="progress-bar" style="width: <%= (@current_step_index.to_f / @total_steps * 100).round %>%;"></div>
</div>

<div class="pt-4 text-center">
  <div class="mb-4">
    <div class="wizard-icon-wrapper d-inline-flex align-items-center justify-content-center mb-3" 
         style="width: 72px; height: 72px; background: linear-gradient(135deg, rgba(124, 58, 237, 0.1), rgba(59, 130, 246, 0.1)); border-radius: 16px; font-size: 2rem;">
      🌐
    </div>
    <h1 class="wizard-title">Do you have a website?</h1>
    <p class="wizard-subtitle">
      If you share your website, we'll automatically learn about your business<br>
      and pre-fill your profile to save you time.
    </p>
  </div>

  <%= form_with url: onboarding_path(step: 'website'), method: :patch, data: { turbo: false, controller: "website-analyzer" } do |f| %>
    <div class="text-start mb-4">
      <label class="form-label">Your Website URL</label>
      <div class="input-group">
        <span class="input-group-text">🔗</span>
        <%= text_field_tag :website_url, @website_url, 
            class: "form-control", 
            placeholder: "yourcompany.com",
            data: { website_analyzer_target: "input" } %>
      </div>
      <div class="form-text mt-2">
        ✨ We'll analyze your site to extract your business name, industry, and description
      </div>
    </div>

    <% if @website_analyzed %>
      <div class="alert-info-custom d-flex align-items-center mb-4">
        <span class="me-2">✅</span>
        <div style="color: var(--text-primary);">Got it! We've learned about your business and saved it to memory.</div>
      </div>
    <% end %>

    <div class="wizard-actions d-flex justify-content-between align-items-center">
      <%= link_to onboarding_path(step: 'about_you'), class: "btn btn-outline-secondary" do %>
        ← Back
      <% end %>
      
      <div class="d-flex gap-2 align-items-center">
        <%= link_to "Skip", onboarding_path(step: 'your_business'), class: "btn btn-link", style: "color: var(--text-muted);" %>
        <%= f.submit "Analyze & Continue", class: "btn btn-primary", data: { website_analyzer_target: "submit" } %>
      </div>
    </div>
  <% end %>

  <div class="mt-4 pt-3" style="border-top: 1px solid var(--border);">
    <p style="color: var(--text-muted); font-size: 0.8125rem;">
      🔒 We only read publicly available information. Your data is never shared.
    </p>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    // Auto-format URL input
    const urlInput = document.querySelector('[data-website-analyzer-target="input"]');
    if (urlInput) {
      urlInput.addEventListener('blur', function() {
        let value = this.value.trim();
        if (value && !value.startsWith('http://') && !value.startsWith('https://')) {
          this.value = 'https://' + value;
        }
      });
    }
    
    // Show loading state on submit
    const form = document.querySelector('form');
    const submitBtn = document.querySelector('[data-website-analyzer-target="submit"]');
    
    if (form && submitBtn) {
      form.addEventListener('submit', function() {
        const urlValue = urlInput?.value?.trim();
        if (urlValue) {
          submitBtn.disabled = true;
          submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-2" role="status"></span>Analyzing...';
        }
      });
    }
  });
</script>
