<%# Progress bar is in the card already %>
<div class="wizard-progress">
  <div class="progress-bar" style="width: 100%;"></div>
</div>

<div class="pt-4 text-center">
  <%# Celebratory animation %>
  <div class="celebration-animation mb-4">
    <div class="celebration-ring"></div>
    <div class="celebration-ring delay-1"></div>
    <div class="celebration-icon">
      <i data-lucide="rocket" style="width: 40px; height: 40px; color: white;"></i>
    </div>
  </div>
  
  <h1 class="wizard-title mb-2">You're Ready to Go!</h1>
  <p class="wizard-subtitle mb-4">
    Your AI-powered workspace is set up and waiting for you
  </p>

  <%# What's Next Preview %>
  <div class="whats-next p-4 rounded-3 mb-4 text-start" 
       style="background: linear-gradient(135deg, rgba(124, 58, 237, 0.06), rgba(59, 130, 246, 0.06)); border: 1px solid rgba(124, 58, 237, 0.1);">
    <h6 class="mb-3" style="color: var(--text-primary); font-weight: 600;">
      <i data-lucide="sparkles" style="width: 18px; height: 18px; color: var(--primary);" class="me-2"></i>
      What You Can Do Now
    </h6>
    
    <div class="d-flex flex-column gap-2">
      <% if session[:onboarding_usage_type] == 'personal' %>
        <div class="next-item d-flex align-items-center">
          <div class="next-icon me-3" style="background: rgba(16, 185, 129, 0.15); color: #10B981;">
            <i data-lucide="message-circle" style="width: 16px; height: 16px;"></i>
          </div>
          <span style="color: var(--text-secondary); font-size: 0.875rem;">Just chat with Amos - ask anything, get things done</span>
        </div>
        <div class="next-item d-flex align-items-center">
          <div class="next-icon me-3" style="background: rgba(59, 130, 246, 0.15); color: #3B82F6;">
            <i data-lucide="check-square" style="width: 16px; height: 16px;"></i>
          </div>
          <span style="color: var(--text-secondary); font-size: 0.875rem;">Create tasks, notes, and reminders with natural language</span>
        </div>
        <div class="next-item d-flex align-items-center">
          <div class="next-icon me-3" style="background: rgba(124, 58, 237, 0.15); color: #7C3AED;">
            <i data-lucide="calendar" style="width: 16px; height: 16px;"></i>
          </div>
          <span style="color: var(--text-secondary); font-size: 0.875rem;">Schedule recurring tasks and automate your routines</span>
        </div>
      <% else %>
        <div class="next-item d-flex align-items-center">
          <div class="next-icon me-3" style="background: rgba(16, 185, 129, 0.15); color: #10B981;">
            <i data-lucide="message-circle" style="width: 16px; height: 16px;"></i>
          </div>
          <span style="color: var(--text-secondary); font-size: 0.875rem;">Just chat with Amos - describe what you need, and it happens</span>
        </div>
        <div class="next-item d-flex align-items-center">
          <div class="next-icon me-3" style="background: rgba(59, 130, 246, 0.15); color: #3B82F6;">
            <i data-lucide="box" style="width: 16px; height: 16px;"></i>
          </div>
          <span style="color: var(--text-secondary); font-size: 0.875rem;">Build custom apps for your specific business needs</span>
        </div>
        <div class="next-item d-flex align-items-center">
          <div class="next-icon me-3" style="background: rgba(124, 58, 237, 0.15); color: #7C3AED;">
            <i data-lucide="zap" style="width: 16px; height: 16px;"></i>
          </div>
          <span style="color: var(--text-secondary); font-size: 0.875rem;">Automate marketing, contacts, and business workflows</span>
        </div>
      <% end %>
    </div>
  </div>

  <%# Two-Factor Authentication suggestion - required for integrations %>
  <% unless current_user.mfa_enabled? %>
    <div class="security-suggestion p-4 rounded-3 mb-4 text-start" 
         style="background: linear-gradient(135deg, rgba(59, 130, 246, 0.08), rgba(124, 58, 237, 0.08)); border: 1px solid rgba(59, 130, 246, 0.2);">
      <div class="d-flex align-items-start">
        <div class="security-icon me-3" style="background: rgba(59, 130, 246, 0.15); width: 40px; height: 40px; border-radius: 10px; display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
          <i data-lucide="shield-check" style="width: 20px; height: 20px; color: #3B82F6;"></i>
        </div>
        <div class="flex-grow-1">
          <h6 class="mb-1" style="color: var(--text-primary); font-weight: 600; font-size: 0.95rem;">
            Secure Your Account with 2FA
          </h6>
          <p class="mb-2" style="color: var(--text-secondary); font-size: 0.85rem; line-height: 1.5;">
            Two-factor authentication adds an extra layer of security. 
            <strong>Note:</strong> 2FA is required before connecting external integrations (Stripe, QuickBooks, etc.).
          </p>
          <div class="d-flex gap-2 flex-wrap">
            <%= link_to users_two_factor_path, class: "btn btn-sm btn-outline-primary" do %>
              <i data-lucide="shield-plus" style="width: 14px; height: 14px;" class="me-1"></i>
              Set Up Now
            <% end %>
            <button type="button" class="btn btn-sm btn-link text-muted" onclick="this.closest('.security-suggestion').remove()">
              I'll do this later
            </button>
          </div>
        </div>
      </div>
    </div>
  <% end %>

  <%# Pro tip %>
  <div class="pro-tip p-3 rounded-3 mb-4" style="background: rgba(245, 158, 11, 0.08); border: 1px solid rgba(245, 158, 11, 0.15);">
    <div class="d-flex align-items-start">
      <i data-lucide="lightbulb" style="width: 18px; height: 18px; color: #F59E0B; flex-shrink: 0;" class="me-2 mt-1"></i>
      <div style="text-align: left;">
        <strong style="color: var(--text-primary); font-size: 0.875rem;">Pro tip:</strong>
        <span style="color: var(--text-secondary); font-size: 0.875rem;">
          Amos learns from you. The more you use it, the better it understands your style and preferences.
        </span>
      </div>
    </div>
  </div>

  <%= form_with url: onboarding_path(step: 'complete'), method: :patch, data: { turbo: false } do %>
    <div class="wizard-actions">
      <%= submit_tag "Launch Amos", class: "btn btn-primary btn-lg w-100 launch-btn" %>
    </div>
  <% end %>
</div>

<style>
  .wizard-progress .progress-bar {
    background: linear-gradient(90deg, var(--primary), var(--success));
  }
  
  /* Celebration animation */
  .celebration-animation {
    position: relative;
    width: 80px;
    height: 80px;
    margin: 0 auto;
  }
  
  .celebration-icon {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 64px;
    height: 64px;
    background: var(--gradient);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 2;
  }
  
  .celebration-ring {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 80px;
    height: 80px;
    border: 2px solid var(--primary);
    border-radius: 50%;
    opacity: 0;
    animation: ring-expand 2s ease-out infinite;
  }
  
  .celebration-ring.delay-1 {
    animation-delay: 0.5s;
  }
  
  @keyframes ring-expand {
    0% {
      width: 64px;
      height: 64px;
      opacity: 0.6;
    }
    100% {
      width: 120px;
      height: 120px;
      opacity: 0;
    }
  }
  
  /* Next items */
  .next-icon {
    width: 32px;
    height: 32px;
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  
  /* Launch button pulse */
  .launch-btn {
    position: relative;
    overflow: hidden;
  }
  
  .launch-btn::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    width: 0;
    height: 0;
    background: rgba(255, 255, 255, 0.2);
    border-radius: 50%;
    transform: translate(-50%, -50%);
    animation: pulse-ring 2s ease-out infinite;
  }
  
  @keyframes pulse-ring {
    0% {
      width: 0;
      height: 0;
      opacity: 0.5;
    }
    100% {
      width: 300px;
      height: 300px;
      opacity: 0;
    }
  }
</style>
