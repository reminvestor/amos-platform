<%# Combined Welcome + Usage Type Selection %>
<div class="wizard-progress">
  <div class="progress-bar" style="width: <%= (@current_step_index.to_f / @total_steps * 100).round %>%;"></div>
</div>

<div class="pt-4">
  <%# Welcome Header %>
  <div class="text-center mb-4">
    <div class="mb-3">
      <%= image_tag "Logo_pfp_2.png", alt: "Amos", 
          style: "height: 72px; width: 72px; border-radius: 16px; object-fit: cover; box-shadow: 0 4px 20px rgba(124, 58, 237, 0.15);" %>
    </div>
    
    <h1 class="wizard-title mb-2">Welcome to AMOS</h1>
    <p class="wizard-subtitle mb-0">
      Your AI collaboration platform.<br>
      Build the future, faster.
    </p>
  </div>

  <%# Usage Type Selection %>
  <div class="text-center mb-3">
    <p style="color: var(--text-secondary); font-size: 0.9375rem; font-weight: 500;">
      How will you use Amos?
    </p>
  </div>

  <%= form_with url: onboarding_path(step: 'welcome'), method: :patch, data: { turbo: false } do |f| %>
    <div class="row g-3 mb-4">
      <%# Work/Business Option %>
      <div class="col-6">
        <input type="radio" class="btn-check" name="usage_type" id="usage_work" value="work" 
               <%= 'checked' if @usage_type == 'work' || @usage_type.blank? %>>
        <label class="usage-card h-100" for="usage_work">
          <div class="usage-icon mb-2">
            💼
          </div>
          <h5 class="mb-1">Work</h5>
          <p class="usage-desc mb-2">
            Business & teams
          </p>
          <ul class="usage-features">
            <li>✓ Marketing & CRM</li>
            <li>✓ Custom apps</li>
            <li>✓ Automation</li>
          </ul>
        </label>
      </div>

      <%# Personal Option %>
      <div class="col-6">
        <input type="radio" class="btn-check" name="usage_type" id="usage_personal" value="personal"
               <%= 'checked' if @usage_type == 'personal' %>>
        <label class="usage-card h-100" for="usage_personal">
          <div class="usage-icon mb-2">
            🏠
          </div>
          <h5 class="mb-1">Personal</h5>
          <p class="usage-desc mb-2">
            Life & productivity
          </p>
          <ul class="usage-features">
            <li>✓ Tasks & notes</li>
            <li>✓ Reminders</li>
            <li>✓ AI assistant</li>
          </ul>
        </label>
      </div>
    </div>

    <div class="text-center">
      <%= submit_tag "Get Started", class: "btn btn-primary btn-lg px-5" %>
    </div>
  <% end %>

  <div class="text-center mt-4 pt-3" style="border-top: 1px solid var(--border);">
    <%= button_to "Skip setup for now", onboarding_skip_path, method: :post, 
        style: "background: none; border: none; color: var(--text-muted); font-size: 0.8125rem; cursor: pointer;",
        data: { turbo: false } %>
  </div>
</div>

<style>
  .usage-card {
    display: block;
    background: var(--bg-primary);
    border: 2px solid var(--border);
    border-radius: 14px;
    padding: 1.25rem;
    cursor: pointer;
    transition: all 0.2s ease;
    text-align: center;
  }

  .usage-card:hover {
    border-color: rgba(124, 58, 237, 0.3);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.06);
    transform: translateY(-2px);
  }

  .btn-check:checked + .usage-card {
    border-color: var(--primary);
    background: linear-gradient(135deg, rgba(124, 58, 237, 0.04) 0%, rgba(59, 130, 246, 0.04) 100%);
    box-shadow: 0 4px 16px rgba(124, 58, 237, 0.15);
  }

  .usage-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    border-radius: 12px;
    background: linear-gradient(135deg, rgba(124, 58, 237, 0.1) 0%, rgba(59, 130, 246, 0.1) 100%);
    font-size: 1.5rem;
  }

  .btn-check:checked + .usage-card .usage-icon {
    background: var(--gradient);
  }

  .usage-card h5 {
    color: var(--text-primary);
    font-weight: 700;
    font-size: 1rem;
    margin: 0;
  }

  .usage-desc {
    color: var(--text-secondary);
    font-size: 0.75rem;
    line-height: 1.4;
    margin: 0;
  }

  .usage-features {
    list-style: none;
    padding: 0;
    margin: 0;
    text-align: left;
  }

  .usage-features li {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    color: var(--text-secondary);
    padding: 0.25rem 0;
    font-size: 0.75rem;
  }
</style>
