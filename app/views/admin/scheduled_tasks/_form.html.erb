<%= form_with model: [:admin, @scheduled_task], class: "needs-validation", local: true do |f| %>
  <% if @scheduled_task.errors.any? %>
    <div class="alert alert-danger">
      <h6 class="alert-heading">Please fix the following errors:</h6>
      <ul class="mb-0">
        <% @scheduled_task.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="row">
    <div class="col-lg-8">
      <!-- Basic Info -->
      <div class="card mb-4">
        <div class="card-header">
          <h5 class="mb-0">Basic Information</h5>
        </div>
        <div class="card-body">
          <div class="mb-3">
            <%= f.label :name, class: "form-label" %>
            <%= f.text_field :name, class: "form-control", placeholder: "e.g., Morning Email Summary" %>
          </div>

          <div class="mb-3">
            <%= f.label :description, class: "form-label" %>
            <%= f.text_area :description, class: "form-control", rows: 2, placeholder: "Optional description of what this task does" %>
          </div>

          <div class="row">
            <div class="col-md-6 mb-3">
              <%= f.label :entity_id, "Entity", class: "form-label" %>
              <%= f.collection_select :entity_id, @entities, :id, :name, 
                { prompt: "Select entity..." }, 
                { class: "form-select" } %>
            </div>
            <div class="col-md-6 mb-3">
              <%= f.label :user_id, "User", class: "form-label" %>
              <% if @scheduled_task.entity_id %>
                <%= f.collection_select :user_id, @scheduled_task.entity.users, :id, :email,
                  { prompt: "Select user..." },
                  { class: "form-select" } %>
              <% else %>
                <select class="form-select" disabled>
                  <option>Select entity first...</option>
                </select>
              <% end %>
            </div>
          </div>

          <div class="row">
            <div class="col-md-6 mb-3">
              <%= f.label :task_type, class: "form-label" %>
              <%= f.select :task_type, 
                ScheduledAgentTask::TASK_TYPES.map { |k, v| ["#{v[:icon]} #{v[:name]}", k] },
                { prompt: "Select type..." },
                { class: "form-select" } %>
            </div>
            <div class="col-md-6 mb-3">
              <%= f.label :agent_plugin_id, "Agent (optional)", class: "form-label" %>
              <%= f.collection_select :agent_plugin_id, @agents, :id, :name,
                { prompt: "Scout (default)", include_blank: true },
                { class: "form-select" } %>
              <div class="form-text">Leave blank to use Scout</div>
            </div>
          </div>
        </div>
      </div>

      <!-- Prompt -->
      <div class="card mb-4">
        <div class="card-header">
          <h5 class="mb-0">Task Prompt</h5>
        </div>
        <div class="card-body">
          <div class="mb-3">
            <%= f.label :prompt, class: "form-label" %>
            <%= f.text_area :prompt, class: "form-control font-monospace", rows: 8,
              placeholder: "Enter the prompt that will be sent to Scout or the agent..." %>
            <div class="form-text">
              This is the instruction that will be executed on schedule. Be specific about what you want done.
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="col-lg-4">
      <!-- Schedule -->
      <div class="card mb-4">
        <div class="card-header">
          <h5 class="mb-0">Schedule</h5>
        </div>
        <div class="card-body">
          <div class="mb-3">
            <%= f.label :schedule_type, class: "form-label" %>
            <%= f.select :schedule_type,
              [
                ['One-time', 'once'],
                ['Daily', 'daily'],
                ['Weekly', 'weekly'],
                ['Monthly', 'monthly'],
                ['Custom (Cron)', 'cron']
              ],
              {},
              { class: "form-select", id: "scheduleType" } %>
          </div>

          <div id="timeFields" class="mb-3" style="display: none;">
            <%= f.label :run_at_time, "Time", class: "form-label" %>
            <%= f.time_field :run_at_time, class: "form-control" %>
          </div>

          <div id="dayOfWeekField" class="mb-3" style="display: none;">
            <%= f.label :run_on_day, "Day of Week", class: "form-label" %>
            <%= f.select :run_on_day,
              Date::DAYNAMES.each_with_index.map { |name, i| [name, i] },
              { prompt: "Select day..." },
              { class: "form-select" } %>
          </div>

          <div id="dayOfMonthField" class="mb-3" style="display: none;">
            <%= f.label :run_on_day, "Day of Month", class: "form-label" %>
            <%= f.select :run_on_day,
              (1..31).map { |d| [d.ordinalize, d] },
              { prompt: "Select day..." },
              { class: "form-select" } %>
          </div>

          <div id="cronField" class="mb-3" style="display: none;">
            <%= f.label :cron_expression, class: "form-label" %>
            <%= f.text_field :cron_expression, class: "form-control font-monospace", placeholder: "0 9 * * 1-5" %>
            <div class="form-text">
              <a href="https://crontab.guru/" target="_blank">Cron expression help</a>
            </div>
          </div>

          <div class="mb-3">
            <%= f.label :timezone, class: "form-label" %>
            <%= f.select :timezone,
              ActiveSupport::TimeZone.all.map { |tz| [tz.to_s, tz.name] },
              { selected: @scheduled_task.timezone || 'UTC' },
              { class: "form-select" } %>
          </div>
        </div>
      </div>

      <!-- Options -->
      <div class="card mb-4">
        <div class="card-header">
          <h5 class="mb-0">Options</h5>
        </div>
        <div class="card-body">
          <div class="form-check mb-3">
            <%= f.check_box :enabled, class: "form-check-input" %>
            <%= f.label :enabled, "Enabled", class: "form-check-label" %>
          </div>

          <div class="mb-3">
            <%= f.label :max_runs, "Max Runs (optional)", class: "form-label" %>
            <%= f.number_field :max_runs, class: "form-control", min: 1, placeholder: "Unlimited" %>
            <div class="form-text">Stop after this many runs</div>
          </div>

          <div class="mb-3">
            <%= f.label :expires_at, "Expires At (optional)", class: "form-label" %>
            <%= f.datetime_local_field :expires_at, class: "form-control" %>
          </div>
        </div>
      </div>

      <!-- Actions -->
      <div class="d-grid gap-2">
        <%= f.submit @scheduled_task.new_record? ? "Create Task" : "Update Task", class: "btn btn-primary btn-lg" %>
        <%= link_to "Cancel", admin_scheduled_tasks_path, class: "btn btn-outline-secondary" %>
      </div>
    </div>
  </div>
<% end %>

<script>
document.addEventListener('DOMContentLoaded', function() {
  const scheduleType = document.getElementById('scheduleType');
  const timeFields = document.getElementById('timeFields');
  const dayOfWeekField = document.getElementById('dayOfWeekField');
  const dayOfMonthField = document.getElementById('dayOfMonthField');
  const cronField = document.getElementById('cronField');

  function updateScheduleFields() {
    const type = scheduleType.value;
    
    timeFields.style.display = ['daily', 'weekly', 'monthly'].includes(type) ? 'block' : 'none';
    dayOfWeekField.style.display = type === 'weekly' ? 'block' : 'none';
    dayOfMonthField.style.display = type === 'monthly' ? 'block' : 'none';
    cronField.style.display = type === 'cron' ? 'block' : 'none';
  }

  scheduleType.addEventListener('change', updateScheduleFields);
  updateScheduleFields();
});
</script>

