<div class="container-fluid py-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <div>
      <h1 class="h3 mb-1">
        <i data-lucide="clock" class="me-2"></i>
        Scheduled Tasks
      </h1>
      <p class="text-muted mb-0">Manage recurring agent tasks and automations</p>
    </div>
    <div class="d-flex gap-2">
      <%= link_to runs_admin_scheduled_tasks_path, class: "btn btn-outline-secondary" do %>
        <i data-lucide="list" class="me-1"></i> Run History
      <% end %>
      <%= link_to new_admin_scheduled_task_path, class: "btn btn-primary" do %>
        <i data-lucide="plus" class="me-1"></i> New Task
      <% end %>
    </div>
  </div>

  <!-- Stats Cards -->
  <div class="row g-3 mb-4">
    <div class="col-md-2">
      <div class="card bg-primary text-white">
        <div class="card-body text-center">
          <h3 class="mb-0"><%= @stats[:total] %></h3>
          <small>Total Tasks</small>
        </div>
      </div>
    </div>
    <div class="col-md-2">
      <div class="card bg-success text-white">
        <div class="card-body text-center">
          <h3 class="mb-0"><%= @stats[:active] %></h3>
          <small>Active</small>
        </div>
      </div>
    </div>
    <div class="col-md-2">
      <div class="card bg-warning text-dark">
        <div class="card-body text-center">
          <h3 class="mb-0"><%= @stats[:paused] %></h3>
          <small>Paused</small>
        </div>
      </div>
    </div>
    <div class="col-md-2">
      <div class="card bg-info text-white">
        <div class="card-body text-center">
          <h3 class="mb-0"><%= @stats[:due_now] %></h3>
          <small>Due Now</small>
        </div>
      </div>
    </div>
    <div class="col-md-2">
      <div class="card bg-secondary text-white">
        <div class="card-body text-center">
          <h3 class="mb-0"><%= @stats[:runs_today] %></h3>
          <small>Runs Today</small>
        </div>
      </div>
    </div>
    <div class="col-md-2">
      <div class="card bg-dark text-white">
        <div class="card-body text-center">
          <h3 class="mb-0"><%= @stats[:success_rate] %>%</h3>
          <small>Success Rate</small>
        </div>
      </div>
    </div>
  </div>

  <!-- Filters -->
  <div class="card mb-4">
    <div class="card-body">
      <%= form_tag admin_scheduled_tasks_path, method: :get, class: "row g-3" do %>
        <div class="col-md-3">
          <%= select_tag :status, 
            options_for_select([
              ['All Statuses', ''],
              ['Active', 'active'],
              ['Paused', 'paused'],
              ['Completed', 'completed'],
              ['Failed', 'failed'],
              ['Archived', 'archived']
            ], params[:status]),
            class: "form-select" %>
        </div>
        <div class="col-md-3">
          <%= select_tag :task_type,
            options_for_select([
              ['All Types', ''],
              ['Email Summary', 'email_summary'],
              ['Report Generation', 'report_generation'],
              ['Data Sync', 'data_sync'],
              ['Email Management', 'email_management'],
              ['Research Update', 'research_update'],
              ['Custom', 'custom']
            ], params[:task_type]),
            class: "form-select" %>
        </div>
        <div class="col-md-2">
          <%= submit_tag "Filter", class: "btn btn-outline-primary" %>
          <%= link_to "Clear", admin_scheduled_tasks_path, class: "btn btn-outline-secondary" %>
        </div>
      <% end %>
    </div>
  </div>

  <!-- Tasks Table -->
  <div class="card">
    <div class="table-responsive">
      <table class="table table-hover mb-0">
        <thead class="table-light">
          <tr>
            <th>Task</th>
            <th>Type</th>
            <th>Schedule</th>
            <th>Next Run</th>
            <th>Last Run</th>
            <th>Runs</th>
            <th>Status</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <% @scheduled_tasks.each do |task| %>
            <tr>
              <td>
                <div class="d-flex align-items-center">
                  <span class="me-2"><%= task.task_type_info[:icon] %></span>
                  <div>
                    <%= link_to task.name, admin_scheduled_task_path(task), class: "text-decoration-none fw-medium" %>
                    <div class="small text-muted">
                      <%= task.entity.name %> &middot; <%= task.user.email %>
                    </div>
                  </div>
                </div>
              </td>
              <td>
                <span class="badge bg-secondary"><%= task.task_type.humanize %></span>
              </td>
              <td>
                <% case task.schedule_type %>
                <% when 'once' %>
                  <span class="text-muted">One-time</span>
                <% when 'daily' %>
                  Daily at <%= task.run_at_time&.strftime('%I:%M %p') %>
                <% when 'weekly' %>
                  Weekly on <%= Date::DAYNAMES[task.run_on_day || 0] %>
                <% when 'monthly' %>
                  Monthly on day <%= task.run_on_day %>
                <% when 'cron' %>
                  <code class="small"><%= task.cron_expression %></code>
                <% end %>
              </td>
              <td>
                <% if task.next_run_at %>
                  <% if task.next_run_at <= Time.current %>
                    <span class="badge bg-warning text-dark">Due now</span>
                  <% else %>
                    <%= task.next_run_at.strftime('%b %d, %I:%M %p') %>
                  <% end %>
                <% else %>
                  <span class="text-muted">—</span>
                <% end %>
              </td>
              <td>
                <% if task.last_run_at %>
                  <%= time_ago_in_words(task.last_run_at) %> ago
                <% else %>
                  <span class="text-muted">Never</span>
                <% end %>
              </td>
              <td>
                <span class="badge bg-light text-dark">
                  <%= task.run_count %>
                  <% if task.failure_count > 0 %>
                    <span class="text-danger">(<%= task.failure_count %> failed)</span>
                  <% end %>
                </span>
              </td>
              <td>
                <% case task.status %>
                <% when 'active' %>
                  <span class="badge bg-success">Active</span>
                <% when 'paused' %>
                  <span class="badge bg-warning text-dark">Paused</span>
                <% when 'completed' %>
                  <span class="badge bg-info">Completed</span>
                <% when 'failed' %>
                  <span class="badge bg-danger">Failed</span>
                <% when 'archived' %>
                  <span class="badge bg-secondary">Archived</span>
                <% end %>
                <% unless task.enabled? %>
                  <span class="badge bg-light text-muted">Disabled</span>
                <% end %>
              </td>
              <td>
                <div class="btn-group btn-group-sm">
                  <%= link_to admin_scheduled_task_path(task), class: "btn btn-outline-primary" do %>
                    <i data-lucide="eye" style="width: 14px; height: 14px;"></i>
                  <% end %>
                  <% if task.status == 'active' %>
                    <%= button_to pause_admin_scheduled_task_path(task), method: :post, class: "btn btn-outline-warning", title: "Pause" do %>
                      <i data-lucide="pause" style="width: 14px; height: 14px;"></i>
                    <% end %>
                  <% elsif task.status == 'paused' %>
                    <%= button_to resume_admin_scheduled_task_path(task), method: :post, class: "btn btn-outline-success", title: "Resume" do %>
                      <i data-lucide="play" style="width: 14px; height: 14px;"></i>
                    <% end %>
                  <% end %>
                  <% if task.can_run? %>
                    <%= button_to run_now_admin_scheduled_task_path(task), method: :post, class: "btn btn-outline-info", title: "Run Now" do %>
                      <i data-lucide="zap" style="width: 14px; height: 14px;"></i>
                    <% end %>
                  <% end %>
                </div>
              </td>
            </tr>
          <% end %>
          <% if @scheduled_tasks.empty? %>
            <tr>
              <td colspan="8" class="text-center py-5 text-muted">
                <i data-lucide="calendar-off" class="mb-2" style="width: 48px; height: 48px;"></i>
                <p class="mb-0">No scheduled tasks found</p>
                <%= link_to "Create your first task", new_admin_scheduled_task_path, class: "btn btn-primary mt-2" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
    <% if @scheduled_tasks.respond_to?(:total_pages) && @scheduled_tasks.total_pages > 1 %>
      <div class="card-footer">
        <%= paginate @scheduled_tasks %>
      </div>
    <% end %>
  </div>
</div>

