<div class="container-fluid py-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <div>
      <nav aria-label="breadcrumb">
        <ol class="breadcrumb mb-1">
          <li class="breadcrumb-item"><%= link_to "Scheduled Tasks", admin_scheduled_tasks_path %></li>
          <li class="breadcrumb-item active"><%= @scheduled_task.name %></li>
        </ol>
      </nav>
      <h1 class="h3 mb-0">
        <span class="me-2"><%= @scheduled_task.task_type_info[:icon] %></span>
        <%= @scheduled_task.name %>
      </h1>
    </div>
    <div class="d-flex gap-2">
      <% if @scheduled_task.status == 'active' %>
        <%= button_to pause_admin_scheduled_task_path(@scheduled_task), method: :post, class: "btn btn-warning" do %>
          <i data-lucide="pause" class="me-1"></i> Pause
        <% end %>
      <% elsif @scheduled_task.status == 'paused' %>
        <%= button_to resume_admin_scheduled_task_path(@scheduled_task), method: :post, class: "btn btn-success" do %>
          <i data-lucide="play" class="me-1"></i> Resume
        <% end %>
      <% end %>
      <% if @scheduled_task.can_run? %>
        <%= button_to run_now_admin_scheduled_task_path(@scheduled_task), method: :post, class: "btn btn-info" do %>
          <i data-lucide="zap" class="me-1"></i> Run Now
        <% end %>
      <% end %>
      <%= link_to edit_admin_scheduled_task_path(@scheduled_task), class: "btn btn-outline-primary" do %>
        <i data-lucide="edit" class="me-1"></i> Edit
      <% end %>
      <%= button_to admin_scheduled_task_path(@scheduled_task), method: :delete, 
        class: "btn btn-outline-danger",
        data: { confirm: "Are you sure you want to delete this task?" } do %>
        <i data-lucide="trash-2" class="me-1"></i> Delete
      <% end %>
    </div>
  </div>

  <div class="row">
    <!-- Task Details -->
    <div class="col-lg-4">
      <div class="card mb-4">
        <div class="card-header">
          <h5 class="mb-0">Task Details</h5>
        </div>
        <div class="card-body">
          <dl class="row mb-0">
            <dt class="col-sm-4">Status</dt>
            <dd class="col-sm-8">
              <% case @scheduled_task.status %>
              <% when 'active' %>
                <span class="badge bg-success">Active</span>
              <% when 'paused' %>
                <span class="badge bg-warning text-dark">Paused</span>
              <% when 'completed' %>
                <span class="badge bg-info">Completed</span>
              <% when 'failed' %>
                <span class="badge bg-danger">Failed</span>
              <% when 'archived' %>
                <span class="badge bg-secondary">Archived</span>
              <% end %>
              <% unless @scheduled_task.enabled? %>
                <span class="badge bg-light text-muted ms-1">Disabled</span>
              <% end %>
            </dd>

            <dt class="col-sm-4">Type</dt>
            <dd class="col-sm-8"><%= @scheduled_task.task_type.humanize %></dd>

            <dt class="col-sm-4">Entity</dt>
            <dd class="col-sm-8"><%= @scheduled_task.entity.name %></dd>

            <dt class="col-sm-4">User</dt>
            <dd class="col-sm-8"><%= @scheduled_task.user.email %></dd>

            <% if @scheduled_task.agent_plugin %>
              <dt class="col-sm-4">Agent</dt>
              <dd class="col-sm-8"><%= @scheduled_task.agent_plugin.name %></dd>
            <% end %>

            <dt class="col-sm-4">Schedule</dt>
            <dd class="col-sm-8">
              <% case @scheduled_task.schedule_type %>
              <% when 'once' %>
                One-time
              <% when 'daily' %>
                Daily at <%= @scheduled_task.run_at_time&.strftime('%I:%M %p') %>
              <% when 'weekly' %>
                Weekly on <%= Date::DAYNAMES[@scheduled_task.run_on_day || 0] %> at <%= @scheduled_task.run_at_time&.strftime('%I:%M %p') %>
              <% when 'monthly' %>
                Monthly on day <%= @scheduled_task.run_on_day %> at <%= @scheduled_task.run_at_time&.strftime('%I:%M %p') %>
              <% when 'cron' %>
                <code><%= @scheduled_task.cron_expression %></code>
              <% end %>
              <div class="small text-muted">Timezone: <%= @scheduled_task.timezone %></div>
            </dd>

            <dt class="col-sm-4">Next Run</dt>
            <dd class="col-sm-8">
              <% if @scheduled_task.next_run_at %>
                <%= @scheduled_task.next_run_at.strftime('%b %d, %Y at %I:%M %p') %>
                <% if @scheduled_task.next_run_at <= Time.current %>
                  <span class="badge bg-warning text-dark ms-1">Due</span>
                <% end %>
              <% else %>
                <span class="text-muted">Not scheduled</span>
              <% end %>
            </dd>

            <dt class="col-sm-4">Last Run</dt>
            <dd class="col-sm-8">
              <% if @scheduled_task.last_run_at %>
                <%= @scheduled_task.last_run_at.strftime('%b %d, %Y at %I:%M %p') %>
              <% else %>
                <span class="text-muted">Never</span>
              <% end %>
            </dd>

            <dt class="col-sm-4">Created</dt>
            <dd class="col-sm-8"><%= @scheduled_task.created_at.strftime('%b %d, %Y') %></dd>
          </dl>
        </div>
      </div>

      <!-- Run Stats -->
      <div class="card mb-4">
        <div class="card-header">
          <h5 class="mb-0">Run Statistics</h5>
        </div>
        <div class="card-body">
          <div class="row text-center">
            <div class="col-6 mb-3">
              <h3 class="mb-0"><%= @run_stats[:total_runs] %></h3>
              <small class="text-muted">Total Runs</small>
            </div>
            <div class="col-6 mb-3">
              <h3 class="mb-0 text-danger"><%= @run_stats[:failures] %></h3>
              <small class="text-muted">Failures</small>
            </div>
            <div class="col-6">
              <h3 class="mb-0 text-success"><%= @run_stats[:success_rate] %>%</h3>
              <small class="text-muted">Success Rate</small>
            </div>
            <div class="col-6">
              <h3 class="mb-0"><%= number_with_delimiter(@run_stats[:avg_duration]) %>ms</h3>
              <small class="text-muted">Avg Duration</small>
            </div>
          </div>
          <% if @scheduled_task.consecutive_failures > 0 %>
            <div class="alert alert-warning mt-3 mb-0">
              <i data-lucide="alert-triangle" class="me-1"></i>
              <%= @scheduled_task.consecutive_failures %> consecutive failures
              <% if @scheduled_task.consecutive_failures >= 3 %>
                <br><small>Task auto-paused after 3 failures</small>
              <% end %>
            </div>
          <% end %>
        </div>
      </div>

      <!-- Prompt -->
      <div class="card">
        <div class="card-header">
          <h5 class="mb-0">Task Prompt</h5>
        </div>
        <div class="card-body">
          <pre class="bg-light p-3 rounded mb-0" style="white-space: pre-wrap;"><%= @scheduled_task.prompt %></pre>
        </div>
      </div>
    </div>

    <!-- Recent Runs -->
    <div class="col-lg-8">
      <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center">
          <h5 class="mb-0">Recent Runs</h5>
          <%= link_to "View All", runs_admin_scheduled_tasks_path(task_id: @scheduled_task.id), class: "btn btn-sm btn-outline-secondary" %>
        </div>
        <div class="table-responsive">
          <table class="table table-hover mb-0">
            <thead class="table-light">
              <tr>
                <th>Started</th>
                <th>Duration</th>
                <th>Status</th>
                <th>Summary</th>
                <th></th>
              </tr>
            </thead>
            <tbody>
              <% @recent_runs.each do |run| %>
                <tr>
                  <td>
                    <% if run.started_at %>
                      <%= run.started_at.strftime('%b %d, %I:%M %p') %>
                    <% else %>
                      <span class="text-muted">Pending</span>
                    <% end %>
                  </td>
                  <td>
                    <% if run.duration_ms %>
                      <%= number_with_delimiter(run.duration_ms) %>ms
                    <% else %>
                      <span class="text-muted">—</span>
                    <% end %>
                  </td>
                  <td>
                    <% case run.status %>
                    <% when 'pending' %>
                      <span class="badge bg-secondary">Pending</span>
                    <% when 'running' %>
                      <span class="badge bg-primary">
                        <span class="spinner-border spinner-border-sm me-1"></span>
                        Running
                      </span>
                    <% when 'completed' %>
                      <span class="badge bg-success">Completed</span>
                    <% when 'failed' %>
                      <span class="badge bg-danger">Failed</span>
                    <% when 'cancelled' %>
                      <span class="badge bg-warning text-dark">Cancelled</span>
                    <% end %>
                  </td>
                  <td>
                    <% if run.result_summary.present? %>
                      <span class="text-truncate d-inline-block" style="max-width: 300px;">
                        <%= truncate(run.result_summary, length: 100) %>
                      </span>
                    <% elsif run.error_message.present? %>
                      <span class="text-danger">
                        <%= truncate(run.error_message, length: 100) %>
                      </span>
                    <% else %>
                      <span class="text-muted">—</span>
                    <% end %>
                  </td>
                  <td>
                    <button type="button" class="btn btn-sm btn-outline-secondary" 
                      data-bs-toggle="modal" data-bs-target="#runModal<%= run.id %>">
                      <i data-lucide="eye" style="width: 14px; height: 14px;"></i>
                    </button>
                  </td>
                </tr>
              <% end %>
              <% if @recent_runs.empty? %>
                <tr>
                  <td colspan="5" class="text-center py-4 text-muted">
                    No runs yet
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Run Detail Modals -->
<% @recent_runs.each do |run| %>
  <div class="modal fade" id="runModal<%= run.id %>" tabindex="-1">
    <div class="modal-dialog modal-lg">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title">Run Details</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body">
          <dl class="row">
            <dt class="col-sm-3">Started</dt>
            <dd class="col-sm-9"><%= run.started_at&.strftime('%b %d, %Y at %I:%M:%S %p') || 'Pending' %></dd>
            
            <dt class="col-sm-3">Completed</dt>
            <dd class="col-sm-9"><%= run.completed_at&.strftime('%b %d, %Y at %I:%M:%S %p') || '—' %></dd>
            
            <dt class="col-sm-3">Duration</dt>
            <dd class="col-sm-9"><%= run.duration_ms ? "#{number_with_delimiter(run.duration_ms)}ms" : '—' %></dd>
            
            <dt class="col-sm-3">Status</dt>
            <dd class="col-sm-9">
              <% case run.status %>
              <% when 'completed' %>
                <span class="badge bg-success">Completed</span>
              <% when 'failed' %>
                <span class="badge bg-danger">Failed</span>
              <% else %>
                <span class="badge bg-secondary"><%= run.status.humanize %></span>
              <% end %>
            </dd>
          </dl>
          
          <% if run.result_summary.present? %>
            <h6>Summary</h6>
            <div class="bg-light p-3 rounded mb-3">
              <%= run.result_summary %>
            </div>
          <% end %>
          
          <% if run.error_message.present? %>
            <h6 class="text-danger">Error</h6>
            <div class="bg-danger bg-opacity-10 p-3 rounded mb-3 text-danger">
              <%= run.error_message %>
            </div>
          <% end %>
          
          <% if run.result_data.present? && run.result_data['content'].present? %>
            <h6>Full Result</h6>
            <div class="bg-light p-3 rounded" style="max-height: 300px; overflow-y: auto;">
              <pre class="mb-0" style="white-space: pre-wrap;"><%= run.result_data['content'] %></pre>
            </div>
          <% end %>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
        </div>
      </div>
    </div>
  </div>
<% end %>

