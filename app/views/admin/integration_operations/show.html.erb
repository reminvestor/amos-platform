<div class="admin-p-xl">
  <!-- Page Header -->
  <div class="admin-page-header admin-mb-xl">
    <div class="header-left">
      <div class="header-icon admin-icon-gradient-purple">
        <i data-lucide="settings" class="admin-text-primary"></i>
      </div>
      <div class="header-text">
        <h1><%= @operation.name %></h1>
        <p><%= @operation.description %></p>
      </div>
    </div>

    <div class="header-actions">
      <%= link_to admin_integration_path(@integration), class: "admin-btn admin-btn-outline" do %>
        <i data-lucide="arrow-left"></i>
        <span>Back to <%= @integration.name %></span>
      <% end %>
    </div>
  </div>

  <div class="admin-content-grid">
    <div style="grid-column: span 2;">
      <!-- Operation Details -->
      <div class="admin-card admin-mb-xl">
        <h3 class="card-title m-0 admin-mb-lg">
          <i data-lucide="info" class="admin-icon-md d-inline-block align-middle me-2"></i>
          Operation Details
        </h3>
        <div class="admin-detail-list">
          <div class="detail-item">
            <span class="admin-text-secondary">Operation ID</span>
            <code class="admin-text-cyan"><%= @operation.operation_id %></code>
          </div>
          <div class="detail-item">
            <span class="admin-text-secondary">HTTP Method</span>
            <span class="admin-badge admin-badge-info"><%= @operation.http_method&.upcase %></span>
          </div>
          <div class="detail-item">
            <span class="admin-text-secondary">Endpoint</span>
            <code class="admin-text-cyan"><%= @operation.path_template %></code>
          </div>
          <div class="detail-item">
            <span class="admin-text-secondary">Idempotent</span>
            <span>
              <% if @operation.is_idempotent %>
                <i data-lucide="check" class="admin-text-success admin-icon-sm"></i> Yes
              <% else %>
                <i data-lucide="x" class="admin-text-muted admin-icon-sm"></i> No
              <% end %>
            </span>
          </div>
          <% if @operation.requires_confirmation %>
            <div class="detail-item">
              <span class="admin-text-secondary">Requires Confirmation</span>
              <span><i data-lucide="alert-triangle" class="admin-text-warning admin-icon-sm"></i> Yes</span>
            </div>
          <% end %>
          <% if @operation.max_limit %>
            <div class="detail-item">
              <span class="admin-text-secondary">Max Limit</span>
              <span class="admin-text-primary"><%= @operation.max_limit %> items</span>
            </div>
          <% end %>
        </div>
      </div>

      <!-- Request Schema -->
      <% if @operation.request_schema.present? %>
        <div class="admin-card admin-mb-xl">
          <h3 class="card-title m-0 admin-mb-lg">
            <i data-lucide="arrow-right-circle" class="admin-icon-md d-inline-block align-middle me-2"></i>
            Request Schema
          </h3>
          <pre class="admin-p-md admin-rounded-md" style="background: var(--bg-tertiary); overflow: auto;"><code class="admin-text-cyan"><%= JSON.pretty_generate(@operation.request_schema) %></code></pre>
        </div>
      <% end %>

      <!-- Response Schema -->
      <% if @operation.response_schema.present? %>
        <div class="admin-card">
          <h3 class="card-title m-0 admin-mb-lg">
            <i data-lucide="arrow-left-circle" class="admin-icon-md d-inline-block align-middle me-2"></i>
            Response Schema
          </h3>
          <pre class="admin-p-md admin-rounded-md" style="background: var(--bg-tertiary); overflow: auto;"><code class="admin-text-cyan"><%= JSON.pretty_generate(@operation.response_schema) %></code></pre>
        </div>
      <% end %>
    </div>

    <!-- Sidebar -->
    <div>
      <div class="admin-card">
        <h3 class="card-title m-0 admin-mb-lg">
          <i data-lucide="zap" class="admin-icon-md d-inline-block align-middle me-2"></i>
          Actions
        </h3>
        <div class="admin-flex admin-flex-col admin-flex-gap-sm">
          <%= link_to edit_admin_integration_operation_path(@integration, @operation), class: "admin-btn admin-btn-primary admin-w-full" do %>
            <i data-lucide="edit"></i> Edit Operation
          <% end %>

          <%= link_to admin_integration_operation_path(@integration, @operation), method: :delete,
              class: "admin-btn admin-btn-danger-outline admin-w-full",
              data: { turbo_method: :delete, turbo_confirm: "Delete this operation?" } do %>
            <i data-lucide="trash"></i> Delete
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  document.addEventListener('turbo:load', () => {
    if (typeof lucide !== 'undefined') {
      lucide.createIcons();
    }
  });
</script>
