<div class="admin-content">
  <div style="padding: 2rem;">
    <div class="container-fluid">
  <div class="row mb-4">
    <div class="col">
      <h1><i data-lucide="settings"></i> <%= @operation.name %></h1>
      <p class="text-muted"><%= @operation.description %></p>
    </div>
    <div class="col-auto">
      <%= link_to "Back to #{@integration.name}", admin_integration_path(@integration), class: "btn btn-outline-secondary" %>
    </div>
  </div>

  <div class="row">
    <div class="col-lg-8">
      <!-- Operation Details -->
      <div class="card border-0 shadow-sm mb-3">
        <div class="card-header bg-white">
          <h5 class="mb-0">Operation Details</h5>
        </div>
        <div class="card-body">
          <dl class="row mb-0">
            <dt class="col-sm-3">Operation ID</dt>
            <dd class="col-sm-9"><code><%= @operation.operation_id %></code></dd>
            
            <dt class="col-sm-3">HTTP Method</dt>
            <dd class="col-sm-9">
              <span class="badge bg-primary"><%= @operation.http_method&.upcase %></span>
            </dd>
            
            <dt class="col-sm-3">Endpoint</dt>
            <dd class="col-sm-9"><code><%= @operation.path_template %></code></dd>
            
            <dt class="col-sm-3">Idempotent</dt>
            <dd class="col-sm-9">
              <% if @operation.is_idempotent %>
                <i data-lucide="check" class="text-success"></i> Yes
              <% else %>
                <i data-lucide="x" class="text-muted"></i> No
              <% end %>
            </dd>
            
            <% if @operation.requires_confirmation %>
              <dt class="col-sm-3">Requires Confirmation</dt>
              <dd class="col-sm-9">
                <i data-lucide="alert-triangle" class="text-warning"></i> Yes
              </dd>
            <% end %>
            
            <% if @operation.max_limit %>
              <dt class="col-sm-3">Max Limit</dt>
              <dd class="col-sm-9"><%= @operation.max_limit %> items</dd>
            <% end %>
          </dl>
        </div>
      </div>

      <!-- Request Schema -->
      <% if @operation.request_schema.present? %>
        <div class="card border-0 shadow-sm mb-3">
          <div class="card-header bg-white">
            <h5 class="mb-0">Request Schema</h5>
          </div>
          <div class="card-body">
            <pre class="bg-light p-3 rounded"><code><%= JSON.pretty_generate(@operation.request_schema) %></code></pre>
          </div>
        </div>
      <% end %>

      <!-- Response Schema -->
      <% if @operation.response_schema.present? %>
        <div class="card border-0 shadow-sm">
          <div class="card-header bg-white">
            <h5 class="mb-0">Response Schema</h5>
          </div>
          <div class="card-body">
            <pre class="bg-light p-3 rounded"><code><%= JSON.pretty_generate(@operation.response_schema) %></code></pre>
          </div>
        </div>
      <% end %>
    </div>

    <!-- Sidebar -->
    <div class="col-lg-4">
      <div class="card border-0 shadow-sm">
        <div class="card-header bg-white">
          <h5 class="mb-0"><i data-lucide="zap"></i> Actions</h5>
        </div>
        <div class="card-body d-grid gap-2">
          <%= link_to edit_admin_integration_operation_path(@integration, @operation), class: "btn btn-primary" do %>
            <i data-lucide="edit" class="me-2"></i> Edit Operation
          <% end %>
          
          <%= link_to admin_integration_operation_path(@integration, @operation), method: :delete,
              class: "btn btn-outline-danger",
              data: { turbo_method: :delete, turbo_confirm: "Delete this operation?" } do %>
            <i class="fas fa-trash me-2"></i> Delete
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
  </div>
</div>

