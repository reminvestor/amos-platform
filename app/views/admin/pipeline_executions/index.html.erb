<div class="admin-content">
  <div class="admin-p-xl">
    <%# Page Header %>
    <div class="admin-page-header">
      <div class="header-left">
        <div class="header-icon">
          <%= admin_icon('activity', size: :lg) %>
        </div>
        <div class="header-text">
          <h1>Pipeline Executions</h1>
          <p>Monitor and manage AI development pipeline runs</p>
        </div>
      </div>
    </div>

    <%# Stats Cards %>
    <div class="admin-stats-grid admin-mb-xl">
      <%= render 'admin/shared/stat_card',
          icon: 'activity',
          label: 'Total Executions',
          value: @stats[:total],
          variant: 'purple-gradient' %>

      <%= render 'admin/shared/stat_card',
          icon: 'play-circle',
          label: 'Active',
          value: @stats[:active],
          variant: 'info' %>

      <%= render 'admin/shared/stat_card',
          icon: 'check-circle',
          label: 'Completed',
          value: @stats[:completed],
          variant: 'success' %>

      <%= render 'admin/shared/stat_card',
          icon: 'dollar-sign',
          label: 'Total Cost',
          value: "$#{number_with_precision(@stats[:total_cost], precision: 2)}",
          variant: 'warning' %>
    </div>

    <%# Filters Card %>
    <div class="admin-card admin-mb-xl">
      <%= form_with url: admin_pipeline_executions_path, method: :get, class: 'admin-filter-grid' do %>
        <div>
          <label class="form-label admin-text-sm">Status</label>
          <%= select_tag :status, options_for_select(
            [['All Statuses', '']] + PipelineExecution.statuses.keys.map { |k| [k.titleize, k] },
            params[:status]
          ), class: 'admin-select admin-w-full' %>
        </div>

        <div>
          <label class="form-label admin-text-sm">Priority</label>
          <%= select_tag :priority, options_for_select(
            [['All Priorities', '']] + PipelineExecution.priorities.keys.map { |k| [k.titleize, k] },
            params[:priority]
          ), class: 'admin-select admin-w-full' %>
        </div>

        <div>
          <label class="form-label admin-text-sm">System</label>
          <%= select_tag :ticket_system, options_for_select(
            [['All Systems', ''], ['JIRA', 'jira'], ['Azure DevOps', 'azure_devops']],
            params[:ticket_system]
          ), class: 'admin-select admin-w-full' %>
        </div>

        <div>
          <%= submit_tag 'Filter', class: 'admin-btn admin-btn-primary admin-w-full' %>
        </div>
      <% end %>
    </div>

    <%# Executions Table %>
    <% if @pipeline_executions.any? %>
      <div class="admin-card">
        <div class="admin-overflow-x-auto">
          <table class="admin-table">
            <thead>
              <tr>
                <th>Ticket</th>
                <th>Title</th>
                <th>Status</th>
                <th>Priority</th>
                <th>System</th>
                <th>Started</th>
                <th>Duration</th>
                <th>Cost</th>
                <th class="admin-text-right">Actions</th>
              </tr>
            </thead>
            <tbody>
              <% @pipeline_executions.each do |execution| %>
                <tr>
                  <td>
                    <%= link_to execution.ticket_id, admin_pipeline_execution_path(execution), class: 'admin-link admin-font-semibold' %>
                  </td>
                  <td>
                    <div class="admin-text-ellipsis admin-max-w-300" title="<%= execution.ticket_title %>">
                      <%= execution.ticket_title %>
                    </div>
                  </td>
                  <td>
                    <span class="admin-badge admin-badge-<%= AiAgents::Pipeline::StateMachine.state_color(execution.status) == 'success' ? 'online' : AiAgents::Pipeline::StateMachine.state_color(execution.status) == 'danger' ? 'offline' : 'warning' %>">
                      <%= execution.status.upcase.gsub('_', ' ') %>
                    </span>
                  </td>
                  <td>
                    <span class="admin-badge admin-badge-<%= execution.priority_critical? ? 'offline' : execution.priority_high? ? 'warning' : 'default' %>">
                      <%= execution.priority.upcase %>
                    </span>
                  </td>
                  <td class="admin-text-muted admin-text-sm">
                    <%= execution.ticket_system.upcase %>
                  </td>
                  <td class="admin-text-muted admin-text-sm">
                    <% if execution.started_at %>
                      <%= time_ago_in_words(execution.started_at) %> ago
                    <% else %>
                      Not started
                    <% end %>
                  </td>
                  <td class="admin-text-muted admin-text-sm">
                    <%= execution.duration_human %>
                  </td>
                  <td class="admin-text-muted admin-text-sm">
                    <%= execution.cost_dollars %>
                  </td>
                  <td class="admin-text-right">
                    <div class="admin-inline-flex admin-flex-gap-sm">
                      <%= link_to admin_pipeline_execution_path(execution), class: 'admin-btn admin-btn-sm admin-btn-outline', aria: { label: 'View execution' } do %>
                        <%= admin_icon('eye', size: :sm) %>
                      <% end %>
                      <% if execution.status_failed? || execution.status_rolled_back? %>
                        <%= button_to retry_admin_pipeline_execution_path(execution), method: :post, class: 'admin-btn admin-btn-sm admin-btn-outline', aria: { label: 'Retry execution' } do %>
                          <%= admin_icon('refresh-cw', size: :sm) %>
                        <% end %>
                      <% end %>
                    </div>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>

      <% if @pipeline_executions.respond_to?(:total_pages) && @pipeline_executions.total_pages > 1 %>
        <div class="admin-mt-lg">
          <%= paginate @pipeline_executions %>
        </div>
      <% end %>
    <% else %>
      <%# Empty State %>
      <div class="admin-empty-state">
        <div class="empty-icon">
          <%= admin_icon('activity', size: :xl) %>
        </div>
        <p class="empty-title">No pipeline executions found</p>
        <p class="empty-description">
          Executions will appear here once pipelines start processing tickets
        </p>
      </div>
    <% end %>
  </div>
</div>

<script>
  document.addEventListener('turbo:load', () => {
    lucide.createIcons();
  });

  document.addEventListener('DOMContentLoaded', () => {
    lucide.createIcons();
  });
</script>
