<%# app/views/admin/entity_costs/bulk_analysis.html.erb %>
<div class="admin-p-xl">
  <!-- Page Header -->
  <div class="admin-page-header admin-mb-xl">
    <div class="header-left">
      <div class="header-icon admin-icon-gradient-purple">
        <i data-lucide="bar-chart-3" class="admin-text-primary"></i>
      </div>
      <div class="header-text">
        <h1>Bulk Cost Analysis</h1>
        <p>Cross-entity insights and optimization opportunities</p>
      </div>
    </div>

    <div class="header-actions">
      <%= link_to admin_entity_costs_path, class: "admin-btn admin-btn-outline" do %>
        <i data-lucide="arrow-left"></i>
        <span>Back to Costs</span>
      <% end %>
    </div>
  </div>

  <!-- Insights Dashboard -->
  <div class="admin-content-grid admin-mb-xl">
    <!-- Highest Cost Entities -->
    <div class="admin-card">
      <div class="admin-flex admin-items-center admin-flex-gap-sm admin-mb-lg" style="border-bottom: 2px solid var(--status-error-text); padding-bottom: 0.75rem;">
        <i data-lucide="flame" class="admin-icon-md" style="color: var(--status-error-text);"></i>
        <h3 class="card-title m-0">Highest Cost Entities</h3>
      </div>
      <div class="admin-table-container">
        <table class="admin-table">
          <thead>
            <tr>
              <th>Entity</th>
              <th>Tier</th>
              <th class="admin-text-right">Total Cost</th>
              <th>Action</th>
            </tr>
          </thead>
          <tbody>
            <% @insights[:highest_cost_entities].each do |entity| %>
              <tr>
                <td>
                  <strong class="admin-text-primary"><%= entity.name %></strong>
                  <br>
                  <small class="admin-text-muted">ID: <%= entity.id %></small>
                </td>
                <td>
                  <span class="admin-badge <%= entity.billing_tier == 'premium' ? 'admin-badge-info' : 'admin-badge-secondary' %>">
                    <%= entity.billing_tier %>
                  </span>
                </td>
                <td class="admin-text-right">
                  $<%= number_with_precision(entity.entity_cost_summaries.sum(:total_cost), precision: 2) %>
                </td>
                <td>
                  <%= link_to admin_entity_cost_path(entity), class: "admin-btn admin-btn-sm admin-btn-outline" do %>
                    <i data-lucide="trending-up" class="admin-icon-sm"></i>
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>

    <!-- Fastest Growing Costs -->
    <div class="admin-card">
      <div class="admin-flex admin-items-center admin-flex-gap-sm admin-mb-lg" style="border-bottom: 2px solid var(--status-warning-text); padding-bottom: 0.75rem;">
        <i data-lucide="rocket" class="admin-icon-md" style="color: var(--status-warning-text);"></i>
        <h3 class="card-title m-0">Fastest Growing Costs</h3>
      </div>
      <div class="admin-table-container">
        <table class="admin-table">
          <thead>
            <tr>
              <th>Entity</th>
              <th class="admin-text-right">Last Month</th>
              <th class="admin-text-right">This Month</th>
              <th class="admin-text-right">Growth</th>
            </tr>
          </thead>
          <tbody>
            <% @insights[:fastest_growing_costs].limit(10).each do |entity| %>
              <% growth = entity.current_month_cost && entity.last_month_cost > 0 ?
                          ((entity.current_month_cost - entity.last_month_cost) / entity.last_month_cost * 100) : 0 %>
              <tr>
                <td>
                  <strong class="admin-text-primary"><%= entity.name %></strong>
                  <br>
                  <small class="admin-text-muted">ID: <%= entity.id %></small>
                </td>
                <td class="admin-text-right admin-text-secondary">
                  $<%= number_with_precision(entity.last_month_cost, precision: 2) %>
                </td>
                <td class="admin-text-right">
                  $<%= number_with_precision(entity.current_month_cost, precision: 2) %>
                </td>
                <td class="admin-text-right">
                  <span class="admin-badge <%= growth > 50 ? 'admin-badge-danger' : growth > 20 ? 'admin-badge-warning' : 'admin-badge-success' %>">
                    +<%= number_with_precision(growth, precision: 1) %>%
                  </span>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <!-- Anomalies and Optimizations -->
  <div class="admin-content-grid admin-mb-xl">
    <!-- Cost Anomalies -->
    <div class="admin-card">
      <div class="admin-flex admin-items-center admin-flex-gap-sm admin-mb-lg" style="border-bottom: 2px solid var(--status-error-text); padding-bottom: 0.75rem;">
        <i data-lucide="alert-triangle" class="admin-icon-md" style="color: var(--status-error-text);"></i>
        <h3 class="card-title m-0">Cost Anomalies Detected</h3>
      </div>
      <% if @insights[:anomalies].any? %>
        <div class="admin-detail-list">
          <% @insights[:anomalies].first(10).each do |anomaly| %>
            <div class="detail-item admin-p-md admin-rounded-md" style="background: var(--bg-tertiary);">
              <div class="admin-flex-between">
                <div>
                  <strong class="admin-text-primary"><%= anomaly[:entity_name] %></strong>
                  <br>
                  <small class="admin-text-muted">
                    <%= anomaly[:date] %> - Spike detected
                  </small>
                </div>
                <div class="admin-text-right">
                  <span class="admin-text-error admin-font-semibold">
                    $<%= number_with_precision(anomaly[:cost], precision: 2) %>
                  </span>
                  <br>
                  <small class="admin-text-muted">
                    Expected: $<%= anomaly[:expected_range] %>
                  </small>
                </div>
              </div>
            </div>
          <% end %>
        </div>
      <% else %>
        <div class="admin-empty-state admin-p-xl">
          <div class="empty-icon admin-mb-md">
            <i data-lucide="check-circle" class="admin-icon-xl admin-text-success"></i>
          </div>
          <p class="admin-m-0 admin-text-secondary">No anomalies detected</p>
        </div>
      <% end %>
    </div>

    <!-- Optimization Opportunities -->
    <div class="admin-card">
      <div class="admin-flex admin-items-center admin-flex-gap-sm admin-mb-lg" style="border-bottom: 2px solid var(--status-success-text); padding-bottom: 0.75rem;">
        <i data-lucide="lightbulb" class="admin-icon-md" style="color: var(--status-success-text);"></i>
        <h3 class="card-title m-0">Optimization Opportunities</h3>
      </div>
      <% if @insights[:optimization_opportunities].any? %>
        <div class="admin-detail-list">
          <% @insights[:optimization_opportunities].each do |opportunity| %>
            <div class="detail-item admin-p-md admin-rounded-md" style="background: var(--bg-tertiary);">
              <div class="admin-flex-between">
                <div>
                  <strong class="admin-text-primary">Entity #<%= opportunity[:entity_id] %></strong>
                  <br>
                  <% if opportunity[:type] == 'downgrade_tier' %>
                    <span class="admin-badge admin-badge-info admin-mt-xs">Tier Optimization</span>
                    <small class="admin-text-secondary d-block admin-mt-xs">
                      Consider downgrading tier - low usage detected
                    </small>
                  <% elsif opportunity[:type] == 'optimize_storage' %>
                    <span class="admin-badge admin-badge-warning admin-mt-xs">Storage Optimization</span>
                    <small class="admin-text-secondary d-block admin-mt-xs">
                      <%= opportunity[:recommendation] %>
                    </small>
                  <% end %>
                </div>
                <div class="admin-text-right">
                  <% if opportunity[:potential_savings] %>
                    <span class="admin-text-success admin-font-semibold">
                      Save $<%= number_with_precision(opportunity[:potential_savings], precision: 0) %>/mo
                    </span>
                  <% end %>
                </div>
              </div>
            </div>
          <% end %>
        </div>
      <% else %>
        <div class="admin-empty-state admin-p-xl">
          <div class="empty-icon admin-mb-md">
            <i data-lucide="thumbs-up" class="admin-icon-xl admin-text-success"></i>
          </div>
          <p class="admin-m-0 admin-text-secondary">No optimization opportunities identified</p>
        </div>
      <% end %>
    </div>
  </div>

  <!-- Service Category Analysis -->
  <div class="admin-card" data-turbo-cache="false">
    <h3 class="card-title m-0 admin-mb-lg">
      <i data-lucide="layers" class="admin-icon-md d-inline-block align-middle me-2"></i>
      Service Category Breakdown (All Entities)
    </h3>
    <div class="admin-chart-container">
      <canvas id="serviceCategoryChart"></canvas>
    </div>
  </div>
</div>

<!-- Consolidated Chart.js -->
<%= render 'admin/chart_js' %>
<script>
document.addEventListener('DOMContentLoaded', function() {
  // Get theme-aware colors
  const styles = getComputedStyle(document.documentElement);
  const textColor = styles.getPropertyValue('--text-secondary').trim() || '#94A3B8';
  const gridColor = styles.getPropertyValue('--border-primary').trim() || '#1E293B';

  // Service Category Stacked Bar Chart
  const ctx = document.getElementById('serviceCategoryChart').getContext('2d');

  // Get last 7 days of data
  const dates = [];
  const aiData = [];
  const emailData = [];
  const storageData = [];
  const computeData = [];
  const otherData = [];

  <% 7.downto(1) do |days_ago| %>
    <% date = days_ago.days.ago.to_date %>
    <% daily_totals = EntityCostSummary.where(summary_date: date).group(:summary_date).sum(
         :ai_chat_cost, :email_cost, :storage_cost, :compute_cost,
         :bandwidth_cost, :integration_cost, :other_costs) %>
    dates.push('<%= date.strftime("%b %d") %>');
    aiData.push(<%= daily_totals[date]&.[](:ai_chat_cost) || 0 %>);
    emailData.push(<%= daily_totals[date]&.[](:email_cost) || 0 %>);
    storageData.push(<%= daily_totals[date]&.[](:storage_cost) || 0 %>);
    computeData.push(<%= daily_totals[date]&.[](:compute_cost) || 0 %>);
    otherData.push(<%= (daily_totals[date]&.[](:bandwidth_cost) || 0) +
                       (daily_totals[date]&.[](:integration_cost) || 0) +
                       (daily_totals[date]&.[](:other_costs) || 0) %>);
  <% end %>

  // Theme-aware chart colors
  const chartColors = {
    ai: styles.getPropertyValue('--accent-purple-start').trim() || '#7C3AED',
    email: styles.getPropertyValue('--accent-purple-end').trim() || '#A78BFA',
    storage: styles.getPropertyValue('--status-info-text').trim() || '#38BDF8',
    compute: styles.getPropertyValue('--status-warning-text').trim() || '#FCD34D',
    other: textColor
  };

  new Chart(ctx, {
    type: 'bar',
    data: {
      labels: dates,
      datasets: [
        {
          label: 'AI Chat',
          data: aiData,
          backgroundColor: chartColors.ai
        },
        {
          label: 'Email',
          data: emailData,
          backgroundColor: chartColors.email
        },
        {
          label: 'Storage',
          data: storageData,
          backgroundColor: chartColors.storage
        },
        {
          label: 'Compute',
          data: computeData,
          backgroundColor: chartColors.compute
        },
        {
          label: 'Other',
          data: otherData,
          backgroundColor: chartColors.other
        }
      ]
    },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      scales: {
        x: {
          stacked: true,
          grid: { color: gridColor },
          ticks: { color: textColor }
        },
        y: {
          stacked: true,
          beginAtZero: true,
          grid: { color: gridColor },
          ticks: {
            color: textColor,
            callback: function(value) {
              return '$' + value.toFixed(0);
            }
          }
        }
      },
      plugins: {
        legend: {
          position: 'bottom',
          labels: { color: textColor }
        },
        tooltip: {
          callbacks: {
            label: function(context) {
              return context.dataset.label + ': $' + context.parsed.y.toFixed(2);
            }
          }
        }
      }
    }
  });

  // Initialize icons
  if (typeof lucide !== 'undefined') {
    lucide.createIcons();
  }
});
</script>
