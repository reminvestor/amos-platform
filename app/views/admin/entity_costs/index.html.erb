<%# app/views/admin/entity_costs/index.html.erb %>
<div class="container-fluid mt-4">
  <div class="row">
    <div class="col-12">
      <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h2">
          <i data-lucide="trending-up" class="me-2"></i>
          Entity Cost Tracking
        </h1>

        <div class="d-flex gap-2">
          <%= link_to bulk_analysis_admin_entity_costs_path, class: "btn btn-outline-primary" do %>
            <i data-lucide="bar-chart-3" class="me-1"></i> Bulk Analysis
          <% end %>

          <%= link_to export_admin_entity_costs_path(format: :csv, start_date: @start_date, end_date: @end_date),
                      class: "btn btn-outline-success" do %>
            <i data-lucide="download" class="me-1"></i> Export All
          <% end %>
        </div>
      </div>

      <!-- Date Range Filter -->
      <div class="card mb-4">
        <div class="card-body">
          <%= form_with url: admin_entity_costs_path, method: :get, local: true, class: "row g-3" do |f| %>
            <div class="col-md-4">
              <%= label_tag :start_date, "Start Date", class: "form-label" %>
              <%= date_field_tag :start_date, @start_date, class: "form-control" %>
            </div>
            <div class="col-md-4">
              <%= label_tag :end_date, "End Date", class: "form-label" %>
              <%= date_field_tag :end_date, @end_date, class: "form-control" %>
            </div>
            <div class="col-md-4 d-flex align-items-end">
              <%= submit_tag "Filter", class: "btn btn-primary" %>
              <%= link_to "Reset", admin_entity_costs_path, class: "btn btn-outline-secondary ms-2" %>
            </div>
          <% end %>
        </div>
      </div>

      <!-- Summary Cards -->
      <div class="row mb-4">
        <div class="col-md-3">
          <div class="card border-primary">
            <div class="card-body">
              <h5 class="card-title text-muted">Total Costs</h5>
              <h2 class="mb-0">$<%= number_with_precision(@total_costs, precision: 2) %></h2>
              <small class="text-muted">
                <%= @start_date.strftime("%b %d") %> - <%= @end_date.strftime("%b %d, %Y") %>
              </small>
            </div>
          </div>
        </div>

        <div class="col-md-3">
          <div class="card border-info">
            <div class="card-body">
              <h5 class="card-title text-muted">Active Entities</h5>
              <h2 class="mb-0"><%= @entities.count %></h2>
              <small class="text-muted">With usage in period</small>
            </div>
          </div>
        </div>

        <div class="col-md-3">
          <div class="card border-warning">
            <div class="card-body">
              <h5 class="card-title text-muted">Avg Cost/Entity</h5>
              <h2 class="mb-0">
                $<%= number_with_precision(@entities.any? ? @total_costs / @entities.count : 0, precision: 2) %>
              </h2>
              <small class="text-muted">Per entity average</small>
            </div>
          </div>
        </div>

        <div class="col-md-3">
          <div class="card border-danger">
            <div class="card-body">
              <h5 class="card-title text-muted">Cost Trend</h5>
              <h2 class="mb-0">
                <% trend = @cost_trends[:trend] %>
                <% if trend == 'increasing' %>
                  <i data-lucide="arrow-up" class="text-danger"></i>
                <% elsif trend == 'decreasing' %>
                  <i data-lucide="arrow-down" class="text-success"></i>
                <% else %>
                  <i data-lucide="equal" class="text-secondary"></i>
                <% end %>
                <%= trend.capitalize %>
              </h2>
              <small class="text-muted">30-day trend</small>
            </div>
          </div>
        </div>
      </div>

      <!-- Cost by Category Chart -->
      <div class="card mb-4">
        <div class="card-header">
          <h5 class="mb-0">Cost Distribution by Service Category</h5>
        </div>
        <div class="card-body">
          <canvas id="costByCategoryChart" height="100"></canvas>
        </div>
      </div>

      <!-- Top Spenders Table -->
      <div class="card">
        <div class="card-header">
          <h5 class="mb-0">Top Cost Entities</h5>
        </div>
        <div class="card-body">
          <div class="table-responsive">
            <table class="table table-hover">
              <thead>
                <tr>
                  <th>Rank</th>
                  <th>Entity</th>
                  <th>Billing Tier</th>
                  <th>Total Cost</th>
                  <th>AI Chat</th>
                  <th>Email</th>
                  <th>Storage</th>
                  <th>Other</th>
                  <th>Actions</th>
                </tr>
              </thead>
              <tbody>
                <% @top_spenders.each_with_index do |entity_data, index| %>
                  <% entity = Entity.find(entity_data[:id]) %>
                  <% summary = entity.entity_cost_summaries.where(summary_date: @start_date..@end_date) %>
                  <tr>
                    <td>
                      <span class="badge bg-<%= index < 3 ? 'danger' : 'secondary' %>">
                        #<%= index + 1 %>
                      </span>
                    </td>
                    <td>
                      <strong><%= entity_data[:name] %></strong>
                      <br>
                      <small class="text-muted">ID: <%= entity_data[:id] %></small>
                    </td>
                    <td>
                      <span class="badge bg-<%= entity.billing_tier == 'premium' ? 'primary' :
                                                entity.billing_tier == 'standard' ? 'info' :
                                                'secondary' %>">
                        <%= entity.billing_tier %>
                      </span>
                    </td>
                    <td class="text-end">
                      <strong>$<%= number_with_precision(entity_data[:total_cost], precision: 2) %></strong>
                      <% if entity.cost_thresholds['total'].present? %>
                        <br>
                        <div class="progress mt-1" style="height: 5px;">
                          <div class="progress-bar <%= entity_data[:total_cost] > entity.cost_thresholds['total'] ? 'bg-danger' : 'bg-success' %>"
                               style="width: <%= [(entity_data[:total_cost] / entity.cost_thresholds['total'] * 100), 100].min %>%"></div>
                        </div>
                      <% end %>
                    </td>
                    <td class="text-end">
                      $<%= number_with_precision(summary.sum(:ai_chat_cost), precision: 2) %>
                    </td>
                    <td class="text-end">
                      $<%= number_with_precision(summary.sum(:email_cost), precision: 2) %>
                    </td>
                    <td class="text-end">
                      $<%= number_with_precision(summary.sum(:storage_cost), precision: 2) %>
                    </td>
                    <td class="text-end">
                      $<%= number_with_precision(
                        summary.sum(:compute_cost) +
                        summary.sum(:bandwidth_cost) +
                        summary.sum(:integration_cost) +
                        summary.sum(:other_costs),
                        precision: 2) %>
                    </td>
                    <td>
                      <%= link_to admin_entity_cost_path(entity),
                                  class: "btn btn-sm btn-outline-primary",
                                  title: "View Details" do %>
                        <i data-lucide="bar-chart"></i>
                      <% end %>
                      <%= link_to export_admin_entity_cost_path(entity, format: :csv, start_date: @start_date, end_date: @end_date),
                                  class: "btn btn-sm btn-outline-success",
                                  title: "Export CSV" do %>
                        <i data-lucide="download"></i>
                      <% end %>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>

          <!-- Pagination -->
          <% if @entities.respond_to?(:total_pages) %>
            <div class="d-flex justify-content-center mt-4">
              <%= paginate @entities %>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Consolidated Chart.js -->
<%= render 'admin/chart_js' %>
<script>
document.addEventListener('DOMContentLoaded', function() {
  // Cost by Category Chart
  const ctx = document.getElementById('costByCategoryChart').getContext('2d');

  const categories = ['AI Chat', 'Email', 'Storage', 'Compute', 'Bandwidth', 'Integrations', 'Other'];
  const data = [
    <%= @cost_by_category.sum { |_, costs| costs[:ai_chat_cost] || 0 } %>,
    <%= @cost_by_category.sum { |_, costs| costs[:email_cost] || 0 } %>,
    <%= @cost_by_category.sum { |_, costs| costs[:storage_cost] || 0 } %>,
    <%= @cost_by_category.sum { |_, costs| costs[:compute_cost] || 0 } %>,
    <%= @cost_by_category.sum { |_, costs| costs[:bandwidth_cost] || 0 } %>,
    <%= @cost_by_category.sum { |_, costs| costs[:integration_cost] || 0 } %>,
    <%= @cost_by_category.sum { |_, costs| costs[:other_costs] || 0 } %>
  ];

  new Chart(ctx, {
    type: 'doughnut',
    data: {
      labels: categories,
      datasets: [{
        data: data,
        backgroundColor: [
          '#0d6efd',
          '#6610f2',
          '#6f42c1',
          '#d63384',
          '#dc3545',
          '#fd7e14',
          '#ffc107'
        ]
      }]
    },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      plugins: {
        legend: {
          position: 'right'
        },
        tooltip: {
          callbacks: {
            label: function(context) {
              const label = context.label || '';
              const value = '$' + context.parsed.toFixed(2);
              const total = context.dataset.data.reduce((a, b) => a + b, 0);
              const percent = ((context.parsed / total) * 100).toFixed(1);
              return label + ': ' + value + ' (' + percent + '%)';
            }
          }
        }
      }
    }
  });
});
</script>