<%# app/views/admin/entity_costs/show.html.erb %>
<div class="container-fluid mt-4">
  <div class="row">
    <div class="col-12">
      <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
          <h1 class="h2">
            <i data-lucide="building" class="me-2"></i>
            <%= @entity.name %> - Cost Analysis
          </h1>
          <p class="text-muted mb-0">
            Entity ID: <%= @entity.id %> |
            Billing Tier: <span class="badge bg-info"><%= @entity.billing_tier %></span> |
            Period: <%= @start_date.strftime("%b %d, %Y") %> - <%= @end_date.strftime("%b %d, %Y") %>
          </p>
        </div>

        <div class="d-flex gap-2">
          <%= link_to admin_entity_costs_path, class: "btn btn-outline-secondary" do %>
            <i data-lucide="arrow-left" class="me-1"></i> Back to List
          <% end %>

          <%= link_to export_admin_entity_cost_path(@entity, format: :csv, start_date: @start_date, end_date: @end_date),
                      class: "btn btn-outline-success" do %>
            <i class="fas fa-download me-1"></i> Export CSV
          <% end %>

          <%= link_to export_admin_entity_cost_path(@entity, format: :json, start_date: @start_date, end_date: @end_date),
                      class: "btn btn-outline-primary" do %>
            <i data-lucide="code" class="me-1"></i> Export JSON
          <% end %>
        </div>
      </div>

      <!-- Date Range Filter -->
      <div class="card mb-4">
        <div class="card-body">
          <%= form_with url: admin_entity_cost_path(@entity), method: :get, local: true, class: "row g-3" do |f| %>
            <div class="col-md-5">
              <%= label_tag :start_date, "Start Date", class: "form-label" %>
              <%= date_field_tag :start_date, @start_date, class: "form-control" %>
            </div>
            <div class="col-md-5">
              <%= label_tag :end_date, "End Date", class: "form-label" %>
              <%= date_field_tag :end_date, @end_date, class: "form-control" %>
            </div>
            <div class="col-md-2 d-flex align-items-end">
              <%= submit_tag "Update", class: "btn btn-primary w-100" %>
            </div>
          <% end %>
        </div>
      </div>

      <!-- Threshold Alerts -->
      <% if @threshold_alerts.any? %>
        <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert">
          <h5 class="alert-heading">
            <i class="fas fa-exclamation-triangle me-2"></i>
            Cost Threshold Alerts
          </h5>
          <ul class="mb-0">
            <% @threshold_alerts.each do |alert| %>
              <li>
                <strong><%= alert[:category].humanize %>:</strong>
                Current: $<%= number_with_precision(alert[:current], precision: 2) %> |
                Threshold: $<%= number_with_precision(alert[:threshold], precision: 2) %> |
                <span class="text-danger">+<%= alert[:overage_percent] %>% over</span>
              </li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <!-- Cost Overview Cards -->
      <div class="row mb-4">
        <div class="col-md-3">
          <div class="card border-primary">
            <div class="card-body">
              <h6 class="card-title text-muted">Total Cost</h6>
              <h3 class="mb-0">$<%= number_with_precision(@total_cost, precision: 2) %></h3>
              <% if @projected_overage && @projected_overage > 0 %>
                <small class="text-danger">
                  Projected overage: $<%= number_with_precision(@projected_overage, precision: 2) %>
                </small>
              <% end %>
            </div>
          </div>
        </div>

        <div class="col-md-3">
          <div class="card border-info">
            <div class="card-body">
              <h6 class="card-title text-muted">Daily Average</h6>
              <h3 class="mb-0">
                $<%= number_with_precision(@daily_costs.values.sum / [@daily_costs.size, 1].max, precision: 2) %>
              </h3>
              <small class="text-muted">Per day</small>
            </div>
          </div>
        </div>

        <div class="col-md-3">
          <div class="card border-warning">
            <div class="card-body">
              <h6 class="card-title text-muted">Top Cost Driver</h6>
              <% if @top_cost_drivers.any? %>
                <h5 class="mb-0"><%= @top_cost_drivers.first[:category].humanize %></h5>
                <small>$<%= number_with_precision(@top_cost_drivers.first[:total_cost], precision: 2) %></small>
              <% else %>
                <h5 class="mb-0">N/A</h5>
              <% end %>
            </div>
          </div>
        </div>

        <div class="col-md-3">
          <div class="card border-success">
            <div class="card-body">
              <h6 class="card-title text-muted">Peer Comparison</h6>
              <% if @peer_benchmark %>
                <h5 class="mb-0">
                  <%= @peer_benchmark[:percentile] %> percentile
                </h5>
                <small class="<%= @peer_benchmark[:comparison] == 'above' ? 'text-danger' : 'text-success' %>">
                  <%= @peer_benchmark[:comparison] == 'above' ? '↑' : '↓' %>
                  <%= @peer_benchmark[:comparison] %> average
                </small>
              <% else %>
                <h5 class="mb-0">N/A</h5>
              <% end %>
            </div>
          </div>
        </div>
      </div>

      <!-- Cost Trends Chart -->
      <div class="card mb-4">
        <div class="card-header">
          <h5 class="mb-0">Daily Cost Trend</h5>
        </div>
        <div class="card-body">
          <canvas id="dailyCostChart" height="80"></canvas>
        </div>
      </div>

      <!-- Service Breakdown -->
      <div class="row mb-4">
        <!-- Cost by Category -->
        <div class="col-md-6">
          <div class="card h-100">
            <div class="card-header">
              <h5 class="mb-0">Cost by Category</h5>
            </div>
            <div class="card-body">
              <canvas id="categoryPieChart" height="300"></canvas>

              <div class="mt-3">
                <table class="table table-sm">
                  <thead>
                    <tr>
                      <th>Category</th>
                      <th class="text-end">Cost</th>
                      <th class="text-end">%</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% @costs_by_category.each do |category, cost| %>
                      <tr>
                        <td><%= category.to_s.humanize %></td>
                        <td class="text-end">$<%= number_with_precision(cost, precision: 2) %></td>
                        <td class="text-end">
                          <%= number_with_precision((cost / @total_cost * 100), precision: 1) %>%
                        </td>
                      </tr>
                    <% end %>
                  </tbody>
                </table>
              </div>
            </div>
          </div>
        </div>

        <!-- Top Cost Drivers -->
        <div class="col-md-6">
          <div class="card h-100">
            <div class="card-header">
              <h5 class="mb-0">Top Cost Drivers</h5>
            </div>
            <div class="card-body">
              <% @top_cost_drivers.each_with_index do |driver, index| %>
                <div class="mb-3">
                  <div class="d-flex justify-content-between align-items-center mb-1">
                    <span>
                      <strong><%= driver[:category].humanize %></strong>
                      <% if driver[:service].present? %>
                        <br><small class="text-muted"><%= driver[:service] %></small>
                      <% end %>
                    </span>
                    <span class="text-end">
                      $<%= number_with_precision(driver[:total_cost], precision: 2) %>
                    </span>
                  </div>
                  <div class="progress" style="height: 10px;">
                    <div class="progress-bar bg-<%= ['primary', 'info', 'warning', 'danger', 'success'][index % 5] %>"
                         style="width: <%= (driver[:total_cost] / @total_cost * 100).round %>%"></div>
                  </div>
                </div>
              <% end %>
            </div>
          </div>
        </div>
      </div>

      <!-- Service Details Tabs -->
      <div class="card">
        <div class="card-header">
          <ul class="nav nav-tabs card-header-tabs" role="tablist">
            <li class="nav-item">
              <a class="nav-link active" data-bs-toggle="tab" href="#ai-usage">
                AI Usage
              </a>
            </li>
            <li class="nav-item">
              <a class="nav-link" data-bs-toggle="tab" href="#email-usage">
                Email Usage
              </a>
            </li>
            <li class="nav-item">
              <a class="nav-link" data-bs-toggle="tab" href="#storage-usage">
                Storage Usage
              </a>
            </li>
            <li class="nav-item">
              <a class="nav-link" data-bs-toggle="tab" href="#recent-metrics">
                Recent Metrics
              </a>
            </li>
          </ul>
        </div>
        <div class="card-body">
          <div class="tab-content">
            <!-- AI Usage Tab -->
            <div class="tab-pane fade show active" id="ai-usage">
              <% if @ai_usage.any? %>
                <div class="table-responsive">
                  <table class="table">
                    <thead>
                      <tr>
                        <th>Service</th>
                        <th class="text-end">Total Tokens</th>
                        <th class="text-end">Conversations</th>
                        <th class="text-end">Total Cost</th>
                        <th class="text-end">Cost/Conv</th>
                      </tr>
                    </thead>
                    <tbody>
                      <% @ai_usage.each do |service, tokens, cost, count| %>
                        <tr>
                          <td><%= service %></td>
                          <td class="text-end"><%= number_with_delimiter(tokens.to_i) %></td>
                          <td class="text-end"><%= count %></td>
                          <td class="text-end">$<%= number_with_precision(cost, precision: 2) %></td>
                          <td class="text-end">$<%= number_with_precision(cost / [count, 1].max, precision: 3) %></td>
                        </tr>
                      <% end %>
                    </tbody>
                  </table>
                </div>
              <% else %>
                <p class="text-muted">No AI usage in selected period</p>
              <% end %>
            </div>

            <!-- Email Usage Tab -->
            <div class="tab-pane fade" id="email-usage">
              <% if @email_usage.any? %>
                <div class="table-responsive">
                  <table class="table">
                    <thead>
                      <tr>
                        <th>Service</th>
                        <th class="text-end">Emails Sent</th>
                        <th class="text-end">Total Cost</th>
                        <th class="text-end">Cost/Email</th>
                      </tr>
                    </thead>
                    <tbody>
                      <% @email_usage.each do |service, sent, cost| %>
                        <tr>
                          <td><%= service %></td>
                          <td class="text-end"><%= number_with_delimiter(sent.to_i) %></td>
                          <td class="text-end">$<%= number_with_precision(cost, precision: 2) %></td>
                          <td class="text-end">$<%= number_with_precision(cost / [sent, 1].max, precision: 4) %></td>
                        </tr>
                      <% end %>
                    </tbody>
                  </table>
                </div>
              <% else %>
                <p class="text-muted">No email usage in selected period</p>
              <% end %>
            </div>

            <!-- Storage Usage Tab -->
            <div class="tab-pane fade" id="storage-usage">
              <% if @storage_usage.any? %>
                <div class="table-responsive">
                  <table class="table">
                    <thead>
                      <tr>
                        <th>Service</th>
                        <th class="text-end">Avg GB Stored</th>
                        <th class="text-end">Total Cost</th>
                        <th class="text-end">Cost/GB</th>
                      </tr>
                    </thead>
                    <tbody>
                      <% @storage_usage.each do |service, gb, cost| %>
                        <tr>
                          <td><%= service %></td>
                          <td class="text-end"><%= number_with_precision(gb, precision: 2) %> GB</td>
                          <td class="text-end">$<%= number_with_precision(cost, precision: 2) %></td>
                          <td class="text-end">$<%= number_with_precision(cost / [gb, 1].max, precision: 4) %></td>
                        </tr>
                      <% end %>
                    </tbody>
                  </table>
                </div>
              <% else %>
                <p class="text-muted">No storage usage in selected period</p>
              <% end %>
            </div>

            <!-- Recent Metrics Tab -->
            <div class="tab-pane fade" id="recent-metrics">
              <div class="table-responsive">
                <table class="table table-sm">
                  <thead>
                    <tr>
                      <th>Date</th>
                      <th>Category</th>
                      <th>Service</th>
                      <th>Type</th>
                      <th class="text-end">Quantity</th>
                      <th class="text-end">Cost</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% @usage_metrics.limit(50).each do |metric| %>
                      <tr>
                        <td><%= metric.tracked_at.strftime("%m/%d %H:%M") %></td>
                        <td><%= metric.category %></td>
                        <td><%= metric.service %></td>
                        <td><%= metric.usage_type %></td>
                        <td class="text-end"><%= number_with_delimiter(metric.quantity) %></td>
                        <td class="text-end">$<%= number_with_precision(metric.calculated_cost_usd, precision: 4) %></td>
                      </tr>
                    <% end %>
                  </tbody>
                </table>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
document.addEventListener('DOMContentLoaded', function() {
  // Daily Cost Chart
  const dailyCtx = document.getElementById('dailyCostChart').getContext('2d');
  const dailyCosts = <%= @daily_costs.to_json.html_safe %>;

  new Chart(dailyCtx, {
    type: 'line',
    data: {
      labels: Object.keys(dailyCosts),
      datasets: [{
        label: 'Daily Cost',
        data: Object.values(dailyCosts),
        borderColor: '#0d6efd',
        backgroundColor: 'rgba(13, 110, 253, 0.1)',
        tension: 0.1,
        fill: true
      }]
    },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      plugins: {
        legend: {
          display: false
        },
        tooltip: {
          callbacks: {
            label: function(context) {
              return '$' + context.parsed.y.toFixed(2);
            }
          }
        }
      },
      scales: {
        y: {
          beginAtZero: true,
          ticks: {
            callback: function(value) {
              return '$' + value.toFixed(0);
            }
          }
        }
      }
    }
  });

  // Category Pie Chart
  const categoryCtx = document.getElementById('categoryPieChart').getContext('2d');
  const categoryData = <%= @costs_by_category.to_json.html_safe %>;

  new Chart(categoryCtx, {
    type: 'pie',
    data: {
      labels: Object.keys(categoryData).map(k => k.charAt(0).toUpperCase() + k.slice(1).replace('_', ' ')),
      datasets: [{
        data: Object.values(categoryData),
        backgroundColor: [
          '#0d6efd',
          '#6610f2',
          '#6f42c1',
          '#d63384',
          '#dc3545',
          '#fd7e14',
          '#ffc107',
          '#28a745'
        ]
      }]
    },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      plugins: {
        legend: {
          position: 'bottom'
        },
        tooltip: {
          callbacks: {
            label: function(context) {
              const label = context.label || '';
              const value = '$' + context.parsed.toFixed(2);
              const total = context.dataset.data.reduce((a, b) => a + b, 0);
              const percent = ((context.parsed / total) * 100).toFixed(1);
              return label + ': ' + value + ' (' + percent + '%)';
            }
          }
        }
      }
    }
  });
});
</script>