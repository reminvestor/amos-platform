<div class="container-fluid py-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <div>
      <h1 class="h3 mb-1">
        <code><%= @action.action_name %></code>
      </h1>
      <p class="text-muted mb-0"><%= @action.description %></p>
    </div>
    <div class="d-flex gap-2">
      <%= link_to admin_integration_integration_actions_path(@integration), class: "admin-btn admin-btn-outline" do %>
        <i data-lucide="arrow-left" style="width: 16px; height: 16px;" class="me-1"></i> Back
      <% end %>
      <%= link_to edit_admin_integration_integration_action_path(@integration, @action), class: "admin-btn admin-btn-primary" do %>
        <i data-lucide="edit" style="width: 16px; height: 16px;" class="me-1"></i> Edit
      <% end %>
    </div>
  </div>

  <div class="row">
    <div class="col-lg-8">
      <!-- Details -->
      <div class="admin-card mb-4">
        <h5 class="mb-3">Action Details</h5>
        <dl class="row mb-0">
          <dt class="col-sm-3">Slug</dt>
          <dd class="col-sm-9"><code><%= @action.slug %></code></dd>

          <dt class="col-sm-3">Status</dt>
          <dd class="col-sm-9">
            <% status_class = case @action.status
              when 'active' then 'admin-badge-success'
              when 'draft' then ''
              when 'testing' then 'admin-badge-info'
              else ''
            end %>
            <span class="admin-badge <%= status_class %>"><%= @action.status %></span>
            <% if @action.draft? %>
              <%= link_to activate_admin_integration_integration_action_path(@integration, @action),
                  method: :post,
                  class: "admin-btn admin-btn-sm admin-btn-success ms-2" do %>
                Activate
              <% end %>
            <% end %>
          </dd>

          <dt class="col-sm-3">Operation</dt>
          <dd class="col-sm-9">
            <code><%= @action.integration_operation&.operation_id %></code>
            <br><small class="text-muted"><%= @action.integration_operation&.http_method %> <%= @action.integration_operation&.path_template %></small>
          </dd>

          <dt class="col-sm-3">Category</dt>
          <dd class="col-sm-9"><%= @action.category || '-' %></dd>

          <dt class="col-sm-3">Generated By</dt>
          <dd class="col-sm-9"><%= @action.mapping_code_generated_by || 'manual' %> • <%= @action.mapping_code_generated_at&.strftime("%Y-%m-%d %H:%M") %></dd>
        </dl>
      </div>

      <!-- Input Schema -->
      <div class="admin-card mb-4">
        <h5 class="mb-3">Input Schema</h5>
        <% if @action.input_schema.any? %>
          <div class="table-responsive">
            <table class="admin-table">
              <thead>
                <tr>
                  <th>Field</th>
                  <th>Type</th>
                  <th>Required</th>
                  <th>Description</th>
                </tr>
              </thead>
              <tbody>
                <% @action.input_schema.each do |field| %>
                  <tr>
                    <td><code><%= field['name'] || field[:name] %></code></td>
                    <td><%= field['type'] || field[:type] %></td>
                    <td>
                      <% if field['required'] || field[:required] %>
                        <i data-lucide="check" style="width: 16px; height: 16px;" class="text-success"></i>
                      <% end %>
                    </td>
                    <td class="small text-muted"><%= field['description'] || field[:description] %></td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        <% else %>
          <p class="text-muted">No input schema defined</p>
        <% end %>
      </div>

      <!-- Mapping Code -->
      <div class="admin-card mb-4">
        <h5 class="mb-3">Mapping Code</h5>
        <pre style="background: var(--bg-tertiary); padding: 1rem; border-radius: 0.5rem; overflow-x: auto;"><code class="language-ruby"><%= @action.mapping_code %></code></pre>
      </div>

      <!-- Test Panel -->
      <div class="admin-card mb-4">
        <h5 class="mb-3">Test Mapping</h5>
        <%= form_with url: test_admin_integration_integration_action_path(@integration, @action), method: :post, local: true do |form| %>
          <div class="mb-3">
            <label class="form-label">Test Inputs (JSON)</label>
            <textarea name="test_inputs" class="form-control" rows="4" 
                      placeholder='{"email": "test@example.com", "name": "Test User"}'><%= @action.sample_input.to_json %></textarea>
          </div>
          <%= form.submit "Test", class: "admin-btn admin-btn-primary" %>
        <% end %>

        <% if @test_result %>
          <div class="mt-3 p-3 rounded" style="background: <%= @test_result[:success] ? 'var(--status-success-bg)' : 'var(--status-danger-bg)' %>;">
            <strong><%= @test_result[:success] ? '✅ Success' : '❌ Failed' %></strong>
            <% if @test_result[:success] %>
              <pre class="mt-2 mb-0"><code><%= JSON.pretty_generate(@test_result[:mapped_params] || @test_result) %></code></pre>
            <% else %>
              <p class="mb-0 mt-2"><%= @test_result[:error] %></p>
            <% end %>
          </div>
        <% end %>
      </div>
    </div>

    <div class="col-lg-4">
      <!-- Usage Stats -->
      <div class="admin-card mb-4">
        <h5 class="mb-3">Usage Statistics</h5>
        <dl class="row mb-0">
          <dt class="col-6">Total Calls</dt>
          <dd class="col-6 text-end"><%= @action.usage_count %></dd>

          <dt class="col-6">Successful</dt>
          <dd class="col-6 text-end text-success"><%= @action.success_count %></dd>

          <dt class="col-6">Errors</dt>
          <dd class="col-6 text-end text-danger"><%= @action.error_count %></dd>

          <dt class="col-6">Success Rate</dt>
          <dd class="col-6 text-end"><%= @action.success_rate %>%</dd>

          <dt class="col-6">Last Used</dt>
          <dd class="col-6 text-end"><%= @action.last_used_at&.strftime("%Y-%m-%d") || '-' %></dd>
        </dl>
      </div>

      <!-- Recent Executions -->
      <div class="admin-card">
        <h5 class="mb-3">Recent Executions</h5>
        <% if @executions.any? %>
          <% @executions.each do |exec| %>
            <div class="p-2 rounded mb-2" style="background: var(--bg-tertiary);">
              <div class="d-flex justify-content-between align-items-center">
                <span class="admin-badge <%= exec.success? ? 'admin-badge-success' : 'admin-badge-danger' %>">
                  <%= exec.status %>
                </span>
                <small class="text-muted"><%= exec.created_at.strftime("%m/%d %H:%M") %></small>
              </div>
              <% if exec.duration_ms %>
                <small class="text-muted"><%= exec.duration_ms %>ms</small>
              <% end %>
              <% if exec.error_message %>
                <small class="text-danger d-block"><%= exec.error_message.truncate(50) %></small>
              <% end %>
            </div>
          <% end %>
        <% else %>
          <p class="text-muted mb-0">No executions yet</p>
        <% end %>
      </div>
    </div>
  </div>
</div>

