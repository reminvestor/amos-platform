<div style="padding: 2rem;">
  <div class="admin-page-header" style="margin-bottom: 2rem;">
    <div class="header-left">
      <%= link_to admin_tools_path, class: "admin-back-link" do %>
        <i data-lucide="arrow-left"></i> Back to Tools
      <% end %>
      <div class="header-text" style="margin-left: 1rem;">
        <div class="d-flex align-items-center gap-3">
          <h1><%= @tool.name %></h1>
          <% if @tool.security_rating == 'pass' %>
            <span class="badge bg-success">Security: Pass</span>
          <% elsif @tool.security_rating == 'fail' %>
            <span class="badge bg-danger">Security: Fail</span>
          <% elsif @tool.security_rating == 'review' %>
            <span class="badge bg-warning text-dark">Security: Review</span>
          <% else %>
            <span class="badge bg-secondary">Security: Pending</span>
          <% end %>
        </div>
        <p><%= @tool.description %></p>
      </div>
    </div>
    <div class="header-actions">
      <%= link_to edit_admin_tool_path(@tool), class: "admin-btn admin-btn-secondary" do %>
        <i data-lucide="edit"></i> Edit
      <% end %>
    </div>
  </div>

  <div class="row">
    <div class="col-md-8">
      <div class="admin-card mb-4">
        <div class="card-header">
          <h3>Configuration</h3>
        </div>
        <div class="card-body">
          <dl class="row mb-0">
            <dt class="col-sm-3">Execution Type</dt>
            <dd class="col-sm-9"><span class="badge bg-info"><%= @tool.execution_type %></span></dd>

            <dt class="col-sm-3">Created By</dt>
            <dd class="col-sm-9"><%= @tool.created_by ? link_to(@tool.created_by.email, admin_user_path(@tool.created_by)) : "System" %></dd>

            <dt class="col-sm-3">Created At</dt>
            <dd class="col-sm-9"><%= @tool.created_at.strftime("%B %d, %Y %H:%M") %></dd>
            
            <dt class="col-sm-3">Visibility</dt>
            <dd class="col-sm-9">
              <% if @tool.is_public? %>
                <span class="badge bg-success">Public</span>
                <span class="text-muted small ms-2">Published <%= time_ago_in_words(@tool.published_at) %> ago</span>
              <% else %>
                <span class="badge bg-secondary">Private</span>
              <% end %>
            </dd>
          </dl>
        </div>
      </div>

      <% if @tool.security_reason.present? %>
        <div class="admin-card mb-4 border-<%= @tool.security_rating == 'fail' ? 'danger' : (@tool.security_rating == 'review' ? 'warning' : 'success') %>">
          <div class="card-header">
            <h3>Security Analysis</h3>
          </div>
          <div class="card-body">
            <p class="mb-0"><%= @tool.security_reason %></p>
          </div>
        </div>
      <% end %>

      <div class="admin-card mb-4">
        <div class="card-header">
          <h3>Implementation</h3>
        </div>
        <div class="card-body p-0">
          <% if @tool.execution_type == 'ruby_code' %>
            <pre class="m-0 p-3" style="background: #0f172a; color: #e2e8f0; overflow-x: auto;"><code><%= @tool.code %></code></pre>
          <% else %>
            <pre class="m-0 p-3" style="background: #0f172a; color: #e2e8f0; overflow-x: auto;"><code><%= JSON.pretty_generate(@tool.api_config) rescue @tool.api_config %></code></pre>
          <% end %>
        </div>
      </div>
    </div>

    <div class="col-md-4">
      <div class="admin-card mb-4">
        <div class="card-header">
          <h3>Input Schema</h3>
        </div>
        <div class="card-body p-0">
          <pre class="m-0 p-3" style="background: #0f172a; color: #e2e8f0; overflow-x: auto; font-size: 0.85rem;"><code><%= JSON.pretty_generate(@tool.parameters) rescue @tool.parameters %></code></pre>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  document.addEventListener('turbo:load', () => {
    if (typeof lucide !== 'undefined') {
      lucide.createIcons();
    }
  });
</script>

