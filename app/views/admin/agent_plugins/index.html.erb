<div class="admin-p-xl">
  <!-- Page Header -->
  <div class="admin-page-header">
    <div class="header-left">
      <div class="header-icon">
        <%= admin_icon('bot', size: :lg) %>
      </div>
      <div class="header-text">
        <h1>Agent Plugins</h1>
        <p>Create and manage AI agents</p>
      </div>
    </div>

    <div class="header-actions">
      <div class="d-flex flex-wrap admin-flex-gap-sm">
        <%= link_to new_admin_agent_plugin_path, class: "admin-btn admin-btn-primary" do %>
          <%= admin_icon('plus', size: :sm) %>
          <span>Create Agent</span>
        <% end %>
        <%= link_to analytics_admin_agent_plugins_path, class: "admin-btn admin-btn-secondary" do %>
          <%= admin_icon('bar-chart-3', size: :sm) %>
          <span>Analytics</span>
        <% end %>
      </div>
    </div>
  </div>

  <!-- Stats Cards -->
  <div class="admin-stats-grid">
    <%= render 'admin/shared/stat_card',
      icon: 'layers',
      value: @stats[:total],
      label: 'Total Agents',
      style: 'purple-gradient' %>

    <%= render 'admin/shared/stat_card',
      icon: 'check-circle',
      value: @stats[:active],
      label: 'Active',
      style: 'success' %>

    <%= render 'admin/shared/stat_card',
      icon: 'file-text',
      value: @stats[:draft],
      label: 'Draft',
      style: 'warning' %>

    <%= render 'admin/shared/stat_card',
      icon: 'globe',
      value: @stats[:system_wide],
      label: 'System-Wide',
      style: 'info' %>
  </div>

  <!-- Filters -->
  <div class="admin-card admin-mb-xl">
    <%= form_with url: admin_agent_plugins_path, method: :get, class: 'admin-filter-grid' do |f| %>
      <div>
        <label class="form-label admin-text-sm">Status</label>
        <%= f.select :status,
          options_for_select([
            ['All Statuses', 'all'],
            ['Active', 'active'],
            ['Draft', 'draft'],
            ['Deprecated', 'deprecated']
          ], @filter_status),
          {},
          class: 'admin-select admin-w-full' %>
      </div>

      <div>
        <label class="form-label admin-text-sm">Role</label>
        <%= f.select :role,
          options_for_select([
            ['All Roles', ''],
            ['Executor', 'executor'],
            ['Planner', 'planner'],
            ['Analyst', 'analyst'],
            ['Verifier', 'verifier'],
            ['Fixer', 'fixer'],
            ['Custom', 'custom']
          ], @filter_role),
          {},
          class: 'admin-select admin-w-full' %>
      </div>

      <div class="admin-flex-1">
        <label class="form-label admin-text-sm">Search</label>
        <%= f.text_field :search,
          value: @search,
          placeholder: 'Search agents...',
          class: 'admin-input admin-w-full' %>
      </div>

      <%= f.submit 'Filter', class: 'admin-btn admin-btn-primary admin-mb-0' %>
    <% end %>
  </div>

  <!-- Agent List -->
  <div class="admin-card">
    <div class="admin-table-container">
      <table class="admin-table">
        <thead>
          <tr>
            <th>Name</th>
            <th>Role</th>
            <th>Status</th>
            <th>Priority</th>
            <th>Capabilities</th>
            <th>Scope</th>
            <th>Last Active</th>
            <th>Actions</th>
          </tr>
        </thead>
      <tbody>
        <% if @agent_plugins.any? %>
          <% @agent_plugins.each do |agent| %>
            <tr>
              <td>
                <div class="d-flex align-items-center gap-2">
                  <%= admin_icon('bot', size: :sm, class: 'text-primary') %>
                  <div>
                    <strong><%= link_to agent.name, admin_agent_plugin_path(agent) %></strong>
                    <div class="text-muted small"><%= agent.slug %></div>
                  </div>
                </div>
              </td>
              <td>
                <span class="badge bg-secondary"><%= agent.role.titleize %></span>
              </td>
              <td>
                <span class="badge bg-<%= agent.status == 'active' ? 'success' : agent.status == 'draft' ? 'warning' : 'secondary' %>">
                  <%= agent.status.titleize %>
                </span>
              </td>
              <td>
                <div class="d-flex align-items-center gap-2">
                  <div class="progress flex-grow-1 admin-priority-bar">
                    <div class="progress-bar" role="progressbar" style="width: <%= agent.priority %>%"></div>
                  </div>
                  <small><%= agent.priority %></small>
                </div>
              </td>
              <td>
                <span class="badge bg-info"><%= agent.agent_capabilities.count %> capabilities</span>
              </td>
              <td>
                <% if agent.system_wide? %>
                  <%= admin_icon('globe', size: :sm, class: 'text-info', title: 'System-wide') %>
                <% else %>
                  <%= admin_icon('building', size: :sm, class: 'text-muted', title: 'Entity-specific') %>
                <% end %>
              </td>
              <td>
                <small class="text-muted">
                  <%= agent.last_activated_at ? time_ago_in_words(agent.last_activated_at) + ' ago' : 'Never' %>
                </small>
              </td>
              <td>
                <div class="btn-group btn-group-sm">
                  <%= link_to admin_agent_plugin_path(agent), class: "btn btn-sm btn-outline-primary", title: "View" do %>
                    <%= admin_icon('eye', size: :sm) %>
                  <% end %>
                  <%= link_to edit_admin_agent_plugin_path(agent), class: "btn btn-sm btn-outline-secondary", title: "Edit" do %>
                    <%= admin_icon('edit', size: :sm) %>
                  <% end %>
                  <%= link_to test_admin_agent_plugin_path(agent), class: "btn btn-sm btn-outline-info", title: "Test" do %>
                    <%= admin_icon('play', size: :sm) %>
                  <% end %>
                </div>
              </td>
            </tr>
          <% end %>
        <% else %>
          <tr>
            <td colspan="8" class="admin-text-center admin-text-muted admin-p-xl">
              <div class="admin-mx-auto admin-mb-md" style="width: 48px; height: 48px;">
                <%= admin_icon('inbox', size: :xl) %>
              </div>
              <p>No agent plugins found</p>
              <%= link_to "Create your first agent", new_admin_agent_plugin_path, class: "admin-btn admin-btn-primary admin-mt-sm" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
    </div>
  </div>

  <!-- Pagination -->
  <% if @agent_plugins.any? %>
    <div class="admin-pagination">
      <%= paginate @agent_plugins %>
    </div>
  <% end %>
</div>

<script>
  document.addEventListener('turbo:load', () => {
    lucide.createIcons();
  });
</script>
