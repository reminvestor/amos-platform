<div class="admin-p-xl">
  <!-- Page Header -->
  <div class="admin-page-header admin-mb-xl">
    <div class="header-left">
      <div class="header-icon admin-icon-gradient-purple">
        <i data-lucide="bot" class="admin-text-primary"></i>
      </div>
      <div class="header-text">
        <h1>Agent Plugins</h1>
        <p>Create and manage AI agents</p>
      </div>
    </div>

    <div class="header-actions">
      <div class="admin-flex admin-flex-gap-sm">
        <%= link_to new_admin_agent_plugin_path, class: "admin-btn admin-btn-primary" do %>
          <i data-lucide="plus"></i>
          <span>Create Agent</span>
        <% end %>
        <%= link_to analytics_admin_agent_plugins_path, class: "admin-btn admin-btn-secondary" do %>
          <i data-lucide="bar-chart-3"></i>
          <span>Analytics</span>
        <% end %>
      </div>
    </div>
  </div>

  <!-- Help Section -->
  <div class="admin-card mb-4">
    <details>
      <summary class="admin-cursor-pointer admin-p-md admin-flex admin-items-center admin-flex-gap-sm admin-text-secondary">
        <i data-lucide="info" class="admin-icon-md"></i>
        <span class="admin-font-medium">How to create new Agents and Tools</span>
      </summary>
      <div class="admin-help-content admin-p-lg admin-border-t">
        <div class="admin-grid-2">
          <div>
            <h4 class="admin-text-primary admin-mb-sm">Create via Chat (Recommended)</h4>
            <p class="admin-text-secondary admin-text-sm admin-mb-md">
              You can ask Scout to create new agents and tools for you. This is the easiest way to get started.
            </p>
            <div class="admin-code-block admin-text-purple admin-text-sm">
              "Create a new SEO Audit agent that can check my website for common issues."
            </div>
            <div class="admin-code-block admin-text-purple admin-text-sm admin-mt-sm">
              "Create a tool called 'check_ssl' that verifies if a website has a valid certificate."
            </div>
          </div>
          <div>
            <h4 class="admin-text-primary admin-mb-sm">Advanced Configuration</h4>
            <p class="admin-text-secondary admin-text-sm admin-mb-md">
              Use the admin forms for full control over system prompts, capabilities, and tool assignments.
            </p>
            <ul class="admin-text-secondary admin-text-sm">
              <li>Define custom <strong>Capabilities</strong> (inputs/outputs JSON schema)</li>
              <li>Assign specialized <strong>Tools</strong> (ruby code or API calls)</li>
              <li>Set specific <strong>AI Models</strong> (Claude 3.5 Sonnet, Opus, etc.)</li>
            </ul>
          </div>
        </div>
      </div>
    </details>
  </div>

  <!-- Stats Cards -->
  <div class="admin-stats-grid admin-mb-xl">
    <div class="admin-card">
      <div class="admin-flex admin-items-center admin-flex-gap-md">
        <div class="admin-stat-icon purple-gradient">
          <i data-lucide="layers" class="admin-icon-lg admin-text-primary"></i>
        </div>
        <div>
          <p class="admin-stat-label">Total Agents</p>
          <h3 class="admin-stat-value"><%= @stats[:total] %></h3>
        </div>
      </div>
    </div>

    <div class="admin-card">
      <div class="admin-flex admin-items-center admin-flex-gap-md">
        <div class="admin-stat-icon success">
          <i data-lucide="check-circle" class="admin-icon-lg admin-text-success"></i>
        </div>
        <div>
          <p class="admin-stat-label">Active</p>
          <h3 class="admin-stat-value"><%= @stats[:active] %></h3>
        </div>
      </div>
    </div>

    <div class="admin-card">
      <div class="admin-flex admin-items-center admin-flex-gap-md">
        <div class="admin-stat-icon warning">
          <i data-lucide="file-text" class="admin-icon-lg admin-text-warning"></i>
        </div>
        <div>
          <p class="admin-stat-label">Draft</p>
          <h3 class="admin-stat-value"><%= @stats[:draft] %></h3>
        </div>
      </div>
    </div>

    <div class="admin-card">
      <div class="admin-flex admin-items-center admin-flex-gap-md">
        <div class="admin-stat-icon info">
          <i data-lucide="globe" class="admin-icon-lg admin-text-info"></i>
        </div>
        <div>
          <p class="admin-stat-label">System-Wide</p>
          <h3 class="admin-stat-value"><%= @stats[:system_wide] %></h3>
        </div>
      </div>
    </div>
  </div>

  <!-- Filters -->
  <div class="admin-card admin-mb-xl">
    <%= form_with url: admin_agent_plugins_path, method: :get, class: 'admin-filter-grid' do |f| %>
      <div>
        <label class="form-label admin-text-sm">Status</label>
        <%= f.select :status,
          options_for_select([
            ['All Statuses', 'all'],
            ['Active', 'active'],
            ['Draft', 'draft'],
            ['Deprecated', 'deprecated']
          ], @filter_status),
          {},
          class: 'admin-select admin-w-full' %>
      </div>

      <div>
        <label class="form-label admin-text-sm">Role</label>
        <%= f.select :role,
          options_for_select([
            ['All Roles', ''],
            ['Executor', 'executor'],
            ['Planner', 'planner'],
            ['Analyst', 'analyst'],
            ['Verifier', 'verifier'],
            ['Fixer', 'fixer'],
            ['Custom', 'custom']
          ], @filter_role),
          {},
          class: 'admin-select admin-w-full' %>
      </div>

      <div class="admin-flex-1">
        <label class="form-label admin-text-sm">Search</label>
        <%= f.text_field :search,
          value: @search,
          placeholder: 'Search agents...',
          class: 'admin-input admin-w-full' %>
      </div>

      <%= f.submit 'Filter', class: 'admin-btn admin-btn-primary admin-mb-0' %>
    <% end %>
  </div>

  <!-- Agent List -->
  <div class="admin-card">
    <div class="admin-table-container">
      <table class="admin-table">
        <thead>
          <tr>
            <th>Name</th>
            <th>Role</th>
            <th>Status</th>
            <th>Visibility</th>
            <th>Priority</th>
            <th>Capabilities</th>
            <th>Scope</th>
            <th>Last Active</th>
            <th>Actions</th>
          </tr>
        </thead>
      <tbody>
        <% if @agent_plugins.any? %>
          <% @agent_plugins.each do |agent| %>
            <tr>
              <td>
                <div class="admin-flex admin-items-center admin-flex-gap-sm">
                  <i data-lucide="bot" class="admin-icon-sm admin-icon-blue"></i>
                  <div>
                    <strong><%= link_to agent.name, admin_agent_plugin_path(agent), class: "admin-text-info" %></strong>
                    <div class="admin-text-muted admin-text-xs"><%= agent.slug %></div>
                  </div>
                </div>
              </td>
              <td>
                <span class="admin-badge admin-badge-secondary"><%= agent.role.titleize %></span>
              </td>
              <td>
                <span class="admin-badge <%= agent.status == 'active' ? 'admin-badge-online' : agent.status == 'draft' ? 'admin-badge-warning' : 'admin-badge-secondary' %>">
                  <%= agent.status.titleize %>
                </span>
              </td>
              <td>
                <% if agent.is_public? %>
                  <span class="badge bg-success" title="Published <%= time_ago_in_words(agent.published_at) if agent.published_at %> ago">Public</span>
                <% else %>
                  <span class="badge bg-secondary">Private</span>
                <% end %>
              </td>
              <td>
                <div class="admin-flex admin-items-center admin-flex-gap-sm admin-priority-bar">
                  <div class="progress flex-grow-1 admin-rounded-sm admin-progress-6 admin-progress-bg">
                    <div class="progress-bar admin-rounded-sm admin-progress-bar-blue" role="progressbar" style="width: <%= agent.priority %>%;"></div>
                  </div>
                  <small class="admin-text-secondary"><%= agent.priority %></small>
                </div>
              </td>
              <td>
                <span class="admin-badge admin-badge-info"><%= agent.agent_capabilities.count %> capabilities</span>
              </td>
              <td>
                <% if agent.system_wide? %>
                  <i data-lucide="globe" class="admin-icon-sm admin-text-info" title="System-wide"></i>
                <% else %>
                  <i data-lucide="building" class="admin-icon-sm admin-text-secondary" title="Entity-specific"></i>
                <% end %>
              </td>
              <td>
                <small class="admin-text-secondary">
                  <%= agent.last_activated_at ? time_ago_in_words(agent.last_activated_at) + ' ago' : 'Never' %>
                </small>
              </td>
              <td>
                <div class="admin-flex admin-flex-gap-xs">
                  <%= link_to admin_agent_plugin_path(agent), class: "admin-btn admin-btn-sm admin-btn-outline", title: "View" do %>
                    <i data-lucide="eye" class="admin-icon-sm"></i>
                  <% end %>
                  <%= link_to edit_admin_agent_plugin_path(agent), class: "admin-btn admin-btn-sm admin-btn-outline", title: "Edit" do %>
                    <i data-lucide="edit" class="admin-icon-sm"></i>
                  <% end %>
                  <%= button_to clone_admin_agent_plugin_path(agent), class: "admin-btn admin-btn-sm admin-btn-outline", title: "Clone", form: { class: "admin-inline-block" } do %>
                    <i data-lucide="copy" class="admin-icon-sm"></i>
                  <% end %>
                  <%= link_to test_admin_agent_plugin_path(agent), class: "admin-btn admin-btn-sm admin-btn-info-outline", title: "Test" do %>
                    <i data-lucide="play" class="admin-icon-sm"></i>
                  <% end %>
                </div>
              </td>
            </tr>
          <% end %>
        <% else %>
          <tr>
            <td colspan="9" class="admin-text-center admin-p-xl admin-text-muted">
              <div class="admin-mb-md admin-text-muted">
                <i data-lucide="inbox" class="admin-icon-3x"></i>
              </div>
              <p>No agent plugins found</p>
              <%= link_to "Create your first agent", new_admin_agent_plugin_path, class: "admin-btn admin-btn-primary admin-mt-md admin-inline-flex" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
    </div>
  </div>

  <!-- Pagination -->
  <% if @agent_plugins.any? %>
    <div class="admin-pagination">
      <%= paginate @agent_plugins %>
    </div>
  <% end %>
</div>

<script>
  document.addEventListener('turbo:load', () => {
    lucide.createIcons();
  });
</script>
