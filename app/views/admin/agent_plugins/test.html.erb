<div class="admin-p-xl">
  <div class="admin-page-header">
    <div class="header-left">
      <%= link_to admin_agent_plugin_path(@agent_plugin), class: "admin-btn admin-btn-sm admin-btn-outline admin-mr-lg" do %>
        <i data-lucide="arrow-left"></i>
      <% end %>
      <div class="header-icon">
        <i data-lucide="play"></i>
      </div>
      <div class="header-text">
        <h1>Test Agent Plugin</h1>
        <p><%= @agent_plugin.name %></p>
      </div>
    </div>
  </div>

  <div class="row">
    <!-- Left: Test Input -->
    <div class="col-md-6">
      <div class="admin-card">
        <div class="admin-card-header">
          <h3 class="admin-card-title">
            <i data-lucide="edit" class="icon-sm"></i>
            Test Configuration
          </h3>
        </div>
        <div class="admin-card-body">
          <form id="test-form">
            <div class="mb-3">
              <label class="form-label">AI Model</label>
              <select id="test-model" class="form-select">
                <option value="claude-opus-4-5">Claude Opus 4.5 (max reasoning)</option>
                <option value="claude-sonnet-4-5">Claude Sonnet 4.5 (balanced)</option>
                <option value="qwen-2-5-72b">Qwen 2.5 72B</option>
                <option value="qwen-2-5-coder-32b">Qwen 2.5 Coder</option>
                <option value="claude-haiku-4-5">Claude Haiku 4.5 (fast & cheap)</option>
                <option value="claude-opus-4-1">Claude Opus 4.1 (legacy)</option>
                <option value="claude-3-5-sonnet">Claude 3.5 Sonnet</option>
                <option value="claude-3-haiku">Claude 3 Haiku</option>
              </select>
              <small class="form-text text-muted">Override the agent's default model for this test</small>
            </div>

            <div class="mb-3">
              <label class="form-label">Test Method</label>
              <select id="test-method" class="form-select">
                <option value="run">Run with Prompt</option>
                <option value="execute_goal">Execute Goal</option>
              </select>
            </div>

            <div class="mb-3" id="prompt-input">
              <label class="form-label">Prompt</label>
              <textarea id="test-prompt" class="form-control font-monospace" rows="4" placeholder="Enter your test prompt..."><%= test_prompt_for_agent(@agent_plugin) %></textarea>
              <small class="form-text text-muted">A sample prompt for testing this agent</small>
            </div>

            <div class="mb-3 d-none" id="goal-input">
              <label class="form-label">Goal</label>
              <input type="text" id="test-goal" class="form-control" placeholder="<%= test_prompt_for_agent(@agent_plugin) %>">
            </div>

            <div class="mb-3">
              <label class="form-label">Context (JSON)</label>
              <textarea id="test-context" class="form-control font-monospace" rows="8"><%= JSON.pretty_generate(test_context_for_agent(@agent_plugin)) %></textarea>
              <small class="form-text text-muted">Additional context for the agent (customize as needed)</small>
            </div>

            <div class="d-grid">
              <button type="submit" class="btn btn-primary btn-lg">
                <i data-lucide="play" class="icon-sm"></i>
                Run Test
              </button>
            </div>
          </form>
        </div>
      </div>
    </div>

    <!-- Right: Test Output -->
    <div class="col-md-6">
      <div class="admin-card">
        <div class="admin-card-header">
          <h3 class="admin-card-title">
            <i data-lucide="terminal" class="icon-sm"></i>
            Test Results
          </h3>
        </div>
        <div class="admin-card-body">
          <div id="test-output" class="d-none">
            <div class="alert alert-info" id="loading-state">
              <div class="d-flex align-items-center gap-2">
                <div class="spinner-border spinner-border-sm" role="status"></div>
                <span>Running test...</span>
              </div>
            </div>

            <div id="success-state" class="d-none">
              <div class="alert alert-success">
                <i data-lucide="check-circle" class="icon-sm"></i>
                Test completed successfully!
              </div>
              <div class="mb-3">
                <label class="form-label small text-muted">Result:</label>
                <pre id="result-output" class="p-3 rounded font-monospace small admin-code-output"></pre>
              </div>
            </div>

            <div id="error-state" class="d-none">
              <div class="alert alert-danger">
                <i data-lucide="alert-circle" class="icon-sm"></i>
                Test failed
              </div>
              <div class="mb-3">
                <label class="form-label small text-muted">Error:</label>
                <pre id="error-output" class="p-3 rounded font-monospace small admin-code-output-error"></pre>
              </div>
            </div>
          </div>

          <div id="initial-state">
            <div class="text-center text-muted py-5">
              <i data-lucide="flask" class="admin-icon-4x mb-3 d-block mx-auto"></i>
              <p>Configure your test and click "Run Test" to see results</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Agent Info -->
      <div class="admin-card mt-4">
        <div class="admin-card-header">
          <h3 class="admin-card-title">
            <i data-lucide="info" class="icon-sm"></i>
            Agent Information
          </h3>
        </div>
        <div class="admin-card-body">
          <dl class="row mb-0">
            <dt class="col-sm-4">Role</dt>
            <dd class="col-sm-8"><span class="badge bg-secondary"><%= @agent_plugin.role.titleize %></span></dd>

            <dt class="col-sm-4">Status</dt>
            <dd class="col-sm-8">
              <span class="badge bg-<%= @agent_plugin.status == 'active' ? 'success' : 'warning' %>">
                <%= @agent_plugin.status.titleize %>
              </span>
            </dd>

            <dt class="col-sm-4">Capabilities</dt>
            <dd class="col-sm-8">
              <% @agent_plugin.agent_capabilities.each do |cap| %>
                <code class="small d-block"><%= cap.capability_name %></code>
              <% end %>
            </dd>

            <dt class="col-sm-4">Required Tools</dt>
            <dd class="col-sm-8">
              <% @agent_plugin.agent_tools.required.each do |tool| %>
                <code class="small d-block"><%= tool.tool_name %></code>
              <% end %>
            </dd>
          </dl>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  document.addEventListener('turbo:load', () => {
    lucide.createIcons();

    // Toggle between prompt and goal inputs
    document.getElementById('test-method')?.addEventListener('change', function(e) {
      const promptInput = document.getElementById('prompt-input');
      const goalInput = document.getElementById('goal-input');

      if (e.target.value === 'execute_goal') {
        promptInput.style.display = 'none';
        goalInput.style.display = 'block';
      } else {
        promptInput.style.display = 'block';
        goalInput.style.display = 'none';
      }
    });

    // Handle test form submission
    document.getElementById('test-form')?.addEventListener('submit', async function(e) {
      e.preventDefault();

      const testOutput = document.getElementById('test-output');
      const initialState = document.getElementById('initial-state');
      const loadingState = document.getElementById('loading-state');
      const successState = document.getElementById('success-state');
      const errorState = document.getElementById('error-state');

      // Show loading
      initialState.classList.add('d-none');
      testOutput.classList.remove('d-none');
      loadingState.classList.remove('d-none');
      successState.classList.add('d-none');
      errorState.classList.add('d-none');

      const testModel = document.getElementById('test-model').value;
      const testMethod = document.getElementById('test-method').value;
      const testPrompt = document.getElementById('test-prompt').value;
      const testGoal = document.getElementById('test-goal').value;
      const testContext = document.getElementById('test-context').value;

      try {
        const formData = new FormData();
        formData.append('test_model', testModel);
        formData.append('test_method', testMethod);
        formData.append('test_prompt', testPrompt);
        formData.append('test_goal', testGoal);
        formData.append('test_context', testContext);

        const csrfToken = document.querySelector('meta[name="csrf-token"]')?.content || '';

        const response = await fetch('<%= run_test_admin_agent_plugin_path(@agent_plugin) %>', {
          method: 'POST',
          body: formData,
          headers: {
            'X-CSRF-Token': csrfToken
          }
        });

        const result = await response.json();

        loadingState.classList.add('d-none');

        if (result.success) {
          successState.classList.remove('d-none');
          // Display the result as plain text if it's a string, or formatted JSON if it's an object
          let displayText = '';
          if (typeof result.result === 'string') {
            displayText = result.result;
          } else {
            displayText = JSON.stringify(result.result, null, 2);
          }
          document.getElementById('result-output').textContent = displayText;
        } else {
          errorState.classList.remove('d-none');
          document.getElementById('error-output').textContent = result.error + '\n\nBacktrace:\n' + (result.backtrace || []).join('\n');
        }

        lucide.createIcons();
      } catch (error) {
        loadingState.classList.add('d-none');
        errorState.classList.remove('d-none');
        document.getElementById('error-output').textContent = 'Network error: ' + error.message;
        lucide.createIcons();
      }
    });
  });
</script>
