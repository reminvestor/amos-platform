<div class="admin-p-xl">
  <div class="admin-page-header admin-mb-xl">
    <div class="header-left">
      <%= link_to admin_agent_plugin_path(@agent_plugin), class: "admin-btn admin-btn-sm admin-btn-outline admin-mr-lg" do %>
        <i data-lucide="arrow-left"></i>
      <% end %>
      <div class="header-icon admin-icon-gradient-purple">
        <i data-lucide="play" class="admin-text-primary"></i>
      </div>
      <div class="header-text">
        <h1>Test Agent Plugin</h1>
        <p><%= @agent_plugin.name %></p>
      </div>
    </div>
  </div>

  <div class="row">
    <!-- Left: Test Input -->
    <div class="col-md-6">
      <div class="admin-card">
        <h3 class="card-title m-0 admin-mb-lg">
          <i data-lucide="edit" class="admin-icon-md d-inline-block align-middle me-2"></i>
          Test Configuration
        </h3>
        <form id="test-form">
          <div class="admin-mb-md">
            <label class="form-label admin-text-primary">AI Model</label>
            <select id="test-model" class="admin-select">
              <option value="claude-opus-4-6">Claude Opus 4.6 (max reasoning)</option>
              <option value="claude-sonnet-4-6">Claude Sonnet 4.6 (balanced)</option>
              <option value="qwen-2-5-72b">Qwen 2.5 72B</option>
              <option value="qwen-2-5-coder-32b">Qwen 2.5 Coder</option>
              <option value="claude-haiku-4-5">Claude Haiku 4.5 (fast & cheap)</option>
            </select>
            <small class="admin-text-muted admin-text-sm">Override the agent's default model for this test</small>
          </div>

          <div class="admin-mb-md">
            <label class="form-label admin-text-primary">Test Method</label>
            <select id="test-method" class="admin-select">
              <option value="run">Run with Prompt</option>
              <option value="execute_goal">Execute Goal</option>
            </select>
          </div>

          <div class="admin-mb-md" id="prompt-input">
            <label class="form-label admin-text-primary">Prompt</label>
            <textarea id="test-prompt" class="admin-input admin-font-mono" rows="4" placeholder="Enter your test prompt..."><%= test_prompt_for_agent(@agent_plugin) %></textarea>
            <small class="admin-text-muted admin-text-sm">A sample prompt for testing this agent</small>
          </div>

          <div class="admin-mb-md d-none" id="goal-input">
            <label class="form-label admin-text-primary">Goal</label>
            <input type="text" id="test-goal" class="admin-input" placeholder="<%= test_prompt_for_agent(@agent_plugin) %>">
          </div>

          <div class="admin-mb-md">
            <label class="form-label admin-text-primary">Context (JSON)</label>
            <textarea id="test-context" class="admin-input admin-font-mono" rows="8"><%= JSON.pretty_generate(test_context_for_agent(@agent_plugin)) %></textarea>
            <small class="admin-text-muted admin-text-sm">Additional context for the agent (customize as needed)</small>
          </div>

          <button type="submit" class="admin-btn admin-btn-primary admin-btn-lg admin-w-full">
            <i data-lucide="play"></i>
            <span>Run Test</span>
          </button>
        </form>
      </div>
    </div>

    <!-- Right: Test Output -->
    <div class="col-md-6">
      <div class="admin-card admin-mb-lg">
        <h3 class="card-title m-0 admin-mb-lg">
          <i data-lucide="terminal" class="admin-icon-md d-inline-block align-middle me-2"></i>
          Test Results
        </h3>
        <div id="test-output" class="d-none">
          <div class="admin-p-md admin-rounded-md admin-mb-md" id="loading-state" style="background: var(--status-info-bg); border: 1px solid var(--status-info-text);">
            <div class="admin-flex admin-items-center admin-flex-gap-sm">
              <div class="spinner-border spinner-border-sm admin-text-info" role="status"></div>
              <span class="admin-text-info">Running test...</span>
            </div>
          </div>

          <div id="success-state" class="d-none">
            <div class="admin-p-md admin-rounded-md admin-mb-md" style="background: var(--status-success-bg); border: 1px solid var(--status-success-text);">
              <div class="admin-flex admin-items-center admin-flex-gap-sm">
                <i data-lucide="check-circle" class="admin-text-success"></i>
                <span class="admin-text-success">Test completed successfully!</span>
              </div>
            </div>
            <div class="admin-mb-md">
              <label class="form-label admin-text-muted admin-text-sm">Result:</label>
              <pre id="result-output" class="admin-p-md admin-rounded-md admin-font-mono admin-text-sm" style="background: var(--bg-tertiary); overflow: auto; max-height: 400px;"></pre>
            </div>
          </div>

          <div id="error-state" class="d-none">
            <div class="admin-p-md admin-rounded-md admin-mb-md" style="background: var(--status-danger-bg); border: 1px solid var(--status-danger-text);">
              <div class="admin-flex admin-items-center admin-flex-gap-sm">
                <i data-lucide="alert-circle" class="admin-text-danger"></i>
                <span class="admin-text-danger">Test failed</span>
              </div>
            </div>
            <div class="admin-mb-md">
              <label class="form-label admin-text-muted admin-text-sm">Error:</label>
              <pre id="error-output" class="admin-p-md admin-rounded-md admin-font-mono admin-text-sm" style="background: var(--status-danger-bg); overflow: auto; max-height: 400px;"></pre>
            </div>
          </div>
        </div>

        <div id="initial-state">
          <div class="admin-text-center admin-text-muted admin-p-xl">
            <i data-lucide="flask" class="admin-icon-xl admin-mb-md d-block mx-auto"></i>
            <p>Configure your test and click "Run Test" to see results</p>
          </div>
        </div>
      </div>

      <!-- Agent Info -->
      <div class="admin-card">
        <h3 class="card-title m-0 admin-mb-lg">
          <i data-lucide="info" class="admin-icon-md d-inline-block align-middle me-2"></i>
          Agent Information
        </h3>
        <div class="admin-detail-list">
          <div class="detail-item">
            <span class="admin-text-secondary">Role</span>
            <span class="admin-badge admin-badge-secondary"><%= @agent_plugin.role.titleize %></span>
          </div>
          <div class="detail-item">
            <span class="admin-text-secondary">Status</span>
            <span class="admin-badge <%= @agent_plugin.status == 'active' ? 'admin-badge-success' : 'admin-badge-warning' %>">
              <%= @agent_plugin.status.titleize %>
            </span>
          </div>
          <div class="detail-item admin-flex-col">
            <span class="admin-text-secondary admin-mb-xs">Capabilities</span>
            <div>
              <% @agent_plugin.agent_capabilities.each do |cap| %>
                <code class="admin-text-cyan admin-text-sm d-block"><%= cap.capability_name %></code>
              <% end %>
            </div>
          </div>
          <div class="detail-item admin-flex-col">
            <span class="admin-text-secondary admin-mb-xs">Required Tools</span>
            <div>
              <% @agent_plugin.agent_tools.required.each do |tool| %>
                <code class="admin-text-cyan admin-text-sm d-block"><%= tool.tool_name %></code>
              <% end %>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  document.addEventListener('turbo:load', () => {
    if (typeof lucide !== 'undefined') {
      lucide.createIcons();
    }

    // Toggle between prompt and goal inputs
    document.getElementById('test-method')?.addEventListener('change', function(e) {
      const promptInput = document.getElementById('prompt-input');
      const goalInput = document.getElementById('goal-input');

      if (e.target.value === 'execute_goal') {
        promptInput.style.display = 'none';
        goalInput.style.display = 'block';
      } else {
        promptInput.style.display = 'block';
        goalInput.style.display = 'none';
      }
    });

    // Handle test form submission
    document.getElementById('test-form')?.addEventListener('submit', async function(e) {
      e.preventDefault();

      const testOutput = document.getElementById('test-output');
      const initialState = document.getElementById('initial-state');
      const loadingState = document.getElementById('loading-state');
      const successState = document.getElementById('success-state');
      const errorState = document.getElementById('error-state');

      // Show loading
      initialState.classList.add('d-none');
      testOutput.classList.remove('d-none');
      loadingState.classList.remove('d-none');
      successState.classList.add('d-none');
      errorState.classList.add('d-none');

      const testModel = document.getElementById('test-model').value;
      const testMethod = document.getElementById('test-method').value;
      const testPrompt = document.getElementById('test-prompt').value;
      const testGoal = document.getElementById('test-goal').value;
      const testContext = document.getElementById('test-context').value;

      try {
        const formData = new FormData();
        formData.append('test_model', testModel);
        formData.append('test_method', testMethod);
        formData.append('test_prompt', testPrompt);
        formData.append('test_goal', testGoal);
        formData.append('test_context', testContext);

        const csrfToken = document.querySelector('meta[name="csrf-token"]')?.content || '';

        const response = await fetch('<%= run_test_admin_agent_plugin_path(@agent_plugin) %>', {
          method: 'POST',
          body: formData,
          headers: {
            'X-CSRF-Token': csrfToken
          }
        });

        const result = await response.json();

        loadingState.classList.add('d-none');

        if (result.success) {
          successState.classList.remove('d-none');
          let displayText = '';
          if (typeof result.result === 'string') {
            displayText = result.result;
          } else {
            displayText = JSON.stringify(result.result, null, 2);
          }
          document.getElementById('result-output').textContent = displayText;
        } else {
          errorState.classList.remove('d-none');
          document.getElementById('error-output').textContent = result.error + '\n\nBacktrace:\n' + (result.backtrace || []).join('\n');
        }

        if (typeof lucide !== 'undefined') {
          lucide.createIcons();
        }
      } catch (error) {
        loadingState.classList.add('d-none');
        errorState.classList.remove('d-none');
        document.getElementById('error-output').textContent = 'Network error: ' + error.message;
        if (typeof lucide !== 'undefined') {
          lucide.createIcons();
        }
      }
    });
  });
</script>
