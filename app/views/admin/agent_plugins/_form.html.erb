<%= form_with(model: [:admin, agent_plugin], class: "admin-form") do |f| %>
  <% if agent_plugin.errors.any? %>
    <div class="alert alert-danger">
      <h5><i data-lucide="alert-circle" class="icon-sm"></i> <%= pluralize(agent_plugin.errors.count, "error") %> prohibited this agent from being saved:</h5>
      <ul class="mb-0">
        <% agent_plugin.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="row">
    <!-- Left Column: Basic Info -->
    <div class="col-md-6">
      <div class="admin-card mb-4">
        <div class="admin-card-header">
          <h3 class="admin-card-title">
            <i data-lucide="info" class="icon-sm"></i>
            Basic Information
          </h3>
        </div>
        <div class="admin-card-body">
          <div class="mb-3">
            <%= f.label :name, class: "form-label" %>
            <%= f.text_field :name, class: "form-control", placeholder: "Sales Email Generator", required: true %>
            <small class="form-text text-muted">Human-readable name for the agent</small>
          </div>

          <div class="mb-3">
            <%= f.label :slug, class: "form-label" %>
            <%= f.text_field :slug, class: "form-control", placeholder: "sales_email_generator" %>
            <small class="form-text text-muted">Unique identifier (auto-generated if blank)</small>
          </div>

          <div class="mb-3">
            <%= f.label :description, class: "form-label" %>
            <%= f.text_area :description, class: "form-control", rows: 3, placeholder: "Describe what this agent does..." %>
          </div>

          <div class="mb-3">
            <%= f.label :status, class: "form-label" %>
            <%= f.select :status,
              options_for_select([
                ['Draft', 'draft'],
                ['Active', 'active'],
                ['Deprecated', 'deprecated']
              ], agent_plugin.status),
              {},
              class: 'form-select' %>
            <small class="form-text text-muted">Draft = testing only, Active = available for workflows, Deprecated = archived</small>
          </div>

          <div class="alert alert-info mb-3">
            <i data-lucide="sparkles" class="icon-sm"></i>
            <strong>Smart Agent Selection:</strong> Scout and Agent Lightning RL will automatically learn which agents work best for different tasks over time. You just need to define what the agent does!
          </div>

          <!-- Advanced Settings -->
          <details class="mb-3">
            <summary class="form-label" style="cursor: pointer; user-select: none;">
              <i data-lucide="settings" class="icon-sm"></i>
              Advanced Settings (Optional)
            </summary>
            <div class="mt-2 p-3 border rounded bg-light">
              <div class="row">
                <div class="col-md-6 mb-3">
                  <%= f.label :role, class: "form-label small" %>
                  <%= f.select :role,
                    options_for_select([
                      ['Executor (default)', 'executor'],
                      ['Planner', 'planner'],
                      ['Analyst', 'analyst'],
                      ['Verifier', 'verifier'],
                      ['Fixer', 'fixer'],
                      ['Custom', 'custom']
                    ], agent_plugin.role || 'executor'),
                    {},
                    class: 'form-select' %>
                  <small class="form-text text-muted">Agent Lightning will learn the optimal role</small>
                </div>

                <div class="col-md-6 mb-3">
                  <%= f.label :priority, class: "form-label small" %>
                  <%= f.number_field :priority, class: "form-control", min: 0, max: 100, value: agent_plugin.priority || 50 %>
                  <small class="form-text text-muted">Initial hint (0-100), RL will optimize</small>
                </div>
              </div>

              <div class="mb-3">
                <%= f.label :version, class: "form-label small" %>
                <%= f.text_field :version, class: "form-control", placeholder: "1.0.0" %>
                <small class="form-text text-muted">Semantic versioning (X.Y.Z)</small>
              </div>

              <div class="mb-0">
                <%= f.label :agent_class, "Custom Ruby Class", class: "form-label small" %>
                <%= f.text_field :agent_class, class: "form-control", placeholder: "Leave blank for standard execution" %>
                <small class="form-text text-muted">
                  For developers only: Full Ruby class path (e.g., Agents::Specialized::ExecutorAgent).
                  <strong>Leave blank to use standard executor.</strong>
                </small>
              </div>
            </div>
          </details>
        </div>
      </div>

      <!-- System Prompt -->
      <div class="admin-card mb-4">
        <div class="admin-card-header">
          <h3 class="admin-card-title">
            <i data-lucide="message-square" class="icon-sm"></i>
            System Prompt
          </h3>
        </div>
        <div class="admin-card-body">
          <div class="mb-3">
            <%= f.text_area :system_prompt,
              value: agent_plugin.system_prompt.is_a?(Hash) ? agent_plugin.system_prompt['prompt'] : agent_plugin.system_prompt,
              class: "form-control font-monospace",
              rows: 8,
              placeholder: "You are a sales email specialist. Generate compelling, personalized emails..." %>
            <small class="form-text text-muted">AI instructions for this agent</small>
          </div>
        </div>
      </div>

      <!-- Configuration -->
      <div class="admin-card mb-4">
        <div class="admin-card-header">
          <h3 class="admin-card-title">
            <i data-lucide="settings" class="icon-sm"></i>
            Configuration (JSON)
          </h3>
        </div>
        <div class="admin-card-body">
          <div class="mb-3">
            <%= f.text_area :configuration,
              value: agent_plugin.configuration.present? ? JSON.pretty_generate(agent_plugin.configuration) : '{}',
              class: "form-control font-monospace",
              rows: 6,
              placeholder: '{ "max_length": 150, "tone": "professional" }' %>
            <small class="form-text text-muted">Custom configuration as JSON</small>
          </div>
        </div>
      </div>
    </div>

    <!-- Right Column: Capabilities & Tools -->
    <div class="col-md-6">
      <!-- Capabilities -->
      <div class="admin-card mb-4">
        <div class="admin-card-header">
          <h3 class="admin-card-title">
            <i data-lucide="zap" class="icon-sm"></i>
            Capabilities
          </h3>
        </div>
        <div class="admin-card-body">
          <div class="alert alert-info mb-3">
            <strong>What are capabilities?</strong> Capabilities define what this agent can do (e.g., "email_generation", "content_analysis"). Scout uses capabilities to find the right agent for each task.
          </div>
          <div id="capabilities-container">
            <%= f.fields_for :agent_capabilities do |capability_form| %>
              <div class="capability-field mb-4 p-3 border rounded">
                <%= capability_form.hidden_field :_destroy %>

                <div class="d-flex justify-content-between align-items-center mb-2">
                  <h6 class="mb-0">Capability</h6>
                  <%= link_to "#", class: "btn btn-sm btn-outline-danger remove-capability" do %>
                    <i data-lucide="trash-2" class="icon-sm"></i>
                  <% end %>
                </div>

                <div class="mb-2">
                  <%= capability_form.label :capability_name, "Name", class: "form-label small" %>
                  <%= capability_form.text_field :capability_name, class: "form-control form-control-sm", placeholder: "email_generation" %>
                </div>

                <div class="mb-2">
                  <%= capability_form.label :contract_schema, "Contract Schema (JSON)", class: "form-label small" %>
                  <%= capability_form.text_area :contract_schema,
                    value: (capability_form.object&.contract_schema.present? ? JSON.pretty_generate(capability_form.object.contract_schema) : '{"inputs": [], "outputs": []}'),
                    class: "form-control form-control-sm font-monospace",
                    rows: 4 %>
                </div>

                <div class="mb-0">
                  <%= capability_form.label :implementation_notes, "Notes", class: "form-label small" %>
                  <%= capability_form.text_area :implementation_notes, class: "form-control form-control-sm", rows: 2 %>
                </div>
              </div>
            <% end %>
          </div>

          <button type="button" class="btn btn-sm btn-outline-primary" id="add-capability">
            <i data-lucide="plus" class="icon-sm"></i>
            Add Capability
          </button>
        </div>
      </div>

      <!-- Tools -->
      <div class="admin-card mb-4">
        <div class="admin-card-header">
          <h3 class="admin-card-title">
            <i data-lucide="wrench" class="icon-sm"></i>
            Tools
          </h3>
        </div>
        <div class="admin-card-body">
          <div class="alert alert-info mb-3">
            <strong>What are tools?</strong> Tools are actions your agent can take (e.g., send emails, fetch data, create campaigns). Select which tools this agent needs.
            <a href="#" class="text-decoration-none" data-bs-toggle="modal" data-bs-target="#availableToolsModal">
              <i data-lucide="help-circle" class="icon-sm"></i> Browse all available tools
            </a>
          </div>

          <div id="tools-container">
            <%= f.fields_for :agent_tools do |tool_form| %>
              <div class="tool-field mb-3 p-2 border rounded">
                <%= tool_form.hidden_field :_destroy %>

                <div class="row align-items-center">
                  <div class="col-md-7">
                    <%= tool_form.text_field :tool_name, class: "form-control form-control-sm", placeholder: "get_data" %>
                  </div>
                  <div class="col-md-3">
                    <div class="form-check">
                      <%= tool_form.check_box :required, class: "form-check-input" %>
                      <%= tool_form.label :required, "Required", class: "form-check-label small" %>
                    </div>
                  </div>
                  <div class="col-md-2 text-end">
                    <%= link_to "#", class: "btn btn-sm btn-outline-danger remove-tool" do %>
                      <i data-lucide="x" class="icon-sm"></i>
                    <% end %>
                  </div>
                </div>
              </div>
            <% end %>
          </div>

          <button type="button" class="btn btn-sm btn-outline-primary" id="add-tool">
            <i data-lucide="plus" class="icon-sm"></i>
            Add Tool
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- Available Tools Modal -->
  <div class="modal fade" id="availableToolsModal" tabindex="-1" aria-labelledby="availableToolsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title" id="availableToolsModalLabel">
            <i data-lucide="wrench" class="icon-sm"></i>
            Available Tools
          </h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
          <div class="mb-3">
            <input type="text" id="tool-search" class="form-control" placeholder="Search tools...">
          </div>
          <div id="tools-list" class="list-group">
            <% Tools::ToolCatalog.instance.all_tools.each do |tool_name, tool_class| %>
              <% definition = tool_class.definition %>
              <div class="list-group-item list-group-item-action tool-item" data-tool-name="<%= tool_name %>" style="cursor: pointer;">
                <div class="d-flex justify-content-between align-items-start">
                  <div>
                    <h6 class="mb-1"><code><%= tool_name %></code></h6>
                    <p class="mb-1 small"><%= definition[:description] %></p>
                    <% if definition[:parameters][:properties] %>
                      <small class="text-muted">
                        Parameters: <%= definition[:parameters][:properties].keys.join(', ') %>
                      </small>
                    <% end %>
                  </div>
                  <button type="button" class="btn btn-sm btn-outline-primary add-this-tool">
                    <i data-lucide="plus" class="icon-sm"></i>
                  </button>
                </div>
              </div>
            <% end %>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
        </div>
      </div>
    </div>
  </div>

  <!-- Form Actions -->
  <div class="admin-card-footer sticky-bottom bg-white border-top py-3">
    <div class="d-flex justify-content-between align-items-center">
      <div>
        <%= link_to "Cancel", agent_plugin.persisted? ? admin_agent_plugin_path(agent_plugin) : admin_agent_plugins_path, class: "btn btn-secondary" %>
      </div>
      <div class="d-flex gap-2">
        <% if agent_plugin.persisted? %>
          <%= f.submit "Save as Draft", name: "draft", class: "btn btn-outline-primary", formnovalidate: true %>
        <% end %>
        <%= f.submit agent_plugin.persisted? ? "Update Agent" : "Create Agent", class: "btn btn-primary" %>
      </div>
    </div>
  </div>
<% end %>

<script>
  document.addEventListener('turbo:load', () => {
    lucide.createIcons();

    // Add capability
    document.getElementById('add-capability')?.addEventListener('click', function() {
      const container = document.getElementById('capabilities-container');
      const time = new Date().getTime();
      const template = `
        <div class="capability-field mb-4 p-3 border rounded">
          <input type="hidden" name="agent_plugin[agent_capabilities_attributes][${time}][_destroy]" value="false">

          <div class="d-flex justify-content-between align-items-center mb-2">
            <h6 class="mb-0">Capability</h6>
            <a href="#" class="btn btn-sm btn-outline-danger remove-capability">
              <i data-lucide="trash-2" class="icon-sm"></i>
            </a>
          </div>

          <div class="mb-2">
            <label class="form-label small">Name</label>
            <input type="text" name="agent_plugin[agent_capabilities_attributes][${time}][capability_name]" class="form-control form-control-sm" placeholder="email_generation">
          </div>

          <div class="mb-2">
            <label class="form-label small">Contract Schema (JSON)</label>
            <textarea name="agent_plugin[agent_capabilities_attributes][${time}][contract_schema]" class="form-control form-control-sm font-monospace" rows="4">{"inputs": [], "outputs": []}</textarea>
          </div>

          <div class="mb-0">
            <label class="form-label small">Notes</label>
            <textarea name="agent_plugin[agent_capabilities_attributes][${time}][implementation_notes]" class="form-control form-control-sm" rows="2"></textarea>
          </div>
        </div>
      `;
      container.insertAdjacentHTML('beforeend', template);
      lucide.createIcons();
    });

    // Add tool
    document.getElementById('add-tool')?.addEventListener('click', function() {
      const container = document.getElementById('tools-container');
      const time = new Date().getTime();
      const template = `
        <div class="tool-field mb-3 p-2 border rounded">
          <input type="hidden" name="agent_plugin[agent_tools_attributes][${time}][_destroy]" value="false">

          <div class="row align-items-center">
            <div class="col-md-7">
              <input type="text" name="agent_plugin[agent_tools_attributes][${time}][tool_name]" class="form-control form-control-sm" placeholder="get_data">
            </div>
            <div class="col-md-3">
              <div class="form-check">
                <input type="checkbox" name="agent_plugin[agent_tools_attributes][${time}][required]" class="form-check-input" value="1">
                <label class="form-check-label small">Required</label>
              </div>
            </div>
            <div class="col-md-2 text-end">
              <a href="#" class="btn btn-sm btn-outline-danger remove-tool">
                <i data-lucide="x" class="icon-sm"></i>
              </a>
            </div>
          </div>
        </div>
      `;
      container.insertAdjacentHTML('beforeend', template);
      lucide.createIcons();
    });

    // Remove capability/tool
    document.addEventListener('click', function(e) {
      if (e.target.closest('.remove-capability')) {
        e.preventDefault();
        const field = e.target.closest('.capability-field');
        const destroyInput = field.querySelector('input[name*="_destroy"]');
        if (destroyInput) {
          destroyInput.value = '1';
          field.style.display = 'none';
        } else {
          field.remove();
        }
      }

      if (e.target.closest('.remove-tool')) {
        e.preventDefault();
        const field = e.target.closest('.tool-field');
        const destroyInput = field.querySelector('input[name*="_destroy"]');
        if (destroyInput) {
          destroyInput.value = '1';
          field.style.display = 'none';
        } else {
          field.remove();
        }
      }

      // Add tool from modal
      if (e.target.closest('.add-this-tool')) {
        e.preventDefault();
        const toolItem = e.target.closest('.tool-item');
        const toolName = toolItem.dataset.toolName;

        // Add tool to form
        const container = document.getElementById('tools-container');
        const time = new Date().getTime();
        const template = `
          <div class="tool-field mb-3 p-2 border rounded">
            <input type="hidden" name="agent_plugin[agent_tools_attributes][${time}][_destroy]" value="false">

            <div class="row align-items-center">
              <div class="col-md-7">
                <input type="text" name="agent_plugin[agent_tools_attributes][${time}][tool_name]" class="form-control form-control-sm" value="${toolName}" readonly>
              </div>
              <div class="col-md-3">
                <div class="form-check">
                  <input type="checkbox" name="agent_plugin[agent_tools_attributes][${time}][required]" class="form-check-input" value="1" checked>
                  <label class="form-check-label small">Required</label>
                </div>
              </div>
              <div class="col-md-2 text-end">
                <a href="#" class="btn btn-sm btn-outline-danger remove-tool">
                  <i data-lucide="x" class="icon-sm"></i>
                </a>
              </div>
            </div>
          </div>
        `;
        container.insertAdjacentHTML('beforeend', template);
        lucide.createIcons();

        // Close modal
        const modal = bootstrap.Modal.getInstance(document.getElementById('availableToolsModal'));
        if (modal) modal.hide();
      }
    });

    // Tool search functionality
    document.getElementById('tool-search')?.addEventListener('input', function(e) {
      const searchTerm = e.target.value.toLowerCase();
      const toolItems = document.querySelectorAll('.tool-item');

      toolItems.forEach(item => {
        const toolName = item.dataset.toolName.toLowerCase();
        const description = item.querySelector('p').textContent.toLowerCase();
        const matches = toolName.includes(searchTerm) || description.includes(searchTerm);
        item.style.display = matches ? '' : 'none';
      });
    });

    // Refresh lucide icons when modal opens
    document.getElementById('availableToolsModal')?.addEventListener('shown.bs.modal', function() {
      lucide.createIcons();
    });
  });
</script>
