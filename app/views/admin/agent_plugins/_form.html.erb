<%= form_with(model: [:admin, agent_plugin], class: "admin-form") do |f| %>
  <% if agent_plugin.errors.any? %>
    <div class="alert alert-danger">
      <h5><i data-lucide="alert-circle" class="icon-sm"></i> <%= pluralize(agent_plugin.errors.count, "error") %> prohibited this agent from being saved:</h5>
      <ul class="mb-0">
        <% agent_plugin.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <!-- Preset Agent Templates -->
  <% if agent_plugin.new_record? %>
    <div class="admin-card admin-card-gradient-purple mb-4">
      <div class="admin-card-body">
        <div class="d-flex align-items-center gap-2 mb-3">
          <i data-lucide="sparkles" class="icon-sm text-primary"></i>
          <h5 class="mb-0 fw-bold">Quick Start with Templates</h5>
        </div>
        <p class="text-muted small mb-3">Start with a pre-configured agent template or build from scratch</p>

        <div class="row g-3">
          <div class="col-md-6 col-lg-3">
            <button type="button" class="btn btn-outline-primary w-100 text-start preset-template"
              data-template="email_marketing"
              data-name="Email Marketing Agent"
              data-description="Generates personalized marketing emails and manages campaigns"
              data-capabilities='["email_generation", "content_analysis"]'
              data-tools='["get_data", "create_object", "list_connections"]'>
              <i data-lucide="mail" class="icon-sm mb-2"></i>
              <div class="fw-semibold">Email Marketing</div>
              <small class="text-muted">Campaigns & outreach</small>
            </button>
          </div>

          <div class="col-md-6 col-lg-3">
            <button type="button" class="btn btn-outline-primary w-100 text-start preset-template"
              data-template="content_creator"
              data-name="Content Creator Agent"
              data-description="Creates landing pages, analyzes content, and manages web presence"
              data-capabilities='["content_analysis", "report_generation"]'
              data-tools='["web_search_tool", "generate_landing_page", "get_data"]'>
              <i data-lucide="file-text" class="icon-sm mb-2"></i>
              <div class="fw-semibold">Content Creator</div>
              <small class="text-muted">Pages & content</small>
            </button>
          </div>

          <div class="col-md-6 col-lg-3">
            <button type="button" class="btn btn-outline-primary w-100 text-start preset-template"
              data-template="data_analyst"
              data-name="Data Analyst Agent"
              data-description="Analyzes data, generates reports, and creates visualizations"
              data-capabilities='["data_extraction", "report_generation"]'
              data-tools='["get_data", "query_metric", "create_dynamic_visualization"]'>
              <i data-lucide="bar-chart" class="icon-sm mb-2"></i>
              <div class="fw-semibold">Data Analyst</div>
              <small class="text-muted">Reports & insights</small>
            </button>
          </div>

          <div class="col-md-6 col-lg-3">
            <button type="button" class="btn btn-outline-primary w-100 text-start preset-template"
              data-template="integration_specialist"
              data-name="Integration Specialist Agent"
              data-description="Manages integrations and orchestrates cross-platform workflows"
              data-capabilities='["data_extraction", "customer_outreach"]'
              data-tools='["list_connections", "list_operations", "invoke_operation", "get_data"]'>
              <i data-lucide="plug" class="icon-sm mb-2"></i>
              <div class="fw-semibold">Integration Specialist</div>
              <small class="text-muted">APIs & workflows</small>
            </button>
          </div>
        </div>
      </div>
    </div>
  <% end %>

  <!-- Status Toggle -->
  <div class="admin-card mb-4">
    <div class="admin-card-body">
      <div class="d-flex align-items-center justify-content-between">
        <div>
          <h5 class="mb-1 fw-bold">Agent Status</h5>
          <p class="text-muted small mb-0">
            <span id="status-description">
              <% case agent_plugin.status %>
              <% when 'active' %>
                <i data-lucide="check-circle" class="admin-icon-sm text-success"></i>
                Agent is active and available for workflows
              <% when 'draft' %>
                <i data-lucide="edit" class="admin-icon-sm text-warning"></i>
                Agent is in draft mode for testing only
              <% when 'deprecated' %>
                <i data-lucide="archive" class="admin-icon-sm text-secondary"></i>
                Agent is deprecated and archived
              <% end %>
            </span>
          </p>
        </div>
        <div class="d-flex align-items-center gap-3">
          <%= f.hidden_field :status, id: 'status-hidden-field', value: agent_plugin.status || 'draft' %>

          <!-- Status Toggle Buttons -->
          <div class="btn-group" role="group" aria-label="Agent status toggle">
            <input type="radio" class="btn-check" name="status_toggle" id="status-draft" value="draft" <%= 'checked' if agent_plugin.status == 'draft' %> autocomplete="off">
            <label class="btn btn-outline-warning" for="status-draft">
              <i data-lucide="edit" class="admin-icon-sm"></i>
              Draft
            </label>

            <input type="radio" class="btn-check" name="status_toggle" id="status-active" value="active" <%= 'checked' if agent_plugin.status == 'active' %> autocomplete="off">
            <label class="btn btn-outline-success" for="status-active">
              <i data-lucide="check-circle" class="admin-icon-sm"></i>
              Active
            </label>

            <input type="radio" class="btn-check" name="status_toggle" id="status-deprecated" value="deprecated" <%= 'checked' if agent_plugin.status == 'deprecated' %> autocomplete="off">
            <label class="btn btn-outline-secondary" for="status-deprecated">
              <i data-lucide="archive" class="admin-icon-sm"></i>
              Deprecated
            </label>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="row">
    <!-- Left Column: Basic Info -->
    <div class="col-md-6">
      <div class="admin-card mb-4">
        <div class="admin-card-header">
          <h3 class="admin-card-title">
            <i data-lucide="info" class="icon-sm"></i>
            Basic Information
          </h3>
        </div>
        <div class="admin-card-body">
          <div class="row">
            <div class="col-md-8 mb-3">
              <%= f.label :name, class: "form-label small fw-semibold" %>
              <%= f.text_field :name, class: "form-control", placeholder: "Sales Email Generator", required: true %>
            </div>

            <div class="col-md-4 mb-3">
              <%= f.label :slug, class: "form-label small fw-semibold" %>
              <%= f.text_field :slug, class: "form-control", placeholder: "sales_email_generator" %>
            </div>
          </div>

          <div class="mb-3">
            <%= f.label :description, class: "form-label small fw-semibold" %>
            <%= f.text_area :description, class: "form-control", rows: 2, placeholder: "Describe what this agent does..." %>
            <small class="form-text text-muted d-flex align-items-center gap-1 mt-1">
              <i data-lucide="sparkles" class="icon-sm"></i>
              <span>Scout and Agent Lightning RL will automatically learn which agents work best for different tasks</span>
            </small>
          </div>

          <!-- Advanced Settings -->
          <details class="mb-0">
            <summary class="form-label small text-muted admin-summary">
              <i data-lucide="settings" class="icon-sm"></i>
              Advanced Settings (Optional)
            </summary>
            <div class="mt-2 p-3 border rounded admin-field-bg">
              <div class="row g-2">
                <div class="col-md-4">
                  <%= f.label :role, class: "form-label small fw-semibold" %>
                  <%= f.select :role,
                    options_for_select([
                      ['Executor (default)', 'executor'],
                      ['Planner', 'planner'],
                      ['Analyst', 'analyst'],
                      ['Verifier', 'verifier'],
                      ['Fixer', 'fixer'],
                      ['Custom', 'custom']
                    ], agent_plugin.role || 'executor'),
                    {},
                    class: 'form-select form-select-sm' %>
                </div>

                <div class="col-md-4">
                  <%= f.label :priority, class: "form-label small fw-semibold" %>
                  <%= f.number_field :priority, class: "form-control form-control-sm", min: 0, max: 100, value: agent_plugin.priority || 50, placeholder: "50" %>
                </div>

                <div class="col-md-4">
                  <%= f.label :version, class: "form-label small fw-semibold" %>
                  <%= f.text_field :version, class: "form-control form-control-sm", placeholder: "1.0.0" %>
                </div>
              </div>

              <div class="mt-2">
                <%= f.label :ai_model, "AI Model", class: "form-label small fw-semibold" %>
                <%= f.select :ai_model,
                  options_for_select([
                    ['Claude Opus 4.6 (maximum reasoning)', 'claude-opus-4-6'],
                    ['Claude Sonnet 4.6 (balanced - recommended)', 'claude-sonnet-4-6'],
                    ['Claude Haiku 4.5 (fast & cheap)', 'claude-haiku-4-5'],
                    ['Qwen 2.5 72B (open weights)', 'qwen-2-5-72b'],
                    ['Qwen 2.5 Coder 32B', 'qwen-2-5-coder-32b']
                  ], agent_plugin.ai_model || 'claude-sonnet-4-6'),
                  {},
                  class: 'form-select form-select-sm' %>
              </div>

              <div class="mt-2 mb-0">
                <%= f.label :agent_class, "Custom Ruby Class (Developers Only)", class: "form-label small fw-semibold" %>
                <%= f.text_field :agent_class, class: "form-control form-control-sm", placeholder: "Leave blank for standard execution" %>
              </div>
            </div>
          </details>
        </div>
      </div>

      <!-- System Prompt -->
      <div class="admin-card mb-4">
        <div class="admin-card-header">
          <h3 class="admin-card-title">
            <i data-lucide="message-square" class="icon-sm"></i>
            System Prompt
          </h3>
        </div>
        <div class="admin-card-body">
          <div class="mb-3">
            <%= f.text_area :system_prompt,
              value: agent_plugin.system_prompt.is_a?(Hash) ? agent_plugin.system_prompt['prompt'] : agent_plugin.system_prompt,
              class: "form-control font-monospace",
              rows: 8,
              placeholder: "You are a sales email specialist. Generate compelling, personalized emails..." %>
            <small class="form-text text-muted">AI instructions for this agent</small>
          </div>
        </div>
      </div>

      <!-- Configuration -->
      <div class="admin-card mb-4">
        <div class="admin-card-header">
          <h3 class="admin-card-title">
            <i data-lucide="settings" class="icon-sm"></i>
            Configuration
          </h3>
        </div>
        <div class="admin-card-body">
          <div class="alert alert-info mb-3">
            <strong>What is configuration?</strong> Add settings like max_length, tone, temperature, etc. that control how your agent behaves.
          </div>

          <div id="config-container">
            <% config_hash = agent_plugin.configuration.presence || {} %>
            <% if config_hash.any? %>
              <% config_hash.each_with_index do |(key, value), index| %>
                <div class="config-pair mb-2">
                  <div class="row g-2 align-items-center">
                    <div class="col-md-4">
                      <input type="text" class="form-control form-control-sm config-key" placeholder="Key (e.g., max_length)" value="<%= key %>">
                    </div>
                    <div class="col-md-6">
                      <input type="text" class="form-control form-control-sm config-value" placeholder="Value (e.g., 150)" value="<%= value %>">
                    </div>
                    <div class="col-md-2">
                      <%= link_to "#", class: "btn btn-sm btn-outline-danger remove-config-pair w-100" do %>
                        <i data-lucide="x" class="icon-sm"></i>
                      <% end %>
                    </div>
                  </div>
                </div>
              <% end %>
            <% end %>
          </div>

          <!-- Hidden field to store final JSON -->
          <%= f.hidden_field :configuration, id: 'configuration-json' %>

          <button type="button" class="btn btn-sm btn-outline-primary" id="add-config-pair">
            <i data-lucide="plus" class="icon-sm"></i>
            Add Configuration
          </button>

          <div class="mt-3">
            <small class="text-muted">
              Examples: <code>max_length: 150</code>, <code>tone: professional</code>, <code>temperature: 0.7</code>
            </small>
          </div>
        </div>
      </div>
    </div>

    <!-- Right Column: Capabilities & Tools -->
    <div class="col-md-6">
      <!-- Capabilities -->
      <div class="admin-card mb-4">
        <div class="admin-card-header">
          <h3 class="admin-card-title">
            <i data-lucide="zap" class="icon-sm"></i>
            Capabilities
          </h3>
        </div>
        <div class="admin-card-body">
          <p class="text-muted small mb-2">
            <i data-lucide="info" class="icon-sm"></i>
            Capabilities define what this agent can do. Scout uses these to find the right agent for each task.
          </p>

          <div class="mb-2">
            <strong class="small text-muted">Quick add common capabilities:</strong>
            <div class="d-flex flex-wrap gap-1 mt-2">
                <button type="button" class="btn btn-sm btn-outline-secondary quick-add-capability" data-capability="email_generation">
                  <i data-lucide="mail" class="icon-sm"></i> Email Generation
                </button>
                <button type="button" class="btn btn-sm btn-outline-secondary quick-add-capability" data-capability="content_analysis">
                  <i data-lucide="search" class="icon-sm"></i> Content Analysis
                </button>
                <button type="button" class="btn btn-sm btn-outline-secondary quick-add-capability" data-capability="data_extraction">
                  <i data-lucide="file-text" class="icon-sm"></i> Data Extraction
                </button>
                <button type="button" class="btn btn-sm btn-outline-secondary quick-add-capability" data-capability="report_generation">
                  <i data-lucide="file-bar-chart" class="icon-sm"></i> Report Generation
                </button>
                <button type="button" class="btn btn-sm btn-outline-secondary quick-add-capability" data-capability="customer_outreach">
                  <i data-lucide="users" class="icon-sm"></i> Customer Outreach
                </button>
            </div>
          </div>

          <div id="capabilities-container">
            <%= f.fields_for :agent_capabilities do |capability_form| %>
              <div class="capability-field mb-2 p-2 border rounded admin-field-bg">
                <%= capability_form.hidden_field :_destroy %>

                <div class="d-flex align-items-center gap-2">
                  <div class="flex-grow-1">
                    <%= capability_form.text_field :capability_name,
                      class: "form-control form-control-sm",
                      placeholder: "e.g., email_generation, content_analysis",
                      required: true %>
                  </div>
                  <%= link_to "#", class: "btn btn-sm btn-outline-danger remove-capability" do %>
                    <i data-lucide="x" class="icon-sm"></i>
                  <% end %>
                </div>

                <!-- Advanced Settings (Collapsed by default) -->
                <details class="mt-2">
                  <summary class="text-muted small admin-summary">
                    <i data-lucide="settings" class="icon-sm"></i> Advanced
                  </summary>
                  <div class="mt-1">
                    <%= capability_form.text_area :implementation_notes,
                      class: "form-control form-control-sm mb-1",
                      rows: 1,
                      placeholder: "Notes (optional)" %>
                    <%= capability_form.text_area :contract_schema,
                      value: (capability_form.object&.contract_schema.present? ? JSON.pretty_generate(capability_form.object.contract_schema) : '{"inputs": [], "outputs": []}'),
                      class: "form-control form-control-sm font-monospace",
                      rows: 2,
                      placeholder: 'Schema (optional)' %>
                  </div>
                </details>
              </div>
            <% end %>
          </div>

          <button type="button" class="btn btn-sm btn-outline-primary" id="add-capability">
            <i data-lucide="plus" class="icon-sm"></i>
            Add Custom Capability
          </button>
        </div>
      </div>

      <!-- Tools -->
      <div class="admin-card mb-4">
        <div class="admin-card-header">
          <h3 class="admin-card-title">
            <i data-lucide="wrench" class="icon-sm"></i>
            Tools
          </h3>
        </div>
        <div class="admin-card-body">
          <p class="text-muted small mb-2">
            <i data-lucide="info" class="icon-sm"></i>
            Tools are actions your agent can take. Select which tools this agent needs.
            <a href="#" class="text-decoration-none ms-1" data-bs-toggle="modal" data-bs-target="#availableToolsModal">
              <i data-lucide="help-circle" class="icon-sm"></i> Browse all <%= Tools::ToolCatalog.instance.all_tools.count %> available tools
            </a>
          </p>

          <div class="mb-2">
            <strong class="small text-muted">Quick add common tools:</strong>
            <div class="d-flex flex-wrap gap-1 mt-2">
              <button type="button" class="btn btn-sm btn-outline-secondary quick-add-tool" data-tool="get_data">
                <i data-lucide="database" class="icon-sm"></i> Get Data
              </button>
              <button type="button" class="btn btn-sm btn-outline-secondary quick-add-tool" data-tool="create_object">
                <i data-lucide="plus-circle" class="icon-sm"></i> Create Object
              </button>
              <button type="button" class="btn btn-sm btn-outline-secondary quick-add-tool" data-tool="update_object">
                <i data-lucide="edit" class="icon-sm"></i> Update Object
              </button>
              <button type="button" class="btn btn-sm btn-outline-secondary quick-add-tool" data-tool="web_search_tool">
                <i data-lucide="search" class="icon-sm"></i> Web Search
              </button>
              <button type="button" class="btn btn-sm btn-outline-secondary quick-add-tool" data-tool="generate_landing_page">
                <i data-lucide="layout" class="icon-sm"></i> Generate Page
              </button>
              <button type="button" class="btn btn-sm btn-outline-secondary quick-add-tool" data-tool="list_connections">
                <i data-lucide="link" class="icon-sm"></i> List Connections
              </button>
              <button type="button" class="btn btn-sm btn-outline-secondary quick-add-tool" data-tool="invoke_operation">
                <i data-lucide="zap" class="icon-sm"></i> Invoke Operation
              </button>
            </div>
          </div>

          <div id="tools-container">
            <%= f.fields_for :agent_tools do |tool_form| %>
              <div class="tool-field mb-2 p-2 border rounded admin-field-bg">
                <%= tool_form.hidden_field :_destroy %>

                <div class="d-flex align-items-center gap-2">
                  <div class="flex-grow-1">
                    <%= tool_form.text_field :tool_name, class: "form-control form-control-sm", placeholder: "get_data" %>
                  </div>
                  <div class="form-check">
                    <%= tool_form.check_box :required, class: "form-check-input" %>
                    <%= tool_form.label :required, "Required", class: "form-check-label small text-nowrap" %>
                  </div>
                  <%= link_to "#", class: "btn btn-sm btn-outline-danger remove-tool" do %>
                    <i data-lucide="x" class="icon-sm"></i>
                  <% end %>
                </div>
              </div>
            <% end %>
          </div>

          <button type="button" class="btn btn-sm btn-outline-primary" id="add-tool">
            <i data-lucide="plus" class="icon-sm"></i>
            Add Custom Tool
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- Available Tools Modal -->
  <div class="modal fade" id="availableToolsModal" tabindex="-1" aria-labelledby="availableToolsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title" id="availableToolsModalLabel">
            <i data-lucide="wrench" class="icon-sm"></i>
            Available Tools
          </h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
          <div class="mb-3">
            <input type="text" id="tool-search" class="form-control" placeholder="Search tools...">
          </div>
          <div id="tools-list" class="list-group">
            <% Tools::ToolCatalog.instance.all_tools.each do |tool_name, tool_data| %>
              <% definition = tool_data[:metadata] %>
              <div class="list-group-item list-group-item-action tool-item admin-summary" data-tool-name="<%= tool_name %>">
                <div class="d-flex justify-content-between align-items-start">
                  <div>
                    <h6 class="mb-1"><code><%= tool_name %></code></h6>
                    <p class="mb-1 small"><%= definition[:description] %></p>
                    <% if definition[:input_schema] && definition[:input_schema][:properties] %>
                      <small class="text-muted">
                        Parameters: <%= definition[:input_schema][:properties].keys.join(', ') %>
                      </small>
                    <% end %>
                  </div>
                  <button type="button" class="btn btn-sm btn-outline-primary add-this-tool">
                    <i data-lucide="plus" class="icon-sm"></i>
                  </button>
                </div>
              </div>
            <% end %>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
        </div>
      </div>
    </div>
  </div>

  <!-- Form Actions -->
  <div class="admin-card admin-sticky-bottom admin-mt-xl">
    <div class="admin-card-body">
      <div class="d-flex justify-content-between align-items-center">
        <div>
          <%= link_to admin_agent_plugins_path, class: "admin-btn admin-btn-outline" do %>
            <i data-lucide="x" class="icon-sm"></i>
            <span>Cancel</span>
          <% end %>
        </div>
        <div class="d-flex admin-flex-gap-sm">
          <% if agent_plugin.persisted? %>
            <%= f.submit "Save as Draft", name: "draft", class: "admin-btn admin-btn-secondary", formnovalidate: true %>
          <% end %>
          <%= f.submit agent_plugin.persisted? ? "Update Agent" : "Create Agent", class: "admin-btn admin-btn-primary" %>
        </div>
      </div>
    </div>
  </div>
<% end %>

<script>
  document.addEventListener('turbo:load', () => {
    lucide.createIcons();

    // Preset Template functionality
    document.querySelectorAll('.preset-template').forEach(button => {
      button.addEventListener('click', function(e) {
        e.preventDefault();

        const name = this.dataset.name;
        const description = this.dataset.description;
        const capabilities = JSON.parse(this.dataset.capabilities || '[]');
        const tools = JSON.parse(this.dataset.tools || '[]');

        // Fill in basic info
        const nameField = document.querySelector('input[name="agent_plugin[name]"]');
        const descField = document.querySelector('textarea[name="agent_plugin[description]"]');

        if (nameField) nameField.value = name;
        if (descField) descField.value = description;

        // Add capabilities
        capabilities.forEach(capability => {
          addCapability(capability);
        });

        // Add tools
        tools.forEach(tool => {
          addTool(tool, false); // false = not required by default
        });

        // Scroll to basic info
        nameField.scrollIntoView({ behavior: 'smooth', block: 'center' });
        nameField.focus();

        lucide.createIcons();
      });
    });

    // Quick add tool
    document.querySelectorAll('.quick-add-tool').forEach(button => {
      button.addEventListener('click', function(e) {
        e.preventDefault();
        const tool = this.dataset.tool;
        addTool(tool, false);
      });
    });

    // Status toggle functionality
    document.querySelectorAll('input[name="status_toggle"]').forEach(radio => {
      radio.addEventListener('change', function() {
        const statusValue = this.value;
        const hiddenField = document.getElementById('status-hidden-field');
        const descriptionSpan = document.getElementById('status-description');

        // Update hidden field
        if (hiddenField) {
          hiddenField.value = statusValue;
        }

        // Update description
        const descriptions = {
          'draft': '<i data-lucide="edit" class="admin-icon-sm text-warning"></i> Agent is in draft mode for testing only',
          'active': '<i data-lucide="check-circle" class="admin-icon-sm text-success"></i> Agent is active and available for workflows',
          'deprecated': '<i data-lucide="archive" class="admin-icon-sm text-secondary"></i> Agent is deprecated and archived'
        };

        if (descriptionSpan && descriptions[statusValue]) {
          descriptionSpan.innerHTML = descriptions[statusValue];
          lucide.createIcons(); // Reinitialize icons
        }
      });
    });

    // Quick add capability
    document.querySelectorAll('.quick-add-capability').forEach(button => {
      button.addEventListener('click', function(e) {
        e.preventDefault();
        const capability = this.dataset.capability;
        addCapability(capability);
      });
    });

    // Add capability function
    function addCapability(capabilityName = '') {
      const container = document.getElementById('capabilities-container');
      const time = new Date().getTime();
      const template = `
        <div class="capability-field mb-2 p-2 border rounded admin-field-bg">
          <input type="hidden" name="agent_plugin[agent_capabilities_attributes][${time}][_destroy]" value="false">

          <div class="d-flex align-items-center gap-2">
            <div class="flex-grow-1">
              <input type="text"
                name="agent_plugin[agent_capabilities_attributes][${time}][capability_name]"
                class="form-control form-control-sm"
                placeholder="e.g., email_generation, content_analysis"
                value="${capabilityName}"
                required>
            </div>
            <a href="#" class="btn btn-sm btn-outline-danger remove-capability">
              <i data-lucide="x" class="icon-sm"></i>
            </a>
          </div>

          <details class="mt-2">
            <summary class="text-muted small admin-summary">
              <i data-lucide="settings" class="icon-sm"></i> Advanced
            </summary>
            <div class="mt-1">
              <textarea name="agent_plugin[agent_capabilities_attributes][${time}][implementation_notes]" class="form-control form-control-sm mb-1" rows="1" placeholder="Notes (optional)"></textarea>
              <textarea name="agent_plugin[agent_capabilities_attributes][${time}][contract_schema]" class="form-control form-control-sm font-monospace" rows="2" placeholder="Schema (optional)">{"inputs": [], "outputs": []}</textarea>
            </div>
          </details>
        </div>
      `;
      container.insertAdjacentHTML('beforeend', template);
      lucide.createIcons();
    }

    // Add capability button
    document.getElementById('add-capability')?.addEventListener('click', function() {
      addCapability();
    });

    // Add tool function
    function addTool(toolName = '', isRequired = false) {
      const container = document.getElementById('tools-container');
      const time = new Date().getTime();
      const template = `
        <div class="tool-field mb-2 p-2 border rounded admin-field-bg">
          <input type="hidden" name="agent_plugin[agent_tools_attributes][${time}][_destroy]" value="false">

          <div class="d-flex align-items-center gap-2">
            <div class="flex-grow-1">
              <input type="text" name="agent_plugin[agent_tools_attributes][${time}][tool_name]" class="form-control form-control-sm" placeholder="get_data" value="${toolName}">
            </div>
            <div class="form-check">
              <input type="checkbox" name="agent_plugin[agent_tools_attributes][${time}][required]" class="form-check-input" value="1" ${isRequired ? 'checked' : ''}>
              <label class="form-check-label small text-nowrap">Required</label>
            </div>
            <a href="#" class="btn btn-sm btn-outline-danger remove-tool">
              <i data-lucide="x" class="icon-sm"></i>
            </a>
          </div>
        </div>
      `;
      container.insertAdjacentHTML('beforeend', template);
      lucide.createIcons();
    }

    // Add tool button
    document.getElementById('add-tool')?.addEventListener('click', function() {
      addTool();
    });

    // Remove capability/tool
    document.addEventListener('click', function(e) {
      if (e.target.closest('.remove-capability')) {
        e.preventDefault();
        const field = e.target.closest('.capability-field');
        const destroyInput = field.querySelector('input[name*="_destroy"]');
        if (destroyInput) {
          destroyInput.value = '1';
          field.style.display = 'none';
        } else {
          field.remove();
        }
      }

      if (e.target.closest('.remove-tool')) {
        e.preventDefault();
        const field = e.target.closest('.tool-field');
        const destroyInput = field.querySelector('input[name*="_destroy"]');
        if (destroyInput) {
          destroyInput.value = '1';
          field.style.display = 'none';
        } else {
          field.remove();
        }
      }

      // Add tool from modal
      if (e.target.closest('.add-this-tool')) {
        e.preventDefault();
        const toolItem = e.target.closest('.tool-item');
        const toolName = toolItem.dataset.toolName;

        // Add tool using the shared function
        addTool(toolName, true); // true = required by default from modal

        // Close modal
        const modal = bootstrap.Modal.getInstance(document.getElementById('availableToolsModal'));
        if (modal) modal.hide();
      }
    });

    // Tool search functionality
    document.getElementById('tool-search')?.addEventListener('input', function(e) {
      const searchTerm = e.target.value.toLowerCase();
      const toolItems = document.querySelectorAll('.tool-item');

      toolItems.forEach(item => {
        const toolName = item.dataset.toolName.toLowerCase();
        const description = item.querySelector('p').textContent.toLowerCase();
        const matches = toolName.includes(searchTerm) || description.includes(searchTerm);
        item.style.display = matches ? '' : 'none';
      });
    });

    // Refresh lucide icons when modal opens
    document.getElementById('availableToolsModal')?.addEventListener('shown.bs.modal', function() {
      lucide.createIcons();
    });

    // Auto-generate slug from name
    const nameField = document.querySelector('input[name="agent_plugin[name]"]');
    const slugField = document.querySelector('input[name="agent_plugin[slug]"]');

    if (nameField && slugField) {
      nameField.addEventListener('input', function(e) {
        // Only auto-generate if slug is empty or was auto-generated
        if (!slugField.dataset.manuallyEdited) {
          const slug = e.target.value
            .toLowerCase()
            .replace(/[^a-z0-9]+/g, '_')  // Replace non-alphanumeric with underscore
            .replace(/^_+|_+$/g, '');      // Trim underscores from start/end
          slugField.value = slug;
        }
      });

      // Mark slug as manually edited if user types in it
      slugField.addEventListener('input', function() {
        slugField.dataset.manuallyEdited = 'true';
      });
    }

    // Configuration key-value pairs
    function updateConfigJSON() {
      const configPairs = document.querySelectorAll('.config-pair');
      const config = {};

      configPairs.forEach(pair => {
        const key = pair.querySelector('.config-key').value.trim();
        let value = pair.querySelector('.config-value').value.trim();

        if (key) {
          // Try to parse value as number or boolean
          if (value === 'true') value = true;
          else if (value === 'false') value = false;
          else if (!isNaN(value) && value !== '') value = Number(value);

          config[key] = value;
        }
      });

      document.getElementById('configuration-json').value = JSON.stringify(config);
    }

    // Add config pair
    document.getElementById('add-config-pair')?.addEventListener('click', function() {
      const container = document.getElementById('config-container');
      const template = `
        <div class="config-pair mb-2">
          <div class="row g-2 align-items-center">
            <div class="col-md-4">
              <input type="text" class="form-control form-control-sm config-key" placeholder="Key (e.g., max_length)">
            </div>
            <div class="col-md-6">
              <input type="text" class="form-control form-control-sm config-value" placeholder="Value (e.g., 150)">
            </div>
            <div class="col-md-2">
              <a href="#" class="btn btn-sm btn-outline-danger remove-config-pair w-100">
                <i data-lucide="x" class="icon-sm"></i>
              </a>
            </div>
          </div>
        </div>
      `;
      container.insertAdjacentHTML('beforeend', template);
      lucide.createIcons();
    });

    // Remove config pair
    document.addEventListener('click', function(e) {
      if (e.target.closest('.remove-config-pair')) {
        e.preventDefault();
        const pair = e.target.closest('.config-pair');
        pair.remove();
        updateConfigJSON();
      }
    });

    // Update JSON when config values change
    document.addEventListener('input', function(e) {
      if (e.target.classList.contains('config-key') || e.target.classList.contains('config-value')) {
        updateConfigJSON();
      }
    });

    // Initialize JSON on page load
    updateConfigJSON();

    // Update JSON before form submission
    document.querySelector('.admin-form')?.addEventListener('submit', function() {
      updateConfigJSON();
    });
  });
</script>
