<div class="admin-content">
  <div class="admin-p-xl">
    <div class="admin-page-header">
      <div class="header-left">
        <div class="header-icon">
          <%= admin_icon('cpu', size: :lg) %>
        </div>
        <div class="header-text">
          <h1>AI Model Performance</h1>
          <p>Performance metrics by model across <%= @selected_entity_id ? 'selected entity' : 'all entities' %></p>
        </div>
      </div>

      <div class="header-actions">
        <%= link_to dashboard_admin_agent_lightning_index_path, class: 'admin-btn admin-btn-outline' do %>
          <%= admin_icon('arrow-left', size: :sm) %>
          <span>Back to Dashboard</span>
        <% end %>
      </div>
    </div>

    <!-- Filters -->
    <div class="admin-card admin-mb-xl">
      <h3 class="card-title">
        <%= admin_icon('filter', size: :md, class: 'admin-inline-block admin-mr-sm') %>
        Filters
      </h3>

      <%= form_with url: models_performance_admin_agent_lightning_index_path, method: :get, class: 'admin-form' do |f| %>
        <div class="admin-grid-3">
          <div class="admin-form-field">
            <%= f.label :entity_id, "Entity", class: "admin-label" %>
            <%= f.select :entity_id,
              options_for_select([['All Entities', '']] + @entities.map { |e| [e.name, e.id] }, @selected_entity_id),
              {},
              { class: "admin-select" }
            %>
          </div>

          <div class="admin-form-field">
            <%= f.label :time_range, "Time Range", class: "admin-label" %>
            <%= f.select :time_range,
              options_for_select([
                ['Last 24 Hours', 1],
                ['Last 7 Days', 7],
                ['Last 30 Days', 30],
                ['Last 90 Days', 90],
                ['All Time', 365]
              ], @time_range_days),
              {},
              { class: "admin-select" }
            %>
          </div>

          <div class="admin-form-field admin-flex admin-items-end">
            <%= f.submit "Apply Filters", class: "admin-btn admin-btn-primary admin-w-full" %>
          </div>
        </div>
      <% end %>
    </div>

    <!-- Overall Platform Stats -->
    <div class="admin-stats-grid admin-mb-xl">
      <%= render 'admin/shared/stat_card',
          icon: 'cpu',
          label: 'Total LLM Calls',
          value: number_with_delimiter(@total_llm_calls),
          subtitle: "Last #{@time_range_days} days",
          variant: 'purple-gradient' %>

      <%= render 'admin/shared/stat_card',
          icon: 'check-circle',
          label: 'Overall Success Rate',
          value: "#{@overall_success_rate}%",
          subtitle: 'Across all models',
          variant: 'success' %>

      <%= render 'admin/shared/stat_card',
          icon: 'dollar-sign',
          label: 'Total Cost',
          value: "$#{@total_platform_cost}",
          subtitle: "Last #{@time_range_days} days",
          variant: 'danger' %>

      <%= render 'admin/shared/stat_card',
          icon: 'layers',
          label: 'Models in Use',
          value: @model_stats.count,
          subtitle: 'Active models',
          variant: 'info' %>
    </div>

    <!-- Charts Row -->
    <div class="admin-grid-2 admin-mb-xl">
      <!-- Token Usage Chart -->
      <div class="admin-card">
        <h3 class="card-title">
          <%= admin_icon('bar-chart-3', size: :md, class: 'admin-inline-block admin-mr-sm') %>
          Token Usage Over Time
        </h3>
        <div class="admin-chart-container">
          <canvas id="tokenUsageChart"></canvas>
        </div>
      </div>

      <!-- Cost Chart -->
      <div class="admin-card">
        <h3 class="card-title">
          <%= admin_icon('trending-up', size: :md, class: 'admin-inline-block admin-mr-sm') %>
          Cost Over Time
        </h3>
        <div class="admin-chart-container">
          <canvas id="costChart"></canvas>
        </div>
      </div>
    </div>

    <!-- Model Performance Table -->
    <div class="admin-card admin-mb-xl">
      <h3 class="card-title">
        <%= admin_icon('bar-chart-3', size: :md, class: 'admin-inline-block admin-mr-sm') %>
        Model Performance Comparison
      </h3>
      <div class="admin-overflow-x-auto">
        <table class="admin-table">
          <thead>
            <tr>
              <th scope="col">Model</th>
              <th scope="col">Total Calls</th>
              <th scope="col">Success Rate</th>
              <th scope="col">Avg Latency</th>
              <th scope="col">Avg Tokens</th>
              <th scope="col">Avg Cost/Call</th>
              <th scope="col">Total Cost</th>
            </tr>
          </thead>
          <tbody>
            <% if @model_stats.any? %>
              <% @model_stats.each do |stat| %>
                <tr>
                  <td>
                    <strong class="admin-text-primary"><%= stat[:display_name] %></strong>
                    <br><small class="admin-text-muted admin-text-xs"><%= stat[:model] %></small>
                  </td>
                  <td class="admin-text-secondary"><%= number_with_delimiter(stat[:total_calls]) %></td>
                  <td>
                    <% if stat[:success_rate] >= 90 %>
                      <span class="admin-badge admin-badge-online"><%= stat[:success_rate] %>%</span>
                    <% elsif stat[:success_rate] >= 70 %>
                      <span class="admin-badge admin-badge-cyan"><%= stat[:success_rate] %>%</span>
                    <% elsif stat[:success_rate] >= 50 %>
                      <span class="admin-badge admin-badge-warning"><%= stat[:success_rate] %>%</span>
                    <% else %>
                      <span class="admin-badge admin-badge-offline"><%= stat[:success_rate] %>%</span>
                    <% end %>
                  </td>
                  <td><code class="admin-code-muted"><%= stat[:avg_latency] %>ms</code></td>
                  <td class="admin-text-secondary"><%= number_with_delimiter(stat[:avg_tokens]) %></td>
                  <td style="color: rgb(248, 113, 113);">$<%= stat[:avg_cost] %></td>
                  <td class="admin-font-semibold" style="color: rgb(248, 113, 113);">$<%= stat[:total_cost] %></td>
                </tr>
              <% end %>
            <% else %>
              <tr>
                <td colspan="7" class="admin-text-center admin-p-xl">
                  <div class="admin-empty-state">
                    <div class="empty-icon">
                      <%= admin_icon('inbox', size: :xl) %>
                    </div>
                    <h3>No LLM call data</h3>
                    <p>LLM call data will appear once traces are collected</p>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>

    <!-- Per-Entity Breakdown (only if viewing all entities) -->
    <% if @selected_entity_id.blank? && @entity_breakdown.any? %>
      <% @entity_breakdown.each do |model, entities| %>
        <% model_name = @model_stats.find { |s| s[:model] == model }&.dig(:display_name) || model %>
        <div class="admin-card admin-mb-xl">
          <h3 class="card-title">
            <%= admin_icon('building', size: :md, class: 'admin-inline-block admin-mr-sm') %>
            <%= model_name %> - Top Entities
          </h3>
          <div class="admin-overflow-x-auto">
            <table class="admin-table">
              <thead>
                <tr>
                  <th scope="col">Entity</th>
                  <th scope="col">Calls</th>
                  <th scope="col">Avg Latency</th>
                  <th scope="col">Total Cost</th>
                </tr>
              </thead>
              <tbody>
                <% entities.each do |entity_stat| %>
                  <tr>
                    <td>
                      <strong class="admin-text-primary"><%= entity_stat[:entity_name] %></strong>
                      <br><small class="admin-text-muted">ID: <%= entity_stat[:entity_id] %></small>
                    </td>
                    <td class="admin-text-secondary"><%= number_with_delimiter(entity_stat[:calls]) %></td>
                    <td><code class="admin-code-muted"><%= entity_stat[:avg_latency] %>ms</code></td>
                    <td style="color: rgb(248, 113, 113);">$<%= entity_stat[:total_cost] %></td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        </div>
      <% end %>
    <% end %>
  </div>
</div>

<%= render 'admin/chart_js' %>
<script>
  // Initialize charts and icons
  function initializeModelsPerformancePage() {
    // Dark theme colors for Chart.js
    Chart.defaults.color = '#94A3B8';
    Chart.defaults.borderColor = '#1E293B';

    // Get canvas elements
    const tokenCanvas = document.getElementById('tokenUsageChart');
    const costCanvas = document.getElementById('costChart');

    // Destroy existing charts if they exist
    if (tokenCanvas && Chart.getChart(tokenCanvas)) {
      Chart.getChart(tokenCanvas).destroy();
    }
    if (costCanvas && Chart.getChart(costCanvas)) {
      Chart.getChart(costCanvas).destroy();
    }

    // Token Usage Chart
    if (tokenCanvas) {
      new Chart(tokenCanvas, {
        type: 'bar',
        data: <%= raw @token_usage_chart.to_json %>,
        options: {
          responsive: true,
          maintainAspectRatio: false,
          scales: {
            x: {
              stacked: true,
              grid: { color: '#1E293B' }
            },
            y: {
              stacked: true,
              beginAtZero: true,
              grid: { color: '#1E293B' },
              ticks: {
                callback: function(value) {
                  // Format large numbers with K/M suffix
                  if (value >= 1000000) {
                    return (value / 1000000).toFixed(1) + 'M';
                  } else if (value >= 1000) {
                    return (value / 1000).toFixed(0) + 'K';
                  }
                  return value;
                }
              }
            }
          },
          plugins: {
            legend: {
              position: 'bottom',
              labels: { color: '#94A3B8' }
            }
          }
        }
      });
    }

    // Cost Chart
    if (costCanvas) {
      new Chart(costCanvas, {
        type: 'line',
        data: <%= raw @cost_chart.to_json %>,
        options: {
          responsive: true,
          maintainAspectRatio: false,
          scales: {
            x: { grid: { color: '#1E293B' } },
            y: {
              beginAtZero: true,
              grid: { color: '#1E293B' },
              ticks: {
                callback: function(value) {
                  return '$' + value.toFixed(2);
                }
              }
            }
          },
          plugins: {
            legend: {
              position: 'bottom',
              labels: { color: '#94A3B8' }
            }
          }
        }
      });
    }

    // Initialize Lucide icons
    if (typeof lucide !== 'undefined') {
      lucide.createIcons();
    }
  }

  // Run on both DOMContentLoaded and turbo:load
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initializeModelsPerformancePage);
  } else {
    initializeModelsPerformancePage();
  }

  document.addEventListener('turbo:load', initializeModelsPerformancePage);
</script>
