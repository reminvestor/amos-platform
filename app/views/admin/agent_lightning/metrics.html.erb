<div class="admin-p-xl">
  <!-- Page Header -->
  <div class="admin-page-header">
    <div class="header-left">
      <div class="header-icon">
        <%= admin_icon('bar-chart-3', size: :lg) %>
      </div>
      <div class="header-text">
        <h1>Agent Lightning Metrics</h1>
        <p><%= @entity ? @entity.name : "Platform-wide" %> (Last <%= @days %> days)</p>
      </div>
    </div>

    <div class="header-actions">
      <div class="admin-flex admin-flex-gap-sm">
        <% [7, 30, 60, 90].each do |days| %>
          <% if days == @days %>
            <span class="admin-badge admin-badge-cyan admin-btn-sm"><%= days %> days</span>
          <% else %>
            <%= link_to days.to_s + " days", metrics_admin_agent_lightning_index_path(days: days), class: "admin-btn admin-btn-sm admin-btn-outline" %>
          <% end %>
        <% end %>
        <%= link_to dashboard_admin_agent_lightning_index_path, class: "admin-btn admin-btn-sm admin-btn-outline" do %>
          <%= admin_icon('arrow-left', size: :sm) %>
          <span>Back</span>
        <% end %>
      </div>
    </div>
  </div>

  <!-- Overall Statistics -->
  <div class="admin-stats-grid">
    <%= render 'admin/shared/stat_card', icon: 'activity', label: 'Total Traces', value: number_with_delimiter(@total_traces), variant: 'purple-gradient', aria_label: 'Total traces count' %>
    <%= render 'admin/shared/stat_card', icon: 'trending-up', label: 'Success Rate', value: "#{@success_rate}%", variant: 'success', aria_label: 'Success rate percentage' %>
    <%= render 'admin/shared/stat_card', icon: 'award', label: 'Avg Reward', value: @avg_reward, variant: 'warning', aria_label: 'Average reward score' %>
    <%= render 'admin/shared/stat_card', icon: 'check-circle', label: 'Completed', value: number_with_delimiter(@completed_traces_count), variant: 'info', aria_label: 'Completed traces count' %>
  </div>

  <!-- Token & Cost Analysis -->
  <div class="admin-content-grid admin-mb-xl">
    <div class="admin-card">
      <h3 class="card-title">
        <%= admin_icon('cpu', size: :md, class: 'icon-with-spacing') %>
        Token Usage
      </h3>
      <div class="admin-detail-list">
        <div class="detail-item">
          <span class="detail-label">Total Tokens</span>
          <span class="detail-value"><%= number_with_delimiter(@total_tokens) %></span>
        </div>
        <div class="detail-item">
          <span class="detail-label">Average per Trace</span>
          <span class="detail-value"><%= number_with_delimiter(@avg_tokens) %></span>
        </div>
      </div>
    </div>

    <div class="admin-card">
      <h3 class="card-title">
        <%= admin_icon('dollar-sign', size: :md, class: 'icon-with-spacing') %>
        Cost Analysis
      </h3>
      <div class="admin-detail-list">
        <div class="detail-item">
          <span class="detail-label">Total Cost</span>
          <span class="detail-value admin-text-error">$<%= @total_cost %></span>
        </div>
        <div class="detail-item">
          <span class="detail-label">Average per Trace</span>
          <span class="detail-value admin-text-error">$<%= @avg_cost %></span>
        </div>
      </div>
    </div>
  </div>

  <!-- Performance Analysis -->
  <div class="admin-card admin-mb-xl">
    <h3 class="card-title">
      <%= admin_icon('zap', size: :md, class: 'icon-with-spacing') %>
      Performance Analysis
    </h3>

    <div class="admin-grid-2">
      <div>
        <h6 class="admin-status-label">Duration Metrics</h6>
        <div class="admin-detail-list">
          <div class="detail-item">
            <span class="detail-label">Total Duration</span>
            <span class="detail-value"><%= @total_duration_minutes %> min</span>
          </div>
          <div class="detail-item">
            <span class="detail-label">Average Duration</span>
            <span class="detail-value"><%= @avg_duration %>ms</span>
          </div>
          <div class="detail-item">
            <span class="detail-label">Minimum Duration</span>
            <span class="detail-value"><%= @min_duration %>ms</span>
          </div>
          <div class="detail-item">
            <span class="detail-label">Maximum Duration</span>
            <span class="detail-value"><%= @max_duration %>ms</span>
          </div>
        </div>
      </div>

      <div>
        <h6 class="admin-status-label">Performance Distribution</h6>
        <div class="admin-progress-bar">
          <div class="admin-progress-segment admin-progress-fast" style="width: <%= (@traces.where('duration_ms < 1000').count.to_f / @total_traces * 100).round %>%;">
            <% if (@traces.where('duration_ms < 1000').count.to_f / @total_traces * 100).round > 10 %>
              &lt;1s
            <% end %>
          </div>
          <div class="admin-progress-segment admin-progress-medium" style="width: <%= (@traces.where('duration_ms >= 1000 AND duration_ms < 5000').count.to_f / @total_traces * 100).round %>%;">
            <% if (@traces.where('duration_ms >= 1000 AND duration_ms < 5000').count.to_f / @total_traces * 100).round > 10 %>
              1-5s
            <% end %>
          </div>
          <div class="admin-progress-segment admin-progress-slow" style="width: <%= (@traces.where('duration_ms >= 5000 AND duration_ms < 10000').count.to_f / @total_traces * 100).round %>%;">
            <% if (@traces.where('duration_ms >= 5000 AND duration_ms < 10000').count.to_f / @total_traces * 100).round > 10 %>
              5-10s
            <% end %>
          </div>
          <div class="admin-progress-segment admin-progress-very-slow" style="width: <%= (@traces.where('duration_ms >= 10000').count.to_f / @total_traces * 100).round %>%;">
            <% if (@traces.where('duration_ms >= 10000').count.to_f / @total_traces * 100).round > 10 %>
              &gt;10s
            <% end %>
          </div>
        </div>
        <div class="admin-grid-4 admin-mt-lg">
          <div class="admin-text-center">
            <div class="admin-legend-square admin-legend-fast admin-mx-auto admin-mb-xs"></div>
            <span class="admin-text-muted admin-text-xs">&lt;1s (<%= (@traces.where('duration_ms < 1000').count.to_f / @total_traces * 100).round %>%)</span>
          </div>
          <div class="admin-text-center">
            <div class="admin-legend-square admin-legend-medium admin-mx-auto admin-mb-xs"></div>
            <span class="admin-text-muted admin-text-xs">1-5s (<%= (@traces.where('duration_ms >= 1000 AND duration_ms < 5000').count.to_f / @total_traces * 100).round %>%)</span>
          </div>
          <div class="admin-text-center">
            <div class="admin-legend-square admin-legend-slow admin-mx-auto admin-mb-xs"></div>
            <span class="admin-text-muted admin-text-xs">5-10s (<%= (@traces.where('duration_ms >= 5000 AND duration_ms < 10000').count.to_f / @total_traces * 100).round %>%)</span>
          </div>
          <div class="admin-text-center">
            <div class="admin-legend-square admin-legend-very-slow admin-mx-auto admin-mb-xs"></div>
            <span class="admin-text-muted admin-text-xs">&gt;10s (<%= (@traces.where('duration_ms >= 10000').count.to_f / @total_traces * 100).round %>%)</span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- LLM Call Analysis -->
  <% if @llm_calls && @llm_calls.any? %>
    <div class="admin-card admin-mb-xl">
      <h3 class="card-title">
        <%= admin_icon('cpu', size: :md, class: 'icon-with-spacing') %>
        LLM Call Analysis
      </h3>

      <div class="admin-stats-grid admin-mb-xl">
        <div class="admin-stat-box admin-stat-box-green">
          <div class="admin-flex admin-items-center admin-flex-gap-md">
            <%= admin_icon('check-circle', size: :md, class: 'admin-text-success') %>
            <div>
              <p class="admin-stat-box-label">Success Rate</p>
              <h4 class="admin-stat-box-value"><%= @llm_success_rate %>%</h4>
            </div>
          </div>
        </div>

        <div class="admin-stat-box admin-stat-box-cyan">
          <div class="admin-flex admin-items-center admin-flex-gap-md">
            <%= admin_icon('activity', size: :md, class: 'admin-text-info') %>
            <div>
              <p class="admin-stat-box-label">Total Calls</p>
              <h4 class="admin-stat-box-value"><%= number_with_delimiter(@llm_calls.count) %></h4>
            </div>
          </div>
        </div>

        <div class="admin-stat-box admin-stat-box-yellow">
          <div class="admin-flex admin-items-center admin-flex-gap-md">
            <%= admin_icon('clock', size: :md, class: 'admin-text-warning') %>
            <div>
              <p class="admin-stat-box-label">Avg Latency</p>
              <h4 class="admin-stat-box-value"><%= @avg_latency %>ms</h4>
            </div>
          </div>
        </div>
      </div>

      <h6 class="admin-status-label">By Agent Role</h6>
      <div class="admin-overflow-x-auto">
        <table class="admin-table">
          <thead>
            <tr>
              <th>Role</th>
              <th class="admin-text-right">Count</th>
              <th class="admin-text-right">Success Rate</th>
              <th class="admin-text-right">Avg Tokens</th>
              <th class="admin-text-right">Total Cost</th>
            </tr>
          </thead>
          <tbody>
            <% @llm_by_role.each do |role_data| %>
              <tr>
                <td>
                  <span class="admin-badge admin-badge-default"><%= role_data[:role] %></span>
                </td>
                <td class="admin-text-right admin-text-primary"><%= number_with_delimiter(role_data[:count]) %></td>
                <td class="admin-text-right">
                  <% if role_data[:success_rate] > 85 %>
                    <span class="admin-badge admin-badge-online"><%= role_data[:success_rate] %>%</span>
                  <% elsif role_data[:success_rate] > 70 %>
                    <span class="admin-badge admin-badge-warning"><%= role_data[:success_rate] %>%</span>
                  <% else %>
                    <span class="admin-badge admin-badge-offline"><%= role_data[:success_rate] %>%</span>
                  <% end %>
                </td>
                <td class="admin-text-right"><code class="admin-code-inline"><%= number_with_delimiter(role_data[:avg_tokens]) %></code></td>
                <td class="admin-text-right admin-text-warning admin-font-semibold">$<%= role_data[:total_cost] %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  <% end %>

  <!-- Tool Execution Analysis -->
  <% if @top_tools && @top_tools.any? %>
    <div class="admin-card">
      <h3 class="card-title">
        <%= admin_icon('tool', size: :md, class: 'icon-with-spacing') %>
        Tool Execution Analysis
      </h3>

      <div class="admin-stats-grid admin-mb-xl">
        <div class="admin-stat-box admin-stat-box-green">
          <div class="admin-flex admin-items-center admin-flex-gap-md">
            <%= admin_icon('check-circle', size: :md, class: 'admin-text-success') %>
            <div>
              <p class="admin-stat-box-label">Success Rate</p>
              <h4 class="admin-stat-box-value"><%= @tool_success_rate %>%</h4>
            </div>
          </div>
        </div>

        <div class="admin-stat-box admin-stat-box-cyan">
          <div class="admin-flex admin-items-center admin-flex-gap-md">
            <%= admin_icon('layers', size: :md, class: 'admin-text-info') %>
            <div>
              <p class="admin-stat-box-label">Total Executions</p>
              <h4 class="admin-stat-box-value"><%= number_with_delimiter(@top_tools.sum { |t| t[:count] }) %></h4>
            </div>
          </div>
        </div>

        <div class="admin-stat-box admin-stat-box-red">
          <div class="admin-flex admin-items-center admin-flex-gap-md">
            <%= admin_icon('x-circle', size: :md, class: 'admin-text-error') %>
            <div>
              <p class="admin-stat-box-label">Failed</p>
              <h4 class="admin-stat-box-value"><%= number_with_delimiter(@failed_tool_executions) %></h4>
            </div>
          </div>
        </div>
      </div>

      <h6 class="admin-status-label">Top 10 Tools</h6>
      <div class="admin-overflow-x-auto">
        <table class="admin-table">
          <thead>
            <tr>
              <th>Tool</th>
              <th class="admin-text-right">Executions</th>
              <th class="admin-text-right">Success Rate</th>
              <th class="admin-text-right">Avg Time</th>
            </tr>
          </thead>
          <tbody>
            <% @top_tools.each do |tool| %>
              <tr>
                <td><code class="admin-code-inline"><%= tool[:name] %></code></td>
                <td class="admin-text-right admin-text-primary"><%= number_with_delimiter(tool[:count]) %></td>
                <td class="admin-text-right">
                  <% if tool[:success_rate] > 85 %>
                    <span class="admin-badge admin-badge-online"><%= tool[:success_rate] %>%</span>
                  <% elsif tool[:success_rate] > 70 %>
                    <span class="admin-badge admin-badge-warning"><%= tool[:success_rate] %>%</span>
                  <% else %>
                    <span class="admin-badge admin-badge-offline"><%= tool[:success_rate] %>%</span>
                  <% end %>
                </td>
                <td class="admin-text-right"><code class="admin-code-muted"><%= tool[:avg_time] %>ms</code></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  <% end %>
</div>

<!-- Initialize Lucide Icons -->
<script>
  document.addEventListener('turbo:load', () => {
    if (typeof lucide !== 'undefined') {
      lucide.createIcons();
    }
  });

  document.addEventListener('DOMContentLoaded', () => {
    if (typeof lucide !== 'undefined') {
      lucide.createIcons();
    }
  });
</script>
