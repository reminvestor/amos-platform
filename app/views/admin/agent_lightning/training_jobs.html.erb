<div class="container-fluid py-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <div>
      <nav aria-label="breadcrumb">
        <ol class="breadcrumb mb-1">
          <li class="breadcrumb-item"><%= link_to 'Agent Lightning', admin_agent_lightning_path %></li>
          <li class="breadcrumb-item active">Training Jobs</li>
        </ol>
      </nav>
      <h1 class="h3 mb-0">Training Jobs</h1>
    </div>
    <%= button_to start_training_admin_agent_lightning_path,
        method: :post,
        class: "admin-btn admin-btn-primary d-flex align-items-center gap-1" do %>
      <i data-lucide="plus" style="width: 16px; height: 16px;"></i>
      Start New Training
    <% end %>
  </div>

  <div class="admin-card">
    <% if @training_jobs.any? %>
      <div class="table-responsive">
        <table class="table table-hover mb-0">
          <thead>
            <tr>
              <th>Job ID</th>
              <th>Type</th>
              <th>Entity</th>
              <th>Status</th>
              <th>Progress</th>
              <th>Improvement</th>
              <th>Started</th>
              <th>Completed</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            <% @training_jobs.each do |job| %>
              <tr>
                <td><code><%= job.job_id[0..11] %></code></td>
                <td><span class="admin-badge"><%= job.job_type.humanize %></span></td>
                <td><%= job.entity&.name || 'N/A' %></td>
                <td>
                  <span class="admin-badge <%= job_status_badge_class(job.status).gsub('bg-', 'admin-badge-') %>">
                    <%= job.status %>
                  </span>
                </td>
                <td>
                  <% if job.running? %>
                    <div class="progress admin-progress-w-80 admin-progress-6">
                      <div class="progress-bar" style="width: <%= job.progress_percentage %>%; background: var(--accent-purple-start);"></div>
                    </div>
                    <small class="text-muted"><%= job.progress_percentage %>%</small>
                  <% else %>
                    <span class="text-muted">-</span>
                  <% end %>
                </td>
                <td>
                  <% if job.improvement_score %>
                    <% if job.improvement_score > 0 %>
                      <span style="color: var(--status-success-text);">+<%= job.improvement_score.round(1) %>%</span>
                    <% elsif job.improvement_score < 0 %>
                      <span style="color: var(--status-error-text);"><%= job.improvement_score.round(1) %>%</span>
                    <% else %>
                      <span class="text-muted">0%</span>
                    <% end %>
                  <% else %>
                    <span class="text-muted">-</span>
                  <% end %>
                </td>
                <td class="text-muted"><%= job.created_at.strftime('%b %d, %H:%M') %></td>
                <td class="text-muted">
                  <%= job.completed_at ? job.completed_at.strftime('%b %d, %H:%M') : '-' %>
                </td>
                <td>
                  <% if job.running? %>
                    <%= button_to stop_training_admin_agent_lightning_path(job_id: job.job_id),
                        method: :post,
                        class: "admin-btn admin-btn-sm admin-btn-danger-outline",
                        data: { confirm: "Stop this training job?" } do %>
                      <i data-lucide="square" style="width: 14px; height: 14px;"></i>
                    <% end %>
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>

      <% if @training_jobs.respond_to?(:total_pages) && @training_jobs.total_pages > 1 %>
        <div class="card-footer" style="background: var(--bg-tertiary); border-top: 1px solid var(--border-primary);">
          <%= paginate @training_jobs, theme: 'bootstrap-5' %>
        </div>
      <% end %>
    <% else %>
      <div class="text-center py-5 text-muted">
        <i data-lucide="cpu" style="width: 48px; height: 48px;"></i>
        <h5 class="mt-3">No Training Jobs</h5>
        <p class="mb-3">Start a training job to optimize your agents using collected traces.</p>
        <%= button_to start_training_admin_agent_lightning_path,
            method: :post,
            class: "admin-btn admin-btn-primary" do %>
          <i data-lucide="zap" style="width: 16px; height: 16px;" class="me-1"></i>
          Start Training
        <% end %>
      </div>
    <% end %>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    lucide.createIcons();
  });
</script>
