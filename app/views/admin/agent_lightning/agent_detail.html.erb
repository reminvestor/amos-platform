<div class="container-fluid py-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <div>
      <nav aria-label="breadcrumb">
        <ol class="breadcrumb mb-1">
          <li class="breadcrumb-item"><%= link_to 'Agent Lightning', admin_agent_lightning_path %></li>
          <li class="breadcrumb-item active"><%= @agent.name %></li>
        </ol>
      </nav>
      <h1 class="h3 mb-0"><%= @agent.name %></h1>
      <p class="text-muted mb-0"><%= @agent.description.to_s.truncate(100) %></p>
    </div>
    <div class="d-flex gap-2">
      <span class="admin-badge <%= @agent.status == 'active' ? 'admin-badge-success' : '' %>">
        <%= @agent.status&.capitalize || 'Unknown' %>
      </span>
    </div>
  </div>

  <!-- Agent Stats -->
  <div class="row g-3 mb-4">
    <div class="col-md-3">
      <div class="admin-card">
        <p class="text-muted mb-1 small">Total Traces</p>
        <h3 class="mb-0"><%= @traces.count %></h3>
      </div>
    </div>
    <div class="col-md-3">
      <div class="admin-card">
        <p class="text-muted mb-1 small">Optimizations</p>
        <h3 class="mb-0"><%= @optimizations.count %></h3>
      </div>
    </div>
    <div class="col-md-3">
      <div class="admin-card">
        <p class="text-muted mb-1 small">Avg Improvement</p>
        <h3 class="mb-0">
          <% avg = @optimizations.average(:improvement_percentage)&.round(1) || 0 %>
          <% if avg > 0 %>
            <span style="color: var(--status-success-text);">+<%= avg %>%</span>
          <% elsif avg < 0 %>
            <span style="color: var(--status-error-text);"><%= avg %>%</span>
          <% else %>
            <span class="text-muted">0%</span>
          <% end %>
        </h3>
      </div>
    </div>
    <div class="col-md-3">
      <div class="admin-card">
        <p class="text-muted mb-1 small">Entity</p>
        <h6 class="mb-0"><%= @agent.entity&.name || 'Global' %></h6>
      </div>
    </div>
  </div>

  <div class="row g-4">
    <!-- Performance Chart -->
    <div class="col-lg-8">
      <div class="admin-card">
        <h5 class="mb-3">Performance History (30 days)</h5>
        <% if @performance_history[:daily_traces].any? %>
          <div class="admin-h-250">
            <canvas id="performanceChart"></canvas>
          </div>
        <% else %>
          <div class="text-center py-4 text-muted">
            <i data-lucide="bar-chart-2" style="width: 48px; height: 48px;"></i>
            <p class="mb-0 mt-2">Not enough data for performance chart</p>
          </div>
        <% end %>
      </div>
    </div>

    <!-- Optimizations Applied -->
    <div class="col-lg-4">
      <div class="admin-card h-100">
        <h5 class="mb-3">Recent Optimizations</h5>
        <% if @optimizations.any? %>
          <% @optimizations.limit(5).each do |opt| %>
            <div class="d-flex justify-content-between align-items-center py-2" style="border-bottom: 1px solid var(--border-primary);">
              <div>
                <span class="admin-badge <%= optimization_status_badge_class(opt.status).gsub('bg-', 'admin-badge-') %> me-2">
                  <%= opt.status %>
                </span>
                <% if opt.improvement_percentage > 0 %>
                  <span style="color: var(--status-success-text);">+<%= opt.improvement_percentage %>%</span>
                <% elsif opt.improvement_percentage < 0 %>
                  <span style="color: var(--status-error-text);"><%= opt.improvement_percentage %>%</span>
                <% else %>
                  <span class="text-muted">0%</span>
                <% end %>
              </div>
              <small class="text-muted"><%= time_ago_in_words(opt.created_at) %> ago</small>
            </div>
          <% end %>
        <% else %>
          <div class="text-center py-4 text-muted">
            <p class="mb-0">No optimizations for this agent yet</p>
          </div>
        <% end %>
      </div>
    </div>
  </div>

  <!-- Recent Traces -->
  <div class="admin-card mt-4">
    <h5 class="mb-3">Recent Traces</h5>
    <% if @traces.any? %>
      <div class="table-responsive">
        <table class="table table-hover mb-0">
          <thead>
            <tr>
              <th>Trace ID</th>
              <th>Type</th>
              <th>Status</th>
              <th>Duration</th>
              <th>Created</th>
            </tr>
          </thead>
          <tbody>
            <% @traces.limit(20).each do |trace| %>
              <tr>
                <td><code><%= trace.trace_id[0..11] %></code></td>
                <td><span class="admin-badge"><%= trace.trace_type %></span></td>
                <td>
                  <span class="admin-badge <%= trace_status_badge_class(trace.status).gsub('bg-', 'admin-badge-') %>">
                    <%= trace.status %>
                  </span>
                </td>
                <td>
                  <% if trace.duration_ms %>
                    <%= trace.duration_ms < 1000 ? "#{trace.duration_ms}ms" : "#{(trace.duration_ms / 1000.0).round(1)}s" %>
                  <% else %>
                    <span class="text-muted">-</span>
                  <% end %>
                </td>
                <td class="text-muted"><%= trace.created_at.strftime('%b %d, %H:%M') %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <div class="text-center py-4 text-muted">
        <i data-lucide="activity" style="width: 48px; height: 48px;"></i>
        <p class="mb-0 mt-2">No traces for this agent yet</p>
      </div>
    <% end %>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
  document.addEventListener('DOMContentLoaded', () => {
    lucide.createIcons();

    <% if @performance_history[:daily_traces].any? %>
    // Get theme-aware colors
    const styles = getComputedStyle(document.documentElement);
    const gridColor = styles.getPropertyValue('--border-primary').trim() || '#333';
    const textColor = styles.getPropertyValue('--text-secondary').trim() || '#999';
    const primaryColor = styles.getPropertyValue('--accent-purple-start').trim() || '#7C3AED';

    const ctx = document.getElementById('performanceChart').getContext('2d');
    const dailyData = <%= @performance_history[:daily_traces].to_json.html_safe %>;
    const labels = Object.keys(dailyData).sort();
    const values = labels.map(l => dailyData[l]);

    new Chart(ctx, {
      type: 'line',
      data: {
        labels: labels.map(d => new Date(d).toLocaleDateString('en-US', { month: 'short', day: 'numeric' })),
        datasets: [{
          label: 'Traces',
          data: values,
          borderColor: primaryColor,
          backgroundColor: primaryColor + '20',
          fill: true,
          tension: 0.3
        }]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: {
          legend: {
            display: false
          }
        },
        scales: {
          y: {
            beginAtZero: true,
            grid: {
              color: gridColor
            },
            ticks: {
              color: textColor
            }
          },
          x: {
            grid: {
              display: false
            },
            ticks: {
              color: textColor
            }
          }
        }
      }
    });
    <% end %>
  });
</script>
