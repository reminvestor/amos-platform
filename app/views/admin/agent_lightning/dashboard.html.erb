<div class="admin-p-xl">
  <!-- Page Header -->
  <div class="admin-page-header">
    <div class="header-left">
      <div class="header-icon">
        <%= admin_icon('zap', size: :lg) %>
      </div>
      <div class="header-text">
        <h1>Agent Lightning Dashboard</h1>
        <p>Platform-wide RL training and optimization monitoring</p>
      </div>
    </div>

    <div class="header-actions">
      <%= link_to metrics_admin_agent_lightning_index_path, class: "admin-btn admin-btn-outline" do %>
        <%= admin_icon('bar-chart-3', size: :sm) %>
        <span>Metrics</span>
      <% end %>
      <%= link_to export_data_admin_agent_lightning_index_path, class: "admin-btn admin-btn-outline" do %>
        <%= admin_icon('download', size: :sm) %>
        <span>Export</span>
      <% end %>
    </div>
  </div>

  <!-- Platform Statistics -->
  <div class="admin-stats-grid">
    <%= render 'admin/shared/stat_card',
        icon: 'building',
        label: 'Entities with Lightning',
        value: @entities_with_lightning,
        variant: 'purple-gradient' %>

    <%= render 'admin/shared/stat_card',
        icon: 'database',
        label: 'Total Traces',
        value: number_with_delimiter(@total_traces),
        variant: 'info' %>

    <%= render 'admin/shared/stat_card',
        icon: 'check-circle',
        label: 'Available for Training',
        value: number_with_delimiter(@total_available_traces),
        variant: 'success' %>
  </div>

  <!-- Key Metrics -->
  <div class="admin-stats-grid admin-mb-xl">
    <%= render 'admin/shared/stat_card',
        icon: 'trending-up',
        label: 'Success Rate',
        value: "#{@success_rate}%",
        subtitle: "#{@recent_traces.count} recent traces",
        variant: 'success' %>

    <%= render 'admin/shared/stat_card',
        icon: 'cpu',
        label: 'Avg Tokens',
        value: number_with_delimiter(@avg_tokens),
        subtitle: 'Per trace',
        variant: 'info' %>

    <%= render 'admin/shared/stat_card',
        icon: 'dollar-sign',
        label: 'Avg Cost',
        value: "$#{@avg_cost}",
        subtitle: 'Per trace',
        variant: 'warning' %>

    <%= render 'admin/shared/stat_card',
        icon: 'clock',
        label: 'Avg Duration',
        value: @avg_duration,
        subtitle: 'milliseconds',
        variant: 'purple' %>
  </div>

  <!-- RL Training Health Indicators -->
  <div class="admin-card admin-mb-xl">
    <h3 class="card-title">
      <%= admin_icon('activity', size: :md, class: 'admin-inline-block admin-mr-sm') %>
      RL Training Health
    </h3>
    <p class="admin-text-muted admin-text-sm admin-mb-lg">Platform-wide training status and performance</p>

    <div class="admin-status-grid">
      <!-- Last Training Status -->
      <div class="admin-status-box admin-stat-box-<%= @last_training_status == 'completed' ? 'green' : @last_training_status == 'failed' ? 'red' : 'yellow' %>">
        <div class="admin-status-label">Last Training</div>
        <div class="admin-flex admin-items-center admin-justify-between">
          <span class="admin-status-value <%= @last_training_status == 'completed' ? 'admin-text-success' : @last_training_status == 'failed' ? 'admin-text-error' : 'admin-text-warning' %>">
            <%= @last_training_status&.titleize || 'Never' %>
          </span>
          <%= admin_icon(
            @last_training_status == 'completed' ? 'check-circle' : @last_training_status == 'failed' ? 'x-circle' : 'clock',
            size: :md,
            class: (@last_training_status == 'completed' ? 'admin-text-success' : @last_training_status == 'failed' ? 'admin-text-error' : 'admin-text-warning')
          ) %>
        </div>
        <div class="admin-status-subtitle">
          <% if @last_training_at %>
            <%= time_ago_in_words(@last_training_at) %> ago
          <% else %>
            No training runs yet
          <% end %>
        </div>
      </div>

      <!-- Performance Trend -->
      <div class="admin-status-box admin-stat-box-cyan">
        <div class="admin-status-label">Performance Trend</div>
        <div class="admin-flex admin-items-center admin-justify-between">
          <span class="admin-status-value">
            <% if @improvement_trend %>
              <%= @improvement_trend.to_s.titleize %>
              <%= @improvement_trend == :improving ? '↗' : @improvement_trend == :declining ? '↘' : '→' %>
            <% else %>
              Not enough data
            <% end %>
          </span>
          <%= admin_icon('trending-up', size: :md, class: 'admin-text-info') %>
        </div>
        <div class="admin-status-subtitle">
          <% if @last_improvement %>
            Last: <%= @last_improvement > 0 ? '+' : '' %><%= @last_improvement %>%
          <% else %>
            No recent training
          <% end %>
        </div>
      </div>

      <!-- Training Success Rate -->
      <div class="admin-status-box admin-stat-box-purple">
        <div class="admin-status-label">Training Jobs</div>
        <div class="admin-flex admin-items-center admin-justify-between">
          <span class="admin-status-value">
            <%= @successful_training_jobs %> / <%= @total_training_jobs %>
          </span>
          <%= admin_icon('zap', size: :md, class: 'admin-text-purple') %>
        </div>
        <div class="admin-status-subtitle">
          <%= @training_success_rate %>% success rate
        </div>
      </div>

      <!-- Available Traces -->
      <div class="admin-status-box admin-stat-box-red">
        <div class="admin-status-label">Available Traces</div>
        <div class="admin-flex admin-items-center admin-justify-between">
          <span class="admin-status-value">
            <%= number_with_delimiter(@total_available_traces) %>
          </span>
          <%= admin_icon('database', size: :md, class: 'admin-text-error') %>
        </div>
        <div class="admin-status-subtitle">
          Ready for next training
        </div>
      </div>
    </div>
  </div>

  <!-- Trace Statistics -->
  <div class="admin-card admin-mb-xl">
    <h3 class="card-title">
      <%= admin_icon('bar-chart-3', size: :md, class: 'admin-inline-block admin-mr-sm') %>
      Trace Statistics
    </h3>

    <div class="admin-grid-4 admin-mb-lg">
      <div>
        <p class="admin-stat-item-label">Total Traces</p>
        <p class="admin-stat-item-value"><%= number_with_delimiter(@total_traces) %></p>
      </div>
      <div>
        <p class="admin-stat-item-label">Completed</p>
        <p class="admin-stat-item-value admin-text-success"><%= number_with_delimiter(@completed_traces) %></p>
      </div>
      <div>
        <p class="admin-stat-item-label">Failed</p>
        <p class="admin-stat-item-value admin-text-error"><%= number_with_delimiter(@failed_traces) %></p>
      </div>
      <div>
        <p class="admin-stat-item-label">With Rewards</p>
        <p class="admin-stat-item-value admin-text-info"><%= number_with_delimiter(@traces_with_rewards) %></p>
      </div>
    </div>

    <% if @total_traces > 0 %>
      <div class="admin-progress-bar">
        <div class="admin-progress-segment admin-progress-success" style="width: <%= (@completed_traces.to_f / @total_traces * 100).round %>%;">
          <% if (@completed_traces.to_f / @total_traces * 100).round > 10 %>
            <%= @completed_traces %>
          <% end %>
        </div>
        <div class="admin-progress-segment admin-progress-error" style="width: <%= (@failed_traces.to_f / @total_traces * 100).round %>%;">
          <% if (@failed_traces.to_f / @total_traces * 100).round > 10 %>
            <%= @failed_traces %>
          <% end %>
        </div>
      </div>
    <% else %>
      <div class="admin-empty-state">No traces yet</div>
    <% end %>
  </div>

  <!-- Cost Summary -->
  <div class="admin-card admin-mb-xl">
    <h3 class="card-title">
      <%= admin_icon('dollar-sign', size: :md, class: 'admin-inline-block admin-mr-sm') %>
      Cost Summary
      <span class="admin-text-muted admin-text-sm admin-font-normal">(Last 100 traces)</span>
    </h3>

    <div class="admin-grid-2">
      <div>
        <p class="admin-stat-item-label">Total Cost</p>
        <p class="admin-stat-item-value admin-text-2xl admin-text-warning">$<%= @total_cost %></p>
      </div>
      <div>
        <p class="admin-stat-item-label">Average Cost</p>
        <p class="admin-stat-item-value admin-text-2xl admin-text-info">$<%= @avg_cost %></p>
        <small class="admin-text-muted admin-text-xs">per trace</small>
      </div>
    </div>
  </div>

  <!-- Last Training Job -->
  <% if @last_training_job %>
    <div class="admin-card admin-mb-xl">
      <h3 class="card-title">
        <%= admin_icon('rocket', size: :md, class: 'admin-inline-block admin-mr-sm') %>
        Last Training Job
      </h3>

      <div class="admin-stats-grid">
        <div>
          <p class="admin-stat-item-label">Date</p>
          <p class="admin-stat-item-value"><%= @last_training_job.completed_at.strftime('%Y-%m-%d %H:%M:%S') %></p>
        </div>
        <div>
          <p class="admin-stat-item-label">Type</p>
          <code class="admin-code-inline"><%= @last_training_job.job_type %></code>
        </div>
        <div>
          <p class="admin-stat-item-label">Traces Used</p>
          <p class="admin-stat-item-value"><%= @last_training_job.traces_used %></p>
        </div>
        <div>
          <p class="admin-stat-item-label">Status</p>
          <span class="admin-badge admin-badge-online"><%= @last_training_job.status.upcase %></span>
        </div>
        <div>
          <p class="admin-stat-item-label">Improvement</p>
          <p class="admin-stat-item-value admin-text-xl admin-text-success">+<%= @last_training_job.improvement_score %></p>
        </div>
      </div>

      <% if @recommendations.any? %>
        <hr class="admin-divider admin-my-lg" />
        <h4 class="admin-text-primary admin-text-base admin-mb-md">
          <%= admin_icon('lightbulb', size: :sm, class: 'admin-inline-block admin-mr-sm') %>
          Recommendations
        </h4>
        <ul class="admin-list-none admin-p-0 admin-m-0">
          <% @recommendations.each do |rec| %>
            <li class="admin-p-md admin-bg-darker admin-rounded-md admin-mb-sm">
              <strong class="admin-text-primary"><%= rec['category'] %></strong>
              <span class="admin-badge <%= rec['priority'] == 'high' ? 'admin-badge-offline' : 'admin-badge-warning' %> admin-ml-sm"><%= rec['priority'].upcase %></span>
              <br />
              <em class="admin-text-secondary admin-text-sm"><%= rec['recommendation'] %></em>
            </li>
          <% end %>
        </ul>
      <% end %>
    </div>
  <% end %>

  <!-- LLM Call Analysis -->
  <% if @llm_calls && @llm_calls.any? %>
    <div class="admin-card admin-mb-xl">
      <h3 class="card-title">
        <%= admin_icon('cpu', size: :md, class: 'admin-inline-block admin-mr-sm') %>
        LLM Call Analysis
        <span class="admin-text-muted admin-text-sm admin-font-normal">(Last 500 calls)</span>
      </h3>

      <div class="admin-grid-2 admin-mb-lg">
        <div>
          <p class="admin-stat-item-label">Success Rate</p>
          <span class="admin-badge admin-badge-online admin-text-base"><%= @llm_success_rate %>%</span>
        </div>
        <div>
          <p class="admin-stat-item-label">Avg Latency</p>
          <code class="admin-code-inline"><%= @avg_latency %>ms</code>
        </div>
      </div>

      <h4 class="admin-text-primary admin-text-sm admin-mb-md admin-uppercase admin-tracking-wide">By Agent Role</h4>
      <div class="admin-overflow-x-auto">
        <table class="admin-table">
          <thead>
            <tr>
              <th>Role</th>
              <th>Count</th>
              <th>Success Rate</th>
              <th>Avg Tokens</th>
              <th>Total Cost</th>
            </tr>
          </thead>
          <tbody>
            <% (@llm_by_role || []).each do |role_data| %>
              <tr>
                <td><code class="admin-code-inline"><%= role_data[:role] %></code></td>
                <td class="admin-text-primary"><%= role_data[:count] %></td>
                <td><span class="admin-badge admin-badge-online"><%= role_data[:success_rate] %>%</span></td>
                <td class="admin-text-secondary"><%= number_with_delimiter(role_data[:avg_tokens]) %></td>
                <td class="admin-text-warning">$<%= role_data[:total_cost] %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  <% end %>

  <!-- Top Tools -->
  <% if @top_tools && @top_tools.any? %>
    <div class="admin-card admin-mb-xl">
      <h3 class="card-title">
        <%= admin_icon('wrench', size: :md, class: 'admin-inline-block admin-mr-sm') %>
        Top Tools
        <span class="admin-text-muted admin-text-sm admin-font-normal">(Last 500 executions)</span>
      </h3>

      <p class="admin-text-secondary admin-mb-lg">
        <strong class="admin-text-primary">Overall Success Rate:</strong>
        <span class="admin-badge admin-badge-online"><%= @tool_success_rate %>%</span>
      </p>

      <div class="admin-overflow-x-auto">
        <table class="admin-table">
          <thead>
            <tr>
              <th>Tool</th>
              <th>Executions</th>
              <th>Success Rate</th>
            </tr>
          </thead>
          <tbody>
            <% @top_tools.each do |tool| %>
              <tr>
                <td><code class="admin-code-inline"><%= tool[:name] %></code></td>
                <td class="admin-text-primary"><%= number_with_delimiter(tool[:count]) %></td>
                <td>
                  <span class="admin-badge <%= tool[:success_rate] > 80 ? 'admin-badge-online' : 'admin-badge-warning' %>">
                    <%= tool[:success_rate] %>%
                  </span>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  <% end %>

  <!-- Training History -->
  <div class="admin-card">
    <h3 class="card-title">
      <%= admin_icon('history', size: :md, class: 'admin-inline-block admin-mr-sm') %>
      Training History
      <span class="admin-text-muted admin-text-sm admin-font-normal">(Last 10)</span>
    </h3>

    <% if @training_history.any? %>
      <div class="admin-overflow-x-auto">
        <table class="admin-table">
          <thead>
            <tr>
              <th>Date</th>
              <th>Entity</th>
              <th>Strategy</th>
              <th>Traces Used</th>
              <th>Improvement</th>
            </tr>
          </thead>
          <tbody>
            <% @recent_training_jobs.each do |job| %>
              <tr>
                <td class="admin-text-primary"><%= job.completed_at.strftime('%Y-%m-%d %H:%M') %></td>
                <td><code class="admin-code-inline"><%= job.job_type %></code></td>
                <td class="admin-text-secondary"><%= job.traces_used %></td>
                <td class="admin-font-semibold admin-text-success">+<%= job.improvement_score %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <div class="admin-empty-state">
        <div class="empty-icon">
          <%= admin_icon('inbox', size: :xl) %>
        </div>
      <% end %>
    </div>
  </div>
</div>

<!-- Initialize Lucide Icons -->
<script>
  document.addEventListener('turbo:load', () => {
    if (typeof lucide !== 'undefined') {
      lucide.createIcons();
    }
  });

  document.addEventListener('DOMContentLoaded', () => {
    if (typeof lucide !== 'undefined') {
      lucide.createIcons();
    }
  });
</script>
