<div class="container-fluid py-4">
  <div class="row mb-4">
    <div class="col-md-8">
      <h1>🔬 Agent Lightning Dashboard</h1>
      <p class="text-muted">Platform-wide Training Statistics</p>
    </div>
    <div class="col-md-4 text-end">
      <% if @can_train_now %>
        <%= button_to "🚀 Train Now", train_now_admin_agent_lightning_index_path, method: :post, class: "btn btn-success" %>
      <% else %>
        <button class="btn btn-secondary" disabled>Train Not Ready</button>
      <% end %>
      <%= link_to "📊 Metrics", metrics_admin_agent_lightning_index_path, class: "btn btn-info" %>
      <%= link_to "📤 Export", export_data_admin_agent_lightning_index_path, class: "btn btn-outline-secondary" %>
    </div>
  </div>

  <!-- Platform Configuration Status -->
  <div class="card mb-4">
    <div class="card-header bg-light">
      <h5 class="mb-0">📋 Platform Configuration Overview</h5>
    </div>
    <div class="card-body">
      <div class="row">
        <div class="col-md-6">
          <p><strong>Total Entities:</strong> <%= @total_entities %></p>
          <p><strong>Entities with Agent Lightning:</strong> <%= @entities_with_lightning %></p>
          <p><strong>Entities with Active Training:</strong> <%= @entity_stats&.count { |s| s[:config]&.enabled? } || 0 %></p>
        </div>
        <div class="col-md-6">
          <p><strong>Entities Ready for Training:</strong> <%= @entity_stats&.count { |s| s[:ready_for_training] } || 0 %></p>
          <p><strong>Total Training Jobs:</strong> <%= @total_training_jobs %></p>
          <p><strong>Last Platform Training:</strong> <%= @last_training_at&.strftime('%Y-%m-%d %H:%M:%S') || 'Never' %></p>
        </div>
      </div>
    </div>

  <!-- Platform Training Health -->
  <div class="card mb-4">
    <div class="card-header bg-light">
      <h5 class="mb-0">✅ Platform Training Health</h5>
    </div>
    <div class="card-body">
      <div class="row">
        <div class="col-md-4">
          <div class="alert alert-info" role="alert">
            <strong>Total Jobs:</strong> <%= @total_training_jobs %>
          </div>
        </div>
        <div class="col-md-4">
          <div class="alert <%= @successful_training_jobs.to_i > 0 ? 'alert-success' : 'alert-warning' %>" role="alert">
            <strong>Successful:</strong> <%= @successful_training_jobs || 0 %>
          </div>
        </div>
        <div class="col-md-4">
          <div class="alert <%= @failed_training_jobs.to_i > 0 ? 'alert-danger' : 'alert-success' %>" role="alert">
            <strong>Failed:</strong> <%= @failed_training_jobs || 0 %>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Key Metrics -->
  <div class="row mb-4">
    <div class="col-md-3">
      <div class="card text-center">
        <div class="card-body">
          <h6 class="card-title text-muted">Success Rate</h6>
          <h3 class="card-text text-success"><%= @success_rate %>%</h3>
          <small class="text-muted">Last 30 days</small>
        </div>
      </div>
    </div>

    <div class="admin-card">
      <div style="display: flex; align-items: center; gap: 1rem;">
        <div style="width: 3rem; height: 3rem; border-radius: 0.75rem; background: rgba(59, 130, 246, 0.1); border: 1px solid rgba(59, 130, 246, 0.2); display: flex; align-items: center; justify-content: center;">
          <i data-lucide="cpu" style="width: 1.5rem; height: 1.5rem; color: #3B82F6;"></i>
        </div>
        <div>
          <p style="color: #94A3B8; font-size: 0.875rem; margin: 0;">Avg Tokens</p>
          <h3 style="color: white; font-size: 1.875rem; font-weight: 600; margin: 0;"><%= number_with_delimiter(@avg_tokens) %></h3>
          <small style="color: #64748B; font-size: 0.75rem;">Per trace</small>
        </div>
      </div>
    </div>

    <div class="admin-card">
      <div style="display: flex; align-items: center; gap: 1rem;">
        <div style="width: 3rem; height: 3rem; border-radius: 0.75rem; background: rgba(234, 179, 8, 0.1); border: 1px solid rgba(234, 179, 8, 0.2); display: flex; align-items: center; justify-content: center;">
          <i data-lucide="dollar-sign" style="width: 1.5rem; height: 1.5rem; color: rgb(250, 204, 21);"></i>
        </div>
        <div>
          <p style="color: #94A3B8; font-size: 0.875rem; margin: 0;">Avg Cost</p>
          <h3 style="color: white; font-size: 1.875rem; font-weight: 600; margin: 0;">$<%= @avg_cost %></h3>
          <small style="color: #64748B; font-size: 0.75rem;">Per trace</small>
        </div>
      </div>
    </div>

    <div class="admin-card">
      <div style="display: flex; align-items: center; gap: 1rem;">
        <div style="width: 3rem; height: 3rem; border-radius: 0.75rem; background: rgba(168, 85, 247, 0.1); border: 1px solid rgba(168, 85, 247, 0.2); display: flex; align-items: center; justify-content: center;">
          <i data-lucide="clock" style="width: 1.5rem; height: 1.5rem; color: #A855F7;"></i>
        </div>
        <div>
          <p style="color: #94A3B8; font-size: 0.875rem; margin: 0;">Avg Duration</p>
          <h3 style="color: white; font-size: 1.875rem; font-weight: 600; margin: 0;"><%= @avg_duration %></h3>
          <small style="color: #64748B; font-size: 0.75rem;">milliseconds</small>
        </div>
      </div>
    </div>
  </div>

  <!-- RL Training Health Indicators -->
  <div class="admin-card" style="margin-bottom: 2rem;">
    <h3 class="card-title">
      <i data-lucide="activity" style="width: 1.25rem; height: 1.25rem; display: inline-block; vertical-align: middle; margin-right: 0.5rem;"></i>
      RL Training Health
    </h3>
    <p style="color: #64748B; font-size: 0.875rem; margin: 0 0 1.5rem 0;">Platform-wide training status and performance</p>

    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1rem;">
      <!-- Last Training Status -->
      <div style="padding: 0.75rem; background: <%= @last_training_status == 'completed' ? 'rgba(34, 197, 94, 0.05)' : @last_training_status == 'failed' ? 'rgba(239, 68, 68, 0.05)' : 'rgba(234, 179, 8, 0.05)' %>; border: 1px solid <%= @last_training_status == 'completed' ? 'rgba(34, 197, 94, 0.2)' : @last_training_status == 'failed' ? 'rgba(239, 68, 68, 0.2)' : 'rgba(234, 179, 8, 0.2)' %>; border-radius: 0.5rem;">
        <div style="color: #64748B; font-size: 0.75rem; font-weight: 500; text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 0.5rem;">Last Training</div>
        <div style="display: flex; align-items: center; justify-content: space-between;">
          <span style="font-size: 1.125rem; font-weight: 600; color: <%= @last_training_status == 'completed' ? '#22C55E' : @last_training_status == 'failed' ? '#EF4444' : '#EAB308' %>;">
            <%= @last_training_status&.titleize || 'Never' %>
          </span>
          <i data-lucide="<%= @last_training_status == 'completed' ? 'check-circle' : @last_training_status == 'failed' ? 'x-circle' : 'clock' %>" style="width: 1.5rem; height: 1.5rem; color: <%= @last_training_status == 'completed' ? '#22C55E' : @last_training_status == 'failed' ? '#EF4444' : '#EAB308' %>;"></i>
        </div>
        <div style="color: #64748B; font-size: 0.75rem; margin-top: 0.25rem;">
          <% if @last_training_at %>
            <%= time_ago_in_words(@last_training_at) %> ago
          <% else %>
            No training runs yet
          <% end %>
        </div>
      </div>

      <!-- Performance Trend -->
      <div style="padding: 0.75rem; background: rgba(59, 130, 246, 0.05); border: 1px solid rgba(59, 130, 246, 0.2); border-radius: 0.5rem;">
        <div style="color: #64748B; font-size: 0.75rem; font-weight: 500; text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 0.5rem;">Performance Trend</div>
        <div style="display: flex; align-items: center; justify-content: space-between;">
          <span style="font-size: 1.125rem; font-weight: 600; color: white;">
            <% if @improvement_trend %>
              <%= @improvement_trend.to_s.titleize %>
              <%= @improvement_trend == :improving ? '↗' : @improvement_trend == :declining ? '↘' : '→' %>
            <% else %>
              Not enough data
            <% end %>
          </span>
          <i data-lucide="trending-up" style="width: 1.5rem; height: 1.5rem; color: #3B82F6;"></i>
        </div>
        <div style="color: #64748B; font-size: 0.75rem; margin-top: 0.25rem;">
          <% if @last_improvement %>
            Last: <%= @last_improvement > 0 ? '+' : '' %><%= @last_improvement %>%
          <% else %>
            No recent training
          <% end %>
        </div>
      </div>

      <!-- Training Success Rate -->
      <div style="padding: 0.75rem; background: rgba(168, 85, 247, 0.05); border: 1px solid rgba(168, 85, 247, 0.2); border-radius: 0.5rem;">
        <div style="color: #64748B; font-size: 0.75rem; font-weight: 500; text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 0.5rem;">Training Jobs</div>
        <div style="display: flex; align-items: center; justify-content: space-between;">
          <span style="font-size: 1.125rem; font-weight: 600; color: white;">
            <%= @successful_training_jobs %> / <%= @total_training_jobs %>
          </span>
          <i data-lucide="zap" style="width: 1.5rem; height: 1.5rem; color: #A855F7;"></i>
        </div>
        <div style="color: #64748B; font-size: 0.75rem; margin-top: 0.25rem;">
          <%= @training_success_rate %>% success rate
        </div>
      </div>

      <!-- Available Traces -->
      <div style="padding: 0.75rem; background: rgba(236, 72, 153, 0.05); border: 1px solid rgba(236, 72, 153, 0.2); border-radius: 0.5rem;">
        <div style="color: #64748B; font-size: 0.75rem; font-weight: 500; text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 0.5rem;">Available Traces</div>
        <div style="display: flex; align-items: center; justify-content: space-between;">
          <span style="font-size: 1.125rem; font-weight: 600; color: white;">
            <%= number_with_delimiter(@total_available_traces) %>
          </span>
          <i data-lucide="database" style="width: 1.5rem; height: 1.5rem; color: #EC4899;"></i>
        </div>
        <div style="color: #64748B; font-size: 0.75rem; margin-top: 0.25rem;">
          Ready for next training
        </div>
      </div>
    </div>
  </div>

  <!-- Trace Statistics -->
  <div class="admin-card" style="margin-bottom: 2rem;">
    <h3 class="card-title">
      <i data-lucide="bar-chart-3" style="width: 1.25rem; height: 1.25rem; display: inline-block; vertical-align: middle; margin-right: 0.5rem;"></i>
      Trace Statistics
    </h3>

    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1.5rem; margin-bottom: 1.5rem;">
      <div>
        <p style="color: #94A3B8; font-size: 0.875rem; margin: 0 0 0.25rem 0;">Total Traces</p>
        <p style="color: white; font-size: 1.5rem; font-weight: 600; margin: 0;"><%= number_with_delimiter(@total_traces) %></p>
      </div>
      <div>
        <p style="color: #94A3B8; font-size: 0.875rem; margin: 0 0 0.25rem 0;">Completed</p>
        <p style="color: rgb(74, 222, 128); font-size: 1.5rem; font-weight: 600; margin: 0;"><%= number_with_delimiter(@completed_traces) %></p>
      </div>
      <div>
        <p style="color: #94A3B8; font-size: 0.875rem; margin: 0 0 0.25rem 0;">Failed</p>
        <p style="color: rgb(248, 113, 113); font-size: 1.5rem; font-weight: 600; margin: 0;"><%= number_with_delimiter(@failed_traces) %></p>
      </div>
      <div>
        <p style="color: #94A3B8; font-size: 0.875rem; margin: 0 0 0.25rem 0;">With Rewards</p>
        <p style="color: #22D3EE; font-size: 1.5rem; font-weight: 600; margin: 0;"><%= number_with_delimiter(@traces_with_rewards) %></p>
      </div>
    </div>

    <% if @total_traces > 0 %>
      <div style="width: 100%; height: 2rem; background: #0F172A; border-radius: 0.5rem; overflow: hidden; display: flex;">
        <div style="background: linear-gradient(90deg, rgb(74, 222, 128), rgb(34, 197, 94)); width: <%= (@completed_traces.to_f / @total_traces * 100).round %>%; display: flex; align-items: center; justify-content: center; color: white; font-size: 0.875rem; font-weight: 600;">
          <% if (@completed_traces.to_f / @total_traces * 100).round > 10 %>
            <%= @completed_traces %>
          <% end %>
        </div>
        <div style="background: linear-gradient(90deg, rgb(248, 113, 113), rgb(239, 68, 68)); width: <%= (@failed_traces.to_f / @total_traces * 100).round %>%; display: flex; align-items: center; justify-content: center; color: white; font-size: 0.875rem; font-weight: 600;">
          <% if (@failed_traces.to_f / @total_traces * 100).round > 10 %>
            <%= @failed_traces %>
          <% end %>
        </div>
      </div>
    <% else %>
      <div style="text-align: center; padding: 2rem; color: #64748B;">No traces yet</div>
    <% end %>
  </div>

  <!-- Cost Summary -->
  <div class="admin-card" style="margin-bottom: 2rem;">
    <h3 class="card-title">
      <i data-lucide="dollar-sign" style="width: 1.25rem; height: 1.25rem; display: inline-block; vertical-align: middle; margin-right: 0.5rem;"></i>
      Cost Summary
      <span style="color: #64748B; font-size: 0.875rem; font-weight: normal;">(Last 100 traces)</span>
    </h3>

    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1.5rem;">
      <div>
        <p style="color: #94A3B8; font-size: 0.875rem; margin: 0 0 0.25rem 0;">Total Cost</p>
        <p style="color: rgb(250, 204, 21); font-size: 2rem; font-weight: 600; margin: 0;">$<%= @total_cost %></p>
      </div>
      <div>
        <p style="color: #94A3B8; font-size: 0.875rem; margin: 0 0 0.25rem 0;">Average Cost</p>
        <p style="color: #22D3EE; font-size: 2rem; font-weight: 600; margin: 0;">$<%= @avg_cost %></p>
        <small style="color: #64748B; font-size: 0.75rem;">per trace</small>
      </div>
    </div>
  </div>

  <!-- Last Training Job -->
  <% if last_training_job = @recent_training_jobs&.first %>
    <div class="card mb-4">
      <div class="card-header bg-light">
        <h5 class="mb-0">🚀 Last Training Job</h5>
      </div>
      <div class="card-body">
        <div class="row">
          <div class="col-md-6">
            <p><strong>Date:</strong> <%= last_training_job.completed_at.strftime('%Y-%m-%d %H:%M:%S') %></p>
            <p><strong>Entity:</strong> <%= last_training_job.entity&.name || 'N/A' %></p>
            <p><strong>Type:</strong> <code><%= last_training_job.job_type %></code></p>
            <p><strong>Traces Used:</strong> <%= last_training_job.traces_used %></p>
          </div>
          <div class="col-md-6">
            <p><strong>Status:</strong> <span class="badge bg-success"><%= last_training_job.status %></span></p>
            <p><strong>Improvement:</strong> <strong class="text-success">+<%= last_training_job.improvement_score_change || 0 %>%</strong></p>
          </div>
        </div>
      </div>

      <% if @recommendations.any? %>
        <hr style="border: none; border-top: 1px solid #1E293B; margin: 1.5rem 0;" />
        <h4 style="color: white; font-size: 1rem; margin: 0 0 1rem 0;">
          <i data-lucide="lightbulb" style="width: 1rem; height: 1rem; display: inline-block; vertical-align: middle; margin-right: 0.5rem;"></i>
          Recommendations
        </h4>
        <ul style="list-style: none; padding: 0; margin: 0;">
          <% @recommendations.each do |rec| %>
            <li style="padding: 0.75rem; background: #0F172A; border-radius: 0.5rem; margin-bottom: 0.5rem;">
              <strong style="color: white;"><%= rec['category'] %></strong>
              <span class="admin-badge <%= rec['priority'] == 'high' ? 'admin-badge-offline' : 'admin-badge-warning' %>" style="margin-left: 0.5rem;"><%= rec['priority'].upcase %></span>
              <br />
              <em style="color: #94A3B8; font-size: 0.875rem;"><%= rec['recommendation'] %></em>
            </li>
          <% end %>
        </ul>
      <% end %>
    </div>
  <% end %>

  <!-- LLM Call Analysis -->
  <% if false # TODO: Enable when LLM call data is available %>
    <div class="card mb-4">
      <div class="card-header bg-light">
        <h5 class="mb-0">🤖 LLM Call Analysis (Last 500 calls)</h5>
      </div>
      <div class="card-body">
        <div class="row mb-3">
          <div class="col-md-6">
            <p><strong>Success Rate:</strong> <span class="badge bg-success"><%= @llm_success_rate %>%</span></p>
          </div>
          <div class="col-md-6">
            <p><strong>Avg Latency:</strong> <code><%= @avg_latency %>ms</code></p>
          </div>
        </div>

      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1.5rem; margin-bottom: 1.5rem;">
        <div>
          <p style="color: #94A3B8; font-size: 0.875rem; margin: 0 0 0.25rem 0;">Success Rate</p>
          <span class="admin-badge admin-badge-online" style="font-size: 1rem;"><%= @llm_success_rate %>%</span>
        </div>
        <div>
          <p style="color: #94A3B8; font-size: 0.875rem; margin: 0 0 0.25rem 0;">Avg Latency</p>
          <code style="color: #22D3EE; background: rgba(34, 211, 238, 0.1); padding: 0.25rem 0.5rem; border-radius: 0.25rem;"><%= @avg_latency %>ms</code>
        </div>
      </div>

      <h4 style="color: white; font-size: 0.875rem; margin: 0 0 1rem 0; text-transform: uppercase; letter-spacing: 0.05em;">By Agent Role</h4>
      <div style="overflow-x: auto;">
        <table class="admin-table">
          <thead>
            <tr>
              <th>Role</th>
              <th>Count</th>
              <th>Success Rate</th>
              <th>Avg Tokens</th>
              <th>Total Cost</th>
            </tr>
          </thead>
          <tbody>
            <% (@llm_by_role || []).each do |role_data| %>
              <tr>
                <td><code style="color: #22D3EE;"><%= role_data[:role] %></code></td>
                <td style="color: white;"><%= role_data[:count] %></td>
                <td><span class="admin-badge admin-badge-online"><%= role_data[:success_rate] %>%</span></td>
                <td style="color: #94A3B8;"><%= number_with_delimiter(role_data[:avg_tokens]) %></td>
                <td style="color: rgb(250, 204, 21);">$<%= role_data[:total_cost] %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  <% end %>

  <!-- Top Tools -->
  <% if @top_tools && @top_tools.any? %>
    <div class="admin-card" style="margin-bottom: 2rem;">
      <h3 class="card-title">
        <i data-lucide="wrench" style="width: 1.25rem; height: 1.25rem; display: inline-block; vertical-align: middle; margin-right: 0.5rem;"></i>
        Top Tools
        <span style="color: #64748B; font-size: 0.875rem; font-weight: normal;">(Last 500 executions)</span>
      </h3>

      <p style="color: #94A3B8; margin: 0 0 1.5rem 0;">
        <strong style="color: white;">Overall Success Rate:</strong>
        <span class="admin-badge admin-badge-online"><%= @tool_success_rate %>%</span>
      </p>

      <div style="overflow-x: auto;">
        <table class="admin-table">
          <thead>
            <tr>
              <th>Tool</th>
              <th>Executions</th>
              <th>Success Rate</th>
            </tr>
          </thead>
          <tbody>
            <% @top_tools.each do |tool| %>
              <tr>
                <td><code style="color: #22D3EE;"><%= tool[:name] %></code></td>
                <td style="color: white;"><%= number_with_delimiter(tool[:count]) %></td>
                <td>
                  <span class="admin-badge <%= tool[:success_rate] > 80 ? 'admin-badge-online' : 'admin-badge-warning' %>">
                    <%= tool[:success_rate] %>%
                  </span>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  <% end %>

  <!-- Training History -->
  <div class="card mt-4">
    <div class="card-header bg-light">
      <h5 class="mb-0">📜 Training History (Last 10)</h5>
    </div>
    <div class="card-body">
      <% if @recent_training_jobs&.any? %>
        <table class="table table-sm">
          <thead>
            <tr>
              <th>Date</th>
              <th>Entity</th>
              <th>Strategy</th>
              <th>Traces Used</th>
              <th>Improvement</th>
            </tr>
          </thead>
          <tbody>
            <% @recent_training_jobs.each do |job| %>
              <tr>
                <td><%= job.completed_at.strftime('%Y-%m-%d %H:%M') %></td>
                <td><%= job.entity&.name || 'N/A' %></td>
                <td><code><%= job.job_type %></code></td>
                <td><%= job.traces_used %></td>
                <td><strong class="text-success">+<%= job.improvement_score_change || 0 %>%</strong></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      <% else %>
        <div class="alert alert-info">
          <p class="mb-0">No training jobs yet. Training history will appear here once jobs are completed.</p>
        </div>
      <% end %>
    </div>
  </div>
</div>

<!-- Initialize Lucide Icons -->
<script>
  document.addEventListener('turbo:load', () => {
    if (typeof lucide !== 'undefined') {
      lucide.createIcons();
    }
  });

  document.addEventListener('DOMContentLoaded', () => {
    if (typeof lucide !== 'undefined') {
      lucide.createIcons();
    }
  });
</script>


