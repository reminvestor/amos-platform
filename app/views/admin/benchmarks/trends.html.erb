<% content_for :title, "Benchmark Trends" %>

<div class="container-fluid py-4">
  <div class="row mb-4">
    <div class="col-12">
      <div class="d-flex justify-content-between align-items-center">
        <div>
          <%= link_to admin_benchmarks_path, class: "text-muted text-decoration-none" do %>
            <i class="bi bi-arrow-left me-1"></i> Back to Benchmarks
          <% end %>
          <h1 class="h3 mb-1 mt-2">Benchmark Trends</h1>
          <p class="text-muted mb-0">Performance over the last <%= @days %> days</p>
        </div>
        <div class="btn-group">
          <%= link_to "7 Days", admin_benchmarks_trends_path(days: 7), class: "btn btn-outline-secondary #{@days == 7 ? 'active' : ''}" %>
          <%= link_to "30 Days", admin_benchmarks_trends_path(days: 30), class: "btn btn-outline-secondary #{@days == 30 ? 'active' : ''}" %>
          <%= link_to "90 Days", admin_benchmarks_trends_path(days: 90), class: "btn btn-outline-secondary #{@days == 90 ? 'active' : ''}" %>
        </div>
      </div>
    </div>
  </div>

  <!-- Summary Cards -->
  <div class="row mb-4">
    <div class="col-md-4">
      <div class="card bg-dark text-light">
        <div class="card-body">
          <h6 class="text-muted">Total Runs</h6>
          <h2><%= @runs_by_day.values.sum %></h2>
        </div>
      </div>
    </div>
    <div class="col-md-4">
      <div class="card bg-dark text-light">
        <div class="card-body">
          <h6 class="text-muted">Average Accuracy</h6>
          <% avg_accuracy = @accuracy_trend.values.compact.sum / [@accuracy_trend.values.compact.size, 1].max %>
          <h2><%= avg_accuracy.round(1) %>%</h2>
        </div>
      </div>
    </div>
    <div class="col-md-4">
      <div class="card bg-dark text-light">
        <div class="card-body">
          <h6 class="text-muted">Best Category</h6>
          <% best = @category_performance.max_by { |_, v| v.to_f } %>
          <h2><%= best&.first&.titleize || 'N/A' %></h2>
          <p class="text-muted mb-0"><%= best&.last&.round(1) %>% accuracy</p>
        </div>
      </div>
    </div>
  </div>

  <!-- Accuracy Trend Chart -->
  <div class="row mb-4">
    <div class="col-12">
      <div class="card bg-dark text-light">
        <div class="card-header">
          <h5 class="mb-0"><i class="bi bi-graph-up me-2"></i>Accuracy Over Time</h5>
        </div>
        <div class="card-body">
          <% if @accuracy_trend.any? %>
            <div style="height: 300px;">
              <canvas id="accuracyChart"></canvas>
            </div>
          <% else %>
            <p class="text-center text-muted py-5">No data available for this period</p>
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <!-- Category Performance -->
  <div class="row">
    <div class="col-md-6">
      <div class="card bg-dark text-light">
        <div class="card-header">
          <h5 class="mb-0"><i class="bi bi-bar-chart me-2"></i>Performance by Category</h5>
        </div>
        <div class="card-body">
          <% if @category_performance.any? %>
            <% @category_performance.sort_by { |_, v| -v.to_f }.each do |category, accuracy| %>
              <div class="mb-3">
                <div class="d-flex justify-content-between mb-1">
                  <span><%= category.titleize %></span>
                  <span><%= accuracy&.round(1) || 0 %>%</span>
                </div>
                <div class="progress" style="height: 8px;">
                  <div class="progress-bar <%= accuracy.to_f >= 80 ? 'bg-success' : accuracy.to_f >= 60 ? 'bg-warning' : 'bg-danger' %>" 
                       style="width: <%= accuracy || 0 %>%"></div>
                </div>
              </div>
            <% end %>
          <% else %>
            <p class="text-center text-muted">No category data available</p>
          <% end %>
        </div>
      </div>
    </div>
    <div class="col-md-6">
      <div class="card bg-dark text-light">
        <div class="card-header">
          <h5 class="mb-0"><i class="bi bi-calendar3 me-2"></i>Runs by Day</h5>
        </div>
        <div class="card-body">
          <% if @runs_by_day.any? %>
            <div style="height: 250px;">
              <canvas id="runsChart"></canvas>
            </div>
          <% else %>
            <p class="text-center text-muted">No runs in this period</p>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>

<% if @accuracy_trend.any? || @runs_by_day.any? %>
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
document.addEventListener('DOMContentLoaded', function() {
  // Accuracy Chart
  <% if @accuracy_trend.any? %>
  const accuracyCtx = document.getElementById('accuracyChart').getContext('2d');
  new Chart(accuracyCtx, {
    type: 'line',
    data: {
      labels: <%= raw @accuracy_trend.keys.map { |d| d.strftime('%b %d') }.to_json %>,
      datasets: [{
        label: 'Accuracy %',
        data: <%= raw @accuracy_trend.values.map { |v| v&.round(1) || 0 }.to_json %>,
        borderColor: '#0d6efd',
        backgroundColor: 'rgba(13, 110, 253, 0.1)',
        fill: true,
        tension: 0.4
      }]
    },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      scales: {
        y: {
          beginAtZero: true,
          max: 100,
          grid: { color: '#333' },
          ticks: { color: '#999' }
        },
        x: {
          grid: { color: '#333' },
          ticks: { color: '#999' }
        }
      },
      plugins: {
        legend: { labels: { color: '#999' } }
      }
    }
  });
  <% end %>

  // Runs Chart
  <% if @runs_by_day.any? %>
  const runsCtx = document.getElementById('runsChart').getContext('2d');
  new Chart(runsCtx, {
    type: 'bar',
    data: {
      labels: <%= raw @runs_by_day.keys.map { |d| d.strftime('%b %d') }.to_json %>,
      datasets: [{
        label: 'Runs',
        data: <%= raw @runs_by_day.values.to_json %>,
        backgroundColor: '#198754'
      }]
    },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      scales: {
        y: {
          beginAtZero: true,
          grid: { color: '#333' },
          ticks: { color: '#999', stepSize: 1 }
        },
        x: {
          grid: { color: '#333' },
          ticks: { color: '#999' }
        }
      },
      plugins: {
        legend: { labels: { color: '#999' } }
      }
    }
  });
  <% end %>
});
</script>
<% end %>

