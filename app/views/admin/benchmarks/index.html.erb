<% content_for :title, "Benchmarks" %>

<div class="container-fluid py-4">
  <div class="row mb-4">
    <div class="col-12">
      <div class="d-flex justify-content-between align-items-center">
        <div>
          <h1 class="h3 mb-1">Business Operations Benchmark</h1>
          <p class="text-muted mb-0">
            Test Scout's capabilities across <%= @task_count %> business scenarios
          </p>
        </div>
        <div class="d-flex gap-2">
          <%= link_to trends_admin_benchmarks_path, class: "btn btn-outline-secondary" do %>
            <i class="bi bi-graph-up me-1"></i> Trends
          <% end %>
          <%= button_to cleanup_admin_benchmarks_path, method: :post, class: "btn btn-outline-danger", data: { confirm: "Clean up all test data?" } do %>
            <i class="bi bi-trash me-1"></i> Cleanup
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <!-- Test Environment Status -->
  <div class="row mb-4">
    <div class="col-md-4">
      <div class="card bg-dark text-light">
        <div class="card-body">
          <h6 class="card-subtitle mb-2 text-muted">Test Environment</h6>
          <% if @test_env_status[:error] %>
            <span class="badge bg-danger">Not Ready</span>
            <p class="small text-danger mt-2"><%= @test_env_status[:error] %></p>
          <% else %>
            <span class="badge bg-success">Ready</span>
            <p class="small text-muted mt-2 mb-0">
              Entity: <%= @test_env_status[:entity_name] %><br>
              Data: <%= @test_env_status[:data_counts].values.sum %> objects
            </p>
          <% end %>
        </div>
      </div>
    </div>
    <div class="col-md-4">
      <div class="card bg-dark text-light">
        <div class="card-body">
          <h6 class="card-subtitle mb-2 text-muted">Task Breakdown</h6>
          <div class="d-flex gap-3">
            <% @difficulty_breakdown.each do |diff, count| %>
              <div>
                <span class="badge <%= diff == :easy ? 'bg-success' : diff == :medium ? 'bg-warning' : 'bg-danger' %>">
                  <%= diff.to_s.titleize %>
                </span>
                <span class="ms-1"><%= count %></span>
              </div>
            <% end %>
          </div>
        </div>
      </div>
    </div>
    <div class="col-md-4">
      <div class="card bg-dark text-light">
        <div class="card-body">
          <h6 class="card-subtitle mb-2 text-muted">Categories</h6>
          <p class="mb-0"><%= @categories.keys.count %> categories</p>
        </div>
      </div>
    </div>
  </div>

  <!-- Run New Benchmark -->
  <div class="row mb-4">
    <div class="col-12">
      <div class="card bg-dark text-light">
        <div class="card-header">
          <h5 class="mb-0"><i class="bi bi-play-circle me-2"></i>Run New Benchmark</h5>
        </div>
        <div class="card-body">
          <%= form_with url: admin_benchmarks_path, method: :post, local: true, class: "row g-3" do |f| %>
            <div class="col-md-4">
              <label class="form-label">Category</label>
              <select name="category" class="form-select bg-dark text-light border-secondary">
                <option value="all">All Categories</option>
                <% @categories.each do |key, name| %>
                  <option value="<%= key %>"><%= name %></option>
                <% end %>
              </select>
            </div>
            <div class="col-md-3">
              <label class="form-label">Run Type</label>
              <select name="run_type" class="form-select bg-dark text-light border-secondary">
                <option value="quick">Quick (5 tasks)</option>
                <option value="standard">Standard (25 tasks)</option>
                <option value="full">Full (all tasks)</option>
                <option value="creation_only">Creation Only</option>
                <option value="grounded_only">Grounded Only</option>
              </select>
            </div>
            <div class="col-md-3">
              <label class="form-label">Options</label>
              <div class="form-check">
                <input type="checkbox" name="cleanup_before" value="true" class="form-check-input" id="cleanupBefore" checked>
                <label class="form-check-label" for="cleanupBefore">Clean up before run</label>
              </div>
            </div>
            <div class="col-md-2 d-flex align-items-end">
              <button type="submit" class="btn btn-primary w-100">
                <i class="bi bi-play-fill me-1"></i> Start
              </button>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <!-- Recent Runs -->
  <div class="row">
    <div class="col-12">
      <div class="card bg-dark text-light">
        <div class="card-header d-flex justify-content-between align-items-center">
          <h5 class="mb-0"><i class="bi bi-clock-history me-2"></i>Recent Runs</h5>
        </div>
        <div class="card-body p-0">
          <% if @recent_runs.any? %>
            <table class="table table-dark table-hover mb-0">
              <thead>
                <tr>
                  <th>Date</th>
                  <th>Category</th>
                  <th>Type</th>
                  <th>Tasks</th>
                  <th>Accuracy</th>
                  <th>Time</th>
                  <th>Actions</th>
                </tr>
              </thead>
              <tbody>
                <% @recent_runs.each do |run| %>
                  <tr>
                    <td>
                      <span title="<%= run.created_at.strftime('%Y-%m-%d %H:%M:%S') %>">
                        <%= time_ago_in_words(run.created_at) %> ago
                      </span>
                    </td>
                    <td><%= run.benchmark_category.titleize %></td>
                    <td><span class="badge bg-secondary"><%= run.run_type %></span></td>
                    <td>
                      <% if run.total_tasks.present? %>
                        <%= run.correct_tasks %>/<%= run.total_tasks %>
                      <% else %>
                        <span class="spinner-border spinner-border-sm" role="status"></span>
                      <% end %>
                    </td>
                    <td>
                      <% if run.overall_accuracy.present? %>
                        <span class="badge <%= run.overall_accuracy >= 80 ? 'bg-success' : run.overall_accuracy >= 60 ? 'bg-warning' : 'bg-danger' %>">
                          <%= run.overall_accuracy.round(1) %>%
                        </span>
                      <% else %>
                        -
                      <% end %>
                    </td>
                    <td>
                      <% if run.avg_execution_time_ms.present? %>
                        <%= (run.avg_execution_time_ms / 1000.0).round(1) %>s avg
                      <% else %>
                        -
                      <% end %>
                    </td>
                    <td>
                      <%= link_to admin_benchmark_path(run), class: "btn btn-sm btn-outline-light" do %>
                        <i class="bi bi-eye"></i> View
                      <% end %>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          <% else %>
            <div class="text-center py-5 text-muted">
              <i class="bi bi-inbox display-4"></i>
              <p class="mt-3">No benchmark runs yet. Start one above!</p>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>

