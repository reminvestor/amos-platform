<% content_for :title, "Benchmark Run ##{@benchmark_run.id}" %>

<div class="container-fluid py-4">
  <!-- Header -->
  <div class="row mb-4">
    <div class="col-12">
      <div class="d-flex justify-content-between align-items-center">
        <div>
          <%= link_to admin_benchmarks_path, class: "text-muted text-decoration-none" do %>
            <i data-lucide="arrow-left" style="width: 16px; height: 16px;"></i> Back to Benchmarks
          <% end %>
          <h1 class="h3 mb-1 mt-2">
            Benchmark Run: <%= @benchmark_run.benchmark_category.titleize %>
          </h1>
          <p class="text-muted mb-0">
            <%= @benchmark_run.created_at.strftime('%B %d, %Y at %I:%M %p') %>
            · <%= @benchmark_run.run_type.titleize %> run
          </p>
        </div>
        <div>
          <span class="admin-badge fs-5 <%= @benchmark_run.overall_accuracy.to_f >= 80 ? 'admin-badge-success' : @benchmark_run.overall_accuracy.to_f >= 60 ? 'admin-badge-warning' : 'admin-badge-danger' %>">
            <%= @benchmark_run.overall_accuracy&.round(1) || 0 %>% Accuracy
          </span>
        </div>
      </div>
    </div>
  </div>

  <!-- Summary Stats -->
  <div class="row mb-4">
    <div class="col-md-3">
      <div class="admin-card text-center">
        <h2 class="mb-0"><%= @benchmark_run.total_tasks || 0 %></h2>
        <p class="text-muted mb-0">Total Tasks</p>
      </div>
    </div>
    <div class="col-md-3">
      <div class="admin-card text-center">
        <h2 class="mb-0" style="color: var(--status-success-text);"><%= @benchmark_run.correct_tasks || 0 %></h2>
        <p class="text-muted mb-0">Correct</p>
      </div>
    </div>
    <div class="col-md-3">
      <div class="admin-card text-center">
        <h2 class="mb-0"><%= (@benchmark_run.avg_execution_time_ms.to_f / 1000).round(1) %>s</h2>
        <p class="text-muted mb-0">Avg Time</p>
      </div>
    </div>
    <div class="col-md-3">
      <div class="admin-card text-center">
        <% collab_helped = @benchmark_run.metadata&.dig('collaboration_helped_count') || 0 %>
        <h2 class="mb-0"><%= collab_helped %></h2>
        <p class="text-muted mb-0">Collaboration Helped</p>
      </div>
    </div>
  </div>

  <!-- Task Results -->
  <div class="row">
    <div class="col-12">
      <div class="admin-card">
        <h5 class="mb-3"><i data-lucide="list-checks" class="me-2" style="width: 20px; height: 20px;"></i>Task Results</h5>
        <div class="accordion accordion-flush" id="taskResults">
          <% @task_results.each_with_index do |result, idx| %>
            <div class="accordion-item" style="background: var(--bg-card); border-color: var(--border-primary);">
              <h2 class="accordion-header">
                <button class="accordion-button collapsed" type="button"
                        data-bs-toggle="collapse" data-bs-target="#task<%= idx %>"
                        style="background: var(--bg-tertiary); color: var(--text-primary);">
                  <span class="me-3">
                    <% if result.correct %>
                      <i data-lucide="check-circle" style="width: 18px; height: 18px; color: var(--status-success-text);"></i>
                    <% else %>
                      <i data-lucide="x-circle" style="width: 18px; height: 18px; color: var(--status-error-text);"></i>
                    <% end %>
                  </span>
                  <span class="flex-grow-1">
                    <strong><%= result.task_id %></strong>
                    <span class="text-muted ms-2"><%= result.task_description.to_s.truncate(80) %></span>
                  </span>
                  <span class="admin-badge me-3"><%= result.execution_time_ms %>ms</span>
                  <% if result.asked_for_help %>
                    <span class="admin-badge admin-badge-info me-3" title="Used collaboration">
                      <i data-lucide="users" style="width: 14px; height: 14px;"></i>
                    </span>
                  <% end %>
                </button>
              </h2>
              <div id="task<%= idx %>" class="accordion-collapse collapse" data-bs-parent="#taskResults">
                <div class="accordion-body" style="background: var(--bg-card);">
                  <div class="row">
                    <div class="col-md-6">
                      <h6 class="text-muted">Expected (Rubric)</h6>
                      <pre class="p-2 rounded small" style="background: var(--bg-tertiary);"><%= result.expected_answer %></pre>
                    </div>
                    <div class="col-md-6">
                      <h6 class="text-muted">Actual Response</h6>
                      <pre class="p-2 rounded small admin-scroll-300" style="background: var(--bg-tertiary);"><%= result.actual_answer.to_s.truncate(2000) %></pre>
                    </div>
                  </div>

                  <% if result.raw_output.present? %>
                    <hr style="border-color: var(--border-primary);">
                    <h6 class="text-muted">Execution Details</h6>
                    <div class="row">
                      <div class="col-md-4">
                        <strong>Tools Used:</strong>
                        <% tools = result.raw_output['tools_used'] || [] %>
                        <% if tools.any? %>
                          <ul class="mb-0 small">
                            <% tools.each do |tool| %>
                              <li><code><%= tool %></code></li>
                            <% end %>
                          </ul>
                        <% else %>
                          <span class="text-muted">None</span>
                        <% end %>
                      </div>
                      <div class="col-md-4">
                        <strong>Agents Used:</strong>
                        <% agents = result.raw_output['agents_used'] || [] %>
                        <% if agents.any? %>
                          <ul class="mb-0 small">
                            <% agents.each do |agent| %>
                              <li><%= agent %></li>
                            <% end %>
                          </ul>
                        <% else %>
                          <span class="text-muted">None</span>
                        <% end %>
                      </div>
                      <div class="col-md-4">
                        <strong>Grounded:</strong>
                        <span style="color: <%= result.raw_output['grounded'] ? 'var(--status-success-text)' : 'var(--status-warning-text)' %>;">
                          <%= result.raw_output['grounded'] ? 'Yes' : 'No' %>
                        </span>
                      </div>
                    </div>

                    <% if result.raw_output['creation_summary'].present? %>
                      <div class="mt-3">
                        <strong>Created Assets:</strong>
                        <span class="admin-badge admin-badge-info">
                          <%= result.raw_output.dig('creation_summary', 'total_created') || 0 %> created,
                          <%= result.raw_output.dig('creation_summary', 'total_verified') || 0 %> verified
                        </span>
                      </div>
                    <% end %>

                    <% if result.raw_output['integration_verifications'].present? %>
                      <div class="mt-3">
                        <strong>Integration Tests:</strong>
                        <% result.raw_output['integration_verifications'].each do |v| %>
                          <div class="small">
                            <%= v['integration_name'] %>:
                            <% if v['test_success'] %>
                              <span style="color: var(--status-success-text);">✓ API test passed</span>
                            <% elsif v['verified'] %>
                              <span style="color: var(--status-warning-text);">✓ Created (not tested)</span>
                            <% else %>
                              <span style="color: var(--status-error-text);">✗ <%= v['error'] %></span>
                            <% end %>
                          </div>
                        <% end %>
                      </div>
                    <% end %>
                  <% end %>
                </div>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>

