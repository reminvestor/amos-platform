<% content_for :title, "Benchmark Run ##{@benchmark_run.id}" %>

<div class="container-fluid py-4">
  <!-- Header -->
  <div class="row mb-4">
    <div class="col-12">
      <div class="d-flex justify-content-between align-items-center">
        <div>
          <%= link_to admin_benchmarks_path, class: "text-muted text-decoration-none" do %>
            <i class="bi bi-arrow-left me-1"></i> Back to Benchmarks
          <% end %>
          <h1 class="h3 mb-1 mt-2">
            Benchmark Run: <%= @benchmark_run.benchmark_category.titleize %>
          </h1>
          <p class="text-muted mb-0">
            <%= @benchmark_run.created_at.strftime('%B %d, %Y at %I:%M %p') %>
            · <%= @benchmark_run.run_type.titleize %> run
          </p>
        </div>
        <div>
          <span class="badge fs-5 <%= @benchmark_run.overall_accuracy.to_f >= 80 ? 'bg-success' : @benchmark_run.overall_accuracy.to_f >= 60 ? 'bg-warning' : 'bg-danger' %>">
            <%= @benchmark_run.overall_accuracy&.round(1) || 0 %>% Accuracy
          </span>
        </div>
      </div>
    </div>
  </div>

  <!-- Summary Stats -->
  <div class="row mb-4">
    <div class="col-md-3">
      <div class="card bg-dark text-light">
        <div class="card-body text-center">
          <h2 class="mb-0"><%= @benchmark_run.total_tasks || 0 %></h2>
          <p class="text-muted mb-0">Total Tasks</p>
        </div>
      </div>
    </div>
    <div class="col-md-3">
      <div class="card bg-dark text-light">
        <div class="card-body text-center">
          <h2 class="mb-0 text-success"><%= @benchmark_run.correct_tasks || 0 %></h2>
          <p class="text-muted mb-0">Correct</p>
        </div>
      </div>
    </div>
    <div class="col-md-3">
      <div class="card bg-dark text-light">
        <div class="card-body text-center">
          <h2 class="mb-0"><%= (@benchmark_run.avg_execution_time_ms.to_f / 1000).round(1) %>s</h2>
          <p class="text-muted mb-0">Avg Time</p>
        </div>
      </div>
    </div>
    <div class="col-md-3">
      <div class="card bg-dark text-light">
        <div class="card-body text-center">
          <% collab_helped = @benchmark_run.metadata&.dig('collaboration_helped_count') || 0 %>
          <h2 class="mb-0"><%= collab_helped %></h2>
          <p class="text-muted mb-0">Collaboration Helped</p>
        </div>
      </div>
    </div>
  </div>

  <!-- Task Results -->
  <div class="row">
    <div class="col-12">
      <div class="card bg-dark text-light">
        <div class="card-header">
          <h5 class="mb-0"><i class="bi bi-list-check me-2"></i>Task Results</h5>
        </div>
        <div class="card-body p-0">
          <div class="accordion accordion-flush" id="taskResults">
            <% @task_results.each_with_index do |result, idx| %>
              <div class="accordion-item bg-dark border-secondary">
                <h2 class="accordion-header">
                  <button class="accordion-button collapsed bg-dark text-light" type="button" 
                          data-bs-toggle="collapse" data-bs-target="#task<%= idx %>">
                    <span class="me-3">
                      <% if result.correct %>
                        <i class="bi bi-check-circle-fill text-success"></i>
                      <% else %>
                        <i class="bi bi-x-circle-fill text-danger"></i>
                      <% end %>
                    </span>
                    <span class="flex-grow-1">
                      <strong><%= result.task_id %></strong>
                      <span class="text-muted ms-2"><%= result.task_description.to_s.truncate(80) %></span>
                    </span>
                    <span class="badge bg-secondary me-3"><%= result.execution_time_ms %>ms</span>
                    <% if result.asked_for_help %>
                      <span class="badge bg-info me-3" title="Used collaboration">
                        <i class="bi bi-people"></i>
                      </span>
                    <% end %>
                  </button>
                </h2>
                <div id="task<%= idx %>" class="accordion-collapse collapse" data-bs-parent="#taskResults">
                  <div class="accordion-body">
                    <div class="row">
                      <div class="col-md-6">
                        <h6 class="text-muted">Expected (Rubric)</h6>
                        <pre class="bg-secondary p-2 rounded small"><%= result.expected_answer %></pre>
                      </div>
                      <div class="col-md-6">
                        <h6 class="text-muted">Actual Response</h6>
                        <pre class="bg-secondary p-2 rounded small" style="max-height: 300px; overflow-y: auto;"><%= result.actual_answer.to_s.truncate(2000) %></pre>
                      </div>
                    </div>
                    
                    <% if result.raw_output.present? %>
                      <hr class="border-secondary">
                      <h6 class="text-muted">Execution Details</h6>
                      <div class="row">
                        <div class="col-md-4">
                          <strong>Tools Used:</strong>
                          <% tools = result.raw_output['tools_used'] || [] %>
                          <% if tools.any? %>
                            <ul class="mb-0 small">
                              <% tools.each do |tool| %>
                                <li><code><%= tool %></code></li>
                              <% end %>
                            </ul>
                          <% else %>
                            <span class="text-muted">None</span>
                          <% end %>
                        </div>
                        <div class="col-md-4">
                          <strong>Agents Used:</strong>
                          <% agents = result.raw_output['agents_used'] || [] %>
                          <% if agents.any? %>
                            <ul class="mb-0 small">
                              <% agents.each do |agent| %>
                                <li><%= agent %></li>
                              <% end %>
                            </ul>
                          <% else %>
                            <span class="text-muted">None</span>
                          <% end %>
                        </div>
                        <div class="col-md-4">
                          <strong>Grounded:</strong>
                          <span class="<%= result.raw_output['grounded'] ? 'text-success' : 'text-warning' %>">
                            <%= result.raw_output['grounded'] ? 'Yes' : 'No' %>
                          </span>
                        </div>
                      </div>
                      
                      <% if result.raw_output['creation_summary'].present? %>
                        <div class="mt-3">
                          <strong>Created Assets:</strong>
                          <span class="badge bg-info">
                            <%= result.raw_output.dig('creation_summary', 'total_created') || 0 %> created,
                            <%= result.raw_output.dig('creation_summary', 'total_verified') || 0 %> verified
                          </span>
                        </div>
                      <% end %>
                      
                      <% if result.raw_output['integration_verifications'].present? %>
                        <div class="mt-3">
                          <strong>Integration Tests:</strong>
                          <% result.raw_output['integration_verifications'].each do |v| %>
                            <div class="small">
                              <%= v['integration_name'] %>: 
                              <% if v['test_success'] %>
                                <span class="text-success">✓ API test passed</span>
                              <% elsif v['verified'] %>
                                <span class="text-warning">✓ Created (not tested)</span>
                              <% else %>
                                <span class="text-danger">✗ <%= v['error'] %></span>
                              <% end %>
                            </div>
                          <% end %>
                        </div>
                      <% end %>
                    <% end %>
                  </div>
                </div>
              </div>
            <% end %>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

