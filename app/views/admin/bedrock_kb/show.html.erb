<div class="container-fluid mt-4">
  <div class="row">
    <div class="col-12">
      <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Bedrock KB: <%= @entity.name %></h1>
        <%= link_to "Back to KB Management", admin_bedrock_kb_index_path, class: "btn btn-secondary" %>
      </div>

      <!-- Flash Messages -->
      <% if flash[:success] %>
        <div class="alert alert-success alert-dismissible fade show" role="alert">
          <%= flash[:success] %>
          <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
      <% end %>
      <% if flash[:error] %>
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
          <%= flash[:error] %>
          <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
      <% end %>

      <!-- Current RAG Mode -->
      <div class="card mb-4">
        <div class="card-header bg-primary text-white">
          <h5 class="mb-0">Current RAG Mode</h5>
        </div>
        <div class="card-body">
          <div class="row">
            <div class="col-md-6">
              <h3>
                <span class="badge bg-<%= @selector.mode == :bedrock_kb ? 'success' : 'secondary' %>">
                  <%= @selector.mode_info[:name] %>
                </span>
              </h3>
              <p class="text-muted"><%= @selector.mode_info[:description] %></p>
            </div>
            <div class="col-md-6">
              <h6>Available Modes:</h6>
              <% @selector.available_modes.each do |mode| %>
                <span class="badge bg-info me-2"><%= mode %></span>
              <% end %>
            </div>
          </div>
        </div>
      </div>

      <!-- Knowledge Base Status -->
      <div class="card mb-4">
        <div class="card-header">
          <h5 class="mb-0">Knowledge Base Status</h5>
        </div>
        <div class="card-body">
          <% if @entity.bedrock_knowledge_base_id.present? %>
            <% if @kb_error %>
              <div class="alert alert-danger">
                <strong>Error:</strong> <%= @kb_error %>
              </div>
            <% elsif @kb_details %>
              <dl class="row">
                <dt class="col-sm-3">Knowledge Base ID</dt>
                <dd class="col-sm-9"><code><%= @kb_details.knowledge_base_id %></code></dd>

                <dt class="col-sm-3">Name</dt>
                <dd class="col-sm-9"><%= @kb_details.name %></dd>

                <dt class="col-sm-3">Status</dt>
                <dd class="col-sm-9">
                  <span class="badge bg-<%= @kb_details.status == 'ACTIVE' ? 'success' : 'warning' %>">
                    <%= @kb_details.status %>
                  </span>
                </dd>

                <dt class="col-sm-3">Created At</dt>
                <dd class="col-sm-9"><%= @kb_details.created_at.strftime("%B %d, %Y at %I:%M %p") rescue @kb_details.created_at %></dd>

                <dt class="col-sm-3">Updated At</dt>
                <dd class="col-sm-9"><%= @kb_details.updated_at.strftime("%B %d, %Y at %I:%M %p") rescue @kb_details.updated_at %></dd>

                <% if @kb_details.description %>
                  <dt class="col-sm-3">Description</dt>
                  <dd class="col-sm-9"><%= @kb_details.description %></dd>
                <% end %>
              </dl>

              <% if @ingestion_status %>
                <hr>
                <h6>Last Ingestion Job</h6>
                <dl class="row">
                  <dt class="col-sm-3">Job ID</dt>
                  <dd class="col-sm-9"><code><%= @ingestion_status[:job_id] %></code></dd>

                  <dt class="col-sm-3">Status</dt>
                  <dd class="col-sm-9">
                    <span class="badge bg-<%= @ingestion_status[:status] == 'COMPLETE' ? 'success' : 'warning' %>">
                      <%= @ingestion_status[:status] %>
                    </span>
                  </dd>

                  <dt class="col-sm-3">Started At</dt>
                  <dd class="col-sm-9"><%= @ingestion_status[:started_at] %></dd>

                  <% if @ingestion_status[:completed_at] %>
                    <dt class="col-sm-3">Completed At</dt>
                    <dd class="col-sm-9"><%= @ingestion_status[:completed_at] %></dd>
                  <% end %>

                  <% if @ingestion_status[:failure_reasons] %>
                    <dt class="col-sm-3">Failure Reasons</dt>
                    <dd class="col-sm-9">
                      <div class="alert alert-danger">
                        <%= @ingestion_status[:failure_reasons].join(", ") %>
                      </div>
                    </dd>
                  <% end %>

                  <% if @ingestion_status[:statistics] %>
                    <dt class="col-sm-3">Statistics</dt>
                    <dd class="col-sm-9">
                      <ul>
                        <% @ingestion_status[:statistics].each do |key, value| %>
                          <li><strong><%= key.to_s.humanize %>:</strong> <%= value %></li>
                        <% end %>
                      </ul>
                    </dd>
                  <% end %>
                </dl>
              <% end %>
            <% end %>
          <% else %>
            <div class="alert alert-info">
              <strong>No Knowledge Base Configured</strong>
              <p class="mb-0">This entity does not have a Bedrock Knowledge Base yet. Create one to enable fully managed RAG with OpenSearch Serverless.</p>
            </div>
          <% end %>
        </div>
      </div>

      <!-- Actions -->
      <div class="card">
        <div class="card-header">
          <h5 class="mb-0">Actions</h5>
        </div>
        <div class="card-body">
          <div class="row">
            <div class="col-md-6 mb-3">
              <% if @entity.bedrock_knowledge_base_id.blank? %>
                <%= button_to "Create Knowledge Base",
                    create_kb_admin_bedrock_kb_path(@entity),
                    method: :post,
                    class: "btn btn-success btn-lg w-100",
                    data: { confirm: "Create a new Bedrock Knowledge Base for #{@entity.name}?" } %>
                <small class="text-muted d-block mt-2">
                  This will create a new Knowledge Base with OpenSearch Serverless and S3 data source.
                </small>
              <% else %>
                <button class="btn btn-secondary btn-lg w-100" disabled>
                  Knowledge Base Already Created
                </button>
              <% end %>
            </div>

            <div class="col-md-6 mb-3">
              <% if @entity.bedrock_knowledge_base_id.present? %>
                <%= button_to "Sync Documents",
                    sync_admin_bedrock_kb_path(@entity),
                    method: :post,
                    class: "btn btn-primary btn-lg w-100",
                    data: { confirm: "Start ingestion job to sync documents?" } %>
                <small class="text-muted d-block mt-2">
                  Triggers an ingestion job to sync documents from S3 to the Knowledge Base.
                </small>
              <% else %>
                <button class="btn btn-secondary btn-lg w-100" disabled>
                  Create KB First
                </button>
              <% end %>
            </div>

            <div class="col-md-6 mb-3">
              <% if @selector.bedrock_kb_available? && !@entity.use_bedrock_kb %>
                <%= button_to "Enable Bedrock KB Mode",
                    enable_admin_bedrock_kb_path(@entity),
                    method: :post,
                    class: "btn btn-success btn-lg w-100",
                    data: { confirm: "Switch entity to Bedrock KB mode?" } %>
                <small class="text-muted d-block mt-2">
                  Switch this entity to use Bedrock KB for RAG queries.
                </small>
              <% elsif @entity.use_bedrock_kb %>
                <%= button_to "Disable Bedrock KB Mode",
                    disable_admin_bedrock_kb_path(@entity),
                    method: :post,
                    class: "btn btn-warning btn-lg w-100",
                    data: { confirm: "Switch entity back to hybrid/pgvector mode?" } %>
                <small class="text-muted d-block mt-2">
                  Switch this entity back to hybrid (pgvector + Pinecone) mode.
                </small>
              <% else %>
                <button class="btn btn-secondary btn-lg w-100" disabled>
                  KB Not Available
                </button>
                <small class="text-muted d-block mt-2">
                  Create and configure Knowledge Base first.
                </small>
              <% end %>
            </div>

            <div class="col-md-6 mb-3">
              <%= link_to "View Entity Settings",
                  entity_path(@entity),
                  class: "btn btn-outline-secondary btn-lg w-100" %>
              <small class="text-muted d-block mt-2">
                View full entity configuration and settings.
              </small>
            </div>
          </div>
        </div>
      </div>

      <!-- Configuration Details -->
      <div class="card mt-4">
        <div class="card-header">
          <h5 class="mb-0">Configuration Details</h5>
        </div>
        <div class="card-body">
          <dl class="row">
            <dt class="col-sm-4">Entity ID</dt>
            <dd class="col-sm-8"><code><%= @entity.id %></code></dd>

            <dt class="col-sm-4">Entity Name</dt>
            <dd class="col-sm-8"><%= @entity.name %></dd>

            <dt class="col-sm-4">Subdomain</dt>
            <dd class="col-sm-8"><code><%= @entity.subdomain %></code></dd>

            <dt class="col-sm-4">Use Bedrock KB</dt>
            <dd class="col-sm-8">
              <span class="badge bg-<%= @entity.use_bedrock_kb ? 'success' : 'secondary' %>">
                <%= @entity.use_bedrock_kb ? 'Yes' : 'No' %>
              </span>
            </dd>

            <dt class="col-sm-4">Knowledge Base ID</dt>
            <dd class="col-sm-8">
              <% if @entity.bedrock_knowledge_base_id %>
                <code><%= @entity.bedrock_knowledge_base_id %></code>
              <% else %>
                <span class="text-muted">Not configured</span>
              <% end %>
            </dd>

            <dt class="col-sm-4">KB Status</dt>
            <dd class="col-sm-8">
              <% if @entity.bedrock_kb_status %>
                <span class="badge bg-<%= @entity.bedrock_kb_status == 'ACTIVE' ? 'success' : 'warning' %>">
                  <%= @entity.bedrock_kb_status %>
                </span>
              <% else %>
                <span class="text-muted">—</span>
              <% end %>
            </dd>

            <dt class="col-sm-4">Last Ingestion Job ID</dt>
            <dd class="col-sm-8">
              <% if @entity.bedrock_last_ingestion_job_id %>
                <code><%= @entity.bedrock_last_ingestion_job_id %></code>
              <% else %>
                <span class="text-muted">No ingestion jobs yet</span>
              <% end %>
            </dd>

            <dt class="col-sm-4">RAG Storage Bucket</dt>
            <dd class="col-sm-8">
              <code><%= ENV['RAG_BUCKET'] || 'Not configured' %></code>
            </dd>

            <dt class="col-sm-4">S3 Data Source Path</dt>
            <dd class="col-sm-8">
              <code>s3://<%= ENV['RAG_BUCKET'] %>/entities/<%= @entity.id %>/</code>
            </dd>
          </dl>
        </div>
      </div>
    </div>
  </div>
</div>
