<div class="admin-content">
  <div style="padding: 2rem;">
    <div class="container-fluid">
  <div class="row mb-4">
    <div class="col-12">
      <div class="d-flex justify-content-between align-items-center">
        <h1><i class="fas fa-money-check-alt"></i> Payout Management</h1>
        <%= link_to new_admin_payout_path, class: "btn btn-primary" do %>
          <i class="fas fa-plus"></i> Create Batch Payout
        <% end %>
      </div>
    </div>
  </div>

  <!-- Stats Cards -->
  <div class="row mb-4">
    <div class="col-md-6">
      <div class="card bg-success text-white">
        <div class="card-body">
          <h5 class="card-title">Ready for Payout</h5>
          <h2 class="mb-0">$<%= number_with_delimiter(@pending_commissions_total, precision: 2) %></h2>
          <small><%= @ready_for_payout_count %> affiliates ready</small>
        </div>
      </div>
    </div>
    <div class="col-md-6">
      <div class="card bg-secondary text-white">
        <div class="card-body">
          <h5 class="card-title">Total Payouts</h5>
          <h2 class="mb-0"><%= @payouts.total_count %></h2>
        </div>
      </div>
    </div>
  </div>

  <!-- Filters -->
  <div class="card bg-secondary mb-4">
    <div class="card-body">
      <%= form_with url: admin_payouts_path, method: :get, local: true, class: "row g-3" do %>
        <div class="col-md-3">
          <%= select_tag :status, options_for_select([['All Statuses', ''], ['Pending', 'pending'], ['Processing', 'processing'], ['Completed', 'completed'], ['Failed', 'failed']], params[:status]), class: "form-select" %>
        </div>
        <div class="col-md-3">
          <button type="submit" class="btn btn-primary">
            <i class="fas fa-search"></i> Filter
          </button>
          <%= link_to "Clear", admin_payouts_path, class: "btn btn-outline-secondary" %>
        </div>
        <div class="col-md-6 text-end">
          <%= link_to admin_payouts_path(format: :csv, **params.permit(:status)), class: "btn btn-outline-success" do %>
            <i class="fas fa-file-csv"></i> Export CSV
          <% end %>
        </div>
      <% end %>
    </div>
  </div>

  <!-- Payouts Table -->
  <div class="card bg-secondary">
    <div class="card-header">
      <h5 class="mb-0">Payouts</h5>
    </div>
    <div class="card-body p-0">
      <div class="table-responsive">
        <table class="table table-dark table-hover mb-0">
          <thead>
            <tr>
              <th>ID</th>
              <th>Affiliate</th>
              <th>Email</th>
              <th>Amount</th>
              <th>Method</th>
              <th>Status</th>
              <th>Date</th>
              <th>Reference</th>
              <th>Processed By</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            <% @payouts.each do |payout| %>
              <tr>
                <td><%= payout.id %></td>
                <td><%= payout.affiliate.user.full_name %></td>
                <td><%= payout.affiliate.user.email %></td>
                <td>$<%= number_with_delimiter(payout.amount, precision: 2) %></td>
                <td><%= payout.payment_method.humanize %></td>
                <td>
                  <span class="badge bg-<%= case payout.status
                    when 'pending' then 'warning'
                    when 'processing' then 'info'
                    when 'completed' then 'success'
                    when 'failed' then 'danger'
                    end %>">
                    <%= payout.status.humanize %>
                  </span>
                </td>
                <td><%= payout.payout_date&.strftime('%Y-%m-%d') || payout.created_at.strftime('%Y-%m-%d') %></td>
                <td><%= payout.payment_reference || 'N/A' %></td>
                <td><%= payout.processed_by&.full_name || 'N/A' %></td>
                <td>
                  <% if payout.pending? || payout.processing? %>
                    <button type="button" class="btn btn-sm btn-success" data-bs-toggle="modal" data-bs-target="#completeModal<%= payout.id %>">
                      <i class="fas fa-check"></i> Complete
                    </button>

                    <!-- Modal for marking complete -->
                    <div class="modal fade" id="completeModal<%= payout.id %>" tabindex="-1">
                      <div class="modal-dialog">
                        <div class="modal-content bg-dark text-white">
                          <div class="modal-header">
                            <h5 class="modal-title">Mark Payout Complete</h5>
                            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                          </div>
                          <%= form_with url: mark_completed_admin_payout_path(payout), method: :post, local: true do %>
                            <div class="modal-body">
                              <p>Mark payout of <strong>$<%= number_with_delimiter(payout.amount, precision: 2) %></strong> to <strong><%= payout.affiliate.user.full_name %></strong> as completed?</p>
                              <div class="mb-3">
                                <label class="form-label">Payment Reference/Transaction ID</label>
                                <%= text_field_tag :payment_reference, nil, class: "form-control", placeholder: "e.g., PayPal TXN-12345" %>
                              </div>
                            </div>
                            <div class="modal-footer">
                              <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                              <button type="submit" class="btn btn-success">Mark Complete</button>
                            </div>
                          <% end %>
                        </div>
                      </div>
                    </div>
                  <% elsif payout.completed? %>
                    <span class="badge bg-success">Completed</span>
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
    <div class="card-footer">
      <%= paginate @payouts %>
    </div>
  </div>
</div>
  </div>
</div>
