<div class="admin-p-xl">
  <!-- Page Header -->
  <div class="admin-page-header admin-mb-xl">
    <div class="header-left">
      <div class="header-icon admin-icon-gradient-purple">
        <i data-lucide="banknote" class="admin-text-primary"></i>
      </div>
      <div class="header-text">
        <h1>Payout Management</h1>
        <p>Manage affiliate payouts and commissions</p>
      </div>
    </div>

    <div class="header-actions">
      <%= link_to new_admin_payout_path, class: "admin-btn admin-btn-primary" do %>
        <i data-lucide="plus"></i>
        <span>Create Batch Payout</span>
      <% end %>
    </div>
  </div>

  <!-- Stats Cards -->
  <div class="admin-stats-grid admin-mb-xl">
    <div class="admin-card">
      <div class="admin-flex admin-items-center admin-flex-gap-md">
        <div class="admin-stat-icon success">
          <i data-lucide="wallet" class="admin-icon-lg admin-text-success"></i>
        </div>
        <div>
          <p class="admin-stat-label">Ready for Payout</p>
          <h3 class="admin-stat-value">$<%= number_with_delimiter(@pending_commissions_total, precision: 2) %></h3>
          <small class="admin-text-muted admin-text-xs"><%= @ready_for_payout_count %> affiliates ready</small>
        </div>
      </div>
    </div>

    <div class="admin-card">
      <div class="admin-flex admin-items-center admin-flex-gap-md">
        <div class="admin-stat-icon info">
          <i data-lucide="list" class="admin-icon-lg admin-text-info"></i>
        </div>
        <div>
          <p class="admin-stat-label">Total Payouts</p>
          <h3 class="admin-stat-value"><%= @payouts.total_count %></h3>
        </div>
      </div>
    </div>
  </div>

  <!-- Filters -->
  <div class="admin-card admin-mb-xl">
    <%= form_with url: admin_payouts_path, method: :get, local: true, class: "admin-filter-grid" do %>
      <div>
        <label class="form-label admin-text-sm">Status</label>
        <%= select_tag :status, options_for_select([['All Statuses', ''], ['Pending', 'pending'], ['Processing', 'processing'], ['Completed', 'completed'], ['Failed', 'failed']], params[:status]), class: "admin-select admin-w-full" %>
      </div>
      <div class="admin-flex admin-items-end admin-flex-gap-sm">
        <button type="submit" class="admin-btn admin-btn-primary">
          <i data-lucide="search"></i> Filter
        </button>
        <%= link_to "Clear", admin_payouts_path, class: "admin-btn admin-btn-outline" %>
      </div>
      <div class="admin-flex admin-items-end admin-ml-auto">
        <%= link_to admin_payouts_path(format: :csv, **params.permit(:status)), class: "admin-btn admin-btn-success" do %>
          <i data-lucide="file-spreadsheet"></i> Export CSV
        <% end %>
      </div>
    <% end %>
  </div>

  <!-- Payouts Table -->
  <div class="admin-card">
    <h3 class="card-title m-0 admin-mb-lg">
      <i data-lucide="list" class="admin-icon-md d-inline-block align-middle me-2"></i>
      Payouts
    </h3>
    <div class="admin-table-container">
      <table class="admin-table">
        <thead>
          <tr>
            <th>ID</th>
            <th>Affiliate</th>
            <th>Email</th>
            <th>Amount</th>
            <th>Method</th>
            <th>Status</th>
            <th>Date</th>
            <th>Reference</th>
            <th>Processed By</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <% @payouts.each do |payout| %>
            <tr>
              <td class="admin-text-cyan">#<%= payout.id %></td>
              <td class="admin-text-primary"><%= payout.affiliate.user.full_name %></td>
              <td class="admin-text-secondary"><%= payout.affiliate.user.email %></td>
              <td class="admin-text-success admin-font-semibold">$<%= number_with_delimiter(payout.amount, precision: 2) %></td>
              <td><span class="admin-badge admin-badge-secondary"><%= payout.payment_method.humanize %></span></td>
              <td>
                <span class="admin-badge <%= case payout.status
                  when 'pending' then 'admin-badge-warning'
                  when 'processing' then 'admin-badge-info'
                  when 'completed' then 'admin-badge-success'
                  when 'failed' then 'admin-badge-danger'
                  end %>">
                  <%= payout.status.humanize %>
                </span>
              </td>
              <td class="admin-text-secondary"><%= payout.payout_date&.strftime('%Y-%m-%d') || payout.created_at.strftime('%Y-%m-%d') %></td>
              <td class="admin-text-secondary"><%= payout.payment_reference || 'N/A' %></td>
              <td class="admin-text-secondary"><%= payout.processed_by&.full_name || 'N/A' %></td>
              <td>
                <% if payout.pending? || payout.processing? %>
                  <button type="button" class="admin-btn admin-btn-sm admin-btn-success" data-bs-toggle="modal" data-bs-target="#completeModal<%= payout.id %>">
                    <i data-lucide="check" class="admin-icon-sm"></i> Complete
                  </button>

                  <!-- Modal for marking complete -->
                  <div class="modal fade" id="completeModal<%= payout.id %>" tabindex="-1">
                    <div class="modal-dialog">
                      <div class="modal-content" style="background: var(--bg-card); border: 1px solid var(--border-primary);">
                        <div class="modal-header" style="border-bottom: 1px solid var(--border-primary);">
                          <h5 class="modal-title admin-text-primary">Mark Payout Complete</h5>
                          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                        </div>
                        <%= form_with url: mark_completed_admin_payout_path(payout), method: :post, local: true do %>
                          <div class="modal-body">
                            <p class="admin-text-secondary">Mark payout of <strong class="admin-text-success">$<%= number_with_delimiter(payout.amount, precision: 2) %></strong> to <strong class="admin-text-primary"><%= payout.affiliate.user.full_name %></strong> as completed?</p>
                            <div class="admin-mb-md">
                              <label class="form-label admin-text-sm">Payment Reference/Transaction ID</label>
                              <%= text_field_tag :payment_reference, nil, class: "admin-input admin-w-full", placeholder: "e.g., PayPal TXN-12345" %>
                            </div>
                          </div>
                          <div class="modal-footer" style="border-top: 1px solid var(--border-primary);">
                            <button type="button" class="admin-btn admin-btn-outline" data-bs-dismiss="modal">Cancel</button>
                            <button type="submit" class="admin-btn admin-btn-success">Mark Complete</button>
                          </div>
                        <% end %>
                      </div>
                    </div>
                  </div>
                <% elsif payout.completed? %>
                  <span class="admin-badge admin-badge-success">Completed</span>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
    <div class="admin-pagination">
      <%= paginate @payouts %>
    </div>
  </div>
</div>

<script>
  document.addEventListener('turbo:load', () => {
    if (typeof lucide !== 'undefined') {
      lucide.createIcons();
    }
  });
</script>
