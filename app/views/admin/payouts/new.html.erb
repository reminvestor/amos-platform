<div class="admin-p-xl">
  <!-- Page Header -->
  <div class="admin-page-header admin-mb-xl">
    <div class="header-left">
      <div class="header-icon admin-icon-gradient-purple">
        <i data-lucide="banknote" class="admin-text-primary"></i>
      </div>
      <div class="header-text">
        <h1>Create Batch Payout</h1>
        <p>Process payouts for multiple affiliates</p>
      </div>
    </div>

    <div class="header-actions">
      <%= link_to admin_payouts_path, class: "admin-btn admin-btn-outline" do %>
        <i data-lucide="arrow-left"></i>
        <span>Back</span>
      <% end %>
    </div>
  </div>

  <!-- Threshold Filter -->
  <div class="admin-card admin-mb-xl">
    <%= form_with url: new_admin_payout_path, method: :get, local: true, class: "admin-filter-grid" do %>
      <div>
        <label class="form-label admin-text-sm">Minimum Threshold</label>
        <%= number_field_tag :threshold, @minimum_threshold, step: 0.01, class: "admin-input admin-w-full" %>
      </div>
      <div class="admin-flex admin-items-end">
        <button type="submit" class="admin-btn admin-btn-primary">
          <i data-lucide="filter"></i> Apply Filter
        </button>
      </div>
    <% end %>
  </div>

  <% if @affiliates_data.any? %>
    <!-- Batch Summary -->
    <div class="admin-card admin-mb-xl" style="background: linear-gradient(135deg, var(--accent-purple-start), var(--accent-purple-end)); color: white;">
      <h5 class="admin-mb-md admin-font-semibold">Batch Summary</h5>
      <div class="row">
        <div class="col-md-4">
          <p class="admin-mb-0">
            <strong>Total Affiliates:</strong> <%= @affiliates_data.count %>
          </p>
        </div>
        <div class="col-md-4">
          <p class="admin-mb-0">
            <strong>Total Amount:</strong> $<%= number_with_delimiter(@affiliates_data.sum { |d| d[:amount] }, precision: 2) %>
          </p>
        </div>
        <div class="col-md-4">
          <p class="admin-mb-0">
            <strong>Total Commissions:</strong> <%= @affiliates_data.sum { |d| d[:commission_count] } %>
          </p>
        </div>
      </div>
    </div>

    <!-- Batch Creation Form -->
    <%= form_with url: admin_payouts_path, method: :post, local: true, id: "batch-payout-form", data: { controller: "payout-calculator bulk-select" } do %>
      <%= hidden_field_tag :minimum_threshold, @minimum_threshold %>

      <div class="admin-card admin-mb-xl">
        <h3 class="card-title m-0 admin-mb-lg">
          <i data-lucide="settings" class="admin-icon-md d-inline-block align-middle me-2"></i>
          Payment Settings
        </h3>
        <div class="row">
          <div class="col-md-6">
            <label class="form-label admin-text-sm">Payment Method</label>
            <%= select_tag :payment_method, options_for_select([['Manual', 'manual'], ['PayPal', 'paypal'], ['Stripe', 'stripe']], 'manual'), class: "admin-select admin-w-full", required: true %>
          </div>
        </div>
      </div>

      <div class="admin-card">
        <div class="admin-flex-between admin-mb-lg">
          <h3 class="card-title m-0">
            <i data-lucide="users" class="admin-icon-md d-inline-block align-middle me-2"></i>
            Select Affiliates for Payout
            <span class="admin-badge admin-badge-info ms-2">
              <span data-bulk-select-target="counter">0</span> selected
            </span>
          </h3>
          <div class="admin-flex admin-flex-gap-sm">
            <button type="button" class="admin-btn admin-btn-sm admin-btn-outline"
                    data-action="payout-calculator#selectAll bulk-select#selectAll">
              Select All
            </button>
            <button type="button" class="admin-btn admin-btn-sm admin-btn-outline"
                    data-action="payout-calculator#deselectAll bulk-select#deselectAll">
              Deselect All
            </button>
          </div>
        </div>

        <div class="admin-table-container">
          <table class="admin-table">
            <thead>
              <tr>
                <th width="50">
                  <input type="checkbox"
                         data-bulk-select-target="masterCheckbox"
                         data-action="bulk-select#toggleAll payout-calculator#calculate"
                         class="form-check-input"
                         checked>
                </th>
                <th>Affiliate</th>
                <th>Email</th>
                <th>Payment Email</th>
                <th>Commissions</th>
                <th>Amount</th>
              </tr>
            </thead>
            <tbody>
              <% @affiliates_data.each do |data| %>
                <% affiliate = data[:affiliate] %>
                <tr>
                  <td>
                    <%= check_box_tag "affiliate_ids[]", affiliate.id, true,
                        class: "form-check-input",
                        data: {
                          amount: data[:amount],
                          payout_calculator_target: "checkbox",
                          bulk_select_target: "checkbox",
                          action: "change->payout-calculator#calculate bulk-select#updateCount"
                        } %>
                  </td>
                  <td>
                    <span class="admin-text-primary"><%= affiliate.user.full_name %></span>
                    <span class="admin-badge <%= case affiliate.tier
                      when 'bronze' then 'admin-badge-secondary'
                      when 'silver' then 'admin-badge-default'
                      when 'gold' then 'admin-badge-warning'
                      end %> admin-ml-xs">
                      <%= affiliate.tier.humanize %>
                    </span>
                  </td>
                  <td class="admin-text-secondary"><%= affiliate.user.email %></td>
                  <td class="admin-text-secondary"><%= affiliate.payment_email || 'Not set' %></td>
                  <td class="admin-text-secondary"><%= data[:commission_count] %> commission(s)</td>
                  <td class="payout-amount admin-text-success admin-font-semibold">$<%= number_with_delimiter(data[:amount], precision: 2) %></td>
                </tr>
              <% end %>
            </tbody>
            <tfoot>
              <tr style="background: var(--accent-purple-start); color: white;">
                <td colspan="5" class="admin-text-right"><strong>Total Selected:</strong></td>
                <td>
                  <strong data-payout-calculator-target="total">$0.00</strong>
                </td>
              </tr>
            </tfoot>
          </table>
        </div>

        <div class="admin-mt-lg">
          <button type="submit" class="admin-btn admin-btn-success admin-btn-lg"
                  data-bulk-select-target="actionButton">
            <i data-lucide="check"></i> Create Batch Payout
          </button>
        </div>
      </div>
    <% end %>
  <% else %>
    <div class="admin-card" style="background: var(--status-info-bg); border-left: 4px solid var(--status-info-text);">
      <div class="admin-flex admin-items-center admin-flex-gap-sm">
        <i data-lucide="info" class="admin-icon-md" style="color: var(--status-info-text);"></i>
        <span class="admin-text-secondary">No affiliates ready for payout with the current threshold of $<%= number_with_delimiter(@minimum_threshold, precision: 2) %>.</span>
      </div>
    </div>
  <% end %>
</div>

<script>
  document.addEventListener('turbo:load', () => {
    if (typeof lucide !== 'undefined') {
      lucide.createIcons();
    }
  });
</script>
