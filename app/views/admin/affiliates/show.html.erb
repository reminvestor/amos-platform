<div class="container-fluid">
  <div class="row mb-4">
    <div class="col-12">
      <div class="d-flex justify-content-between align-items-center">
        <h1>
          <i class="fas fa-user-circle"></i> <%= @affiliate.user.full_name %>
          <span class="badge bg-<%= case @affiliate.status
            when 'pending' then 'warning'
            when 'active' then 'success'
            when 'suspended' then 'danger'
            when 'terminated' then 'dark'
            end %>">
            <%= @affiliate.status.humanize %>
          </span>
        </h1>
        <%= link_to admin_affiliates_path, class: "btn btn-outline-secondary" do %>
          <i class="fas fa-arrow-left"></i> Back to List
        <% end %>
      </div>
    </div>
  </div>

  <!-- Stats Overview -->
  <div class="row mb-4">
    <div class="col-md-3">
      <div class="card bg-secondary text-white">
        <div class="card-body">
          <h6 class="card-title">Total Clicks</h6>
          <h3 class="mb-0"><%= @stats[:total_clicks] %></h3>
          <small class="text-muted"><%= @stats[:clicks_this_month] %> this month</small>
        </div>
      </div>
    </div>
    <div class="col-md-3">
      <div class="card bg-secondary text-white">
        <div class="card-body">
          <h6 class="card-title">Conversions</h6>
          <h3 class="mb-0"><%= @stats[:total_conversions] %></h3>
          <small class="text-muted"><%= @stats[:conversion_rate] %>% rate</small>
        </div>
      </div>
    </div>
    <div class="col-md-3">
      <div class="card bg-success text-white">
        <div class="card-body">
          <h6 class="card-title">Total Earned</h6>
          <h3 class="mb-0">$<%= number_with_delimiter(@stats[:total_earned], precision: 2) %></h3>
          <small class="text-muted">$<%= number_with_delimiter(@stats[:earnings_this_month], precision: 2) %> this month</small>
        </div>
      </div>
    </div>
    <div class="col-md-3">
      <div class="card bg-warning text-dark">
        <div class="card-body">
          <h6 class="card-title">Pending Balance</h6>
          <h3 class="mb-0">$<%= number_with_delimiter(@stats[:balance], precision: 2) %></h3>
          <small>Available for payout</small>
        </div>
      </div>
    </div>
  </div>

  <!-- Affiliate Details -->
  <div class="row mb-4">
    <div class="col-md-6">
      <div class="card bg-secondary">
        <div class="card-header">
          <h5 class="mb-0">Affiliate Information</h5>
        </div>
        <div class="card-body">
          <table class="table table-dark mb-0">
            <tr>
              <th width="40%">Affiliate Code</th>
              <td><code><%= @affiliate.affiliate_code %></code></td>
            </tr>
            <tr>
              <th>Email</th>
              <td><%= @affiliate.user.email %></td>
            </tr>
            <tr>
              <th>Payment Email</th>
              <td><%= @affiliate.payment_email || 'Not set' %></td>
            </tr>
            <tr>
              <th>Commission Rate</th>
              <td><%= number_to_percentage(@affiliate.commission_rate * 100, precision: 2) %></td>
            </tr>
            <tr>
              <th>Tier</th>
              <td>
                <span class="badge bg-<%= case @affiliate.tier
                  when 'bronze' then 'secondary'
                  when 'silver' then 'light text-dark'
                  when 'gold' then 'warning'
                  end %>">
                  <%= @affiliate.tier.humanize %>
                </span>
              </td>
            </tr>
            <tr>
              <th>Joined</th>
              <td><%= @affiliate.created_at.strftime('%B %d, %Y') %></td>
            </tr>
            <% if @affiliate.approved_at %>
              <tr>
                <th>Approved</th>
                <td><%= @affiliate.approved_at.strftime('%B %d, %Y') %></td>
              </tr>
              <tr>
                <th>Approved By</th>
                <td><%= @affiliate.approved_by&.full_name || 'System' %></td>
              </tr>
            <% end %>
          </table>
        </div>
      </div>
    </div>

    <div class="col-md-6">
      <div class="card bg-secondary">
        <div class="card-header">
          <h5 class="mb-0">Actions</h5>
        </div>
        <div class="card-body">
          <% if @affiliate.pending? %>
            <%= button_to approve_admin_affiliate_path(@affiliate), method: :post, class: "btn btn-success mb-2 w-100" do %>
              <i class="fas fa-check"></i> Approve Affiliate
            <% end %>
          <% end %>

          <% if @affiliate.active? %>
            <%= button_to suspend_admin_affiliate_path(@affiliate), method: :post, class: "btn btn-warning mb-2 w-100", data: { confirm: 'Are you sure you want to suspend this affiliate?' } do %>
              <i class="fas fa-pause"></i> Suspend Affiliate
            <% end %>
          <% end %>

          <div class="mb-3">
            <%= form_with url: update_commission_rate_admin_affiliate_path(@affiliate), method: :patch, local: true do %>
              <label class="form-label text-white">Update Commission Rate</label>
              <div class="input-group">
                <%= number_field_tag :commission_rate, @affiliate.commission_rate, step: 0.01, min: 0, max: 1, class: "form-control" %>
                <button type="submit" class="btn btn-primary">Update</button>
              </div>
              <small class="text-muted">Enter as decimal (0.20 = 20%)</small>
            <% end %>
          </div>

          <% if @affiliate.application_notes.present? %>
            <div class="mt-3">
              <label class="form-label text-white">Application Notes</label>
              <div class="bg-dark p-3 rounded">
                <%= simple_format(@affiliate.application_notes) %>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <!-- Recent Commissions -->
  <div class="card bg-secondary mb-4">
    <div class="card-header d-flex justify-content-between align-items-center">
      <h5 class="mb-0">Recent Commissions</h5>
      <%= link_to admin_commissions_path(affiliate_id: @affiliate.id), class: "btn btn-sm btn-outline-primary" do %>
        View All
      <% end %>
    </div>
    <div class="card-body p-0">
      <div class="table-responsive">
        <table class="table table-dark table-hover mb-0">
          <thead>
            <tr>
              <th>Date</th>
              <th>Customer</th>
              <th>Type</th>
              <th>Amount</th>
              <th>Status</th>
            </tr>
          </thead>
          <tbody>
            <% @stats[:recent_commissions].each do |commission| %>
              <tr>
                <td><%= commission.earned_at.strftime('%Y-%m-%d') %></td>
                <td><%= commission.entity.name %></td>
                <td><%= commission.commission_type.humanize %></td>
                <td>$<%= number_with_delimiter(commission.amount, precision: 2) %></td>
                <td>
                  <span class="badge bg-<%= case commission.status
                    when 'pending' then 'warning'
                    when 'approved' then 'success'
                    when 'paid' then 'primary'
                    when 'cancelled' then 'danger'
                    end %>">
                    <%= commission.status.humanize %>
                  </span>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <!-- Recent Payouts -->
  <div class="card bg-secondary">
    <div class="card-header d-flex justify-content-between align-items-center">
      <h5 class="mb-0">Recent Payouts</h5>
      <%= link_to admin_payouts_path, class: "btn btn-sm btn-outline-primary" do %>
        View All
      <% end %>
    </div>
    <div class="card-body p-0">
      <div class="table-responsive">
        <table class="table table-dark table-hover mb-0">
          <thead>
            <tr>
              <th>Date</th>
              <th>Amount</th>
              <th>Method</th>
              <th>Reference</th>
              <th>Status</th>
            </tr>
          </thead>
          <tbody>
            <% if @stats[:recent_payouts].any? %>
              <% @stats[:recent_payouts].each do |payout| %>
                <tr>
                  <td><%= payout.payout_date&.strftime('%Y-%m-%d') || payout.created_at.strftime('%Y-%m-%d') %></td>
                  <td>$<%= number_with_delimiter(payout.amount, precision: 2) %></td>
                  <td><%= payout.payment_method.humanize %></td>
                  <td><%= payout.payment_reference || 'N/A' %></td>
                  <td>
                    <span class="badge bg-<%= case payout.status
                      when 'pending' then 'warning'
                      when 'processing' then 'info'
                      when 'completed' then 'success'
                      when 'failed' then 'danger'
                      end %>">
                      <%= payout.status.humanize %>
                    </span>
                  </td>
                </tr>
              <% end %>
            <% else %>
              <tr>
                <td colspan="5" class="text-center text-muted">No payouts yet</td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>
