<div class="admin-p-xl">
  <!-- Page Header -->
  <div class="admin-page-header admin-mb-xl">
    <div class="header-left">
      <div class="header-icon admin-icon-gradient-purple">
        <i data-lucide="users-cog" class="admin-text-primary"></i>
      </div>
      <div class="header-text">
        <h1>Affiliate Management</h1>
        <p>Manage affiliates, commissions, and payouts</p>
      </div>
    </div>

    <div class="header-actions">
      <%= link_to admin_analytics_affiliates_path, class: "admin-btn admin-btn-outline" do %>
        <i data-lucide="trending-up"></i>
        <span>View Analytics</span>
      <% end %>
    </div>
  </div>

  <!-- Stats Cards -->
  <div class="admin-stats-grid admin-mb-xl">
    <div class="admin-card">
      <div class="admin-flex admin-items-center admin-flex-gap-md">
        <div class="admin-stat-icon info">
          <i data-lucide="users" class="admin-icon-lg admin-text-info"></i>
        </div>
        <div>
          <p class="admin-stat-label">Total Affiliates</p>
          <h3 class="admin-stat-value"><%= @total_affiliates %></h3>
        </div>
      </div>
    </div>

    <div class="admin-card">
      <div class="admin-flex admin-items-center admin-flex-gap-md">
        <div class="admin-stat-icon warning">
          <i data-lucide="clock" class="admin-icon-lg admin-text-warning"></i>
        </div>
        <div>
          <p class="admin-stat-label">Pending Approval</p>
          <h3 class="admin-stat-value"><%= @pending_count %></h3>
        </div>
      </div>
    </div>

    <div class="admin-card">
      <div class="admin-flex admin-items-center admin-flex-gap-md">
        <div class="admin-stat-icon success">
          <i data-lucide="check-circle" class="admin-icon-lg admin-text-success"></i>
        </div>
        <div>
          <p class="admin-stat-label">Active Affiliates</p>
          <h3 class="admin-stat-value"><%= @active_count %></h3>
        </div>
      </div>
    </div>
  </div>

  <!-- Filters -->
  <div class="admin-card admin-mb-xl">
    <%= form_with url: admin_affiliates_path, method: :get, local: true, class: "admin-filter-grid" do %>
      <div class="admin-flex-1">
        <label class="form-label admin-text-sm">Search</label>
        <%= text_field_tag :query, params[:query], class: "admin-input admin-w-full", placeholder: "Search by name, email, code..." %>
      </div>
      <div>
        <label class="form-label admin-text-sm">Status</label>
        <%= select_tag :status, options_for_select([['All Statuses', ''], ['Pending', 'pending'], ['Active', 'active'], ['Suspended', 'suspended'], ['Terminated', 'terminated']], params[:status]), class: "admin-select admin-w-full" %>
      </div>
      <div>
        <label class="form-label admin-text-sm">Tier</label>
        <%= select_tag :tier, options_for_select([['All Tiers', ''], ['Bronze', 'bronze'], ['Silver', 'silver'], ['Gold', 'gold']], params[:tier]), class: "admin-select admin-w-full" %>
      </div>
      <div class="admin-flex admin-items-end admin-flex-gap-sm">
        <button type="submit" class="admin-btn admin-btn-primary">
          <i data-lucide="search"></i> Filter
        </button>
        <%= link_to "Clear", admin_affiliates_path, class: "admin-btn admin-btn-outline" %>
      </div>
      <div class="admin-flex admin-items-end">
        <%= link_to admin_affiliates_path(format: :csv, **params.permit(:status, :tier, :query)), class: "admin-btn admin-btn-success" do %>
          <i data-lucide="file-spreadsheet"></i> Export CSV
        <% end %>
      </div>
    <% end %>
  </div>

  <!-- Affiliates Table -->
  <div class="admin-card">
    <h3 class="card-title m-0 admin-mb-lg">
      <i data-lucide="users" class="admin-icon-md d-inline-block align-middle me-2"></i>
      Affiliates
    </h3>
    <div class="admin-table-container">
      <table class="admin-table">
        <thead>
          <tr>
            <th>ID</th>
            <th>Name</th>
            <th>Email</th>
            <th>Code</th>
            <th>Status</th>
            <th>Tier</th>
            <th>Rate</th>
            <th>Clicks</th>
            <th>Conversions</th>
            <th>Earned</th>
            <th>Joined</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <% @affiliates.each do |affiliate| %>
            <tr>
              <td class="admin-text-cyan">#<%= affiliate.id %></td>
              <td class="admin-text-primary"><%= affiliate.user.full_name %></td>
              <td class="admin-text-secondary"><%= affiliate.user.email %></td>
              <td><code class="admin-text-cyan"><%= affiliate.affiliate_code %></code></td>
              <td>
                <span class="admin-badge <%= case affiliate.status
                  when 'pending' then 'admin-badge-warning'
                  when 'active' then 'admin-badge-success'
                  when 'suspended' then 'admin-badge-danger'
                  when 'terminated' then 'admin-badge-secondary'
                  end %>">
                  <%= affiliate.status.humanize %>
                </span>
              </td>
              <td>
                <span class="admin-badge <%= case affiliate.tier
                  when 'bronze' then 'admin-badge-secondary'
                  when 'silver' then 'admin-badge-default'
                  when 'gold' then 'admin-badge-warning'
                  end %>">
                  <%= affiliate.tier.humanize %>
                </span>
              </td>
              <td class="admin-text-secondary"><%= number_to_percentage(affiliate.commission_rate * 100, precision: 2) %></td>
              <td class="admin-text-secondary"><%= affiliate.total_clicks %></td>
              <td class="admin-text-secondary"><%= affiliate.total_conversions %></td>
              <td class="admin-text-success admin-font-semibold">$<%= number_with_delimiter(affiliate.total_earned, precision: 2) %></td>
              <td class="admin-text-secondary"><%= affiliate.created_at.strftime('%Y-%m-%d') %></td>
              <td>
                <%= link_to admin_affiliate_path(affiliate), class: "admin-btn admin-btn-sm admin-btn-outline" do %>
                  <i data-lucide="eye" class="admin-icon-sm"></i>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <div class="admin-pagination">
      <%= paginate @affiliates %>
    </div>
  </div>
</div>

<script>
  document.addEventListener('turbo:load', () => {
    if (typeof lucide !== 'undefined') {
      lucide.createIcons();
    }
  });
</script>
