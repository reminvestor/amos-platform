<div class="admin-content">
  <div style="padding: 2rem;">
    <div class="container-fluid">
  <div class="row mb-4">
    <div class="col-12">
      <div class="d-flex justify-content-between align-items-center">
        <h1><i class="fas fa-users-cog"></i> Affiliate Management</h1>
        <%= link_to admin_analytics_affiliates_path, class: "btn btn-outline-primary" do %>
          <i data-lucide="trending-up"></i> View Analytics
        <% end %>
      </div>
    </div>
  </div>

  <!-- Stats Cards -->
  <div class="row mb-4">
    <div class="col-md-4">
      <div class="card bg-secondary text-white">
        <div class="card-body">
          <h5 class="card-title">Total Affiliates</h5>
          <h2 class="mb-0"><%= @total_affiliates %></h2>
        </div>
      </div>
    </div>
    <div class="col-md-4">
      <div class="card bg-warning text-dark">
        <div class="card-body">
          <h5 class="card-title">Pending Approval</h5>
          <h2 class="mb-0"><%= @pending_count %></h2>
        </div>
      </div>
    </div>
    <div class="col-md-4">
      <div class="card bg-success text-white">
        <div class="card-body">
          <h5 class="card-title">Active Affiliates</h5>
          <h2 class="mb-0"><%= @active_count %></h2>
        </div>
      </div>
    </div>
  </div>

  <!-- Filters -->
  <div class="card bg-secondary mb-4">
    <div class="card-body">
      <%= form_with url: admin_affiliates_path, method: :get, local: true, class: "row g-3" do %>
        <div class="col-md-3">
          <%= text_field_tag :query, params[:query], class: "form-control", placeholder: "Search by name, email, code..." %>
        </div>
        <div class="col-md-2">
          <%= select_tag :status, options_for_select([['All Statuses', ''], ['Pending', 'pending'], ['Active', 'active'], ['Suspended', 'suspended'], ['Terminated', 'terminated']], params[:status]), class: "form-select" %>
        </div>
        <div class="col-md-2">
          <%= select_tag :tier, options_for_select([['All Tiers', ''], ['Bronze', 'bronze'], ['Silver', 'silver'], ['Gold', 'gold']], params[:tier]), class: "form-select" %>
        </div>
        <div class="col-md-3">
          <button type="submit" class="btn btn-primary">
            <i data-lucide="search"></i> Filter
          </button>
          <%= link_to "Clear", admin_affiliates_path, class: "btn btn-outline-secondary" %>
        </div>
        <div class="col-md-2 text-end">
          <%= link_to admin_affiliates_path(format: :csv, **params.permit(:status, :tier, :query)), class: "btn btn-outline-success" do %>
            <i class="fas fa-file-csv"></i> Export CSV
          <% end %>
        </div>
      <% end %>
    </div>
  </div>

  <!-- Affiliates Table -->
  <div class="card bg-secondary">
    <div class="card-header">
      <h5 class="mb-0">Affiliates</h5>
    </div>
    <div class="card-body p-0">
      <div class="table-responsive">
        <table class="table table-dark table-hover mb-0">
          <thead>
            <tr>
              <th>ID</th>
              <th>Name</th>
              <th>Email</th>
              <th>Code</th>
              <th>Status</th>
              <th>Tier</th>
              <th>Rate</th>
              <th>Clicks</th>
              <th>Conversions</th>
              <th>Earned</th>
              <th>Joined</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            <% @affiliates.each do |affiliate| %>
              <tr>
                <td><%= affiliate.id %></td>
                <td><%= affiliate.user.full_name %></td>
                <td><%= affiliate.user.email %></td>
                <td><code><%= affiliate.affiliate_code %></code></td>
                <td>
                  <span class="badge bg-<%= case affiliate.status
                    when 'pending' then 'warning'
                    when 'active' then 'success'
                    when 'suspended' then 'danger'
                    when 'terminated' then 'dark'
                    end %>">
                    <%= affiliate.status.humanize %>
                  </span>
                </td>
                <td>
                  <span class="badge bg-<%= case affiliate.tier
                    when 'bronze' then 'secondary'
                    when 'silver' then 'light text-dark'
                    when 'gold' then 'warning'
                    end %>">
                    <%= affiliate.tier.humanize %>
                  </span>
                </td>
                <td><%= number_to_percentage(affiliate.commission_rate * 100, precision: 2) %></td>
                <td><%= affiliate.total_clicks %></td>
                <td><%= affiliate.total_conversions %></td>
                <td>$<%= number_with_delimiter(affiliate.total_earned, precision: 2) %></td>
                <td><%= affiliate.created_at.strftime('%Y-%m-%d') %></td>
                <td>
                  <%= link_to admin_affiliate_path(affiliate), class: "btn btn-sm btn-outline-primary" do %>
                    <i data-lucide="eye"></i>
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
    <div class="card-footer">
      <%= paginate @affiliates %>
    </div>
  </div>
</div>
  </div>
</div>
