<div class="admin-p-xl">
  <!-- Page Header -->
  <div class="admin-page-header admin-mb-xl">
    <div class="header-left">
      <div class="header-icon admin-icon-gradient-purple">
        <i data-lucide="users" class="admin-text-primary"></i>
      </div>
      <div class="header-text">
        <h1>User Management</h1>
        <p>Monitor and manage platform users</p>
      </div>
    </div>
  </div>

  <!-- Stats Cards -->
  <div class="admin-stats-grid admin-mb-xl">
    <div class="admin-card">
      <div class="admin-flex admin-items-center admin-flex-gap-md">
        <div class="admin-stat-icon purple-gradient">
          <i data-lucide="users" class="admin-icon-lg admin-text-primary"></i>
        </div>
        <div>
          <p class="admin-stat-label">Total Users</p>
          <h3 class="admin-stat-value"><%= @stats[:total_users] %></h3>
        </div>
      </div>
    </div>

    <div class="admin-card">
      <div class="admin-flex admin-items-center admin-flex-gap-md">
        <div class="admin-stat-icon info">
          <i data-lucide="check-circle" class="admin-icon-lg admin-text-info"></i>
        </div>
        <div>
          <p class="admin-stat-label">Onboarded</p>
          <h3 class="admin-stat-value"><%= @stats[:onboarded] %></h3>
        </div>
      </div>
    </div>

    <div class="admin-card">
      <div class="admin-flex admin-items-center admin-flex-gap-md">
        <div class="admin-stat-icon warning">
          <i data-lucide="shield" class="admin-icon-lg admin-text-warning"></i>
        </div>
        <div>
          <p class="admin-stat-label">Admins</p>
          <h3 class="admin-stat-value"><%= @stats[:admins] %></h3>
        </div>
      </div>
    </div>

    <div class="admin-card">
      <div class="admin-flex admin-items-center admin-flex-gap-md">
        <div class="admin-stat-icon success">
          <i data-lucide="activity" class="admin-icon-lg admin-text-success"></i>
        </div>
        <div>
          <p class="admin-stat-label">Active Today</p>
          <h3 class="admin-stat-value"><%= @stats[:active_today] %></h3>
        </div>
      </div>
    </div>
  </div>

  <!-- Users Table -->
  <div class="admin-card">
    <h3 class="card-title admin-mb-lg">All Users</h3>

    <div class="admin-table-container">
      <table class="admin-table">
        <thead>
          <tr>
            <th>ID</th>
            <th>Name</th>
            <th>Email</th>
            <th>Entity</th>
            <th>Role</th>
            <th>Onboarded</th>
            <th>Last Sign In</th>
            <th class="admin-text-right">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% @users.each do |user| %>
            <tr>
              <td class="admin-text-muted admin-text-sm">#<%= user.id %></td>
              <td>
                <%= link_to user.full_name, admin_user_path(user), class: "admin-text-info admin-font-semibold" %>
              </td>
              <td class="admin-text-muted admin-text-sm"><%= user.email %></td>
              <td class="admin-text-primary"><%= user.entity&.name || 'None' %></td>
              <td>
                <% if user.role == 'admin' %>
                  <span class="admin-badge admin-badge-warning"><%= user.role.titleize %></span>
                <% else %>
                  <span class="admin-badge admin-badge-secondary"><%= user.role.titleize %></span>
                <% end %>
              </td>
              <td>
                <% if user.onboarded? %>
                  <span class="admin-badge admin-badge-online">YES</span>
                <% else %>
                  <span class="admin-badge admin-badge-offline">NO</span>
                <% end %>
              </td>
              <td class="admin-text-muted admin-text-sm">
                <%= user.current_sign_in_at ? time_ago_in_words(user.current_sign_in_at) + ' ago' : 'Never' %>
              </td>
              <td class="admin-text-right">
                <div class="admin-inline-flex admin-flex-gap-sm">
                  <%= link_to admin_user_path(user), class: 'admin-btn admin-btn-sm admin-btn-outline', aria: { label: 'View user' } do %>
                    <i data-lucide="eye" class="admin-icon-sm"></i>
                  <% end %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <% if @users.respond_to?(:total_pages) && @users.total_pages > 1 %>
      <div class="admin-pagination">
        <%= paginate @users %>
      </div>
    <% end %>
  </div>
</div>

<script>
  document.addEventListener('turbo:load', () => {
    lucide.createIcons();
  });

  document.addEventListener('DOMContentLoaded', () => {
    lucide.createIcons();
  });
</script>
