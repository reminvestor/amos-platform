<div class="admin-content">
  <div class="admin-p-xl">
    <%# Page Header %>
    <div class="admin-page-header">
      <div class="header-left">
        <div class="header-icon">
          <%= admin_icon('users', size: :lg) %>
        </div>
        <div class="header-text">
          <h1>User Management</h1>
          <p>Monitor and manage platform users</p>
        </div>
      </div>
    </div>

    <%# Stats Cards %>
    <div class="admin-stats-grid admin-mb-xl">
      <%= render 'admin/shared/stat_card',
          icon: 'users',
          label: 'Total Users',
          value: @stats[:total_users],
          variant: 'purple-gradient' %>

      <%= render 'admin/shared/stat_card',
          icon: 'check-circle',
          label: 'Onboarded',
          value: @stats[:onboarded],
          variant: 'info' %>

      <%= render 'admin/shared/stat_card',
          icon: 'shield',
          label: 'Admins',
          value: @stats[:admins],
          variant: 'warning' %>

      <%= render 'admin/shared/stat_card',
          icon: 'activity',
          label: 'Active Today',
          value: @stats[:active_today],
          variant: 'success' %>
    </div>

    <%# Users Table %>
    <div class="admin-card">
      <div class="admin-mb-lg">
        <h3 class="admin-text-primary admin-text-lg admin-font-semibold admin-m-0">All Users</h3>
      </div>

      <div class="admin-overflow-x-auto">
        <table class="admin-table">
          <thead>
            <tr>
              <th>ID</th>
              <th>Name</th>
              <th>Email</th>
              <th>Entity</th>
              <th>Role</th>
              <th>Onboarded</th>
              <th>Last Sign In</th>
              <th class="admin-text-right">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% @users.each do |user| %>
              <tr>
                <td class="admin-text-muted admin-text-sm">#<%= user.id %></td>
                <td>
                  <%= link_to user.full_name, admin_user_path(user), class: 'admin-link admin-font-semibold' %>
                </td>
                <td class="admin-text-muted admin-text-sm"><%= user.email %></td>
                <td class="admin-text-primary"><%= user.entity&.name || 'None' %></td>
                <td>
                  <% if user.role == 'admin' %>
                    <span class="admin-badge admin-badge-warning"><%= user.role.titleize %></span>
                  <% else %>
                    <span class="admin-badge admin-badge-default"><%= user.role.titleize %></span>
                  <% end %>
                </td>
                <td>
                  <% if user.onboarded? %>
                    <span class="admin-badge admin-badge-online">YES</span>
                  <% else %>
                    <span class="admin-badge admin-badge-offline">NO</span>
                  <% end %>
                </td>
                <td class="admin-text-muted admin-text-sm">
                  <%= user.current_sign_in_at ? time_ago_in_words(user.current_sign_in_at) + ' ago' : 'Never' %>
                </td>
                <td class="admin-text-right">
                  <div class="admin-inline-flex admin-flex-gap-sm">
                    <%= link_to admin_user_path(user), class: 'admin-btn admin-btn-sm admin-btn-outline', aria: { label: 'View user' } do %>
                      <%= admin_icon('eye', size: :sm) %>
                      <span>View</span>
                    <% end %>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>

      <% if @users.respond_to?(:total_pages) && @users.total_pages > 1 %>
        <div class="admin-mt-lg">
          <%= paginate @users %>
        </div>
      <% end %>
    </div>
  </div>
</div>

<script>
  document.addEventListener('turbo:load', () => {
    lucide.createIcons();
  });

  document.addEventListener('DOMContentLoaded', () => {
    lucide.createIcons();
  });
</script>

