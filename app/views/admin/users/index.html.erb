<div class="container-fluid">
  <div class="row mb-4">
    <div class="col">
      <h1><i class="fas fa-users text-primary"></i> User Management</h1>
      <p class="text-muted">Monitor and manage platform users</p>
    </div>
  </div>

  <!-- Stats -->
  <div class="row mb-4">
    <div class="col-md-3">
      <div class="card border-0 shadow-sm">
        <div class="card-body">
          <div class="small text-muted mb-1">Total Users</div>
          <div class="h3 mb-0"><%= @stats[:total_users] %></div>
        </div>
      </div>
    </div>
    <div class="col-md-3">
      <div class="card border-0 shadow-sm">
        <div class="card-body">
          <div class="small text-muted mb-1">Onboarded</div>
          <div class="h3 mb-0 text-success"><%= @stats[:onboarded] %></div>
        </div>
      </div>
    </div>
    <div class="col-md-3">
      <div class="card border-0 shadow-sm">
        <div class="card-body">
          <div class="small text-muted mb-1">Admins</div>
          <div class="h3 mb-0 text-warning"><%= @stats[:admins] %></div>
        </div>
      </div>
    </div>
    <div class="col-md-3">
      <div class="card border-0 shadow-sm">
        <div class="card-body">
          <div class="small text-muted mb-1">Active Today</div>
          <div class="h3 mb-0 text-info"><%= @stats[:active_today] %></div>
        </div>
      </div>
    </div>
  </div>

  <!-- Users Table -->
  <div class="row">
    <div class="col-12">
      <div class="card border-0 shadow-sm">
        <div class="card-header bg-white">
          <h5 class="mb-0">All Users</h5>
        </div>
        <div class="card-body">
          <div class="table-responsive">
            <table class="table table-hover">
              <thead>
                <tr>
                  <th>ID</th>
                  <th>Name</th>
                  <th>Email</th>
                  <th>Entity</th>
                  <th>Role</th>
                  <th>Onboarded</th>
                  <th>Last Sign In</th>
                  <th>Actions</th>
                </tr>
              </thead>
              <tbody>
                <% @users.each do |user| %>
                  <tr>
                    <td><%= user.id %></td>
                    <td><%= user.full_name %></td>
                    <td><%= user.email %></td>
                    <td><%= user.entity&.name || 'None' %></td>
                    <td>
                      <span class="badge bg-<%= user.role == 'admin' ? 'danger' : 'secondary' %>">
                        <%= user.role.titleize %>
                      </span>
                    </td>
                    <td>
                      <% if user.onboarded? %>
                        <i class="fas fa-check text-success"></i>
                      <% else %>
                        <i class="fas fa-times text-muted"></i>
                      <% end %>
                    </td>
                    <td>
                      <%= user.current_sign_in_at ? time_ago_in_words(user.current_sign_in_at) + ' ago' : 'Never' %>
                    </td>
                    <td>
                      <%= link_to "View", admin_user_path(user), class: "btn btn-outline-primary btn-sm" %>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
          
          <% if @users.respond_to?(:total_pages) && @users.total_pages > 1 %>
            <div class="mt-3">
              <%= paginate @users %>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>

