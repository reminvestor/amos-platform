<div style="padding: 2rem;">
  <!-- Page Header -->
  <div class="admin-page-header" style="margin-bottom: 2rem;">
    <div class="header-left">
      <div class="header-icon" style="background: linear-gradient(135deg, #8B5CF6 0%, #6D28D9 100%);">
        <i data-lucide="users" style="color: white;"></i>
      </div>
      <div class="header-text">
        <h1>User Management</h1>
        <p>Monitor and manage platform users</p>
      </div>
    </div>
  </div>

  <!-- Stats Cards -->
  <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1.5rem; margin-bottom: 2rem;">
    <div class="admin-card">
      <div style="display: flex; align-items: center; gap: 1rem;">
        <div style="width: 3rem; height: 3rem; border-radius: 0.75rem; background: linear-gradient(135deg, #7C3AED 0%, #A78BFA 100%); display: flex; align-items: center; justify-content: center;">
          <i data-lucide="users" style="width: 1.5rem; height: 1.5rem; color: white;"></i>
        </div>
        <div>
          <p style="color: #94A3B8; font-size: 0.875rem; margin: 0;">Total Users</p>
          <h3 style="color: white; font-size: 1.875rem; font-weight: 600; margin: 0;"><%= @stats[:total_users] %></h3>
        </div>
      </div>
    </div>

    <div class="admin-card">
      <div style="display: flex; align-items: center; gap: 1rem;">
        <div style="width: 3rem; height: 3rem; border-radius: 0.75rem; background: rgba(34, 211, 238, 0.1); border: 1px solid rgba(34, 211, 238, 0.2); display: flex; align-items: center; justify-content: center;">
          <i data-lucide="check-circle" style="width: 1.5rem; height: 1.5rem; color: #22D3EE;"></i>
        </div>
        <div>
          <p style="color: #94A3B8; font-size: 0.875rem; margin: 0;">Onboarded</p>
          <h3 style="color: white; font-size: 1.875rem; font-weight: 600; margin: 0;"><%= @stats[:onboarded] %></h3>
        </div>
      </div>
    </div>

    <div class="admin-card">
      <div style="display: flex; align-items: center; gap: 1rem;">
        <div style="width: 3rem; height: 3rem; border-radius: 0.75rem; background: rgba(234, 179, 8, 0.1); border: 1px solid rgba(234, 179, 8, 0.2); display: flex; align-items: center; justify-content: center;">
          <i data-lucide="shield" style="width: 1.5rem; height: 1.5rem; color: rgb(250, 204, 21);"></i>
        </div>
        <div>
          <p style="color: #94A3B8; font-size: 0.875rem; margin: 0;">Admins</p>
          <h3 style="color: white; font-size: 1.875rem; font-weight: 600; margin: 0;"><%= @stats[:admins] %></h3>
        </div>
      </div>
    </div>

    <div class="admin-card">
      <div style="display: flex; align-items: center; gap: 1rem;">
        <div style="width: 3rem; height: 3rem; border-radius: 0.75rem; background: rgba(34, 197, 94, 0.1); border: 1px solid rgba(34, 197, 94, 0.2); display: flex; align-items: center; justify-content: center;">
          <i data-lucide="activity" style="width: 1.5rem; height: 1.5rem; color: rgb(74, 222, 128);"></i>
        </div>
        <div>
          <p style="color: #94A3B8; font-size: 0.875rem; margin: 0;">Active Today</p>
          <h3 style="color: white; font-size: 1.875rem; font-weight: 600; margin: 0;"><%= @stats[:active_today] %></h3>
        </div>
      </div>
    </div>
  </div>

  <!-- Users Table -->
  <div class="admin-card">
    <h3 class="card-title" style="margin-bottom: 1.5rem;">All Users</h3>

    <div class="admin-table-container">
      <table class="admin-table">
        <thead>
          <tr>
            <th>ID</th>
            <th>Name</th>
            <th>Email</th>
            <th>Entity</th>
            <th>Role</th>
            <th>Onboarded</th>
            <th>Last Sign In</th>
            <th style="text-align: right;">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% @users.each do |user| %>
            <tr>
              <td style="color: #64748B; font-size: 0.875rem;">#<%= user.id %></td>
              <td>
                <%= link_to user.full_name, admin_user_path(user), style: "color: #22D3EE; font-weight: 600; text-decoration: none;" %>
              </td>
              <td style="color: #64748B; font-size: 0.875rem;"><%= user.email %></td>
              <td style="color: white;"><%= user.entity&.name || 'None' %></td>
              <td>
                <% if user.role == 'admin' %>
                  <span class="admin-badge admin-badge-warning"><%= user.role.titleize %></span>
                <% else %>
                  <span class="admin-badge admin-badge-secondary"><%= user.role.titleize %></span>
                <% end %>
              </td>
              <td>
                <% if user.onboarded? %>
                  <span class="admin-badge admin-badge-online">YES</span>
                <% else %>
                  <span class="admin-badge admin-badge-offline">NO</span>
                <% end %>
              </td>
              <td style="color: #64748B; font-size: 0.875rem;">
                <%= user.current_sign_in_at ? time_ago_in_words(user.current_sign_in_at) + ' ago' : 'Never' %>
              </td>
              <td style="text-align: right;">
                <div style="display: inline-flex; gap: 0.5rem;">
                  <%= link_to admin_user_path(user), class: 'admin-btn admin-btn-sm admin-btn-outline icon-btn', style: "border-color: #1E293B; color: #3B82F6;", aria: { label: 'View user' } do %>
                    <i data-lucide="eye" style="width: 1rem; height: 1rem;"></i>
                  <% end %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <% if @users.respond_to?(:total_pages) && @users.total_pages > 1 %>
      <div class="admin-pagination">
        <%= paginate @users %>
      </div>
    <% end %>
  </div>
</div>

<script>
  document.addEventListener('turbo:load', () => {
    lucide.createIcons();
  });

  document.addEventListener('DOMContentLoaded', () => {
    lucide.createIcons();
  });
</script>
