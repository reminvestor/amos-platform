
<div class="admin-content admin-p-xl">
  <div class="container-fluid">
    <%# Page Header %>
    <div class="admin-page-header admin-mb-xl">
      <div class="header-left">
        <div class="header-icon">
          <%= admin_icon('user', size: :lg) %>
        </div>
        <div class="header-text">
          <h1><%= @user.full_name %></h1>
          <p><%= @user.email %></p>
        </div>
      </div>

      <div class="header-actions">
        <%= link_to admin_users_path, class: "admin-btn admin-btn-outline" do %>
          <%= admin_icon('arrow-left', size: :sm) %>
          <span>Back to Users</span>
        <% end %>
      </div>
    </div>

    <div class="row">
      <%# Main Content Column %>
      <div class="col-lg-8">
        <%# User Information Card %>
        <div class="admin-card admin-mb-lg">
          <h5 class="admin-section-heading">
            <%= admin_icon('info', size: :md) %>
            User Information
          </h5>

          <dl class="row admin-dl">
            <dt class="col-sm-3">User ID</dt>
            <dd class="col-sm-9"><%= @user.id %></dd>

            <dt class="col-sm-3">Name</dt>
            <dd class="col-sm-9"><%= @user.full_name %></dd>

            <dt class="col-sm-3">Email</dt>
            <dd class="col-sm-9"><%= @user.email %></dd>

            <dt class="col-sm-3">Role</dt>
            <dd class="col-sm-9">
              <span class="admin-badge <%= @user.role == 'admin' ? 'admin-badge-error' : 'admin-badge-secondary' %>">
                <%= @user.role.titleize %>
              </span>
            </dd>

            <dt class="col-sm-3">Entity</dt>
            <dd class="col-sm-9">
              <% if @user.entity %>
                <%= link_to @user.entity.name, admin_integrations_path, class: "admin-link" %>
                <span class="admin-text-muted">(ID: <%= @user.entity.id %>)</span>
              <% else %>
                <span class="admin-text-muted">No entity assigned</span>
              <% end %>
            </dd>

            <dt class="col-sm-3">Onboarded</dt>
            <dd class="col-sm-9">
              <% if @user.onboarded? %>
                <%= admin_icon('check-circle', size: :sm, class: 'admin-inline admin-text-success') %>
                <span class="admin-text-success">Yes</span>
              <% else %>
                <%= admin_icon('x-circle', size: :sm, class: 'admin-inline admin-text-error') %>
                <span class="admin-text-error">No</span>
              <% end %>
            </dd>

            <dt class="col-sm-3">Created</dt>
            <dd class="col-sm-9"><%= @user.created_at.strftime("%B %d, %Y") %></dd>

            <dt class="col-sm-3">Last Sign In</dt>
            <dd class="col-sm-9">
              <%= @user.current_sign_in_at ? @user.current_sign_in_at.strftime("%B %d, %Y at %I:%M %p") : 'Never' %>
            </dd>

            <dt class="col-sm-3">Sign In Count</dt>
            <dd class="col-sm-9"><%= @user.sign_in_count || 0 %></dd>
          </dl>
        </div>

        <%# Activity Stats Card %>
        <div class="admin-card">
          <h5 class="admin-section-heading">
            <%= admin_icon('activity', size: :md) %>
            Activity Stats
          </h5>

          <div class="row text-center">
            <div class="col-md-3">
              <div class="admin-stat-box admin-stat-box-purple">
                <div class="admin-stat-box-value"><%= @user.campaigns.count %></div>
                <div class="admin-stat-box-label">Campaigns</div>
              </div>
            </div>
            <div class="col-md-3">
              <div class="admin-stat-box admin-stat-box-cyan">
                <div class="admin-stat-box-value"><%= @user.contacts.count %></div>
                <div class="admin-stat-box-label">Contacts</div>
              </div>
            </div>
            <div class="col-md-3">
              <div class="admin-stat-box admin-stat-box-green">
                <div class="admin-stat-box-value"><%= @user.landing_pages.count %></div>
                <div class="admin-stat-box-label">Landing Pages</div>
              </div>
            </div>
            <div class="col-md-3">
              <div class="admin-stat-box admin-stat-box-yellow">
                <div class="admin-stat-box-value"><%= @user.email_templates.count %></div>
                <div class="admin-stat-box-label">Email Templates</div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <%# Sidebar Actions Column %>
      <div class="col-lg-4">
        <div class="admin-card">
          <h5 class="admin-section-heading">
            <%= admin_icon('settings', size: :md) %>
            Admin Actions
          </h5>

          <%# Warning Alert %>
          <div class="admin-alert-warning">
            <%= admin_icon('alert-triangle', size: :sm, class: 'admin-flex-none admin-mt-xs admin-text-warning') %>
            <small class="admin-text-secondary admin-leading-relaxed">
              <strong class="admin-text-primary">Note:</strong> Changes to user accounts should be made carefully and only when necessary for platform administration.
            </small>
          </div>

          <%# Action Buttons %>
          <div class="admin-btn-group">
            <%= link_to edit_admin_user_path(@user), class: "admin-btn admin-btn-outline w-100" do %>
              <%= admin_icon('pencil', size: :sm) %>
              <span>Edit User Details</span>
            <% end %>

            <% unless @user.role == 'admin' %>
              <%= button_to make_admin_admin_user_path(@user),
                  method: :post,
                  class: "admin-btn admin-btn-outline admin-btn-warning-outline w-100",
                  form: { data: { turbo_confirm: "Make #{@user.full_name} an admin?" } } do %>
                <%= admin_icon('shield-check', size: :sm) %>
                <span>Make Admin</span>
              <% end %>
            <% end %>

            <%= button_to reset_password_admin_user_path(@user),
                method: :post,
                class: "admin-btn admin-btn-outline admin-btn-info-outline w-100",
                form: { data: { turbo_confirm: "Reset password for #{@user.full_name}? A temporary password will be generated and emailed to the user." } } do %>
              <%= admin_icon('key', size: :sm) %>
              <span>Reset Password</span>
            <% end %>

            <%= button_to admin_user_path(@user),
                method: :delete,
                class: "admin-btn admin-btn-outline admin-btn-danger-outline w-100",
                form: { data: { turbo_confirm: "Delete #{@user.full_name}? This cannot be undone." } } do %>
              <%= admin_icon('trash-2', size: :sm) %>
              <span>Delete User</span>
            <% end %>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  document.addEventListener('turbo:load', () => {
    if (typeof lucide !== 'undefined') {
      lucide.createIcons();
    }
  });

  document.addEventListener('DOMContentLoaded', () => {
    if (typeof lucide !== 'undefined') {
      lucide.createIcons();
    }
  });
</script>
