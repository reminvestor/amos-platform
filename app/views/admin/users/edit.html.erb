
<div class="admin-content admin-p-xl">
  <div class="container-fluid">
    <%# Page Header %>
    <div class="admin-page-header admin-mb-xl">
      <div class="header-left">
        <div class="header-icon admin-icon-gradient-purple">
          <%= admin_icon('user-pen', size: :lg) %>
        </div>
        <div class="header-text">
          <h1>Edit User</h1>
          <p>Update <%= @user.full_name %>'s account details</p>
        </div>
      </div>

      <div class="header-actions">
        <%= link_to admin_user_path(@user), class: "admin-btn admin-btn-outline" do %>
          <%= admin_icon('arrow-left', size: :sm) %>
          <span>Back to User</span>
        <% end %>
      </div>
    </div>

    <div class="row">
      <%# Main Form Column %>
      <div class="col-lg-8">
        <div class="admin-card">
          <%= form_with(model: [:admin, @user], local: true) do |f| %>
            <%# Error Messages %>
            <% if @user.errors.any? %>
              <div class="admin-alert admin-alert-error">
                <h5>
                  <%= admin_icon('alert-circle', size: :md) %>
                  Errors:
                </h5>
                <ul class="admin-m-0">
                  <% @user.errors.full_messages.each do |msg| %>
                    <li><%= msg %></li>
                  <% end %>
                </ul>
              </div>
            <% end %>

            <%# First Name Field %>
            <div class="form-group">
              <%= f.label :first_name, "First Name", class: "form-label" %>
              <%= f.text_field :first_name, class: "form-control", placeholder: "Enter first name",
                  style: "background-color: var(--bg-input); border: 1px solid var(--border-primary); color: var(--text-primary); padding: 0.75rem; border-radius: 0.5rem;" %>
            </div>

            <%# Last Name Field %>
            <div class="form-group">
              <%= f.label :last_name, "Last Name", class: "form-label" %>
              <%= f.text_field :last_name, class: "form-control", placeholder: "Enter last name",
                  style: "background-color: var(--bg-input); border: 1px solid var(--border-primary); color: var(--text-primary); padding: 0.75rem; border-radius: 0.5rem;" %>
            </div>

            <%# Email Field %>
            <div class="form-group">
              <%= f.label :email, "Email Address", class: "form-label" %>
              <%= f.email_field :email, class: "form-control", placeholder: "user@example.com",
                  style: "background-color: var(--bg-input); border: 1px solid var(--border-primary); color: var(--text-primary); padding: 0.75rem; border-radius: 0.5rem;" %>
            </div>

            <%# Onboarded Checkbox %>
            <div class="form-group">
              <div class="form-check">
                <%= f.check_box :onboarded, checked: @user.onboarded?, class: "admin-mr-sm" %>
                <%= f.label :onboarded, "Mark as Onboarded", class: "admin-text-primary" %>
                <small class="form-helper-text admin-ml-xl">
                  User has completed onboarding process
                </small>
              </div>
            </div>

            <%# Resource Limits %>
            <div class="admin-mt-lg admin-pt-lg admin-border-t">
              <h5 class="admin-section-heading admin-mb-md">
                <%= admin_icon('sliders', size: :sm, class: 'admin-text-info') %>
                <span>Creation Limits</span>
              </h5>
              
              <div class="row">
                <div class="col-md-4">
                  <div class="form-group">
                    <%= f.label :agents_limit, "Agents Limit", class: "form-label" %>
                    <%= f.number_field :agents_limit, class: "form-control", min: 0,
                        style: "background-color: var(--bg-input); border: 1px solid var(--border-primary); color: var(--text-primary); padding: 0.75rem; border-radius: 0.5rem;" %>
                  </div>
                </div>
                <div class="col-md-4">
                  <div class="form-group">
                    <%= f.label :tools_limit, "Tools Limit", class: "form-label" %>
                    <%= f.number_field :tools_limit, class: "form-control", min: 0,
                        style: "background-color: var(--bg-input); border: 1px solid var(--border-primary); color: var(--text-primary); padding: 0.75rem; border-radius: 0.5rem;" %>
                  </div>
                </div>
                <div class="col-md-4">
                  <div class="form-group">
                    <%= f.label :integrations_limit, "Integrations Limit", class: "form-label" %>
                    <%= f.number_field :integrations_limit, class: "form-control", min: 0,
                        style: "background-color: var(--bg-input); border: 1px solid var(--border-primary); color: var(--text-primary); padding: 0.75rem; border-radius: 0.5rem;" %>
                  </div>
                </div>
              </div>
              <p class="admin-text-secondary admin-text-sm admin-mt-sm">
                These limits control how many custom resources this user can create. Admins bypass these limits.
              </p>
            </div>

            <%# Action Buttons %>
            <div class="admin-flex admin-flex-gap-md admin-pt-lg admin-border-t">
              <%= f.submit "Save Changes", class: "admin-btn admin-btn-primary" %>
              <%= link_to admin_user_path(@user), class: "admin-btn admin-btn-outline" do %>
                <%= admin_icon('x', size: :sm) %>
                <span>Cancel</span>
              <% end %>
            </div>
          <% end %>
        </div>

        <%# Info Alert %>
        <div class="admin-alert admin-alert-info admin-mt-lg">
          <div class="admin-flex admin-items-start admin-flex-gap-md">
            <%= admin_icon('info', size: :md, class: 'admin-text-info admin-flex-none admin-mt-xs') %>
            <div>
              <strong class="admin-text-primary">Note:</strong>
              <span class="admin-text-secondary"> Role changes must be made from the user details page using the "Make Admin" button. You can update basic profile information here.</span>
            </div>
          </div>
        </div>
      </div>

      <%# Tips Sidebar %>
      <div class="col-lg-4">
        <div class="admin-card">
          <h5 class="admin-section-heading admin-mb-lg">
            <%= admin_icon('lightbulb', size: :md, class: 'admin-text-warning') %>
            <span>User Management Tips</span>
          </h5>

          <div class="admin-mb-lg">
            <p class="admin-text-primary admin-font-semibold admin-mb-sm">Changing Roles:</p>
            <p class="admin-text-secondary admin-text-sm admin-leading-relaxed">
              To promote a user to admin, use the "Make Admin" button on the user details page. This ensures proper permission tracking.
            </p>
          </div>

          <div class="admin-mb-lg">
            <p class="admin-text-primary admin-font-semibold admin-mb-sm">Onboarding Status:</p>
            <p class="admin-text-secondary admin-text-sm admin-leading-relaxed">
              Mark users as onboarded once they've completed the initial setup process. This helps track user engagement.
            </p>
          </div>

          <div>
            <p class="admin-text-primary admin-font-semibold admin-mb-sm">Email Changes:</p>
            <p class="admin-text-secondary admin-text-sm admin-leading-relaxed">
              Changing a user's email address may require them to verify the new address before they can log in again.
            </p>
          </div>
        </div>

        <%# Warning Card %>
        <div class="admin-card admin-mt-lg">
          <div class="admin-alert-warning">
            <div class="admin-flex admin-items-start admin-flex-gap-sm">
              <%= admin_icon('alert-triangle', size: :sm, class: 'admin-text-warning admin-flex-none admin-mt-xs') %>
              <small class="admin-text-secondary admin-leading-relaxed">
                <strong class="admin-text-primary">Caution:</strong> Be careful when modifying user accounts. Changes may affect their ability to access the platform.
              </small>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  document.addEventListener('turbo:load', () => {
    if (typeof lucide !== 'undefined') {
      lucide.createIcons();
    }
  });

  document.addEventListener('DOMContentLoaded', () => {
    if (typeof lucide !== 'undefined') {
      lucide.createIcons();
    }
  });
</script>
