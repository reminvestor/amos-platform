<% content_for :title, "Pull Requests" %>

<div class="container-fluid py-4">
  <div class="row mb-4">
    <div class="col-12">
      <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
          <li class="breadcrumb-item"><%= link_to "Admin", admin_dashboard_path %></li>
          <li class="breadcrumb-item"><%= link_to "Evolution Engine", admin_platform_evolution_path %></li>
          <li class="breadcrumb-item active">Pull Requests</li>
        </ol>
      </nav>
      <div class="d-flex justify-content-between align-items-center">
        <div>
          <h1 class="mb-1">🔀 Pull Requests</h1>
          <p class="text-muted mb-0">AI-generated pull requests for code fixes</p>
        </div>
      </div>
    </div>
  </div>

  <!-- Filters -->
  <div class="row mb-4">
    <div class="col-12">
      <div class="card border-0 shadow-sm">
        <div class="card-body">
          <%= form_tag pull_requests_admin_platform_evolution_path, method: :get, class: "row g-3" do %>
            <div class="col-md-3">
              <%= select_tag :status, 
                options_for_select([['All Statuses', ''], ['Pending Review', 'pending_review'], ['Approved', 'approved'], ['Merged', 'merged'], ['Closed', 'closed']], params[:status]),
                class: "form-select" %>
            </div>
            <div class="col-md-2">
              <button type="submit" class="btn btn-primary">
                <i data-lucide="filter"></i> Filter
              </button>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <!-- PRs List -->
  <div class="row">
    <div class="col-12">
      <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
          <% if @prs.any? %>
            <table class="table table-hover mb-0">
              <thead>
                <tr>
                  <th>PR</th>
                  <th>Branch</th>
                  <th>Ticket</th>
                  <th>Status</th>
                  <th>Created</th>
                  <th class="text-end">Actions</th>
                </tr>
              </thead>
              <tbody>
                <% @prs.each do |pr| %>
                  <tr>
                    <td>
                      <% if pr.pr_url.present? %>
                        <%= link_to "##{pr.pr_number || pr.id}", pr.pr_url, target: "_blank" %>
                      <% else %>
                        <code>#<%= pr.pr_number || pr.id %></code>
                      <% end %>
                    </td>
                    <td><code><%= pr.branch_name %></code></td>
                    <td>
                      <%= link_to pr.support_ticket&.ticket_number, ticket_admin_platform_evolution_path(pr.support_ticket) %>
                    </td>
                    <td><span class="badge bg-<%= pr_status_class(pr.status) %>"><%= pr.status&.humanize %></span></td>
                    <td><%= time_ago_in_words(pr.created_at) %> ago</td>
                    <td class="text-end">
                      <%= link_to pull_request_admin_platform_evolution_path(pr), class: "btn btn-sm btn-outline-primary" do %>
                        View
                      <% end %>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
            
            <%= paginate @prs if @prs.respond_to?(:total_pages) %>
          <% else %>
            <div class="p-4 text-center text-muted">
              <i data-lucide="git-pull-request" style="width: 48px; height: 48px; opacity: 0.3;"></i>
              <p class="mt-3 mb-0">No pull requests found</p>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>


