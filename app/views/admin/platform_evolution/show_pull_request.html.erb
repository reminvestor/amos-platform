<% content_for :title, "Pull Request ##{@pr.pr_number || @pr.id}" %>

<div class="container-fluid py-4">
  <div class="row mb-4">
    <div class="col-12">
      <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
          <li class="breadcrumb-item"><%= link_to "Admin", admin_dashboard_path %></li>
          <li class="breadcrumb-item"><%= link_to "Evolution Engine", admin_platform_evolution_path %></li>
          <li class="breadcrumb-item"><%= link_to "Pull Requests", pull_requests_admin_platform_evolution_path %></li>
          <li class="breadcrumb-item active">PR #<%= @pr.pr_number || @pr.id %></li>
        </ol>
      </nav>
      <div class="d-flex justify-content-between align-items-center">
        <div>
          <h1 class="mb-1">🔀 Pull Request #<%= @pr.pr_number || @pr.id %></h1>
          <p class="text-muted mb-0">
            <code><%= @pr.branch_name %></code>
          </p>
        </div>
        <div>
          <span class="badge bg-<%= pr_status_class(@pr.status) %> fs-6"><%= @pr.status&.humanize %></span>
        </div>
      </div>
    </div>
  </div>

  <div class="row">
    <!-- Main Content -->
    <div class="col-lg-8">
      <!-- PR Details -->
      <div class="card border-0 shadow-sm mb-4">
        <div class="card-header bg-light">
          <h5 class="mb-0"><i data-lucide="git-pull-request"></i> Pull Request Details</h5>
        </div>
        <div class="card-body">
          <% if @pr.pr_url.present? %>
            <p>
              <strong>GitHub URL:</strong> 
              <%= link_to @pr.pr_url, @pr.pr_url, target: "_blank", class: "text-primary" %>
            </p>
          <% end %>
          
          <div class="row">
            <div class="col-md-6">
              <p><strong>Branch:</strong> <code><%= @pr.branch_name %></code></p>
              <p><strong>Target:</strong> <code><%= @pr.target_branch || 'main' %></code></p>
            </div>
            <div class="col-md-6">
              <p><strong>Created:</strong> <%= @pr.created_at.strftime('%Y-%m-%d %H:%M') %></p>
              <% if @pr.merged_at %>
                <p><strong>Merged:</strong> <%= @pr.merged_at.strftime('%Y-%m-%d %H:%M') %></p>
                <p><strong>Merged By:</strong> <%= @pr.merged_by %></p>
              <% end %>
            </div>
          </div>

          <% if @pr.pr_description.present? %>
            <hr>
            <h6>Description</h6>
            <div class="bg-light p-3 rounded">
              <%= simple_format(@pr.pr_description) %>
            </div>
          <% end %>
        </div>
      </div>

      <!-- Related Ticket -->
      <div class="card border-0 shadow-sm mb-4">
        <div class="card-header bg-light">
          <h5 class="mb-0"><i data-lucide="ticket"></i> Related Ticket</h5>
        </div>
        <div class="card-body">
          <div class="d-flex justify-content-between align-items-start">
            <div>
              <h6><code><%= @ticket.ticket_number %></code> - <%= @ticket.title %></h6>
              <p class="text-muted mb-0"><%= @ticket.description&.truncate(150) %></p>
            </div>
            <%= link_to ticket_admin_platform_evolution_path(@ticket), class: "btn btn-sm btn-outline-primary" do %>
              View Ticket
            <% end %>
          </div>
        </div>
      </div>

      <!-- Code Fix -->
      <div class="card border-0 shadow-sm mb-4">
        <div class="card-header bg-light">
          <h5 class="mb-0"><i data-lucide="code-2"></i> Related Code Fix</h5>
        </div>
        <div class="card-body">
          <div class="d-flex justify-content-between align-items-start">
            <div>
              <h6><%= @fix.fix_description %></h6>
              <p class="text-muted mb-0">
                <span class="badge bg-<%= risk_badge_class(@fix.risk_level) %>"><%= @fix.risk_level %> risk</span>
                <span class="ms-2"><%= @fix.files_changed_count %> files changed</span>
              </p>
            </div>
            <%= link_to code_fix_admin_platform_evolution_path(@fix), class: "btn btn-sm btn-outline-primary" do %>
              View Fix
            <% end %>
          </div>
        </div>
      </div>
    </div>

    <!-- Sidebar -->
    <div class="col-lg-4">
      <!-- Actions -->
      <div class="card border-0 shadow-sm mb-4">
        <div class="card-header bg-light">
          <h5 class="mb-0"><i data-lucide="settings"></i> Actions</h5>
        </div>
        <div class="card-body">
          <% if @pr.status == 'pending_review' %>
            <%= button_to merge_pr_admin_platform_evolution_path(@pr), method: :post, class: "btn btn-success w-100 mb-2", data: { confirm: "Merge this pull request?" } do %>
              <i data-lucide="git-merge"></i> Merge PR
            <% end %>
            <% if @pr.pr_url.present? %>
              <%= link_to @pr.pr_url, target: "_blank", class: "btn btn-outline-primary w-100" do %>
                <i data-lucide="external-link"></i> View on GitHub
              <% end %>
            <% end %>
          <% elsif @pr.status == 'merged' %>
            <div class="alert alert-success mb-0">
              <i data-lucide="check-circle"></i>
              <strong>Merged!</strong>
              <% if @pr.merge_commit_sha %>
                <br>
                <small class="text-muted">Commit: <%= @pr.merge_commit_sha.first(8) %></small>
              <% end %>
            </div>
          <% elsif @pr.status == 'closed' %>
            <div class="alert alert-secondary mb-0">
              <i data-lucide="x-circle"></i>
              <strong>Closed without merge</strong>
            </div>
          <% end %>
        </div>
      </div>

      <!-- Timeline -->
      <div class="card border-0 shadow-sm">
        <div class="card-header bg-light">
          <h5 class="mb-0"><i data-lucide="clock"></i> Timeline</h5>
        </div>
        <div class="card-body">
          <div class="timeline-simple">
            <div class="timeline-item">
              <small class="text-muted"><%= @pr.created_at.strftime('%Y-%m-%d %H:%M') %></small>
              <p class="mb-0">PR created</p>
            </div>
            <% if @pr.merged_at %>
              <div class="timeline-item">
                <small class="text-muted"><%= @pr.merged_at.strftime('%Y-%m-%d %H:%M') %></small>
                <p class="mb-0">PR merged by <%= @pr.merged_by %></p>
              </div>
            <% end %>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
.timeline-simple .timeline-item {
  position: relative;
  padding-left: 20px;
  padding-bottom: 15px;
  border-left: 2px solid #e9ecef;
}

.timeline-simple .timeline-item:before {
  content: '';
  position: absolute;
  left: -5px;
  top: 0;
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: #6c757d;
}

.timeline-simple .timeline-item:last-child {
  border-left-color: transparent;
}
</style>


