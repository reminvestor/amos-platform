<div class="admin-p-xl">
  <!-- Page Header -->
  <div class="admin-page-header admin-mb-xl">
    <div class="header-left">
      <div class="header-icon admin-icon-gradient-purple">
        <i data-lucide="ticket" class="admin-text-primary"></i>
      </div>
      <div class="header-text">
        <div class="admin-flex admin-items-center admin-flex-gap-sm admin-mb-sm">
          <span class="admin-badge <%= @ticket.priority == 'critical' ? 'admin-badge-danger' : (@ticket.priority == 'high' ? 'admin-badge-warning' : 'admin-badge-secondary') %>">
            <%= @ticket.priority %>
          </span>
          <h1 class="admin-mb-0"><%= @ticket.ticket_number %></h1>
        </div>
        <p><%= @ticket.title %></p>
      </div>
    </div>

    <div class="header-actions">
      <div class="admin-flex admin-flex-gap-sm">
        <%= link_to tickets_admin_platform_evolution_path, class: "admin-btn admin-btn-secondary" do %>
          <i data-lucide="arrow-left"></i>
          <span>All Tickets</span>
        <% end %>
        <% if @ticket.is_open? %>
          <%= button_to "Start Debug", debug_ticket_admin_platform_evolution_path(@ticket), method: :post, class: "admin-btn admin-btn-primary" %>
        <% end %>
      </div>
    </div>
  </div>

  <div class="admin-grid-2">
    <!-- Ticket Details - Main Column -->
    <div class="admin-flex admin-flex-col admin-flex-gap-lg">
      <!-- Details Card -->
      <div class="admin-card">
        <div class="admin-card-header">
          <h5 class="admin-text-primary admin-mb-0">
            <i data-lucide="file-text" class="admin-icon-sm admin-mr-sm"></i>
            Details
          </h5>
        </div>
        <div class="admin-p-lg">
          <div class="admin-text-secondary"><%= simple_format(@ticket.description) %></div>

          <% if @ticket.error_class.present? %>
            <hr class="admin-border-t admin-my-lg">
            <h6 class="admin-text-primary admin-mb-md">Error Information</h6>
            <p class="admin-mb-sm"><strong class="admin-text-primary">Class:</strong> <code class="admin-code-block admin-p-sm"><%= @ticket.error_class %></code></p>
            <p class="admin-mb-sm"><strong class="admin-text-primary">Message:</strong> <span class="admin-text-secondary"><%= @ticket.error_message %></span></p>
            <% if @ticket.error_file.present? %>
              <p class="admin-mb-sm">
                <strong class="admin-text-primary">Location:</strong>
                <code class="admin-code-block admin-p-sm"><%= @ticket.error_file %><% if @ticket.error_line %>:<%= @ticket.error_line %><% end %></code>
              </p>
            <% end %>
            <% if @ticket.stack_trace.present? %>
              <div class="admin-mt-lg">
                <h6 class="admin-text-primary admin-mb-md">Stack Trace</h6>
                <pre class="admin-code-block admin-scroll-400"><%= @ticket.stack_trace %></pre>
              </div>
            <% else %>
              <div class="admin-alert-warning admin-mt-lg">
                <i data-lucide="alert-triangle" class="admin-icon-sm admin-text-warning"></i>
                <span class="admin-text-warning">No stack trace captured. The error may have been logged without a full backtrace.</span>
              </div>
            <% end %>
          <% end %>

          <% if @ticket.resolution_notes.present? %>
            <hr class="admin-border-t admin-my-lg">
            <h6 class="admin-text-primary admin-mb-md">Resolution</h6>
            <p class="admin-text-secondary"><%= @ticket.resolution_notes %></p>
          <% end %>
        </div>
      </div>

      <!-- Work Status -->
      <div class="admin-card">
        <div class="admin-card-header">
          <h5 class="admin-text-primary admin-mb-0">
            <% if @ticket.is_open? %>
              <i data-lucide="loader" class="admin-icon-sm admin-mr-sm"></i>
              Work Status
            <% else %>
              <i data-lucide="check-circle" class="admin-icon-sm admin-mr-sm admin-text-success"></i>
              Work Completed
            <% end %>
          </h5>
        </div>
        <div class="admin-p-lg">
          <div class="admin-pipeline-steps admin-mb-lg">
            <%
              has_merged_pr = @prs.any? { |pr| pr.status == 'merged' }
              steps = [
                { name: 'Detected', done: true },
                { name: 'Investigating', done: @debug_sessions.any? },
                { name: 'Debugging', done: @debug_sessions.any? { |s| s.status.in?(%w[analyzing reproducing proposing_fix completed]) } },
                { name: 'Fix Created', done: @code_fixes.any? },
                { name: 'PR Submitted', done: @prs.any? },
                { name: 'Merged', done: has_merged_pr }
              ]
            %>
            <% steps.each_with_index do |step, idx| %>
              <div class="admin-pipeline-step">
                <div class="admin-pipeline-icon <%= step[:done] ? 'admin-bg-success' : 'admin-bg-secondary' %>">
                  <% if step[:done] %>
                    <i data-lucide="check"></i>
                  <% else %>
                    <span><%= idx + 1 %></span>
                  <% end %>
                </div>
                <p class="<%= step[:done] ? 'admin-text-primary' : 'admin-text-muted' %> admin-font-medium admin-mb-0"><%= step[:name] %></p>
              </div>
              <% unless idx == steps.length - 1 %>
                <div class="admin-pipeline-arrow">
                  <i data-lucide="arrow-right" class="admin-text-muted"></i>
                </div>
              <% end %>
            <% end %>
          </div>

          <% if @debug_sessions.empty? && @ticket.is_open? %>
            <div class="admin-info-box">
              <i data-lucide="info" class="admin-icon-sm admin-text-info"></i>
              <div>
                <strong class="admin-text-info">Queued for debugging.</strong>
                <span class="admin-text-secondary">The AI debug agent will analyze this ticket shortly.</span>
                <br>
                <small class="admin-text-muted">Click "Start Debug" to manually trigger debugging now.</small>
              </div>
            </div>
          <% elsif @debug_sessions.any? { |s| s.status.in?(%w[gathering_info analyzing reproducing proposing_fix]) } %>
            <div class="admin-info-box">
              <i data-lucide="loader" class="admin-icon-sm admin-text-primary"></i>
              <span class="admin-text-primary"><strong>Actively debugging.</strong> The AI is working on this issue.</span>
            </div>
          <% end %>
        </div>
      </div>

      <!-- Debug Sessions -->
      <div class="admin-card">
        <div class="admin-card-header">
          <h5 class="admin-text-primary admin-mb-0">
            <i data-lucide="search" class="admin-icon-sm admin-mr-sm"></i>
            Debug Sessions (<%= @debug_sessions.count %>)
          </h5>
        </div>
        <% if @debug_sessions.any? %>
          <div class="admin-table-container">
            <table class="admin-table">
              <thead>
                <tr>
                  <th>Session</th>
                  <th>Status</th>
                  <th>Confidence</th>
                  <th>Started</th>
                  <th>Actions</th>
                </tr>
              </thead>
              <tbody>
                <% @debug_sessions.each do |session| %>
                  <tr>
                    <td><code class="admin-text-secondary"><%= session.session_id[0..15] %>...</code></td>
                    <td>
                      <span class="admin-badge <%= session.status == 'completed' ? 'admin-badge-success' : 'admin-badge-info' %>">
                        <%= session.status %>
                      </span>
                    </td>
                    <td class="admin-text-secondary">
                      <% if session.confidence_score %>
                        <%= (session.confidence_score * 100).round %>%
                      <% else %>
                        -
                      <% end %>
                    </td>
                    <td class="admin-text-secondary admin-text-sm"><%= session.started_at&.strftime('%Y-%m-%d %H:%M') %></td>
                    <td>
                      <%= link_to debug_session_admin_platform_evolution_path(session), class: "admin-btn admin-btn-sm admin-btn-outline" do %>
                        <i data-lucide="eye" class="admin-icon-sm"></i>
                      <% end %>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        <% else %>
          <div class="admin-p-lg admin-text-center admin-text-muted">
            No debug sessions yet
          </div>
        <% end %>
      </div>

      <!-- Code Fixes -->
      <div class="admin-card">
        <div class="admin-card-header">
          <h5 class="admin-text-primary admin-mb-0">
            <i data-lucide="wrench" class="admin-icon-sm admin-mr-sm"></i>
            Code Fixes (<%= @code_fixes.count %>)
          </h5>
        </div>
        <% if @code_fixes.any? %>
          <div class="admin-table-container">
            <table class="admin-table">
              <thead>
                <tr>
                  <th>Fix</th>
                  <th>Status</th>
                  <th>Tests</th>
                  <th>Risk</th>
                  <th>Created</th>
                  <th>Actions</th>
                </tr>
              </thead>
              <tbody>
                <% @code_fixes.each do |fix| %>
                  <tr>
                    <td><code class="admin-text-secondary"><%= fix.fix_id %></code></td>
                    <td>
                      <span class="admin-badge <%= fix.status == 'validated' ? 'admin-badge-success' : (fix.status == 'rejected' ? 'admin-badge-danger' : 'admin-badge-info') %>">
                        <%= fix.status %>
                      </span>
                    </td>
                    <td>
                      <% if fix.tests_passed %>
                        <span class="admin-text-success">Passed</span>
                      <% elsif fix.test_results.present? %>
                        <span class="admin-text-danger">Failed</span>
                      <% else %>
                        <span class="admin-text-muted">-</span>
                      <% end %>
                    </td>
                    <td>
                      <span class="admin-badge <%= fix.risk_level == 'low' ? 'admin-badge-success' : (fix.risk_level == 'critical' ? 'admin-badge-danger' : 'admin-badge-warning') %>">
                        <%= fix.risk_level %>
                      </span>
                    </td>
                    <td class="admin-text-secondary admin-text-sm"><%= fix.created_at.strftime('%Y-%m-%d %H:%M') %></td>
                    <td>
                      <%= link_to code_fix_admin_platform_evolution_path(fix), class: "admin-btn admin-btn-sm admin-btn-outline" do %>
                        <i data-lucide="eye" class="admin-icon-sm"></i>
                      <% end %>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        <% else %>
          <div class="admin-p-lg admin-text-center admin-text-muted">
            No code fixes yet
          </div>
        <% end %>
      </div>
    </div>

    <!-- Sidebar -->
    <div class="admin-flex admin-flex-col admin-flex-gap-lg">
      <!-- Status Card -->
      <div class="admin-card">
        <div class="admin-card-header">
          <h6 class="admin-text-primary admin-mb-0">Status</h6>
        </div>
        <div class="admin-p-lg">
          <dl class="admin-dl">
            <dt>Status</dt>
            <dd><strong><%= @ticket.status.humanize %></strong></dd>
            <dt>Priority</dt>
            <dd><strong><%= @ticket.priority.humanize %></strong></dd>
            <dt>Category</dt>
            <dd><%= @ticket.category&.humanize || '-' %></dd>
            <dt>Source</dt>
            <dd><%= @ticket.source.humanize %></dd>
            <dt>Reporter</dt>
            <dd><%= @ticket.user&.email || 'System' %></dd>
            <dt>Created</dt>
            <dd><%= @ticket.created_at.strftime('%Y-%m-%d %H:%M') %></dd>
            <% if @ticket.resolved_at %>
              <dt>Resolved</dt>
              <dd><%= @ticket.resolved_at.strftime('%Y-%m-%d %H:%M') %></dd>
              <dt>Time to Resolution</dt>
              <dd><%= @ticket.time_to_resolution_minutes %> minutes</dd>
            <% end %>
          </dl>
        </div>
      </div>

      <!-- Pull Requests Card -->
      <% if @prs.any? %>
        <div class="admin-card">
          <div class="admin-card-header">
            <h6 class="admin-text-primary admin-mb-0">Pull Requests</h6>
          </div>
          <div class="admin-list">
            <% @prs.each do |pr| %>
              <div class="admin-list-item admin-flex admin-justify-between admin-items-center">
                <div>
                  <strong class="admin-text-primary">PR #<%= pr.pr_number %></strong>
                  <span class="admin-badge <%= pr.status == 'merged' ? 'admin-badge-success' : 'admin-badge-info' %>"><%= pr.status %></span>
                </div>
                <% if pr.pr_url %>
                  <%= link_to pr.pr_url, target: '_blank', class: "admin-btn admin-btn-sm admin-btn-outline" do %>
                    <i data-lucide="external-link" class="admin-icon-sm"></i>
                  <% end %>
                <% end %>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>

<script>
  document.addEventListener('turbo:load', () => {
    lucide.createIcons();
  });
</script>
