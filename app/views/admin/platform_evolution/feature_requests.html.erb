<div class="admin-p-xl">
  <!-- Page Header -->
  <div class="admin-page-header admin-mb-xl">
    <div class="header-left">
      <div class="header-icon admin-icon-gradient-purple">
        <i data-lucide="lightbulb" class="admin-text-primary"></i>
      </div>
      <div class="header-text">
        <h1>Feature Requests</h1>
        <p>Review and approve feature requests before development begins</p>
      </div>
    </div>

    <div class="header-actions">
      <%= link_to admin_platform_evolution_path, class: "admin-btn admin-btn-secondary" do %>
        <i data-lucide="arrow-left"></i>
        <span>Dashboard</span>
      <% end %>
    </div>
  </div>

  <!-- Pending Approval -->
  <div class="admin-card admin-mb-xl">
    <div class="admin-card-header">
      <h5 class="admin-text-primary admin-mb-0">
        <i data-lucide="clock" class="admin-icon-sm admin-mr-sm admin-text-warning"></i>
        Pending Approval
        <% if @pending_features.any? %>
          <span class="admin-badge admin-badge-warning admin-ml-sm"><%= @pending_features.count %></span>
        <% end %>
      </h5>
    </div>
    <div class="admin-table-container">
      <% if @pending_features.any? %>
        <table class="admin-table">
          <thead>
            <tr>
              <th>Ticket</th>
              <th>Title</th>
              <th>Requested By</th>
              <th>Entity</th>
              <th>Created</th>
              <th class="admin-text-right">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% @pending_features.each do |ticket| %>
              <tr>
                <td><code class="admin-text-secondary"><%= ticket.ticket_number %></code></td>
                <td>
                  <strong class="admin-text-primary"><%= ticket.title.truncate(50) %></strong>
                  <div class="admin-text-muted admin-text-sm"><%= ticket.description&.truncate(100) %></div>
                </td>
                <td class="admin-text-secondary"><%= ticket.user&.email || 'System' %></td>
                <td class="admin-text-secondary"><%= ticket.entity&.name %></td>
                <td class="admin-text-secondary admin-text-sm"><%= time_ago_in_words(ticket.created_at) %> ago</td>
                <td class="admin-text-right">
                  <div class="admin-flex admin-justify-end admin-flex-gap-sm">
                    <%= link_to ticket_admin_platform_evolution_path(ticket), class: "admin-btn admin-btn-sm admin-btn-outline" do %>
                      <i data-lucide="eye" class="admin-icon-sm"></i>
                    <% end %>
                    <%= button_to approve_feature_admin_platform_evolution_path(ticket), method: :post, class: "admin-btn admin-btn-sm admin-btn-success", data: { confirm: "Approve this feature request for development?" } do %>
                      <i data-lucide="check" class="admin-icon-sm"></i>
                    <% end %>
                    <%= button_to reject_feature_admin_platform_evolution_path(ticket), method: :post, params: { reason: 'Not aligned with current priorities' }, class: "admin-btn admin-btn-sm admin-btn-danger-outline", data: { confirm: "Reject this feature request?" } do %>
                      <i data-lucide="x" class="admin-icon-sm"></i>
                    <% end %>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      <% else %>
        <div class="admin-p-xl admin-text-center admin-text-muted">
          <div class="admin-mb-md">
            <i data-lucide="check-circle" class="admin-icon-3x"></i>
          </div>
          <p>No feature requests pending approval</p>
        </div>
      <% end %>
    </div>
  </div>

  <!-- Two Column Layout -->
  <div class="admin-grid-2">
    <!-- Approved & In Progress -->
    <div class="admin-card">
      <div class="admin-card-header">
        <h5 class="admin-text-primary admin-mb-0">
          <i data-lucide="rocket" class="admin-icon-sm admin-mr-sm admin-text-success"></i>
          Approved & In Progress
        </h5>
      </div>
      <% if @approved_features.any? %>
        <div class="admin-list">
          <% @approved_features.each do |ticket| %>
            <div class="admin-list-item admin-flex admin-justify-between admin-items-start">
              <div>
                <strong class="admin-text-primary"><%= ticket.title.truncate(40) %></strong>
                <div class="admin-text-muted admin-text-sm">
                  <code><%= ticket.ticket_number %></code>
                  <span class="admin-ml-sm"><%= ticket.entity&.name %></span>
                  <span class="admin-badge <%= ticket.status == 'in_progress' ? 'admin-badge-info' : (ticket.status == 'completed' ? 'admin-badge-success' : 'admin-badge-secondary') %> admin-ml-sm"><%= ticket.status.humanize %></span>
                </div>
              </div>
              <%= link_to ticket_admin_platform_evolution_path(ticket), class: "admin-btn admin-btn-sm admin-btn-outline" do %>
                View
              <% end %>
            </div>
          <% end %>
        </div>
      <% else %>
        <div class="admin-p-lg admin-text-center admin-text-muted">
          No approved features in progress
        </div>
      <% end %>
    </div>

    <!-- Recently Rejected -->
    <div class="admin-card">
      <div class="admin-card-header">
        <h5 class="admin-text-primary admin-mb-0">
          <i data-lucide="x-circle" class="admin-icon-sm admin-mr-sm admin-text-danger"></i>
          Recently Rejected
        </h5>
      </div>
      <% if @rejected_features.any? %>
        <div class="admin-list">
          <% @rejected_features.each do |ticket| %>
            <div class="admin-list-item admin-flex admin-justify-between admin-items-start">
              <div>
                <strong class="admin-text-primary"><%= ticket.title.truncate(40) %></strong>
                <div class="admin-text-muted admin-text-sm">
                  <code><%= ticket.ticket_number %></code>
                  <span class="admin-ml-sm"><%= ticket.resolution_notes&.truncate(50) || 'Rejected' %></span>
                </div>
              </div>
              <small class="admin-text-muted"><%= time_ago_in_words(ticket.updated_at) %> ago</small>
            </div>
          <% end %>
        </div>
      <% else %>
        <div class="admin-p-lg admin-text-center admin-text-muted">
          No recent rejections
        </div>
      <% end %>
    </div>
  </div>
</div>

<script>
  document.addEventListener('turbo:load', () => {
    lucide.createIcons();
  });
</script>
