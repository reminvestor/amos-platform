<div class="admin-p-xl">
  <!-- Page Header -->
  <div class="admin-page-header admin-mb-xl">
    <div class="header-left">
      <div class="header-icon admin-icon-gradient-purple">
        <i data-lucide="file-warning" class="admin-text-primary"></i>
      </div>
      <div class="header-text">
        <h1>Error Logs</h1>
        <p>Captured errors from application logs</p>
      </div>
    </div>

    <div class="header-actions">
      <div class="admin-flex admin-flex-gap-sm">
        <%= link_to admin_platform_evolution_path, class: "admin-btn admin-btn-secondary" do %>
          <i data-lucide="arrow-left"></i>
          <span>Dashboard</span>
        <% end %>
        <%= button_to run_log_scan_admin_platform_evolution_path, method: :post, class: "admin-btn admin-btn-primary" do %>
          <i data-lucide="scan-line"></i>
          <span>Scan Logs Now</span>
        <% end %>
      </div>
    </div>
  </div>

  <!-- Grouped Errors (Last 24 Hours) -->
  <% if @grouped_errors.present? && @grouped_errors.any? %>
    <div class="admin-card admin-mb-xl">
      <div class="admin-card-header">
        <h5 class="admin-text-primary admin-mb-0">
          <i data-lucide="alert-triangle" class="admin-icon-sm admin-mr-sm admin-text-danger"></i>
          Error Groups (Last 24 Hours)
          <span class="admin-badge admin-badge-danger admin-ml-sm"><%= @grouped_errors.count %></span>
        </h5>
      </div>
      <div class="admin-table-container">
        <table class="admin-table">
          <thead>
            <tr>
              <th>Error</th>
              <th>Count</th>
              <th>Last Seen</th>
              <th>Ticket</th>
            </tr>
          </thead>
          <tbody>
            <% @grouped_errors.each do |error| %>
              <tr>
                <td>
                  <strong class="admin-text-danger"><%= error[:error_class] %></strong>
                  <div class="admin-text-muted admin-text-sm"><%= error[:error_message]&.truncate(80) %></div>
                </td>
                <td><span class="admin-badge admin-badge-danger"><%= error[:count] %></span></td>
                <td class="admin-text-secondary"><%= time_ago_in_words(error[:last_seen]) %> ago</td>
                <td>
                  <% if error[:ticket_id] %>
                    <%= link_to error[:ticket_number], ticket_admin_platform_evolution_path(error[:ticket_id]), class: "admin-text-info" %>
                  <% else %>
                    <span class="admin-text-muted">-</span>
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  <% end %>

  <!-- Filters -->
  <div class="admin-card admin-mb-xl">
    <%= form_tag error_logs_admin_platform_evolution_path, method: :get, class: 'admin-filter-grid' do %>
      <div class="admin-flex admin-items-center admin-flex-gap-md">
        <label class="admin-flex admin-items-center admin-flex-gap-sm">
          <%= check_box_tag :unprocessed, 'true', params[:unprocessed] == 'true', class: "admin-checkbox" %>
          <span class="admin-text-secondary">Unprocessed Only</span>
        </label>
      </div>
      <%= submit_tag 'Filter', class: 'admin-btn admin-btn-primary admin-mb-0' %>
    <% end %>
  </div>

  <!-- Error Entries -->
  <div class="admin-card">
    <div class="admin-card-header">
      <h5 class="admin-text-primary admin-mb-0">
        <i data-lucide="list" class="admin-icon-sm admin-mr-sm"></i>
        Error Entries
      </h5>
    </div>
    <div class="admin-table-container">
      <% if @entries.any? %>
        <table class="admin-table">
          <thead>
            <tr>
              <th>Error</th>
              <th>Source</th>
              <th>Occurred</th>
              <th>Status</th>
              <th>Ticket</th>
            </tr>
          </thead>
          <tbody>
            <% @entries.each do |entry| %>
              <tr>
                <td>
                  <strong class="admin-text-danger"><%= entry.error_class %></strong>
                  <div class="admin-text-muted admin-text-sm"><%= entry.error_message&.truncate(60) %></div>
                </td>
                <td>
                  <code class="admin-text-secondary"><%= entry.source_file&.split('/')&.last %></code>
                  <% if entry.line_number %>:<%= entry.line_number %><% end %>
                </td>
                <td class="admin-text-secondary admin-text-sm"><%= time_ago_in_words(entry.occurred_at || entry.created_at) %> ago</td>
                <td>
                  <% if entry.processed_at %>
                    <span class="admin-badge admin-badge-success">Processed</span>
                  <% else %>
                    <span class="admin-badge admin-badge-warning">Unprocessed</span>
                  <% end %>
                </td>
                <td>
                  <% if entry.support_ticket %>
                    <%= link_to entry.support_ticket.ticket_number, ticket_admin_platform_evolution_path(entry.support_ticket), class: "admin-text-info" %>
                  <% else %>
                    <span class="admin-text-muted">-</span>
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      <% else %>
        <div class="admin-p-xl admin-text-center admin-text-muted">
          <div class="admin-mb-md">
            <i data-lucide="check-circle" class="admin-icon-3x"></i>
          </div>
          <p>No error logs found</p>
        </div>
      <% end %>
    </div>
  </div>

  <!-- Pagination -->
  <% if @entries.respond_to?(:total_pages) && @entries.any? %>
    <div class="admin-pagination">
      <%= paginate @entries %>
    </div>
  <% end %>
</div>

<script>
  document.addEventListener('turbo:load', () => {
    lucide.createIcons();
  });
</script>
