<% content_for :title, "Context Graph Stats" %>

<div class="container-fluid py-4">
  <div class="row mb-4">
    <div class="col-12">
      <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
          <li class="breadcrumb-item"><%= link_to "Admin", admin_dashboard_path %></li>
          <li class="breadcrumb-item"><%= link_to "Context Graph", admin_context_graph_path %></li>
          <li class="breadcrumb-item active">Stats</li>
        </ol>
      </nav>
      <h1 class="mb-1">📊 Context Graph Statistics</h1>
      <p class="text-muted mb-0">Decision analytics for the last <%= @period.inspect %></p>
    </div>
  </div>

  <!-- Summary Stats -->
  <div class="row mb-4">
    <div class="col-md-2">
      <div class="card border-0 shadow-sm h-100">
        <div class="card-body text-center">
          <h2 class="text-primary mb-0"><%= number_with_delimiter(@stats[:total_decisions]) %></h2>
          <small class="text-muted">Total Decisions</small>
        </div>
      </div>
    </div>
    <div class="col-md-2">
      <div class="card border-0 shadow-sm h-100">
        <div class="card-body text-center">
          <h2 class="text-warning mb-0"><%= number_to_percentage(@stats[:exception_rate] * 100, precision: 1) %></h2>
          <small class="text-muted">Exception Rate</small>
        </div>
      </div>
    </div>
    <div class="col-md-2">
      <div class="card border-0 shadow-sm h-100">
        <div class="card-body text-center">
          <h2 class="text-success mb-0"><%= number_to_percentage(@stats[:precedent_usage_rate] * 100, precision: 1) %></h2>
          <small class="text-muted">Precedent Usage</small>
        </div>
      </div>
    </div>
    <div class="col-md-2">
      <div class="card border-0 shadow-sm h-100">
        <div class="card-body text-center">
          <h2 class="text-info mb-0"><%= @stats[:avg_confidence] || 'N/A' %></h2>
          <small class="text-muted">Avg Confidence</small>
        </div>
      </div>
    </div>
  </div>

  <div class="row mb-4">
    <!-- By Decision Type -->
    <div class="col-md-6">
      <div class="card border-0 shadow-sm">
        <div class="card-header bg-transparent">
          <h5 class="mb-0">Decisions by Type</h5>
        </div>
        <div class="card-body">
          <table class="table table-sm">
            <thead>
              <tr>
                <th>Type</th>
                <th class="text-end">Count</th>
              </tr>
            </thead>
            <tbody>
              <% @stats[:by_type].each do |type, count| %>
                <tr>
                  <td><code><%= type %></code></td>
                  <td class="text-end"><%= count %></td>
                </tr>
              <% end %>
              <% if @stats[:by_type].empty? %>
                <tr>
                  <td colspan="2" class="text-muted text-center">No decisions recorded yet</td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <!-- By Outcome -->
    <div class="col-md-6">
      <div class="card border-0 shadow-sm">
        <div class="card-header bg-transparent">
          <h5 class="mb-0">Decisions by Outcome</h5>
        </div>
        <div class="card-body">
          <table class="table table-sm">
            <thead>
              <tr>
                <th>Outcome</th>
                <th class="text-end">Count</th>
              </tr>
            </thead>
            <tbody>
              <% @stats[:by_outcome].each do |outcome, count| %>
                <tr>
                  <td>
                    <% case outcome %>
                    <% when 'success' %>
                      <span class="badge bg-success">Success</span>
                    <% when 'failure' %>
                      <span class="badge bg-danger">Failure</span>
                    <% when 'partial' %>
                      <span class="badge bg-warning">Partial</span>
                    <% else %>
                      <span class="badge bg-secondary"><%= outcome || 'Unknown' %></span>
                    <% end %>
                  </td>
                  <td class="text-end"><%= count %></td>
                </tr>
              <% end %>
              <% if @stats[:by_outcome].empty? %>
                <tr>
                  <td colspan="2" class="text-muted text-center">No decisions recorded yet</td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>

  <!-- Learning Stats -->
  <div class="row mb-4">
    <div class="col-md-6">
      <div class="card border-0 shadow-sm">
        <div class="card-header bg-transparent d-flex justify-content-between align-items-center">
          <h5 class="mb-0">🧠 Experience Learning Stats</h5>
          <%= link_to "View Details", admin_experience_learning_path, class: "btn btn-sm btn-outline-primary" %>
        </div>
        <div class="card-body">
          <% exp_from_traces = DecisionTrace.where('created_at > ?', @period.ago)
               .where("metadata->>'experience_created' = 'true'").count %>
          <% implicit_outcomes = DecisionTrace.where('created_at > ?', @period.ago)
               .where("outcome_details->>'source' = 'implicit_feedback'").count %>
          <% user_feedback_outcomes = DecisionTrace.where('created_at > ?', @period.ago)
               .where("outcome_details->>'source' = 'user_feedback'").count %>
          
          <table class="table table-sm mb-0">
            <tbody>
              <tr>
                <td>Experiences Created from Failures</td>
                <td class="text-end"><span class="badge bg-success"><%= exp_from_traces %></span></td>
              </tr>
              <tr>
                <td>Outcomes from Implicit Feedback</td>
                <td class="text-end"><span class="badge bg-info"><%= implicit_outcomes %></span></td>
              </tr>
              <tr>
                <td>Outcomes from User Feedback</td>
                <td class="text-end"><span class="badge bg-primary"><%= user_feedback_outcomes %></span></td>
              </tr>
              <tr>
                <td>Decisions with Confidence Score</td>
                <td class="text-end">
                  <span class="badge bg-secondary">
                    <%= DecisionTrace.where('created_at > ?', @period.ago).where.not(confidence_score: nil).count %>
                  </span>
                </td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>
    <div class="col-md-6">
      <div class="card border-0 shadow-sm">
        <div class="card-header bg-transparent">
          <h5 class="mb-0">📊 Outcome Sources</h5>
        </div>
        <div class="card-body">
          <% outcome_sources = DecisionTrace.where('created_at > ?', @period.ago)
               .where.not(outcome: nil)
               .group("outcome_details->>'source'")
               .count %>
          
          <% if outcome_sources.any? %>
            <table class="table table-sm mb-0">
              <thead>
                <tr>
                  <th>Source</th>
                  <th class="text-end">Count</th>
                </tr>
              </thead>
              <tbody>
                <% outcome_sources.each do |source, count| %>
                  <tr>
                    <td>
                      <% case source %>
                      <% when 'implicit_feedback' %>
                        <span class="badge bg-info">Implicit Feedback</span>
                      <% when 'user_feedback' %>
                        <span class="badge bg-primary">User Feedback</span>
                      <% when 'automated' %>
                        <span class="badge bg-secondary">Automated</span>
                      <% else %>
                        <span class="badge bg-light text-dark"><%= source || 'Not specified' %></span>
                      <% end %>
                    </td>
                    <td class="text-end"><%= count %></td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          <% else %>
            <p class="text-muted text-center mb-0">No outcome sources recorded yet</p>
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <!-- Daily Stats Chart -->
  <div class="row">
    <div class="col-12">
      <div class="card border-0 shadow-sm">
        <div class="card-header bg-transparent">
          <h5 class="mb-0">Daily Decision Volume</h5>
        </div>
        <div class="card-body">
          <% if @daily_stats.any? %>
            <div style="height: 300px;">
              <table class="table table-sm">
                <thead>
                  <tr>
                    <th>Date</th>
                    <th class="text-end">Decisions</th>
                    <th style="width: 60%;">Volume</th>
                  </tr>
                </thead>
                <tbody>
                  <% max_count = @daily_stats.map(&:decision_count).max || 1 %>
                  <% @daily_stats.each do |stat| %>
                    <tr>
                      <td><%= stat.stats_date %></td>
                      <td class="text-end"><%= stat.decision_count %></td>
                      <td>
                        <div class="progress" style="height: 20px;">
                          <div class="progress-bar bg-primary" style="width: <%= (stat.decision_count.to_f / max_count * 100).round %>%"></div>
                        </div>
                      </td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            </div>
          <% else %>
            <p class="text-muted text-center mb-0">No daily data available yet</p>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>


