<% content_for :title, "Context Graph Dashboard" %>

<div class="container-fluid py-4">
  <div class="row mb-4">
    <div class="col-12">
      <div class="d-flex justify-content-between align-items-center">
        <div>
          <h1 class="mb-1">🧠 Context Graph</h1>
          <p class="text-muted mb-0">Decision traces, precedents, and the "why" behind every Amos action</p>
        </div>
        <div>
          <%= link_to admin_experience_learning_path, class: "btn btn-outline-success me-2" do %>
            <i data-lucide="sparkles"></i> Experience Learning
          <% end %>
          <%= link_to stats_admin_context_graph_path, class: "btn btn-outline-primary" do %>
            <i data-lucide="bar-chart-2"></i> Stats
          <% end %>
          <%= link_to approvals_admin_context_graph_path, class: "btn btn-outline-warning" do %>
            <i data-lucide="check-circle"></i> Approvals
            <% if @global_stats[:pending_approvals] > 0 %>
              <span class="badge bg-warning text-dark"><%= @global_stats[:pending_approvals] %></span>
            <% end %>
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <!-- Stats Cards -->
  <div class="row mb-4">
    <div class="col-md-2">
      <div class="card border-0 shadow-sm h-100">
        <div class="card-body text-center">
          <h2 class="text-primary mb-0"><%= number_with_delimiter(@global_stats[:total_decisions]) %></h2>
          <small class="text-muted">Total Decisions</small>
        </div>
      </div>
    </div>
    <div class="col-md-2">
      <div class="card border-0 shadow-sm h-100">
        <div class="card-body text-center">
          <h2 class="text-info mb-0"><%= @global_stats[:decisions_today] %></h2>
          <small class="text-muted">Today</small>
        </div>
      </div>
    </div>
    <div class="col-md-2">
      <div class="card border-0 shadow-sm h-100">
        <div class="card-body text-center">
          <h2 class="text-warning mb-0"><%= @global_stats[:total_exceptions] %></h2>
          <small class="text-muted">Exceptions</small>
        </div>
      </div>
    </div>
    <div class="col-md-2">
      <div class="card border-0 shadow-sm h-100">
        <div class="card-body text-center">
          <h2 class="text-success mb-0"><%= number_with_delimiter(@global_stats[:total_precedent_links]) %></h2>
          <small class="text-muted">Precedent Links</small>
        </div>
      </div>
    </div>
    <div class="col-md-4">
      <div class="card border-0 shadow-sm h-100">
        <div class="card-header bg-white">
          <small class="text-muted">Decision Types (7 days)</small>
        </div>
        <div class="card-body p-2">
          <% @decision_breakdown.each do |type, count| %>
            <span class="badge bg-secondary me-1"><%= type %>: <%= count %></span>
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <div class="row">
    <!-- Recent Decisions -->
    <div class="col-md-8">
      <div class="card border-0 shadow-sm">
        <div class="card-header bg-white d-flex justify-content-between align-items-center">
          <h5 class="mb-0">📝 Recent Decisions</h5>
          <%= link_to "View All", decisions_admin_context_graph_path, class: "btn btn-sm btn-outline-primary" %>
        </div>
        <div class="card-body p-0">
          <table class="table table-hover mb-0">
            <thead class="table-light">
              <tr>
                <th>Decision</th>
                <th>Type</th>
                <th>Task Type</th>
                <th>Outcome</th>
                <th>Learning</th>
                <th>Time</th>
              </tr>
            </thead>
            <tbody>
              <% @recent_decisions.each do |decision| %>
                <tr>
                  <td>
                    <%= link_to decision.decision_summary.truncate(50), decision_admin_context_graph_path(decision) %>
                    <% if decision.is_exception? %>
                      <span class="badge bg-warning text-dark">Exception</span>
                    <% end %>
                  </td>
                  <td><span class="badge bg-secondary"><%= decision.decision_type %></span></td>
                  <td>
                    <% task_type = decision.metadata&.dig('task_type') %>
                    <% if task_type %>
                      <small class="badge bg-light text-dark"><%= task_type.gsub('_', ' ') %></small>
                    <% else %>
                      <span class="text-muted">-</span>
                    <% end %>
                  </td>
                  <td>
                    <% if decision.outcome %>
                      <span class="badge bg-<%= decision.outcome == 'success' ? 'success' : (decision.outcome == 'failure' ? 'danger' : 'secondary') %>">
                        <%= decision.outcome %>
                      </span>
                      <% if decision.outcome_details&.dig('source') == 'implicit_feedback' %>
                        <span class="badge bg-info" title="From implicit feedback">💬</span>
                      <% end %>
                    <% else %>
                      <span class="text-muted">-</span>
                    <% end %>
                  </td>
                  <td>
                    <% if decision.metadata&.dig('experience_created') %>
                      <span class="badge bg-success" title="Experience created from this decision">📚</span>
                    <% elsif decision.decision_precedents.count > 0 %>
                      <span class="badge bg-info" title="Used precedents"><%= decision.decision_precedents.count %> prec.</span>
                    <% else %>
                      <span class="text-muted">-</span>
                    <% end %>
                  </td>
                  <td><small><%= time_ago_in_words(decision.created_at) %> ago</small></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <!-- Sidebar -->
    <div class="col-md-4">
      <!-- Pending Approvals -->
      <div class="card border-0 shadow-sm mb-4">
        <div class="card-header bg-warning text-dark">
          <h6 class="mb-0">⏳ Pending Approvals</h6>
        </div>
        <div class="card-body p-0">
          <% if @pending_approvals.any? %>
            <div class="list-group list-group-flush">
              <% @pending_approvals.each do |decision| %>
                <div class="list-group-item">
                  <strong><%= decision.decision_summary.truncate(40) %></strong>
                  <br>
                  <small class="text-muted">
                    <%= decision.entity&.name %> • <%= time_ago_in_words(decision.created_at) %> ago
                  </small>
                  <div class="mt-2">
                    <%= link_to "Review", decision_admin_context_graph_path(decision), class: "btn btn-sm btn-outline-primary" %>
                  </div>
                </div>
              <% end %>
            </div>
          <% else %>
            <div class="p-3 text-center text-muted">
              <p class="mb-0">✅ No pending approvals</p>
            </div>
          <% end %>
        </div>
      </div>

      <!-- Recent Exceptions -->
      <div class="card border-0 shadow-sm mb-4">
        <div class="card-header bg-white">
          <h6 class="mb-0">⚠️ Recent Exceptions</h6>
        </div>
        <div class="card-body p-0">
          <% if @recent_exceptions.any? %>
            <div class="list-group list-group-flush">
              <% @recent_exceptions.first(5).each do |decision| %>
                <div class="list-group-item">
                  <strong><%= decision.decision_summary.truncate(40) %></strong>
                  <br>
                  <small class="text-muted">
                    <%= decision.entity&.name %> •
                    <span class="badge bg-<%= decision.outcome == 'success' ? 'success' : 'secondary' %>">
                      <%= decision.outcome || 'pending' %>
                    </span>
                  </small>
                </div>
              <% end %>
            </div>
          <% else %>
            <div class="p-3 text-center text-muted">
              <p class="mb-0">No exceptions yet</p>
            </div>
          <% end %>
        </div>
        <div class="card-footer bg-white">
          <%= link_to "View All Exceptions", exceptions_admin_context_graph_path, class: "btn btn-sm btn-outline-warning w-100" %>
        </div>
      </div>

      <!-- Entities -->
      <div class="card border-0 shadow-sm">
        <div class="card-header bg-white">
          <h6 class="mb-0">📊 By Entity</h6>
        </div>
        <div class="card-body p-0">
          <div class="list-group list-group-flush">
            <% @entities.each do |entity| %>
              <% count = DecisionTrace.where(entity: entity).count %>
              <%= link_to entity_admin_context_graph_path(entity), class: "list-group-item list-group-item-action d-flex justify-content-between align-items-center" do %>
                <%= entity.name %>
                <span class="badge bg-primary"><%= count %></span>
              <% end %>
            <% end %>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

