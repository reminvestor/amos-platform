<% content_for :title, "Experience Learning Dashboard" %>

<div class="container-fluid py-4">
  <div class="row mb-4">
    <div class="col-12">
      <div class="d-flex justify-content-between align-items-center">
        <div>
          <h1 class="mb-1">🧠 Experience Learning Dashboard</h1>
          <p class="text-muted mb-0">Training-Free GRPO: Continual learning from task executions</p>
        </div>
        <div>
          <%= button_to "Run Global Maintenance", run_maintenance_admin_experience_learning_path, 
              method: :post, class: "btn btn-outline-primary me-2" %>
          <%= link_to "Platform Experiences", platform_experiences_admin_experience_learning_path, 
              class: "btn btn-outline-secondary me-2" %>
          <%= link_to "Conflicts", conflicts_admin_experience_learning_path, 
              class: "btn btn-outline-warning" %>
        </div>
      </div>
    </div>
  </div>

  <!-- Stats Cards -->
  <div class="row mb-4">
    <div class="col-md-2">
      <div class="card border-0 shadow-sm h-100">
        <div class="card-body text-center">
          <h2 class="text-primary mb-0"><%= number_with_delimiter(@global_stats[:total_experiences]) %></h2>
          <small class="text-muted">Total Experiences</small>
        </div>
      </div>
    </div>
    <div class="col-md-2">
      <div class="card border-0 shadow-sm h-100">
        <div class="card-body text-center">
          <h2 class="text-success mb-0"><%= @global_stats[:active_experiences] %></h2>
          <small class="text-muted">Active</small>
        </div>
      </div>
    </div>
    <div class="col-md-2">
      <div class="card border-0 shadow-sm h-100">
        <div class="card-body text-center">
          <h2 class="text-info mb-0"><%= @global_stats[:platform_wide] %></h2>
          <small class="text-muted">Platform-Wide</small>
        </div>
      </div>
    </div>
    <div class="col-md-2">
      <div class="card border-0 shadow-sm h-100">
        <div class="card-body text-center">
          <h2 class="text-warning mb-0"><%= @global_stats[:high_utility] %></h2>
          <small class="text-muted">High Utility (≥0.6)</small>
        </div>
      </div>
    </div>
    <div class="col-md-2">
      <div class="card border-0 shadow-sm h-100">
        <div class="card-body text-center">
          <h2 class="mb-0"><%= number_with_delimiter(@global_stats[:total_applications]) %></h2>
          <small class="text-muted">Total Applications</small>
        </div>
      </div>
    </div>
    <div class="col-md-2">
      <div class="card border-0 shadow-sm h-100">
        <div class="card-body text-center">
          <h2 class="mb-0"><%= (@global_stats[:avg_success_rate] * 100).round(1) %>%</h2>
          <small class="text-muted">Avg Success Rate</small>
        </div>
      </div>
    </div>
  </div>

  <!-- Source Type Breakdown -->
  <div class="row mb-4">
    <div class="col-md-6">
      <div class="card border-0 shadow-sm">
        <div class="card-header bg-white">
          <h5 class="mb-0">📊 Experiences by Source</h5>
        </div>
        <div class="card-body">
          <% @global_stats[:by_source_type].each do |source, count| %>
            <div class="d-flex justify-content-between align-items-center mb-2">
              <span class="badge <%= source_type_badge_class(source) %>"><%= source&.titleize || 'Unknown' %></span>
              <span class="fw-bold"><%= count %></span>
            </div>
          <% end %>
        </div>
      </div>
    </div>
    <div class="col-md-6">
      <div class="card border-0 shadow-sm">
        <div class="card-header bg-white">
          <h5 class="mb-0">🎯 Experiences by Task Type</h5>
        </div>
        <div class="card-body p-0">
          <table class="table table-sm mb-0">
            <thead class="table-light">
              <tr>
                <th>Task Type</th>
                <th class="text-center">Count</th>
                <th class="text-center">Avg Utility</th>
                <th class="text-center">Applications</th>
              </tr>
            </thead>
            <tbody>
              <% @task_type_stats.each do |stat| %>
                <tr>
                  <td><%= stat.task_type.titleize.gsub('_', ' ') %></td>
                  <td class="text-center"><%= stat.count %></td>
                  <td class="text-center">
                    <span class="badge <%= utility_badge_class(stat.avg_utility) %>">
                      <%= stat.avg_utility&.round(2) || 'N/A' %>
                    </span>
                  </td>
                  <td class="text-center"><%= stat.total_applications %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>

  <!-- Implicit Feedback & Calibration -->
  <div class="row mb-4">
    <div class="col-md-6">
      <div class="card border-0 shadow-sm">
        <div class="card-header bg-white d-flex justify-content-between align-items-center">
          <h5 class="mb-0">💬 Implicit Feedback (7 days)</h5>
          <%= link_to "View All", implicit_feedback_admin_experience_learning_path, class: "btn btn-sm btn-outline-primary" %>
        </div>
        <div class="card-body">
          <div class="row text-center">
            <div class="col-4">
              <h3 class="text-primary mb-0"><%= @implicit_feedback_stats[:total_7d] %></h3>
              <small class="text-muted">Total Signals</small>
            </div>
            <div class="col-4">
              <h3 class="text-success mb-0"><%= @implicit_feedback_stats[:positive] %></h3>
              <small class="text-muted">Positive</small>
            </div>
            <div class="col-4">
              <h3 class="text-danger mb-0"><%= @implicit_feedback_stats[:negative] %></h3>
              <small class="text-muted">Negative</small>
            </div>
          </div>
          <hr>
          <h6>Detection Methods:</h6>
          <% @implicit_feedback_stats[:detection_methods].each do |method, count| %>
            <span class="badge bg-secondary me-1"><%= method %>: <%= count %></span>
          <% end %>
          <% if @implicit_feedback_stats[:detection_methods].empty? %>
            <span class="text-muted">No implicit signals detected yet</span>
          <% end %>
        </div>
      </div>
    </div>
    <div class="col-md-6">
      <div class="card border-0 shadow-sm">
        <div class="card-header bg-white">
          <h5 class="mb-0">📈 Confidence Calibration</h5>
        </div>
        <div class="card-body">
          <% if @calibration_overview.any? %>
            <table class="table table-sm mb-0">
              <thead>
                <tr>
                  <th>Entity</th>
                  <th class="text-center">Data Points</th>
                  <th class="text-center">Calibration</th>
                  <th class="text-center">Status</th>
                </tr>
              </thead>
              <tbody>
                <% @calibration_overview.first(5).each do |cal| %>
                  <tr>
                    <td>
                      <%= link_to cal[:entity].name, 
                          calibration_admin_experience_learning_path(cal[:entity]) %>
                    </td>
                    <td class="text-center"><%= cal[:data_points] %></td>
                    <td class="text-center">
                      <% if cal[:calibration_score] %>
                        <span class="badge <%= calibration_badge_class(cal[:calibration_score]) %>">
                          <%= (cal[:calibration_score] * 100).round %>%
                        </span>
                      <% else %>
                        <span class="text-muted">N/A</span>
                      <% end %>
                    </td>
                    <td class="text-center">
                      <% if cal[:significant_miscalibration] %>
                        <span class="badge bg-warning text-dark">Needs Attention</span>
                      <% else %>
                        <span class="badge bg-success">OK</span>
                      <% end %>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          <% else %>
            <p class="text-center text-muted mb-0">
              Not enough data for calibration analysis (need 20+ decisions with confidence scores)
            </p>
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <div class="row">
    <!-- Top Experiences -->
    <div class="col-md-6">
      <div class="card border-0 shadow-sm">
        <div class="card-header bg-white d-flex justify-content-between align-items-center">
          <h5 class="mb-0">⭐ Top Performing Experiences</h5>
          <%= link_to "View All", experiences_admin_experience_learning_path(high_utility: 'true'), 
              class: "btn btn-sm btn-outline-primary" %>
        </div>
        <div class="card-body p-0">
          <% if @top_experiences.any? %>
            <div class="list-group list-group-flush">
              <% @top_experiences.each do |exp| %>
                <div class="list-group-item">
                  <div class="d-flex justify-content-between align-items-start">
                    <div class="flex-grow-1">
                      <div class="d-flex align-items-center mb-1">
                        <span class="badge bg-primary me-2"><%= exp.task_type.gsub('_', ' ') %></span>
                        <span class="badge <%= utility_badge_class(exp.utility_score) %>">
                          <%= exp.utility_score.round(2) %>
                        </span>
                      </div>
                      <p class="mb-1"><%= exp.content.truncate(100) %></p>
                      <small class="text-muted">
                        <%= exp.apply_count %> applications • 
                        <%= (exp.success_rate * 100).round %>% success
                        <% if exp.entity.nil? %>
                          • <span class="badge bg-info">Platform-Wide</span>
                        <% end %>
                      </small>
                    </div>
                  </div>
                </div>
              <% end %>
            </div>
          <% else %>
            <div class="p-4 text-center text-muted">
              No high-performing experiences yet
            </div>
          <% end %>
        </div>
      </div>
    </div>

    <!-- Entities -->
    <div class="col-md-6">
      <div class="card border-0 shadow-sm">
        <div class="card-header bg-white">
          <h5 class="mb-0">📊 Entities</h5>
        </div>
        <div class="card-body p-0">
          <div class="list-group list-group-flush">
            <% @entities.each do |entity| %>
              <% exp_count = TaskExperience.where(entity: entity).active.count %>
              <% avg_utility = TaskExperience.where(entity: entity).active.average(:utility_score)&.round(2) %>
              <%= link_to entity_admin_experience_learning_path(entity), 
                  class: "list-group-item list-group-item-action d-flex justify-content-between align-items-center" do %>
                <div>
                  <strong><%= entity.name %></strong>
                  <% if avg_utility %>
                    <br>
                    <small class="text-muted">Avg Utility: <%= avg_utility %></small>
                  <% end %>
                </div>
                <span class="badge bg-primary"><%= exp_count %> experiences</span>
              <% end %>
            <% end %>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Recent Learning Activity -->
  <div class="row mt-4">
    <div class="col-12">
      <div class="card border-0 shadow-sm">
        <div class="card-header bg-white">
          <h5 class="mb-0">🔄 Recent Learning Activity</h5>
        </div>
        <div class="card-body">
          <% if @recent_cycles.any? %>
            <table class="table table-hover mb-0">
              <thead>
                <tr>
                  <th>Entity</th>
                  <th>Cycle Type</th>
                  <th class="text-center">Experiences Created</th>
                  <th class="text-center">Experiences Modified</th>
                  <th class="text-center">Task Types</th>
                  <th>Time</th>
                </tr>
              </thead>
              <tbody>
                <% @recent_cycles.each do |cycle| %>
                  <% learning_data = cycle.learnings&.find { |l| l['type'] == 'experience_learning' } %>
                  <% next unless learning_data %>
                  <tr>
                    <td><%= cycle.entity&.name %></td>
                    <td><span class="badge bg-info"><%= cycle.cycle_type %></span></td>
                    <td class="text-center">
                      <span class="badge bg-success"><%= learning_data['experiences_created'] %></span>
                    </td>
                    <td class="text-center">
                      <span class="badge bg-warning text-dark"><%= learning_data['experiences_modified'] %></span>
                    </td>
                    <td class="text-center"><%= learning_data['task_types_analyzed']&.count || 0 %></td>
                    <td><%= time_ago_in_words(cycle.created_at) %> ago</td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          <% else %>
            <p class="text-center text-muted mb-0">No evolution cycles with experience learning yet</p>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>

<% content_for :head do %>
<style>
  .badge { font-weight: 500; }
</style>
<% end %>
