<% content_for :title, "Confidence Calibration: #{@entity.name}" %>

<div class="container-fluid py-4">
  <div class="row mb-4">
    <div class="col-12">
      <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
          <li class="breadcrumb-item"><%= link_to "Experience Learning", admin_experience_learning_path %></li>
          <li class="breadcrumb-item"><%= link_to @entity.name, entity_admin_experience_learning_path(@entity) %></li>
          <li class="breadcrumb-item active">Calibration</li>
        </ol>
      </nav>
      <h1 class="mb-1">📈 Confidence Calibration</h1>
      <p class="text-muted mb-0">Analyzing how well Amos's confidence scores predict actual outcomes for <%= @entity.name %></p>
    </div>
  </div>

  <!-- Calibration Overview -->
  <div class="row mb-4">
    <div class="col-md-4">
      <div class="card border-0 shadow-sm h-100">
        <div class="card-body text-center">
          <% if @calibration[:overall_calibration_score] %>
            <h1 class="<%= calibration_badge_class(@calibration[:overall_calibration_score]).gsub('bg-', 'text-') %>">
              <%= (@calibration[:overall_calibration_score] * 100).round %>%
            </h1>
          <% else %>
            <h1 class="text-muted">N/A</h1>
          <% end %>
          <small class="text-muted">Overall Calibration Score</small>
        </div>
      </div>
    </div>
    <div class="col-md-4">
      <div class="card border-0 shadow-sm h-100">
        <div class="card-body text-center">
          <h2 class="mb-0"><%= @calibration[:data_points] %></h2>
          <small class="text-muted">Data Points Analyzed</small>
        </div>
      </div>
    </div>
    <div class="col-md-4">
      <div class="card border-0 shadow-sm h-100">
        <div class="card-body text-center">
          <h2 class="mb-0"><%= @calibration[:calibration]&.count || 0 %></h2>
          <small class="text-muted">Confidence Buckets</small>
        </div>
      </div>
    </div>
  </div>

  <!-- Guidance -->
  <% if @calibration[:guidance][:significant_miscalibration] %>
    <div class="alert alert-warning mb-4">
      <h5>⚠️ Calibration Issues Detected</h5>
      <p class="mb-2"><%= @calibration[:guidance][:text] %></p>
      <% issues = @calibration[:guidance][:issues] || [] %>
      <% overconfident_count = issues.count { |i| i[:type] == :overconfident } %>
      <% underconfident_count = issues.count { |i| i[:type] == :underconfident } %>
      <% if overconfident_count > 0 %>
        <span class="badge bg-danger me-2"><%= overconfident_count %> overconfident bucket(s)</span>
      <% end %>
      <% if underconfident_count > 0 %>
        <span class="badge bg-info me-2"><%= underconfident_count %> underconfident bucket(s)</span>
      <% end %>
    </div>
  <% else %>
    <div class="alert alert-success mb-4">
      <h5>✅ Well Calibrated</h5>
      <p class="mb-0">Amos's confidence scores align well with actual outcomes for this entity.</p>
    </div>
  <% end %>

  <!-- Calibration by Bucket -->
  <div class="row mb-4">
    <div class="col-12">
      <div class="card border-0 shadow-sm">
        <div class="card-header bg-white">
          <h5 class="mb-0">Calibration by Confidence Range</h5>
        </div>
        <div class="card-body">
          <% calibration_data = @calibration[:calibration] %>
          <% if calibration_data.present? && calibration_data.any? %>
            <table class="table mb-0">
              <thead>
                <tr>
                  <th>Confidence Range</th>
                  <th class="text-center">Sample Size</th>
                  <th class="text-center">Predicted Success</th>
                  <th class="text-center">Actual Success</th>
                  <th class="text-center">Calibration Error</th>
                  <th>Visualization</th>
                </tr>
              </thead>
              <tbody>
                <% calibration_data.sort.each do |bucket_key, bucket| %>
                  <tr>
                    <td><strong><%= "#{(bucket_key * 100).to_i}%-#{((bucket_key + 0.1) * 100).to_i}%" %></strong></td>
                    <td class="text-center"><%= bucket[:sample_size] %></td>
                    <td class="text-center"><%= (bucket[:predicted] * 100).round %>%</td>
                    <td class="text-center"><%= (bucket[:actual] * 100).round %>%</td>
                    <td class="text-center">
                      <% error = bucket[:difference].abs %>
                      <span class="badge <%= error < 0.1 ? 'bg-success' : (error < 0.2 ? 'bg-warning text-dark' : 'bg-danger') %>">
                        <%= (error * 100).round %>%
                      </span>
                      <% if bucket[:is_overconfident] %>
                        <small class="text-danger d-block">Overconfident</small>
                      <% elsif bucket[:is_underconfident] %>
                        <small class="text-info d-block">Underconfident</small>
                      <% end %>
                    </td>
                    <td style="width: 30%;">
                      <div class="d-flex align-items-center">
                        <div class="flex-grow-1">
                          <div class="progress" style="height: 20px;">
                            <div class="progress-bar bg-primary" style="width: <%= (bucket[:predicted] * 100).round %>%;" title="Predicted"></div>
                          </div>
                          <div class="progress mt-1" style="height: 20px;">
                            <div class="progress-bar bg-success" style="width: <%= (bucket[:actual] * 100).round %>%;" title="Actual"></div>
                          </div>
                        </div>
                        <div class="ms-2">
                          <small class="text-primary d-block">Predicted</small>
                          <small class="text-success d-block">Actual</small>
                        </div>
                      </div>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          <% else %>
            <p class="text-center text-muted mb-0">Not enough data for bucket analysis (need at least 5 decisions per confidence bucket)</p>
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <!-- Sample Decision Traces -->
  <div class="row">
    <div class="col-12">
      <div class="card border-0 shadow-sm">
        <div class="card-header bg-white">
          <h5 class="mb-0">Sample Decision Traces with Confidence</h5>
        </div>
        <div class="card-body p-0">
          <% if @sample_traces.any? %>
            <table class="table table-hover mb-0">
              <thead class="table-light">
                <tr>
                  <th>Summary</th>
                  <th>Type</th>
                  <th class="text-center">Confidence</th>
                  <th class="text-center">Outcome</th>
                  <th class="text-center">Calibration</th>
                  <th>Time</th>
                </tr>
              </thead>
              <tbody>
                <% @sample_traces.each do |trace| %>
                  <tr>
                    <td><%= trace.decision_summary.truncate(60) %></td>
                    <td><span class="badge bg-secondary"><%= trace.decision_type %></span></td>
                    <td class="text-center">
                      <span class="badge bg-info"><%= (trace.confidence_score * 100).round %>%</span>
                    </td>
                    <td class="text-center">
                      <span class="badge bg-<%= trace.outcome == 'success' ? 'success' : 'danger' %>">
                        <%= trace.outcome %>
                      </span>
                    </td>
                    <td class="text-center">
                      <% if trace.outcome == 'success' && trace.confidence_score >= 0.5 %>
                        <span class="badge bg-success">Correct</span>
                      <% elsif trace.outcome == 'failure' && trace.confidence_score < 0.5 %>
                        <span class="badge bg-success">Correct</span>
                      <% elsif trace.outcome == 'success' && trace.confidence_score < 0.5 %>
                        <span class="badge bg-info">Underconfident</span>
                      <% else %>
                        <span class="badge bg-danger">Overconfident</span>
                      <% end %>
                    </td>
                    <td><small><%= time_ago_in_words(trace.created_at) %> ago</small></td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          <% else %>
            <div class="p-4 text-center text-muted">
              No decision traces with confidence scores found
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
