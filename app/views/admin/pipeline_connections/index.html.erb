<div class="container-fluid py-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0">Pipeline Connections</h1>
    <%= link_to new_admin_pipeline_connection_path, class: 'btn btn-primary' do %>
      <i data-lucide="plus" class="me-2" style="width: 16px; height: 16px;"></i>
      New Connection
    <% end %>
  </div>

  <!-- Filter Tabs -->
  <ul class="nav nav-tabs mb-4" role="tablist">
    <li class="nav-item">
      <%= link_to 'All', admin_pipeline_connections_path, class: "nav-link #{params[:system_type].blank? ? 'active' : ''}" %>
    </li>
    <li class="nav-item">
      <%= link_to 'JIRA', admin_pipeline_connections_path(system_type: 'jira'), class: "nav-link #{params[:system_type] == 'jira' ? 'active' : ''}" %>
    </li>
    <li class="nav-item">
      <%= link_to 'GitHub', admin_pipeline_connections_path(system_type: 'github'), class: "nav-link #{params[:system_type] == 'github' ? 'active' : ''}" %>
    </li>
    <li class="nav-item">
      <%= link_to 'Azure DevOps', admin_pipeline_connections_path(system_type: 'azure_devops'), class: "nav-link #{params[:system_type] == 'azure_devops' ? 'active' : ''}" %>
    </li>
    <li class="nav-item">
      <%= link_to 'Azure Repos', admin_pipeline_connections_path(system_type: 'azure_repos'), class: "nav-link #{params[:system_type] == 'azure_repos' ? 'active' : ''}" %>
    </li>
  </ul>

  <% if @pipeline_connections.any? %>
    <div class="card">
      <div class="table-responsive">
        <table class="table table-hover mb-0">
          <thead class="table-light">
            <tr>
              <th>Name</th>
              <th>Type</th>
              <th>Status</th>
              <th>Last Sync</th>
              <th>Executions</th>
              <th class="text-end">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% @pipeline_connections.each do |connection| %>
              <tr>
                <td>
                  <%= link_to connection.name, admin_pipeline_connection_path(connection), class: 'text-decoration-none fw-semibold' %>
                </td>
                <td>
                  <span class="badge bg-secondary">
                    <%= connection.system_type.upcase %>
                  </span>
                </td>
                <td>
                  <% if connection.status_active? %>
                    <span class="badge bg-success">Active</span>
                  <% elsif connection.status_inactive? %>
                    <span class="badge bg-secondary">Inactive</span>
                  <% else %>
                    <span class="badge bg-danger">Error</span>
                  <% end %>
                </td>
                <td>
                  <% if connection.last_sync_at %>
                    <small class="text-muted">
                      <%= time_ago_in_words(connection.last_sync_at) %> ago
                    </small>
                  <% else %>
                    <small class="text-muted">Never</small>
                  <% end %>
                </td>
                <td>
                  <%= connection.pipeline_executions.count %>
                </td>
                <td class="text-end">
                  <div class="btn-group btn-group-sm" role="group" aria-label="Connection actions">
                    <%= link_to admin_pipeline_connection_path(connection), class: 'btn btn-outline-primary', aria: { label: 'View connection' } do %>
                      <i data-lucide="eye" style="width: 14px; height: 14px;"></i>
                    <% end %>
                    <%= link_to edit_admin_pipeline_connection_path(connection), class: 'btn btn-outline-secondary', aria: { label: 'Edit connection' } do %>
                      <i data-lucide="edit" style="width: 14px; height: 14px;"></i>
                    <% end %>
                    <%= button_to test_admin_pipeline_connection_path(connection), method: :post, class: 'btn btn-outline-info', aria: { label: 'Test connection' } do %>
                      <i data-lucide="zap" style="width: 14px; height: 14px;"></i>
                    <% end %>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>

    <div class="mt-4">
      <%= paginate @pipeline_connections %>
    </div>
  <% else %>
    <div class="alert alert-info" role="alert">
      <i data-lucide="info" class="me-2" style="width: 20px; height: 20px;"></i>
      No pipeline connections found. <%= link_to 'Create your first connection', new_admin_pipeline_connection_path, class: 'alert-link' %> to get started.
    </div>
  <% end %>
</div>
