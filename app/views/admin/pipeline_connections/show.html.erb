<div class="container-fluid py-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <div>
      <%= link_to admin_pipeline_connections_path, class: 'text-decoration-none text-muted me-3' do %>
        <i data-lucide="arrow-left" class="me-1" style="width: 16px; height: 16px;"></i>
        Back
      <% end %>
      <h1 class="h3 mb-0 d-inline"><%= @pipeline_connection.name %></h1>
    </div>
    <div class="btn-group" role="group" aria-label="Connection actions">
      <%= link_to 'Edit', edit_admin_pipeline_connection_path(@pipeline_connection), class: 'btn btn-secondary' %>
      <%= button_to 'Test Connection', test_admin_pipeline_connection_path(@pipeline_connection), method: :post, class: 'btn btn-info' %>
      <%= button_to 'Delete', admin_pipeline_connection_path(@pipeline_connection), method: :delete, data: { turbo_confirm: 'Are you sure?' }, class: 'btn btn-danger' %>
    </div>
  </div>

  <div class="row g-4">
    <!-- Connection Details -->
    <div class="col-lg-6">
      <div class="card">
        <div class="card-header bg-light">
          <h5 class="card-title mb-0">Connection Details</h5>
        </div>
        <div class="card-body">
          <dl class="row mb-0">
            <dt class="col-sm-4">Type</dt>
            <dd class="col-sm-8">
              <span class="badge bg-secondary"><%= @pipeline_connection.system_type.upcase %></span>
            </dd>

            <dt class="col-sm-4">Status</dt>
            <dd class="col-sm-8">
              <% if @pipeline_connection.status_active? %>
                <span class="badge bg-success">Active</span>
              <% elsif @pipeline_connection.status_inactive? %>
                <span class="badge bg-secondary">Inactive</span>
              <% else %>
                <span class="badge bg-danger">Error</span>
              <% end %>
            </dd>

            <dt class="col-sm-4">Created</dt>
            <dd class="col-sm-8">
              <%= l @pipeline_connection.created_at, format: :long %>
            </dd>

            <dt class="col-sm-4">Last Sync</dt>
            <dd class="col-sm-8">
              <% if @pipeline_connection.last_sync_at %>
                <%= time_ago_in_words(@pipeline_connection.last_sync_at) %> ago
              <% else %>
                <span class="text-muted">Never</span>
              <% end %>
            </dd>

            <dt class="col-sm-4">Last Health Check</dt>
            <dd class="col-sm-8">
              <% if @pipeline_connection.last_health_check_at %>
                <%= time_ago_in_words(@pipeline_connection.last_health_check_at) %> ago
              <% else %>
                <span class="text-muted">Never</span>
              <% end %>
            </dd>

            <dt class="col-sm-4">Executions</dt>
            <dd class="col-sm-8">
              <%= @pipeline_connection.pipeline_executions.count %>
            </dd>
          </dl>
        </div>
      </div>
    </div>

    <!-- Metadata -->
    <div class="col-lg-6">
      <div class="card">
        <div class="card-header bg-light">
          <h5 class="card-title mb-0">Metadata</h5>
        </div>
        <div class="card-body">
          <% if @pipeline_connection.metadata.present? %>
            <pre class="bg-light p-3 rounded"><%= JSON.pretty_generate(@pipeline_connection.metadata) %></pre>
          <% else %>
            <p class="text-muted mb-0">No metadata available</p>
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <!-- Recent Executions -->
  <div class="card mt-4">
    <div class="card-header bg-light d-flex justify-content-between align-items-center">
      <h5 class="card-title mb-0">Recent Pipeline Executions</h5>
      <%= link_to 'View All', admin_pipeline_executions_path(connection_id: @pipeline_connection.id), class: 'btn btn-sm btn-outline-primary' %>
    </div>
    <div class="card-body p-0">
      <% if @recent_executions.any? %>
        <div class="table-responsive">
          <table class="table table-hover mb-0">
            <thead class="table-light">
              <tr>
                <th>Ticket ID</th>
                <th>Title</th>
                <th>Status</th>
                <th>Priority</th>
                <th>Started</th>
                <th>Duration</th>
              </tr>
            </thead>
            <tbody>
              <% @recent_executions.each do |execution| %>
                <tr>
                  <td>
                    <%= link_to execution.ticket_id, admin_pipeline_execution_path(execution), class: 'text-decoration-none' %>
                  </td>
                  <td><%= execution.ticket_title %></td>
                  <td>
                    <span class="badge bg-<%= AiAgents::Pipeline::StateMachine.state_color(execution.status) %>">
                      <%= execution.status.titleize %>
                    </span>
                  </td>
                  <td>
                    <span class="badge bg-<%= execution.priority_critical? ? 'danger' : execution.priority_high? ? 'warning' : 'secondary' %>">
                      <%= execution.priority.titleize %>
                    </span>
                  </td>
                  <td>
                    <% if execution.started_at %>
                      <small class="text-muted"><%= time_ago_in_words(execution.started_at) %> ago</small>
                    <% else %>
                      <small class="text-muted">Not started</small>
                    <% end %>
                  </td>
                  <td>
                    <small class="text-muted"><%= execution.duration_human %></small>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% else %>
        <div class="p-4 text-center text-muted">
          <i data-lucide="inbox" class="mb-2" style="width: 48px; height: 48px;"></i>
          <p class="mb-0">No executions yet</p>
        </div>
      <% end %>
    </div>
  </div>
</div>

<script>
  document.addEventListener('turbo:load', () => {
    lucide.createIcons();
  });
</script>
