<script src="https://unpkg.com/lucide@latest"></script>

<div class="admin-content" style="padding: 2rem;">
  <div class="container-fluid">
    <%# Page Header %>
    <div class="admin-page-header" style="margin-bottom: 2rem;">
      <div class="header-left">
        <div class="header-icon" style="background: linear-gradient(135deg, #22D3EE 0%, #06B6D4 100%);">
          <i data-lucide="<%= case @pipeline_connection.system_type
                when 'jira' then 'file-text'
                when 'github' then 'github'
                when 'azure_devops', 'azure_repos' then 'cloud'
                else 'plug'
                end %>"></i>
        </div>
        <div class="header-text">
          <h1>Edit Pipeline Connection</h1>
          <p>Update <%= @pipeline_connection.name %> configuration</p>
        </div>
      </div>

      <div class="header-actions">
        <%= link_to admin_pipeline_connection_path(@pipeline_connection), class: "admin-btn admin-btn-outline" do %>
          <i data-lucide="arrow-left"></i>
          <span>Back to Connection</span>
        <% end %>
      </div>
    </div>

    <div class="row">
      <%# Main Form Column %>
      <div class="col-lg-8">
        <div class="admin-card">
          <%= form_with model: @pipeline_connection, url: admin_pipeline_connection_path(@pipeline_connection), method: :patch, local: true do |f| %>
            <%# Error Messages %>
            <% if @pipeline_connection.errors.any? %>
              <div class="alert alert-danger" style="background-color: var(--status-error-bg); border-color: var(--status-error-border); color: var(--status-error-text); margin-bottom: 1.5rem;">
                <h5 style="margin-bottom: 0.5rem;">
                  <i data-lucide="alert-circle" style="width: 1rem; height: 1rem; display: inline; vertical-align: middle;"></i>
                  <%= pluralize(@pipeline_connection.errors.count, "error") %> prohibited this connection from being saved:
                </h5>
                <ul style="margin-bottom: 0;">
                  <% @pipeline_connection.errors.full_messages.each do |message| %>
                    <li><%= message %></li>
                  <% end %>
                </ul>
              </div>
            <% end %>

            <%# System Type Field (Disabled) %>
            <div style="margin-bottom: 1.5rem;">
              <%= f.label :system_type, "System Type", style: "display: block; color: white; font-weight: 600; margin-bottom: 0.5rem;" %>
              <%= f.select :system_type,
                  options_for_select([
                    ['JIRA', 'jira'],
                    ['GitHub', 'github'],
                    ['Azure DevOps', 'azure_devops'],
                    ['Azure Repos', 'azure_repos']
                  ], @pipeline_connection.system_type),
                  {},
                  class: 'form-select',
                  disabled: true,
                  style: "background-color: var(--bg-secondary); border: 1px solid var(--border-primary); color: var(--text-muted); padding: 0.75rem; border-radius: 0.5rem; opacity: 0.6;" %>
              <small style="color: rgb(250, 204, 21); font-size: 0.875rem; display: block; margin-top: 0.25rem;">
                System type cannot be changed after creation
              </small>
            </div>

            <%# Connection Name Field %>
            <div style="margin-bottom: 1.5rem;">
              <%= f.label :name, "Connection Name", style: "display: block; color: white; font-weight: 600; margin-bottom: 0.5rem;" %>
              <%= f.text_field :name, class: 'form-control', placeholder: 'e.g., GitHub - Production',
                  style: "background-color: var(--bg-input); border: 1px solid var(--border-primary); color: var(--text-primary); padding: 0.75rem; border-radius: 0.5rem;" %>
              <small style="color: var(--text-muted); font-size: 0.875rem; display: block; margin-top: 0.25rem;">
                A friendly name to identify this connection
              </small>
            </div>

            <%# Status Field %>
            <div style="margin-bottom: 1.5rem;">
              <%= f.label :status, "Status", style: "display: block; color: white; font-weight: 600; margin-bottom: 0.5rem;" %>
              <%= f.select :status,
                  options_for_select([
                    ['Active', 'active'],
                    ['Inactive', 'inactive']
                  ], @pipeline_connection.status),
                  {},
                  class: 'form-select',
                  style: "background-color: var(--bg-input); border: 1px solid var(--border-primary); color: var(--text-primary); padding: 0.75rem; border-radius: 0.5rem;" %>
            </div>

            <hr style="border-color: var(--border-primary); margin: 2rem 0;">

            <h5 style="color: white; font-weight: 600; margin-bottom: 0.5rem;">Configuration</h5>
            <p style="color: var(--text-secondary); margin-bottom: 1.5rem;">Update the credentials and settings for this connection.</p>

            <% config = @pipeline_connection.config %>

            <!-- JIRA Config -->
            <% if @pipeline_connection.system_type == 'jira' %>
              <div style="margin-bottom: 1.5rem;">
                <label style="display: block; color: white; font-weight: 600; margin-bottom: 0.5rem;">JIRA API URL</label>
                <input type="text" name="mcp_connection[config][api_url]" class="form-control" value="<%= config[:api_url] %>" placeholder="https://your-domain.atlassian.net"
                    style="background-color: var(--bg-input); border: 1px solid var(--border-primary); color: var(--text-primary); padding: 0.75rem; border-radius: 0.5rem;">
              </div>
              <div style="margin-bottom: 1.5rem;">
                <label style="display: block; color: white; font-weight: 600; margin-bottom: 0.5rem;">JIRA API Token</label>
                <div style="display: flex; gap: 0;">
                  <input type="password" name="mcp_connection[config][api_token]" class="form-control password-field" value="<%= config[:api_token] %>" placeholder="Your JIRA API token" id="jira_token_edit"
                      style="background-color: var(--bg-input); border: 1px solid var(--border-primary); color: var(--text-primary); padding: 0.75rem; border-radius: 0.5rem 0 0 0.5rem; border-right: none;">
                  <button class="toggle-password" type="button" data-target="jira_token_edit"
                      style="background-color: var(--bg-input); border: 1px solid var(--border-primary); color: var(--text-secondary); padding: 0.75rem; border-radius: 0 0.5rem 0.5rem 0; cursor: pointer;">
                    <i data-lucide="eye" style="width: 16px; height: 16px;"></i>
                  </button>
                </div>
                <small style="color: var(--text-muted); font-size: 0.875rem; display: block; margin-top: 0.25rem;">
                  Generate at: <a href="https://id.atlassian.com/manage-profile/security/api-tokens" target="_blank" style="color: #22D3EE;">id.atlassian.com/manage-profile/security/api-tokens</a>
                </small>
              </div>
              <div style="margin-bottom: 1.5rem;">
                <label style="display: block; color: white; font-weight: 600; margin-bottom: 0.5rem;">Email</label>
                <input type="email" name="mcp_connection[config][email]" class="form-control" value="<%= config[:email] %>" placeholder="your@email.com"
                    style="background-color: var(--bg-input); border: 1px solid var(--border-primary); color: var(--text-primary); padding: 0.75rem; border-radius: 0.5rem;">
              </div>
              <div style="margin-bottom: 1.5rem;">
                <label style="display: block; color: white; font-weight: 600; margin-bottom: 0.5rem;">Project Key (Optional)</label>
                <input type="text" name="mcp_connection[config][project_key]" class="form-control" value="<%= config[:project_key] %>" placeholder="e.g., PROJ"
                    style="background-color: var(--bg-input); border: 1px solid var(--border-primary); color: var(--text-primary); padding: 0.75rem; border-radius: 0.5rem;">
              </div>
            <% end %>

            <!-- GitHub Config -->
            <% if @pipeline_connection.system_type == 'github' %>
              <div style="margin-bottom: 1.5rem;">
                <label style="display: block; color: white; font-weight: 600; margin-bottom: 0.5rem;">GitHub API Token</label>
                <div style="display: flex; gap: 0;">
                  <input type="password" name="mcp_connection[config][token]" class="form-control password-field" value="<%= config[:token] %>" placeholder="ghp_..." id="github_token_edit"
                      style="background-color: var(--bg-input); border: 1px solid var(--border-primary); color: var(--text-primary); padding: 0.75rem; border-radius: 0.5rem 0 0 0.5rem; border-right: none;">
                  <button class="toggle-password" type="button" data-target="github_token_edit"
                      style="background-color: var(--bg-input); border: 1px solid var(--border-primary); color: var(--text-secondary); padding: 0.75rem; border-radius: 0 0.5rem 0.5rem 0; cursor: pointer;">
                    <i data-lucide="eye" style="width: 16px; height: 16px;"></i>
                  </button>
                </div>
                <small style="color: var(--text-muted); font-size: 0.875rem; display: block; margin-top: 0.25rem;">
                  Generate at: <a href="https://github.com/settings/tokens" target="_blank" style="color: #22D3EE;">github.com/settings/tokens</a>
                </small>
              </div>
              <div style="margin-bottom: 1.5rem;">
                <label style="display: block; color: white; font-weight: 600; margin-bottom: 0.5rem;">Organization</label>
                <input type="text" name="mcp_connection[config][organization]" class="form-control" value="<%= config[:organization] %>" placeholder="e.g., NuvolaNetworks"
                    style="background-color: var(--bg-input); border: 1px solid var(--border-primary); color: var(--text-primary); padding: 0.75rem; border-radius: 0.5rem;">
              </div>
              <div style="margin-bottom: 1.5rem;">
                <label style="display: block; color: white; font-weight: 600; margin-bottom: 0.5rem;">Repository (Optional)</label>
                <input type="text" name="mcp_connection[config][repository]" class="form-control" value="<%= config[:repository] %>" placeholder="e.g., agent_marketing"
                    style="background-color: var(--bg-input); border: 1px solid var(--border-primary); color: var(--text-primary); padding: 0.75rem; border-radius: 0.5rem;">
                <small style="color: var(--text-muted); font-size: 0.875rem; display: block; margin-top: 0.25rem;">
                  Leave blank to access all repositories in the organization
                </small>
              </div>
            <% end %>

            <!-- Azure DevOps Config -->
            <% if @pipeline_connection.system_type == 'azure_devops' %>
              <div style="margin-bottom: 1.5rem;">
                <label style="display: block; color: white; font-weight: 600; margin-bottom: 0.5rem;">Azure DevOps Organization</label>
                <input type="text" name="mcp_connection[config][organization]" class="form-control" value="<%= config[:organization] %>" placeholder="Your organization name"
                    style="background-color: var(--bg-input); border: 1px solid var(--border-primary); color: var(--text-primary); padding: 0.75rem; border-radius: 0.5rem;">
              </div>
              <div style="margin-bottom: 1.5rem;">
                <label style="display: block; color: white; font-weight: 600; margin-bottom: 0.5rem;">Personal Access Token (PAT)</label>
                <div style="display: flex; gap: 0;">
                  <input type="password" name="mcp_connection[config][pat]" class="form-control password-field" value="<%= config[:pat] %>" placeholder="Your Azure DevOps PAT" id="azure_devops_pat_edit"
                      style="background-color: var(--bg-input); border: 1px solid var(--border-primary); color: var(--text-primary); padding: 0.75rem; border-radius: 0.5rem 0 0 0.5rem; border-right: none;">
                  <button class="toggle-password" type="button" data-target="azure_devops_pat_edit"
                      style="background-color: var(--bg-input); border: 1px solid var(--border-primary); color: var(--text-secondary); padding: 0.75rem; border-radius: 0 0.5rem 0.5rem 0; cursor: pointer;">
                    <i data-lucide="eye" style="width: 16px; height: 16px;"></i>
                  </button>
                </div>
              </div>
              <div style="margin-bottom: 1.5rem;">
                <label style="display: block; color: white; font-weight: 600; margin-bottom: 0.5rem;">Project (Optional)</label>
                <input type="text" name="mcp_connection[config][project]" class="form-control" value="<%= config[:project] %>" placeholder="Project name"
                    style="background-color: var(--bg-input); border: 1px solid var(--border-primary); color: var(--text-primary); padding: 0.75rem; border-radius: 0.5rem;">
              </div>
            <% end %>

            <!-- Azure Repos Config -->
            <% if @pipeline_connection.system_type == 'azure_repos' %>
              <div style="margin-bottom: 1.5rem;">
                <label style="display: block; color: white; font-weight: 600; margin-bottom: 0.5rem;">Azure Repos Organization</label>
                <input type="text" name="mcp_connection[config][organization]" class="form-control" value="<%= config[:organization] %>" placeholder="Your organization name"
                    style="background-color: var(--bg-input); border: 1px solid var(--border-primary); color: var(--text-primary); padding: 0.75rem; border-radius: 0.5rem;">
              </div>
              <div style="margin-bottom: 1.5rem;">
                <label style="display: block; color: white; font-weight: 600; margin-bottom: 0.5rem;">Personal Access Token (PAT)</label>
                <div style="display: flex; gap: 0;">
                  <input type="password" name="mcp_connection[config][pat]" class="form-control password-field" value="<%= config[:pat] %>" placeholder="Your Azure Repos PAT" id="azure_repos_pat_edit"
                      style="background-color: var(--bg-input); border: 1px solid var(--border-primary); color: var(--text-primary); padding: 0.75rem; border-radius: 0.5rem 0 0 0.5rem; border-right: none;">
                  <button class="toggle-password" type="button" data-target="azure_repos_pat_edit"
                      style="background-color: var(--bg-input); border: 1px solid var(--border-primary); color: var(--text-secondary); padding: 0.75rem; border-radius: 0 0.5rem 0.5rem 0; cursor: pointer;">
                    <i data-lucide="eye" style="width: 16px; height: 16px;"></i>
                  </button>
                </div>
              </div>
            <% end %>

            <%# Action Buttons %>
            <div style="display: flex; gap: 0.75rem; padding-top: 1rem; border-top: 1px solid var(--border-primary); margin-top: 2rem;">
              <%= f.submit "Update Connection", class: "admin-btn admin-btn-primary" %>
              <%= link_to admin_pipeline_connection_path(@pipeline_connection), class: "admin-btn admin-btn-outline" do %>
                <i data-lucide="x"></i>
                <span>Cancel</span>
              <% end %>
            </div>
          <% end %>
        </div>
      </div>

      <%# Sidebar Column %>
      <div class="col-lg-4">
        <%# Connection Info Card %>
        <div class="admin-card" style="margin-bottom: 1.5rem;">
          <h5 style="color: white; font-weight: 600; margin-bottom: 1.5rem; display: flex; align-items: center; gap: 0.5rem;">
            <i data-lucide="info" style="width: 1.25rem; height: 1.25rem; color: #22D3EE;"></i>
            <span>Connection Info</span>
          </h5>

          <dl style="margin-bottom: 0; font-size: 0.875rem;">
            <dt style="color: var(--text-secondary); font-weight: 600; margin-bottom: 0.25rem;">Created:</dt>
            <dd style="color: white; margin-bottom: 1rem;"><%= @pipeline_connection.created_at.strftime('%b %d, %Y') %></dd>

            <dt style="color: var(--text-secondary); font-weight: 600; margin-bottom: 0.25rem;">Last Updated:</dt>
            <dd style="color: white; margin-bottom: 1rem;"><%= @pipeline_connection.updated_at.strftime('%b %d, %Y') %></dd>

            <dt style="color: var(--text-secondary); font-weight: 600; margin-bottom: 0.25rem;">Last Sync:</dt>
            <dd style="color: white; margin-bottom: 1rem;">
              <% if @pipeline_connection.last_sync_at %>
                <%= time_ago_in_words(@pipeline_connection.last_sync_at) %> ago
              <% else %>
                Never
              <% end %>
            </dd>

            <dt style="color: var(--text-secondary); font-weight: 600; margin-bottom: 0.25rem;">Executions:</dt>
            <dd style="color: white; margin-bottom: 0;"><%= @pipeline_connection.pipeline_executions.count %></dd>
          </dl>
        </div>

        <%# Security Note Card %>
        <div class="admin-card">
          <div style="padding: 0.75rem; background-color: rgba(234, 179, 8, 0.1); border: 1px solid rgba(234, 179, 8, 0.2); border-radius: 0.5rem;">
            <div style="display: flex; align-items-start; gap: 0.75rem;">
              <i data-lucide="alert-triangle" style="width: 1.25rem; height: 1.25rem; color: rgb(250, 204, 21); flex-shrink: 0; margin-top: 0.125rem;"></i>
              <div>
                <strong style="color: white; display: block; margin-bottom: 0.5rem;">Security Note</strong>
                <p style="color: var(--text-secondary); font-size: 0.875rem; line-height: 1.6; margin: 0;">
                  Credentials are encrypted in the database. Only update tokens if you need to rotate credentials or if the connection is experiencing authentication issues.
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  function initPasswordToggles() {
    // Password toggle functionality
    document.querySelectorAll('.toggle-password').forEach(button => {
      // Remove old listeners by cloning
      const newButton = button.cloneNode(true);
      button.parentNode.replaceChild(newButton, button);

      newButton.addEventListener('click', function(e) {
        e.preventDefault();

        const targetId = this.getAttribute('data-target');
        const input = document.getElementById(targetId);

        // Lucide replaces <i> with <svg>, so look for either
        const icon = this.querySelector('i') || this.querySelector('svg') || this.querySelector('[data-lucide]');

        if (!input || !icon) {
          console.error('Toggle failed - input or icon not found');
          return;
        }

        if (input.type === 'password') {
          input.type = 'text';
          icon.setAttribute('data-lucide', 'eye-off');
        } else {
          input.type = 'password';
          icon.setAttribute('data-lucide', 'eye');
        }

        // Reinitialize the icon
        if (typeof lucide !== 'undefined') {
          lucide.createIcons();
        }
      });
    });

    if (typeof lucide !== 'undefined') {
      lucide.createIcons();
    }
  }

  document.addEventListener('DOMContentLoaded', initPasswordToggles);
  document.addEventListener('turbo:load', initPasswordToggles);
</script>
