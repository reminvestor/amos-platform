
<div class="admin-content admin-p-xl">
  <div class="container-fluid">
    <%# Page Header %>
    <div class="admin-page-header admin-mb-xl">
      <div class="header-left">
        <div class="header-icon admin-icon-gradient-cyan">
          <%= admin_icon(case @pipeline_connection.system_type
                when 'jira' then 'file-text'
                when 'github' then 'github'
                when 'azure_devops', 'azure_repos' then 'cloud'
                else 'plug'
                end, size: :lg) %>
        </div>
        <div class="header-text">
          <h1>Edit Pipeline Connection</h1>
          <p>Update <%= @pipeline_connection.name %> configuration</p>
        </div>
      </div>

      <div class="header-actions">
        <%= link_to admin_pipeline_connection_path(@pipeline_connection), class: "admin-btn admin-btn-outline" do %>
          <%= admin_icon('arrow-left', size: :sm) %>
          <span>Back to Connection</span>
        <% end %>
      </div>
    </div>

    <div class="row">
      <%# Main Form Column %>
      <div class="col-lg-8">
        <div class="admin-card">
          <%= form_with model: @pipeline_connection, url: admin_pipeline_connection_path(@pipeline_connection), method: :patch, local: true do |f| %>
            <%# Error Messages %>
            <% if @pipeline_connection.errors.any? %>
              <div class="admin-alert admin-alert-error">
                <h5>
                  <%= admin_icon('alert-circle', size: :md) %>
                  <%= pluralize(@pipeline_connection.errors.count, "error") %> prohibited this connection from being saved:
                </h5>
                <ul>
                  <% @pipeline_connection.errors.full_messages.each do |message| %>
                    <li><%= message %></li>
                  <% end %>
                </ul>
              </div>
            <% end %>

            <%# System Type Field (Disabled) %>
            <div class="form-group">
              <%= f.label :system_type, "System Type", class: "form-label" %>
              <%= f.select :system_type,
                  options_for_select([
                    ['JIRA', 'jira'],
                    ['GitHub', 'github'],
                    ['Azure DevOps', 'azure_devops'],
                    ['Azure Repos', 'azure_repos']
                  ], @pipeline_connection.system_type),
                  {},
                  class: 'form-select admin-form-disabled',
                  disabled: true,
                  style: "background-color: var(--bg-secondary); border: 1px solid var(--border-primary); color: var(--text-muted); padding: 0.75rem; border-radius: 0.5rem; opacity: 0.6;" %>
              <small class="form-helper-warning">
                System type cannot be changed after creation
              </small>
            </div>

            <%# Connection Name Field %>
            <div class="form-group">
              <%= f.label :name, "Connection Name", class: "form-label" %>
              <%= f.text_field :name, class: 'form-control', placeholder: 'e.g., GitHub - Production',
                  style: "background-color: var(--bg-input); border: 1px solid var(--border-primary); color: var(--text-primary); padding: 0.75rem; border-radius: 0.5rem;" %>
              <small class="form-helper-text">
                A friendly name to identify this connection
              </small>
            </div>

            <%# Status Field %>
            <div class="form-group">
              <%= f.label :status, "Status", class: "form-label" %>
              <%= f.select :status,
                  options_for_select([
                    ['Active', 'active'],
                    ['Inactive', 'inactive']
                  ], @pipeline_connection.status),
                  {},
                  class: 'form-select',
                  style: "background-color: var(--bg-input); border: 1px solid var(--border-primary); color: var(--text-primary); padding: 0.75rem; border-radius: 0.5rem;" %>
            </div>

            <hr class="admin-divider">

            <h5 class="admin-text-primary admin-font-semibold admin-mb-sm">Configuration</h5>
            <p class="admin-text-secondary admin-mb-lg">Update the credentials and settings for this connection.</p>

            <% config = @pipeline_connection.config %>

            <!-- JIRA Config -->
            <% if @pipeline_connection.system_type == 'jira' %>
              <div class="form-group">
                <label class="form-label">JIRA API URL</label>
                <input type="text" name="mcp_connection[config][api_url]" class="form-control" value="<%= config[:api_url] %>" placeholder="https://your-domain.atlassian.net"
                    style="background-color: var(--bg-input); border: 1px solid var(--border-primary); color: var(--text-primary); padding: 0.75rem; border-radius: 0.5rem;">
              </div>
              <div class="form-group">
                <label class="form-label">JIRA API Token</label>
                <div class="admin-password-toggle-group">
                  <input type="password" name="mcp_connection[config][api_token]" class="form-control password-field admin-password-input-left" value="<%= config[:api_token] %>" placeholder="Your JIRA API token" id="jira_token_edit"
                      style="background-color: var(--bg-input); border: 1px solid var(--border-primary); color: var(--text-primary); padding: 0.75rem;">
                  <button class="toggle-password admin-btn admin-toggle-btn-right" type="button" data-target="jira_token_edit">
                    <%= admin_icon('eye', size: :md) %>
                  </button>
                </div>
                <small class="form-helper-text">
                  Generate at: <a href="https://id.atlassian.com/manage-profile/security/api-tokens" target="_blank" class="admin-link">id.atlassian.com/manage-profile/security/api-tokens</a>
                </small>
              </div>
              <div class="form-group">
                <label class="form-label">Email</label>
                <input type="email" name="mcp_connection[config][email]" class="form-control" value="<%= config[:email] %>" placeholder="your@email.com"
                    style="background-color: var(--bg-input); border: 1px solid var(--border-primary); color: var(--text-primary); padding: 0.75rem; border-radius: 0.5rem;">
              </div>
              <div class="form-group">
                <label class="form-label">Project Key (Optional)</label>
                <input type="text" name="mcp_connection[config][project_key]" class="form-control" value="<%= config[:project_key] %>" placeholder="e.g., PROJ"
                    style="background-color: var(--bg-input); border: 1px solid var(--border-primary); color: var(--text-primary); padding: 0.75rem; border-radius: 0.5rem;">
              </div>
            <% end %>

            <!-- GitHub Config -->
            <% if @pipeline_connection.system_type == 'github' %>
              <div class="form-group">
                <label class="form-label">GitHub API Token</label>
                <div class="admin-password-toggle-group">
                  <input type="password" name="mcp_connection[config][token]" class="form-control password-field admin-password-input-left" value="<%= config[:token] %>" placeholder="ghp_..." id="github_token_edit"
                      style="background-color: var(--bg-input); border: 1px solid var(--border-primary); color: var(--text-primary); padding: 0.75rem;">
                  <button class="toggle-password admin-btn admin-toggle-btn-right" type="button" data-target="github_token_edit">
                    <%= admin_icon('eye', size: :md) %>
                  </button>
                </div>
                <small class="form-helper-text">
                  Generate at: <a href="https://github.com/settings/tokens" target="_blank" class="admin-link">github.com/settings/tokens</a>
                </small>
              </div>
              <div class="form-group">
                <label class="form-label">Organization</label>
                <input type="text" name="mcp_connection[config][organization]" class="form-control" value="<%= config[:organization] %>" placeholder="e.g., NuvolaNetworks"
                    style="background-color: var(--bg-input); border: 1px solid var(--border-primary); color: var(--text-primary); padding: 0.75rem; border-radius: 0.5rem;">
              </div>
              <div class="form-group">
                <label class="form-label">Repository (Optional)</label>
                <input type="text" name="mcp_connection[config][repository]" class="form-control" value="<%= config[:repository] %>" placeholder="e.g., agent_marketing"
                    style="background-color: var(--bg-input); border: 1px solid var(--border-primary); color: var(--text-primary); padding: 0.75rem; border-radius: 0.5rem;">
                <small class="form-helper-text">
                  Leave blank to access all repositories in the organization
                </small>
              </div>
            <% end %>

            <!-- Azure DevOps Config -->
            <% if @pipeline_connection.system_type == 'azure_devops' %>
              <div class="form-group">
                <label class="form-label">Azure DevOps Organization</label>
                <input type="text" name="mcp_connection[config][organization]" class="form-control" value="<%= config[:organization] %>" placeholder="Your organization name"
                    style="background-color: var(--bg-input); border: 1px solid var(--border-primary); color: var(--text-primary); padding: 0.75rem; border-radius: 0.5rem;">
              </div>
              <div class="form-group">
                <label class="form-label">Personal Access Token (PAT)</label>
                <div class="admin-password-toggle-group">
                  <input type="password" name="mcp_connection[config][pat]" class="form-control password-field admin-password-input-left" value="<%= config[:pat] %>" placeholder="Your Azure DevOps PAT" id="azure_devops_pat_edit"
                      style="background-color: var(--bg-input); border: 1px solid var(--border-primary); color: var(--text-primary); padding: 0.75rem;">
                  <button class="toggle-password admin-btn admin-toggle-btn-right" type="button" data-target="azure_devops_pat_edit">
                    <%= admin_icon('eye', size: :md) %>
                  </button>
                </div>
              </div>
              <div class="form-group">
                <label class="form-label">Project (Optional)</label>
                <input type="text" name="mcp_connection[config][project]" class="form-control" value="<%= config[:project] %>" placeholder="Project name"
                    style="background-color: var(--bg-input); border: 1px solid var(--border-primary); color: var(--text-primary); padding: 0.75rem; border-radius: 0.5rem;">
              </div>
            <% end %>

            <!-- Azure Repos Config -->
            <% if @pipeline_connection.system_type == 'azure_repos' %>
              <div class="form-group">
                <label class="form-label">Azure Repos Organization</label>
                <input type="text" name="mcp_connection[config][organization]" class="form-control" value="<%= config[:organization] %>" placeholder="Your organization name"
                    style="background-color: var(--bg-input); border: 1px solid var(--border-primary); color: var(--text-primary); padding: 0.75rem; border-radius: 0.5rem;">
              </div>
              <div class="form-group">
                <label class="form-label">Personal Access Token (PAT)</label>
                <div class="admin-password-toggle-group">
                  <input type="password" name="mcp_connection[config][pat]" class="form-control password-field admin-password-input-left" value="<%= config[:pat] %>" placeholder="Your Azure Repos PAT" id="azure_repos_pat_edit"
                      style="background-color: var(--bg-input); border: 1px solid var(--border-primary); color: var(--text-primary); padding: 0.75rem;">
                  <button class="toggle-password admin-btn admin-toggle-btn-right" type="button" data-target="azure_repos_pat_edit">
                    <%= admin_icon('eye', size: :md) %>
                  </button>
                </div>
              </div>
            <% end %>

            <%# Action Buttons %>
            <div class="admin-flex admin-flex-gap-md admin-mt-xl admin-section-divider">
              <%= f.submit "Update Connection", class: "admin-btn admin-btn-primary" %>
              <%= link_to admin_pipeline_connection_path(@pipeline_connection), class: "admin-btn admin-btn-outline" do %>
                <%= admin_icon('x', size: :sm) %>
                <span>Cancel</span>
              <% end %>
            </div>
          <% end %>
        </div>
      </div>

      <%# Sidebar Column %>
      <div class="col-lg-4">
        <%# Connection Info Card %>
        <div class="admin-card form-group">
          <h5 class="admin-section-heading admin-mb-lg">
            <%= admin_icon('info', size: :lg, class: 'admin-text-info') %>
            <span>Connection Info</span>
          </h5>

          <dl class="admin-dl admin-text-sm">
            <dt>Created:</dt>
            <dd><%= @pipeline_connection.created_at.strftime('%b %d, %Y') %></dd>

            <dt>Last Updated:</dt>
            <dd><%= @pipeline_connection.updated_at.strftime('%b %d, %Y') %></dd>

            <dt>Last Sync:</dt>
            <dd>
              <% if @pipeline_connection.last_sync_at %>
                <%= time_ago_in_words(@pipeline_connection.last_sync_at) %> ago
              <% else %>
                Never
              <% end %>
            </dd>

            <dt>Executions:</dt>
            <dd><%= @pipeline_connection.pipeline_executions.count %></dd>
          </dl>
        </div>

        <%# Security Note Card %>
        <div class="admin-card">
          <div class="admin-alert-warning">
            <div class="admin-flex admin-items-start admin-flex-gap-md">
              <%= admin_icon('alert-triangle', size: :md, class: 'admin-text-warning admin-flex-none admin-mt-xs') %>
              <div>
                <strong class="admin-text-primary admin-block admin-mb-sm">Security Note</strong>
                <p class="admin-text-secondary admin-text-sm admin-leading-relaxed admin-m-0">
                  Credentials are encrypted in the database. Only update tokens if you need to rotate credentials or if the connection is experiencing authentication issues.
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  function initPasswordToggles() {
    // Password toggle functionality
    document.querySelectorAll('.toggle-password').forEach(button => {
      // Remove old listeners by cloning
      const newButton = button.cloneNode(true);
      button.parentNode.replaceChild(newButton, button);

      newButton.addEventListener('click', function(e) {
        e.preventDefault();

        const targetId = this.getAttribute('data-target');
        const input = document.getElementById(targetId);

        // Lucide replaces <i> with <svg>, so look for either
        const icon = this.querySelector('i') || this.querySelector('svg') || this.querySelector('[data-lucide]');

        if (!input || !icon) {
          console.error('Toggle failed - input or icon not found');
          return;
        }

        if (input.type === 'password') {
          input.type = 'text';
          icon.setAttribute('data-lucide', 'eye-off');
        } else {
          input.type = 'password';
          icon.setAttribute('data-lucide', 'eye');
        }

        // Reinitialize the icon
        if (typeof lucide !== 'undefined') {
          lucide.createIcons();
        }
      });
    });

    if (typeof lucide !== 'undefined') {
      lucide.createIcons();
    }
  }

  document.addEventListener('DOMContentLoaded', initPasswordToggles);
  document.addEventListener('turbo:load', initPasswordToggles);
</script>
