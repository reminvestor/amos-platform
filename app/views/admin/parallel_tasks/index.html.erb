<div style="padding: 2rem;">
  <!-- Page Header -->
  <div class="admin-page-header" style="margin-bottom: 2rem;">
    <div class="header-left">
      <div class="header-icon" style="background: linear-gradient(135deg, #3B82F6 0%, #2563EB 100%);">
        <i data-lucide="layers" style="color: white;"></i>
      </div>
      <div class="header-text">
        <h1>Parallel Task Monitor</h1>
        <p>Real-time monitoring of concurrent task execution</p>
      </div>
    </div>

    <div class="header-actions">
      <div style="display: flex; gap: 0.5rem;">
        <%= link_to admin_parallel_tasks_path(time_range: '1h', filter: @filter), class: "admin-btn admin-btn-sm #{@time_range == '1h' ? 'admin-btn-primary' : 'admin-btn-outline'}" do %>
          <span>1 Hour</span>
        <% end %>
        <%= link_to admin_parallel_tasks_path(time_range: '24h', filter: @filter), class: "admin-btn admin-btn-sm #{@time_range == '24h' ? 'admin-btn-primary' : 'admin-btn-outline'}" do %>
          <span>24 Hours</span>
        <% end %>
        <%= link_to admin_parallel_tasks_path(time_range: '7d', filter: @filter), class: "admin-btn admin-btn-sm #{@time_range == '7d' ? 'admin-btn-primary' : 'admin-btn-outline'}" do %>
          <span>7 Days</span>
        <% end %>
        <%= link_to admin_parallel_tasks_path(time_range: 'all', filter: @filter), class: "admin-btn admin-btn-sm #{@time_range == 'all' ? 'admin-btn-primary' : 'admin-btn-outline'}" do %>
          <span>All Time</span>
        <% end %>
      </div>
    </div>
  </div>

  <!-- Statistics Cards -->
  <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1.5rem; margin-bottom: 2rem;">
    <div class="admin-card">
      <div style="display: flex; align-items: center; gap: 1rem;">
        <div style="width: 3rem; height: 3rem; border-radius: 0.75rem; background: linear-gradient(135deg, #7C3AED 0%, #A78BFA 100%); display: flex; align-items: center; justify-content: center;">
          <i data-lucide="activity" style="width: 1.5rem; height: 1.5rem; color: white;"></i>
        </div>
        <div>
          <p style="color: #94A3B8; font-size: 0.875rem; margin: 0;">Total Tasks</p>
          <h3 style="color: white; font-size: 1.875rem; font-weight: 600; margin: 0;"><%= number_with_delimiter(@stats[:total]) %></h3>
        </div>
      </div>
    </div>

    <div class="admin-card">
      <div style="display: flex; align-items: center; gap: 1rem;">
        <div style="width: 3rem; height: 3rem; border-radius: 0.75rem; background: rgba(234, 179, 8, 0.1); border: 1px solid rgba(234, 179, 8, 0.2); display: flex; align-items: center; justify-content: center;">
          <i data-lucide="loader" style="width: 1.5rem; height: 1.5rem; color: rgb(250, 204, 21);"></i>
        </div>
        <div>
          <p style="color: #94A3B8; font-size: 0.875rem; margin: 0;">Active</p>
          <h3 style="color: white; font-size: 1.875rem; font-weight: 600; margin: 0;"><%= number_with_delimiter(@stats[:active]) %></h3>
        </div>
      </div>
    </div>

    <div class="admin-card">
      <div style="display: flex; align-items: center; gap: 1rem;">
        <div style="width: 3rem; height: 3rem; border-radius: 0.75rem; background: rgba(34, 197, 94, 0.1); border: 1px solid rgba(34, 197, 94, 0.2); display: flex; align-items: center; justify-content: center;">
          <i data-lucide="check-circle" style="width: 1.5rem; height: 1.5rem; color: rgb(74, 222, 128);"></i>
        </div>
        <div>
          <p style="color: #94A3B8; font-size: 0.875rem; margin: 0;">Success Rate</p>
          <h3 style="color: white; font-size: 1.875rem; font-weight: 600; margin: 0;"><%= @stats[:success_rate] %>%</h3>
        </div>
      </div>
    </div>

    <div class="admin-card">
      <div style="display: flex; align-items: center; gap: 1rem;">
        <div style="width: 3rem; height: 3rem; border-radius: 0.75rem; background: rgba(34, 211, 238, 0.1); border: 1px solid rgba(34, 211, 238, 0.2); display: flex; align-items: center; justify-content: center;">
          <i data-lucide="clock" style="width: 1.5rem; height: 1.5rem; color: #22D3EE;"></i>
        </div>
        <div>
          <p style="color: #94A3B8; font-size: 0.875rem; margin: 0;">Avg Duration</p>
          <h3 style="color: white; font-size: 1.875rem; font-weight: 600; margin: 0;"><%= @stats[:avg_duration] %>s</h3>
        </div>
      </div>
    </div>
  </div>

  <!-- Tasks Table -->
  <div class="admin-card">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem;">
      <h3 class="card-title" style="margin: 0;">
        <i data-lucide="list" style="width: 1.25rem; height: 1.25rem; display: inline-block; vertical-align: middle; margin-right: 0.5rem;"></i>
        Task Execution Queue
      </h3>

      <div class="admin-tabs">
        <%= link_to "All", admin_parallel_tasks_path(time_range: @time_range),
                    class: "admin-tab #{@filter == 'all' || @filter.nil? ? 'admin-tab-active' : ''}" %>
        <%= link_to "Active", admin_parallel_tasks_path(time_range: @time_range, filter: 'active'),
                    class: "admin-tab #{@filter == 'active' ? 'admin-tab-active' : ''}" %>
        <%= link_to "Completed", admin_parallel_tasks_path(time_range: @time_range, filter: 'completed'),
                    class: "admin-tab #{@filter == 'completed' ? 'admin-tab-active' : ''}" %>
        <%= link_to "Failed", admin_parallel_tasks_path(time_range: @time_range, filter: 'failed'),
                    class: "admin-tab #{@filter == 'failed' ? 'admin-tab-active' : ''}" %>
        <%= link_to "Voice", admin_parallel_tasks_path(time_range: @time_range, filter: 'voice'),
                    class: "admin-tab #{@filter == 'voice' ? 'admin-tab-active' : ''}" %>
      </div>
    </div>

    <% if @tasks.any? %>
      <div class="admin-table-container">
        <table class="admin-table">
        <%= admin_table_caption("Parallel task execution queue showing task status, progress, and actions") %>
        <thead>
          <tr>
            <th>ID</th>
            <th>Type</th>
            <th>User</th>
            <th>Description</th>
            <th>Status</th>
            <th>Progress</th>
            <th>Dependencies</th>
            <th>Duration</th>
            <th>Created</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <% @tasks.each do |task| %>
            <tr>
              <td>
                <code style="color: #22D3EE;"><%= link_to "##{task.id}", admin_parallel_task_path(task), style: "color: #22D3EE; text-decoration: none;" %></code>
              </td>
              <td>
                <% type_badge = case task.task_type
                     when 'voice_immediate' then 'admin-badge-offline'
                     when 'voice_followup' then 'admin-badge-warning'
                     when 'analysis' then 'admin-badge-cyan'
                     else 'admin-badge-default'
                   end %>
                <span class="admin-badge <%= type_badge %>">
                  <%= task.task_type&.humanize || 'Unknown' %>
                </span>
              </td>
              <td style="color: #94A3B8;"><%= task.user.email %></td>
              <td style="color: white; max-width: 200px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                <%= task.metadata['description'] || '-' %>
              </td>
              <td>
                <%= admin_status_badge(task.status) %>
              </td>
              <td>
                <div style="display: flex; align-items: center; gap: 0.5rem;">
                  <div style="flex-grow: 1; height: 6px; background: #1E293B; border-radius: 3px; width: 60px;">
                    <div style="width: <%= task.progress || 0 %>%; height: 100%; background: #3B82F6; border-radius: 3px;"></div>
                  </div>
                  <span style="font-size: 0.75rem; color: #94A3B8;"><%= task.progress || 0 %>%</span>
                </div>
              </td>
              <td>
                <% if task.depends_on_tasks.any? %>
                  <span class="admin-badge admin-badge-primary" style="font-size: 0.75rem;">
                    <%= task.depends_on_tasks.count %> deps
                  </span>
                <% else %>
                  <span style="color: #64748B;">None</span>
                <% end %>
              </td>
              <td style="color: #94A3B8;">
                <% if task.started_at && task.status == 'completed' %>
                  <%= format_duration(task.updated_at - task.started_at) %>
                <% elsif task.started_at %>
                  <%= format_duration(Time.current - task.started_at) %>
                <% else %>
                  -
                <% end %>
              </td>
              <td style="color: #94A3B8; white-space: nowrap;"><%= task.created_at.strftime('%m/%d %H:%M') %></td>
              <td>
                <div style="display: flex; gap: 0.5rem;">
                  <%= link_to admin_parallel_task_path(task),
                      class: "admin-btn admin-btn-sm admin-btn-outline icon-btn",
                      'aria-label': "View task #{task.id} details",
                      style: "border-color: #1E293B; color: #3B82F6;" do %>
                    <i data-lucide="eye" style="width: 1rem; height: 1rem;"></i>
                  <% end %>

                  <% if task.status == 'active' %>
                    <%= button_to cancel_admin_parallel_task_path(task),
                        method: :post,
                        class: "admin-btn admin-btn-sm admin-btn-warning icon-btn",
                        'aria-label': "Cancel task #{task.id}",
                        data: { confirm: "Cancel this task?" },
                        style: "border-color: #1E293B; color: #F59E0B;" do %>
                      <i data-lucide="x-circle" style="width: 1rem; height: 1rem;"></i>
                    <% end %>
                  <% elsif task.status.in?(['failed', 'cancelled']) %>
                    <%= button_to retry_admin_parallel_task_path(task),
                        method: :post,
                        class: "admin-btn admin-btn-sm admin-btn-primary icon-btn",
                        'aria-label': "Retry task #{task.id}",
                        style: "border-color: #1E293B; color: #3B82F6;" do %>
                      <i data-lucide="refresh-cw" style="width: 1rem; height: 1rem;"></i>
                    <% end %>
                  <% end %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <% if @tasks.count >= 100 %>
      <p style="text-align: center; margin-top: 1.5rem; margin-bottom: 0; color: #64748B; font-size: 0.875rem;">
        Showing first 100 tasks. Use filters to narrow results.
      </p>
    <% end %>
  <% else %>
    <div class="admin-empty-state" style="padding: 3rem 0; text-align: center;">
      <div class="empty-icon" style="margin-bottom: 1rem; color: #475569;">
        <i data-lucide="inbox" style="width: 3rem; height: 3rem;"></i>
      </div>
      <h3 style="color: white;">No tasks found</h3>
      <p style="color: #94A3B8;">No parallel tasks match the selected filters</p>
    </div>
  <% end %>
  </div>

  <!-- Pagination -->
  <% if @tasks.any? && @tasks.total_pages > 1 %>
    <div class="admin-pagination">
      <%= paginate @tasks %>
    </div>
  <% end %>
</div>

<!-- Initialize Lucide Icons and Auto-refresh -->
<script>
  function initializeParallelTasksPage() {
    if (typeof lucide !== 'undefined') {
      lucide.createIcons();
    }
  }

  // Run on both DOMContentLoaded and turbo:load
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initializeParallelTasksPage);
  } else {
    initializeParallelTasksPage();
  }

  document.addEventListener('turbo:load', initializeParallelTasksPage);

  // Auto-refresh for active tasks
  <% if @stats[:active] > 0 %>
  setTimeout(() => {
    window.location.reload();
  }, 10000); // Refresh every 10 seconds when there are active tasks
  <% end %>
</script>
