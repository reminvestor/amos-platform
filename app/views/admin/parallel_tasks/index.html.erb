<div class="admin-p-xl">
  <!-- Page Header -->
  <div class="admin-page-header">
    <div class="header-left">
      <div class="header-icon">
        <i data-lucide="layers"></i>
      </div>
      <div class="header-text">
        <h1>Parallel Task Monitor</h1>
        <p>Real-time monitoring of concurrent task execution</p>
      </div>
    </div>

    <div class="header-actions">
      <div class="d-flex flex-wrap admin-flex-gap-sm">
        <%= link_to admin_parallel_tasks_path(time_range: '1h', filter: @filter), class: "admin-btn admin-btn-sm #{@time_range == '1h' ? 'admin-btn-primary' : 'admin-btn-outline'}" do %>
          <span>1 Hour</span>
        <% end %>
        <%= link_to admin_parallel_tasks_path(time_range: '24h', filter: @filter), class: "admin-btn admin-btn-sm #{@time_range == '24h' ? 'admin-btn-primary' : 'admin-btn-outline'}" do %>
          <span>24 Hours</span>
        <% end %>
        <%= link_to admin_parallel_tasks_path(time_range: '7d', filter: @filter), class: "admin-btn admin-btn-sm #{@time_range == '7d' ? 'admin-btn-primary' : 'admin-btn-outline'}" do %>
          <span>7 Days</span>
        <% end %>
        <%= link_to admin_parallel_tasks_path(time_range: 'all', filter: @filter), class: "admin-btn admin-btn-sm #{@time_range == 'all' ? 'admin-btn-primary' : 'admin-btn-outline'}" do %>
          <span>All Time</span>
        <% end %>
      </div>
    </div>
  </div>

  <!-- Statistics Cards -->
  <div class="admin-stats-grid">
    <%= render 'admin/shared/stat_card', icon: 'activity', label: 'Total Tasks', value: number_with_delimiter(@stats[:total]), style: 'purple-gradient', aria_label: 'Total parallel tasks count' %>
    <%= render 'admin/shared/stat_card', icon: 'loader', label: 'Active', value: number_with_delimiter(@stats[:active]), style: 'warning', aria_label: 'Active tasks count' %>
    <%= render 'admin/shared/stat_card', icon: 'check-circle', label: 'Success Rate', value: "#{@stats[:success_rate]}%", style: 'success', aria_label: 'Task success rate percentage' %>
    <%= render 'admin/shared/stat_card', icon: 'clock', label: 'Avg Duration', value: "#{@stats[:avg_duration]}s", style: 'info', aria_label: 'Average task duration' %>
  </div>

  <!-- Tasks Table -->
  <div class="admin-card">
    <div class="d-flex justify-content-between align-items-center admin-mb-lg">
      <h3 class="card-title m-0">
        <i data-lucide="list" class="admin-icon-md d-inline-block align-middle me-2" aria-hidden="true"></i>
        Task Execution Queue
      </h3>

      <div class="admin-tabs">
        <%= link_to "All", admin_parallel_tasks_path(time_range: @time_range),
                    class: "admin-tab #{@filter == 'all' || @filter.nil? ? 'admin-tab-active' : ''}" %>
        <%= link_to "Active", admin_parallel_tasks_path(time_range: @time_range, filter: 'active'),
                    class: "admin-tab #{@filter == 'active' ? 'admin-tab-active' : ''}" %>
        <%= link_to "Completed", admin_parallel_tasks_path(time_range: @time_range, filter: 'completed'),
                    class: "admin-tab #{@filter == 'completed' ? 'admin-tab-active' : ''}" %>
        <%= link_to "Failed", admin_parallel_tasks_path(time_range: @time_range, filter: 'failed'),
                    class: "admin-tab #{@filter == 'failed' ? 'admin-tab-active' : ''}" %>
        <%= link_to "Voice", admin_parallel_tasks_path(time_range: @time_range, filter: 'voice'),
                    class: "admin-tab #{@filter == 'voice' ? 'admin-tab-active' : ''}" %>
      </div>
    </div>

    <% if @tasks.any? %>
      <div class="admin-overflow-auto">
        <table class="admin-table">
        <%= admin_table_caption("Parallel task execution queue showing task status, progress, and actions") %>
        <thead>
          <tr>
            <th>ID</th>
            <th>Type</th>
            <th>User</th>
            <th>Description</th>
            <th>Status</th>
            <th>Progress</th>
            <th>Dependencies</th>
            <th>Duration</th>
            <th>Created</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <% @tasks.each do |task| %>
            <tr>
              <td>
                <code class="admin-text-cyan"><%= link_to "##{task.id}", admin_parallel_task_path(task), class: "admin-text-cyan text-decoration-none" %></code>
              </td>
              <td>
                <% type_badge = case task.task_type
                     when 'voice_immediate' then 'admin-badge-offline'
                     when 'voice_followup' then 'admin-badge-warning'
                     when 'analysis' then 'admin-badge-cyan'
                     else 'admin-badge-default'
                   end %>
                <span class="admin-badge <%= type_badge %>">
                  <%= task.task_type&.humanize || 'Unknown' %>
                </span>
              </td>
              <td class="admin-text-secondary"><%= task.user.email %></td>
              <td class="text-white admin-text-truncate admin-table-cell-truncate">
                <%= task.metadata['description'] || '-' %>
              </td>
              <td>
                <%= admin_status_badge(task.status) %>
              </td>
              <td>
                <div class="d-flex align-items-center admin-flex-gap-sm">
                  <div class="admin-progress-bar">
                    <div class="admin-progress-fill" style="width: <%= task.progress || 0 %>%;"></div>
                  </div>
                  <span class="admin-text-xs admin-text-secondary"><%= task.progress || 0 %>%</span>
                </div>
              </td>
              <td>
                <% if task.depends_on_tasks.any? %>
                  <span class="admin-badge admin-badge-primary admin-text-xs">
                    <%= task.depends_on_tasks.count %> deps
                  </span>
                <% else %>
                  <span class="admin-text-muted">None</span>
                <% end %>
              </td>
              <td class="admin-text-secondary">
                <% if task.started_at && task.status == 'completed' %>
                  <%= format_duration(task.updated_at - task.started_at) %>
                <% elsif task.started_at %>
                  <%= format_duration(Time.current - task.started_at) %>
                <% else %>
                  -
                <% end %>
              </td>
              <td class="admin-text-secondary admin-nowrap"><%= task.created_at.strftime('%m/%d %H:%M') %></td>
              <td>
                <div class="d-flex admin-flex-gap-sm">
                  <%= link_to admin_parallel_task_path(task),
                      class: "admin-btn admin-btn-sm admin-btn-outline admin-btn-icon",
                      'aria-label': "View task #{task.id} details" do %>
                    <i data-lucide="eye" class="admin-icon-sm" aria-hidden="true"></i>
                  <% end %>

                  <% if task.status == 'active' %>
                    <%= button_to cancel_admin_parallel_task_path(task),
                        method: :post,
                        class: "admin-btn admin-btn-sm admin-btn-warning admin-btn-icon",
                        'aria-label': "Cancel task #{task.id}",
                        data: { confirm: "Cancel this task?" } do %>
                      <i data-lucide="x-circle" class="admin-icon-sm" aria-hidden="true"></i>
                    <% end %>
                  <% elsif task.status.in?(['failed', 'cancelled']) %>
                    <%= button_to retry_admin_parallel_task_path(task),
                        method: :post,
                        class: "admin-btn admin-btn-sm admin-btn-primary admin-btn-icon",
                        'aria-label': "Retry task #{task.id}" do %>
                      <i data-lucide="refresh-cw" class="admin-icon-sm" aria-hidden="true"></i>
                    <% end %>
                  <% end %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <% if @tasks.count >= 100 %>
      <p class="text-muted admin-text-center admin-mt-lg mb-0 admin-text-sm">
        Showing first 100 tasks. Use filters to narrow results.
      </p>
    <% end %>
  <% else %>
    <div class="admin-empty-state">
      <div class="empty-icon">
        <i data-lucide="inbox"></i>
      </div>
      <h3>No tasks found</h3>
      <p>No parallel tasks match the selected filters</p>
    </div>
  <% end %>
  </div>

  <!-- Pagination -->
  <% if @tasks.any? && @tasks.total_pages > 1 %>
    <div class="admin-mt-xl">
      <%= paginate @tasks %>
    </div>
  <% end %>
</div>

<!-- Initialize Lucide Icons and Auto-refresh -->
<script>
  function initializeParallelTasksPage() {
    if (typeof lucide !== 'undefined') {
      lucide.createIcons();
    }
  }

  // Run on both DOMContentLoaded and turbo:load
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initializeParallelTasksPage);
  } else {
    initializeParallelTasksPage();
  }

  document.addEventListener('turbo:load', initializeParallelTasksPage);

  // Auto-refresh for active tasks
  <% if @stats[:active] > 0 %>
  setTimeout(() => {
    window.location.reload();
  }, 10000); // Refresh every 10 seconds when there are active tasks
  <% end %>
</script>
