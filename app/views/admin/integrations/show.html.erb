<div class="admin-content">
  <div class="admin-p-2rem">
    <div class="container-fluid">
  <div class="row mb-4">
    <div class="col">
      <h1>
        <% if @integration.icon_url.present? %>
          <img src="<%= @integration.icon_url %>" alt="<%= @integration.name %>" 
               class="rounded me-2 admin-icon-40">
        <% else %>
          <i data-lucide="puzzle" class="text-primary"></i>
        <% end %>
        <%= @integration.name %>
      </h1>
      <p class="text-muted"><%= @integration.description %></p>
    </div>
    <div class="col-auto">
      <%= link_to admin_integrations_path, class: "btn btn-outline-secondary" do %>
        <i data-lucide="arrow-left" class="me-1"></i> Back to Integrations
      <% end %>
    </div>
  </div>

  <!-- Info Cards -->
  <div class="row mb-4">
    <div class="col-md-3">
      <div class="card border-0 shadow-sm">
        <div class="card-body">
          <div class="small text-muted mb-1">Category</div>
          <div class="h5 mb-0">
            <span class="badge bg-primary"><%= @integration.category.humanize %></span>
          </div>
        </div>
      </div>
    </div>
    <div class="col-md-3">
      <div class="card border-0 shadow-sm">
        <div class="card-body">
          <div class="small text-muted mb-1">Authentication</div>
          <div class="h5 mb-0">
            <span class="badge bg-info"><%= @integration.auth_type.humanize %></span>
          </div>
        </div>
      </div>
    </div>
    <div class="col-md-3">
      <div class="card border-0 shadow-sm">
        <div class="card-body">
          <div class="small text-muted mb-1">Total Connections</div>
          <div class="h5 mb-0"><%= @integration.connections.count %></div>
        </div>
      </div>
    </div>
    <div class="col-md-3">
      <div class="card border-0 shadow-sm">
        <div class="card-body">
          <div class="small text-muted mb-1">Operations</div>
          <div class="h5 mb-0"><%= @integration.integration_operations.count %></div>
        </div>
      </div>
    </div>
  </div>

  <!-- Details -->
  <div class="row">
    <div class="col-lg-8">
      <!-- Configuration -->
      <div class="card border-0 shadow-sm mb-3">
        <div class="card-header bg-white">
          <h5 class="mb-0"><i data-lucide="settings"></i> Configuration</h5>
        </div>
        <div class="card-body">
          <dl class="row mb-0">
            <dt class="col-sm-3">Slug</dt>
            <dd class="col-sm-9"><code><%= @integration.slug %></code></dd>
            
            <dt class="col-sm-3">Status</dt>
            <dd class="col-sm-9">
              <span class="badge bg-<%= @integration.is_active ? 'success' : 'secondary' %>">
                <%= @integration.is_active ? 'Active' : 'Inactive' %>
              </span>
            </dd>
            
            <dt class="col-sm-3">Verified</dt>
            <dd class="col-sm-9">
              <% if @integration.is_verified %>
                <i data-lucide="check-circle" class="text-success"></i> Verified
              <% else %>
                <i data-lucide="x-circle" class="text-muted"></i> Not verified
              <% end %>
            </dd>
            
            <dt class="col-sm-3">Created</dt>
            <dd class="col-sm-9"><%= @integration.created_at.strftime("%B %d, %Y") %></dd>
          </dl>
        </div>
      </div>

      <!-- Operations -->
      <div class="card border-0 shadow-sm">
        <div class="card-header bg-white d-flex justify-content-between align-items-center">
          <h5 class="mb-0"><i data-lucide="list-checks"></i> Available Operations</h5>
          <% if current_admin&.editor? || current_admin&.super_admin? %>
            <button type="button" class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#discoverOperationsModal">
              <i data-lucide="sparkles" class="me-1"></i> AI Discover
            </button>
          <% end %>
        </div>
        <div class="card-body">
          <% if @integration.integration_operations.any? %>
            <div class="list-group">
              <% @integration.integration_operations.order(is_enabled: :desc, created_at: :desc).each do |operation| %>
                <div class="list-group-item <%= 'bg-light' unless operation.is_enabled %>">
                  <div class="d-flex justify-content-between align-items-center">
                    <div class="flex-grow-1">
                      <div class="d-flex align-items-center gap-2">
                        <h6 class="mb-1"><%= operation.name %></h6>
                        <% unless operation.is_enabled %>
                          <span class="badge bg-warning text-dark">Disabled</span>
                        <% end %>
                        <% if operation.documentation&.include?("Auto-discovered by AI") %>
                          <span class="badge bg-info">
                            <i data-lucide="sparkles"></i> AI Discovered
                          </span>
                        <% end %>
                      </div>
                      <small class="text-muted"><%= operation.description %></small>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                      <span class="badge bg-secondary"><%= operation.http_method.upcase %></span>
                      <%= link_to "Edit", edit_admin_integration_operation_path(@integration, operation), class: "btn btn-sm btn-outline-primary" %>
                    </div>
                  </div>
                </div>
              <% end %>
            </div>
          <% else %>
            <p class="text-muted mb-0">No operations defined yet. Click "AI Discover" to automatically find operations!</p>
          <% end %>
        </div>
      </div>
    </div>

    <!-- Sidebar -->
    <div class="col-lg-4">
      <!-- Auth Configuration (for all integrations) -->
      <div class="card border-0 shadow-sm mb-3">
        <div class="card-header bg-white">
          <h5 class="mb-0"><i data-lucide="key"></i> Authentication Configuration</h5>
        </div>
        <div class="card-body">
          <% oauth_config = OauthConfiguration.find_by(integration: @integration) %>
          
          <% if oauth_config %>
            <dl class="row mb-3">
              <dt class="col-sm-4">Auth Type</dt>
              <dd class="col-sm-8"><span class="badge bg-info"><%= @integration.auth_type.humanize %></span></dd>
              
              <% if @integration.oauth? %>
                <dt class="col-sm-4">Client ID</dt>
                <dd class="col-sm-8"><code><%= oauth_config.client_id[0..15] %>...</code></dd>
                
                <dt class="col-sm-4">Redirect URI</dt>
                <dd class="col-sm-8"><small><%= oauth_config.redirect_uri %></small></dd>
              <% else %>
                <dt class="col-sm-4">Auth Params</dt>
                <dd class="col-sm-8">
                  <% if oauth_config.auth_configs.any? %>
                    <div class="small">
                      <% oauth_config.auth_configs.order(:position).each do |ac| %>
                        <div class="mb-1">
                          <span class="badge badge-sm bg-secondary"><%= ac.auth_placement %></span>
                          <code class="small"><%= ac.auth_key %></code>
                        </div>
                      <% end %>
                    </div>
                  <% else %>
                    <span class="text-muted small">Not configured</span>
                  <% end %>
                </dd>
              <% end %>
              
              <dt class="col-sm-4">Status</dt>
              <dd class="col-sm-8">
                <span class="badge bg-<%= oauth_config.active? ? 'success' : 'secondary' %>">
                  <%= oauth_config.status.humanize %>
                </span>
              </dd>
            </dl>
            <%= link_to edit_admin_integration_oauth_configuration_path(@integration, oauth_config), 
                class: "btn btn-warning btn-sm w-100" do %>
              <i data-lucide="edit" class="me-1"></i> Edit Auth Config
            <% end %>
          <% else %>
            <p class="text-muted mb-3">
              <strong>Auth Type:</strong> 
              <span class="badge bg-info"><%= @integration.auth_type.humanize %></span>
            </p>
            <p class="text-muted mb-3">No authentication configuration yet</p>
            
            <%= link_to new_admin_integration_oauth_configuration_path(@integration), class: "btn btn-warning btn-sm w-100" do %>
              <i data-lucide="plus" class="me-1"></i> Configure Authentication
            <% end %>
          <% end %>
        </div>
      </div>
      
      <!-- Active Connections -->
      <div class="card border-0 shadow-sm mb-3">
        <div class="card-header bg-white">
          <h5 class="mb-0"><i data-lucide="link"></i> Active Connections</h5>
        </div>
        <div class="card-body">
          <% active_connections = @integration.connections.where(status: 'connected') %>
          <% if active_connections.any? %>
            <ul class="list-unstyled mb-0">
              <% active_connections.limit(5).each do |connection| %>
                <li class="mb-2">
                  <%= link_to connection.name, admin_connection_path(connection), class: "text-decoration-none" %>
                  <br><small class="text-muted"><%= connection.entity&.name || 'No entity' %></small>
                </li>
              <% end %>
            </ul>
            <% if active_connections.count > 5 %>
              <small class="text-muted">+ <%= active_connections.count - 5 %> more</small>
            <% end %>
          <% else %>
            <p class="text-muted mb-0">No active connections</p>
          <% end %>
        </div>
      </div>

      <!-- Actions -->
      <div class="card border-0 shadow-sm">
        <div class="card-header bg-white">
          <h5 class="mb-0"><i data-lucide="zap"></i> Actions</h5>
        </div>
        <div class="card-body d-grid gap-2">
          <%= link_to edit_admin_integration_path(@integration), class: "btn btn-primary" do %>
            <i data-lucide="edit" class="me-2"></i> Edit Integration
          <% end %>
          
          <%= link_to admin_integration_path(@integration, format: :json), 
              class: "btn btn-outline-info", 
              target: "_blank" do %>
            <i data-lucide="code" class="me-2"></i> View JSON
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
  </div>
</div>

<!-- AI Operation Discovery Modal -->
<div class="modal fade" id="discoverOperationsModal" tabindex="-1" aria-labelledby="discoverOperationsModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-lg">
    <div class="modal-content">
      <%= form_with url: discover_operations_admin_integration_path(@integration), method: :post, local: true do |form| %>
        <div class="modal-header">
          <h5 class="modal-title" id="discoverOperationsModalLabel">
            <i data-lucide="sparkles" class="text-primary me-2"></i> AI Operation Discovery
          </h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
          <p class="text-muted">
            Our AI will automatically research the <%= @integration.name %> API to discover useful operations that aren't currently implemented.
          </p>
          
          <div class="alert alert-info mb-3">
            <strong><i data-lucide="brain" class="me-2"></i> How it works:</strong>
            <ol class="mb-0 mt-2">
              <li>AI searches the web for <%= @integration.name %> API documentation</li>
              <li>Analyzes your existing operations as templates</li>
              <li>Identifies gaps and suggests 5-10 most useful missing operations</li>
              <li>Creates operations (disabled) for your review</li>
            </ol>
          </div>
          
          <div class="card border-primary mb-3">
            <div class="card-body py-2">
              <small>
                <i data-lucide="lightbulb" class="text-warning me-1"></i>
                <strong>Current Operations:</strong> <%= @integration.integration_operations.count %> configured
                <% if @integration.integration_operations.any? %>
                  <br>
                  <span class="text-muted">The AI will use these as templates to match your integration's style and patterns.</span>
                <% end %>
              </small>
            </div>
          </div>
          
          <div class="mb-3">
            <label for="operation_spec" class="form-label">
              <strong><i data-lucide="target" class="me-1"></i> Target Specific Operations (Optional)</strong>
            </label>
            <%= form.text_area :operation_spec, 
                class: "form-control", 
                rows: 5,
                placeholder: "Examples:\n- List all invoices\n- Create a new customer\n- Update payment method\n- Delete a subscription\n- Get transaction details\n\nLeave blank for AI to suggest the most commonly useful operations." %>
            <small class="form-text text-muted">
              Tell the AI what operations you need, or leave blank for automatic discovery.
            </small>
          </div>
          
          <div class="alert alert-warning mb-0">
            <i data-lucide="clock" class="me-2"></i>
            <strong>Processing time:</strong> 1-2 minutes. You'll receive a notification when new operations are ready for review.
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
          <%= form.submit "Start Discovery", class: "btn btn-primary" %>
        </div>
      <% end %>
    </div>
  </div>
</div>

