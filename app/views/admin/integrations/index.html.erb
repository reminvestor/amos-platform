<script src="https://unpkg.com/lucide@latest"></script>

<div class="admin-content">
  <div style="padding: 2rem;">
    <%# Page Header %>
    <div class="admin-page-header">
      <div class="header-left">
        <div class="header-icon">
          <i data-lucide="plug"></i>
        </div>
        <div class="header-text">
          <h1>Integrations</h1>
          <p>Manage third-party service integrations and API connections</p>
        </div>
      </div>

      <% if @current_admin.editor? || @current_admin.super_admin? %>
        <div class="header-actions">
          <%= link_to new_admin_integration_path, class: "admin-btn admin-btn-primary" do %>
            <i data-lucide="plus"></i>
            <span>Add Integration</span>
          <% end %>
        </div>
      <% end %>
    </div>

    <%# Stats Cards %>
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1.5rem; margin-bottom: 2rem;">
      <%# Total Integrations %>
      <div class="admin-card">
        <div style="display: flex; align-items: center; gap: 1rem;">
          <div style="width: 3rem; height: 3rem; border-radius: 0.75rem; background: linear-gradient(135deg, #7C3AED 0%, #A78BFA 100%); display: flex; align-items: center; justify-content: center;">
            <i data-lucide="puzzle" class="icon-xl text-white"></i>
          </div>
          <div>
            <p style="color: #94A3B8; font-size: 0.875rem; margin: 0;">Total Integrations</p>
            <h3 style="color: white; font-size: 1.875rem; font-weight: 600; margin: 0;"><%= @stats[:total] %></h3>
            <p style="color: #64748B; font-size: 0.75rem; margin: 0;"><%= @stats[:verified] %> verified, <%= @stats[:custom] %> custom</p>
          </div>
        </div>
      </div>

      <%# Active Connections %>
      <div class="admin-card">
        <div style="display: flex; align-items: center; gap: 1rem;">
          <div style="width: 3rem; height: 3rem; border-radius: 0.75rem; background: rgba(34, 197, 94, 0.1); display: flex; align-items: center; justify-content: center; border: 1px solid rgba(34, 197, 94, 0.2);">
            <i data-lucide="link" class="icon-xl text-success"></i>
          </div>
          <div>
            <p style="color: #94A3B8; font-size: 0.875rem; margin: 0;">Active Connections</p>
            <h3 style="color: white; font-size: 1.875rem; font-weight: 600; margin: 0;"><%= @stats[:active_connections] %></h3>
            <p style="color: #64748B; font-size: 0.75rem; margin: 0;">Across <%= @stats[:connected_entities] %> entities</p>
          </div>
        </div>
      </div>

      <%# API Calls (24h) %>
      <div class="admin-card">
        <div style="display: flex; align-items: center; gap: 1rem;">
          <div style="width: 3rem; height: 3rem; border-radius: 0.75rem; background: rgba(34, 211, 238, 0.1); display: flex; align-items: center; justify-content: center; border: 1px solid rgba(34, 211, 238, 0.2);">
            <i data-lucide="activity" class="icon-xl text-info"></i>
          </div>
          <div>
            <p style="color: #94A3B8; font-size: 0.875rem; margin: 0;">API Calls (24h)</p>
            <h3 style="color: white; font-size: 1.875rem; font-weight: 600; margin: 0;"><%= number_with_delimiter(@stats[:api_calls_24h]) %></h3>
            <p style="color: #64748B; font-size: 0.75rem; margin: 0;"><%= @stats[:error_rate] %>% error rate</p>
          </div>
        </div>
      </div>
    </div>

    <%# Integrations Table %>
    <div class="admin-card">
      <h3 class="card-title">
        <i data-lucide="list" class="icon-lg icon-with-spacing"></i>
        All Integrations
      </h3>

      <% if @integrations.any? %>
        <div style="overflow-x: auto;">
          <table class="admin-table">
            <thead>
              <tr>
                <th>Integration</th>
                <th>Category</th>
                <th>Auth Type</th>
                <th>Connections</th>
                <th>Status</th>
                <th>Actions</th>
              </tr>
            </thead>
            <tbody>
              <% @integrations.each do |integration| %>
                <tr>
                  <td>
                    <div style="display: flex; align-items: center; gap: 0.75rem;">
                      <% if integration.icon_url.present? %>
                        <img src="<%= integration.icon_url %>" alt="<%= integration.name %>"
                             style="width: 32px; height: 32px; border-radius: 0.375rem;">
                      <% else %>
                        <div style="width: 32px; height: 32px; border-radius: 0.375rem; background: linear-gradient(135deg, #7C3AED 0%, #A78BFA 100%); display: flex; align-items: center; justify-content: center;">
                          <i data-lucide="puzzle" style="width: 1rem; height: 1rem; color: white;"></i>
                        </div>
                      <% end %>
                      <div>
                        <div style="display: flex; align-items: center; gap: 0.5rem;">
                          <span style="color: white; font-weight: 600;"><%= integration.name %></span>
                          <% if integration.is_verified %>
                            <i data-lucide="check-circle" style="width: 1rem; height: 1rem; color: rgb(74, 222, 128);" title="Verified"></i>
                          <% end %>
                        </div>
                        <span style="color: #64748B; font-size: 0.75rem;"><%= integration.slug %></span>
                      </div>
                    </div>
                  </td>
                  <td style="color: #94A3B8;"><%= integration.category&.humanize || 'N/A' %></td>
                  <td>
                    <span class="admin-badge admin-badge-cyan"><%= integration.auth_type&.humanize || 'None' %></span>
                  </td>
                  <td style="color: #94A3B8;">
                    <%= integration.connections.count %>
                    <% if integration.connections.active.any? %>
                      <span style="color: rgb(74, 222, 128);">(<%= integration.connections.active.count %> active)</span>
                    <% end %>
                  </td>
                  <td>
                    <% if integration.is_active %>
                      <span class="admin-badge admin-badge-online">Active</span>
                    <% else %>
                      <span class="admin-badge admin-badge-default">Inactive</span>
                    <% end %>
                  </td>
                  <td>
                    <div style="display: flex; gap: 0.5rem; align-items: center;">
                      <%= link_to admin_integration_path(integration), class: "admin-btn admin-btn-sm admin-btn-outline" do %>
                        <i data-lucide="eye"></i>
                        <span>View</span>
                      <% end %>
                      <% if @current_admin.editor? || @current_admin.super_admin? %>
                        <%= link_to edit_admin_integration_path(integration), class: "admin-btn admin-btn-sm admin-btn-outline" do %>
                          <i data-lucide="edit"></i>
                        <% end %>
                        <%= link_to admin_integration_operations_path(integration), class: "admin-btn admin-btn-sm admin-btn-outline", title: "Operations" do %>
                          <i data-lucide="settings"></i>
                        <% end %>
                        <%= link_to new_admin_integration_oauth_configuration_path(integration), class: "admin-btn admin-btn-sm admin-btn-outline", title: "Auth Config" do %>
                          <i data-lucide="key"></i>
                        <% end %>
                      <% end %>
                    </div>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% else %>
        <%# Empty State %>
        <div class="admin-empty-state">
          <div class="empty-icon">
            <i data-lucide="puzzle"></i>
          </div>
          <h3>No Integrations</h3>
          <p>Get started by adding your first integration to connect with third-party services.</p>
          <% if @current_admin.editor? || @current_admin.super_admin? %>
            <%= link_to new_admin_integration_path, class: "admin-btn admin-btn-primary" do %>
              <i data-lucide="plus"></i>
              <span>Add Integration</span>
            <% end %>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
</div>

<script>
  document.addEventListener('turbo:load', () => {
    if (typeof lucide !== 'undefined') {
      lucide.createIcons();
    }
  });

  document.addEventListener('DOMContentLoaded', () => {
    if (typeof lucide !== 'undefined') {
      lucide.createIcons();
    }
  });
</script>
