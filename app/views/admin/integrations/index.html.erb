<div class="admin-p-xl">
  <!-- Page Header -->
  <div class="admin-page-header admin-mb-xl">
    <div class="header-left">
      <div class="header-icon admin-icon-gradient-purple">
        <i data-lucide="plug" class="admin-text-primary"></i>
      </div>
      <div class="header-text">
        <h1>Integrations</h1>
        <p>Manage third-party service integrations and API connections</p>
      </div>
    </div>

    <% if @current_admin.editor? || @current_admin.super_admin? %>
      <div class="header-actions">
        <%= link_to new_admin_integration_path, class: "admin-btn admin-btn-primary" do %>
          <i data-lucide="plus"></i>
          <span>Add Integration</span>
        <% end %>
      </div>
    <% end %>
  </div>

  <!-- Stats Cards -->
  <div class="admin-stats-grid admin-mb-xl">
    <div class="admin-card">
      <div class="admin-flex admin-items-center admin-flex-gap-md">
        <div class="admin-stat-icon purple-gradient">
          <i data-lucide="puzzle" class="admin-icon-lg admin-text-primary"></i>
        </div>
        <div>
          <p class="admin-stat-label">Total Integrations</p>
          <h3 class="admin-stat-value"><%= @stats[:total] %></h3>
          <small class="admin-text-muted admin-text-xs"><%= @stats[:verified] %> verified, <%= @stats[:custom] %> custom</small>
        </div>
      </div>
    </div>

    <div class="admin-card">
      <div class="admin-flex admin-items-center admin-flex-gap-md">
        <div class="admin-stat-icon success">
          <i data-lucide="link" class="admin-icon-lg admin-text-success"></i>
        </div>
        <div>
          <p class="admin-stat-label">Active Connections</p>
          <h3 class="admin-stat-value"><%= @stats[:active_connections] %></h3>
          <small class="admin-text-muted admin-text-xs">Across <%= @stats[:connected_entities] %> entities</small>
        </div>
      </div>
    </div>

    <div class="admin-card">
      <div class="admin-flex admin-items-center admin-flex-gap-md">
        <div class="admin-stat-icon info">
          <i data-lucide="activity" class="admin-icon-lg admin-text-info"></i>
        </div>
        <div>
          <p class="admin-stat-label">API Calls (24h)</p>
          <h3 class="admin-stat-value"><%= number_with_delimiter(@stats[:api_calls_24h]) %></h3>
          <small class="admin-text-muted admin-text-xs"><%= @stats[:error_rate] %>% error rate</small>
        </div>
      </div>
    </div>
  </div>

  <!-- Integrations Table -->
  <div class="admin-card">
    <div class="admin-mb-lg">
      <h3 class="card-title">
        <i data-lucide="list" class="admin-icon-md admin-inline-block admin-mr-sm"></i>
        All Integrations
      </h3>
    </div>

    <% if @integrations.any? %>
      <div class="admin-table-container">
        <table class="admin-table">
          <thead>
            <tr>
              <th>Integration</th>
              <th>Category</th>
              <th>Auth Type</th>
              <th>Connections</th>
              <th>Status</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            <% @integrations.each do |integration| %>
              <tr>
                <td>
                  <div class="admin-flex admin-items-center admin-flex-gap-md">
                    <% if integration.icon_url.present? %>
                      <img src="<%= integration.icon_url %>" alt="<%= integration.name %>"
                           class="admin-integration-icon admin-bg-darker admin-p-sm">
                    <% else %>
                      <div class="admin-integration-icon admin-integration-icon-placeholder">
                        <i data-lucide="puzzle" class="admin-icon-md admin-text-primary"></i>
                      </div>
                    <% end %>
                    <div>
                      <div class="admin-flex admin-items-center admin-flex-gap-sm">
                        <span class="admin-text-primary admin-font-semibold"><%= integration.name %></span>
                        <% if integration.is_verified %>
                          <i data-lucide="check-circle" class="admin-icon-sm admin-text-success" title="Verified"></i>
                        <% end %>
                      </div>
                      <span class="admin-text-muted admin-text-xs"><%= integration.slug %></span>
                    </div>
                  </div>
                </td>
                <td class="admin-text-secondary"><%= integration.category&.humanize || 'N/A' %></td>
                <td>
                  <span class="admin-badge admin-badge-cyan"><%= integration.auth_type&.humanize || 'None' %></span>
                </td>
                <td class="admin-text-secondary">
                  <%= integration.connections.count %>
                  <% if integration.connections.active.any? %>
                    <span class="admin-text-success admin-text-xs">(<%= integration.connections.active.count %> active)</span>
                  <% end %>
                </td>
                <td>
                  <% if integration.is_active %>
                    <span class="admin-badge admin-badge-online">Active</span>
                  <% else %>
                    <span class="admin-badge admin-badge-secondary">Inactive</span>
                  <% end %>
                </td>
                <td>
                  <div class="admin-flex admin-flex-gap-sm admin-items-center">
                    <%= link_to admin_integration_path(integration), class: "admin-btn admin-btn-sm admin-btn-outline", title: "View" do %>
                      <i data-lucide="eye" class="admin-icon-sm"></i>
                    <% end %>
                    <% if @current_admin.editor? || @current_admin.super_admin? %>
                      <%= link_to edit_admin_integration_path(integration), class: "admin-btn admin-btn-sm admin-btn-outline", title: "Edit" do %>
                        <i data-lucide="edit" class="admin-icon-sm"></i>
                      <% end %>
                      <%= link_to admin_integration_operations_path(integration), class: "admin-btn admin-btn-sm admin-btn-warning-outline", title: "Operations" do %>
                        <i data-lucide="settings" class="admin-icon-sm"></i>
                      <% end %>
                      <%= link_to new_admin_integration_oauth_configuration_path(integration), class: "admin-btn admin-btn-sm admin-btn-info-outline", title: "Auth Config" do %>
                        <i data-lucide="key" class="admin-icon-sm"></i>
                      <% end %>
                    <% end %>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <div class="admin-empty-state admin-text-center admin-p-xl">
        <div class="empty-icon admin-mb-md admin-text-muted">
          <i data-lucide="puzzle" class="admin-icon-xl"></i>
        </div>
        <h3 class="admin-text-primary">No Integrations</h3>
        <p class="admin-text-secondary admin-mb-lg">Get started by adding your first integration to connect with third-party services.</p>
        <% if @current_admin.editor? || @current_admin.super_admin? %>
          <%= link_to new_admin_integration_path, class: "admin-btn admin-btn-primary" do %>
            <i data-lucide="plus"></i>
            <span>Add Integration</span>
          <% end %>
        <% end %>
      </div>
    <% end %>
  </div>
</div>

<script>
  document.addEventListener('turbo:load', () => {
    if (typeof lucide !== 'undefined') {
      lucide.createIcons();
    }
  });

  document.addEventListener('DOMContentLoaded', () => {
    if (typeof lucide !== 'undefined') {
      lucide.createIcons();
    }
  });
</script>
