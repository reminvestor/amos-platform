
<div class="admin-content">
  <div class="admin-p-xl">
    <%# Page Header %>
    <div class="admin-page-header">
      <div class="header-left">
        <div class="header-icon">
          <%= admin_icon('plug', size: :lg) %>
        </div>
        <div class="header-text">
          <h1>Integrations</h1>
          <p>Manage third-party service integrations and API connections</p>
        </div>
      </div>

      <% if @current_admin.editor? || @current_admin.super_admin? %>
        <div class="header-actions">
          <%= link_to new_admin_integration_path, class: "admin-btn admin-btn-primary" do %>
            <%= admin_icon('plus', size: :sm) %>
            <span>Add Integration</span>
          <% end %>
        </div>
      <% end %>
    </div>

    <%# Stats Cards %>
    <div class="admin-stats-grid admin-mb-xl">
      <%= render 'admin/shared/stat_card',
          icon: 'puzzle',
          label: 'Total Integrations',
          value: @stats[:total],
          subtitle: "#{@stats[:verified]} verified, #{@stats[:custom]} custom",
          variant: 'purple-gradient' %>

      <%= render 'admin/shared/stat_card',
          icon: 'link',
          label: 'Active Connections',
          value: @stats[:active_connections],
          subtitle: "Across #{@stats[:connected_entities]} entities",
          variant: 'success' %>

      <%= render 'admin/shared/stat_card',
          icon: 'activity',
          label: 'API Calls (24h)',
          value: number_with_delimiter(@stats[:api_calls_24h]),
          subtitle: "#{@stats[:error_rate]}% error rate",
          variant: 'info' %>
    </div>

    <%# Integrations Table %>
    <div class="admin-card">
      <h3 class="card-title">
        <%= admin_icon('list', size: :lg, class: 'icon-with-spacing') %>
        All Integrations
      </h3>

      <% if @integrations.any? %>
        <div class="admin-overflow-x-auto">
          <table class="admin-table">
            <thead>
              <tr>
                <th>Integration</th>
                <th>Category</th>
                <th>Auth Type</th>
                <th>Connections</th>
                <th>Status</th>
                <th>Actions</th>
              </tr>
            </thead>
            <tbody>
              <% @integrations.each do |integration| %>
                <tr>
                  <td>
                    <div class="admin-flex admin-items-center admin-flex-gap-md">
                      <% if integration.icon_url.present? %>
                        <img src="<%= integration.icon_url %>" alt="<%= integration.name %>"
                             class="admin-integration-icon">
                      <% else %>
                        <div class="admin-integration-icon admin-integration-icon-placeholder">
                          <%= admin_icon('puzzle', size: :sm, class: 'text-white') %>
                        </div>
                      <% end %>
                      <div>
                        <div class="admin-flex admin-items-center admin-flex-gap-sm">
                          <span class="admin-text-primary admin-font-semibold"><%= integration.name %></span>
                          <% if integration.is_verified %>
                            <%= admin_icon('check-circle', size: :sm, class: 'admin-text-success', title: 'Verified') %>
                          <% end %>
                        </div>
                        <span class="admin-text-muted admin-text-xs"><%= integration.slug %></span>
                      </div>
                    </div>
                  </td>
                  <td class="admin-text-muted"><%= integration.category&.humanize || 'N/A' %></td>
                  <td>
                    <span class="admin-badge admin-badge-cyan"><%= integration.auth_type&.humanize || 'None' %></span>
                  </td>
                  <td class="admin-text-muted">
                    <%= integration.connections.count %>
                    <% if integration.connections.active.any? %>
                      <span class="admin-text-success">(<%= integration.connections.active.count %> active)</span>
                    <% end %>
                  </td>
                  <td>
                    <% if integration.is_active %>
                      <span class="admin-badge admin-badge-online">Active</span>
                    <% else %>
                      <span class="admin-badge admin-badge-default">Inactive</span>
                    <% end %>
                  </td>
                  <td>
                    <div class="admin-flex admin-flex-gap-sm admin-items-center">
                      <%= link_to admin_integration_path(integration), class: "admin-btn admin-btn-sm admin-btn-outline" do %>
                        <%= admin_icon('eye', size: :sm) %>
                        <span>View</span>
                      <% end %>
                      <% if @current_admin.editor? || @current_admin.super_admin? %>
                        <%= link_to edit_admin_integration_path(integration), class: "admin-btn admin-btn-sm admin-btn-outline" do %>
                          <%= admin_icon('edit', size: :sm) %>
                        <% end %>
                        <%= link_to admin_integration_operations_path(integration), class: "admin-btn admin-btn-sm admin-btn-outline", title: "Operations" do %>
                          <%= admin_icon('settings', size: :sm) %>
                        <% end %>
                        <%= link_to new_admin_integration_oauth_configuration_path(integration), class: "admin-btn admin-btn-sm admin-btn-outline", title: "Auth Config" do %>
                          <%= admin_icon('key', size: :sm) %>
                        <% end %>
                      <% end %>
                    </div>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% else %>
        <%# Empty State %>
        <div class="admin-empty-state">
          <div class="empty-icon">
            <%= admin_icon('puzzle', size: :xl) %>
          </div>
          <h3>No Integrations</h3>
          <p>Get started by adding your first integration to connect with third-party services.</p>
          <% if @current_admin.editor? || @current_admin.super_admin? %>
            <%= link_to new_admin_integration_path, class: "admin-btn admin-btn-primary" do %>
              <%= admin_icon('plus', size: :sm) %>
              <span>Add Integration</span>
            <% end %>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
</div>

<script>
  document.addEventListener('turbo:load', () => {
    if (typeof lucide !== 'undefined') {
      lucide.createIcons();
    }
  });

  document.addEventListener('DOMContentLoaded', () => {
    if (typeof lucide !== 'undefined') {
      lucide.createIcons();
    }
  });
</script>
