<div style="padding: 2rem;">
  <!-- Page Header -->
  <div class="admin-page-header" style="margin-bottom: 2rem;">
    <div class="header-left">
      <div class="header-icon" style="background: linear-gradient(135deg, #8B5CF6 0%, #6D28D9 100%);">
        <i data-lucide="plug" style="color: white;"></i>
      </div>
      <div class="header-text">
        <h1>Integrations</h1>
        <p>Manage third-party service integrations and API connections</p>
      </div>
    </div>

    <% if @current_admin.editor? || @current_admin.super_admin? %>
      <div class="header-actions">
        <%= link_to new_admin_integration_path, class: "admin-btn admin-btn-primary" do %>
          <i data-lucide="plus"></i>
          <span>Add Integration</span>
        <% end %>
      </div>
    <% end %>
  </div>

  <!-- Stats Cards -->
  <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1.5rem; margin-bottom: 2rem;">
    <div class="admin-card">
      <div style="display: flex; align-items: center; gap: 1rem;">
        <div style="width: 3rem; height: 3rem; border-radius: 0.75rem; background: linear-gradient(135deg, #7C3AED 0%, #A78BFA 100%); display: flex; align-items: center; justify-content: center;">
          <i data-lucide="puzzle" style="width: 1.5rem; height: 1.5rem; color: white;"></i>
        </div>
        <div>
          <p style="color: #94A3B8; font-size: 0.875rem; margin: 0;">Total Integrations</p>
          <h3 style="color: white; font-size: 1.875rem; font-weight: 600; margin: 0;"><%= @stats[:total] %></h3>
          <small style="color: #64748B; font-size: 0.75rem;"><%= @stats[:verified] %> verified, <%= @stats[:custom] %> custom</small>
        </div>
      </div>
    </div>

    <div class="admin-card">
      <div style="display: flex; align-items: center; gap: 1rem;">
        <div style="width: 3rem; height: 3rem; border-radius: 0.75rem; background: rgba(34, 197, 94, 0.1); border: 1px solid rgba(34, 197, 94, 0.2); display: flex; align-items: center; justify-content: center;">
          <i data-lucide="link" style="width: 1.5rem; height: 1.5rem; color: rgb(74, 222, 128);"></i>
        </div>
        <div>
          <p style="color: #94A3B8; font-size: 0.875rem; margin: 0;">Active Connections</p>
          <h3 style="color: white; font-size: 1.875rem; font-weight: 600; margin: 0;"><%= @stats[:active_connections] %></h3>
          <small style="color: #64748B; font-size: 0.75rem;">Across <%= @stats[:connected_entities] %> entities</small>
        </div>
      </div>
    </div>

    <div class="admin-card">
      <div style="display: flex; align-items: center; gap: 1rem;">
        <div style="width: 3rem; height: 3rem; border-radius: 0.75rem; background: rgba(34, 211, 238, 0.1); border: 1px solid rgba(34, 211, 238, 0.2); display: flex; align-items: center; justify-content: center;">
          <i data-lucide="activity" style="width: 1.5rem; height: 1.5rem; color: #22D3EE;"></i>
        </div>
        <div>
          <p style="color: #94A3B8; font-size: 0.875rem; margin: 0;">API Calls (24h)</p>
          <h3 style="color: white; font-size: 1.875rem; font-weight: 600; margin: 0;"><%= number_with_delimiter(@stats[:api_calls_24h]) %></h3>
          <small style="color: #64748B; font-size: 0.75rem;"><%= @stats[:error_rate] %>% error rate</small>
        </div>
      </div>
    </div>
  </div>

  <!-- Integrations Table -->
  <div class="admin-card">
    <div style="margin-bottom: 1.5rem;">
      <h3 class="card-title">
        <i data-lucide="list" style="width: 1.25rem; height: 1.25rem; display: inline-block; vertical-align: middle; margin-right: 0.5rem;"></i>
        All Integrations
      </h3>
    </div>

    <% if @integrations.any? %>
      <div class="admin-table-container">
        <table class="admin-table">
          <thead>
            <tr>
              <th>Integration</th>
              <th>Category</th>
              <th>Auth Type</th>
              <th>Connections</th>
              <th>Status</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            <% @integrations.each do |integration| %>
              <tr>
                <td>
                  <div style="display: flex; align-items: center; gap: 1rem;">
                    <% if integration.icon_url.present? %>
                      <img src="<%= integration.icon_url %>" alt="<%= integration.name %>"
                           style="width: 2.5rem; height: 2.5rem; border-radius: 0.5rem; object-fit: contain; background: #1E293B; padding: 0.25rem;">
                    <% else %>
                      <div style="width: 2.5rem; height: 2.5rem; border-radius: 0.5rem; background: #1E293B; display: flex; align-items: center; justify-content: center;">
                        <i data-lucide="puzzle" style="width: 1.25rem; height: 1.25rem; color: white;"></i>
                      </div>
                    <% end %>
                    <div>
                      <div style="display: flex; align-items: center; gap: 0.5rem;">
                        <span style="color: white; font-weight: 600;"><%= integration.name %></span>
                        <% if integration.is_verified %>
                          <i data-lucide="check-circle" style="width: 1rem; height: 1rem; color: rgb(74, 222, 128);" title="Verified"></i>
                        <% end %>
                      </div>
                      <span style="color: #64748B; font-size: 0.75rem;"><%= integration.slug %></span>
                    </div>
                  </div>
                </td>
                <td style="color: #94A3B8;"><%= integration.category&.humanize || 'N/A' %></td>
                <td>
                  <span class="admin-badge admin-badge-cyan"><%= integration.auth_type&.humanize || 'None' %></span>
                </td>
                <td style="color: #94A3B8;">
                  <%= integration.connections.count %>
                  <% if integration.connections.active.any? %>
                    <span style="color: rgb(74, 222, 128); font-size: 0.75rem;">(<%= integration.connections.active.count %> active)</span>
                  <% end %>
                </td>
                <td>
                  <% if integration.is_active %>
                    <span class="admin-badge admin-badge-online">Active</span>
                  <% else %>
                    <span class="admin-badge admin-badge-secondary">Inactive</span>
                  <% end %>
                </td>
                <td>
                  <div style="display: flex; gap: 0.5rem; align-items: center;">
                    <%= link_to admin_integration_path(integration), class: "admin-btn admin-btn-sm admin-btn-outline icon-btn", title: "View", style: "border-color: #1E293B; color: #3B82F6;" do %>
                      <i data-lucide="eye" style="width: 1rem; height: 1rem;"></i>
                    <% end %>
                    <% if @current_admin.editor? || @current_admin.super_admin? %>
                      <%= link_to edit_admin_integration_path(integration), class: "admin-btn admin-btn-sm admin-btn-outline icon-btn", title: "Edit", style: "border-color: #1E293B; color: #94A3B8;" do %>
                        <i data-lucide="edit" style="width: 1rem; height: 1rem;"></i>
                      <% end %>
                      <%= link_to admin_integration_operations_path(integration), class: "admin-btn admin-btn-sm admin-btn-outline icon-btn", title: "Operations", style: "border-color: #1E293B; color: #F59E0B;" do %>
                        <i data-lucide="settings" style="width: 1rem; height: 1rem;"></i>
                      <% end %>
                      <%= link_to new_admin_integration_oauth_configuration_path(integration), class: "admin-btn admin-btn-sm admin-btn-outline icon-btn", title: "Auth Config", style: "border-color: #1E293B; color: #22D3EE;" do %>
                        <i data-lucide="key" style="width: 1rem; height: 1rem;"></i>
                      <% end %>
                    <% end %>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <%# Empty State %>
      <div class="admin-empty-state" style="text-align: center; padding: 3rem 0;">
        <div class="empty-icon" style="margin-bottom: 1rem; color: #475569;">
          <i data-lucide="puzzle" style="width: 3rem; height: 3rem;"></i>
        </div>
        <h3 style="color: white;">No Integrations</h3>
        <p style="color: #94A3B8; margin-bottom: 1.5rem;">Get started by adding your first integration to connect with third-party services.</p>
        <% if @current_admin.editor? || @current_admin.super_admin? %>
          <%= link_to new_admin_integration_path, class: "admin-btn admin-btn-primary" do %>
            <i data-lucide="plus"></i>
            <span>Add Integration</span>
          <% end %>
        <% end %>
      </div>
    <% end %>
  </div>
</div>

<script>
  document.addEventListener('turbo:load', () => {
    if (typeof lucide !== 'undefined') {
      lucide.createIcons();
    }
  });

  document.addEventListener('DOMContentLoaded', () => {
    if (typeof lucide !== 'undefined') {
      lucide.createIcons();
    }
  });
</script>
