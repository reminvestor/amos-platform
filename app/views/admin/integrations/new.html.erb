<script src="https://unpkg.com/lucide@latest"></script>

<div class="admin-content" style="padding: 2rem;">
  <div class="container-fluid">
    <%# Page Header %>
    <div class="admin-page-header" style="margin-bottom: 2rem;">
      <div class="header-left">
        <div class="header-icon" style="background: linear-gradient(135deg, #22D3EE 0%, #06B6D4 100%);">
          <i data-lucide="plus"></i>
        </div>
        <div class="header-text">
          <h1>New Integration</h1>
          <p>Add a new integration to the platform</p>
        </div>
      </div>
    </div>

    <div class="row">
      <%# Main Form Column %>
      <div class="col-lg-8">
        <div class="admin-card">
          <%= form_with(model: [:admin, @integration], local: true) do |f| %>
            <%# Error Messages %>
            <% if @integration.errors.any? %>
              <div class="alert alert-danger" style="background-color: var(--status-error-bg); border-color: var(--status-error-border); color: var(--status-error-text); margin-bottom: 1.5rem;">
                <h5 style="margin-bottom: 0.5rem;">
                  <i data-lucide="alert-circle" style="width: 1rem; height: 1rem; display: inline; vertical-align: middle;"></i>
                  Errors:
                </h5>
                <ul style="margin-bottom: 0;">
                  <% @integration.errors.full_messages.each do |msg| %>
                    <li><%= msg %></li>
                  <% end %>
                </ul>
              </div>
            <% end %>

            <%# Name Field %>
            <div style="margin-bottom: 1.5rem;">
              <%= f.label :name, "Integration Name", style: "display: block; color: white; font-weight: 600; margin-bottom: 0.5rem;" %>
              <%= f.text_field :name, class: "form-control", placeholder: "e.g., Google Sheets",
                  style: "background-color: var(--bg-input); border: 1px solid var(--border-primary); color: var(--text-primary); padding: 0.75rem; border-radius: 0.5rem;" %>
            </div>

            <%# Slug Field %>
            <div style="margin-bottom: 1.5rem;">
              <%= f.label :slug, "Slug", style: "display: block; color: white; font-weight: 600; margin-bottom: 0.5rem;" %>
              <%= f.text_field :slug, class: "form-control", placeholder: "e.g., google_sheets",
                  style: "background-color: var(--bg-input); border: 1px solid var(--border-primary); color: var(--text-primary); padding: 0.75rem; border-radius: 0.5rem;" %>
              <small style="color: var(--text-muted); font-size: 0.875rem; display: block; margin-top: 0.25rem;">
                URL-friendly identifier (lowercase, underscores)
              </small>
            </div>

            <%# Description Field %>
            <div style="margin-bottom: 1.5rem;">
              <%= f.label :description, "Description", style: "display: block; color: white; font-weight: 600; margin-bottom: 0.5rem;" %>
              <%= f.text_area :description, rows: 3, class: "form-control", placeholder: "Brief description of the integration",
                  style: "background-color: var(--bg-input); border: 1px solid var(--border-primary); color: var(--text-primary); padding: 0.75rem; border-radius: 0.5rem;" %>
            </div>

            <%# Category Field %>
            <div style="margin-bottom: 1.5rem;">
              <%= f.label :category, "Category", style: "display: block; color: white; font-weight: 600; margin-bottom: 0.5rem;" %>
              <%= f.select :category,
                  options_for_select(['payment', 'ecommerce', 'crm', 'communication', 'productivity', 'marketing', 'analytics', 'custom']),
                  { prompt: "Select a category" }, class: "form-select",
                  style: "background-color: var(--bg-input); border: 1px solid var(--border-primary); color: var(--text-primary); padding: 0.75rem; border-radius: 0.5rem;" %>
            </div>

            <%# Auth Type Field %>
            <div style="margin-bottom: 1.5rem;">
              <%= f.label :auth_type, "Authentication Type", style: "display: block; color: white; font-weight: 600; margin-bottom: 0.5rem;" %>
              <%= f.select :auth_type,
                  options_for_select(Integration.auth_types.keys.map { |k| [k.humanize, k] }),
                  { prompt: "Select auth type" }, class: "form-select",
                  style: "background-color: var(--bg-input); border: 1px solid var(--border-primary); color: var(--text-primary); padding: 0.75rem; border-radius: 0.5rem;" %>
              <div style="margin-top: 0.5rem; padding: 0.75rem; background-color: rgba(34, 211, 238, 0.05); border: 1px solid rgba(34, 211, 238, 0.1); border-radius: 0.5rem;">
                <small style="color: var(--text-secondary); line-height: 1.6;">
                  <strong style="color: white;">Auth Types:</strong><br>
                  • <strong>API Key</strong> - Simple API key authentication<br>
                  • <strong>Bearer Token</strong> - Token-based authentication<br>
                  • <strong>Basic Auth</strong> - Username/password (like Stripe)<br>
                  • <strong>OAuth2</strong> - OAuth 2.0 (configure after creation)<br>
                  • <strong>Custom</strong> - Special authentication methods
                </small>
              </div>
            </div>

            <%# API Base URL Field %>
            <div style="margin-bottom: 1.5rem;">
              <%= f.label :api_base_url, "API Base URL", style: "display: block; color: white; font-weight: 600; margin-bottom: 0.5rem;" %>
              <%= f.text_field :api_base_url, class: "form-control", placeholder: "https://api.example.com/v1",
                  style: "background-color: var(--bg-input); border: 1px solid var(--border-primary); color: var(--text-primary); padding: 0.75rem; border-radius: 0.5rem;" %>
            </div>

            <%# Documentation URL Field %>
            <div style="margin-bottom: 1.5rem;">
              <%= f.label :documentation_url, "Documentation URL (optional)", style: "display: block; color: white; font-weight: 600; margin-bottom: 0.5rem;" %>
              <%= f.text_field :documentation_url, class: "form-control", placeholder: "https://developer.example.com/docs",
                  style: "background-color: var(--bg-input); border: 1px solid var(--border-primary); color: var(--text-primary); padding: 0.75rem; border-radius: 0.5rem;" %>
            </div>

            <%# Icon URL Field %>
            <div style="margin-bottom: 1.5rem;">
              <%= f.label :icon_url, "Icon URL (optional)", style: "display: block; color: white; font-weight: 600; margin-bottom: 0.5rem;" %>
              <%= f.text_field :icon_url, class: "form-control", placeholder: "https://example.com/icon.png",
                  style: "background-color: var(--bg-input); border: 1px solid var(--border-primary); color: var(--text-primary); padding: 0.75rem; border-radius: 0.5rem;" %>
            </div>

            <%# Checkboxes %>
            <div style="margin-bottom: 1rem;">
              <div class="form-check">
                <%= f.check_box :is_active, checked: true, style: "margin-right: 0.5rem;" %>
                <%= f.label :is_active, "Active", style: "color: white;" %>
              </div>
            </div>

            <div style="margin-bottom: 1.5rem;">
              <div class="form-check">
                <%= f.check_box :is_verified, style: "margin-right: 0.5rem;" %>
                <%= f.label :is_verified, "Verified", style: "color: white;" %>
                <small style="color: var(--text-muted); font-size: 0.875rem; display: block; margin-top: 0.25rem; margin-left: 1.5rem;">
                  Mark as verified/official integration
                </small>
              </div>
            </div>

            <%# Action Buttons %>
            <div style="display: flex; gap: 0.75rem; padding-top: 1rem; border-top: 1px solid var(--border-primary);">
              <%= f.submit "Create Integration", class: "admin-btn admin-btn-primary" %>
              <%= link_to admin_integrations_path, class: "admin-btn admin-btn-outline" do %>
                <i data-lucide="x"></i>
                <span>Cancel</span>
              <% end %>
            </div>
          <% end %>
        </div>

        <%# Next Steps Alert %>
        <div style="margin-top: 1.5rem; padding: 1rem; background-color: rgba(34, 211, 238, 0.1); border: 1px solid rgba(34, 211, 238, 0.2); border-radius: 0.5rem;">
          <div style="display: flex; align-items-start; gap: 0.75rem;">
            <i data-lucide="info" style="width: 1.25rem; height: 1.25rem; color: #22D3EE; flex-shrink: 0; margin-top: 0.125rem;"></i>
            <div>
              <strong style="color: white;">Next Steps:</strong>
              <span style="color: var(--text-secondary);"> After creating the integration, configure authentication details by clicking "Auth Config" button.</span>
            </div>
          </div>
        </div>
      </div>

      <%# Tips Sidebar %>
      <div class="col-lg-4">
        <div class="admin-card">
          <h5 style="color: white; font-weight: 600; margin-bottom: 1.5rem; display: flex; align-items: center; gap: 0.5rem;">
            <i data-lucide="lightbulb" style="width: 1.25rem; height: 1.25rem; color: #FACC15;"></i>
            <span>Tips</span>
          </h5>

          <div style="margin-bottom: 1.5rem;">
            <p style="color: white; font-weight: 600; margin-bottom: 0.5rem;">Slug Requirements:</p>
            <ul style="color: var(--text-secondary); font-size: 0.875rem; line-height: 1.8; padding-left: 1.25rem;">
              <li>Lowercase letters and underscores only</li>
              <li>Must be unique</li>
              <li>Used in URLs and callbacks</li>
            </ul>
          </div>

          <div style="margin-bottom: 1.5rem;">
            <p style="color: white; font-weight: 600; margin-bottom: 0.5rem;">OAuth Integrations:</p>
            <p style="color: var(--text-secondary); font-size: 0.875rem; line-height: 1.6;">
              After creating an OAuth2 integration, click "Auth Config" to set up client ID, client secret, and redirect URIs.
            </p>
          </div>

          <div>
            <p style="color: white; font-weight: 600; margin-bottom: 0.5rem;">Need Help?</p>
            <p style="color: var(--text-secondary); font-size: 0.875rem; line-height: 1.6;">
              Check <code style="background-color: rgba(34, 211, 238, 0.1); padding: 0.125rem 0.375rem; border-radius: 0.25rem; color: #22D3EE;">docs/ADDING_INTEGRATIONS.md</code> for detailed instructions.
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  document.addEventListener('turbo:load', () => {
    if (typeof lucide !== 'undefined') {
      lucide.createIcons();
    }
  });

  document.addEventListener('DOMContentLoaded', () => {
    if (typeof lucide !== 'undefined') {
      lucide.createIcons();
    }
  });
</script>
