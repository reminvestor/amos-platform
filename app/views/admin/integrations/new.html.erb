
<div class="admin-content admin-p-xl">
  <div class="container-fluid">
    <%# Page Header %>
    <div class="admin-page-header admin-mb-xl">
      <div class="header-left">
        <div class="header-icon admin-icon-gradient-cyan">
          <%= admin_icon('plus', size: :lg) %>
        </div>
        <div class="header-text">
          <h1>New Integration</h1>
          <p>Add a new integration to the platform</p>
        </div>
      </div>
    </div>

    <div class="row">
      <%# Main Form Column %>
      <div class="col-lg-8">
        <div class="admin-card">
          <%= form_with(model: [:admin, @integration], local: true) do |f| %>
            <%# Error Messages %>
            <% if @integration.errors.any? %>
              <div class="admin-alert admin-alert-error">
                <h5>
                  <%= admin_icon('alert-circle', size: :md) %>
                  Errors:
                </h5>
                <ul>
                  <% @integration.errors.full_messages.each do |msg| %>
                    <li><%= msg %></li>
                  <% end %>
                </ul>
              </div>
            <% end %>

            <%# Name Field %>
            <div class="form-group">
              <%= f.label :name, "Integration Name", class: "form-label" %>
              <%= f.text_field :name, class: "form-control", placeholder: "e.g., Google Sheets",
                  style: "background-color: var(--bg-input); border: 1px solid var(--border-primary); color: var(--text-primary); padding: 0.75rem; border-radius: 0.5rem;" %>
            </div>

            <%# Slug Field %>
            <div class="form-group">
              <%= f.label :slug, "Slug", class: "form-label" %>
              <%= f.text_field :slug, class: "form-control", placeholder: "e.g., google_sheets",
                  style: "background-color: var(--bg-input); border: 1px solid var(--border-primary); color: var(--text-primary); padding: 0.75rem; border-radius: 0.5rem;" %>
              <small class="form-helper-text">
                URL-friendly identifier (lowercase, underscores)
              </small>
            </div>

            <%# Description Field %>
            <div class="form-group">
              <%= f.label :description, "Description", class: "form-label" %>
              <%= f.text_area :description, rows: 3, class: "form-control", placeholder: "Brief description of the integration",
                  style: "background-color: var(--bg-input); border: 1px solid var(--border-primary); color: var(--text-primary); padding: 0.75rem; border-radius: 0.5rem;" %>
            </div>

            <%# Category Field %>
            <div class="form-group">
              <%= f.label :category, "Category", class: "form-label" %>
              <%= f.select :category,
                  options_for_select(['payment', 'ecommerce', 'crm', 'communication', 'productivity', 'marketing', 'analytics', 'custom']),
                  { prompt: "Select a category" }, class: "form-select",
                  style: "background-color: var(--bg-input); border: 1px solid var(--border-primary); color: var(--text-primary); padding: 0.75rem; border-radius: 0.5rem;" %>
            </div>

            <%# Auth Type Field %>
            <div class="form-group">
              <%= f.label :auth_type, "Authentication Type", class: "form-label" %>
              <%= f.select :auth_type,
                  options_for_select(Integration.auth_types.keys.map { |k| [k.humanize, k] }),
                  { prompt: "Select auth type" }, class: "form-select",
                  style: "background-color: var(--bg-input); border: 1px solid var(--border-primary); color: var(--text-primary); padding: 0.75rem; border-radius: 0.5rem;" %>
              <div class="admin-info-box admin-mt-sm">
                <small class="admin-text-secondary admin-leading-relaxed">
                  <strong class="admin-text-primary">Auth Types:</strong><br>
                  • <strong>API Key</strong> - Simple API key authentication<br>
                  • <strong>Bearer Token</strong> - Token-based authentication<br>
                  • <strong>Basic Auth</strong> - Username/password (like Stripe)<br>
                  • <strong>OAuth2</strong> - OAuth 2.0 (configure after creation)<br>
                  • <strong>Custom</strong> - Special authentication methods
                </small>
              </div>
            </div>

            <%# API Base URL Field %>
            <div class="form-group">
              <%= f.label :api_base_url, "API Base URL", class: "form-label" %>
              <%= f.text_field :api_base_url, class: "form-control", placeholder: "https://api.example.com/v1",
                  style: "background-color: var(--bg-input); border: 1px solid var(--border-primary); color: var(--text-primary); padding: 0.75rem; border-radius: 0.5rem;" %>
            </div>

            <%# Documentation URL Field %>
            <div class="form-group">
              <%= f.label :documentation_url, "Documentation URL (optional)", class: "form-label" %>
              <%= f.text_field :documentation_url, class: "form-control", placeholder: "https://developer.example.com/docs",
                  style: "background-color: var(--bg-input); border: 1px solid var(--border-primary); color: var(--text-primary); padding: 0.75rem; border-radius: 0.5rem;" %>
            </div>

            <%# Icon URL Field %>
            <div class="form-group">
              <%= f.label :icon_url, "Icon URL (optional)", class: "form-label" %>
              <%= f.text_field :icon_url, class: "form-control", placeholder: "https://example.com/icon.png",
                  style: "background-color: var(--bg-input); border: 1px solid var(--border-primary); color: var(--text-primary); padding: 0.75rem; border-radius: 0.5rem;" %>
            </div>

            <%# Checkboxes %>
            <div class="admin-mb-md">
              <div class="form-check">
                <%= f.check_box :is_active, checked: true, class: "admin-mr-sm" %>
                <%= f.label :is_active, "Active", class: "admin-text-primary" %>
              </div>
            </div>

            <div class="form-group">
              <div class="form-check">
                <%= f.check_box :is_verified, class: "admin-mr-sm" %>
                <%= f.label :is_verified, "Verified", class: "admin-text-primary" %>
                <small class="form-helper-text" style="margin-left: 1.5rem;">
                  Mark as verified/official integration
                </small>
              </div>
            </div>

            <%# Action Buttons %>
            <div class="admin-flex-gap-md admin-section-divider">
              <%= f.submit "Create Integration", class: "admin-btn admin-btn-primary" %>
              <%= link_to admin_integrations_path, class: "admin-btn admin-btn-outline" do %>
                <%= admin_icon('x', size: :sm) %>
                <span>Cancel</span>
              <% end %>
            </div>
          <% end %>
        </div>

        <%# Next Steps Alert %>
        <div class="admin-info-box admin-mt-lg">
          <div class="admin-flex admin-items-start admin-flex-gap-md">
            <%= admin_icon('info', size: :md, class: 'admin-text-info admin-flex-none admin-mt-xs') %>
            <div>
              <strong class="admin-text-primary">Next Steps:</strong>
              <span class="admin-text-secondary"> After creating the integration, configure authentication details by clicking "Auth Config" button.</span>
            </div>
          </div>
        </div>
      </div>

      <%# Tips Sidebar %>
      <div class="col-lg-4">
        <div class="admin-card">
          <h5 class="admin-section-heading admin-mb-lg">
            <%= admin_icon('lightbulb', size: :md, class: 'admin-text-warning') %>
            <span>Tips</span>
          </h5>

          <div class="form-group">
            <p class="admin-text-primary admin-font-semibold admin-mb-sm">Slug Requirements:</p>
            <ul class="admin-text-secondary admin-text-sm admin-leading-relaxed" style="padding-left: 1.25rem;">
              <li>Lowercase letters and underscores only</li>
              <li>Must be unique</li>
              <li>Used in URLs and callbacks</li>
            </ul>
          </div>

          <div class="form-group">
            <p class="admin-text-primary admin-font-semibold admin-mb-sm">OAuth Integrations:</p>
            <p class="admin-text-secondary admin-text-sm admin-leading-relaxed">
              After creating an OAuth2 integration, click "Auth Config" to set up client ID, client secret, and redirect URIs.
            </p>
          </div>

          <div>
            <p class="admin-text-primary admin-font-semibold admin-mb-sm">Need Help?</p>
            <p class="admin-text-secondary admin-text-sm admin-leading-relaxed">
              Check <code class="admin-code-inline">docs/ADDING_INTEGRATIONS.md</code> for detailed instructions.
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  document.addEventListener('turbo:load', () => {
    if (typeof lucide !== 'undefined') {
      lucide.createIcons();
    }
  });

  document.addEventListener('DOMContentLoaded', () => {
    if (typeof lucide !== 'undefined') {
      lucide.createIcons();
    }
  });
</script>



