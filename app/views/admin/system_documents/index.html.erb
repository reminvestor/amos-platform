<div class="admin-p-xl">
  <!-- Page Header -->
  <div class="admin-page-header admin-mb-xl">
    <div class="header-left">
      <div class="header-icon admin-icon-gradient-purple">
        <i data-lucide="database" class="admin-text-primary"></i>
      </div>
      <div class="header-text">
        <h1>System Document Library</h1>
        <p>Manage knowledge base documents available to all entities via Scout</p>
      </div>
    </div>

    <div class="header-actions">
      <%= link_to new_admin_system_document_path, class: "admin-btn admin-btn-primary" do %>
        <i data-lucide="upload"></i>
        <span>Upload Document</span>
      <% end %>
    </div>
  </div>

  <!-- Summary Stats -->
  <div class="admin-stats-grid admin-mb-xl">
    <div class="admin-card">
      <div class="admin-flex admin-items-center admin-flex-gap-md">
        <div class="admin-stat-icon purple-gradient">
          <i data-lucide="files" class="admin-icon-lg admin-text-primary"></i>
        </div>
        <div>
          <p class="admin-stat-label">Total Documents</p>
          <h3 class="admin-stat-value"><%= @total_documents %></h3>
        </div>
      </div>
    </div>

    <div class="admin-card">
      <div class="admin-flex admin-items-center admin-flex-gap-md">
        <div class="admin-stat-icon info">
          <i data-lucide="hard-drive" class="admin-icon-lg admin-text-info"></i>
        </div>
        <div>
          <p class="admin-stat-label">Storage Used</p>
          <h3 class="admin-stat-value"><%= number_to_human_size(@total_storage) %></h3>
        </div>
      </div>
    </div>

    <div class="admin-card">
      <div class="admin-flex admin-items-center admin-flex-gap-md">
        <div class="admin-stat-icon success">
          <i data-lucide="check-circle" class="admin-icon-lg admin-text-success"></i>
        </div>
        <div>
          <p class="admin-stat-label">Indexed</p>
          <h3 class="admin-stat-value"><%= @indexed_count %></h3>
        </div>
      </div>
    </div>

    <div class="admin-card">
      <div class="admin-flex admin-items-center admin-flex-gap-md">
        <div class="admin-stat-icon warning">
          <i data-lucide="loader" class="admin-icon-lg admin-text-warning"></i>
        </div>
        <div>
          <p class="admin-stat-label">Processing</p>
          <h3 class="admin-stat-value"><%= @pending_count %></h3>
        </div>
      </div>
    </div>

    <div class="admin-card">
      <div class="admin-flex admin-items-center admin-flex-gap-md">
        <div class="admin-stat-icon error">
          <i data-lucide="alert-circle" class="admin-icon-lg admin-text-error"></i>
        </div>
        <div>
          <p class="admin-stat-label">Failed</p>
          <h3 class="admin-stat-value"><%= @failed_count %></h3>
        </div>
      </div>
    </div>
  </div>

  <div class="admin-content-grid">
    <!-- Categories Sidebar -->
    <div class="admin-card" style="grid-column: span 1;">
      <h3 class="card-title m-0 admin-mb-lg">
        <i data-lucide="folder" class="admin-icon-md d-inline-block align-middle me-2"></i>
        Categories
      </h3>
      <div class="admin-detail-list">
        <%= link_to admin_system_documents_path, class: "detail-item admin-p-sm admin-rounded-md #{'admin-bg-darker' if params[:category].blank?}" do %>
          <div class="admin-flex admin-items-center admin-flex-gap-sm">
            <i data-lucide="list" class="admin-icon-sm"></i>
            <span class="admin-text-primary">All Documents</span>
          </div>
          <span class="admin-badge admin-badge-secondary"><%= @total_documents %></span>
        <% end %>

        <% @categories.group_by { |(cat, subcat), count| cat }.each do |category, subcategories| %>
          <% total_count = subcategories.sum { |(cat, subcat), count| count } %>

          <%= link_to admin_system_documents_path(category: category),
              class: "detail-item admin-p-sm admin-rounded-md #{'admin-bg-darker' if params[:category] == category && params[:subcategory].blank?}" do %>
            <div class="admin-flex admin-items-center admin-flex-gap-sm">
              <i data-lucide="folder-open" class="admin-icon-sm"></i>
              <span class="admin-text-primary"><%= category.titleize %></span>
            </div>
            <span class="admin-badge admin-badge-secondary"><%= total_count %></span>
          <% end %>

          <% subcategories.each do |(cat, subcat), count| %>
            <% next if subcat.blank? %>
            <%= link_to admin_system_documents_path(category: category, subcategory: subcat),
                class: "detail-item admin-p-sm admin-rounded-md admin-ml-md #{'admin-bg-darker' if params[:subcategory] == subcat}" do %>
              <div class="admin-flex admin-items-center admin-flex-gap-sm">
                <i data-lucide="folder" class="admin-icon-sm admin-text-muted"></i>
                <span class="admin-text-secondary admin-text-sm"><%= subcat.titleize %></span>
              </div>
              <span class="admin-badge admin-badge-secondary"><%= count %></span>
            <% end %>
          <% end %>
        <% end %>
      </div>
    </div>

    <!-- Documents List -->
    <div style="grid-column: span 2;">
      <% if @documents.any? %>
        <% @documents.each do |doc| %>
          <div class="admin-card admin-mb-md">
            <div class="admin-flex-between admin-items-start">
              <div class="admin-flex-1">
                <h5 class="admin-text-primary admin-mb-sm admin-font-semibold">
                  <%= icon_for_content_type(doc.content_type) %>
                  <%= doc.original_filename %>
                </h5>

                <p class="admin-text-muted admin-mb-sm admin-text-sm">
                  <i data-lucide="folder" class="admin-icon-xs"></i> <%= doc.category.titleize %>
                  <% if doc.subcategory.present? %>
                    → <%= doc.subcategory.titleize %>
                  <% end %>
                  <span class="mx-2">•</span>
                  <i data-lucide="hard-drive" class="admin-icon-xs"></i> <%= doc.human_file_size %>
                  <span class="mx-2">•</span>
                  <i data-lucide="clock" class="admin-icon-xs"></i> <%= time_ago_in_words(doc.created_at) %> ago
                  <span class="mx-2">•</span>
                  <i data-lucide="user" class="admin-icon-xs"></i> <%= doc.uploaded_by.email %>
                </p>

                <% if doc.description.present? %>
                  <p class="admin-text-secondary admin-mb-sm admin-text-sm"><%= doc.description %></p>
                <% end %>

                <div class="admin-flex admin-flex-gap-sm admin-flex-wrap">
                  <%= status_badge_for_system_document(doc) %>

                  <% if doc.status_indexed? %>
                    <span class="admin-badge admin-badge-info">
                      <i data-lucide="box" class="admin-icon-xs"></i> <%= doc.chunk_count %> chunks
                    </span>
                    <span class="admin-badge admin-badge-secondary">
                      <i data-lucide="check-circle" class="admin-icon-xs"></i> Indexed <%= time_ago_in_words(doc.indexed_at) %> ago
                    </span>
                  <% elsif doc.status_failed? %>
                    <div class="admin-mt-sm admin-p-sm admin-rounded-md" style="background: var(--status-error-bg); color: var(--status-error-text);">
                      <i data-lucide="alert-triangle" class="admin-icon-xs"></i> <%= doc.error_message %>
                    </div>
                  <% end %>
                </div>
              </div>

              <div class="admin-flex admin-flex-col admin-flex-gap-xs admin-ml-lg">
                <%= link_to admin_system_document_path(doc), class: "admin-btn admin-btn-sm admin-btn-outline" do %>
                  <i data-lucide="eye" class="admin-icon-sm"></i> View
                <% end %>

                <%= link_to download_admin_system_document_path(doc), class: "admin-btn admin-btn-sm admin-btn-outline" do %>
                  <i data-lucide="download" class="admin-icon-sm"></i> Download
                <% end %>

                <%= button_to reindex_admin_system_document_path(doc), method: :post, class: "admin-btn admin-btn-sm admin-btn-info-outline" do %>
                  <i data-lucide="refresh-cw" class="admin-icon-sm"></i> Re-index
                <% end %>

                <%= button_to admin_system_document_path(doc), method: :delete,
                    class: "admin-btn admin-btn-sm admin-btn-danger-outline",
                    data: { confirm: "Are you sure you want to delete this document? This will also remove it from RAG storage." } do %>
                  <i data-lucide="trash" class="admin-icon-sm"></i> Delete
                <% end %>
              </div>
            </div>
          </div>
        <% end %>

        <div class="admin-pagination">
          <%== pagy_nav(@pagy) if defined?(@pagy) %>
        </div>
      <% else %>
        <div class="admin-card">
          <div class="admin-empty-state admin-p-xl">
            <div class="empty-icon admin-mb-md">
              <i data-lucide="inbox" class="admin-icon-3x admin-text-muted"></i>
            </div>
            <h5 class="admin-text-primary">No documents found</h5>
            <p class="admin-text-secondary">Upload your first system document to get started</p>
            <%= link_to new_admin_system_document_path, class: "admin-btn admin-btn-primary admin-mt-md" do %>
              <i data-lucide="upload"></i> Upload Document
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>

<script>
  document.addEventListener('turbo:load', () => {
    if (typeof lucide !== 'undefined') {
      lucide.createIcons();
    }
  });
</script>
