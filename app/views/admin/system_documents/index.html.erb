<div class="container-fluid mt-4">
  <!-- Header -->
  <div class="d-flex justify-content-between align-items-center mb-4">
    <div>
      <h1><i data-lucide="database"></i> System Document Library</h1>
      <p class="text-muted mb-0">Manage knowledge base documents available to all entities via Scout</p>
    </div>
    <%= link_to new_admin_system_document_path, class: "btn btn-primary" do %>
      <i data-lucide="upload"></i> Upload Document
    <% end %>
  </div>

  <!-- Summary Stats -->
  <div class="row mb-4">
    <div class="col-md-3">
      <div class="card">
        <div class="card-body">
          <h6 class="text-muted">Total Documents</h6>
          <h3 class="mb-0"><%= @total_documents %></h3>
        </div>
      </div>
    </div>
    <div class="col-md-3">
      <div class="card">
        <div class="card-body">
          <h6 class="text-muted">Storage Used</h6>
          <h3 class="mb-0"><%= number_to_human_size(@total_storage) %></h3>
        </div>
      </div>
    </div>
    <div class="col-md-2">
      <div class="card border-success">
        <div class="card-body">
          <h6 class="text-muted">Indexed</h6>
          <h3 class="mb-0 text-success"><%= @indexed_count %></h3>
        </div>
      </div>
    </div>
    <div class="col-md-2">
      <div class="card border-warning">
        <div class="card-body">
          <h6 class="text-muted">Processing</h6>
          <h3 class="mb-0 text-warning"><%= @pending_count %></h3>
        </div>
      </div>
    </div>
    <div class="col-md-2">
      <div class="card border-danger">
        <div class="card-body">
          <h6 class="text-muted">Failed</h6>
          <h3 class="mb-0 text-danger"><%= @failed_count %></h3>
        </div>
      </div>
    </div>
  </div>

  <div class="row">
    <!-- Categories Sidebar -->
    <div class="col-md-3">
      <div class="card">
        <div class="card-header">
          <i data-lucide="folder"></i> Categories
        </div>
        <div class="list-group list-group-flush">
          <%= link_to admin_system_documents_path, class: "list-group-item list-group-item-action #{'active' if params[:category].blank?}" do %>
            <i class="fas fa-list"></i> All Documents
            <span class="badge bg-secondary float-end"><%= @total_documents %></span>
          <% end %>

          <% @categories.group_by { |(cat, subcat), count| cat }.each do |category, subcategories| %>
            <% total_count = subcategories.sum { |(cat, subcat), count| count } %>

            <%= link_to admin_system_documents_path(category: category),
                class: "list-group-item list-group-item-action #{'active' if params[:category] == category && params[:subcategory].blank?}" do %>
              <i data-lucide="folder-open"></i> <%= category.titleize %>
              <span class="badge bg-secondary float-end"><%= total_count %></span>
            <% end %>

            <% subcategories.each do |(cat, subcat), count| %>
              <% next if subcat.blank? %>
              <%= link_to admin_system_documents_path(category: category, subcategory: subcat),
                  class: "list-group-item list-group-item-action ps-4 #{'active' if params[:subcategory] == subcat}",
                  style: "font-size: 0.9em;" do %>
                <i data-lucide="folder"></i> <%= subcat.titleize %>
                <span class="badge bg-secondary float-end"><%= count %></span>
              <% end %>
            <% end %>
          <% end %>
        </div>
      </div>
    </div>

    <!-- Documents List -->
    <div class="col-md-9">
      <% if @documents.any? %>
        <% @documents.each do |doc| %>
          <div class="card mb-3">
            <div class="card-body">
              <div class="d-flex justify-content-between align-items-start">
                <div class="flex-grow-1">
                  <h5 class="card-title mb-2">
                    <%= icon_for_content_type(doc.content_type) %>
                    <%= doc.original_filename %>
                  </h5>

                  <p class="text-muted mb-2" style="font-size: 0.9em;">
                    <i data-lucide="folder"></i> <%= doc.category.titleize %>
                    <% if doc.subcategory.present? %>
                      → <%= doc.subcategory.titleize %>
                    <% end %>
                    <span class="mx-2">•</span>
                    <i data-lucide="hard-drive"></i> <%= doc.human_file_size %>
                    <span class="mx-2">•</span>
                    <i data-lucide="clock"></i> <%= time_ago_in_words(doc.created_at) %> ago
                    <span class="mx-2">•</span>
                    <i class="fas fa-user"></i> <%= doc.uploaded_by.email %>
                  </p>

                  <% if doc.description.present? %>
                    <p class="mb-2" style="font-size: 0.9em;"><%= doc.description %></p>
                  <% end %>

                  <div class="mb-2">
                    <%= status_badge_for_system_document(doc) %>

                    <% if doc.status_indexed? %>
                      <span class="badge bg-info">
                        <i data-lucide="box"></i> <%= doc.chunk_count %> chunks
                      </span>
                      <span class="badge bg-secondary">
                        <i data-lucide="check-circle"></i> Indexed <%= time_ago_in_words(doc.indexed_at) %> ago
                      </span>
                    <% elsif doc.status_failed? %>
                      <div class="alert alert-danger mt-2 mb-0 py-2" style="font-size: 0.85em;">
                        <i data-lucide="alert-triangle"></i> <%= doc.error_message %>
                      </div>
                    <% end %>
                  </div>
                </div>

                <div class="btn-group-vertical ms-3" role="group">
                  <%= link_to admin_system_document_path(doc), class: "btn btn-sm btn-outline-primary" do %>
                    <i data-lucide="eye"></i> View
                  <% end %>

                  <%= link_to download_admin_system_document_path(doc), class: "btn btn-sm btn-outline-secondary" do %>
                    <i data-lucide="download"></i> Download
                  <% end %>

                  <%= button_to reindex_admin_system_document_path(doc), method: :post, class: "btn btn-sm btn-outline-info" do %>
                    <i class="fas fa-sync"></i> Re-index
                  <% end %>

                  <%= button_to admin_system_document_path(doc), method: :delete,
                      class: "btn btn-sm btn-outline-danger",
                      data: { confirm: "Are you sure you want to delete this document? This will also remove it from RAG storage." } do %>
                    <i data-lucide="trash"></i> Delete
                  <% end %>
                </div>
              </div>
            </div>
          </div>
        <% end %>

        <div class="d-flex justify-content-center mt-4">
          <%== pagy_nav(@pagy) if defined?(@pagy) %>
        </div>
      <% else %>
        <div class="card">
          <div class="card-body text-center py-5">
            <i data-lucide="inbox" class="icon-3x text-muted mb-3"></i>
            <h5>No documents found</h5>
            <p class="text-muted">Upload your first system document to get started</p>
            <%= link_to new_admin_system_document_path, class: "btn btn-primary mt-2" do %>
              <i data-lucide="upload"></i> Upload Document
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>

<% content_for :head do %>
<style>
  .list-group-item.active {
    background-color: #667eea;
    border-color: #667eea;
  }
</style>
<% end %>
