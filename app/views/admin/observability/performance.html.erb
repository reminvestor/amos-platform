<div class="admin-p-xl">
  <!-- Page Header -->
  <div class="admin-page-header">
    <div class="header-left">
      <div class="header-icon admin-stat-icon info">
        <i data-lucide="gauge"></i>
      </div>
      <div class="header-text">
        <h1>Performance Monitoring</h1>
        <p>Track system performance and response times</p>
      </div>
    </div>

    <div class="header-actions">
      <div class="d-flex admin-flex-gap-sm">
        <%= link_to admin_observability_performance_path(time_range: 1), class: "admin-btn admin-btn-sm #{params[:time_range] == '1' ? 'admin-btn-primary' : 'admin-btn-outline'}" do %>
          <span>24h</span>
        <% end %>
        <%= link_to admin_observability_performance_path(time_range: 7), class: "admin-btn admin-btn-sm #{params[:time_range].nil? || params[:time_range] == '7' ? 'admin-btn-primary' : 'admin-btn-outline'}" do %>
          <span>7d</span>
        <% end %>
        <%= link_to admin_observability_performance_path(time_range: 30), class: "admin-btn admin-btn-sm #{params[:time_range] == '30' ? 'admin-btn-primary' : 'admin-btn-outline'}" do %>
          <span>30d</span>
        <% end %>
      </div>
    </div>
  </div>

  <!-- Performance Metrics -->
  <div class="admin-stats-grid">
    <%= render 'admin/shared/stat_card', icon: 'list-checks', label: 'Total Workflows', value: number_with_delimiter(@total_workflows), style: 'purple-gradient', aria_label: 'Total workflows count' %>
    <%= render 'admin/shared/stat_card', icon: 'check-circle', label: 'Success Rate', value: "#{@success_rate}%", style: (@success_rate >= 95 ? 'success' : 'warning'), aria_label: 'Workflow success rate percentage' %>
    <%= render 'admin/shared/stat_card', icon: 'workflow', label: 'Avg Workflow', value: "#{@avg_workflow_duration}ms", style: 'info', aria_label: 'Average workflow duration' %>
    <%= render 'admin/shared/stat_card', icon: 'git-branch', label: 'Avg Phase', value: "#{@avg_phase_duration}ms", style: 'info', aria_label: 'Average phase duration' %>
    <%= render 'admin/shared/stat_card', icon: 'tool', label: 'Avg Tool', value: "#{@avg_tool_duration}ms", style: 'info', aria_label: 'Average tool call duration' %>
  </div>

  <!-- Charts Row -->
  <div class="admin-content-grid">
    <!-- Performance Trend Chart -->
    <% if @performance_chart && @performance_chart[:datasets]&.any? %>
      <div class="admin-card" data-turbo-cache="false">
        <h3 class="card-title m-0">
          <i data-lucide="trending-up" class="admin-icon-md d-inline-block align-middle me-2" aria-hidden="true"></i>
          Performance Trend
        </h3>
        <div class="admin-chart-container">
          <canvas id="performanceTrendChart"></canvas>
        </div>
      </div>
    <% end %>

    <!-- Error Rate Chart -->
    <% if @error_rate_chart && @error_rate_chart[:datasets]&.any? %>
      <div class="admin-card" data-turbo-cache="false">
        <h3 class="card-title m-0">
          <i data-lucide="alert-circle" class="admin-icon-md d-inline-block align-middle me-2" aria-hidden="true"></i>
          Error Rate
        </h3>
        <div class="admin-chart-container">
          <canvas id="errorRateChart"></canvas>
        </div>
      </div>
    <% end %>
  </div>

  <!-- Slowest Operations -->
  <div class="admin-content-grid">
    <!-- Slowest Workflows -->
    <div class="admin-card">
      <h3 class="card-title m-0 admin-mb-lg">
        <i data-lucide="clock" class="admin-icon-md d-inline-block align-middle me-2" aria-hidden="true"></i>
        Slowest Workflows
      </h3>

      <% if @slowest_workflows.any? %>
        <div class="admin-detail-list">
          <% @slowest_workflows.each do |workflow| %>
            <div class="detail-item">
              <div>
                <code class="admin-badge admin-badge-cyan admin-text-xs me-2">#<%= workflow.id %></code>
                <span class="text-white"><%= workflow.entity&.name || "N/A" %></span>
                <div class="admin-text-muted admin-text-sm mt-1"><%= workflow.workflow_template_id || "Ad-hoc" %></div>
              </div>
              <% if workflow.started_at && workflow.completed_at %>
                <span class="admin-badge admin-badge-warning"><%= ((workflow.completed_at - workflow.started_at) * 1000).round %>ms</span>
              <% else %>
                <span class="admin-badge admin-badge-default">N/A</span>
              <% end %>
            </div>
          <% end %>
        </div>
      <% else %>
        <div class="admin-empty-state">
          <div class="empty-icon">
            <i data-lucide="check-circle"></i>
          </div>
          <h3>No slow workflows</h3>
          <p>All workflows are performing well</p>
        </div>
      <% end %>
    </div>

    <!-- Slowest Tool Calls -->
    <div class="admin-card">
      <h3 class="card-title m-0 admin-mb-lg">
        <i data-lucide="clock" class="admin-icon-md d-inline-block align-middle me-2" aria-hidden="true"></i>
        Slowest Tool Calls
      </h3>

      <% if @slowest_tools.any? %>
        <div class="admin-detail-list">
          <% @slowest_tools.each do |event| %>
            <div class="detail-item">
              <div>
                <code class="admin-badge admin-badge-cyan admin-text-xs me-2">#<%= event.id %></code>
                <span class="text-white"><%= event.metadata&.dig('tool') || "Unknown tool" %></span>
              </div>
              <span class="admin-badge admin-badge-warning"><%= event.metadata&.dig('duration')&.to_i || 0 %>ms</span>
            </div>
          <% end %>
        </div>
      <% else %>
        <div class="admin-empty-state">
          <div class="empty-icon">
            <i data-lucide="check-circle"></i>
          </div>
          <h3>No slow tool calls</h3>
          <p>All tools are performing well</p>
        </div>
      <% end %>
    </div>
  </div>
</div>

<!-- Chart.js Configuration -->
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<script>
  function initializePerformanceCharts() {
    // Dark theme colors
    Chart.defaults.color = '#94A3B8';
    Chart.defaults.borderColor = '#1E293B';

    // Performance Trend Chart
    <% if @performance_chart && @performance_chart[:datasets]&.any? %>
      const perfCanvas = document.getElementById('performanceTrendChart');
      if (perfCanvas && Chart.getChart(perfCanvas)) {
        Chart.getChart(perfCanvas).destroy();
      }

      if (perfCanvas) {
        new Chart(perfCanvas, {
          type: 'bar',
          data: <%= raw @performance_chart.to_json %>,
          options: {
            responsive: true,
            maintainAspectRatio: false,
            scales: {
              x: {
                stacked: true,
                grid: { color: '#1E293B' }
              },
              y: {
                stacked: true,
                beginAtZero: true,
                grid: { color: '#1E293B' },
                ticks: {
                  callback: function(value) {
                    return value + 'ms';
                  }
                }
              }
            },
            plugins: {
              legend: {
                position: 'bottom',
                labels: { color: '#94A3B8' }
              }
            }
          }
        });
      }
    <% end %>

    // Error Rate Chart
    <% if @error_rate_chart && @error_rate_chart[:datasets]&.any? %>
      const errorCanvas = document.getElementById('errorRateChart');
      if (errorCanvas && Chart.getChart(errorCanvas)) {
        Chart.getChart(errorCanvas).destroy();
      }

      if (errorCanvas) {
        new Chart(errorCanvas, {
          type: 'doughnut',
          data: {
            labels: ['Success', 'Errors'],
            datasets: [{
              data: [
                <%= @successful_workflows %>,
                <%= @failed_workflows %>
              ],
              backgroundColor: [
                'rgba(34, 197, 94, 0.8)',
                'rgba(239, 68, 68, 0.8)'
              ],
              borderColor: [
                'rgb(34, 197, 94)',
                'rgb(239, 68, 68)'
              ],
              borderWidth: 2
            }]
          },
          options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
              legend: {
                position: 'bottom',
                labels: { color: '#94A3B8' }
              }
            }
          }
        });
      }
    <% end %>

    // Initialize Lucide icons
    if (typeof lucide !== 'undefined') {
      lucide.createIcons();
    }
  }

  // Run on both DOMContentLoaded and turbo:load
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initializePerformanceCharts);
  } else {
    initializePerformanceCharts();
  }

  document.addEventListener('turbo:load', initializePerformanceCharts);
</script>

<!-- Lazy-load Chart.js for performance charts -->
<%= javascript_include_tag "chart_loader", type: "module", defer: true %>
