<div class="admin-content" data-turbo-cache="false">
  <div class="admin-p-xl">
    <%# Page Header %>
    <div class="admin-page-header">
      <div class="header-left">
        <div class="header-icon">
          <%= admin_icon('brain', size: :lg) %>
        </div>
        <div class="header-text">
          <h1>AI Usage Metrics</h1>
          <p>Monitor AI model usage, costs, and performance</p>
        </div>
      </div>

      <div class="header-actions admin-flex admin-flex-gap-xs">
        <%= link_to admin_observability_ai_usage_path(time_range: 1, group_by: "hour"),
                    class: "admin-btn admin-btn-sm #{params[:time_range] == '1' ? 'admin-btn-primary' : 'admin-btn-outline'}" do %>
          Last 24 Hours
        <% end %>
        <%= link_to admin_observability_ai_usage_path(time_range: 7, group_by: "day"),
                    class: "admin-btn admin-btn-sm #{params[:time_range] == '7' || params[:time_range].nil? ? 'admin-btn-primary' : 'admin-btn-outline'}" do %>
          Last 7 Days
        <% end %>
        <%= link_to admin_observability_ai_usage_path(time_range: 30, group_by: "day"),
                    class: "admin-btn admin-btn-sm #{params[:time_range] == '30' ? 'admin-btn-primary' : 'admin-btn-outline'}" do %>
          Last 30 Days
        <% end %>
      </div>
    </div>

    <%# Stats Cards %>
    <div class="admin-stats-grid admin-mb-xl">
      <%= render 'admin/shared/stat_card',
          icon: 'cpu',
          label: 'Total Requests',
          value: number_with_delimiter(@total_requests),
          variant: 'purple-gradient' %>

      <%= render 'admin/shared/stat_card',
          icon: 'coins',
          label: 'Total Tokens',
          value: number_with_delimiter(@total_tokens),
          variant: 'success' %>

      <%= render 'admin/shared/stat_card',
          icon: 'dollar-sign',
          label: 'Total Cost',
          value: "$#{number_with_precision(@total_cost, precision: 2)}",
          variant: 'danger' %>

      <%= render 'admin/shared/stat_card',
          icon: 'clock',
          label: 'Avg Latency',
          value: "#{@average_latency}s",
          variant: 'info' %>
    </div>

    <%# Charts Row %>
    <div class="admin-grid-2 admin-mb-xl">
      <%# Token Usage Chart %>
      <div class="admin-card">
        <h3 class="card-title">
          <%= admin_icon('bar-chart-3', size: :md, class: 'icon-with-spacing') %>
          Token Usage Over Time
        </h3>
        <div class="admin-chart-container">
          <canvas id="tokenUsageChart"></canvas>
        </div>
      </div>

      <%# Cost Chart %>
      <div class="admin-card">
        <h3 class="card-title">
          <%= admin_icon('trending-up', size: :md, class: 'icon-with-spacing') %>
          Cost Over Time
        </h3>
        <div class="admin-chart-container">
          <canvas id="costChart"></canvas>
        </div>
      </div>
    </div>

    <%# Usage Breakdown Row %>
    <div class="admin-grid-2 admin-mb-xl">
      <%# Usage by Entity %>
      <div class="admin-card">
        <h3 class="card-title">
          <%= admin_icon('building', size: :md, class: 'icon-with-spacing') %>
          Usage by Entity
        </h3>
        <% if @usage_by_entity.any? %>
          <div class="admin-overflow-x-auto">
            <table class="admin-table">
              <thead>
                <tr>
                  <th>Entity</th>
                  <th class="admin-text-right">Requests</th>
                </tr>
              </thead>
              <tbody>
                <% @usage_by_entity.sort_by { |_, count| -count }.first(10).each do |entity_name, count| %>
                  <tr>
                    <td class="admin-text-primary"><%= entity_name %></td>
                    <td class="admin-text-secondary admin-text-right"><%= number_with_delimiter(count) %></td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        <% else %>
          <p class="admin-text-secondary admin-m-0">No usage data available</p>
        <% end %>
      </div>

      <%# Usage by Model %>
      <div class="admin-card">
        <h3 class="card-title">
          <%= admin_icon('cpu', size: :md, class: 'icon-with-spacing') %>
          Usage by Model
        </h3>
        <% if @usage_by_model.any? %>
          <div class="admin-overflow-x-auto">
            <table class="admin-table">
              <thead>
                <tr>
                  <th>Model</th>
                  <th class="admin-text-right">Requests</th>
                </tr>
              </thead>
              <tbody>
                <% @usage_by_model.sort_by { |_, count| -count }.each do |model, count| %>
                  <tr>
                    <td>
                      <code class="admin-code-inline"><%= model %></code>
                    </td>
                    <td class="admin-text-secondary admin-text-right"><%= number_with_delimiter(count) %></td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        <% else %>
          <p class="admin-text-secondary admin-m-0">No model data available</p>
        <% end %>
      </div>
    </div>

    <%# Top Entities %>
    <div class="admin-card admin-mb-xl">
      <h3 class="card-title">
        <%= admin_icon('trophy', size: :md, class: 'icon-with-spacing') %>
        Top Entities by Usage
      </h3>
      <% if @top_entities.any? %>
        <div class="admin-overflow-x-auto">
          <table class="admin-table">
            <thead>
              <tr>
                <th>#</th>
                <th>Entity Name</th>
                <th class="admin-text-right">Request Count</th>
              </tr>
            </thead>
            <tbody>
              <% @top_entities.each_with_index do |entity, index| %>
                <tr>
                  <td class="admin-text-secondary"><%= index + 1 %></td>
                  <td class="admin-text-primary admin-font-semibold"><%= entity.name %></td>
                  <td class="admin-text-secondary admin-text-right"><%= number_with_delimiter(entity.request_count) %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% else %>
        <p class="admin-text-secondary admin-m-0">No entity data available</p>
      <% end %>
    </div>

    <%# Recent Requests %>
    <div class="admin-card">
      <h3 class="card-title">
        <%= admin_icon('clock', size: :md, class: 'icon-with-spacing') %>
        Recent AI Requests
      </h3>
      <% if @recent_requests.any? %>
        <div class="admin-overflow-x-auto">
          <table class="admin-table">
            <thead>
              <tr>
                <th>Time</th>
                <th>Entity</th>
                <th>User</th>
                <th>Event</th>
                <th>Details</th>
              </tr>
            </thead>
            <tbody>
              <% @recent_requests.each do |event| %>
                <tr>
                  <td class="admin-text-secondary admin-text-sm"><%= time_ago_in_words(event.created_at) %> ago</td>
                  <td class="admin-text-primary"><%= event.entity&.name || "N/A" %></td>
                  <td class="admin-text-secondary"><%= event.user&.email || "System" %></td>
                  <td><span class="admin-badge admin-badge-default"><%= event.event_type.upcase %></span></td>
                  <td class="admin-text-secondary admin-text-sm">
                    <% if event.metadata.present? %>
                      <%= event.metadata["model"] || "N/A" %>
                    <% end %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% else %>
        <p class="admin-text-secondary admin-m-0">No recent requests</p>
      <% end %>
    </div>
  </div>
</div>

<!-- Consolidated Chart.js -->
<%= render 'admin/chart_js' %>
<script>
  (function() {
    // Prevent duplicate initialization
    if (window.aiUsagePageInitialized) return;
    window.aiUsagePageInitialized = true;

    // Dark theme colors
    Chart.defaults.color = '#94A3B8';
    Chart.defaults.borderColor = '#1E293B';

    // Get canvas elements
    const tokenCanvas = document.getElementById('tokenUsageChart');
    const costCanvas = document.getElementById('costChart');

    // Destroy existing charts if they exist
    if (tokenCanvas && Chart.getChart(tokenCanvas)) {
      Chart.getChart(tokenCanvas).destroy();
    }
    if (costCanvas && Chart.getChart(costCanvas)) {
      Chart.getChart(costCanvas).destroy();
    }

    // Token Usage Chart
    if (tokenCanvas) {
      new Chart(tokenCanvas, {
        type: 'bar',
        data: <%= raw @token_usage_chart.to_json %>,
        options: {
          responsive: true,
          maintainAspectRatio: false,
          scales: {
            x: {
              stacked: true,
              grid: { color: '#1E293B' }
            },
            y: {
              stacked: true,
              beginAtZero: true,
              grid: { color: '#1E293B' }
            }
          },
          plugins: {
            legend: {
              position: 'bottom',
              labels: { color: '#94A3B8' }
            }
          }
        }
      });
    }

    // Cost Chart
    if (costCanvas) {
      new Chart(costCanvas, {
        type: 'line',
        data: <%= raw @cost_chart.to_json %>,
        options: {
          responsive: true,
          maintainAspectRatio: false,
          scales: {
            x: { grid: { color: '#1E293B' } },
            y: {
              beginAtZero: true,
              grid: { color: '#1E293B' },
              ticks: {
                callback: function(value) {
                  return '$' + value.toFixed(2);
                }
              }
            }
          },
          plugins: {
            legend: {
              position: 'bottom',
              labels: { color: '#94A3B8' }
            }
          }
        }
      });
    }

    // Initialize Lucide icons
    if (typeof lucide !== 'undefined') {
      lucide.createIcons();
    }
  })();
</script>
