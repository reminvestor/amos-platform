<div class="admin-content" data-turbo-cache="false">
  <div style="padding: 2rem;">
    <%# Page Header %>
    <div class="admin-page-header">
      <div class="header-left">
        <div class="header-icon">
          <i data-lucide="brain"></i>
        </div>
        <div class="header-text">
          <h1>AI Usage Metrics</h1>
          <p>Monitor AI model usage, costs, and performance</p>
        </div>
      </div>

      <div class="header-actions" style="display: flex; gap: 0.5rem;">
        <%= link_to admin_observability_ai_usage_path(time_range: 1, group_by: "hour"),
                    class: "admin-btn admin-btn-sm #{params[:time_range] == '1' ? 'admin-btn-primary' : 'admin-btn-outline'}" do %>
          Last 24 Hours
        <% end %>
        <%= link_to admin_observability_ai_usage_path(time_range: 7, group_by: "day"),
                    class: "admin-btn admin-btn-sm #{params[:time_range] == '7' || params[:time_range].nil? ? 'admin-btn-primary' : 'admin-btn-outline'}" do %>
          Last 7 Days
        <% end %>
        <%= link_to admin_observability_ai_usage_path(time_range: 30, group_by: "day"),
                    class: "admin-btn admin-btn-sm #{params[:time_range] == '30' ? 'admin-btn-primary' : 'admin-btn-outline'}" do %>
          Last 30 Days
        <% end %>
      </div>
    </div>

    <%# Stats Cards %>
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1.5rem; margin-bottom: 2rem;">
      <%# Total Requests %>
      <div class="admin-card">
        <div style="display: flex; align-items: center; gap: 1rem;">
          <div style="width: 3rem; height: 3rem; border-radius: 0.75rem; background: linear-gradient(135deg, #7C3AED 0%, #A78BFA 100%); display: flex; align-items: center; justify-content: center;">
            <i data-lucide="cpu" class="icon-xl text-white"></i>
          </div>
          <div>
            <p style="color: #94A3B8; font-size: 0.875rem; margin: 0;">Total Requests</p>
            <h3 style="color: white; font-size: 1.875rem; font-weight: 600; margin: 0;"><%= number_with_delimiter(@total_requests) %></h3>
          </div>
        </div>
      </div>

      <%# Total Tokens %>
      <div class="admin-card">
        <div style="display: flex; align-items: center; gap: 1rem;">
          <div style="width: 3rem; height: 3rem; border-radius: 0.75rem; background: rgba(34, 197, 94, 0.1); display: flex; align-items: center; justify-content: center; border: 1px solid rgba(34, 197, 94, 0.2);">
            <i data-lucide="coins" class="icon-xl text-success"></i>
          </div>
          <div>
            <p style="color: #94A3B8; font-size: 0.875rem; margin: 0;">Total Tokens</p>
            <h3 style="color: white; font-size: 1.875rem; font-weight: 600; margin: 0;"><%= number_with_delimiter(@total_tokens) %></h3>
          </div>
        </div>
      </div>

      <%# Total Cost %>
      <div class="admin-card">
        <div style="display: flex; align-items: center; gap: 1rem;">
          <div style="width: 3rem; height: 3rem; border-radius: 0.75rem; background: rgba(239, 68, 68, 0.1); display: flex; align-items: center; justify-content: center; border: 1px solid rgba(239, 68, 68, 0.2);">
            <i data-lucide="dollar-sign" class="icon-xl text-danger"></i>
          </div>
          <div>
            <p style="color: #94A3B8; font-size: 0.875rem; margin: 0;">Total Cost</p>
            <h3 style="color: white; font-size: 1.875rem; font-weight: 600; margin: 0;">$<%= number_with_precision(@total_cost, precision: 2) %></h3>
          </div>
        </div>
      </div>

      <%# Avg Latency %>
      <div class="admin-card">
        <div style="display: flex; align-items: center; gap: 1rem;">
          <div style="width: 3rem; height: 3rem; border-radius: 0.75rem; background: rgba(34, 211, 238, 0.1); display: flex; align-items: center; justify-content: center; border: 1px solid rgba(34, 211, 238, 0.2);">
            <i data-lucide="clock" class="icon-xl text-info"></i>
          </div>
          <div>
            <p style="color: #94A3B8; font-size: 0.875rem; margin: 0;">Avg Latency</p>
            <h3 style="color: white; font-size: 1.875rem; font-weight: 600; margin: 0;"><%= @average_latency %>s</h3>
          </div>
        </div>
      </div>
    </div>

    <%# Charts Row %>
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(400px, 1fr)); gap: 1.5rem; margin-bottom: 2rem;">
      <%# Token Usage Chart %>
      <div class="admin-card">
        <h3 class="card-title">
          <i data-lucide="bar-chart-3" class="icon-lg icon-with-spacing"></i>
          Token Usage Over Time
        </h3>
        <div style="position: relative; height: 300px; width: 100%;">
          <canvas id="tokenUsageChart"></canvas>
        </div>
      </div>

      <%# Cost Chart %>
      <div class="admin-card">
        <h3 class="card-title">
          <i data-lucide="trending-up" class="icon-lg icon-with-spacing"></i>
          Cost Over Time
        </h3>
        <div style="position: relative; height: 300px; width: 100%;">
          <canvas id="costChart"></canvas>
        </div>
      </div>
    </div>

    <%# Usage Breakdown Row %>
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(400px, 1fr)); gap: 1.5rem; margin-bottom: 2rem;">
      <%# Usage by Entity %>
      <div class="admin-card">
        <h3 class="card-title">
          <i data-lucide="building" class="icon-lg icon-with-spacing"></i>
          Usage by Entity
        </h3>
        <% if @usage_by_entity.any? %>
          <div style="overflow-x: auto;">
            <table class="admin-table">
              <thead>
                <tr>
                  <th>Entity</th>
                  <th style="text-align: right;">Requests</th>
                </tr>
              </thead>
              <tbody>
                <% @usage_by_entity.sort_by { |_, count| -count }.first(10).each do |entity_name, count| %>
                  <tr>
                    <td style="color: white;"><%= entity_name %></td>
                    <td style="color: #94A3B8; text-align: right;"><%= number_with_delimiter(count) %></td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        <% else %>
          <p style="color: #94A3B8; margin: 0;">No usage data available</p>
        <% end %>
      </div>

      <%# Usage by Model %>
      <div class="admin-card">
        <h3 class="card-title">
          <i data-lucide="cpu" class="icon-lg icon-with-spacing"></i>
          Usage by Model
        </h3>
        <% if @usage_by_model.any? %>
          <div style="overflow-x: auto;">
            <table class="admin-table">
              <thead>
                <tr>
                  <th>Model</th>
                  <th style="text-align: right;">Requests</th>
                </tr>
              </thead>
              <tbody>
                <% @usage_by_model.sort_by { |_, count| -count }.each do |model, count| %>
                  <tr>
                    <td>
                      <code style="background: #0F172A; padding: 0.25rem 0.5rem; border-radius: 0.25rem; color: #22D3EE; font-size: 0.875rem;"><%= model %></code>
                    </td>
                    <td style="color: #94A3B8; text-align: right;"><%= number_with_delimiter(count) %></td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        <% else %>
          <p style="color: #94A3B8; margin: 0;">No model data available</p>
        <% end %>
      </div>
    </div>

    <%# Top Entities %>
    <div class="admin-card" style="margin-bottom: 2rem;">
      <h3 class="card-title">
        <i data-lucide="trophy" class="icon-lg icon-with-spacing"></i>
        Top Entities by Usage
      </h3>
      <% if @top_entities.any? %>
        <div style="overflow-x: auto;">
          <table class="admin-table">
            <thead>
              <tr>
                <th>#</th>
                <th>Entity Name</th>
                <th style="text-align: right;">Request Count</th>
              </tr>
            </thead>
            <tbody>
              <% @top_entities.each_with_index do |entity, index| %>
                <tr>
                  <td style="color: #94A3B8;"><%= index + 1 %></td>
                  <td style="color: white; font-weight: 600;"><%= entity.name %></td>
                  <td style="color: #94A3B8; text-align: right;"><%= number_with_delimiter(entity.request_count) %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% else %>
        <p style="color: #94A3B8; margin: 0;">No entity data available</p>
      <% end %>
    </div>

    <%# Recent Requests %>
    <div class="admin-card">
      <h3 class="card-title">
        <i data-lucide="clock" class="icon-lg icon-with-spacing"></i>
        Recent AI Requests
      </h3>
      <% if @recent_requests.any? %>
        <div style="overflow-x: auto;">
          <table class="admin-table">
            <thead>
              <tr>
                <th>Time</th>
                <th>Entity</th>
                <th>User</th>
                <th>Event</th>
                <th>Details</th>
              </tr>
            </thead>
            <tbody>
              <% @recent_requests.each do |event| %>
                <tr>
                  <td style="color: #94A3B8; font-size: 0.875rem;"><%= time_ago_in_words(event.created_at) %> ago</td>
                  <td style="color: white;"><%= event.entity&.name || "N/A" %></td>
                  <td style="color: #94A3B8;"><%= event.user&.email || "System" %></td>
                  <td><span class="admin-badge admin-badge-default"><%= event.event_type.upcase %></span></td>
                  <td style="color: #94A3B8; font-size: 0.875rem;">
                    <% if event.metadata.present? %>
                      <%= event.metadata["model"] || "N/A" %>
                    <% end %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% else %>
        <p style="color: #94A3B8; margin: 0;">No recent requests</p>
      <% end %>
    </div>
  </div>
</div>

<!-- Consolidated Chart.js -->
<%= render 'admin/chart_js' %>
<script>
  (function() {
    // Prevent duplicate initialization
    if (window.aiUsagePageInitialized) return;
    window.aiUsagePageInitialized = true;

    // Dark theme colors
    Chart.defaults.color = '#94A3B8';
    Chart.defaults.borderColor = '#1E293B';

    // Get canvas elements
    const tokenCanvas = document.getElementById('tokenUsageChart');
    const costCanvas = document.getElementById('costChart');

    // Destroy existing charts if they exist
    if (tokenCanvas && Chart.getChart(tokenCanvas)) {
      Chart.getChart(tokenCanvas).destroy();
    }
    if (costCanvas && Chart.getChart(costCanvas)) {
      Chart.getChart(costCanvas).destroy();
    }

    // Token Usage Chart
    if (tokenCanvas) {
      new Chart(tokenCanvas, {
        type: 'bar',
        data: <%= raw @token_usage_chart.to_json %>,
        options: {
          responsive: true,
          maintainAspectRatio: false,
          scales: {
            x: {
              stacked: true,
              grid: { color: '#1E293B' }
            },
            y: {
              stacked: true,
              beginAtZero: true,
              grid: { color: '#1E293B' }
            }
          },
          plugins: {
            legend: {
              position: 'bottom',
              labels: { color: '#94A3B8' }
            }
          }
        }
      });
    }

    // Cost Chart
    if (costCanvas) {
      new Chart(costCanvas, {
        type: 'line',
        data: <%= raw @cost_chart.to_json %>,
        options: {
          responsive: true,
          maintainAspectRatio: false,
          scales: {
            x: { grid: { color: '#1E293B' } },
            y: {
              beginAtZero: true,
              grid: { color: '#1E293B' },
              ticks: {
                callback: function(value) {
                  return '$' + value.toFixed(2);
                }
              }
            }
          },
          plugins: {
            legend: {
              position: 'bottom',
              labels: { color: '#94A3B8' }
            }
          }
        }
      });
    }

    // Initialize Lucide icons
    if (typeof lucide !== 'undefined') {
      lucide.createIcons();
    }
  })();
</script>
