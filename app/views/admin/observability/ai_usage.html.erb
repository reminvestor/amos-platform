<div class="container-fluid py-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="mb-0">
      <i class="fas fa-brain me-2"></i> AI Usage Metrics
    </h1>

    <div class="btn-group" role="group">
      <%= link_to admin_observability_ai_usage_path(time_range: 1, group_by: "hour"),
                  class: "btn btn-sm #{params[:time_range] == '1' ? 'btn-primary' : 'btn-outline-primary'}" do %>
        Last 24 Hours
      <% end %>
      <%= link_to admin_observability_ai_usage_path(time_range: 7, group_by: "day"),
                  class: "btn btn-sm #{params[:time_range] == '7' || params[:time_range].nil? ? 'btn-primary' : 'btn-outline-primary'}" do %>
        Last 7 Days
      <% end %>
      <%= link_to admin_observability_ai_usage_path(time_range: 30, group_by: "day"),
                  class: "btn btn-sm #{params[:time_range] == '30' ? 'btn-primary' : 'btn-outline-primary'}" do %>
        Last 30 Days
      <% end %>
    </div>
  </div>

  <!-- Summary Cards -->
  <div class="row g-4 mb-4">
    <div class="col-md-3">
      <div class="card border-primary">
        <div class="card-body">
          <div class="d-flex align-items-center">
            <div class="flex-grow-1">
              <h6 class="text-muted mb-1">Total Requests</h6>
              <h2 class="mb-0"><%= number_with_delimiter(@total_requests) %></h2>
            </div>
            <div class="text-primary">
              <i class="fas fa-robot fa-2x"></i>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="col-md-3">
      <div class="card border-success">
        <div class="card-body">
          <div class="d-flex align-items-center">
            <div class="flex-grow-1">
              <h6 class="text-muted mb-1">Total Tokens</h6>
              <h2 class="mb-0"><%= number_with_delimiter(@total_tokens) %></h2>
            </div>
            <div class="text-success">
              <i class="fas fa-coins fa-2x"></i>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="col-md-3">
      <div class="card border-danger">
        <div class="card-body">
          <div class="d-flex align-items-center">
            <div class="flex-grow-1">
              <h6 class="text-muted mb-1">Total Cost</h6>
              <h2 class="mb-0">$<%= number_with_precision(@total_cost, precision: 2) %></h2>
            </div>
            <div class="text-danger">
              <i class="fas fa-dollar-sign fa-2x"></i>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="col-md-3">
      <div class="card border-info">
        <div class="card-body">
          <div class="d-flex align-items-center">
            <div class="flex-grow-1">
              <h6 class="text-muted mb-1">Avg Latency</h6>
              <h2 class="mb-0"><%= @average_latency %>s</h2>
            </div>
            <div class="text-info">
              <i class="fas fa-clock fa-2x"></i>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Charts -->
  <div class="row g-4 mb-4">
    <div class="col-md-6">
      <div class="card">
        <div class="card-header">
          <h5 class="mb-0">
            <i class="fas fa-chart-area me-2"></i> Token Usage Over Time
          </h5>
        </div>
        <div class="card-body">
          <canvas id="tokenUsageChart" style="height: 300px;"></canvas>
        </div>
      </div>
    </div>

    <div class="col-md-6">
      <div class="card">
        <div class="card-header">
          <h5 class="mb-0">
            <i class="fas fa-chart-line me-2"></i> Cost Over Time
          </h5>
        </div>
        <div class="card-body">
          <canvas id="costChart" style="height: 300px;"></canvas>
        </div>
      </div>
    </div>
  </div>

  <!-- Usage Breakdown -->
  <div class="row g-4 mb-4">
    <div class="col-md-6">
      <div class="card">
        <div class="card-header">
          <h5 class="mb-0">
            <i class="fas fa-building me-2"></i> Usage by Entity
          </h5>
        </div>
        <div class="card-body">
          <% if @usage_by_entity.any? %>
            <div class="table-responsive">
              <table class="table table-sm">
                <thead>
                  <tr>
                    <th>Entity</th>
                    <th class="text-end">Requests</th>
                  </tr>
                </thead>
                <tbody>
                  <% @usage_by_entity.sort_by { |_, count| -count }.first(10).each do |entity_name, count| %>
                    <tr>
                      <td><%= entity_name %></td>
                      <td class="text-end"><%= number_with_delimiter(count) %></td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            </div>
          <% else %>
            <p class="text-muted mb-0">No usage data available</p>
          <% end %>
        </div>
      </div>
    </div>

    <div class="col-md-6">
      <div class="card">
        <div class="card-header">
          <h5 class="mb-0">
            <i class="fas fa-microchip me-2"></i> Usage by Model
          </h5>
        </div>
        <div class="card-body">
          <% if @usage_by_model.any? %>
            <div class="table-responsive">
              <table class="table table-sm">
                <thead>
                  <tr>
                    <th>Model</th>
                    <th class="text-end">Requests</th>
                  </tr>
                </thead>
                <tbody>
                  <% @usage_by_model.sort_by { |_, count| -count }.each do |model, count| %>
                    <tr>
                      <td><code><%= model %></code></td>
                      <td class="text-end"><%= number_with_delimiter(count) %></td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            </div>
          <% else %>
            <p class="text-muted mb-0">No model data available</p>
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <!-- Top Entities -->
  <div class="row g-4 mb-4">
    <div class="col-12">
      <div class="card">
        <div class="card-header">
          <h5 class="mb-0">
            <i class="fas fa-trophy me-2"></i> Top Entities by Usage
          </h5>
        </div>
        <div class="card-body">
          <% if @top_entities.any? %>
            <div class="table-responsive">
              <table class="table table-hover">
                <thead>
                  <tr>
                    <th>#</th>
                    <th>Entity Name</th>
                    <th class="text-end">Request Count</th>
                  </tr>
                </thead>
                <tbody>
                  <% @top_entities.each_with_index do |entity, index| %>
                    <tr>
                      <td><%= index + 1 %></td>
                      <td><%= entity.name %></td>
                      <td class="text-end"><%= number_with_delimiter(entity.request_count) %></td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            </div>
          <% else %>
            <p class="text-muted mb-0">No entity data available</p>
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <!-- Recent Requests -->
  <div class="row g-4">
    <div class="col-12">
      <div class="card">
        <div class="card-header">
          <h5 class="mb-0">
            <i class="fas fa-history me-2"></i> Recent AI Requests
          </h5>
        </div>
        <div class="card-body">
          <% if @recent_requests.any? %>
            <div class="table-responsive">
              <table class="table table-hover table-sm">
                <thead>
                  <tr>
                    <th>Time</th>
                    <th>Entity</th>
                    <th>User</th>
                    <th>Event</th>
                    <th>Details</th>
                  </tr>
                </thead>
                <tbody>
                  <% @recent_requests.each do |message| %>
                    <tr>
                      <td><%= time_ago_in_words(message.created_at) %> ago</td>
                      <td><%= message.entity&.name || "N/A" %></td>
                      <td><%= message.user&.email || "System" %></td>
                      <td><span class="badge bg-primary">AI Response</span></td>
                      <td>
                        <% if message.metadata.present? %>
                          <small class="text-muted">
                            <%= message.metadata["model"] || "claude-sonnet-4" %>
                            <% if message.metadata["input_tokens"] || message.metadata["output_tokens"] %>
                              - <%= (message.metadata["input_tokens"].to_i + message.metadata["output_tokens"].to_i) %> tokens
                            <% end %>
                          </small>
                        <% else %>
                          <small class="text-muted">claude-sonnet-4</small>
                        <% end %>
                      </td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            </div>
          <% else %>
            <p class="text-muted mb-0">No recent requests</p>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<script>
  // Token Usage Chart
  const tokenCtx = document.getElementById('tokenUsageChart');
  new Chart(tokenCtx, {
    type: 'bar',
    data: <%= raw @token_usage_chart.to_json %>,
    options: {
      responsive: true,
      maintainAspectRatio: false,
      scales: {
        x: { stacked: true },
        y: {
          stacked: true,
          beginAtZero: true
        }
      },
      plugins: {
        legend: {
          position: 'bottom'
        }
      }
    }
  });

  // Cost Chart
  const costCtx = document.getElementById('costChart');
  new Chart(costCtx, {
    type: 'line',
    data: <%= raw @cost_chart.to_json %>,
    options: {
      responsive: true,
      maintainAspectRatio: false,
      scales: {
        y: {
          beginAtZero: true,
          ticks: {
            callback: function(value) {
              return '$' + value.toFixed(2);
            }
          }
        }
      },
      plugins: {
        legend: {
          position: 'bottom'
        }
      }
    }
  });
</script>
