<div class="admin-content">
  <div style="padding: 2rem;">
    <div class="container-fluid">
  <div class="row mb-4">
    <div class="col">
      <h1><i class="fas fa-exclamation-triangle text-danger"></i> Error Tracking</h1>
      <p class="text-muted">Monitor platform errors and failures</p>
    </div>
  </div>

  <!-- Error Rate -->
  <div class="row mb-4">
    <div class="col-md-4">
      <div class="card border-0 shadow-sm">
        <div class="card-body">
          <div class="small text-muted mb-1">Error Rate</div>
          <div class="h3 mb-0 text-danger"><%= @error_rate %>%</div>
        </div>
      </div>
    </div>
    <div class="col-md-4">
      <div class="card border-0 shadow-sm">
        <div class="card-body">
          <div class="small text-muted mb-1">Total Errors</div>
          <div class="h3 mb-0"><%= @error_logs.count %></div>
        </div>
      </div>
    </div>
  </div>

  <!-- Error Logs -->
  <div class="row">
    <div class="col-12">
      <div class="card border-0 shadow-sm">
        <div class="card-header bg-white">
          <h5 class="mb-0">Recent Errors</h5>
        </div>
        <div class="card-body">
          <% if @error_logs.any? %>
            <div class="table-responsive">
              <table class="table table-sm">
                <thead>
                  <tr>
                    <th>Time</th>
                    <th>Operation</th>
                    <th>Status</th>
                    <th>Error</th>
                  </tr>
                </thead>
                <tbody>
                  <% @error_logs.each do |log| %>
                    <tr>
                      <td><%= log.created_at.strftime("%b %d, %I:%M %p") %></td>
                      <td><%= log.operation_id || 'N/A' %></td>
                      <td><span class="badge bg-danger"><%= log.response_status %></span></td>
                      <td class="text-muted small"><%= truncate(log.error_message, length: 100) if log.error_message %></td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            </div>
          <% else %>
            <p class="text-center text-muted py-5">No errors in the selected timeframe 🎉</p>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
  </div>
</div>

