<div class="admin-content">
  <div style="padding: 2rem;">
    <div class="container-fluid">
  <div class="row mb-4">
    <div class="col">
      <h1><i class="fas fa-robot text-primary"></i> AI Usage Metrics</h1>
      <p class="text-muted">Monitor AI model usage, costs, and performance</p>
    </div>
    <div class="col-auto">
      <div class="btn-group">
        <%= link_to "1 Hour", admin_observability_ai_usage_path(timeframe: '1h'), class: "btn btn-sm #{'btn-primary' if @timeframe == '1h'} #{'btn-outline-primary' if @timeframe != '1h'}" %>
        <%= link_to "24 Hours", admin_observability_ai_usage_path(timeframe: '24h'), class: "btn btn-sm #{'btn-primary' if @timeframe == '24h'} #{'btn-outline-primary' if @timeframe != '24h'}" %>
        <%= link_to "7 Days", admin_observability_ai_usage_path(timeframe: '7d'), class: "btn btn-sm #{'btn-primary' if @timeframe == '7d'} #{'btn-outline-primary' if @timeframe != '7d'}" %>
      </div>
    </div>
  </div>

  <!-- Stats -->
  <div class="row mb-4">
    <div class="col-md-3">
      <div class="card border-0 shadow-sm">
        <div class="card-body">
          <div class="small text-muted mb-1">Total AI Calls</div>
          <div class="h3 mb-0"><%= number_with_delimiter(@stats[:total_ai_calls]) %></div>
        </div>
      </div>
    </div>
    <div class="col-md-3">
      <div class="card border-0 shadow-sm">
        <div class="card-body">
          <div class="small text-muted mb-1">Total Tokens</div>
          <div class="h3 mb-0"><%= number_with_delimiter(@stats[:total_tokens]) %></div>
        </div>
      </div>
    </div>
    <div class="col-md-3">
      <div class="card border-0 shadow-sm">
        <div class="card-body">
          <div class="small text-muted mb-1">Estimated Cost</div>
          <div class="h3 mb-0 text-success">$<%= @stats[:estimated_cost] %></div>
        </div>
      </div>
    </div>
    <div class="col-md-3">
      <div class="card border-0 shadow-sm">
        <div class="card-body">
          <div class="small text-muted mb-1">Avg Response Time</div>
          <div class="h3 mb-0"><%= @stats[:avg_response_time] %>ms</div>
        </div>
      </div>
    </div>
  </div>

  <div class="row">
    <div class="col-12">
      <div class="card border-0 shadow-sm">
        <div class="card-body text-center py-5">
          <i class="fas fa-chart-line fa-4x text-muted mb-3"></i>
          <h4>AI Usage Analytics Coming Soon</h4>
          <p class="text-muted">Detailed breakdowns by user, model, and time will be available here</p>
        </div>
      </div>
    </div>
  </div>
</div>
  </div>
</div>

