<div class="admin-p-xl">
  <!-- Page Header -->
  <div class="admin-page-header admin-mb-xl">
    <div class="header-left">
      <div class="header-icon" style="background: linear-gradient(135deg, var(--status-success-bg), rgba(34, 197, 94, 0.3));">
        <i data-lucide="gauge" class="admin-text-success"></i>
      </div>
      <div class="header-text">
        <h1>Performance Metrics</h1>
        <p>Monitor API and system performance</p>
      </div>
    </div>
  </div>

  <!-- Performance Stats -->
  <div class="admin-stats-grid admin-mb-xl">
    <div class="admin-card">
      <div class="admin-flex admin-items-center admin-flex-gap-md">
        <div class="admin-stat-icon success">
          <i data-lucide="clock" class="admin-icon-lg admin-text-success"></i>
        </div>
        <div>
          <p class="admin-stat-label">Avg Response Time</p>
          <h3 class="admin-stat-value"><%= @stats[:avg_response_time] %>ms</h3>
        </div>
      </div>
    </div>

    <div class="admin-card">
      <div class="admin-flex admin-items-center admin-flex-gap-md">
        <div class="admin-stat-icon warning">
          <i data-lucide="timer" class="admin-icon-lg admin-text-warning"></i>
        </div>
        <div>
          <p class="admin-stat-label">P95 Response Time</p>
          <h3 class="admin-stat-value"><%= @stats[:p95_response_time] %>ms</h3>
        </div>
      </div>
    </div>
  </div>

  <!-- Slowest Operations -->
  <div class="admin-card">
    <h3 class="card-title m-0 admin-mb-lg">
      <i data-lucide="snail" class="admin-icon-md d-inline-block align-middle me-2"></i>
      Slowest Operations
    </h3>
    <% if @stats[:slowest_operations].any? %>
      <div class="admin-table-container">
        <table class="admin-table">
          <thead>
            <tr>
              <th>Operation</th>
              <th>Avg Response Time</th>
            </tr>
          </thead>
          <tbody>
            <% @stats[:slowest_operations].each do |operation_id, avg_time| %>
              <tr>
                <td class="admin-text-primary"><%= operation_id %></td>
                <td class="admin-text-warning"><%= avg_time.round(0) %>ms</td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <div class="admin-text-center admin-text-muted admin-p-xl">
        <i data-lucide="inbox" class="admin-icon-xl admin-mb-md"></i>
        <p class="admin-mb-0">No performance data available</p>
      </div>
    <% end %>
  </div>
</div>

<script>
  document.addEventListener('turbo:load', () => {
    if (typeof lucide !== 'undefined') {
      lucide.createIcons();
    }
  });
</script>
