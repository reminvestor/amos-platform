<div class="admin-p-xl">
  <!-- Page Header -->
  <div class="admin-page-header admin-mb-xl">
    <div class="header-left">
      <div class="header-icon admin-icon-gradient-purple">
        <i data-lucide="plug" class="admin-text-primary"></i>
      </div>
      <div class="header-text">
        <h1>Connections Management</h1>
        <p>Monitor and manage all integration connections across the platform</p>
      </div>
    </div>
  </div>

  <!-- Stats Cards -->
  <div class="admin-stats-grid admin-mb-xl">
    <div class="admin-card">
      <div class="admin-flex admin-items-center admin-flex-gap-md">
        <div class="admin-stat-icon success">
          <i data-lucide="check-circle" class="admin-icon-lg admin-text-success"></i>
        </div>
        <div>
          <p class="admin-stat-label">Active Connections</p>
          <h3 class="admin-stat-value"><%= Connection.where(status: 'connected').count %></h3>
        </div>
      </div>
    </div>

    <div class="admin-card">
      <div class="admin-flex admin-items-center admin-flex-gap-md">
        <div class="admin-stat-icon error">
          <i data-lucide="alert-triangle" class="admin-icon-lg admin-text-error"></i>
        </div>
        <div>
          <p class="admin-stat-label">Failed/Inactive</p>
          <h3 class="admin-stat-value"><%= Connection.where.not(status: 'connected').count %></h3>
        </div>
      </div>
    </div>

    <div class="admin-card">
      <div class="admin-flex admin-items-center admin-flex-gap-md">
        <div class="admin-stat-icon info">
          <i data-lucide="users" class="admin-icon-lg admin-text-info"></i>
        </div>
        <div>
          <p class="admin-stat-label">Users with Connections</p>
          <h3 class="admin-stat-value"><%= User.joins(:connections).distinct.count %></h3>
        </div>
      </div>
    </div>

    <div class="admin-card">
      <div class="admin-flex admin-items-center admin-flex-gap-md">
        <div class="admin-stat-icon purple-gradient">
          <i data-lucide="puzzle" class="admin-icon-lg admin-text-primary"></i>
        </div>
        <div>
          <p class="admin-stat-label">Available Integrations</p>
          <h3 class="admin-stat-value"><%= Integration.where(is_active: true).count %></h3>
        </div>
      </div>
    </div>
  </div>

  <!-- Connections Table -->
  <div class="admin-card">
    <h3 class="card-title admin-mb-lg">All Connections</h3>
    <% if @connections.any? %>
      <div class="admin-table-container">
        <table class="admin-table">
          <thead>
            <tr>
              <th>Integration</th>
              <th>Name</th>
              <th>Entity</th>
              <th>Status</th>
              <th>Created</th>
              <th>Last Used</th>
              <th class="admin-text-right">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% @connections.each do |connection| %>
              <tr>
                <td>
                  <div class="admin-flex admin-items-center admin-flex-gap-0\.75">
                    <% if connection.integration.icon_url.present? %>
                      <img src="<%= connection.integration.icon_url %>"
                           alt="<%= connection.integration.name %>"
                           class="admin-connection-icon">
                    <% else %>
                      <i data-lucide="box" class="admin-icon-lg admin-text-muted"></i>
                    <% end %>
                    <span class="admin-text-primary admin-font-medium"><%= connection.integration.name %></span>
                  </div>
                </td>
                <td>
                  <%= link_to connection.name, admin_connection_path(connection), class: "admin-text-info admin-font-semibold" %>
                </td>
                <td class="admin-text-secondary admin-text-sm">
                  <%= connection.entity&.name || 'N/A' %>
                </td>
                <td>
                  <span class="admin-badge admin-badge-<%= connection.status == 'connected' ? 'online' : 'offline' %>">
                    <%= connection.status.to_s.upcase.gsub('_', ' ') %>
                  </span>
                </td>
                <td class="admin-text-secondary admin-text-sm">
                  <%= connection.created_at.strftime("%b %d, %Y") %>
                </td>
                <td class="admin-text-secondary admin-text-sm">
                  <% last_log = connection.integration_logs.maximum(:created_at) %>
                  <%= last_log ? "#{time_ago_in_words(last_log)} ago" : 'Never' %>
                </td>
                <td class="admin-text-right">
                  <%= link_to admin_connection_path(connection), class: 'admin-btn admin-btn-sm admin-btn-outline', aria: { label: 'View details' } do %>
                    <i data-lucide="eye" class="admin-icon-sm"></i>
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>

      <% if @connections.respond_to?(:total_pages) && @connections.total_pages > 1 %>
        <div class="admin-pagination">
          <%= paginate @connections %>
        </div>
      <% end %>
    <% else %>
      <div class="admin-empty-state admin-text-center admin-p-xl">
        <div class="empty-icon admin-mb-md admin-text-muted">
          <i data-lucide="plug" class="admin-icon-xl"></i>
        </div>
        <p class="admin-text-lg admin-font-semibold admin-text-primary admin-mb-sm">No connections yet</p>
        <p class="admin-text-secondary">
          Connections will appear here as users connect their integrations
        </p>
      </div>
    <% end %>
  </div>
</div>

<script>
  document.addEventListener('turbo:load', () => {
    lucide.createIcons();
  });

  document.addEventListener('DOMContentLoaded', () => {
    lucide.createIcons();
  });
</script>
