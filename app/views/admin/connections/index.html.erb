
<div class="admin-content">
  <div class="admin-p-xl">
    <%# Page Header %>
    <div class="admin-page-header">
      <div class="header-left">
        <div class="header-icon">
          <%= admin_icon('plug', size: :lg) %>
        </div>
        <div class="header-text">
          <h1>Connections Management</h1>
          <p>Monitor and manage all integration connections across the platform</p>
        </div>
      </div>
    </div>

    <%# Stats Cards %>
    <div class="admin-stats-grid admin-mb-xl">
      <%= render 'admin/shared/stat_card',
          icon: 'check-circle',
          label: 'Active Connections',
          value: Connection.where(status: 'connected').count,
          variant: 'success' %>

      <%= render 'admin/shared/stat_card',
          icon: 'alert-triangle',
          label: 'Failed/Inactive',
          value: Connection.where.not(status: 'connected').count,
          variant: 'danger' %>

      <%= render 'admin/shared/stat_card',
          icon: 'users',
          label: 'Users with Connections',
          value: User.joins(:connections).distinct.count,
          variant: 'info' %>

      <%= render 'admin/shared/stat_card',
          icon: 'puzzle',
          label: 'Available Integrations',
          value: Integration.where(is_active: true).count,
          variant: 'purple-gradient' %>
    </div>

    <%# Connections Table %>
    <div class="admin-card">
      <h3 class="card-title">All Connections</h3>
      <% if @connections.any? %>
        <div class="admin-overflow-x-auto">
          <table class="admin-table">
            <thead>
              <tr>
                <th>Integration</th>
                <th>Name</th>
                <th>Entity</th>
                <th>Status</th>
                <th>Created</th>
                <th>Last Used</th>
                <th class="admin-text-right">Actions</th>
              </tr>
            </thead>
            <tbody>
              <% @connections.each do |connection| %>
                <tr>
                  <td>
                    <div class="admin-flex admin-items-center admin-flex-gap-sm">
                      <% if connection.integration.icon_url.present? %>
                        <img src="<%= connection.integration.icon_url %>"
                             alt="<%= connection.integration.name %>"
                             class="admin-connection-icon">
                      <% else %>
                        <%= admin_icon('box', size: :sm, class: 'admin-text-muted') %>
                      <% end %>
                      <span class="admin-text-primary"><%= connection.integration.name %></span>
                    </div>
                  </td>
                  <td>
                    <%= link_to connection.name, admin_connection_path(connection), class: 'admin-link admin-font-semibold' %>
                  </td>
                  <td class="admin-text-muted admin-text-sm">
                    <%= connection.entity&.name || 'N/A' %>
                  </td>
                  <td>
                    <span class="admin-badge admin-badge-<%= connection.status == 'connected' ? 'online' : 'offline' %>">
                      <%= connection.status.to_s.upcase.gsub('_', ' ') %>
                    </span>
                  </td>
                  <td class="admin-text-muted admin-text-sm">
                    <%= connection.created_at.strftime("%b %d, %Y") %>
                  </td>
                  <td class="admin-text-muted admin-text-sm">
                    <% last_log = connection.integration_logs.maximum(:created_at) %>
                    <%= last_log ? "#{time_ago_in_words(last_log)} ago" : 'Never' %>
                  </td>
                  <td class="admin-text-right">
                    <%= link_to admin_connection_path(connection), class: 'admin-btn admin-btn-sm admin-btn-outline', aria: { label: 'View details' } do %>
                      <%= admin_icon('eye', size: :sm) %>
                      <span>View</span>
                    <% end %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>

        <% if @connections.respond_to?(:total_pages) && @connections.total_pages > 1 %>
          <div class="admin-mt-lg">
            <%= paginate @connections %>
          </div>
        <% end %>
      <% else %>
        <%# Empty State %>
        <div class="admin-empty-state">
          <div class="empty-icon">
            <%= admin_icon('plug', size: :xl) %>
          </div>
          <p class="empty-title">No connections yet</p>
          <p class="empty-description">
            Connections will appear here as users connect their integrations
          </p>
        </div>
      <% end %>
    </div>
  </div>
</div>

<script>
  document.addEventListener('turbo:load', () => {
    lucide.createIcons();
  });

  document.addEventListener('DOMContentLoaded', () => {
    lucide.createIcons();
  });
</script>
