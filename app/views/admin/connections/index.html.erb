<div class="container-fluid">
  <div class="row mb-4">
    <div class="col">
      <h1><i class="fas fa-plug text-primary"></i> Connections Management</h1>
      <p class="text-muted">Monitor and manage all integration connections across the platform</p>
    </div>
  </div>

  <!-- Stats Cards -->
  <div class="row mb-4">
    <div class="col-md-3">
      <div class="card border-0 shadow-sm">
        <div class="card-body">
          <div class="d-flex align-items-center">
            <div class="rounded-circle bg-success bg-opacity-10 p-3 me-3">
              <i class="fas fa-check-circle text-success fa-lg"></i>
            </div>
            <div>
              <div class="h4 mb-0"><%= Connection.where(status: 'connected').count %></div>
              <div class="text-muted small">Active Connections</div>
            </div>
          </div>
        </div>
      </div>
    </div>
    <div class="col-md-3">
      <div class="card border-0 shadow-sm">
        <div class="card-body">
          <div class="d-flex align-items-center">
            <div class="rounded-circle bg-danger bg-opacity-10 p-3 me-3">
              <i class="fas fa-exclamation-triangle text-danger fa-lg"></i>
            </div>
            <div>
              <div class="h4 mb-0"><%= Connection.where.not(status: 'connected').count %></div>
              <div class="text-muted small">Failed/Inactive</div>
            </div>
          </div>
        </div>
      </div>
    </div>
    <div class="col-md-3">
      <div class="card border-0 shadow-sm">
        <div class="card-body">
          <div class="d-flex align-items-center">
            <div class="rounded-circle bg-info bg-opacity-10 p-3 me-3">
              <i class="fas fa-users text-info fa-lg"></i>
            </div>
            <div>
              <div class="h4 mb-0"><%= User.joins(:connections).distinct.count %></div>
              <div class="text-muted small">Users with Connections</div>
            </div>
          </div>
        </div>
      </div>
    </div>
    <div class="col-md-3">
      <div class="card border-0 shadow-sm">
        <div class="card-body">
          <div class="d-flex align-items-center">
            <div class="rounded-circle bg-warning bg-opacity-10 p-3 me-3">
              <i class="fas fa-puzzle-piece text-warning fa-lg"></i>
            </div>
            <div>
              <div class="h4 mb-0"><%= Integration.where(is_active: true).count %></div>
              <div class="text-muted small">Available Integrations</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Connections Table -->
  <div class="row">
    <div class="col-12">
      <div class="card border-0 shadow-sm">
        <div class="card-header bg-white">
          <h5 class="mb-0">All Connections</h5>
        </div>
        <div class="card-body">
          <% if @connections.any? %>
            <div class="table-responsive">
              <table class="table table-hover">
                <thead>
                  <tr>
                    <th>Integration</th>
                    <th>Name</th>
                    <th>Entity</th>
                    <th>Status</th>
                    <th>Created</th>
                    <th>Last Used</th>
                    <th>Actions</th>
                  </tr>
                </thead>
                <tbody>
                  <% @connections.each do |connection| %>
                    <tr>
                      <td>
                        <div class="d-flex align-items-center">
                          <% if connection.integration.icon_url.present? %>
                            <img src="<%= connection.integration.icon_url %>" 
                                 alt="<%= connection.integration.name %>" 
                                 class="rounded me-2" style="width: 24px; height: 24px;">
                          <% else %>
                            <i class="fas fa-cube text-muted me-2"></i>
                          <% end %>
                          <%= connection.integration.name %>
                        </div>
                      </td>
                      <td><%= connection.name %></td>
                      <td><%= connection.entity&.name || 'N/A' %></td>
                      <td>
                        <span class="badge bg-<%= connection.status == 'connected' ? 'success' : 'danger' %>">
                          <%= connection.status.to_s.humanize %>
                        </span>
                      </td>
                      <td><%= connection.created_at.strftime("%b %d, %Y") %></td>
                      <td>
                        <% last_log = connection.integration_logs.maximum(:created_at) %>
                        <%= last_log ? "#{time_ago_in_words(last_log)} ago" : 'Never' %>
                      </td>
                      <td>
                        <%= link_to "View Details", admin_connection_path(connection), class: "btn btn-outline-primary btn-sm" %>
                      </td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            </div>
            
            <% if @connections.respond_to?(:total_pages) && @connections.total_pages > 1 %>
              <div class="mt-3">
                <%= paginate @connections %>
              </div>
            <% end %>
          <% else %>
            <div class="text-center py-5">
              <i class="fas fa-plug fa-4x text-muted mb-3"></i>
              <h4>No Connections Yet</h4>
              <p class="text-muted">Connections will appear here as users connect their integrations</p>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>

