<div class="admin-content">
  <div style="padding: 2rem;">
    <div class="container-fluid">
  <div class="row mb-4">
    <div class="col-12">
      <div class="d-flex justify-content-between align-items-center">
        <h1><i class="fas fa-chart-line"></i> Affiliate Analytics</h1>
        <div>
          <%= form_with url: admin_analytics_affiliates_path, method: :get, local: true, class: "d-inline" do %>
            <%= select_tag :date_range, options_for_select([['Last 7 Days', '7days'], ['Last 30 Days', '30days'], ['Last 90 Days', '90days'], ['Last Year', 'year'], ['All Time', 'all']], @date_range), class: "form-select d-inline-block w-auto", onchange: "this.form.submit()" %>
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <!-- Summary Metrics -->
  <div class="row mb-4">
    <div class="col-md-3 mb-3">
      <div class="card bg-secondary text-white">
        <div class="card-body">
          <h6 class="card-title">Total Affiliates</h6>
          <h3 class="mb-0"><%= @analytics[:summary][:total_affiliates] %></h3>
          <small class="text-muted"><%= @analytics[:summary][:active_affiliates] %> active</small>
        </div>
      </div>
    </div>

    <div class="col-md-3 mb-3">
      <div class="card bg-primary text-white">
        <div class="card-body">
          <h6 class="card-title">Total Clicks</h6>
          <h3 class="mb-0"><%= number_with_delimiter(@analytics[:summary][:total_clicks]) %></h3>
        </div>
      </div>
    </div>

    <div class="col-md-3 mb-3">
      <div class="card bg-success text-white">
        <div class="card-body">
          <h6 class="card-title">Total Conversions</h6>
          <h3 class="mb-0"><%= number_with_delimiter(@analytics[:summary][:total_conversions]) %></h3>
        </div>
      </div>
    </div>

    <div class="col-md-3 mb-3">
      <div class="card bg-warning text-dark">
        <div class="card-body">
          <h6 class="card-title">Commissions Earned</h6>
          <h3 class="mb-0">$<%= number_with_delimiter(@analytics[:summary][:total_commissions_earned], precision: 2) %></h3>
        </div>
      </div>
    </div>
  </div>

  <!-- Secondary Metrics -->
  <div class="row mb-4">
    <div class="col-md-4 mb-3">
      <div class="card bg-secondary text-white">
        <div class="card-body">
          <h6 class="card-title">Pending Commissions</h6>
          <h4 class="mb-0">$<%= number_with_delimiter(@analytics[:summary][:total_commissions_pending], precision: 2) %></h4>
        </div>
      </div>
    </div>

    <div class="col-md-4 mb-3">
      <div class="card bg-secondary text-white">
        <div class="card-body">
          <h6 class="card-title">Approved Commissions</h6>
          <h4 class="mb-0">$<%= number_with_delimiter(@analytics[:summary][:total_commissions_approved], precision: 2) %></h4>
        </div>
      </div>
    </div>

    <div class="col-md-4 mb-3">
      <div class="card bg-secondary text-white">
        <div class="card-body">
          <h6 class="card-title">Payouts Processed</h6>
          <h4 class="mb-0">$<%= number_with_delimiter(@analytics[:summary][:total_payouts_processed], precision: 2) %></h4>
        </div>
      </div>
    </div>
  </div>

  <!-- Conversion Funnel -->
  <div class="card bg-secondary mb-4">
    <div class="card-header">
      <h5 class="mb-0">Conversion Funnel</h5>
    </div>
    <div class="card-body">
      <div class="row">
        <div class="col-md-4 text-center">
          <div class="mb-2">
            <h2 class="text-primary"><%= number_with_delimiter(@analytics[:conversion_funnel][:clicks]) %></h2>
            <p class="text-muted mb-0">Clicks</p>
          </div>
          <i class="fas fa-arrow-down fa-2x text-muted"></i>
        </div>
        <div class="col-md-4 text-center">
          <div class="mb-2">
            <h2 class="text-info"><%= number_with_delimiter(@analytics[:conversion_funnel][:signups]) %></h2>
            <p class="text-muted mb-0">Signups</p>
            <small class="badge bg-info"><%= @analytics[:conversion_funnel][:click_to_signup_rate] %>% rate</small>
          </div>
          <i class="fas fa-arrow-down fa-2x text-muted"></i>
        </div>
        <div class="col-md-4 text-center">
          <div class="mb-2">
            <h2 class="text-success"><%= number_with_delimiter(@analytics[:conversion_funnel][:conversions]) %></h2>
            <p class="text-muted mb-0">Paying Customers</p>
            <small class="badge bg-success"><%= @analytics[:conversion_funnel][:overall_conversion_rate] %>% overall</small>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Top Affiliates -->
  <div class="card bg-secondary mb-4">
    <div class="card-header">
      <h5 class="mb-0">Top Performing Affiliates</h5>
    </div>
    <div class="card-body p-0">
      <div class="table-responsive">
        <table class="table table-dark table-hover mb-0">
          <thead>
            <tr>
              <th>Rank</th>
              <th>Affiliate</th>
              <th>Email</th>
              <th>Tier</th>
              <th>Total Earnings</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            <% @analytics[:top_affiliates].each_with_index do |affiliate, index| %>
              <tr>
                <td>
                  <% if index < 3 %>
                    <span class="badge bg-<%= ['warning', 'light text-dark', 'secondary'][index] %>">
                      #<%= index + 1 %>
                    </span>
                  <% else %>
                    #<%= index + 1 %>
                  <% end %>
                </td>
                <td><%= affiliate.user.full_name %></td>
                <td><%= affiliate.user.email %></td>
                <td>
                  <span class="badge bg-<%= case affiliate.tier
                    when 'bronze' then 'secondary'
                    when 'silver' then 'light text-dark'
                    when 'gold' then 'warning'
                    end %>">
                    <%= affiliate.tier.humanize %>
                  </span>
                </td>
                <td>$<%= number_with_delimiter(affiliate.total_earnings, precision: 2) %></td>
                <td>
                  <%= link_to admin_affiliate_path(affiliate), class: "btn btn-sm btn-outline-primary" do %>
                    <i class="fas fa-eye"></i> View
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <!-- Tier Distribution -->
  <div class="card bg-secondary mb-4">
    <div class="card-header">
      <h5 class="mb-0">Tier Distribution</h5>
    </div>
    <div class="card-body">
      <div class="row">
        <div class="col-md-4 text-center">
          <div class="mb-2">
            <span class="badge bg-secondary" style="font-size: 1.5rem;">Bronze</span>
            <h3 class="mt-2"><%= @analytics[:tier_distribution][:bronze] %></h3>
            <p class="text-muted mb-0">affiliates</p>
          </div>
        </div>
        <div class="col-md-4 text-center">
          <div class="mb-2">
            <span class="badge bg-light text-dark" style="font-size: 1.5rem;">Silver</span>
            <h3 class="mt-2"><%= @analytics[:tier_distribution][:silver] %></h3>
            <p class="text-muted mb-0">affiliates</p>
          </div>
        </div>
        <div class="col-md-4 text-center">
          <div class="mb-2">
            <span class="badge bg-warning" style="font-size: 1.5rem;">Gold</span>
            <h3 class="mt-2"><%= @analytics[:tier_distribution][:gold] %></h3>
            <p class="text-muted mb-0">affiliates</p>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Monthly Trends (Chart Placeholder) -->
  <div class="card bg-secondary mb-4">
    <div class="card-header">
      <h5 class="mb-0">Monthly Trends</h5>
    </div>
    <div class="card-body">
      <div class="row">
        <div class="col-md-12">
          <p class="text-muted text-center">
            <i class="fas fa-chart-line fa-3x mb-3"></i><br>
            Chart integration available with Chart.js or similar library.
          </p>
          <div class="row">
            <div class="col-md-12">
              <h6 class="text-white">Data Summary:</h6>
              <table class="table table-sm table-dark">
                <thead>
                  <tr>
                    <th>Month</th>
                    <th>New Affiliates</th>
                    <th>Commissions</th>
                    <th>Payouts</th>
                  </tr>
                </thead>
                <tbody>
                  <% @analytics[:monthly_trends][:labels].each_with_index do |label, index| %>
                    <tr>
                      <td><%= label %></td>
                      <td><%= @analytics[:monthly_trends][:affiliates][index] %></td>
                      <td>$<%= number_with_delimiter(@analytics[:monthly_trends][:commissions][index], precision: 2) %></td>
                      <td>$<%= number_with_delimiter(@analytics[:monthly_trends][:payouts][index], precision: 2) %></td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Actions -->
  <div class="d-flex justify-content-between">
    <%= link_to admin_affiliates_path, class: "btn btn-outline-secondary" do %>
      <i class="fas fa-users-cog"></i> Manage Affiliates
    <% end %>
    <%= link_to admin_settings_affiliate_path, class: "btn btn-outline-primary" do %>
      <i class="fas fa-cog"></i> Settings
    <% end %>
  </div>
</div>
  </div>
</div>
