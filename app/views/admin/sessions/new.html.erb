<div class="min-vh-100 d-flex align-items-center justify-content-center" style="background: var(--bg-primary);">
  <div class="container">
    <div class="row justify-content-center">
      <div class="col-md-6 col-lg-5">
        <div class="admin-card" style="border: 1px solid var(--border-primary);">
          <div class="p-5">
            <div class="text-center mb-4">
              <h2>Admin Portal</h2>
              <p class="text-muted">Sign in to manage integrations</p>
            </div>

            <%= form_with url: admin_session_path, local: true, html: { class: "needs-validation" } do |f| %>
              <% if flash[:alert] %>
                <div class="p-3 rounded mb-3" style="background: var(--status-error-bg); color: var(--status-error-text);">
                  <%= flash[:alert] %>
                </div>
              <% end %>

              <div class="mb-3">
                <%= f.label :email, class: "form-label" %>
                <%= f.email_field :email,
                    class: "form-control",
                    placeholder: "admin@example.com",
                    required: true,
                    autofocus: true %>
              </div>

              <div class="mb-4">
                <%= f.label :password, class: "form-label" %>
                <%= f.password_field :password,
                    class: "form-control",
                    required: true %>
              </div>

              <div class="d-grid">
                <%= f.submit "Sign In", class: "admin-btn admin-btn-primary admin-btn-lg" %>
              </div>
            <% end %>

            <div class="text-center mt-4">
              <small class="text-muted">
                Forgot your password? Contact system administrator.
              </small>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
