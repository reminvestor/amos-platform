<div class="min-vh-100 d-flex align-items-center justify-content-center bg-dark">
  <div class="container">
    <div class="row justify-content-center">
      <div class="col-md-6 col-lg-5">
        <div class="card bg-secondary border-0 shadow">
          <div class="card-body p-5">
            <div class="text-center mb-4">
              <h2 class="text-white">Admin Portal</h2>
              <p class="text-muted">Sign in to manage integrations</p>
            </div>

            <%= form_with url: admin_session_path, local: true, html: { class: "needs-validation" } do |f| %>
              <% if flash[:alert] %>
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                  <%= flash[:alert] %>
                  <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
              <% end %>

              <div class="mb-3">
                <%= f.label :email, class: "form-label text-white" %>
                <%= f.email_field :email, 
                    class: "form-control bg-dark text-white border-secondary", 
                    placeholder: "admin@example.com",
                    required: true,
                    autofocus: true %>
              </div>

              <div class="mb-4">
                <%= f.label :password, class: "form-label text-white" %>
                <%= f.password_field :password, 
                    class: "form-control bg-dark text-white border-secondary",
                    required: true %>
              </div>

              <div class="d-grid">
                <%= f.submit "Sign In", class: "btn btn-primary btn-lg" %>
              </div>
            <% end %>

            <div class="text-center mt-4">
              <small class="text-muted">
                Forgot your password? Contact system administrator.
              </small>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
