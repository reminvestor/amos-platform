<div style="padding: 2rem;">
  <!-- Page Header -->
  <div class="admin-page-header" style="margin-bottom: 2rem;">
    <div class="header-left">
      <div class="header-icon" style="background: linear-gradient(135deg, #3B82F6 0%, #2563EB 100%);">
        <i data-lucide="layout-dashboard" style="color: white;"></i>
      </div>
      <div class="header-text">
        <h1>Admin Dashboard</h1>
        <p>Monitor platform activity and system health</p>
      </div>
    </div>
  </div>

  <!-- Stats Cards -->
  <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1.5rem; margin-bottom: 2rem;">
    <div class="admin-card">
      <div style="display: flex; align-items: center; gap: 1rem;">
        <div style="width: 3rem; height: 3rem; border-radius: 0.75rem; background: linear-gradient(135deg, #7C3AED 0%, #A78BFA 100%); display: flex; align-items: center; justify-content: center;">
          <i data-lucide="users" style="width: 1.5rem; height: 1.5rem; color: white;"></i>
        </div>
        <div>
          <p style="color: #94A3B8; font-size: 0.875rem; margin: 0;">Total Users</p>
          <h3 style="color: white; font-size: 1.875rem; font-weight: 600; margin: 0;"><%= @stats[:total_users] %></h3>
          <small style="color: #64748B; font-size: 0.75rem;">Active accounts</small>
        </div>
      </div>
    </div>

    <div class="admin-card">
      <div style="display: flex; align-items: center; gap: 1rem;">
        <div style="width: 3rem; height: 3rem; border-radius: 0.75rem; background: rgba(34, 211, 238, 0.1); border: 1px solid rgba(34, 211, 238, 0.2); display: flex; align-items: center; justify-content: center;">
          <i data-lucide="plug" style="width: 1.5rem; height: 1.5rem; color: #22D3EE;"></i>
        </div>
        <div>
          <p style="color: #94A3B8; font-size: 0.875rem; margin: 0;">Integrations</p>
          <h3 style="color: white; font-size: 1.875rem; font-weight: 600; margin: 0;"><%= @stats[:total_integrations] %></h3>
          <small style="color: #64748B; font-size: 0.75rem;">Available integrations</small>
        </div>
      </div>
    </div>

    <div class="admin-card">
      <div style="display: flex; align-items: center; gap: 1rem;">
        <div style="width: 3rem; height: 3rem; border-radius: 0.75rem; background: rgba(34, 197, 94, 0.1); border: 1px solid rgba(34, 197, 94, 0.2); display: flex; align-items: center; justify-content: center;">
          <i data-lucide="link" style="width: 1.5rem; height: 1.5rem; color: rgb(74, 222, 128);"></i>
        </div>
        <div>
          <p style="color: #94A3B8; font-size: 0.875rem; margin: 0;">Active Connections</p>
          <h3 style="color: white; font-size: 1.875rem; font-weight: 600; margin: 0;"><%= @stats[:active_connections] %></h3>
          <small style="<%= @stats[:failed_connections] > 0 ? 'color: #F87171;' : 'color: #64748B;' %> font-size: 0.75rem;">
            <%= @stats[:failed_connections] > 0 ? "#{@stats[:failed_connections]} failing" : 'All healthy' %>
          </small>
        </div>
      </div>
    </div>

    <div class="admin-card">
      <div style="display: flex; align-items: center; gap: 1rem;">
        <div style="width: 3rem; height: 3rem; border-radius: 0.75rem; background: rgba(234, 179, 8, 0.1); border: 1px solid rgba(234, 179, 8, 0.2); display: flex; align-items: center; justify-content: center;">
          <i data-lucide="activity" style="width: 1.5rem; height: 1.5rem; color: rgb(250, 204, 21);"></i>
        </div>
        <div>
          <p style="color: #94A3B8; font-size: 0.875rem; margin: 0;">API Calls Today</p>
          <h3 style="color: white; font-size: 1.875rem; font-weight: 600; margin: 0;"><%= number_with_delimiter(@stats[:api_calls_today]) %></h3>
          <small style="color: #64748B; font-size: 0.75rem;">External API calls</small>
        </div>
      </div>
    </div>
  </div>

  <!-- Two Column Layout -->
  <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 2rem; margin-bottom: 2rem;">
    <!-- Integration Health -->
    <div class="admin-card">
      <h3 class="card-title">
        <i data-lucide="heart-pulse" style="width: 1.25rem; height: 1.25rem; display: inline-block; vertical-align: middle; margin-right: 0.5rem;"></i>
        Integration Health
      </h3>
      <% if @failing_connections.any? %>
        <div style="display: flex; flex-direction: column; gap: 0.75rem;">
          <% @failing_connections.each do |connection| %>
            <div style="padding: 1rem; background: #0F172A; border: 1px solid #1E293B; border-radius: 0.5rem; display: flex; justify-content: space-between; align-items: center;">
              <div>
                <h6 style="color: white; margin: 0 0 0.25rem 0; font-weight: 600;"><%= connection.name %></h6>
                <small style="color: #94A3B8; font-size: 0.875rem;">
                  <%= connection.integration.name %> - <%= connection.entity.name %>
                </small>
              </div>
              <span class="admin-badge admin-badge-offline">FAILING</span>
            </div>
          <% end %>
        </div>
      <% else %>
        <div class="admin-empty-state" style="padding: 2rem 0;">
          <div class="empty-icon" style="margin-bottom: 1rem;">
            <i data-lucide="check-circle" style="width: 3rem; height: 3rem; color: rgb(74, 222, 128);"></i>
          </div>
          <p class="empty-title" style="margin: 0; color: #94A3B8;">All connections are healthy</p>
        </div>
      <% end %>
    </div>

    <!-- Recent Activity -->
    <div class="admin-card">
      <h3 class="card-title">
        <i data-lucide="history" style="width: 1.25rem; height: 1.25rem; display: inline-block; vertical-align: middle; margin-right: 0.5rem;"></i>
        Recent Activity
      </h3>
      <% if @recent_admin_activity.any? %>
        <div style="display: flex; flex-direction: column; gap: 0.75rem;">
          <% @recent_admin_activity.each do |activity| %>
            <div style="padding: 1rem; background: #0F172A; border: 1px solid #1E293B; border-radius: 0.5rem;">
              <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 0.25rem;">
                <h6 style="color: white; margin: 0; font-weight: 600;"><%= activity.action.humanize %></h6>
                <small style="color: #64748B; font-size: 0.75rem;"><%= time_ago_in_words(activity.created_at) %> ago</small>
              </div>
              <small style="color: #94A3B8; font-size: 0.875rem;">
                by <%= activity.admin_user.full_name %>
              </small>
            </div>
          <% end %>
        </div>
      <% else %>
        <div class="admin-empty-state" style="padding: 2rem 0;">
          <div class="empty-icon" style="margin-bottom: 1rem;">
            <i data-lucide="clock" style="width: 3rem; height: 3rem; color: #64748B;"></i>
          </div>
          <p class="empty-title" style="margin: 0; color: #94A3B8;">No recent activity</p>
        </div>
      <% end %>
    </div>
  </div>

  <!-- Quick Actions -->
  <div class="admin-card">
    <h3 class="card-title">
      <i data-lucide="zap" style="width: 1.25rem; height: 1.25rem; display: inline-block; vertical-align: middle; margin-right: 0.5rem;"></i>
      Quick Actions
    </h3>
    <div style="display: flex; flex-wrap: wrap; gap: 0.75rem;">
      <%= link_to dashboard_admin_agent_collaboration_index_path, class: 'admin-btn admin-btn-outline' do %>
        <i data-lucide="network"></i>
        <span>Agent Collaboration</span>
      <% end %>
      <%= link_to admin_integrations_path, class: 'admin-btn admin-btn-outline' do %>
        <i data-lucide="plug"></i>
        <span>Manage Integrations</span>
      <% end %>
      <%= link_to admin_connections_path, class: 'admin-btn admin-btn-outline' do %>
        <i data-lucide="link"></i>
        <span>View Connections</span>
      <% end %>
      <%= link_to admin_users_path, class: 'admin-btn admin-btn-outline' do %>
        <i data-lucide="users"></i>
        <span>Manage Users</span>
      <% end %>
      <%= link_to admin_observability_ai_usage_path, class: 'admin-btn admin-btn-outline' do %>
        <i data-lucide="bar-chart-3"></i>
        <span>AI Usage Stats</span>
      <% end %>
    </div>
  </div>
</div>

<script>
  document.addEventListener('turbo:load', () => {
    lucide.createIcons();
  });

  document.addEventListener('DOMContentLoaded', () => {
    lucide.createIcons();
  });
</script>
