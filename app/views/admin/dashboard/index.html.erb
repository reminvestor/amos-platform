<div class="admin-p-xl">
  <!-- Page Header -->
  <div class="admin-page-header admin-mb-xl">
    <div class="header-left">
      <div class="header-icon admin-icon-gradient-purple">
        <i data-lucide="layout-dashboard" class="admin-text-primary"></i>
      </div>
      <div class="header-text">
        <h1>Admin Dashboard</h1>
        <p>Monitor platform activity and system health</p>
      </div>
    </div>
  </div>

  <!-- Stats Cards -->
  <div class="admin-stats-grid admin-mb-xl">
    <div class="admin-card">
      <div class="admin-flex admin-items-center admin-flex-gap-md">
        <div class="admin-stat-icon purple-gradient">
          <i data-lucide="users" class="admin-icon-lg admin-text-primary"></i>
        </div>
        <div>
          <p class="admin-stat-label">Total Users</p>
          <h3 class="admin-stat-value"><%= @stats[:total_users] %></h3>
          <small class="admin-text-muted admin-text-xs">Active accounts</small>
        </div>
      </div>
    </div>

    <div class="admin-card">
      <div class="admin-flex admin-items-center admin-flex-gap-md">
        <div class="admin-stat-icon info">
          <i data-lucide="plug" class="admin-icon-lg admin-text-info"></i>
        </div>
        <div>
          <p class="admin-stat-label">Integrations</p>
          <h3 class="admin-stat-value"><%= @stats[:total_integrations] %></h3>
          <small class="admin-text-muted admin-text-xs">Available integrations</small>
        </div>
      </div>
    </div>

    <div class="admin-card">
      <div class="admin-flex admin-items-center admin-flex-gap-md">
        <div class="admin-stat-icon success">
          <i data-lucide="link" class="admin-icon-lg admin-text-success"></i>
        </div>
        <div>
          <p class="admin-stat-label">Active Connections</p>
          <h3 class="admin-stat-value"><%= @stats[:active_connections] %></h3>
          <small class="admin-text-xs <%= @stats[:failed_connections] > 0 ? 'admin-text-error' : 'admin-text-muted' %>">
            <%= @stats[:failed_connections] > 0 ? "#{@stats[:failed_connections]} failing" : 'All healthy' %>
          </small>
        </div>
      </div>
    </div>

    <div class="admin-card">
      <div class="admin-flex admin-items-center admin-flex-gap-md">
        <div class="admin-stat-icon warning">
          <i data-lucide="activity" class="admin-icon-lg admin-text-warning"></i>
        </div>
        <div>
          <p class="admin-stat-label">API Calls Today</p>
          <h3 class="admin-stat-value"><%= number_with_delimiter(@stats[:api_calls_today]) %></h3>
          <small class="admin-text-muted admin-text-xs">External API calls</small>
        </div>
      </div>
    </div>
  </div>

  <!-- Two Column Layout -->
  <div class="admin-content-grid admin-mb-xl">
    <!-- Integration Health -->
    <div class="admin-card">
      <h3 class="card-title">
        <i data-lucide="heart-pulse" class="admin-icon-md admin-inline-block admin-mr-sm"></i>
        Integration Health
      </h3>
      <% if @failing_connections.any? %>
        <div class="admin-flex-col admin-flex-gap-0\.75">
          <% @failing_connections.each do |connection| %>
            <div class="admin-bg-darker admin-border admin-rounded-md admin-p-md admin-flex-between">
              <div>
                <h6 class="admin-text-primary admin-m-0 admin-mb-xs admin-font-semibold"><%= connection.name %></h6>
                <small class="admin-text-secondary admin-text-sm">
                  <%= connection.integration.name %> - <%= connection.entity.name %>
                </small>
              </div>
              <span class="admin-badge admin-badge-offline">FAILING</span>
            </div>
          <% end %>
        </div>
      <% else %>
        <div class="admin-empty-state admin-p-xl">
          <div class="empty-icon admin-mb-md">
            <i data-lucide="check-circle" class="admin-icon-xl admin-text-success"></i>
          </div>
          <p class="admin-m-0 admin-text-secondary">All connections are healthy</p>
        </div>
      <% end %>
    </div>

    <!-- Recent Activity -->
    <div class="admin-card">
      <h3 class="card-title">
        <i data-lucide="history" class="admin-icon-md admin-inline-block admin-mr-sm"></i>
        Recent Activity
      </h3>
      <% if @recent_admin_activity.any? %>
        <div class="admin-flex-col admin-flex-gap-0\.75">
          <% @recent_admin_activity.each do |activity| %>
            <div class="admin-bg-darker admin-border admin-rounded-md admin-p-md">
              <div class="admin-flex-between admin-mb-xs">
                <h6 class="admin-text-primary admin-m-0 admin-font-semibold"><%= activity.action.humanize %></h6>
                <small class="admin-text-muted admin-text-xs"><%= time_ago_in_words(activity.created_at) %> ago</small>
              </div>
              <small class="admin-text-secondary admin-text-sm">
                by <%= activity.admin_user.full_name %>
              </small>
            </div>
          <% end %>
        </div>
      <% else %>
        <div class="admin-empty-state admin-p-xl">
          <div class="empty-icon admin-mb-md">
            <i data-lucide="clock" class="admin-icon-xl admin-text-muted"></i>
          </div>
          <p class="admin-m-0 admin-text-secondary">No recent activity</p>
        </div>
      <% end %>
    </div>
  </div>

  <!-- Quick Actions -->
  <div class="admin-card">
    <h3 class="card-title">
      <i data-lucide="zap" class="admin-icon-md admin-inline-block admin-mr-sm"></i>
      Quick Actions
    </h3>
    <div class="admin-flex admin-flex-wrap admin-flex-gap-0\.75">
      <%= link_to dashboard_admin_agent_collaboration_index_path, class: 'admin-btn admin-btn-outline' do %>
        <i data-lucide="network"></i>
        <span>Agent Collaboration</span>
      <% end %>
      <%= link_to admin_integrations_path, class: 'admin-btn admin-btn-outline' do %>
        <i data-lucide="plug"></i>
        <span>Manage Integrations</span>
      <% end %>
      <%= link_to admin_connections_path, class: 'admin-btn admin-btn-outline' do %>
        <i data-lucide="link"></i>
        <span>View Connections</span>
      <% end %>
      <%= link_to admin_users_path, class: 'admin-btn admin-btn-outline' do %>
        <i data-lucide="users"></i>
        <span>Manage Users</span>
      <% end %>
      <%= link_to admin_observability_ai_usage_path, class: 'admin-btn admin-btn-outline' do %>
        <i data-lucide="bar-chart-3"></i>
        <span>AI Usage Stats</span>
      <% end %>
    </div>
  </div>
</div>

<script>
  document.addEventListener('turbo:load', () => {
    lucide.createIcons();
  });

  document.addEventListener('DOMContentLoaded', () => {
    lucide.createIcons();
  });
</script>
