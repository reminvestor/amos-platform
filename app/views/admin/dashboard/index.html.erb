<div class="container-fluid">
  <div class="row">
    <div class="col-12">
      <h1 class="mb-4">
        <i class="fas fa-tachometer-alt"></i> Admin Dashboard
      </h1>
    </div>
  </div>

  <!-- Quick Stats -->
  <div class="row mb-4">
    <div class="col-md-3 mb-3">
      <div class="card bg-secondary text-white">
        <div class="card-body">
          <h5 class="card-title">Total Users</h5>
          <h2 class="mb-0"><%= @stats[:total_users] %></h2>
          <small class="text-muted">Active accounts</small>
        </div>
      </div>
    </div>

    <div class="col-md-3 mb-3">
      <div class="card bg-secondary text-white">
        <div class="card-body">
          <h5 class="card-title">Integrations</h5>
          <h2 class="mb-0"><%= @stats[:total_integrations] %></h2>
          <small class="text-muted">Available integrations</small>
        </div>
      </div>
    </div>

    <div class="col-md-3 mb-3">
      <div class="card bg-secondary text-white">
        <div class="card-body">
          <h5 class="card-title">Active Connections</h5>
          <h2 class="mb-0"><%= @stats[:active_connections] %></h2>
          <small class="text-muted">
            <% if @stats[:failed_connections] > 0 %>
              <span class="text-danger"><%= @stats[:failed_connections] %> failing</span>
            <% else %>
              All healthy
            <% end %>
          </small>
        </div>
      </div>
    </div>

    <div class="col-md-3 mb-3">
      <div class="card bg-secondary text-white">
        <div class="card-body">
          <h5 class="card-title">API Calls Today</h5>
          <h2 class="mb-0"><%= number_with_delimiter(@stats[:api_calls_today]) %></h2>
          <small class="text-muted">External API calls</small>
        </div>
      </div>
    </div>
  </div>

  <!-- Integration Health -->
  <div class="row mb-4">
    <div class="col-md-6">
      <div class="card bg-secondary">
        <div class="card-header">
          <h5 class="mb-0">Integration Health</h5>
        </div>
        <div class="card-body">
          <% if @failing_connections.any? %>
            <div class="list-group">
              <% @failing_connections.each do |connection| %>
                <div class="list-group-item bg-dark d-flex justify-content-between align-items-center">
                  <div>
                    <h6 class="mb-1 text-white"><%= connection.name %></h6>
                    <small class="text-muted">
                      <%= connection.integration.name %> - 
                      <%= connection.entity.name %>
                    </small>
                  </div>
                  <span class="badge bg-danger">Failing</span>
                </div>
              <% end %>
            </div>
          <% else %>
            <p class="text-muted mb-0">All connections are healthy</p>
          <% end %>
        </div>
      </div>
    </div>

    <div class="col-md-6">
      <div class="card bg-secondary">
        <div class="card-header">
          <h5 class="mb-0">Recent Activity</h5>
        </div>
        <div class="card-body">
          <% if @recent_admin_activity.any? %>
            <div class="list-group">
              <% @recent_admin_activity.each do |activity| %>
                <div class="list-group-item bg-dark">
                  <div class="d-flex w-100 justify-content-between">
                    <h6 class="mb-1 text-white"><%= activity.action.humanize %></h6>
                    <small class="text-muted"><%= time_ago_in_words(activity.created_at) %> ago</small>
                  </div>
                  <small class="text-muted">
                    by <%= activity.admin_user.full_name %>
                  </small>
                </div>
              <% end %>
            </div>
          <% else %>
            <p class="text-muted mb-0">No recent activity</p>
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <!-- Quick Actions -->
  <div class="row">
    <div class="col-12">
      <h4 class="mb-3">Quick Actions</h4>
      <div class="btn-group" role="group">
        <%= link_to admin_integrations_path, class: "btn btn-outline-primary" do %>
          <i class="fas fa-plug"></i> Manage Integrations
        <% end %>
        <%= link_to admin_connections_path, class: "btn btn-outline-primary" do %>
          <i class="fas fa-link"></i> View Connections
        <% end %>
        <%= link_to admin_users_path, class: "btn btn-outline-primary" do %>
          <i class="fas fa-users"></i> Manage Users
        <% end %>
        <%= link_to admin_observability_ai_usage_path, class: "btn btn-outline-primary" do %>
          <i class="fas fa-chart-line"></i> AI Usage Stats
        <% end %>
      </div>
    </div>
  </div>
</div>
