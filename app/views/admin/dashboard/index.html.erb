<div class="admin-content">
  <div class="admin-p-xl">
    <%# Page Header %>
    <div class="admin-page-header">
      <div class="header-left">
        <div class="header-icon">
          <%= admin_icon('layout-dashboard', size: :lg) %>
        </div>
        <div class="header-text">
          <h1>Admin Dashboard</h1>
          <p>Monitor platform activity and system health</p>
        </div>
      </div>
    </div>

    <%# Stats Cards %>
    <div class="admin-stats-grid admin-mb-xl">
      <%= render 'admin/shared/stat_card',
          icon: 'users',
          label: 'Total Users',
          value: @stats[:total_users],
          subtitle: 'Active accounts',
          variant: 'purple-gradient' %>

      <%= render 'admin/shared/stat_card',
          icon: 'plug',
          label: 'Integrations',
          value: @stats[:total_integrations],
          subtitle: 'Available integrations',
          variant: 'info' %>

      <%= render 'admin/shared/stat_card',
          icon: 'link',
          label: 'Active Connections',
          value: @stats[:active_connections],
          subtitle: (@stats[:failed_connections] > 0 ? "#{@stats[:failed_connections]} failing" : 'All healthy'),
          subtitle_class: (@stats[:failed_connections] > 0 ? 'text-danger' : ''),
          variant: 'success' %>

      <%= render 'admin/shared/stat_card',
          icon: 'activity',
          label: 'API Calls Today',
          value: number_with_delimiter(@stats[:api_calls_today]),
          subtitle: 'External API calls',
          variant: 'warning' %>
    </div>

    <%# Two Column Layout %>
    <div class="admin-grid-2 admin-mb-xl">
      <%# Integration Health %>
      <div class="admin-card">
        <h3 class="card-title">Integration Health</h3>
        <% if @failing_connections.any? %>
          <div class="admin-flex admin-flex-col admin-flex-gap-0.75">
            <% @failing_connections.each do |connection| %>
              <div class="admin-p-md admin-bg-darker admin-border admin-rounded-md admin-flex admin-justify-between admin-items-center">
                <div>
                  <h6 class="admin-text-primary admin-m-0 admin-mb-xs admin-font-semibold"><%= connection.name %></h6>
                  <small class="admin-text-secondary admin-text-sm">
                    <%= connection.integration.name %> - <%= connection.entity.name %>
                  </small>
                </div>
                <span class="admin-badge admin-badge-offline">FAILING</span>
              </div>
            <% end %>
          </div>
        <% else %>
          <div class="admin-empty-state">
            <div class="empty-icon">
              <%= admin_icon('check-circle', size: :xl) %>
            </div>
            <p class="empty-title admin-mb-0">All connections are healthy</p>
          </div>
        <% end %>
      </div>

      <%# Recent Activity %>
      <div class="admin-card">
        <h3 class="card-title">Recent Activity</h3>
        <% if @recent_admin_activity.any? %>
          <div class="admin-flex admin-flex-col admin-flex-gap-0.75">
            <% @recent_admin_activity.each do |activity| %>
              <div class="admin-p-md admin-bg-darker admin-border admin-rounded-md">
                <div class="admin-flex admin-justify-between admin-items-start admin-mb-xs">
                  <h6 class="admin-text-primary admin-m-0 admin-font-semibold"><%= activity.action.humanize %></h6>
                  <small class="admin-text-secondary admin-text-sm"><%= time_ago_in_words(activity.created_at) %> ago</small>
                </div>
                <small class="admin-text-secondary admin-text-sm">
                  by <%= activity.admin_user.full_name %>
                </small>
              </div>
            <% end %>
          </div>
        <% else %>
          <div class="admin-empty-state">
            <div class="empty-icon">
              <%= admin_icon('clock', size: :xl) %>
            </div>
            <p class="empty-title admin-mb-0">No recent activity</p>
          </div>
        <% end %>
      </div>
    </div>

    <%# Quick Actions %>
    <div class="admin-card">
      <h3 class="card-title">Quick Actions</h3>
      <div class="admin-flex admin-flex-wrap admin-flex-gap-0.75">
        <%= link_to dashboard_admin_agent_lightning_index_path, class: 'admin-btn admin-btn-outline' do %>
          <%= admin_icon('zap', size: :sm) %>
          <span>Agent Lightning</span>
        <% end %>
        <%= link_to admin_integrations_path, class: 'admin-btn admin-btn-outline' do %>
          <%= admin_icon('plug', size: :sm) %>
          <span>Manage Integrations</span>
        <% end %>
        <%= link_to admin_connections_path, class: 'admin-btn admin-btn-outline' do %>
          <%= admin_icon('link', size: :sm) %>
          <span>View Connections</span>
        <% end %>
        <%= link_to admin_users_path, class: 'admin-btn admin-btn-outline' do %>
          <%= admin_icon('users', size: :sm) %>
          <span>Manage Users</span>
        <% end %>
        <%= link_to admin_observability_ai_usage_path, class: 'admin-btn admin-btn-outline' do %>
          <%= admin_icon('bar-chart-3', size: :sm) %>
          <span>AI Usage Stats</span>
        <% end %>
      </div>
    </div>
  </div>
</div>

<script>
  document.addEventListener('turbo:load', () => {
    lucide.createIcons();
  });

  document.addEventListener('DOMContentLoaded', () => {
    lucide.createIcons();
  });
</script>
