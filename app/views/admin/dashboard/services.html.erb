<div style="padding: 2rem;">
  <!-- Page Header -->
  <div class="admin-page-header" style="margin-bottom: 2rem;">
    <div class="header-left">
      <div class="header-icon" style="background: linear-gradient(135deg, #8B5CF6 0%, #6D28D9 100%);">
        <i data-lucide="activity" style="color: white;"></i>
      </div>
      <div class="header-text">
        <h1>Services Health</h1>
        <p>Monitor system health and service status</p>
      </div>
    </div>

    <div class="header-actions">
      <% if @overall_status == :healthy %>
        <div style="display: flex; align-items: center; gap: 0.5rem; background: rgba(34, 197, 94, 0.1); border: 1px solid rgba(34, 197, 94, 0.2); color: rgb(74, 222, 128); padding: 0.5rem 1rem; border-radius: 9999px; font-weight: 600; font-size: 0.875rem;">
          <i data-lucide="check-circle" style="width: 1rem; height: 1rem;"></i>
          <span>All Systems Operational</span>
        </div>
      <% elsif @overall_status == :warning %>
        <div style="display: flex; align-items: center; gap: 0.5rem; background: rgba(234, 179, 8, 0.1); border: 1px solid rgba(234, 179, 8, 0.2); color: rgb(250, 204, 21); padding: 0.5rem 1rem; border-radius: 9999px; font-weight: 600; font-size: 0.875rem;">
          <i data-lucide="alert-triangle" style="width: 1rem; height: 1rem;"></i>
          <span>Some Issues</span>
        </div>
      <% else %>
        <div style="display: flex; align-items: center; gap: 0.5rem; background: rgba(239, 68, 68, 0.1); border: 1px solid rgba(239, 68, 68, 0.2); color: rgb(248, 113, 113); padding: 0.5rem 1rem; border-radius: 9999px; font-weight: 600; font-size: 0.875rem;">
          <i data-lucide="x-circle" style="width: 1rem; height: 1rem;"></i>
          <span>Systems Down</span>
        </div>
      <% end %>
    </div>
  </div>

  <!-- Service Cards Grid -->
  <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 1.5rem; margin-bottom: 2rem;">
    <% @services.each do |service_key, service| %>
      <div class="admin-card" style="position: relative;">
        <%# Service Header %>
        <div style="display: flex; align-items: flex-start; justify-content: space-between; margin-bottom: 1rem;">
          <div>
            <h3 style="color: white; font-weight: 600; margin: 0 0 0.25rem 0; font-size: 1.125rem;">
              <%= service[:name] %>
            </h3>
            <p style="color: #64748B; font-size: 0.75rem; margin: 0;">
              Last checked: <%= Time.current.strftime("%l:%M%p").strip %>
            </p>
          </div>
          <div style="width: 2.5rem; height: 2.5rem; border-radius: 0.5rem; display: flex; align-items: center; justify-content: center; <%= service[:status] == :healthy ? 'background: rgba(34, 211, 238, 0.1);' : service[:status] == :warning ? 'background: rgba(251, 191, 36, 0.1);' : 'background: rgba(239, 68, 68, 0.1);' %>">
            <% if service[:status] == :healthy %>
              <i data-lucide="check-circle" style="width: 1.25rem; height: 1.25rem; color: #22D3EE;"></i>
            <% elsif service[:status] == :warning %>
              <i data-lucide="alert-triangle" style="width: 1.25rem; height: 1.25rem; color: rgb(250, 204, 21);"></i>
            <% elsif service[:status] == :unhealthy %>
              <i data-lucide="x-circle" style="width: 1.25rem; height: 1.25rem; color: rgb(248, 113, 113);"></i>
            <% else %>
              <i data-lucide="help-circle" style="width: 1.25rem; height: 1.25rem; color: #64748B;"></i>
            <% end %>
          </div>
        </div>

        <%# Status Badge %>
        <div style="margin-bottom: 1rem;">
          <% if service[:status] == :healthy %>
            <span class="admin-badge admin-badge-online">HEALTHY</span>
          <% elsif service[:status] == :warning %>
            <span class="admin-badge admin-badge-warning">WARNING</span>
          <% elsif service[:status] == :unhealthy %>
            <span class="admin-badge admin-badge-offline">UNHEALTHY</span>
          <% else %>
            <span class="admin-badge admin-badge-secondary">UNKNOWN</span>
          <% end %>
        </div>

        <%# Error Message %>
        <% if service[:error].present? %>
          <div style="margin-top: 1rem; padding: 0.75rem; background: rgba(239, 68, 68, 0.1); border: 1px solid rgba(239, 68, 68, 0.2); border-radius: 0.375rem;">
            <p style="color: rgb(248, 113, 113); font-size: 0.875rem; margin: 0; line-height: 1.5;">
              <%= service[:error] %>
            </p>
          </div>
        <% end %>

        <%# Service Details %>
        <% if service[:details].present? && service[:details].any? && service[:error].blank? %>
          <div style="border-top: 1px solid #1E293B; padding-top: 1rem; margin-top: 1rem;">
            <% service[:details].first(3).each do |key, value| %>
              <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
                <span style="color: #64748B; font-size: 0.875rem;"><%= key.to_s.titleize %></span>
                <span style="color: white; font-size: 0.875rem; font-weight: 500;"><%= value %></span>
              </div>
            <% end %>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>

  <%# System Information Card %>
  <div class="admin-card">
    <div style="margin-bottom: 1.5rem;">
      <h3 style="color: white; font-size: 1.125rem; font-weight: 600; margin: 0;">System Information</h3>
    </div>
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1.5rem;">
      <div>
        <p style="color: #64748B; font-size: 0.875rem; margin: 0 0 0.25rem 0;">Rails Version</p>
        <p style="color: white; font-weight: 600; margin: 0;"><%= Rails.version %></p>
      </div>
      <div>
        <p style="color: #64748B; font-size: 0.875rem; margin: 0 0 0.25rem 0;">Ruby Version</p>
        <p style="color: white; font-weight: 600; margin: 0;"><%= RUBY_VERSION %></p>
      </div>
      <div>
        <p style="color: #64748B; font-size: 0.875rem; margin: 0 0 0.25rem 0;">Environment</p>
        <p style="color: white; font-weight: 600; margin: 0;"><%= Rails.env.titleize %></p>
      </div>
      <div>
        <p style="color: #64748B; font-size: 0.875rem; margin: 0 0 0.25rem 0;">Server Time</p>
        <p style="color: white; font-weight: 600; margin: 0;"><%= Time.current.strftime("%Y-%m-%d %H:%M:%S %Z") %></p>
      </div>
    </div>
  </div>
</div>

<script>
  document.addEventListener('turbo:load', () => {
    lucide.createIcons();
  });

  document.addEventListener('DOMContentLoaded', () => {
    lucide.createIcons();
  });
</script>
