<div class="admin-p-xl">
  <!-- Page Header -->
  <div class="admin-page-header admin-mb-xl">
    <div class="header-left">
      <div class="header-icon admin-icon-gradient-purple">
        <i data-lucide="activity" class="admin-text-primary"></i>
      </div>
      <div class="header-text">
        <h1>Services Health</h1>
        <p>Monitor system health and service status</p>
      </div>
    </div>

    <div class="header-actions">
      <% if @overall_status == :healthy %>
        <div class="admin-status-pill admin-status-pill-success">
          <i data-lucide="check-circle" class="admin-icon-sm"></i>
          <span>All Systems Operational</span>
        </div>
      <% elsif @overall_status == :warning %>
        <div class="admin-status-pill admin-status-pill-warning">
          <i data-lucide="alert-triangle" class="admin-icon-sm"></i>
          <span>Some Issues</span>
        </div>
      <% else %>
        <div class="admin-status-pill admin-status-pill-error">
          <i data-lucide="x-circle" class="admin-icon-sm"></i>
          <span>Systems Down</span>
        </div>
      <% end %>
    </div>
  </div>

  <!-- Service Cards Grid -->
  <div class="admin-content-grid admin-mb-xl">
    <% @services.each do |service_key, service| %>
      <div class="admin-card admin-relative">
        <%# Service Header %>
        <div class="admin-flex-between admin-items-start admin-mb-md">
          <div>
            <h3 class="admin-text-primary admin-font-semibold admin-m-0 admin-mb-xs admin-text-lg">
              <%= service[:name] %>
            </h3>
            <p class="admin-text-muted admin-text-xs admin-m-0">
              Last checked: <%= Time.current.strftime("%l:%M%p").strip %>
            </p>
          </div>
          <div class="admin-service-status-icon <%= service[:status] == :healthy ? 'admin-service-icon-healthy' : service[:status] == :warning ? 'admin-service-icon-warning' : 'admin-service-icon-error' %>">
            <% if service[:status] == :healthy %>
              <i data-lucide="check-circle" class="admin-icon-md admin-text-info"></i>
            <% elsif service[:status] == :warning %>
              <i data-lucide="alert-triangle" class="admin-icon-md admin-text-warning"></i>
            <% elsif service[:status] == :unhealthy %>
              <i data-lucide="x-circle" class="admin-icon-md admin-text-error"></i>
            <% else %>
              <i data-lucide="help-circle" class="admin-icon-md admin-text-muted"></i>
            <% end %>
          </div>
        </div>

        <%# Status Badge %>
        <div class="admin-mb-md">
          <% if service[:status] == :healthy %>
            <span class="admin-badge admin-badge-online">HEALTHY</span>
          <% elsif service[:status] == :warning %>
            <span class="admin-badge admin-badge-warning">WARNING</span>
          <% elsif service[:status] == :unhealthy %>
            <span class="admin-badge admin-badge-offline">UNHEALTHY</span>
          <% else %>
            <span class="admin-badge admin-badge-secondary">UNKNOWN</span>
          <% end %>
        </div>

        <%# Error Message %>
        <% if service[:error].present? %>
          <div class="admin-error-box admin-mt-md">
            <p class="admin-text-error admin-text-sm admin-m-0 admin-leading-relaxed">
              <%= service[:error] %>
            </p>
          </div>
        <% end %>

        <%# Service Details %>
        <% if service[:details].present? && service[:details].any? && service[:error].blank? %>
          <div class="admin-border-t admin-mt-md admin-pt-lg">
            <% service[:details].first(3).each do |key, value| %>
              <div class="admin-flex-between admin-items-center admin-mb-sm">
                <span class="admin-text-muted admin-text-sm"><%= key.to_s.titleize %></span>
                <span class="admin-text-primary admin-text-sm admin-font-medium"><%= value %></span>
              </div>
            <% end %>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>

  <%# System Information Card %>
  <div class="admin-card">
    <div class="admin-mb-lg">
      <h3 class="admin-text-primary admin-text-lg admin-font-semibold admin-m-0">System Information</h3>
    </div>
    <div class="admin-stats-grid">
      <div>
        <p class="admin-text-muted admin-text-sm admin-m-0 admin-mb-xs">Rails Version</p>
        <p class="admin-text-primary admin-font-semibold admin-m-0"><%= Rails.version %></p>
      </div>
      <div>
        <p class="admin-text-muted admin-text-sm admin-m-0 admin-mb-xs">Ruby Version</p>
        <p class="admin-text-primary admin-font-semibold admin-m-0"><%= RUBY_VERSION %></p>
      </div>
      <div>
        <p class="admin-text-muted admin-text-sm admin-m-0 admin-mb-xs">Environment</p>
        <p class="admin-text-primary admin-font-semibold admin-m-0"><%= Rails.env.titleize %></p>
      </div>
      <div>
        <p class="admin-text-muted admin-text-sm admin-m-0 admin-mb-xs">Server Time</p>
        <p class="admin-text-primary admin-font-semibold admin-m-0"><%= Time.current.strftime("%Y-%m-%d %H:%M:%S %Z") %></p>
      </div>
    </div>
  </div>
</div>

<script>
  document.addEventListener('turbo:load', () => {
    lucide.createIcons();
  });

  document.addEventListener('DOMContentLoaded', () => {
    lucide.createIcons();
  });
</script>
