<div class="admin-content">
  <div class="admin-p-xl">
    <%# Page Header %>
    <div class="admin-page-header">
      <div class="header-left">
        <div class="header-icon">
          <%= admin_icon('activity', size: :lg) %>
        </div>
        <div class="header-text">
          <h1>Services Health</h1>
          <p>Monitor system health and service status</p>
        </div>
      </div>

      <div class="header-actions">
        <% if @overall_status == :healthy %>
          <span class="admin-badge admin-badge-online admin-badge-lg admin-text-sm">
            <%= admin_icon('check-circle', size: :md, class: 'icon-with-spacing') %> All Systems Operational
          </span>
        <% elsif @overall_status == :warning %>
          <span class="admin-badge admin-badge-warning admin-badge-lg admin-text-sm">
            <%= admin_icon('alert-triangle', size: :md, class: 'icon-with-spacing') %> Some Issues
          </span>
        <% else %>
          <span class="admin-badge admin-badge-offline admin-badge-lg admin-text-sm">
            <%= admin_icon('x-circle', size: :md, class: 'icon-with-spacing') %> Systems Down
          </span>
        <% end %>
      </div>
    </div>

    <%# Service Cards Grid %>
    <div class="admin-service-grid admin-mb-xl">
      <% @services.each do |service_key, service| %>
        <div class="admin-card admin-relative">
          <%# Service Header %>
          <div class="admin-flex admin-items-start admin-justify-between admin-mb-md">
            <div>
              <h3 class="admin-text-primary admin-font-semibold admin-m-0 admin-mb-xs">
                <%= service[:name] %>
              </h3>
              <p class="admin-text-muted admin-text-xs admin-m-0">
                Last checked: <%= Time.current.strftime("%l:%M%p").strip %>
              </p>
            </div>
            <div class="admin-service-icon-box" style="<%= service[:status] == :healthy ? 'background: rgba(34, 211, 238, 0.1);' : service[:status] == :warning ? 'background: rgba(251, 191, 36, 0.1);' : 'background: rgba(239, 68, 68, 0.1);' %>">
              <% if service[:status] == :healthy %>
                <%= admin_icon('check-circle', size: :md, class: 'text-info') %>
              <% elsif service[:status] == :warning %>
                <%= admin_icon('alert-triangle', size: :md, class: 'admin-text-warning') %>
              <% elsif service[:status] == :unhealthy %>
                <%= admin_icon('x-circle', size: :md, class: 'admin-text-error') %>
              <% else %>
                <%= admin_icon('help-circle', size: :md, class: 'admin-text-muted') %>
              <% end %>
            </div>
          </div>

          <%# Status Badge %>
          <div class="admin-mb-md">
            <% if service[:status] == :healthy %>
              <span class="admin-badge admin-badge-online">HEALTHY</span>
            <% elsif service[:status] == :warning %>
              <span class="admin-badge admin-badge-warning">WARNING</span>
            <% elsif service[:status] == :unhealthy %>
              <span class="admin-badge admin-badge-offline">UNHEALTHY</span>
            <% else %>
              <span class="admin-badge admin-badge-default">UNKNOWN</span>
            <% end %>
          </div>

          <%# Error Message %>
          <% if service[:error].present? %>
            <div class="admin-error-box admin-mt-md">
              <p class="admin-text-error admin-text-sm admin-leading-relaxed admin-m-0">
                <%= service[:error] %>
              </p>
            </div>
          <% end %>

          <%# Service Details %>
          <% if service[:details].present? && service[:details].any? && service[:error].blank? %>
            <div class="admin-border-t admin-pt-md admin-mt-md">
              <% service[:details].first(3).each do |key, value| %>
                <div class="admin-flex admin-justify-between admin-items-center admin-mb-sm">
                  <span class="admin-text-muted admin-text-sm"><%= key.to_s.titleize %></span>
                  <span class="admin-text-primary admin-text-sm admin-font-medium"><%= value %></span>
                </div>
              <% end %>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>

    <%# System Information Card %>
    <div class="admin-card">
      <div class="admin-mb-lg">
        <h3 class="admin-text-primary admin-text-lg admin-font-semibold admin-m-0">System Information</h3>
      </div>
      <div class="admin-grid-4">
        <div>
          <p class="admin-text-muted admin-text-sm admin-m-0 admin-mb-xs">Rails Version</p>
          <p class="admin-text-primary admin-font-semibold admin-m-0"><%= Rails.version %></p>
        </div>
        <div>
          <p class="admin-text-muted admin-text-sm admin-m-0 admin-mb-xs">Ruby Version</p>
          <p class="admin-text-primary admin-font-semibold admin-m-0"><%= RUBY_VERSION %></p>
        </div>
        <div>
          <p class="admin-text-muted admin-text-sm admin-m-0 admin-mb-xs">Environment</p>
          <p class="admin-text-primary admin-font-semibold admin-m-0"><%= Rails.env.titleize %></p>
        </div>
        <div>
          <p class="admin-text-muted admin-text-sm admin-m-0 admin-mb-xs">Server Time</p>
          <p class="admin-text-primary admin-font-semibold admin-m-0"><%= Time.current.strftime("%Y-%m-%d %H:%M:%S %Z") %></p>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  document.addEventListener('turbo:load', () => {
    lucide.createIcons();
  });

  document.addEventListener('DOMContentLoaded', () => {
    lucide.createIcons();
  });
</script>
