<div class="admin-p-xl">
  <!-- Page Header -->
  <div class="admin-page-header admin-mb-xl">
    <div class="header-left">
      <div class="header-icon admin-icon-gradient-purple">
        <i data-lucide="settings" class="admin-text-primary"></i>
      </div>
      <div class="header-text">
        <h1>System Settings</h1>
        <p>Manage system-level API keys and configuration</p>
      </div>
    </div>

    <div class="header-actions">
      <%= button_to "Reset to ENV Defaults", reset_defaults_admin_system_settings_path, method: :post, class: "admin-btn admin-btn-warning", data: { confirm: "Reset all settings to environment variable values?" } do %>
        <i data-lucide="refresh-cw"></i>
        <span>Reset to ENV Defaults</span>
      <% end %>
    </div>
  </div>

  <!-- Warning Alert -->
  <div class="admin-card admin-mb-xl" style="border-left: 4px solid var(--status-warning-text); background: var(--status-warning-bg);">
    <div class="admin-flex admin-items-center admin-flex-gap-md">
      <i data-lucide="alert-triangle" class="admin-text-warning"></i>
      <div>
        <strong class="admin-text-warning">Warning:</strong>
        <span class="admin-text-primary">These settings control critical system functionality. Changes take effect immediately. Incorrect values may break the application.</span>
      </div>
    </div>
  </div>

  <%= form_with url: update_all_admin_system_settings_path, method: :patch, local: true do |f| %>

    <% @categories.each do |category_key, category_name| %>
      <% settings = @settings_by_category[category_key.to_s] %>
      <% next if settings.blank? %>

      <!-- <%= category_name %> Settings -->
      <div class="admin-card admin-mb-lg">
        <div class="admin-flex admin-items-center admin-flex-gap-sm admin-mb-lg" style="border-bottom: 2px solid var(--accent-purple-start); padding-bottom: 0.75rem;">
          <%= category_icon(category_key) %>
          <h5 class="admin-text-primary admin-mb-0"><%= category_name %></h5>
        </div>
        <div class="row g-3">
          <% settings.each do |setting| %>
            <div class="col-sm-6 col-md-4 col-lg-3">
              <div class="admin-mb-md">
                <label class="form-label admin-mb-xs admin-text-sm">
                  <strong class="admin-text-primary"><%= setting.key %></strong>
                  <% if setting.description.present? %>
                    <br><small class="admin-text-muted admin-text-xs"><%= setting.description %></small>
                  <% end %>
                </label>

                <% if setting.is_sensitive? %>
                  <div class="admin-flex admin-flex-gap-xs">
                    <%= password_field_tag "settings[#{setting.id}]",
                        setting.effective_value,
                        class: "admin-input admin-flex-1 password-field",
                        placeholder: "Enter #{setting.key}",
                        autocomplete: "off",
                        id: "setting_#{setting.id}" %>
                    <button class="admin-btn admin-btn-outline toggle-password" type="button"
                            data-target="setting_<%= setting.id %>">
                      <i data-lucide="eye" class="admin-icon-sm"></i>
                    </button>
                  </div>
                  <% if setting.effective_value.present? %>
                    <small class="admin-text-muted admin-text-xs">Current: <%= setting.masked_value %></small>
                  <% end %>
                <% else %>
                  <%= text_field_tag "settings[#{setting.id}]",
                      setting.effective_value,
                      class: "admin-input",
                      placeholder: "Enter #{setting.key}" %>
                <% end %>
              </div>

              <div class="admin-flex admin-flex-between admin-items-center admin-mt-xs">
                <div>
                  <% if setting.using_env_fallback? %>
                    <span class="admin-badge admin-badge-info admin-text-xs" title="Using environment variable">ENV</span>
                  <% elsif setting.effective_value.present? %>
                    <span class="admin-badge admin-badge-success admin-text-xs" title="Set in database">DB</span>
                  <% else %>
                    <span class="admin-badge admin-badge-warning admin-text-xs" title="Not configured">Empty</span>
                  <% end %>
                </div>
                <div>
                  <% if %w[OPENAI_API_KEY DEEPGRAM_API_KEY GITHUB_TOKEN].include?(setting.key) %>
                    <button type="button"
                            class="admin-btn admin-btn-sm admin-btn-outline test-key-btn"
                            data-setting-id="<%= setting.id %>">
                      <i data-lucide="check-circle" class="admin-icon-sm"></i>
                      <span>Test</span>
                    </button>
                  <% end %>
                </div>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>

    <div class="admin-text-right admin-mb-xl">
      <%= f.submit "Save All Settings", class: "admin-btn admin-btn-primary" %>
    </div>
  <% end %>
</div>

<script>
function initPasswordToggles() {
  document.querySelectorAll('.toggle-password').forEach(button => {
    const newButton = button.cloneNode(true);
    button.parentNode.replaceChild(newButton, button);

    newButton.addEventListener('click', function(e) {
      e.preventDefault();

      const targetId = this.getAttribute('data-target');
      const input = document.getElementById(targetId);
      if (!input) return;

      const icon = this.querySelector('i') || this.querySelector('svg') || this.querySelector('[data-lucide]');
      if (!icon) return;

      if (input.type === 'password') {
        input.type = 'text';
        icon.setAttribute('data-lucide', 'eye-off');
      } else {
        input.type = 'password';
        icon.setAttribute('data-lucide', 'eye');
      }

      if (typeof lucide !== 'undefined') {
        lucide.createIcons();
      }
    });
  });

  if (typeof lucide !== 'undefined') {
    lucide.createIcons();
  }
}

function initTestButtons() {
  document.querySelectorAll('.test-key-btn').forEach(button => {
    const newButton = button.cloneNode(true);
    button.parentNode.replaceChild(newButton, button);

    newButton.addEventListener('click', function(e) {
      e.preventDefault();

      const settingId = this.getAttribute('data-setting-id');
      const originalHTML = this.innerHTML;
      this.disabled = true;
      this.innerHTML = '<span class="spinner-border spinner-border-sm"></span> Testing...';

      let csrfTokenInput = document.querySelector('input[name="authenticity_token"]');

      if (!csrfTokenInput) {
        const tokenValue = '<%= form_authenticity_token %>';
        if (!tokenValue || tokenValue === '') {
          showError('CSRF token not found. Please refresh the page.');
          this.disabled = false;
          this.innerHTML = originalHTML;
          return;
        }
        makeRequest(tokenValue);
        return;
      }

      const tokenValue = csrfTokenInput.value;
      makeRequest(tokenValue);

      function makeRequest(token) {
        fetch(`/admin/system_settings/${settingId}/test_key`, {
          method: 'POST',
          headers: {
            'X-CSRF-Token': token,
            'Accept': 'application/json'
          }
        })
        .then(response => response.json())
        .then(data => {
          newButton.disabled = false;
          newButton.innerHTML = originalHTML;

          if (typeof lucide !== 'undefined') {
            lucide.createIcons();
          }

          if (data.success) {
            showSuccess(data.message);
          } else {
            showError(data.message);
          }
        })
        .catch(error => {
          newButton.disabled = false;
          newButton.innerHTML = originalHTML;

          if (typeof lucide !== 'undefined') {
            lucide.createIcons();
          }

          showError('Error testing API key: ' + error);
        });
      }
    });
  });
}

document.addEventListener('DOMContentLoaded', () => {
  initPasswordToggles();
  initTestButtons();
});

document.addEventListener('turbo:load', () => {
  initPasswordToggles();
  initTestButtons();
});
</script>
