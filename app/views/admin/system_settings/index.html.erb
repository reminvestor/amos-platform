<div class="admin-content">
  <div class="admin-p-xl">
    <div class="container-fluid py-3">
  <div class="row mb-3">
    <div class="col-12">
      <div class="d-flex justify-content-between align-items-center mb-3">
        <h1 class="h4 mb-0">
          <%= admin_icon('settings', size: :md, class: 'me-2') %>
          System Settings
        </h1>
        <%= button_to "Reset to ENV Defaults", reset_defaults_admin_system_settings_path, method: :post, class: "btn btn-sm btn-warning", data: { confirm: "Reset all settings to environment variable values?" } %>
      </div>
      <p class="text-muted mb-0 admin-text-sm">Manage system-level API keys and configuration</p>
    </div>
  </div>

  <div class="alert alert-warning mb-3 py-2 admin-text-sm">
    <%= admin_icon('alert-triangle', size: :sm, class: 'me-2') %>
    <strong>Warning:</strong> These settings control critical system functionality. Changes take effect immediately. Incorrect values may break the application.
  </div>

  <%= form_with url: update_all_admin_system_settings_path, method: :patch, local: true do |f| %>

    <% @categories.each do |category_key, category_name| %>
      <% settings = @settings_by_category[category_key.to_s] %>
      <% next if settings.blank? %>

      <!-- <%= category_name %> Settings -->
      <div class="card mb-3">
        <div class="card-header <%= category_color(category_key) %> text-white p-2">
          <h5 class="mb-0 admin-text-base">
            <%= category_icon(category_key) %>
            <%= category_name %>
          </h5>
        </div>
        <div class="card-body p-3">
          <div class="row g-3">
            <% settings.each do |setting| %>
              <div class="col-sm-6 col-md-4 col-lg-3">
                <div class="mb-2">
                  <label class="form-label mb-1 admin-text-sm">
                    <strong><%= setting.key %></strong>
                    <% if setting.description.present? %>
                      <br><small class="text-muted admin-text-xs"><%= setting.description %></small>
                    <% end %>
                  </label>

                  <% if setting.is_sensitive? %>
                    <div class="input-group input-group-sm">
                      <%= password_field_tag "settings[#{setting.id}]",
                          setting.effective_value,
                          class: "form-control font-monospace password-field admin-text-sm",
                          placeholder: "Enter #{setting.key}",
                          autocomplete: "off",
                          id: "setting_#{setting.id}" %>
                      <button class="btn btn-outline-secondary toggle-password py-1 px-2" type="button"
                              data-target="setting_<%= setting.id %>">
                        <%= admin_icon('eye', size: :sm) %>
                      </button>
                    </div>
                    <% if setting.effective_value.present? %>
                      <small class="text-muted admin-text-xs">Current: <%= setting.masked_value %></small>
                    <% end %>
                  <% else %>
                    <%= text_field_tag "settings[#{setting.id}]",
                        setting.effective_value,
                        class: "form-control form-control-sm font-monospace admin-text-sm",
                        placeholder: "Enter #{setting.key}" %>
                  <% end %>
                </div>

                <div class="d-flex justify-content-between align-items-center mt-1">
                  <div>
                    <% if setting.using_env_fallback? %>
                      <span class="badge bg-info admin-text-xs" title="Using environment variable">ENV</span>
                    <% elsif setting.effective_value.present? %>
                      <span class="badge bg-success admin-text-xs" title="Set in database">DB</span>
                    <% else %>
                      <span class="badge bg-warning admin-text-xs" title="Not configured">Empty</span>
                    <% end %>
                  </div>
                  <div>
                    <% if %w[OPENAI_API_KEY DEEPGRAM_API_KEY GITHUB_TOKEN].include?(setting.key) %>
                      <button type="button"
                              class="btn btn-sm btn-outline-primary py-0 px-2 test-key-btn admin-text-xs"
                              data-setting-id="<%= setting.id %>">
                        <%= admin_icon('check-circle', size: :sm) %>
                        <span class="ms-1">Test</span>
                      </button>
                    <% end %>
                  </div>
                </div>
              </div>
            <% end %>
          </div>
        </div>
      </div>
    <% end %>

    <div class="text-end mb-4">
      <%= f.submit "Save All Settings", class: "btn btn-primary" %>
    </div>
  <% end %>

</div>

<script>
function initPasswordToggles() {
  console.log('Initializing password toggles...');

  document.querySelectorAll('.toggle-password').forEach(button => {
    // Remove old listeners by cloning
    const newButton = button.cloneNode(true);
    button.parentNode.replaceChild(newButton, button);

    newButton.addEventListener('click', function(e) {
      e.preventDefault();

      const targetId = this.getAttribute('data-target');
      console.log('Toggle clicked, target:', targetId);

      const input = document.getElementById(targetId);
      if (!input) {
        console.error('Input not found:', targetId);
        return;
      }

      // Lucide replaces <i> with <svg>, so look for either
      const icon = this.querySelector('i') || this.querySelector('svg') || this.querySelector('[data-lucide]');
      if (!icon) {
        console.error('Icon not found in button');
        return;
      }

      console.log('Current input type:', input.type);

      if (input.type === 'password') {
        input.type = 'text';
        // Replace the entire icon element
        icon.setAttribute('data-lucide', 'eye-off');
        console.log('Switched to text');
      } else {
        input.type = 'password';
        // Replace the entire icon element
        icon.setAttribute('data-lucide', 'eye');
        console.log('Switched to password');
      }

      // Reinitialize the icon
      if (typeof lucide !== 'undefined') {
        lucide.createIcons();
        console.log('Icons reinitialized');
      } else {
        console.error('lucide is not defined');
      }
    });
  });

  // Initialize lucide icons
  if (typeof lucide !== 'undefined') {
    lucide.createIcons();
    console.log('Initial lucide icons created');
  } else {
    console.error('lucide library not loaded');
  }
}

function initTestButtons() {
  console.log('Initializing test buttons...');

  document.querySelectorAll('.test-key-btn').forEach(button => {
    // Remove old listeners by cloning
    const newButton = button.cloneNode(true);
    button.parentNode.replaceChild(newButton, button);

    newButton.addEventListener('click', function(e) {
      e.preventDefault();

      const settingId = this.getAttribute('data-setting-id');
      console.log('Test button clicked for setting:', settingId);

      const originalHTML = this.innerHTML;
      this.disabled = true;
      this.innerHTML = '<span class="spinner-border spinner-border-sm"></span> Testing...';

      // Get CSRF token from the form (form_with automatically includes it)
      console.log('Looking for CSRF token...');
      console.log('All forms:', document.querySelectorAll('form'));
      console.log('All inputs with name authenticity_token:', document.querySelectorAll('input[name="authenticity_token"]'));
      console.log('All hidden inputs:', document.querySelectorAll('input[type="hidden"]'));

      let csrfTokenInput = document.querySelector('input[name="authenticity_token"]');

      // If not found, try getting it from Rails directly via a data attribute
      if (!csrfTokenInput) {
        console.warn('Token not in form, trying to get from Rails...');
        // Let's embed it directly in the page
        const tokenValue = '<%= form_authenticity_token %>';
        console.log('Using embedded token');

        if (!tokenValue || tokenValue === '') {
          console.error('CSRF token not available');
          alert('Error: CSRF token not found. Please refresh the page.');
          this.disabled = false;
          this.innerHTML = originalHTML;
          return;
        }

        // Continue with embedded token
        makeRequest(tokenValue);
        return;
      }

      const tokenValue = csrfTokenInput.value;
      makeRequest(tokenValue);

      function makeRequest(token) {
        console.log('CSRF token found:', token ? 'Yes' : 'No');
        console.log('Fetching:', `/admin/system_settings/${settingId}/test_key`);

        fetch(`/admin/system_settings/${settingId}/test_key`, {
          method: 'POST',
          headers: {
            'X-CSRF-Token': token,
            'Accept': 'application/json'
          }
        })
        .then(response => {
          console.log('Response status:', response.status);
          return response.json();
        })
        .then(data => {
          console.log('Response data:', data);
          newButton.disabled = false;
          newButton.innerHTML = originalHTML;

          // Reinitialize icons
          if (typeof lucide !== 'undefined') {
            lucide.createIcons();
          }

          if (data.success) {
            alert('✓ ' + data.message);
          } else {
            alert('✗ ' + data.message);
          }
        })
        .catch(error => {
          console.error('Error testing API key:', error);
          newButton.disabled = false;
          newButton.innerHTML = originalHTML;

          // Reinitialize icons
          if (typeof lucide !== 'undefined') {
            lucide.createIcons();
          }

          alert('Error testing API key: ' + error);
        });
      }
    });
  });
}

document.addEventListener('DOMContentLoaded', () => {
  initPasswordToggles();
  initTestButtons();
});

document.addEventListener('turbo:load', () => {
  initPasswordToggles();
  initTestButtons();
});
</script>
  </div>
</div>
