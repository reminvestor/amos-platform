<% content_for :title, "OAuth Configurations" %>

<div class="admin-content">
  <div style="padding: 2rem;">
    <div class="container-fluid py-4">
  <div class="row mb-4">
    <div class="col">
      <h1><i data-lucide="key" class="me-2"></i>OAuth Configurations</h1>
      <p class="text-muted">Manage OAuth app credentials for integrations</p>
    </div>
    <div class="col-auto">
      <%= link_to "New OAuth Configuration", new_admin_oauth_configuration_path, class: "btn btn-primary" %>
    </div>
  </div>

  <!-- Stats Cards -->
  <div class="row mb-4">
    <div class="col-md-4">
      <div class="card">
        <div class="card-body">
          <h6 class="text-muted">Total Configurations</h6>
          <h3><%= @stats[:total] %></h3>
        </div>
      </div>
    </div>
    <div class="col-md-4">
      <div class="card">
        <div class="card-body">
          <h6 class="text-muted">Active</h6>
          <h3 class="text-success"><%= @stats[:active] %></h3>
        </div>
      </div>
    </div>
    <div class="col-md-4">
      <div class="card">
        <div class="card-body">
          <h6 class="text-muted">Integrations Configured</h6>
          <h3><%= @stats[:integrations_configured] %></h3>
        </div>
      </div>
    </div>
  </div>

  <!-- OAuth Configurations Table -->
  <div class="card">
    <div class="card-body">
      <table class="table">
          <thead>
          <tr>
            <th>ID</th>
            <th>Integration</th>
            <th>Client ID</th>
            <th>Redirect URI</th>
            <th>Status</th>
            <th>Created</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <% @oauth_configurations.each do |config| %>
            <tr>
              <td>#<%= config.id %></td>
              <td>
                <i data-lucide="plug" class="me-1"></i>
                <%= config.integration.name %>
              </td>
              <td><code><%= config.client_id[0..15] %>...</code></td>
              <td><small><%= config.redirect_uri %></small></td>
              <td>
                <span class="badge <%= config.active? ? 'bg-success' : 'bg-secondary' %>">
                  <%= config.status.humanize %>
                </span>
              </td>
              <td><%= config.created_at.strftime("%Y-%m-%d") %></td>
              <td>
                <%= link_to "View", admin_oauth_configuration_path(config), class: "btn btn-sm btn-outline-primary" %>
                <%= link_to "Edit", edit_admin_integration_oauth_configuration_path(config.integration, config), class: "btn btn-sm btn-outline-secondary" %>
                <%= link_to "Delete", admin_integration_oauth_configuration_path(config.integration, config), 
                    method: :delete, 
                    data: { confirm: "Are you sure?" }, 
                    class: "btn btn-sm btn-outline-danger" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
      
      <%= paginate @oauth_configurations if @oauth_configurations.respond_to?(:total_pages) %>
    </div>
  </div>
</div>
  </div>
</div>

