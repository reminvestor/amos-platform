<% content_for :title, "OAuth Configurations" %>

<div class="admin-p-xl">
  <!-- Page Header -->
  <div class="admin-page-header admin-mb-xl">
    <div class="header-left">
      <div class="header-icon admin-icon-gradient-purple">
        <i data-lucide="key" class="admin-text-primary"></i>
      </div>
      <div class="header-text">
        <h1>OAuth Configurations</h1>
        <p>Manage OAuth app credentials for integrations</p>
      </div>
    </div>

    <div class="header-actions">
      <%= link_to new_admin_oauth_configuration_path, class: "admin-btn admin-btn-primary" do %>
        <i data-lucide="plus"></i>
        <span>New OAuth Configuration</span>
      <% end %>
    </div>
  </div>

  <!-- Stats Cards -->
  <div class="admin-stats-grid admin-mb-xl">
    <div class="admin-card">
      <div class="admin-flex admin-items-center admin-flex-gap-md">
        <div class="admin-stat-icon purple-gradient">
          <i data-lucide="key" class="admin-icon-lg admin-text-primary"></i>
        </div>
        <div>
          <p class="admin-stat-label">Total Configurations</p>
          <h3 class="admin-stat-value"><%= @stats[:total] %></h3>
        </div>
      </div>
    </div>

    <div class="admin-card">
      <div class="admin-flex admin-items-center admin-flex-gap-md">
        <div class="admin-stat-icon success">
          <i data-lucide="check-circle" class="admin-icon-lg admin-text-success"></i>
        </div>
        <div>
          <p class="admin-stat-label">Active</p>
          <h3 class="admin-stat-value"><%= @stats[:active] %></h3>
        </div>
      </div>
    </div>

    <div class="admin-card">
      <div class="admin-flex admin-items-center admin-flex-gap-md">
        <div class="admin-stat-icon info">
          <i data-lucide="plug" class="admin-icon-lg admin-text-info"></i>
        </div>
        <div>
          <p class="admin-stat-label">Integrations Configured</p>
          <h3 class="admin-stat-value"><%= @stats[:integrations_configured] %></h3>
        </div>
      </div>
    </div>
  </div>

  <!-- OAuth Configurations Table -->
  <div class="admin-card">
    <h3 class="card-title m-0 admin-mb-lg">
      <i data-lucide="list" class="admin-icon-md d-inline-block align-middle me-2"></i>
      OAuth Configurations
    </h3>
    <div class="admin-table-container">
      <table class="admin-table">
        <thead>
          <tr>
            <th>ID</th>
            <th>Integration</th>
            <th>Client ID</th>
            <th>Redirect URI</th>
            <th>Status</th>
            <th>Created</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <% @oauth_configurations.each do |config| %>
            <tr>
              <td class="admin-text-cyan">#<%= config.id %></td>
              <td>
                <div class="admin-flex admin-items-center admin-flex-gap-sm">
                  <i data-lucide="plug" class="admin-icon-sm admin-text-info"></i>
                  <span class="admin-text-primary"><%= config.integration.name %></span>
                </div>
              </td>
              <td><code class="admin-text-cyan"><%= config.client_id[0..15] %>...</code></td>
              <td><small class="admin-text-secondary"><%= config.redirect_uri %></small></td>
              <td>
                <span class="admin-badge <%= config.active? ? 'admin-badge-success' : 'admin-badge-secondary' %>">
                  <%= config.status.humanize %>
                </span>
              </td>
              <td class="admin-text-secondary"><%= config.created_at.strftime("%Y-%m-%d") %></td>
              <td>
                <div class="admin-flex admin-flex-gap-xs">
                  <%= link_to admin_oauth_configuration_path(config), class: "admin-btn admin-btn-sm admin-btn-outline" do %>
                    <i data-lucide="eye" class="admin-icon-sm"></i>
                  <% end %>
                  <%= link_to edit_admin_integration_oauth_configuration_path(config.integration, config), class: "admin-btn admin-btn-sm admin-btn-outline" do %>
                    <i data-lucide="edit" class="admin-icon-sm"></i>
                  <% end %>
                  <%= link_to admin_integration_oauth_configuration_path(config.integration, config),
                      method: :delete,
                      data: { confirm: "Are you sure?" },
                      class: "admin-btn admin-btn-sm admin-btn-danger-outline" do %>
                    <i data-lucide="trash" class="admin-icon-sm"></i>
                  <% end %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <% if @oauth_configurations.respond_to?(:total_pages) %>
      <div class="admin-pagination">
        <%= paginate @oauth_configurations %>
      </div>
    <% end %>
  </div>
</div>

<script>
  document.addEventListener('turbo:load', () => {
    if (typeof lucide !== 'undefined') {
      lucide.createIcons();
    }
  });
</script>
