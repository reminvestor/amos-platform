<% content_for :title, "OAuth Configuration ##{@oauth_configuration.id}" %>

<div class="admin-p-xl">
  <!-- Page Header -->
  <div class="admin-page-header admin-mb-xl">
    <div class="header-left">
      <div class="header-icon admin-icon-gradient-purple">
        <i data-lucide="key" class="admin-text-primary"></i>
      </div>
      <div class="header-text">
        <h1>OAuth Configuration #<%= @oauth_configuration.id %></h1>
        <p><%= @oauth_configuration.integration.name %></p>
      </div>
    </div>

    <div class="header-actions">
      <div class="admin-flex admin-flex-gap-sm">
        <%= link_to edit_admin_oauth_configuration_path(@oauth_configuration), class: "admin-btn admin-btn-primary" do %>
          <i data-lucide="edit"></i>
          <span>Edit</span>
        <% end %>
        <%= link_to admin_oauth_configuration_path(@oauth_configuration),
            method: :delete,
            data: { confirm: "Are you sure?" },
            class: "admin-btn admin-btn-danger" do %>
          <i data-lucide="trash"></i>
          <span>Delete</span>
        <% end %>
        <%= link_to admin_oauth_configurations_path, class: "admin-btn admin-btn-outline" do %>
          <i data-lucide="arrow-left"></i>
          <span>Back</span>
        <% end %>
      </div>
    </div>
  </div>

  <div class="admin-content-grid">
    <!-- Configuration Details -->
    <div class="admin-card">
      <h3 class="card-title m-0 admin-mb-lg">
        <i data-lucide="settings" class="admin-icon-md d-inline-block align-middle me-2"></i>
        Configuration Details
      </h3>
      <div class="admin-detail-list">
        <div class="detail-item">
          <span class="admin-text-secondary">Entity</span>
          <span class="admin-text-primary"><%= @oauth_configuration.entity.name %></span>
        </div>
        <div class="detail-item">
          <span class="admin-text-secondary">Integration</span>
          <div class="admin-flex admin-items-center admin-flex-gap-sm">
            <i data-lucide="plug" class="admin-icon-sm admin-text-info"></i>
            <span class="admin-text-primary"><%= @oauth_configuration.integration.name %></span>
            <span class="admin-badge admin-badge-info"><%= @oauth_configuration.integration.auth_type.humanize %></span>
          </div>
        </div>
        <div class="detail-item">
          <span class="admin-text-secondary">Client ID</span>
          <code class="admin-text-cyan"><%= @oauth_configuration.client_id %></code>
        </div>
        <div class="detail-item">
          <span class="admin-text-secondary">Client Secret</span>
          <div>
            <code class="admin-text-secondary"><%= "*" * 40 %></code>
            <small class="admin-text-muted d-block">Hidden for security</small>
          </div>
        </div>
        <div class="detail-item">
          <span class="admin-text-secondary">Redirect URI</span>
          <code class="admin-text-cyan"><%= @oauth_configuration.redirect_uri %></code>
        </div>
        <div class="detail-item">
          <span class="admin-text-secondary">Scopes</span>
          <div>
            <% if @oauth_configuration.scopes.present? %>
              <div class="admin-flex admin-flex-gap-xs admin-flex-wrap">
                <% @oauth_configuration.scopes.split(',').each do |scope| %>
                  <span class="admin-badge admin-badge-secondary"><%= scope.strip %></span>
                <% end %>
              </div>
            <% else %>
              <span class="admin-text-muted">None specified</span>
            <% end %>
          </div>
        </div>
        <div class="detail-item">
          <span class="admin-text-secondary">Status</span>
          <span class="admin-badge <%= @oauth_configuration.active? ? 'admin-badge-success' : 'admin-badge-secondary' %>">
            <%= @oauth_configuration.status.humanize %>
          </span>
        </div>
        <div class="detail-item">
          <span class="admin-text-secondary">Created At</span>
          <span class="admin-text-primary"><%= @oauth_configuration.created_at.strftime("%B %d, %Y at %I:%M %p") %></span>
        </div>
        <div class="detail-item">
          <span class="admin-text-secondary">Updated At</span>
          <span class="admin-text-primary"><%= @oauth_configuration.updated_at.strftime("%B %d, %Y at %I:%M %p") %></span>
        </div>
      </div>
    </div>

    <!-- Integration Details -->
    <div class="admin-card">
      <h3 class="card-title m-0 admin-mb-lg">
        <i data-lucide="plug" class="admin-icon-md d-inline-block align-middle me-2"></i>
        Integration Details
      </h3>
      <div class="admin-detail-list">
        <div class="detail-item admin-flex-col">
          <span class="admin-text-secondary admin-mb-xs">Authorize URL</span>
          <code class="admin-text-cyan admin-text-sm"><%= @oauth_configuration.integration.auth_config["authorize_url"] %></code>
        </div>
        <div class="detail-item admin-flex-col">
          <span class="admin-text-secondary admin-mb-xs">Token URL</span>
          <code class="admin-text-cyan admin-text-sm"><%= @oauth_configuration.integration.auth_config["token_url"] %></code>
        </div>
        <div class="detail-item admin-flex-col">
          <span class="admin-text-secondary admin-mb-xs">API Base URL</span>
          <code class="admin-text-cyan admin-text-sm"><%= @oauth_configuration.integration.api_base_url %></code>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  document.addEventListener('turbo:load', () => {
    if (typeof lucide !== 'undefined') {
      lucide.createIcons();
    }
  });
</script>
