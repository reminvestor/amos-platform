<% content_for :title, "OAuth Configuration ##{@oauth_configuration.id}" %>

<div class="admin-content">
  <div style="padding: 2rem;">
    <div class="container py-4">
  <div class="row">
    <div class="col-md-10 mx-auto">
      <div class="d-flex justify-content-between align-items-center mb-4">
        <h1><i data-lucide="key" class="me-2"></i>OAuth Configuration #<%= @oauth_configuration.id %></h1>
        <div>
          <%= link_to "Edit", edit_admin_oauth_configuration_path(@oauth_configuration), class: "btn btn-primary" %>
          <%= link_to "Delete", admin_oauth_configuration_path(@oauth_configuration), 
              method: :delete, 
              data: { confirm: "Are you sure?" }, 
              class: "btn btn-danger" %>
          <%= link_to "Back", admin_oauth_configurations_path, class: "btn btn-secondary" %>
        </div>
      </div>

      <div class="card mb-4">
        <div class="card-header">
          <h5>Configuration Details</h5>
        </div>
        <div class="card-body">
          <dl class="row">
            <dt class="col-sm-3">Entity</dt>
            <dd class="col-sm-9"><%= @oauth_configuration.entity.name %></dd>

            <dt class="col-sm-3">Integration</dt>
            <dd class="col-sm-9">
              <i data-lucide="plug" class="me-1"></i>
              <%= @oauth_configuration.integration.name %>
              <span class="badge bg-info ms-2"><%= @oauth_configuration.integration.auth_type.humanize %></span>
            </dd>

            <dt class="col-sm-3">Client ID</dt>
            <dd class="col-sm-9"><code><%= @oauth_configuration.client_id %></code></dd>

            <dt class="col-sm-3">Client Secret</dt>
            <dd class="col-sm-9">
              <code><%= "*" * 40 %></code>
              <small class="text-muted d-block">Hidden for security</small>
            </dd>

            <dt class="col-sm-3">Redirect URI</dt>
            <dd class="col-sm-9"><code><%= @oauth_configuration.redirect_uri %></code></dd>

            <dt class="col-sm-3">Scopes</dt>
            <dd class="col-sm-9">
              <% if @oauth_configuration.scopes.present? %>
                <% @oauth_configuration.scopes.split(',').each do |scope| %>
                  <span class="badge bg-secondary me-1"><%= scope.strip %></span>
                <% end %>
              <% else %>
                <span class="text-muted">None specified</span>
              <% end %>
            </dd>

            <dt class="col-sm-3">Status</dt>
            <dd class="col-sm-9">
              <span class="badge <%= @oauth_configuration.active? ? 'bg-success' : 'bg-secondary' %>">
                <%= @oauth_configuration.status.humanize %>
              </span>
            </dd>

            <dt class="col-sm-3">Created At</dt>
            <dd class="col-sm-9"><%= @oauth_configuration.created_at.strftime("%B %d, %Y at %I:%M %p") %></dd>

            <dt class="col-sm-3">Updated At</dt>
            <dd class="col-sm-9"><%= @oauth_configuration.updated_at.strftime("%B %d, %Y at %I:%M %p") %></dd>
          </dl>
        </div>
      </div>

      <div class="card">
        <div class="card-header">
          <h5>Integration Details</h5>
        </div>
        <div class="card-body">
          <dl class="row">
            <dt class="col-sm-3">Authorize URL</dt>
            <dd class="col-sm-9"><code><%= @oauth_configuration.integration.auth_config["authorize_url"] %></code></dd>

            <dt class="col-sm-3">Token URL</dt>
            <dd class="col-sm-9"><code><%= @oauth_configuration.integration.auth_config["token_url"] %></code></dd>

            <dt class="col-sm-3">API Base URL</dt>
            <dd class="col-sm-9"><code><%= @oauth_configuration.integration.api_base_url %></code></dd>
          </dl>
        </div>
      </div>
    </div>
  </div>
</div>
  </div>
</div>


