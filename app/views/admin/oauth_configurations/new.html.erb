<% content_for :title, "OAuth Configuration for #{@integration.name}" %>

<div class="container py-4">
  <div class="row">
    <div class="col-md-8 mx-auto">
      <div class="card">
        <div class="card-header">
          <h3><i class="fas fa-key me-2"></i>OAuth Configuration for <%= @integration.name %></h3>
          <small class="text-muted">Platform-wide configuration</small>
        </div>
        <div class="card-body">
          <%= form_with model: [:admin, @integration, @oauth_configuration], local: true do |f| %>
            <% if @oauth_configuration.errors.any? %>
              <div class="alert alert-danger">
                <h5><%= pluralize(@oauth_configuration.errors.count, "error") %> prohibited this configuration from being saved:</h5>
                <ul>
                  <% @oauth_configuration.errors.full_messages.each do |message| %>
                    <li><%= message %></li>
                  <% end %>
                </ul>
              </div>
            <% end %>

            <div class="mb-3">
              <%= f.label :authorize_url, "Authorize URL", class: "form-label" %>
              <%= f.text_field :authorize_url, class: "form-control" %>
              <div class="form-text">The OAuth authorization endpoint</div>
            </div>

            <div class="mb-3">
              <%= f.label :token_url, "Token URL", class: "form-label" %>
              <%= f.text_field :token_url, class: "form-control" %>
              <div class="form-text">The OAuth token exchange endpoint</div>
            </div>

            <div class="mb-3">
              <%= f.label :client_id, "Client ID", class: "form-label" %>
              <%= f.text_field :client_id, class: "form-control", placeholder: "Your OAuth app client ID from #{@integration.name}" %>
            </div>

            <div class="mb-3">
              <%= f.label :client_secret, "Client Secret", class: "form-label" %>
              <%= f.text_field :client_secret, class: "form-control", placeholder: "Your OAuth app client secret" %>
              <div class="form-text">This will be stored securely</div>
            </div>

            <div class="mb-3">
              <%= f.label :redirect_uri, "Redirect URI", class: "form-label" %>
              <%= f.text_field :redirect_uri, class: "form-control" %>
              <div class="form-text">
                <strong>Important:</strong> Register this exact URI in your <%= @integration.name %> OAuth app settings
              </div>
            </div>

            <div class="mb-3">
              <%= f.label :scopes, "Scopes (comma-separated)", class: "form-label" %>
              <%= f.text_area :scopes, class: "form-control", rows: 2 %>
              <div class="form-text">
                Enter the required OAuth scopes, separated by commas
              </div>
            </div>

            <div class="mb-3">
              <%= f.label :status, "Status", class: "form-label" %>
              <%= f.select :status, OauthConfiguration.statuses.keys.map { |k| [k.humanize, k] }, {}, class: "form-select" %>
            </div>

            <div class="d-flex justify-content-between">
              <%= link_to "Cancel", admin_integration_path(@integration), class: "btn btn-secondary" %>
              <%= f.submit "Create OAuth Configuration", class: "btn btn-primary" %>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>

