<div class="admin-p-xl">
  <%# Page Header %>
  <div class="admin-page-header admin-mb-xl">
    <div class="header-left">
      <div class="header-icon admin-icon-gradient-purple">
        <i data-lucide="shield-check" class="admin-text-primary"></i>
      </div>
      <div class="header-text">
        <h1><%= @ai_ruleset.name %></h1>
        <p>
          <span class="admin-badge admin-badge-<%= category_badge_class(@ai_ruleset.category) %>">
            <%= @ai_ruleset.category.titleize %>
          </span>
          <% if @ai_ruleset.is_system? %>
            <span class="admin-badge admin-badge-warning admin-ml-sm">System Preset</span>
          <% end %>
          <% if @ai_ruleset.is_active? %>
            <span class="admin-badge admin-badge-online admin-ml-sm">Active</span>
          <% else %>
            <span class="admin-badge admin-badge-secondary admin-ml-sm">Inactive</span>
          <% end %>
        </p>
      </div>
    </div>

    <% if @current_admin.super_admin? %>
      <div class="header-actions">
        <%= link_to edit_admin_ai_ruleset_path(@ai_ruleset), class: "admin-btn admin-btn-outline" do %>
          <i data-lucide="edit"></i>
          <span>Edit</span>
        <% end %>
        <%= link_to toggle_admin_ai_ruleset_path(@ai_ruleset), method: :patch,
            class: "admin-btn #{@ai_ruleset.is_active? ? 'admin-btn-warning' : 'admin-btn-success'}" do %>
          <i data-lucide="<%= @ai_ruleset.is_active? ? 'pause' : 'play' %>"></i>
          <span><%= @ai_ruleset.is_active? ? 'Disable' : 'Enable' %></span>
        <% end %>
      </div>
    <% end %>
  </div>

  <div class="row">
    <%# Main Content %>
    <div class="col-lg-8">
      <%# Description Card %>
      <% if @ai_ruleset.description.present? %>
        <div class="admin-card admin-mb-lg">
          <h4 class="admin-mb-md">
            <i data-lucide="file-text" class="admin-icon-md admin-mr-sm"></i>
            Description
          </h4>
          <p class="admin-text-secondary"><%= @ai_ruleset.description %></p>
        </div>
      <% end %>

      <%# Rules Card %>
      <div class="admin-card admin-mb-lg">
        <h4 class="admin-mb-md">
          <i data-lucide="list-ordered" class="admin-icon-md admin-mr-sm"></i>
          Rules (<%= @ai_ruleset.rules.size %>)
        </h4>
        <% if @ai_ruleset.rules.any? %>
          <ol class="admin-pl-lg">
            <% @ai_ruleset.rules.each do |rule| %>
              <li class="admin-mb-sm admin-text-primary" style="line-height: 1.6;">
                <%= rule %>
              </li>
            <% end %>
          </ol>
        <% else %>
          <p class="admin-text-muted">No rules defined.</p>
        <% end %>
      </div>

      <%# Prompt Preview Card %>
      <div class="admin-card">
        <h4 class="admin-mb-md">
          <i data-lucide="code" class="admin-icon-md admin-mr-sm"></i>
          Prompt Preview
        </h4>
        <p class="admin-text-secondary admin-text-sm admin-mb-md">
          This is how the rules will appear when injected into Scout's system prompt:
        </p>
        <div class="admin-code-block admin-p-lg" style="background: var(--bg-darker); border-radius: 0.5rem; overflow-x: auto;">
          <pre style="margin: 0; white-space: pre-wrap; color: var(--text-secondary); font-size: 0.875rem;"><%= @preview_prompt.presence || "No rules to display" %></pre>
        </div>
      </div>
    </div>

    <%# Sidebar %>
    <div class="col-lg-4">
      <%# Details Card %>
      <div class="admin-card admin-mb-lg">
        <h5 class="admin-section-heading admin-mb-lg">
          <i data-lucide="info" class="admin-icon-md admin-text-info"></i>
          <span>Details</span>
        </h5>

        <div class="form-group">
          <p class="admin-text-muted admin-text-xs">Scope</p>
          <p class="admin-text-primary admin-flex admin-items-center admin-flex-gap-sm">
            <% if @ai_ruleset.global? %>
              <i data-lucide="globe" class="admin-icon-sm admin-text-info"></i>
              Global (All Entities)
            <% else %>
              <i data-lucide="building" class="admin-icon-sm"></i>
              <%= @ai_ruleset.entity&.name || "Entity ##{@ai_ruleset.entity_id}" %>
            <% end %>
          </p>
        </div>

        <div class="form-group">
          <p class="admin-text-muted admin-text-xs">Priority</p>
          <p class="admin-text-primary"><%= @ai_ruleset.priority %></p>
        </div>

        <div class="form-group">
          <p class="admin-text-muted admin-text-xs">Created</p>
          <p class="admin-text-primary"><%= @ai_ruleset.created_at.strftime("%B %d, %Y") %></p>
        </div>

        <div>
          <p class="admin-text-muted admin-text-xs">Last Updated</p>
          <p class="admin-text-primary"><%= @ai_ruleset.updated_at.strftime("%B %d, %Y at %I:%M %p") %></p>
        </div>
      </div>

      <%# Clone Card %>
      <% if @current_admin.super_admin? %>
        <div class="admin-card admin-mb-lg">
          <h5 class="admin-section-heading admin-mb-lg">
            <i data-lucide="copy" class="admin-icon-md admin-text-cyan"></i>
            <span>Clone Ruleset</span>
          </h5>
          <p class="admin-text-secondary admin-text-sm admin-mb-md">
            Create a copy of this ruleset, optionally for a specific entity.
          </p>
          <%= form_with url: clone_admin_ai_ruleset_path(@ai_ruleset), method: :post, local: true do |f| %>
            <div class="form-group admin-mb-md">
              <%= f.select :target_entity_id,
                  options_for_select([["Same Scope (#{@ai_ruleset.global? ? 'Global' : @ai_ruleset.entity&.name})", nil]] + @entities),
                  {}, class: "form-select",
                  style: "background-color: var(--bg-input); border: 1px solid var(--border-primary); color: var(--text-primary); padding: 0.5rem; border-radius: 0.5rem;" %>
            </div>
            <%= f.submit "Clone Ruleset", class: "admin-btn admin-btn-info admin-btn-sm" %>
          <% end %>
        </div>
      <% end %>

      <%# Back Link %>
      <div class="admin-card">
        <%= link_to admin_ai_rulesets_path, class: "admin-btn admin-btn-outline" do %>
          <i data-lucide="arrow-left" class="admin-icon-sm"></i>
          <span>Back to All Rulesets</span>
        <% end %>
      </div>
    </div>
  </div>
</div>

<% @entities ||= Entity.order(:name).pluck(:name, :id) %>

<script>
  document.addEventListener('turbo:load', () => {
    if (typeof lucide !== 'undefined') {
      lucide.createIcons();
    }
  });

  document.addEventListener('DOMContentLoaded', () => {
    if (typeof lucide !== 'undefined') {
      lucide.createIcons();
    }
  });
</script>
