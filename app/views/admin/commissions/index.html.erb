<div class="admin-p-xl">
  <!-- Page Header -->
  <div class="admin-page-header admin-mb-xl">
    <div class="header-left">
      <div class="header-icon admin-icon-gradient-purple">
        <i data-lucide="dollar-sign" class="admin-text-primary"></i>
      </div>
      <div class="header-text">
        <h1>Commission Management</h1>
        <p>Manage affiliate commissions and payouts</p>
      </div>
    </div>
  </div>

  <!-- Stats Cards -->
  <div class="admin-stats-grid admin-mb-xl">
    <div class="admin-card">
      <div class="admin-flex admin-items-center admin-flex-gap-md">
        <div class="admin-stat-icon warning">
          <i data-lucide="clock" class="admin-icon-lg admin-text-warning"></i>
        </div>
        <div>
          <p class="admin-stat-label">Pending Review</p>
          <h3 class="admin-stat-value">$<%= number_with_delimiter(@total_pending, precision: 2) %></h3>
        </div>
      </div>
    </div>

    <div class="admin-card">
      <div class="admin-flex admin-items-center admin-flex-gap-md">
        <div class="admin-stat-icon success">
          <i data-lucide="check-circle" class="admin-icon-lg admin-text-success"></i>
        </div>
        <div>
          <p class="admin-stat-label">Approved</p>
          <h3 class="admin-stat-value">$<%= number_with_delimiter(@total_approved, precision: 2) %></h3>
        </div>
      </div>
    </div>

    <div class="admin-card">
      <div class="admin-flex admin-items-center admin-flex-gap-md">
        <div class="admin-stat-icon purple-gradient">
          <i data-lucide="banknote" class="admin-icon-lg admin-text-primary"></i>
        </div>
        <div>
          <p class="admin-stat-label">Paid Out</p>
          <h3 class="admin-stat-value">$<%= number_with_delimiter(@total_paid, precision: 2) %></h3>
        </div>
      </div>
    </div>
  </div>

  <!-- Filters -->
  <div class="admin-card admin-mb-xl">
    <%= form_with url: admin_commissions_path, method: :get, local: true, class: "admin-filter-grid" do %>
      <div>
        <label class="form-label admin-text-sm">Status</label>
        <%= select_tag :status, options_for_select([['All Statuses', ''], ['Pending', 'pending'], ['Approved', 'approved'], ['Paid', 'paid'], ['Cancelled', 'cancelled']], params[:status]), class: "admin-select admin-w-full" %>
      </div>
      <div>
        <label class="form-label admin-text-sm">From Date</label>
        <%= date_field_tag :date_from, params[:date_from], class: "admin-input admin-w-full" %>
      </div>
      <div>
        <label class="form-label admin-text-sm">To Date</label>
        <%= date_field_tag :date_to, params[:date_to], class: "admin-input admin-w-full" %>
      </div>
      <div>
        <label class="form-label admin-text-sm">Affiliate ID</label>
        <%= number_field_tag :affiliate_id, params[:affiliate_id], class: "admin-input admin-w-full", placeholder: "Affiliate ID" %>
      </div>
      <div class="admin-flex admin-items-end admin-flex-gap-sm">
        <button type="submit" class="admin-btn admin-btn-primary">
          <i data-lucide="search"></i> Filter
        </button>
        <%= link_to "Clear", admin_commissions_path, class: "admin-btn admin-btn-outline" %>
      </div>
      <div class="admin-flex admin-items-end">
        <%= link_to admin_commissions_path(format: :csv, **params.permit(:status, :date_from, :date_to, :affiliate_id)), class: "admin-btn admin-btn-success" do %>
          <i data-lucide="file-spreadsheet"></i> Export CSV
        <% end %>
      </div>
    <% end %>
  </div>

  <!-- Commissions Table -->
  <%= form_with url: bulk_approve_admin_commissions_path, method: :post, local: true, id: "bulk-form", data: { controller: "bulk-select" } do %>
    <div class="admin-card">
      <div class="admin-flex-between admin-mb-lg">
        <h3 class="card-title m-0">
          <i data-lucide="list" class="admin-icon-md d-inline-block align-middle me-2"></i>
          Commissions
          <span class="admin-badge admin-badge-info ms-2">
            <span data-bulk-select-target="counter">0</span> selected
          </span>
        </h3>
        <div class="admin-flex admin-flex-gap-sm">
          <button type="button" class="admin-btn admin-btn-sm admin-btn-outline"
                  data-action="bulk-select#selectAll">
            Select All
          </button>
          <button type="button" class="admin-btn admin-btn-sm admin-btn-outline"
                  data-action="bulk-select#deselectAll">
            Deselect All
          </button>
          <button type="submit" class="admin-btn admin-btn-sm admin-btn-success"
                  data-bulk-select-target="actionButton">
            <i data-lucide="check-check"></i> Bulk Approve Selected
          </button>
        </div>
      </div>

      <div class="admin-table-container">
        <table class="admin-table">
          <thead>
            <tr>
              <th width="50">
                <input type="checkbox"
                       data-bulk-select-target="masterCheckbox"
                       data-action="bulk-select#toggleAll"
                       class="form-check-input">
              </th>
              <th>ID</th>
              <th>Affiliate</th>
              <th>Email</th>
              <th>Customer</th>
              <th>Type</th>
              <th>Amount</th>
              <th>Status</th>
              <th>Earned</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            <% @commissions.each do |commission| %>
              <tr>
                <td>
                  <% if commission.pending? %>
                    <%= check_box_tag "commission_ids[]", commission.id, false,
                        class: "form-check-input",
                        data: {
                          bulk_select_target: "checkbox",
                          action: "bulk-select#updateCount"
                        } %>
                  <% end %>
                </td>
                <td class="admin-text-cyan">#<%= commission.id %></td>
                <td class="admin-text-primary"><%= commission.affiliate.user.full_name %></td>
                <td class="admin-text-secondary"><%= commission.affiliate.user.email %></td>
                <td class="admin-text-secondary"><%= commission.entity.name %></td>
                <td><span class="admin-badge admin-badge-secondary"><%= commission.commission_type.humanize %></span></td>
                <td class="admin-text-success admin-font-semibold">$<%= number_with_delimiter(commission.amount, precision: 2) %></td>
                <td>
                  <span class="admin-badge <%= case commission.status
                    when 'pending' then 'admin-badge-warning'
                    when 'approved' then 'admin-badge-success'
                    when 'paid' then 'admin-badge-info'
                    when 'cancelled' then 'admin-badge-danger'
                    end %>">
                    <%= commission.status.humanize %>
                  </span>
                </td>
                <td class="admin-text-secondary"><%= commission.earned_at.strftime('%Y-%m-%d') %></td>
                <td>
                  <div class="admin-flex admin-flex-gap-xs">
                    <% if commission.pending? %>
                      <%= button_to approve_admin_commission_path(commission), method: :post, class: "admin-btn admin-btn-sm admin-btn-success", data: { turbo: false } do %>
                        <i data-lucide="check" class="admin-icon-sm"></i>
                      <% end %>
                      <%= button_to cancel_admin_commission_path(commission), method: :post, class: "admin-btn admin-btn-sm admin-btn-danger", data: { confirm: 'Cancel this commission?', turbo: false } do %>
                        <i data-lucide="x" class="admin-icon-sm"></i>
                      <% end %>
                    <% elsif commission.approved? %>
                      <span class="admin-badge admin-badge-success">Approved</span>
                    <% elsif commission.paid? %>
                      <span class="admin-badge admin-badge-info">Paid</span>
                    <% end %>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>

      <div class="admin-pagination">
        <%= paginate @commissions %>
      </div>
    </div>
  <% end %>
</div>

<script>
  document.addEventListener('turbo:load', () => {
    if (typeof lucide !== 'undefined') {
      lucide.createIcons();
    }
  });
</script>
