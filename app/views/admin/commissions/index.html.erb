<div class="container-fluid">
  <div class="row mb-4">
    <div class="col-12">
      <h1><i class="fas fa-dollar-sign"></i> Commission Management</h1>
    </div>
  </div>

  <!-- Stats Cards -->
  <div class="row mb-4">
    <div class="col-md-4">
      <div class="card bg-warning text-dark">
        <div class="card-body">
          <h5 class="card-title">Pending Review</h5>
          <h2 class="mb-0">$<%= number_with_delimiter(@total_pending, precision: 2) %></h2>
        </div>
      </div>
    </div>
    <div class="col-md-4">
      <div class="card bg-success text-white">
        <div class="card-body">
          <h5 class="card-title">Approved</h5>
          <h2 class="mb-0">$<%= number_with_delimiter(@total_approved, precision: 2) %></h2>
        </div>
      </div>
    </div>
    <div class="col-md-4">
      <div class="card bg-primary text-white">
        <div class="card-body">
          <h5 class="card-title">Paid Out</h5>
          <h2 class="mb-0">$<%= number_with_delimiter(@total_paid, precision: 2) %></h2>
        </div>
      </div>
    </div>
  </div>

  <!-- Filters -->
  <div class="card bg-secondary mb-4">
    <div class="card-body">
      <%= form_with url: admin_commissions_path, method: :get, local: true, class: "row g-3" do %>
        <div class="col-md-2">
          <%= select_tag :status, options_for_select([['All Statuses', ''], ['Pending', 'pending'], ['Approved', 'approved'], ['Paid', 'paid'], ['Cancelled', 'cancelled']], params[:status]), class: "form-select" %>
        </div>
        <div class="col-md-2">
          <%= date_field_tag :date_from, params[:date_from], class: "form-control", placeholder: "From Date" %>
        </div>
        <div class="col-md-2">
          <%= date_field_tag :date_to, params[:date_to], class: "form-control", placeholder: "To Date" %>
        </div>
        <div class="col-md-2">
          <%= number_field_tag :affiliate_id, params[:affiliate_id], class: "form-control", placeholder: "Affiliate ID" %>
        </div>
        <div class="col-md-2">
          <button type="submit" class="btn btn-primary">
            <i class="fas fa-search"></i> Filter
          </button>
          <%= link_to "Clear", admin_commissions_path, class: "btn btn-outline-secondary" %>
        </div>
        <div class="col-md-2 text-end">
          <%= link_to admin_commissions_path(format: :csv, **params.permit(:status, :date_from, :date_to, :affiliate_id)), class: "btn btn-outline-success" do %>
            <i class="fas fa-file-csv"></i> Export CSV
          <% end %>
        </div>
      <% end %>
    </div>
  </div>

  <!-- Commissions Table -->
  <%= form_with url: bulk_approve_admin_commissions_path, method: :post, local: true, id: "bulk-form", data: { controller: "bulk-select" } do %>
    <div class="card bg-secondary">
      <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="mb-0">
          Commissions
          <span class="badge bg-info ms-2">
            <span data-bulk-select-target="counter">0</span> selected
          </span>
        </h5>
        <div class="btn-group">
          <button type="button" class="btn btn-sm btn-outline-light"
                  data-action="bulk-select#selectAll">
            Select All
          </button>
          <button type="button" class="btn btn-sm btn-outline-light"
                  data-action="bulk-select#deselectAll">
            Deselect All
          </button>
          <button type="submit" class="btn btn-sm btn-success"
                  data-bulk-select-target="actionButton">
            <i class="fas fa-check-double"></i> Bulk Approve Selected
          </button>
        </div>
      </div>
      <div class="card-body p-0">
        <div class="table-responsive">
          <table class="table table-dark table-hover mb-0">
            <thead>
              <tr>
                <th width="50">
                  <input type="checkbox"
                         data-bulk-select-target="masterCheckbox"
                         data-action="bulk-select#toggleAll"
                         class="form-check-input">
                </th>
                <th>ID</th>
                <th>Affiliate</th>
                <th>Email</th>
                <th>Customer</th>
                <th>Type</th>
                <th>Amount</th>
                <th>Status</th>
                <th>Earned</th>
                <th>Actions</th>
              </tr>
            </thead>
            <tbody>
              <% @commissions.each do |commission| %>
                <tr>
                  <td>
                    <% if commission.pending? %>
                      <%= check_box_tag "commission_ids[]", commission.id, false,
                          class: "form-check-input",
                          data: {
                            bulk_select_target: "checkbox",
                            action: "bulk-select#updateCount"
                          } %>
                    <% end %>
                  </td>
                  <td><%= commission.id %></td>
                  <td><%= commission.affiliate.user.full_name %></td>
                  <td><%= commission.affiliate.user.email %></td>
                  <td><%= commission.entity.name %></td>
                  <td><%= commission.commission_type.humanize %></td>
                  <td>$<%= number_with_delimiter(commission.amount, precision: 2) %></td>
                  <td>
                    <span class="badge bg-<%= case commission.status
                      when 'pending' then 'warning'
                      when 'approved' then 'success'
                      when 'paid' then 'primary'
                      when 'cancelled' then 'danger'
                      end %>">
                      <%= commission.status.humanize %>
                    </span>
                  </td>
                  <td><%= commission.earned_at.strftime('%Y-%m-%d') %></td>
                  <td>
                    <% if commission.pending? %>
                      <%= button_to approve_admin_commission_path(commission), method: :post, class: "btn btn-sm btn-success", data: { turbo: false } do %>
                        <i class="fas fa-check"></i>
                      <% end %>
                      <%= button_to cancel_admin_commission_path(commission), method: :post, class: "btn btn-sm btn-danger", data: { confirm: 'Cancel this commission?', turbo: false } do %>
                        <i class="fas fa-times"></i>
                      <% end %>
                    <% elsif commission.approved? %>
                      <span class="badge bg-success">Approved</span>
                    <% elsif commission.paid? %>
                      <span class="badge bg-primary">Paid</span>
                    <% end %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
      <div class="card-footer">
        <%= paginate @commissions %>
      </div>
    </div>
  <% end %>
</div>
