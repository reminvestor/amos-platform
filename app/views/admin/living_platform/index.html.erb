<% content_for :title, "Living Platform Dashboard" %>

<div class="container-fluid py-4">
  <div class="row mb-4">
    <div class="col-12">
      <div class="d-flex justify-content-between align-items-center">
        <div>
          <h1 class="mb-1">🌱 Living Platform Dashboard</h1>
          <p class="text-muted mb-0">Autonomous platform evolution and self-improvement</p>
        </div>
        <div>
          <%= link_to "Benchmark Results", benchmark_results_admin_living_platform_index_path, class: "btn btn-outline-primary" %>
        </div>
      </div>
    </div>
  </div>

  <!-- System Health Banner -->
  <div class="row mb-4">
    <div class="col-12">
      <% health_class = case @system_health[:status]
         when 'healthy' then 'bg-success'
         when 'attention_needed' then 'bg-warning'
         when 'critical' then 'bg-danger'
         else 'bg-secondary'
         end %>
      <div class="card <%= health_class %> text-white">
        <div class="card-body">
          <div class="row align-items-center">
            <div class="col-md-3">
              <h3 class="mb-0">
                <% case @system_health[:status]
                   when 'healthy' %>✅ System Healthy
                <% when 'attention_needed' %>⚠️ Attention Needed
                <% when 'critical' %>🚨 Critical Issues
                <% else %>❓ Unknown
                <% end %>
              </h3>
            </div>
            <div class="col-md-3">
              <div class="text-center">
                <h2 class="mb-0"><%= (@system_health[:score].to_f * 100).round %>%</h2>
                <small>Health Score</small>
              </div>
            </div>
            <div class="col-md-3">
              <div class="text-center">
                <h2 class="mb-0"><%= @system_health[:anomalies] || 0 %></h2>
                <small>Critical Anomalies (24h)</small>
              </div>
            </div>
            <div class="col-md-3">
              <div class="text-center">
                <h2 class="mb-0"><%= @global_stats[:pending_goals] %></h2>
                <small>Pending Goals</small>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Global Stats -->
  <div class="row mb-4">
    <div class="col-md-3">
      <div class="card border-0 shadow-sm">
        <div class="card-body text-center">
          <h3 class="text-primary mb-0"><%= @global_stats[:total_goals] %></h3>
          <small class="text-muted">Total Goals</small>
        </div>
      </div>
    </div>
    <div class="col-md-3">
      <div class="card border-0 shadow-sm">
        <div class="card-body text-center">
          <h3 class="text-info mb-0"><%= @global_stats[:total_perceptions] %></h3>
          <small class="text-muted">Perceptions</small>
        </div>
      </div>
    </div>
    <div class="col-md-3">
      <div class="card border-0 shadow-sm">
        <div class="card-body text-center">
          <h3 class="text-warning mb-0"><%= @global_stats[:total_anomalies] %></h3>
          <small class="text-muted">Active Anomalies</small>
        </div>
      </div>
    </div>
    <div class="col-md-3">
      <div class="card border-0 shadow-sm">
        <div class="card-body text-center">
          <h3 class="text-success mb-0"><%= @global_stats[:total_cycles] %></h3>
          <small class="text-muted">Evolution Cycles</small>
        </div>
      </div>
    </div>
  </div>

  <div class="row">
    <!-- Entities List -->
    <div class="col-md-4">
      <div class="card border-0 shadow-sm">
        <div class="card-header bg-white">
          <h5 class="mb-0">📊 Entities</h5>
        </div>
        <div class="card-body p-0">
          <div class="list-group list-group-flush">
            <% @entities.each do |entity| %>
              <% perception = PlatformPerception.where(entity: entity).recent.first %>
              <%= link_to admin_living_platform_path(entity), class: "list-group-item list-group-item-action d-flex justify-content-between align-items-center" do %>
                <div>
                  <strong><%= entity.name %></strong>
                  <% if perception %>
                    <br>
                    <small class="text-muted">
                      Health: <%= (perception.overall_health_score.to_f * 100).round %>%
                    </small>
                  <% end %>
                </div>
                <% if perception&.anomaly_count.to_i > 0 %>
                  <span class="badge bg-warning"><%= perception.anomaly_count %> anomalies</span>
                <% else %>
                  <span class="badge bg-success">OK</span>
                <% end %>
              <% end %>
            <% end %>
          </div>
        </div>
      </div>
    </div>

    <!-- Recent Anomalies -->
    <div class="col-md-4">
      <div class="card border-0 shadow-sm">
        <div class="card-header bg-white">
          <h5 class="mb-0">⚠️ Recent Anomalies</h5>
        </div>
        <div class="card-body p-0">
          <% if @recent_anomalies.any? %>
            <div class="list-group list-group-flush">
              <% @recent_anomalies.each do |anomaly| %>
                <div class="list-group-item">
                  <div class="d-flex justify-content-between">
                    <strong><%= anomaly.title.truncate(40) %></strong>
                    <span class="badge bg-<%= anomaly.severity == 'critical' ? 'danger' : (anomaly.severity == 'high' ? 'warning' : 'secondary') %>">
                      <%= anomaly.severity %>
                    </span>
                  </div>
                  <small class="text-muted">
                    <%= anomaly.anomaly_type %> • <%= time_ago_in_words(anomaly.created_at) %> ago
                  </small>
                </div>
              <% end %>
            </div>
          <% else %>
            <div class="p-4 text-center text-muted">
              <p class="mb-0">No active anomalies 🎉</p>
            </div>
          <% end %>
        </div>
      </div>
    </div>

    <!-- Recent Goals -->
    <div class="col-md-4">
      <div class="card border-0 shadow-sm">
        <div class="card-header bg-white">
          <h5 class="mb-0">🎯 Recent Goals</h5>
        </div>
        <div class="card-body p-0">
          <% if @recent_goals.any? %>
            <div class="list-group list-group-flush">
              <% @recent_goals.each do |goal| %>
                <div class="list-group-item">
                  <div class="d-flex justify-content-between">
                    <strong><%= goal.title.truncate(35) %></strong>
                    <span class="badge bg-<%= goal.completed? ? 'success' : (goal.in_progress? ? 'primary' : 'secondary') %>">
                      <%= goal.status %>
                    </span>
                  </div>
                  <small class="text-muted">
                    <%= goal.goal_type %> • Priority: <%= goal.priority %>
                  </small>
                </div>
              <% end %>
            </div>
          <% else %>
            <div class="p-4 text-center text-muted">
              <p class="mb-0">No goals generated yet</p>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <!-- Recent Evolution Cycles -->
  <div class="row mt-4">
    <div class="col-12">
      <div class="card border-0 shadow-sm">
        <div class="card-header bg-white">
          <h5 class="mb-0">🧬 Recent Evolution Cycles</h5>
        </div>
        <div class="card-body">
          <% if @recent_cycles.any? %>
            <table class="table table-hover mb-0">
              <thead>
                <tr>
                  <th>Entity</th>
                  <th>Type</th>
                  <th>Status</th>
                  <th>Anomalies</th>
                  <th>Goals</th>
                  <th>Experiments</th>
                  <th>Promotions</th>
                  <th>Duration</th>
                  <th>Started</th>
                </tr>
              </thead>
              <tbody>
                <% @recent_cycles.each do |cycle| %>
                  <tr>
                    <td><%= cycle.entity&.name %></td>
                    <td><span class="badge bg-info"><%= cycle.cycle_type %></span></td>
                    <td>
                      <span class="badge bg-<%= cycle.completed? ? 'success' : (cycle.failed? ? 'danger' : 'warning') %>">
                        <%= cycle.status %>
                      </span>
                    </td>
                    <td><%= cycle.anomaly_count %></td>
                    <td><%= cycle.goals_generated %></td>
                    <td><%= cycle.experiments_started %>/<%= cycle.experiments_completed %></td>
                    <td><%= cycle.promotion_count %></td>
                    <td><%= cycle.duration_minutes %>m</td>
                    <td><%= time_ago_in_words(cycle.started_at) %> ago</td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          <% else %>
            <p class="text-center text-muted mb-0">No evolution cycles yet</p>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>

