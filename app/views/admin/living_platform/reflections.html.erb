<% content_for :title, "Reflections - #{@entity.name}" %>

<div class="container-fluid py-4">
  <!-- Header -->
  <div class="row mb-4">
    <div class="col-12">
      <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
          <li class="breadcrumb-item"><%= link_to "Living Platform", admin_living_platform_index_path %></li>
          <li class="breadcrumb-item"><%= link_to @entity.name, admin_living_platform_path(@entity) %></li>
          <li class="breadcrumb-item active">Reflections</li>
        </ol>
      </nav>
      <h1 class="mb-1">🧠 Agent Reflections</h1>
      <p class="text-muted">Metacognition - agents reflecting on their own performance</p>
    </div>
  </div>

  <!-- Stats -->
  <div class="row mb-4">
    <div class="col-md-3">
      <div class="card border-0 shadow-sm">
        <div class="card-body text-center">
          <h3 class="text-primary mb-0"><%= @reflection_stats[:avg_score] || 'N/A' %></h3>
          <small class="text-muted">Avg Score (1-10)</small>
        </div>
      </div>
    </div>
    <div class="col-md-4">
      <div class="card border-0 shadow-sm">
        <div class="card-header bg-white">
          <small class="text-muted">Common Issues</small>
        </div>
        <div class="card-body p-2">
          <% @reflection_stats[:common_issues].first(5).each do |issue, count| %>
            <span class="badge bg-warning me-1"><%= issue %>: <%= count %></span>
          <% end %>
        </div>
      </div>
    </div>
    <div class="col-md-5">
      <div class="card border-0 shadow-sm">
        <div class="card-header bg-white">
          <small class="text-muted">Knowledge Gaps</small>
        </div>
        <div class="card-body p-2">
          <% @reflection_stats[:common_gaps].first(5).each do |gap, count| %>
            <span class="badge bg-info me-1"><%= gap %>: <%= count %></span>
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <!-- Navigation Tabs -->
  <div class="row mb-4">
    <div class="col-12">
      <ul class="nav nav-tabs">
        <li class="nav-item">
          <%= link_to "Overview", admin_living_platform_path(@entity), class: "nav-link" %>
        </li>
        <li class="nav-item">
          <%= link_to "Perception", admin_living_platform_perception_path(@entity), class: "nav-link" %>
        </li>
        <li class="nav-item">
          <%= link_to "Goals", admin_living_platform_goals_path(@entity), class: "nav-link" %>
        </li>
        <li class="nav-item">
          <%= link_to "Reflections", admin_living_platform_reflections_path(@entity), class: "nav-link active" %>
        </li>
        <li class="nav-item">
          <%= link_to "Evolution", admin_living_platform_cycles_path(@entity), class: "nav-link" %>
        </li>
        <li class="nav-item">
          <%= link_to "Lifecycle", admin_living_platform_lifecycle_path(@entity), class: "nav-link" %>
        </li>
      </ul>
    </div>
  </div>

  <!-- Reflections List -->
  <div class="card border-0 shadow-sm">
    <div class="card-body p-0">
      <table class="table table-hover mb-0">
        <thead class="table-light">
          <tr>
            <th>Agent</th>
            <th>Type</th>
            <th>Score</th>
            <th>Scores Breakdown</th>
            <th>Issues</th>
            <th>Knowledge Gaps</th>
            <th>Created</th>
          </tr>
        </thead>
        <tbody>
          <% @reflections.each do |reflection| %>
            <tr>
              <td><strong><%= reflection.agent_plugin.name %></strong></td>
              <td><span class="badge bg-info"><%= reflection.reflection_type %></span></td>
              <td>
                <% score = reflection.overall_score %>
                <% if score %>
                  <span class="badge bg-<%= score >= 7 ? 'success' : (score >= 5 ? 'warning' : 'danger') %>">
                    <%= score %>/10
                  </span>
                <% else %>
                  <span class="text-muted">N/A</span>
                <% end %>
              </td>
              <td>
                <small>
                  <% if reflection.efficiency_score %>E:<%= reflection.efficiency_score %> <% end %>
                  <% if reflection.quality_score %>Q:<%= reflection.quality_score %> <% end %>
                  <% if reflection.tool_usage_score %>T:<%= reflection.tool_usage_score %> <% end %>
                  <% if reflection.communication_score %>C:<%= reflection.communication_score %><% end %>
                </small>
              </td>
              <td>
                <% if reflection.has_issues? %>
                  <span class="badge bg-warning"><%= reflection.identified_issues.count %></span>
                  <% if reflection.has_critical_issues? %>
                    <span class="badge bg-danger">Critical</span>
                  <% end %>
                <% else %>
                  <span class="text-muted">-</span>
                <% end %>
              </td>
              <td>
                <% if reflection.has_knowledge_gaps? %>
                  <span class="badge bg-info"><%= reflection.knowledge_gaps.count %></span>
                <% else %>
                  <span class="text-muted">-</span>
                <% end %>
              </td>
              <td><%= time_ago_in_words(reflection.created_at) %> ago</td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>

  <div class="d-flex justify-content-center mt-4">
    <%= paginate @reflections %>
  </div>
</div>


