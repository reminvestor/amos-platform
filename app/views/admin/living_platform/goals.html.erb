<% content_for :title, "Goals - #{@entity.name}" %>

<div class="container-fluid py-4">
  <!-- Header -->
  <div class="row mb-4">
    <div class="col-12">
      <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
          <li class="breadcrumb-item"><%= link_to "Living Platform", admin_living_platform_index_path %></li>
          <li class="breadcrumb-item"><%= link_to @entity.name, admin_living_platform_path(@entity) %></li>
          <li class="breadcrumb-item active">Goals</li>
        </ol>
      </nav>
      <h1 class="mb-1">🎯 Autonomous Goals</h1>
      <p class="text-muted">Goals generated by the Desire Engine</p>
    </div>
  </div>

  <!-- Stats -->
  <div class="row mb-4">
    <div class="col-md-3">
      <div class="card border-0 shadow-sm">
        <div class="card-body text-center">
          <h3 class="text-success mb-0"><%= @goal_stats[:completion_rate] %>%</h3>
          <small class="text-muted">Completion Rate</small>
        </div>
      </div>
    </div>
    <% @goal_stats[:by_type].each do |type, count| %>
      <div class="col-md-2">
        <div class="card border-0 shadow-sm">
          <div class="card-body text-center">
            <h4 class="text-primary mb-0"><%= count %></h4>
            <small class="text-muted"><%= type.titleize %></small>
          </div>
        </div>
      </div>
    <% end %>
  </div>

  <!-- Navigation Tabs -->
  <div class="row mb-4">
    <div class="col-12">
      <ul class="nav nav-tabs">
        <li class="nav-item">
          <%= link_to "Overview", admin_living_platform_path(@entity), class: "nav-link" %>
        </li>
        <li class="nav-item">
          <%= link_to "Perception", admin_living_platform_perception_path(@entity), class: "nav-link" %>
        </li>
        <li class="nav-item">
          <%= link_to "Goals", admin_living_platform_goals_path(@entity), class: "nav-link active" %>
        </li>
        <li class="nav-item">
          <%= link_to "Reflections", admin_living_platform_reflections_path(@entity), class: "nav-link" %>
        </li>
        <li class="nav-item">
          <%= link_to "Evolution", admin_living_platform_cycles_path(@entity), class: "nav-link" %>
        </li>
        <li class="nav-item">
          <%= link_to "Lifecycle", admin_living_platform_lifecycle_path(@entity), class: "nav-link" %>
        </li>
      </ul>
    </div>
  </div>

  <!-- Goals List -->
  <div class="card border-0 shadow-sm">
    <div class="card-body p-0">
      <table class="table table-hover mb-0">
        <thead class="table-light">
          <tr>
            <th>Title</th>
            <th>Type</th>
            <th>Priority</th>
            <th>Status</th>
            <th>Target</th>
            <th>Source</th>
            <th>Created</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <% @goals.each do |goal| %>
            <tr>
              <td>
                <strong><%= goal.title.truncate(50) %></strong>
                <% if goal.description %>
                  <br><small class="text-muted"><%= goal.description.truncate(80) %></small>
                <% end %>
              </td>
              <td>
                <span class="badge bg-<%= 
                  case goal.goal_type
                  when 'improvement' then 'primary'
                  when 'expansion' then 'success'
                  when 'maintenance' then 'warning'
                  when 'learning' then 'info'
                  when 'social' then 'secondary'
                  else 'dark'
                  end
                %>"><%= goal.goal_type %></span>
              </td>
              <td>
                <% if goal.priority >= 70 %>
                  <strong class="text-danger"><%= goal.priority %></strong>
                <% elsif goal.priority >= 50 %>
                  <span class="text-warning"><%= goal.priority %></span>
                <% else %>
                  <span class="text-muted"><%= goal.priority %></span>
                <% end %>
              </td>
              <td>
                <span class="badge bg-<%= 
                  case goal.status
                  when 'completed' then 'success'
                  when 'in_progress' then 'primary'
                  when 'scheduled' then 'info'
                  when 'failed' then 'danger'
                  when 'cancelled' then 'secondary'
                  else 'warning'
                  end
                %>"><%= goal.status %></span>
              </td>
              <td>
                <% if goal.target_type %>
                  <small><%= goal.target_type %>#<%= goal.target_id %></small>
                <% else %>
                  <small class="text-muted">Entity-wide</small>
                <% end %>
              </td>
              <td><small><%= goal.source %></small></td>
              <td><%= time_ago_in_words(goal.created_at) %> ago</td>
              <td>
                <% if goal.pending? || goal.scheduled? %>
                  <%= button_to "Cancel", admin_living_platform_cancel_goal_path(@entity, goal), 
                      method: :post, class: "btn btn-sm btn-outline-danger",
                      data: { confirm: "Are you sure?" } %>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>

  <div class="d-flex justify-content-center mt-4">
    <%= paginate @goals %>
  </div>
</div>


