<% content_for :title, "Profile - AMOS Sell" %>

<div class="row mb-4">
  <div class="col">
    <h1 class="display-5 fw-bold mb-2">
      <i class="bi bi-person-circle me-2"></i>Your Profile
    </h1>
    <p class="text-muted lead">
      Manage your affiliate account settings and payment preferences.
    </p>
  </div>
</div>

<div class="row g-4">
  <!-- Account Info -->
  <div class="col-lg-8">
    <div class="card bg-dark border-secondary">
      <div class="card-header">
        <h5 class="mb-0"><i class="bi bi-person me-2"></i>Account Information</h5>
      </div>
      <div class="card-body">
        <div class="row g-3">
          <div class="col-md-6">
            <label class="form-label text-muted small">Name</label>
            <div class="fw-semibold"><%= @profile[:name] || 'Not set' %></div>
          </div>
          <div class="col-md-6">
            <label class="form-label text-muted small">Email</label>
            <div class="fw-semibold"><%= @profile[:email] %></div>
          </div>
          <div class="col-md-6">
            <label class="form-label text-muted small">Affiliate Code</label>
            <div class="fw-semibold text-success"><%= @profile[:affiliate_code] %></div>
          </div>
          <div class="col-md-6">
            <label class="form-label text-muted small">Status</label>
            <div>
              <span class="badge bg-success"><%= @affiliate&.status&.capitalize || 'Pending' %></span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Payment Settings -->
    <div class="card bg-dark border-secondary mt-4">
      <div class="card-header">
        <h5 class="mb-0"><i class="bi bi-credit-card me-2"></i>Payment Settings</h5>
      </div>
      <div class="card-body">
        <div class="row g-3">
          <div class="col-md-6">
            <label class="form-label text-muted small">Payment Method</label>
            <div class="fw-semibold"><%= @profile[:payment_method] %></div>
          </div>
          <div class="col-md-6">
            <label class="form-label text-muted small">Minimum Payout</label>
            <div class="fw-semibold">$<%= @profile[:payout_threshold] %></div>
          </div>
        </div>
        <div class="mt-3">
          <p class="text-muted small mb-0">
            Payment settings will be available once the affiliate payout system is fully configured.
          </p>
        </div>
      </div>
    </div>
  </div>

  <!-- Stats Sidebar -->
  <div class="col-lg-4">
    <div class="card bg-dark border-secondary">
      <div class="card-header">
        <h6 class="mb-0"><i class="bi bi-graph-up me-2"></i>Quick Stats</h6>
      </div>
      <div class="card-body">
        <div class="mb-3 pb-3 border-bottom border-secondary">
          <div class="text-muted small">Total Referrals</div>
          <div class="fs-4 fw-bold"><%= @affiliate&.total_referrals || 0 %></div>
        </div>
        <div class="mb-3 pb-3 border-bottom border-secondary">
          <div class="text-muted small">Total Earned</div>
          <div class="fs-4 fw-bold text-success">$<%= number_with_delimiter(@affiliate&.total_earned || 0) %></div>
        </div>
        <div class="mb-3 pb-3 border-bottom border-secondary">
          <div class="text-muted small">Conversion Rate</div>
          <div class="fs-4 fw-bold"><%= @affiliate&.conversion_rate || 0 %>%</div>
        </div>
        <div>
          <div class="text-muted small">Commission Rate</div>
          <div class="fs-4 fw-bold"><%= (@affiliate&.commission_rate.to_f * 100).round(1) %>%</div>
        </div>
      </div>
    </div>

    <!-- Referral Link -->
    <div class="card bg-dark border-success mt-4">
      <div class="card-body">
        <h6 class="mb-3"><i class="bi bi-link-45deg me-2"></i>Your Referral Link</h6>
        <div class="input-group">
          <input type="text" class="form-control form-control-sm" id="profile-referral-link"
                 value="<%= "#{request.base_url}?ref=#{@profile[:affiliate_code]}" %>" readonly>
          <button class="btn btn-success btn-sm" onclick="navigator.clipboard.writeText(document.getElementById('profile-referral-link').value).then(() => { this.innerHTML = '<i class=\'bi bi-check\'></i>'; setTimeout(() => this.innerHTML = '<i class=\'bi bi-clipboard\'></i>', 2000) })">
            <i class="bi bi-clipboard"></i>
          </button>
        </div>
      </div>
    </div>
  </div>
</div>
