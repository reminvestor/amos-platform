<% content_for :title, "Referral Link - AMOS Sell" %>

<div class="row mb-4">
  <div class="col">
    <h1 class="display-5 fw-bold mb-2">
      <i class="bi bi-link-45deg me-2"></i>Your Referral Link
    </h1>
    <p class="text-muted lead">
      Share this link to earn commissions when people sign up.
    </p>
  </div>
</div>

<div class="row g-4">
  <div class="col-lg-8">
    <!-- Main Link Card -->
    <div class="card bg-dark border-success">
      <div class="card-body p-4">
        <h5 class="mb-3">Referral Link</h5>
        <div class="input-group input-group-lg mb-3">
          <input type="text" class="form-control" id="referral-link-main"
                 value="<%= @referral_link %>" readonly>
          <button class="btn btn-success" onclick="copyLink('referral-link-main', this)">
            <i class="bi bi-clipboard me-1"></i> Copy
          </button>
        </div>
        
        <h5 class="mb-3 mt-4">Referral Code</h5>
        <div class="input-group mb-3" style="max-width: 300px;">
          <input type="text" class="form-control fs-4 fw-bold text-center text-success" 
                 id="referral-code" value="<%= @referral_code %>" readonly>
          <button class="btn btn-outline-success" onclick="copyLink('referral-code', this)">
            <i class="bi bi-clipboard"></i>
          </button>
        </div>
      </div>
    </div>

    <!-- Share Options -->
    <div class="card bg-dark border-secondary mt-4">
      <div class="card-header">
        <h5 class="mb-0"><i class="bi bi-share me-2"></i>Share</h5>
      </div>
      <div class="card-body">
        <div class="d-flex flex-wrap gap-3">
          <a href="https://twitter.com/intent/tweet?text=Check%20out%20AMOS%20-%20AI%20powered%20marketing!&url=<%= CGI.escape(@referral_link) %>" 
             target="_blank" class="btn btn-outline-info">
            <i class="bi bi-twitter me-1"></i> Twitter
          </a>
          <a href="https://www.linkedin.com/sharing/share-offsite/?url=<%= CGI.escape(@referral_link) %>" 
             target="_blank" class="btn btn-outline-primary">
            <i class="bi bi-linkedin me-1"></i> LinkedIn
          </a>
          <a href="mailto:?subject=Check out AMOS&body=I've been using AMOS for AI-powered marketing. Check it out: <%= @referral_link %>" 
             class="btn btn-outline-light">
            <i class="bi bi-envelope me-1"></i> Email
          </a>
        </div>
      </div>
    </div>
  </div>

  <!-- QR Code Sidebar -->
  <div class="col-lg-4">
    <div class="card bg-dark border-secondary">
      <div class="card-header">
        <h6 class="mb-0"><i class="bi bi-qr-code me-2"></i>QR Code</h6>
      </div>
      <div class="card-body text-center py-4">
        <div class="bg-white rounded p-3 d-inline-block mb-3">
          <div id="qr-placeholder" class="d-flex align-items-center justify-content-center text-muted" style="width: 200px; height: 200px;">
            <div>
              <i class="bi bi-qr-code display-1"></i>
              <p class="small mt-2 mb-0">QR Code</p>
            </div>
          </div>
        </div>
        <p class="text-muted small">
          Scan this QR code to open your referral link.
        </p>
      </div>
    </div>

    <!-- Tips -->
    <div class="card bg-dark border-secondary mt-4">
      <div class="card-header">
        <h6 class="mb-0"><i class="bi bi-lightbulb me-2 text-warning"></i>Sharing Tips</h6>
      </div>
      <div class="card-body">
        <ul class="list-unstyled mb-0 small">
          <li class="mb-2 d-flex gap-2">
            <i class="bi bi-check text-success"></i>
            <span>Add the link to your email signature</span>
          </li>
          <li class="mb-2 d-flex gap-2">
            <i class="bi bi-check text-success"></i>
            <span>Share on social media with a personal recommendation</span>
          </li>
          <li class="mb-2 d-flex gap-2">
            <i class="bi bi-check text-success"></i>
            <span>Include it in blog posts or reviews</span>
          </li>
          <li class="d-flex gap-2">
            <i class="bi bi-check text-success"></i>
            <span>Use the QR code for in-person networking</span>
          </li>
        </ul>
      </div>
    </div>
  </div>
</div>

<script>
function copyLink(inputId, btn) {
  const input = document.getElementById(inputId);
  navigator.clipboard.writeText(input.value).then(() => {
    const original = btn.innerHTML;
    btn.innerHTML = '<i class="bi bi-check me-1"></i> Copied!';
    setTimeout(() => { btn.innerHTML = original; }, 2000);
  });
}
</script>
