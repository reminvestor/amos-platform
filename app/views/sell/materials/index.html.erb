<% content_for :title, "Marketing Materials - AMOS Sell" %>

<h2 class="mb-4"><i class="bi bi-folder me-2"></i>Marketing Materials</h2>

<div class="row g-4">
  <% @materials.each do |material| %>
    <div class="col-md-4">
      <div class="card bg-dark border-secondary h-100">
        <div class="card-body">
          <div class="d-flex align-items-center mb-3">
            <div class="rounded bg-success bg-opacity-25 p-3 me-3">
              <i class="bi bi-<%= material[:type] == 'pdf' ? 'file-pdf' : 'file-zip' %> text-success fs-4"></i>
            </div>
            <div>
              <h6 class="mb-0"><%= material[:name] %></h6>
              <small class="text-muted"><%= material[:size] %></small>
            </div>
          </div>
          <span class="badge bg-secondary mb-3"><%= material[:category].titleize %></span>
          <div class="d-grid">
            <button class="btn btn-outline-success btn-sm">
              <i class="bi bi-download me-2"></i>Download
            </button>
          </div>
        </div>
      </div>
    </div>
  <% end %>
</div>

<div class="card bg-dark border-success mt-5">
  <div class="card-body text-center py-4">
    <i class="bi bi-lightbulb text-success display-6 d-block mb-3"></i>
    <h5>Need Custom Materials?</h5>
    <p class="text-muted mb-0">
      Contact us at <a href="mailto:partners@amoslabs.com" class="text-success">partners@amoslabs.com</a>
      for custom co-branded materials.
    </p>
  </div>
</div>
