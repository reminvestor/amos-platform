<% content_for :title, "Leaderboard - AMOS Sell" %>

<div class="row mb-4">
  <div class="col">
    <h1 class="display-5 fw-bold mb-2">
      <i class="bi bi-trophy me-2 text-warning"></i>Affiliate Leaderboard
    </h1>
    <p class="text-muted lead">
      See how you stack up against other AMOS affiliates.
    </p>
  </div>
</div>

<!-- Your Rank Card -->
<div class="row mb-4">
  <div class="col-lg-8">
    <div class="card bg-dark border-success">
      <div class="card-body d-flex align-items-center gap-4">
        <div class="text-center" style="min-width: 80px;">
          <div class="display-4 fw-bold text-success"><%= @current_rank || '--' %></div>
          <div class="text-muted small">Your Rank</div>
        </div>
        <div class="vr bg-secondary"></div>
        <div class="flex-grow-1">
          <h5 class="mb-1"><%= current_user.full_name || current_user.email.split('@').first %></h5>
          <p class="text-muted mb-0">
            Keep sharing your referral link to climb the leaderboard!
          </p>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Leaderboard Table -->
<div class="row">
  <div class="col-lg-8">
    <div class="card bg-dark border-secondary">
      <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="mb-0"><i class="bi bi-bar-chart me-2"></i>Top Affiliates</h5>
        <span class="badge bg-success">This Month</span>
      </div>
      <div class="card-body">
        <% if @leaderboard.any? %>
          <table class="table table-dark table-hover mb-0">
            <thead>
              <tr>
                <th style="width: 60px;">Rank</th>
                <th>Affiliate</th>
                <th class="text-end">Referrals</th>
                <th class="text-end">Conversions</th>
                <th class="text-end">Earnings</th>
              </tr>
            </thead>
            <tbody>
              <% @leaderboard.each_with_index do |entry, idx| %>
                <tr class="<%= 'table-success' if entry[:user_id] == current_user.id %>">
                  <td>
                    <% if idx < 3 %>
                      <span class="fs-5"><%= ['🥇', '🥈', '🥉'][idx] %></span>
                    <% else %>
                      <span class="text-muted"><%= idx + 1 %></span>
                    <% end %>
                  </td>
                  <td><%= entry[:name] %></td>
                  <td class="text-end"><%= entry[:referrals] || 0 %></td>
                  <td class="text-end"><%= entry[:conversions] || 0 %></td>
                  <td class="text-end text-success">$<%= number_with_delimiter(entry[:earnings] || 0) %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        <% else %>
          <div class="text-center py-5 text-muted">
            <i class="bi bi-trophy display-4 d-block mb-3"></i>
            <h5>Leaderboard Coming Soon</h5>
            <p class="mb-0">Start referring to claim your spot on the leaderboard!</p>
          </div>
        <% end %>
      </div>
    </div>
  </div>

  <!-- Tips Sidebar -->
  <div class="col-lg-4">
    <div class="card bg-dark border-secondary">
      <div class="card-header">
        <h6 class="mb-0"><i class="bi bi-lightbulb me-2 text-warning"></i>Tips to Climb</h6>
      </div>
      <div class="card-body">
        <ul class="list-unstyled mb-0">
          <li class="mb-3 d-flex gap-2">
            <i class="bi bi-check-circle text-success mt-1"></i>
            <span>Share your referral link on social media for wider reach</span>
          </li>
          <li class="mb-3 d-flex gap-2">
            <i class="bi bi-check-circle text-success mt-1"></i>
            <span>Write reviews or tutorials about AMOS to drive organic traffic</span>
          </li>
          <li class="mb-3 d-flex gap-2">
            <i class="bi bi-check-circle text-success mt-1"></i>
            <span>Engage with your referrals to increase conversion rates</span>
          </li>
          <li class="d-flex gap-2">
            <i class="bi bi-check-circle text-success mt-1"></i>
            <span>Download marketing materials for professional-looking promotions</span>
          </li>
        </ul>
      </div>
    </div>
  </div>
</div>
