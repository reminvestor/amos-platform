<div class="container-fluid py-4">
  <div class="row mb-4">
    <div class="col-12">
      <h1 class="mb-3">Workflow Templates</h1>
      <p class="text-muted">Browse and customize workflow templates for your business automation needs.</p>
    </div>
  </div>

  <!-- Filters -->
  <div class="row mb-4">
    <div class="col-md-4 mb-3">
      <%= form_with url: workflow_templates_path, method: :get, local: true, class: "d-flex gap-2" do |f| %>
        <%= select_tag :category, options_for_select([
          ['All Categories', ''],
          ['Campaign Creation', 'campaign_creation'],
          ['Analytics', 'analytics'],
          ['Content Generation', 'content_generation'],
          ['Data Import', 'data_import']
        ], params[:category]), class: 'form-select', onchange: 'this.form.submit()' %>
      <% end %>
    </div>
    <div class="col-md-4 mb-3">
      <%= form_with url: workflow_templates_path, method: :get, local: true, class: "d-flex gap-2" do |f| %>
        <%= select_tag :industry, options_for_select([
          ['All Industries', ''],
          ['General', 'general'],
          ['SaaS', 'saas'],
          ['E-commerce', 'ecommerce'],
          ['Fintech', 'fintech']
        ], params[:industry]), class: 'form-select', onchange: 'this.form.submit()' %>
      <% end %>
    </div>
    <div class="col-md-4 mb-3">
      <%= form_with url: workflow_templates_path, method: :get, local: true, class: "d-flex gap-2" do |f| %>
        <%= text_field_tag :tag, params[:tag], class: 'form-control', placeholder: 'Filter by tag...' %>
        <%= submit_tag 'Search', class: 'btn btn-primary' %>
      <% end %>
    </div>
  </div>

  <!-- Template Grid -->
  <div class="row">
    <% if @templates.any? %>
      <% @templates.each do |template| %>
        <div class="col-md-6 col-lg-4 mb-4">
          <div class="card h-100">
            <div class="card-body">
              <div class="d-flex justify-content-between align-items-start mb-2">
                <h5 class="card-title mb-0"><%= template.name %></h5>
                <% if template.is_system? %>
                  <span class="badge bg-primary">System</span>
                <% elsif template.shared? %>
                  <span class="badge bg-success">Shared</span>
                <% else %>
                  <span class="badge bg-secondary">Custom</span>
                <% end %>
              </div>

              <p class="card-text text-muted small"><%= template.description %></p>

              <div class="mb-2">
                <span class="badge bg-light text-dark"><%= template.category.humanize %></span>
                <span class="badge bg-light text-dark"><%= template.industry.humanize %></span>
              </div>

              <% if template.tags.any? %>
                <div class="mb-3">
                  <% template.tags.each do |tag| %>
                    <span class="badge bg-info text-dark"><%= tag %></span>
                  <% end %>
                </div>
              <% end %>
            </div>

            <div class="card-footer bg-transparent border-top">
              <div class="d-flex gap-2">
                <%= link_to 'View Details', workflow_template_path(template), class: 'btn btn-sm btn-outline-primary' %>

                <% if template.is_system? || template.shared? %>
                  <%= button_to 'Duplicate', duplicate_workflow_template_path(template),
                      method: :post, class: 'btn btn-sm btn-primary' %>
                <% elsif template.entity_id == current_entity.id %>
                  <%= link_to 'Edit', '#', class: 'btn btn-sm btn-outline-secondary',
                      data: { bs_toggle: 'modal', bs_target: "#editTemplate#{template.id}" } %>
                  <%= button_to 'Delete', workflow_template_path(template),
                      method: :delete, class: 'btn btn-sm btn-outline-danger',
                      data: { confirm: 'Are you sure?' } %>
                <% end %>
              </div>
            </div>
          </div>
        </div>
      <% end %>
    <% else %>
      <div class="col-12">
        <div class="alert alert-info">
          <i class="bi bi-info-circle me-2"></i>
          No workflow templates found. Try adjusting your filters or create a new template.
        </div>
      </div>
    <% end %>
  </div>
</div>
