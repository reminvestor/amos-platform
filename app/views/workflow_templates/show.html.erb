<div class="container-fluid py-4">
  <div class="row">
    <div class="col-lg-8 offset-lg-2">
      <!-- Header -->
      <div class="d-flex justify-content-between align-items-start mb-4">
        <div>
          <h1 class="mb-2"><%= @template.name %></h1>
          <p class="text-muted"><%= @template.description %></p>
        </div>
        <%= link_to 'Back to Templates', workflow_templates_path, class: 'btn btn-outline-secondary' %>
      </div>

      <!-- Template Info Card -->
      <div class="card mb-4">
        <div class="card-body">
          <h5 class="card-title mb-3">Template Information</h5>

          <div class="row mb-3">
            <div class="col-md-6">
              <strong>Type:</strong>
              <% if @template.is_system? %>
                <span class="badge bg-primary ms-2">System Template</span>
              <% elsif @template.shared? %>
                <span class="badge bg-success ms-2">Shared Template</span>
              <% else %>
                <span class="badge bg-secondary ms-2">Custom Template</span>
              <% end %>
            </div>
            <div class="col-md-6">
              <strong>Status:</strong>
              <% if @template.is_active? %>
                <span class="badge bg-success ms-2">Active</span>
              <% else %>
                <span class="badge bg-secondary ms-2">Inactive</span>
              <% end %>
            </div>
          </div>

          <div class="row mb-3">
            <div class="col-md-6">
              <strong>Category:</strong>
              <span class="ms-2"><%= @template.category.humanize %></span>
            </div>
            <div class="col-md-6">
              <strong>Industry:</strong>
              <span class="ms-2"><%= @template.industry.humanize %></span>
            </div>
          </div>

          <% if @template.tags.any? %>
            <div class="mb-3">
              <strong>Tags:</strong>
              <% @template.tags.each do |tag| %>
                <span class="badge bg-info text-dark ms-2"><%= tag %></span>
              <% end %>
            </div>
          <% end %>
        </div>
      </div>

      <!-- Template Specification -->
      <div class="card mb-4">
        <div class="card-body">
          <h5 class="card-title mb-3">Workflow Specification</h5>
          <pre class="bg-light p-3 rounded"><code><%= JSON.pretty_generate(@template.template_spec) %></code></pre>
        </div>
      </div>

      <!-- Actions -->
      <div class="card">
        <div class="card-body">
          <h5 class="card-title mb-3">Actions</h5>
          <div class="d-flex gap-2">
            <% if @template.is_system? || @template.shared? %>
              <%= button_to 'Duplicate to Customize', duplicate_workflow_template_path(@template),
                  method: :post, class: 'btn btn-primary' %>
              <p class="text-muted small mb-0 align-self-center ms-3">
                Create a custom copy of this template that you can edit.
              </p>
            <% elsif @template.entity_id == current_entity.id %>
              <%= link_to 'Edit Template', '#', class: 'btn btn-primary',
                  data: { bs_toggle: 'modal', bs_target: "#editTemplate#{@template.id}" } %>
              <%= button_to 'Delete Template', workflow_template_path(@template),
                  method: :delete, class: 'btn btn-danger',
                  data: { confirm: 'Are you sure you want to delete this template?' } %>
            <% else %>
              <p class="text-muted mb-0">
                This template belongs to another entity and cannot be modified.
              </p>
            <% end %>
          </div>
        </div>
      </div>

      <!-- Template Version Info -->
      <div class="mt-4 text-muted small">
        <p class="mb-1"><strong>Created:</strong> <%= @template.created_at.strftime('%B %d, %Y at %I:%M %p') %></p>
        <p class="mb-0"><strong>Last Updated:</strong> <%= @template.updated_at.strftime('%B %d, %Y at %I:%M %p') %></p>
      </div>
    </div>
  </div>
</div>
