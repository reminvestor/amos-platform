<div class="container-fluid py-4">
  <%# Page Header %>
  <div class="admin-page-header">
    <div class="header-left">
      <div class="header-icon">
        <i data-lucide="edit"></i>
      </div>
      <div class="header-text">
        <h1>Edit Document</h1>
        <p>Update document information and organization</p>
      </div>
    </div>

    <div class="header-actions">
      <%= link_to @document, class: "admin-btn admin-btn-outline" do %>
        <i data-lucide="arrow-left"></i>
        <span>Back to Document</span>
      <% end %>
    </div>
  </div>

  <div class="row">
    <div class="col-lg-8 col-xl-6">
      <div class="admin-card">
        <%= form_with model: @document, local: true do |form| %>
          <%# Document Information %>
          <h5 class="mb-3">Document Information</h5>
          
          <div class="admin-form-group">
            <label class="admin-label">File Name</label>
            <div class="admin-input disabled">
              <i data-lucide="<%= @document.content_type_icon %>" class="me-2" style="width: 1rem; height: 1rem;"></i>
              <%= @document.original_filename %>
            </div>
          </div>

          <div class="admin-form-group">
            <%= form.label :title, class: "admin-label" %>
            <%= form.text_field :title, class: "admin-input", placeholder: "Document title" %>
          </div>

          <div class="row">
            <div class="col-md-6">
              <div class="admin-form-group">
                <%= form.label :author, class: "admin-label" %>
                <%= form.text_field :author, class: "admin-input", placeholder: "Author name" %>
              </div>
            </div>
            <div class="col-md-6">
              <div class="admin-form-group">
                <%= form.label :document_date, "Document Date", class: "admin-label" %>
                <%= form.date_field :document_date, class: "admin-input" %>
              </div>
            </div>
          </div>

          <div class="admin-form-group">
            <%= form.label :summary, class: "admin-label" %>
            <%= form.text_area :summary, class: "admin-input", rows: 3, placeholder: "Brief description of the document content..." %>
          </div>

          <hr class="my-4">

          <%# Organization %>
          <h5 class="mb-3">Organization</h5>

          <%# Subject Assignment %>
          <% if @subjects.any? %>
            <div class="admin-form-group">
              <%= form.label :subject_ids, "Assigned Folders", class: "admin-label" %>
              <div class="subject-selection">
                <% @subjects.each do |subject| %>
                  <label class="subject-checkbox">
                    <%= check_box_tag "document[subject_ids][]", 
                        subject.id, 
                        @selected_subjects.include?(subject), 
                        id: "subject_#{subject.id}" %>
                    <span class="subject-label" style="padding-left: <%= subject.ancestors.count * 1.5 %>rem;">
                      <i data-lucide="<%= subject.display_icon %>"></i>
                      <%= subject.name %>
                    </span>
                  </label>
                <% end %>
              </div>
            </div>
          <% end %>

          <%# Tags %>
          <div class="admin-form-group">
            <%= form.label :tags, class: "admin-label" %>
            <%= form.text_field :tags, 
                class: "admin-input", 
                value: @selected_tags.pluck(:name).join(', '),
                placeholder: "contract, 2024, draft" %>
            <p class="form-text text-muted">Separate tags with commas</p>
            
            <% if @selected_tags.any? %>
              <div class="current-tags mt-2">
                <span class="text-muted small">Current tags:</span>
                <% @selected_tags.each do |tag| %>
                  <span class="tag" style="background-color: <%= tag.display_color %>20; color: <%= tag.display_color %>;">
                    <%= tag.name %>
                    <button type="button" class="remove-tag" onclick="removeTag('<%= tag.name %>')">&times;</button>
                  </span>
                <% end %>
              </div>
            <% end %>
          </div>

          <hr class="my-4">

          <%# Document Status %>
          <h5 class="mb-3">Document Status</h5>
          
          <div class="row">
            <div class="col-md-6">
              <div class="status-item">
                <label class="admin-label">Processing Status</label>
                <% if @document.processing_status == 'completed' || @document.embedded_chunks_count > 0 %>
                  <span class="admin-badge admin-badge-online">Indexed</span>
                <% elsif @document.processing_status == 'processing' %>
                  <span class="admin-badge admin-badge-warning">Processing</span>
                <% elsif @document.processing_status == 'failed' %>
                  <span class="admin-badge admin-badge-offline">Failed</span>
                <% else %>
                  <span class="admin-badge admin-badge-default">Pending</span>
                <% end %>
              </div>
            </div>
            <div class="col-md-6">
              <div class="status-item">
                <label class="admin-label">Statistics</label>
                <div class="text-muted">
                  <%= @document.view_count %> views • 
                  <%= @document.chunks_count %> chunks •
                  <%= @document.file_size_human %>
                </div>
              </div>
            </div>
          </div>

          <% if @document.version > 1 %>
            <div class="alert alert-info admin-alert mt-3">
              <i data-lucide="info" class="me-2"></i>
              This is version <%= @document.version %> of this document.
              <%= link_to "View all versions", document_path(@document), class: "alert-link" %>
            </div>
          <% end %>

          <hr class="my-4">

          <div class="d-flex justify-content-between">
            <%= link_to "Cancel", @document, class: "admin-btn admin-btn-outline" %>
            <div>
              <%= link_to "Delete Document", 
                  document_path(@document), 
                  method: :delete,
                  data: { confirm: "Are you sure you want to delete this document? This action cannot be undone." },
                  class: "admin-btn admin-btn-danger me-2" %>
              <%= form.submit "Save Changes", class: "admin-btn admin-btn-primary" %>
            </div>
          </div>
        <% end %>
      </div>
    </div>

    <%# Sidebar Info %>
    <div class="col-lg-4 col-xl-3">
      <div class="admin-card">
        <h5 class="mb-3">Document Details</h5>
        
        <dl class="info-list">
          <dt>Uploaded</dt>
          <dd><%= @document.created_at.strftime("%B %d, %Y at %I:%M %p") %></dd>
          
          <dt>Last Modified</dt>
          <dd><%= @document.updated_at.strftime("%B %d, %Y at %I:%M %p") %></dd>
          
          <% if @document.last_accessed_at %>
            <dt>Last Accessed</dt>
            <dd><%= @document.last_accessed_at.strftime("%B %d, %Y at %I:%M %p") %></dd>
          <% end %>
          
          <dt>Content Type</dt>
          <dd><%= @document.content_type || 'Unknown' %></dd>
          
          <% if @document.page_count %>
            <dt>Pages</dt>
            <dd><%= @document.page_count %></dd>
          <% end %>
          
          <dt>Language</dt>
          <dd><%= @document.language.upcase %></dd>
        </dl>
      </div>

      <% if @document.rag_chunks.any? %>
        <div class="admin-card mt-3">
          <h5 class="mb-3">Processing Info</h5>
          
          <div class="processing-stats">
            <div class="stat-row">
              <span>Chunks Created</span>
              <span class="value"><%= @document.chunks_count %></span>
            </div>
            <div class="stat-row">
              <span>Embeddings</span>
              <span class="value"><%= @document.embedded_chunks_count %></span>
            </div>
            <div class="stat-row">
              <span>Progress</span>
              <span class="value"><%= @document.embedding_progress %>%</span>
            </div>
          </div>
          
          <div class="progress mt-3" style="height: 6px;">
            <div class="progress-bar bg-success" 
                 role="progressbar" 
                 style="width: <%= @document.embedding_progress %>%"
                 aria-valuenow="<%= @document.embedding_progress %>" 
                 aria-valuemin="0" 
                 aria-valuemax="100">
            </div>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>

<style>
  /* Disabled input style */
  .admin-input.disabled {
    background-color: rgba(45, 53, 72, 0.5);
    cursor: not-allowed;
    display: flex;
    align-items: center;
  }

  /* Subject Selection */
  .subject-selection {
    max-height: 300px;
    overflow-y: auto;
    border: 1px solid #1E293B;
    border-radius: 0.5rem;
    padding: 0.5rem;
    background: #0F172A;
  }

  .subject-checkbox {
    display: flex;
    align-items: center;
    padding: 0.5rem;
    border-radius: 0.375rem;
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .subject-checkbox:hover {
    background: rgba(167, 139, 250, 0.05);
  }

  .subject-checkbox input[type="checkbox"] {
    margin-right: 0.5rem;
  }

  .subject-label {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: #94A3B8;
  }

  .subject-checkbox input[type="checkbox"]:checked + .subject-label {
    color: #A78BFA;
    font-weight: 500;
  }

  /* Current Tags */
  .current-tags {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .tag {
    display: inline-flex;
    align-items: center;
    padding: 0.25rem 0.75rem;
    border-radius: 9999px;
    font-size: 0.75rem;
    font-weight: 500;
    position: relative;
  }

  .remove-tag {
    background: none;
    border: none;
    color: currentColor;
    font-size: 1.25rem;
    line-height: 1;
    margin-left: 0.25rem;
    cursor: pointer;
    opacity: 0.7;
    transition: opacity 0.15s ease;
  }

  .remove-tag:hover {
    opacity: 1;
  }

  /* Status Items */
  .status-item {
    margin-bottom: 1rem;
  }

  .status-item .admin-label {
    margin-bottom: 0.5rem;
  }

  /* Processing Stats */
  .processing-stats {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .stat-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.875rem;
  }

  .stat-row .value {
    color: white;
    font-weight: 600;
  }

  /* Info List */
  .info-list {
    margin: 0;
  }

  .info-list dt {
    color: #64748B;
    font-weight: 500;
    font-size: 0.875rem;
    margin-bottom: 0.25rem;
  }

  .info-list dd {
    color: white;
    margin-bottom: 1rem;
    font-size: 0.875rem;
  }

  .info-list dd:last-child {
    margin-bottom: 0;
  }

  /* Progress bar dark theme */
  .progress {
    background-color: #1E293B;
  }

  /* Admin danger button */
  .admin-btn-danger {
    background: transparent;
    color: #EF4444;
    border: 1px solid #EF4444;
  }

  .admin-btn-danger:hover {
    background: #EF4444;
    color: white;
  }
</style>

<script>
function removeTag(tagName) {
  const tagsInput = document.getElementById('document_tags');
  const currentTags = tagsInput.value.split(',').map(t => t.trim()).filter(t => t);
  const newTags = currentTags.filter(t => t !== tagName);
  tagsInput.value = newTags.join(', ');
}

document.addEventListener('turbo:load', () => {
  // Initialize Lucide icons
  if (typeof lucide !== 'undefined') {
    lucide.createIcons();
  }
});
</script>
