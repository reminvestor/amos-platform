<% if document.processing_status == 'processing' %>
  <div class="processing-indicator">
    <div class="spinner-border spinner-border-sm" role="status">
      <span class="visually-hidden">Processing...</span>
    </div>
    <div style="text-align: center; margin-top: 0.5rem;">
      <small class="processing-text d-block"><%= document.processing_stage_description %></small>
      <div class="progress mt-1" style="height: 4px;">
        <div class="progress-bar bg-primary" role="progressbar" style="width: <%= document.processing_progress %>%"></div>
      </div>
    </div>
  </div>
<% else %>
  <i data-lucide="<%= document.content_type_icon %>" class="preview-icon"></i>
<% end %>
<div class="document-badges">
  <% if document.processing_status == 'processing' %>
    <span class="badge badge-warning">Processing</span>
  <% elsif document.processing_status == 'failed' %>
    <span class="badge badge-danger">Failed</span>
  <% else %>
    <% document.document_tags.limit(2).each do |tag| %>
      <span class="badge badge-<%= tag.category || 'custom' %>" 
            style="background-color: <%= tag.display_color %>20; color: <%= tag.display_color %>;">
        <%= tag.name %>
      </span>
    <% end %>
  <% end %>
</div>
