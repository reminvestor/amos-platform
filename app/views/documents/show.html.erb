<div class="container-fluid py-4">
  <%# Notification area for real-time updates %>
  <div id="document-notifications"></div>
  
  <div class="row">
    <%# Document Preview/Viewer %>
    <div class="col-lg-8">
      <div class="admin-card">
        <div class="admin-card-header">
          <div class="d-flex justify-content-between align-items-start">
            <div>
              <h4 class="mb-1"><%= @document.display_title %></h4>
              <% if @document.author.present? %>
                <p class="text-muted mb-0">By <%= @document.author %> • <%= @document.document_date&.strftime("%B %d, %Y") || @document.created_at.strftime("%B %d, %Y") %></p>
              <% end %>
            </div>
            <div class="viewer-controls">
              <%= link_to documents_path, class: "admin-btn admin-btn-sm admin-btn-ghost", title: "Back to documents" do %>
                <i data-lucide="arrow-left"></i>
              <% end %>
              <%= link_to edit_document_path(@document), class: "admin-btn admin-btn-sm admin-btn-ghost", title: "Edit" do %>
                <i data-lucide="edit"></i>
              <% end %>
              <%= link_to download_document_path(@document), class: "admin-btn admin-btn-sm admin-btn-ghost", title: "Download" do %>
                <i data-lucide="download"></i>
              <% end %>
              <button class="admin-btn admin-btn-sm admin-btn-ghost" data-bs-toggle="dropdown" aria-expanded="false">
                <i data-lucide="share-2"></i>
              </button>
              <ul class="dropdown-menu dropdown-menu-end">
                <li><a class="dropdown-item" href="#" onclick="copyShareLink()">
                  <i data-lucide="link" class="me-2"></i>Copy Link
                </a></li>
                <li><a class="dropdown-item" href="#">
                  <i data-lucide="mail" class="me-2"></i>Email Document
                </a></li>
              </ul>
            </div>
          </div>
        </div>
        <div class="admin-card-body">
          <%# Document Summary %>
          <% if @document.summary.present? %>
            <div class="document-summary-box mb-4">
              <h5>Summary</h5>
              <p><%= @document.summary %></p>
            </div>
          <% end %>
          
          <%# Document Content Preview %>
          <div class="document-viewer" data-document-id="<%= @document.id %>">
            <% if @document.file.attached? %>
              <% if @document.content_type&.include?('pdf') %>
                <%# Show PDF viewer %>
                <div class="pdf-viewer-container" style="height: 600px; border: 1px solid #1E293B; border-radius: 0.5rem; overflow: hidden;">
                  <iframe 
                    src="<%= rails_blob_path(@document.file, disposition: 'inline') %>" 
                    style="width: 100%; height: 100%; border: none;"
                    title="<%= @document.display_title %>">
                  </iframe>
                </div>
              <% elsif @document.content_type&.include?('image') %>
                <%# Show image preview %>
                <div class="text-center">
                  <%= image_tag rails_blob_path(@document.file), class: "img-fluid", alt: @document.display_title %>
                </div>
              <% else %>
                <%# For other file types, show download link %>
                <div class="text-center py-5">
                  <i data-lucide="<%= @document.content_type_icon %>" style="width: 4rem; height: 4rem; color: #64748B;"></i>
                  <h5 class="mt-3"><%= @document.display_title %></h5>
                  <p class="text-muted">This file type cannot be displayed in the browser.</p>
                  <%= link_to download_document_path(@document), class: "admin-btn admin-btn-primary mt-3" do %>
                    <i data-lucide="download"></i>
                    <span>Download File</span>
                  <% end %>
                </div>
              <% end %>
              
              <%# Show processing overlay if still processing %>
              <% if @document.processing_status == 'processing' %>
                <div class="processing-overlay mt-4">
                  <div class="alert alert-info">
                    <div class="d-flex align-items-center">
                      <div class="spinner-border spinner-border-sm text-primary me-3" role="status">
                        <span class="visually-hidden">Processing...</span>
                      </div>
                      <div>
                        <strong>Processing Document...</strong>
                        <div class="small text-muted mt-1">
                          <%= @document.processing_stage_description %>
                          <span class="ms-2">(<%= @document.processing_progress %>% complete)</span>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
              <% end %>
              
            <% elsif @document.processing_status == 'completed' && @document.rag_chunks.any? %>
              <%# Show processed document content %>
              <div class="document-content">
                <% @document.rag_chunks.order(:position).limit(5).each_with_index do |chunk, index| %>
                  <div class="chunk-preview mb-3 p-3" style="background: #0F172A; border-radius: 0.5rem; border: 1px solid #1E293B;">
                    <div class="chunk-header mb-2" style="color: #94A3B8; font-size: 0.875rem;">
                      Section <%= index + 1 %> <% if chunk.page_number.present? %>(Page <%= chunk.page_number %>)<% end %>
                    </div>
                    <div class="chunk-content" style="color: #E2E8F0; line-height: 1.6;">
                      <%= simple_format(chunk.content.truncate(500)) %>
                    </div>
                  </div>
                <% end %>
                
                <% if @document.rag_chunks.count > 5 %>
                  <div class="text-center mt-3">
                    <p class="text-muted">Showing first 5 sections of <%= @document.rag_chunks.count %> total</p>
                  </div>
                <% end %>
              </div>
            <% elsif @document.processing_status == 'processing' %>
              <%# Show processing state %>
              <div class="document-preview-container">
                <div class="preview-message text-center py-5">
                  <i data-lucide="<%= @document.content_type_icon %>" class="mb-3" style="width: 4rem; height: 4rem; color: #64748B;"></i>
                  <h5>Processing Document...</h5>
                  
                  <div class="processing-details mt-3 mb-4" style="max-width: 400px; margin: 0 auto;">
                    <p class="text-primary mb-2"><strong><%= @document.processing_stage.humanize %></strong></p>
                    <p class="text-muted mb-3"><%= @document.processing_stage_description %></p>
                    
                    <div class="progress" style="height: 8px;">
                      <div class="progress-bar bg-primary progress-bar-striped progress-bar-animated" 
                           role="progressbar" 
                           style="width: <%= @document.processing_progress %>%"
                           aria-valuenow="<%= @document.processing_progress %>" 
                           aria-valuemin="0" 
                           aria-valuemax="100">
                      </div>
                    </div>
                    <small class="text-muted mt-1 d-block"><%= @document.processing_progress %>% complete</small>
                  </div>
                  
                  <% if @document.processing_stage == 'embedding' && @document.chunk_count > 0 %>
                    <div class="embedding-stats" style="background: rgba(124, 58, 237, 0.1); padding: 1rem; border-radius: 0.5rem; max-width: 300px; margin: 1rem auto;">
                      <p class="mb-1" style="color: #A78BFA; font-size: 0.875rem;">
                        <strong>Embeddings Progress</strong>
                      </p>
                      <p class="mb-0" style="color: white;">
                        <%= @document.embedded_chunks_count %> / <%= @document.chunk_count %> chunks
                      </p>
                    </div>
                  <% end %>
                  
                  <div class="mt-3">
                    <button class="admin-btn admin-btn-sm admin-btn-outline" onclick="window.location.reload()">
                      <i data-lucide="refresh-cw"></i>
                      <span>Refresh</span>
                    </button>
                  </div>
                </div>
              </div>
            <% else %>
              <%# Show failed or unknown state %>
              <div class="document-preview-container">
                <div class="preview-message text-center py-5">
                  <i data-lucide="alert-circle" class="mb-3" style="width: 4rem; height: 4rem; color: #EF4444;"></i>
                  <h5>Preview Unavailable</h5>
                  <% if @document.processing_status == 'failed' %>
                    <p class="text-danger mb-4">Document processing failed.</p>
                    <div class="d-flex gap-2 justify-content-center">
                      <%= button_to retry_processing_document_path(@document), 
                          method: :post, 
                          class: "admin-btn admin-btn-primary",
                          data: { turbo_frame: "_top" } do %>
                        <i data-lucide="refresh-cw"></i>
                        <span>Retry Processing</span>
                      <% end %>
                      <%= link_to new_document_path, class: "admin-btn admin-btn-outline" do %>
                        <i data-lucide="upload"></i>
                        <span>Upload New Version</span>
                      <% end %>
                    </div>
                  <% else %>
                    <p class="text-muted">Document preview is not available at this time.</p>
                  <% end %>
                </div>
              </div>
            <% end %>
          </div>
          
          <%# Document Chunks/Sections %>
          <% if @document.rag_chunks.any? %>
            <div class="document-sections mt-4">
              <h5>Document Sections (<%= @document.rag_chunks.count %>)</h5>
              <div class="sections-list">
                <% @document.rag_chunks.limit(5).each do |chunk| %>
                  <div class="section-item">
                    <% if chunk.metadata['heading'].present? %>
                      <h6><%= chunk.metadata['heading'] %></h6>
                    <% end %>
                    <p class="text-muted"><%= truncate(chunk.content, length: 200) %></p>
                  </div>
                <% end %>
                <% if @document.rag_chunks.count > 5 %>
                  <p class="text-center text-muted">... and <%= @document.rag_chunks.count - 5 %> more sections</p>
                <% end %>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    </div>

    <%# Sidebar: Metadata & Analytics %>
    <div class="col-lg-4">
      <%# Document Info %>
      <div class="admin-card mb-3">
        <div class="admin-card-header">
          <h5 class="mb-0">Document Information</h5>
        </div>
        <div class="admin-card-body">
          <dl class="info-list">
            <dt>File Name</dt>
            <dd><%= @document.original_filename %></dd>
            
            <dt>Type</dt>
            <dd><%= @document.content_type || 'Unknown' %></dd>
            
            <dt>Size</dt>
            <dd><%= @document.file_size_human %></dd>
            
            <% if @document.page_count.present? %>
              <dt>Pages</dt>
              <dd><%= @document.page_count %></dd>
            <% end %>
            
            <dt>Language</dt>
            <dd><%= @document.language.upcase %></dd>
            
            <dt>Uploaded</dt>
            <dd><%= @document.created_at.strftime("%B %d, %Y at %I:%M %p") %></dd>
            
            <% if @document.version > 1 %>
              <dt>Version</dt>
              <dd><%= @document.version %></dd>
            <% end %>
          </dl>
        </div>
      </div>

      <%# Collections & Tags %>
      <div class="admin-card mb-3">
        <div class="admin-card-header">
          <h5 class="mb-0">Organization</h5>
          <%= link_to edit_document_path(@document), class: "admin-btn admin-btn-sm admin-btn-ghost" do %>
            <i data-lucide="edit-2"></i>
          <% end %>
        </div>
        <div class="admin-card-body">
          <div class="mb-3">
            <label class="admin-label">Collections</label>
            <div class="selected-subjects">
              <% if @subjects.any? %>
                <% @subjects.each do |subject| %>
                  <span class="subject-tag" style="background-color: <%= subject.display_color %>20; border-color: <%= subject.display_color %>40;">
                    <i data-lucide="<%= subject.display_icon %>"></i>
                    <%= subject.name %>
                  </span>
                <% end %>
              <% else %>
                <span class="text-muted">Not organized</span>
              <% end %>
            </div>
          </div>
          
          <div>
            <label class="admin-label">Tags</label>
            <div class="selected-tags">
              <% if @tags.any? %>
                <% @tags.each do |tag| %>
                  <span class="tag" style="background-color: <%= tag.display_color %>20; color: <%= tag.display_color %>;">
                    <%= tag.name %>
                  </span>
                <% end %>
              <% else %>
                <span class="text-muted">No tags</span>
              <% end %>
            </div>
          </div>
        </div>
      </div>

      <%# Analytics %>
      <div class="admin-card mb-3">
        <div class="admin-card-header">
          <h5 class="mb-0">Usage Analytics</h5>
        </div>
        <div class="admin-card-body">
          <div class="analytics-stats">
            <div class="stat-item">
              <span class="stat-value"><%= @document.view_count %></span>
              <span class="stat-label">Total Views</span>
            </div>
            <div class="stat-item">
              <span class="stat-value"><%= @analytics[:total_queries] %></span>
              <span class="stat-label">AI Queries</span>
            </div>
            <div class="stat-item">
              <span class="stat-value"><%= @analytics[:avg_relevance] || 'N/A' %></span>
              <span class="stat-label">Avg Relevance</span>
            </div>
          </div>
          
          <% if @analytics[:popular_queries].any? %>
            <div class="mt-3">
              <h6>Popular Queries</h6>
              <ul class="list-unstyled small">
                <% @analytics[:popular_queries].first(3).each do |query_info| %>
                  <li class="py-1">
                    <span class="text-info">"<%= truncate(query_info[:query], length: 50) %>"</span>
                    <span class="text-muted">(<%= query_info[:count] %> times)</span>
                  </li>
                <% end %>
              </ul>
            </div>
          <% end %>
        </div>
      </div>

      <%# Related Documents %>
      <% if @related_documents.any? %>
        <div class="admin-card">
          <div class="admin-card-header">
            <h5 class="mb-0">Related Documents</h5>
          </div>
          <div class="admin-card-body p-0">
            <div class="related-docs-list">
              <% @related_documents.each do |doc| %>
                <%= link_to document_path(doc), class: "related-doc-item" do %>
                  <i data-lucide="<%= doc.content_type_icon %>"></i>
                  <div>
                    <h6><%= truncate(doc.display_title, length: 40) %></h6>
                    <span class="text-muted">
                      <%= doc.file_size_human %> • 
                      <%= time_ago_in_words(doc.created_at) %> ago
                    </span>
                  </div>
                <% end %>
              <% end %>
            </div>
          </div>
        </div>
      <% end %>

      <%# Version History %>
      <% if @versions && @versions.count > 1 %>
        <div class="admin-card mt-3">
          <div class="admin-card-header">
            <h5 class="mb-0">Version History</h5>
          </div>
          <div class="admin-card-body">
            <div class="version-list">
              <% @versions.each do |version| %>
                <div class="version-item">
                  <%= link_to document_path(version), 
                      class: "d-flex justify-content-between align-items-center text-decoration-none #{'active' if version.id == @document.id}" do %>
                    <div>
                      <span class="fw-semibold">Version <%= version.version %></span>
                      <% if version.is_latest_version %><span class="badge badge-primary ms-2">Latest</span><% end %>
                      <div class="small text-muted"><%= version.created_at.strftime("%B %d, %Y") %></div>
                    </div>
                    <i data-lucide="chevron-right"></i>
                  <% end %>
                </div>
              <% end %>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>

<% if @document.processing_status == 'processing' %>
  <script>
    // Subscribe to updates for this specific document
    document.addEventListener('DOMContentLoaded', function() {
      if (window.subscribeToDocument) {
        window.subscribeToDocument(<%= @document.id %>);
      }
      
      // Listen for completion events
      document.addEventListener('document:processing:complete', function(event) {
        if (event.detail.documentId === <%= @document.id %>) {
          // Show completion notification
          const notification = `
            <div class="alert alert-success alert-dismissible fade show" role="alert">
              <i data-lucide="check-circle" class="me-2"></i>
              <strong>Document Ready!</strong> The document has been processed successfully.
              <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
          `;
          document.getElementById('document-notifications').insertAdjacentHTML('beforeend', notification);
          
          // Refresh the page after a short delay to show the processed content
          setTimeout(() => {
            window.location.reload();
          }, 1500);
        }
      });
      
      // Listen for error events  
      document.addEventListener('document:processing:error', function(event) {
        if (event.detail.documentId === <%= @document.id %>) {
          // Show error notification
          const notification = `
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
              <i data-lucide="alert-circle" class="me-2"></i>
              <strong>Processing Failed!</strong> ${event.detail.error || 'An error occurred while processing the document.'}
              <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
          `;
          document.getElementById('document-notifications').insertAdjacentHTML('beforeend', notification);
        }
      });
    });
  </script>
<% end %>

<style>
  /* Document Viewer Styles */
  .document-viewer {
    min-height: 400px;
    background: #0F172A;
    border: 1px solid #1E293B;
    border-radius: 0.5rem;
    padding: 1.5rem;
  }

  .document-summary-box {
    background: rgba(167, 139, 250, 0.05);
    border: 1px solid rgba(167, 139, 250, 0.2);
    border-radius: 0.5rem;
    padding: 1rem;
  }

  .document-summary-box h5 {
    color: #A78BFA;
    font-size: 0.875rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 0.5rem;
  }

  /* Info List */
  .info-list {
    margin: 0;
  }

  .info-list dt {
    color: #64748B;
    font-weight: 500;
    font-size: 0.875rem;
    margin-bottom: 0.25rem;
  }

  .info-list dd {
    color: white;
    margin-bottom: 1rem;
    word-break: break-word;
  }

  .info-list dd:last-child {
    margin-bottom: 0;
  }

  /* Subject Tags */
  .selected-subjects {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .subject-tag {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0.25rem 0.75rem;
    border-radius: 9999px;
    font-size: 0.75rem;
    border: 1px solid;
  }

  .subject-tag i {
    width: 0.875rem;
    height: 0.875rem;
  }

  /* Tags */
  .selected-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .tag {
    display: inline-block;
    padding: 0.25rem 0.75rem;
    border-radius: 9999px;
    font-size: 0.75rem;
    font-weight: 500;
  }

  /* Analytics Stats */
  .analytics-stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
    text-align: center;
  }

  .stat-item {
    padding: 1rem 0;
  }

  .stat-value {
    display: block;
    font-size: 1.875rem;
    font-weight: 600;
    color: white;
    line-height: 1;
  }

  .stat-label {
    display: block;
    font-size: 0.75rem;
    color: #64748B;
    margin-top: 0.25rem;
  }

  /* Related Documents */
  .related-docs-list {
    display: flex;
    flex-direction: column;
  }

  .related-doc-item {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.75rem 1rem;
    border-bottom: 1px solid #1E293B;
    text-decoration: none;
    color: inherit;
    transition: all 0.15s ease;
  }

  .related-doc-item:last-child {
    border-bottom: none;
  }

  .related-doc-item:hover {
    background: rgba(255, 255, 255, 0.05);
  }

  .related-doc-item i {
    width: 1.25rem;
    height: 1.25rem;
    color: #64748B;
  }

  .related-doc-item h6 {
    color: white;
    font-size: 0.875rem;
    font-weight: 500;
    margin: 0;
  }

  /* Document Sections */
  .document-sections {
    border-top: 1px solid #1E293B;
    padding-top: 1.5rem;
  }

  .sections-list {
    margin-top: 1rem;
  }

  .section-item {
    padding: 1rem;
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid #1E293B;
    border-radius: 0.5rem;
    margin-bottom: 0.75rem;
  }

  .section-item h6 {
    color: #A78BFA;
    font-size: 0.875rem;
    margin-bottom: 0.5rem;
  }

  .section-item p {
    font-size: 0.875rem;
    line-height: 1.6;
    margin: 0;
  }

  /* Version List */
  .version-list {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .version-item a {
    padding: 0.75rem;
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid #1E293B;
    border-radius: 0.375rem;
    transition: all 0.15s ease;
  }

  .version-item a:hover {
    background: rgba(167, 139, 250, 0.1);
    border-color: #A78BFA;
  }

  .version-item a.active {
    background: rgba(167, 139, 250, 0.2);
    border-color: #A78BFA;
  }

  .version-item i {
    width: 1rem;
    height: 1rem;
    color: #64748B;
  }
</style>

<script>
function copyShareLink() {
  const url = window.location.href;
  navigator.clipboard.writeText(url).then(() => {
    // Show success message
    const toast = new bootstrap.Toast(document.createElement('div'));
    // For now, just alert
    showSuccess('Link copied to clipboard!');
  });
}

document.addEventListener('turbo:load', () => {
  // Initialize Lucide icons
  if (typeof lucide !== 'undefined') {
    lucide.createIcons();
  }
});
</script>
