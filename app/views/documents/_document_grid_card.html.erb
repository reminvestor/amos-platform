<div class="document-card" data-document-id="<%= document.id %>">
  <div class="document-preview">
    <% if document.processing_status == 'processing' %>
      <div class="processing-indicator">
        <div class="spinner-border spinner-border-sm" role="status">
          <span class="visually-hidden">Processing...</span>
        </div>
        <div style="text-align: center; margin-top: 0.5rem;">
          <small class="processing-text d-block"><%= document.processing_stage_description %></small>
          <div class="progress mt-1" style="height: 4px;">
            <div class="progress-bar bg-primary" role="progressbar" style="width: <%= document.processing_progress %>%"></div>
          </div>
        </div>
      </div>
    <% else %>
      <i data-lucide="<%= document.content_type_icon %>" class="preview-icon"></i>
    <% end %>
    <div class="document-badges">
      <% if document.processing_status == 'processing' %>
        <span class="badge badge-warning">Processing</span>
      <% elsif document.processing_status == 'failed' %>
        <span class="badge badge-danger">Failed</span>
      <% else %>
        <% document.document_tags.limit(2).each do |tag| %>
          <span class="badge badge-<%= tag.category || 'custom' %>" 
                style="background-color: <%= tag.display_color %>20; color: <%= tag.display_color %>; border: 1px solid <%= tag.display_color %>40;">
            <%= tag.name %>
          </span>
        <% end %>
        <% if document.document_tags.count > 2 %>
          <span class="badge badge-secondary">+<%= document.document_tags.count - 2 %></span>
        <% end %>
      <% end %>
    </div>
  </div>
  <div class="document-info">
    <h6><%= link_to document.display_title, document_path(document), class: "text-white text-decoration-none" %></h6>
    <p class="document-meta" style="font-size: 0.75rem; color: #94A3B8; margin: 0.25rem 0;">
      <i data-lucide="folder" style="width: 0.75rem; height: 0.75rem;"></i> <%= document.rag_store.name %>
    </p>
    <% if document.summary.present? %>
      <p class="document-summary"><%= truncate(document.summary, length: 100) %></p>
    <% end %>
    <p class="document-meta">
      <span><i data-lucide="calendar"></i> <%= document.created_at.strftime("%b %d, %Y") %></span>
      <% if document.view_count > 0 %>
        <span><i data-lucide="eye"></i> <%= document.view_count %> views</span>
      <% end %>
    </p>
    <div class="document-actions">
      <%= link_to document_path(document), class: "admin-btn admin-btn-sm admin-btn-ghost", title: "View" do %>
        <i data-lucide="eye"></i>
      <% end %>
      <%= link_to download_document_path(document), class: "admin-btn admin-btn-sm admin-btn-ghost", title: "Download" do %>
        <i data-lucide="download"></i>
      <% end %>
      <div class="dropdown d-inline-block">
        <button class="admin-btn admin-btn-sm admin-btn-ghost" type="button" data-bs-toggle="dropdown" aria-expanded="false">
          <i data-lucide="more-vertical"></i>
        </button>
        <ul class="dropdown-menu dropdown-menu-end">
          <%= link_to edit_document_path(document), class: "dropdown-item" do %>
            <i data-lucide="edit" class="me-2"></i>Edit
          <% end %>
          <% if document.processing_status == 'failed' %>
            <%= button_to retry_processing_document_path(document), 
                method: :post, 
                class: "dropdown-item",
                data: { turbo_frame: "_top" } do %>
              <i data-lucide="refresh-cw" class="me-2"></i>Retry Processing
            <% end %>
          <% end %>
          <li><hr class="dropdown-divider"></li>
          <%= link_to document_path(document), 
              method: :delete,
              data: { confirm: "Are you sure you want to delete this document?" },
              class: "dropdown-item text-danger" do %>
            <i data-lucide="trash-2" class="me-2"></i>Delete
          <% end %>
        </ul>
      </div>
    </div>
  </div>
</div>
