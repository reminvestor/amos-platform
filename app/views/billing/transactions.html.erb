<div class="container-fluid">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <div>
      <nav aria-label="breadcrumb">
        <ol class="breadcrumb mb-2">
          <li class="breadcrumb-item"><%= link_to "Billing", billing_path %></li>
          <li class="breadcrumb-item active">Transactions</li>
        </ol>
      </nav>
      <h1 class="h3 mb-0 text-white">
        <i data-lucide="list" class="me-2 text-primary"></i>
        Transaction History
      </h1>
      <p class="text-muted">Complete history of your work token transactions</p>
    </div>
  </div>

  <!-- Filters -->
  <div class="card bg-dark border-secondary mb-4">
    <div class="card-body">
      <%= form_with url: transactions_billing_path, method: :get, local: true, class: "row g-3 align-items-end" do %>
        <div class="col-md-3">
          <label class="form-label text-white">Transaction Type</label>
          <%= select_tag :type, 
              options_for_select([
                ['All Types', ''],
                ['Purchases', 'purchase'],
                ['Usage', 'usage'],
                ['Bonuses', 'bonus'],
                ['Refunds', 'refund'],
                ['Adjustments', 'adjustment']
              ], params[:type]),
              class: "form-select bg-dark text-white border-secondary" %>
        </div>
        <div class="col-md-3">
          <label class="form-label text-white">Category</label>
          <%= select_tag :category,
              options_for_select([
                ['All Categories', ''],
                ['AI Usage', 'ai_tokens'],
                ['Email', 'email'],
                ['Storage', 'storage'],
                ['API Calls', 'api_call'],
                ['Other Compute', 'other_compute'],
                ['Token Purchase', 'token_purchase'],
                ['Signup Bonus', 'signup_bonus']
              ], params[:category]),
              class: "form-select bg-dark text-white border-secondary" %>
        </div>
        <div class="col-md-2">
          <%= submit_tag "Filter", class: "btn btn-primary w-100" %>
        </div>
        <div class="col-md-2">
          <%= link_to "Clear", transactions_billing_path, class: "btn btn-outline-secondary w-100" %>
        </div>
      <% end %>
    </div>
  </div>

  <!-- Transactions Table -->
  <div class="card bg-dark border-secondary">
    <div class="card-body p-0">
      <% if @transactions.any? %>
        <div class="table-responsive">
          <table class="table table-dark table-striped table-hover mb-0">
            <thead>
              <tr>
                <th style="width: 50px;"></th>
                <th>Description</th>
                <th>Category</th>
                <th class="text-end">Amount</th>
                <th class="text-end">Balance</th>
                <th>Date</th>
              </tr>
            </thead>
            <tbody>
              <% @transactions.each do |tx| %>
                <tr>
                  <td class="text-center fs-5"><%= tx.category_icon %></td>
                  <td>
                    <div class="text-white"><%= tx.description || tx.category_label %></div>
                    <div class="small text-muted">
                      <%= tx.transaction_type.titleize %>
                      <% if tx.source_type.present? %>
                        • <%= tx.source_type.underscore.humanize %>
                      <% end %>
                    </div>
                  </td>
                  <td>
                    <span class="badge bg-secondary"><%= tx.category_label %></span>
                  </td>
                  <td class="text-end <%= tx.credit? ? 'text-success' : 'text-danger' %> fw-medium">
                    <%= tx.formatted_amount %>
                  </td>
                  <td class="text-end text-muted">
                    <%= number_with_delimiter(tx.balance_after) %>
                  </td>
                  <td class="text-muted">
                    <div><%= tx.created_at.strftime('%b %d, %Y') %></div>
                    <div class="small"><%= tx.created_at.strftime('%I:%M %p') %></div>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
        
        <!-- Pagination -->
        <% if @transactions.respond_to?(:total_pages) && @transactions.total_pages > 1 %>
          <div class="card-footer bg-dark border-secondary">
            <nav>
              <ul class="pagination justify-content-center mb-0">
                <% if @transactions.first_page? %>
                  <li class="page-item disabled"><span class="page-link">Previous</span></li>
                <% else %>
                  <li class="page-item"><%= link_to "Previous", transactions_billing_path(page: @transactions.prev_page, type: params[:type], category: params[:category]), class: "page-link" %></li>
                <% end %>
                
                <li class="page-item disabled">
                  <span class="page-link">Page <%= @transactions.current_page %> of <%= @transactions.total_pages %></span>
                </li>
                
                <% if @transactions.last_page? %>
                  <li class="page-item disabled"><span class="page-link">Next</span></li>
                <% else %>
                  <li class="page-item"><%= link_to "Next", transactions_billing_path(page: @transactions.next_page, type: params[:type], category: params[:category]), class: "page-link" %></li>
                <% end %>
              </ul>
            </nav>
          </div>
        <% end %>
      <% else %>
        <div class="text-center py-5">
          <i data-lucide="list" style="width: 48px; height: 48px; color: #64748B;" class="mb-3"></i>
          <h5 class="text-muted">No Transactions Found</h5>
          <p class="text-muted">
            <% if params[:type].present? || params[:category].present? %>
              Try adjusting your filters.
            <% else %>
              Your transaction history will appear here.
            <% end %>
          </p>
        </div>
      <% end %>
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    if (typeof lucide !== 'undefined') lucide.createIcons();
  });
</script>

