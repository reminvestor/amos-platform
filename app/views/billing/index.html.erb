<div class="container-fluid">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <div>
      <h1 class="h3 mb-0 text-white">
        <i data-lucide="coins" class="me-2 text-warning"></i>
        AMOS Work Tokens
      </h1>
      <p class="text-muted">Track your AI usage and manage billing</p>
    </div>
    <div class="d-flex gap-2">
      <%= link_to settings_billing_path, class: "btn btn-outline-secondary" do %>
        <i data-lucide="settings" style="width: 16px; height: 16px;"></i>
        Settings
      <% end %>
      <%= link_to purchase_billing_path, class: "btn btn-primary" do %>
        <i data-lucide="plus" style="width: 16px; height: 16px;"></i>
        Buy Tokens
      <% end %>
    </div>
  </div>

  <!-- Balance & Stats Cards -->
  <div class="row g-4 mb-4">
    <div class="col-md-4">
      <div class="card bg-dark border-warning h-100">
        <div class="card-body">
          <div class="d-flex align-items-center gap-3 mb-3">
            <div class="icon-circle bg-warning bg-opacity-10" style="width: 48px; height: 48px; display: flex; align-items: center; justify-content: center; border-radius: 50%;">
              <i data-lucide="coins" class="text-warning" style="width: 24px; height: 24px;"></i>
            </div>
            <div>
              <div class="text-muted small">Current Balance</div>
              <div class="h2 mb-0 text-warning"><%= number_with_delimiter(@stats[:balance]) %></div>
            </div>
          </div>
          <% if @stats[:free_remaining] > 0 %>
            <div class="small text-success">
              <i data-lucide="gift" style="width: 14px; height: 14px;"></i>
              Includes <%= number_with_delimiter(@stats[:free_remaining]) %> free tokens
            </div>
          <% end %>
          <% if @billing_account.low_balance? %>
            <div class="alert alert-warning py-2 mt-2 mb-0">
              <i data-lucide="alert-triangle" style="width: 14px; height: 14px;"></i>
              Low balance - 
              <% if @billing_account.auto_replenish_enabled? && @billing_account.has_payment_method? %>
                will auto-replenish
              <% else %>
                <%= link_to "add tokens", purchase_billing_path %>
              <% end %>
            </div>
          <% end %>
        </div>
      </div>
    </div>
    
    <div class="col-md-4">
      <div class="card bg-dark border-secondary h-100">
        <div class="card-body">
          <div class="d-flex align-items-center gap-3 mb-3">
            <div class="icon-circle bg-info bg-opacity-10" style="width: 48px; height: 48px; display: flex; align-items: center; justify-content: center; border-radius: 50%;">
              <i data-lucide="activity" class="text-info" style="width: 24px; height: 24px;"></i>
            </div>
            <div>
              <div class="text-muted small">Used This Month</div>
              <div class="h2 mb-0 text-white"><%= number_with_delimiter(@stats[:usage_this_month]) %></div>
            </div>
          </div>
          <div class="small text-muted">
            ≈ $<%= number_with_precision(@stats[:spending_this_month], precision: 2) %>
            <% if @stats[:monthly_limit] > 0 %>
              / $<%= @stats[:monthly_limit] %> limit
            <% end %>
          </div>
          <% if @stats[:monthly_limit] > 0 %>
            <div class="progress mt-2" style="height: 4px;">
              <% pct = [(@stats[:spending_this_month] / @stats[:monthly_limit] * 100), 100].min %>
              <div class="progress-bar <%= pct > 80 ? 'bg-warning' : 'bg-info' %>" style="width: <%= pct %>%"></div>
            </div>
          <% end %>
        </div>
      </div>
    </div>
    
    <div class="col-md-4">
      <div class="card bg-dark border-secondary h-100">
        <div class="card-body">
          <div class="d-flex align-items-center gap-3 mb-3">
            <div class="icon-circle bg-success bg-opacity-10" style="width: 48px; height: 48px; display: flex; align-items: center; justify-content: center; border-radius: 50%;">
              <i data-lucide="trending-up" class="text-success" style="width: 24px; height: 24px;"></i>
            </div>
            <div>
              <div class="text-muted small">Lifetime Stats</div>
              <div class="h4 mb-0 text-white"><%= number_with_delimiter(@stats[:lifetime_used]) %> used</div>
            </div>
          </div>
          <div class="small text-muted">
            <%= number_with_delimiter(@stats[:lifetime_purchased]) %> purchased total
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Usage by Category -->
  <div class="row g-4 mb-4">
    <div class="col-lg-6">
      <div class="card bg-dark border-secondary h-100">
        <div class="card-header bg-dark border-secondary d-flex justify-content-between align-items-center">
          <h5 class="mb-0 text-white">
            <i data-lucide="pie-chart" class="me-2 text-primary"></i>
            Usage by Category (30 days)
          </h5>
          <%= link_to usage_billing_path, class: "btn btn-sm btn-outline-secondary" do %>
            Details
          <% end %>
        </div>
        <div class="card-body">
          <% if @usage_summary[:by_category].any? %>
            <% max_tokens = @usage_summary[:by_category].values.max || 1 %>
            <% @usage_summary[:by_category].each do |category, tokens| %>
              <div class="mb-3">
                <div class="d-flex justify-content-between align-items-center mb-1">
                  <span>
                    <%= case category
                        when 'ai_tokens' then '🤖 AI Usage'
                        when 'email' then '📧 Email'
                        when 'storage' then '💾 Storage'
                        when 'api_call' then '🔌 API Calls'
                        when 'other_compute' then '☁️ Other Compute'
                        else category&.titleize || 'Other'
                        end %>
                  </span>
                  <span class="badge bg-secondary"><%= number_with_delimiter(tokens) %></span>
                </div>
                <div class="progress" style="height: 8px;">
                  <div class="progress-bar bg-primary" style="width: <%= (tokens.to_f / max_tokens * 100).round %>%"></div>
                </div>
              </div>
            <% end %>
          <% else %>
            <div class="text-center py-4 text-muted">
              <i data-lucide="bar-chart-2" style="width: 32px; height: 32px;" class="mb-2"></i>
              <p class="mb-0">No usage data yet</p>
            </div>
          <% end %>
        </div>
      </div>
    </div>

    <div class="col-lg-6">
      <div class="card bg-dark border-secondary h-100">
        <div class="card-header bg-dark border-secondary d-flex justify-content-between align-items-center">
          <h5 class="mb-0 text-white">
            <i data-lucide="history" class="me-2 text-primary"></i>
            Recent Activity
          </h5>
          <%= link_to transactions_billing_path, class: "btn btn-sm btn-outline-secondary" do %>
            View All
          <% end %>
        </div>
        <div class="card-body p-0">
          <% if @recent_transactions.any? %>
            <div class="table-responsive">
              <table class="table table-dark table-striped table-hover mb-0">
                <tbody>
                  <% @recent_transactions.each do |tx| %>
                    <tr>
                      <td style="width: 40px;"><%= tx.category_icon %></td>
                      <td>
                        <div><%= tx.category_label %></div>
                        <div class="small text-muted"><%= truncate(tx.description, length: 40) %></div>
                      </td>
                      <td class="text-end <%= tx.credit? ? 'text-success' : 'text-danger' %>">
                        <%= tx.formatted_amount %>
                      </td>
                      <td class="text-muted small text-end">
                        <%= time_ago_in_words(tx.created_at) %>
                      </td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            </div>
          <% else %>
            <div class="text-center py-4 text-muted">
              <i data-lucide="list" style="width: 32px; height: 32px;" class="mb-2"></i>
              <p class="mb-0">No transactions yet</p>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <!-- Recent Purchases -->
  <% if @purchases.any? %>
    <div class="card bg-dark border-secondary">
      <div class="card-header bg-dark border-secondary">
        <h5 class="mb-0 text-white">
          <i data-lucide="credit-card" class="me-2 text-success"></i>
          Recent Purchases
        </h5>
      </div>
      <div class="card-body p-0">
        <div class="table-responsive">
          <table class="table table-dark table-striped table-hover mb-0">
            <thead>
              <tr>
                <th>Date</th>
                <th>Amount</th>
                <th>Tokens</th>
                <th>Bonus</th>
                <th>Type</th>
                <th>Status</th>
              </tr>
            </thead>
            <tbody>
              <% @purchases.each do |purchase| %>
                <tr>
                  <td><%= purchase.created_at.strftime('%b %d, %Y %I:%M %p') %></td>
                  <td>$<%= number_with_precision(purchase.amount_usd, precision: 2) %></td>
                  <td><%= number_with_delimiter(purchase.tokens_purchased) %></td>
                  <td class="text-success">
                    <% if purchase.bonus_tokens > 0 %>
                      +<%= number_with_delimiter(purchase.bonus_tokens) %>
                    <% else %>
                      —
                    <% end %>
                  </td>
                  <td>
                    <span class="badge <%= purchase.auto_replenish? ? 'bg-info' : 'bg-secondary' %>">
                      <%= purchase.trigger.titleize %>
                    </span>
                  </td>
                  <td>
                    <span class="badge bg-success">Completed</span>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  <% end %>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    if (typeof lucide !== 'undefined') lucide.createIcons();
  });
</script>

