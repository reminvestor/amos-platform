            <div class="admin-card-header">
              <h5 class="mb-0 text-white">
                <i data-lucide="users" class="me-2 text-info"></i>
                Refer a Friend & Earn Tokens
              </h5>
            </div>
            <div class="admin-card-body">
              <div class="d-flex align-items-center gap-3 p-3 rounded mb-3" style="background: rgba(59, 130, 246, 0.1); border: 1px solid rgba(59, 130, 246, 0.2);">
                <div style="width: 2.5rem; height: 2.5rem; border-radius: 0.5rem; background: linear-gradient(135deg, #3B82F6 0%, #8B5CF6 100%); display: flex; align-items: center; justify-content: center;">
