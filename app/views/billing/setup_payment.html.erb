</div>

<script>
  // Dynamically load Stripe.js and initialize
  (function() {
    // Track if already initialized to prevent double initialization
    let stripeInitialized = false;
    let stripeElements = null;
    let stripeLoadAttempts = 0;
    const MAX_LOAD_ATTEMPTS = 20;
    
    function loadStripeScript() {
      return new Promise((resolve, reject) => {
        // Check if already loaded
        if (typeof Stripe !== 'undefined') {
          resolve();
          return;
        }
        
        // Check if script tag already exists
        if (document.querySelector('script[src*="js.stripe.com"]')) {
          // Script exists but not loaded yet, wait for it
          waitForStripe(resolve, reject);
          return;
        }
        
        // Create and append script
        const script = document.createElement('script');
        script.src = 'https://js.stripe.com/v3/';
        script.async = true;
        script.onload = resolve;
        script.onerror = () => reject(new Error('Failed to load Stripe.js'));
        document.head.appendChild(script);
      });
    }
    
    function waitForStripe(resolve, reject) {
      stripeLoadAttempts++;
      if (typeof Stripe !== 'undefined') {
        resolve();
      } else if (stripeLoadAttempts > MAX_LOAD_ATTEMPTS) {
        reject(new Error('Stripe.js failed to load after multiple attempts'));
      } else {
        setTimeout(() => waitForStripe(resolve, reject), 100);
      }
    }
    
    async function initializeStripe() {
      // Prevent double initialization
      if (stripeInitialized) {
        console.log('💳 Stripe already initialized, skipping');
        return;
      }
      
      // Check if elements exist
      const cardNumberContainer = document.getElementById('card-number-element');
      if (!cardNumberContainer) {
        console.log('💳 Card element container not found, skipping Stripe init');
        return;
      }
      
      // Check if already has Stripe iframe (already mounted)
      if (cardNumberContainer.querySelector('iframe')) {
        console.log('💳 Stripe Elements already mounted');
        stripeInitialized = true;
        return;
      }
      
      console.log('💳 Initializing Stripe Elements...');
      
      if (typeof lucide !== 'undefined') lucide.createIcons();
      
      // Ensure Stripe is loaded
      try {
        await loadStripeScript();
      } catch (error) {
        console.error('💳 Failed to load Stripe:', error);
        const cardErrors = document.getElementById('card-errors');
        if (cardErrors) {
          cardErrors.textContent = 'Failed to load payment system. Please refresh the page.';
        }
        return;
      }
      
      // Check for publishable key
      const publishableKey = '<%= @publishable_key %>';
      if (!publishableKey || publishableKey === '') {
        console.error('💳 Stripe publishable key is missing');
        const cardErrors = document.getElementById('card-errors');
        if (cardErrors) {
          cardErrors.textContent = 'Payment system configuration error. Please contact support.';
        }
        return;
      }
      
      const stripe = Stripe(publishableKey);
      stripeElements = stripe.elements();
      
      // Custom styling for Stripe Elements - ensure white text on dark background
      const style = {
        base: {
          color: '#ffffff',
          fontFamily: '-apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif',
          fontSmoothing: 'antialiased',
          fontSize: '16px',
          fontWeight: '400',
          '::placeholder': {
            color: '#94a3b8'
          },
          iconColor: '#94a3b8'
        },
        invalid: {
          color: '#ef4444',
          iconColor: '#ef4444'
        },
        complete: {
          color: '#22c55e',
          iconColor: '#22c55e'
        }
      };
      
      // Create separate card elements
      const cardNumberElement = stripeElements.create('cardNumber', { 
        style: style,
        showIcon: true
      });
      const cardExpiryElement = stripeElements.create('cardExpiry', { style: style });
      const cardCvcElement = stripeElements.create('cardCvc', { style: style });
      
      // Mount elements
      try {
        cardNumberElement.mount('#card-number-element');
        cardExpiryElement.mount('#card-expiry-element');
        cardCvcElement.mount('#card-cvc-element');
        stripeInitialized = true;
        console.log('💳 Stripe Elements mounted successfully');
      } catch (e) {
        console.error('💳 Error mounting Stripe Elements:', e);
        return;
      }
      
      const submitButton = document.getElementById('submit-button');
      const cardErrors = document.getElementById('card-errors');
      
      // Track completion state of each element
      let cardNumberComplete = false;
      let cardExpiryComplete = false;
      let cardCvcComplete = false;
      
      function updateSubmitButton() {
        submitButton.disabled = !(cardNumberComplete && cardExpiryComplete && cardCvcComplete);
      }
      
      // Listen for changes on each element
      cardNumberElement.on('change', function(event) {
        cardNumberComplete = event.complete;
        updateSubmitButton();
        if (event.error) {
          cardErrors.textContent = event.error.message;
        } else {
          cardErrors.textContent = '';
        }
      });
      
      cardExpiryElement.on('change', function(event) {
        cardExpiryComplete = event.complete;
        updateSubmitButton();
        if (event.error) {
          cardErrors.textContent = event.error.message;
        } else if (!cardErrors.textContent.includes('card number')) {
          cardErrors.textContent = '';
        }
      });
      
      cardCvcElement.on('change', function(event) {
        cardCvcComplete = event.complete;
        updateSubmitButton();
        if (event.error) {
          cardErrors.textContent = event.error.message;
        } else if (!cardErrors.textContent.includes('card number') && !cardErrors.textContent.includes('expir')) {
          cardErrors.textContent = '';
        }
      });

      // Focus on card number element after mounting
      cardNumberElement.on('ready', function() {
        console.log('💳 Card number element ready');
        cardNumberElement.focus();
      });

      // Toggle auto-replenish settings
      const autoReplenishCheckbox = document.getElementById('auto_replenish');
      const replenishSettings = document.getElementById('replenish-settings');
      
      if (autoReplenishCheckbox && replenishSettings) {
        autoReplenishCheckbox.addEventListener('change', function() {
          replenishSettings.style.display = this.checked ? 'block' : 'none';
        });
      }
      
      // Handle form submission
      const form = document.getElementById('payment-form');
      if (form) {
        form.addEventListener('submit', async function(event) {
          event.preventDefault();
          
          // Check for setup intent client secret
          const clientSecret = '<%= @setup_intent&.client_secret %>';
          if (!clientSecret || clientSecret === '') {
            cardErrors.textContent = 'Payment setup failed. Please refresh the page and try again.';
            console.error('💳 Setup Intent client secret is missing');
            return;
          }
          
          submitButton.disabled = true;
          document.getElementById('button-text').classList.add('d-none');
          document.getElementById('spinner').classList.remove('d-none');
          
          // Collect billing address
          const billingStreet = document.getElementById('billing_street')?.value?.trim() || '';
          const billingZip = document.getElementById('billing_zip')?.value?.trim() || '';
          const billingCountry = document.getElementById('billing_country')?.value || 'US';

          if (!billingStreet || !billingZip) {
            cardErrors.textContent = 'Street address and zip code are required for tax purposes.';
            submitButton.disabled = false;
            document.getElementById('button-text').classList.remove('d-none');
            document.getElementById('spinner').classList.add('d-none');
            return;
          }

          let setupIntentResult;
          try {
            setupIntentResult = await stripe.confirmCardSetup(
              clientSecret,
              {
                payment_method: {
                  card: cardNumberElement,
                  billing_details: {
                    address: {
                      line1: billingStreet,
                      postal_code: billingZip,
                      country: billingCountry
                    }
                  }
                }
              }
            );
          } catch (stripeError) {
            console.error('💳 Stripe confirmCardSetup error:', stripeError);
            cardErrors.textContent = 'Payment processing error. Please try again.';
            submitButton.disabled = false;
            document.getElementById('button-text').classList.remove('d-none');
            document.getElementById('spinner').classList.add('d-none');
            return;
          }
          
          const { setupIntent, error } = setupIntentResult;
          
          if (error) {
            cardErrors.textContent = error.message;
            submitButton.disabled = false;
            document.getElementById('button-text').classList.remove('d-none');
            document.getElementById('spinner').classList.add('d-none');
          } else {
            // Get settings from form
            const autoReplenish = document.getElementById('auto_replenish').checked;
            const replenishAmount = document.querySelector('input[name="replenish_amount"]:checked')?.value || 20;
            const monthlyLimit = document.getElementById('monthly_limit').value || 100;
            
            // Submit the payment method ID and settings to our server
            try {
              // Get CSRF token from multiple sources (meta tag, direct embed, or input field)
              let csrfToken = document.querySelector('meta[name="csrf-token"]')?.content;
              if (!csrfToken) {
                csrfToken = document.getElementById('csrf-token-value')?.value;
              }
              if (!csrfToken) {
                csrfToken = document.querySelector('input[name="authenticity_token"]')?.value;
              }
              if (!csrfToken) {
                console.error('💳 CSRF token not found in any location');
                throw new Error('Session expired. Please refresh the page and try again.');
              }
              
              const response = await fetch('<%= confirm_payment_method_billing_path %>', {
                method: 'POST',
                headers: {
                  'Content-Type': 'application/json',
                  'X-CSRF-Token': csrfToken
                },
                body: JSON.stringify({
                  payment_method_id: setupIntent.payment_method,
                  auto_replenish_enabled: autoReplenish,
                  auto_replenish_amount_usd: parseInt(replenishAmount),
                  monthly_limit_usd: parseInt(monthlyLimit),
                  billing_address: {
                    street: billingStreet,
                    zip: billingZip,
                    country: billingCountry
                  }
                })
              });
              
              if (response.ok) {
                <% if @is_onboarding %>
                  // After onboarding payment setup, redirect to onboarding wizard
                  window.location.href = '<%= onboarding_path %>';
                <% else %>
                  window.location.href = '<%= chat_mode_path %>';
                <% end %>
              } else {
                let errorMessage = 'Failed to save payment method';
                try {
                  const data = await response.json();
                  errorMessage = data.error || errorMessage;
                } catch (e) {
                  // Response wasn't JSON
                  console.error('💳 Non-JSON error response:', response.status);
                  errorMessage = `Server error (${response.status}). Please try again.`;
                }
                cardErrors.textContent = errorMessage;
                submitButton.disabled = false;
                document.getElementById('button-text').classList.remove('d-none');
                document.getElementById('spinner').classList.add('d-none');
              }
            } catch (fetchError) {
              console.error('💳 Fetch error:', fetchError);
              cardErrors.textContent = fetchError.message || 'Network error. Please check your connection and try again.';
              submitButton.disabled = false;
              document.getElementById('button-text').classList.remove('d-none');
              document.getElementById('spinner').classList.add('d-none');
            }
          }
        });
      }
    }
    
    // Initialize on multiple events to handle both fresh loads and Turbo navigation
    document.addEventListener('DOMContentLoaded', () => initializeStripe());
    document.addEventListener('turbo:load', () => initializeStripe());
    document.addEventListener('turbo:render', () => initializeStripe());
    
    // Also try immediately in case DOM is already ready
    if (document.readyState === 'complete' || document.readyState === 'interactive') {
      setTimeout(() => initializeStripe(), 100);
    }
  })();

  // Referral form handling - use window namespace to avoid Turbo redeclaration errors
  (function() {
    if (window._referralFormInitialized) {
      console.log('📧 Referral form already initialized, skipping');
      return;
    }
    
    function initReferralForm() {
      const form = document.getElementById('referral-form');
      const tokenCount = document.getElementById('referral-token-count');
      const submitBtn = document.getElementById('submit-referrals');
      
      if (!form || !tokenCount || !submitBtn) return;
      
      window._referralFormInitialized = true;
      console.log('📧 Initializing referral form');
    
    const emailInputs = form.querySelectorAll('input[type="email"]');
    
    function updateTokenCount() {
      let validEmails = 0;
      emailInputs.forEach(input => {
        if (input.value && input.value.includes('@') && input.value.includes('.')) {
          validEmails++;
        }
      });
      
      const tokens = validEmails * 50000;
      tokenCount.textContent = tokens.toLocaleString() + ' tokens';
      submitBtn.disabled = validEmails === 0;
    }
    
    emailInputs.forEach(input => {
      input.addEventListener('input', updateTokenCount);
    });

    submitBtn.addEventListener('click', async function() {
      const emails = [];
      emailInputs.forEach(input => {
        if (input.value && input.value.includes('@')) {
          emails.push(input.value.trim());
        }
      });
      
      if (emails.length === 0) return;
      
      submitBtn.disabled = true;
      submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Sending...';
      
      try {
        console.log('📧 Submitting referrals:', emails);
        const csrfToken = document.querySelector('meta[name="csrf-token"]')?.content || 
                          document.querySelector('input[name="authenticity_token"]')?.value || '';
        const response = await fetch('/referrals', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'X-CSRF-Token': csrfToken
          },
          body: JSON.stringify({ emails: emails })
        });
        
        console.log('📧 Response status:', response.status);
        
        if (response.ok) {
          const data = await response.json();
          console.log('📧 Success:', data);
          const modal = bootstrap.Modal.getInstance(document.getElementById('referralModal'));
          modal.hide();
          
          alert('Invitations sent! You earned ' + (emails.length * 50000).toLocaleString() + ' tokens!');
          
          emailInputs.forEach(input => input.value = '');
          updateTokenCount();
        } else {
          const text = await response.text();
          console.log('📧 Error response:', text);
          try {
            const data = JSON.parse(text);
            alert(data.error || 'Failed to send invitations. Please try again.');
          } catch (e) {
            alert('Server error: ' + response.status + '. Check Rails logs.');
          }
        }
      } catch (error) {
        console.error('📧 Fetch error:', error);
        alert('Network error: ' + error.message);
      } finally {
        submitBtn.disabled = false;
        submitBtn.innerHTML = '<i data-lucide="send" style="width: 14px; height: 14px;" class="me-1"></i> Send Invitations';
        if (typeof lucide !== 'undefined') lucide.createIcons();
      }
    });
    }
    
    document.addEventListener('DOMContentLoaded', initReferralForm);
    document.addEventListener('turbo:load', initReferralForm);
  })();
</script>

<%# Referral Modal - Theme Aware %>
<div class="modal fade" id="referralModal" tabindex="-1" aria-labelledby="referralModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="referralModalLabel">
          <i data-lucide="gift" style="width: 20px; height: 20px;" class="me-2 text-info"></i>
          Refer Friends & Earn Tokens
        </h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <div class="alert alert-info mb-4">
          <div class="d-flex align-items-center gap-2">
            <i data-lucide="info" style="width: 16px; height: 16px;"></i>
            <span>Enter up to 5 friend emails. You'll earn <strong>50,000 tokens</strong> for each, plus <strong>100,000 bonus</strong> when they sign up! Your friends get <strong>200,000 free tokens</strong> on signup.</span>
          </div>
        </div>

        <form id="referral-form">
          <div class="mb-3">
            <label class="form-label">Friend's Email #1</label>
            <input type="email" class="form-control" name="email_1" placeholder="friend@example.com">
          </div>
          <div class="mb-3">
            <label class="form-label">Friend's Email #2 <span class="text-muted">(optional)</span></label>
            <input type="email" class="form-control" name="email_2" placeholder="friend@example.com">
          </div>
          <div class="mb-3">
            <label class="form-label">Friend's Email #3 <span class="text-muted">(optional)</span></label>
            <input type="email" class="form-control" name="email_3" placeholder="friend@example.com">
          </div>
          <div class="mb-3">
            <label class="form-label">Friend's Email #4 <span class="text-muted">(optional)</span></label>
            <input type="email" class="form-control" name="email_4" placeholder="friend@example.com">
          </div>
          <div class="mb-3">
            <label class="form-label">Friend's Email #5 <span class="text-muted">(optional)</span></label>
            <input type="email" class="form-control" name="email_5" placeholder="friend@example.com">
          </div>
        </form>

        <div class="p-3 rounded mb-3" style="background: rgba(34, 197, 94, 0.1); border: 1px solid rgba(34, 197, 94, 0.2);">
          <div class="d-flex justify-content-between align-items-center small">
            <span class="text-body-secondary">Tokens you'll earn:</span>
            <span class="text-success fw-bold" id="referral-token-count">0 tokens</span>
          </div>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="button" class="btn btn-primary" id="submit-referrals" disabled>
          <i data-lucide="send" style="width: 14px; height: 14px;" class="me-1"></i>
          Send Invitations
        </button>
      </div>
    </div>
  </div>
</div>
