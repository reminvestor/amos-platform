                  </div>
                  <div class="col-6">
                    <label class="form-label text-white">CVC</label>
                    <div id="card-cvc-element" class="form-control border-secondary" style="padding: 12px; min-height: 44px; background-color: #1e293b !important;">
                      <!-- Stripe CVC will be inserted here -->
                    </div>
                  </div>
                </div>

                <%# Billing Address for tax calculation %>
                <div class="mb-4">
                  <label class="form-label text-white">Street Address</label>
                  <input type="text" class="form-control bg-dark text-white border-secondary" id="billing_street"
                         placeholder="123 Main St, Apt 4"
                         value="<%= @billing_account.billing_address&.dig('street') %>" required>
                </div>
                <div class="row mb-4">
                  <div class="col-7">
                    <label class="form-label text-white">Zip Code</label>
                    <input type="text" class="form-control bg-dark text-white border-secondary" id="billing_zip"
