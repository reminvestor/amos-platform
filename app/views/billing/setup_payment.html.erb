                </div>
              </div>

              <div class="mb-3">
                <div class="d-flex align-items-start gap-2 mb-2">
                  <div class="badge bg-primary rounded-circle" style="width: 1.5rem; height: 1.5rem; display: flex; align-items: center; justify-content: center;">1</div>
