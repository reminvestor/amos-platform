<div class="container-fluid">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <div>
      <nav aria-label="breadcrumb">
        <ol class="breadcrumb mb-2">
          <li class="breadcrumb-item"><%= link_to "Billing", billing_path %></li>
          <li class="breadcrumb-item active">Purchase History</li>
        </ol>
      </nav>
      <h1 class="h3 mb-0 text-white">
        <i data-lucide="receipt" class="me-2 text-primary"></i>
        Purchase History
      </h1>
      <p class="text-muted">View your token purchases and download receipts</p>
    </div>
    <div>
      <%= link_to purchase_billing_path, class: "btn btn-primary" do %>
        <i data-lucide="plus" style="width: 16px; height: 16px;"></i>
        Buy More Tokens
      <% end %>
    </div>
  </div>

  <!-- Purchase History Table -->
  <div class="card bg-dark border-secondary">
    <div class="card-body p-0">
      <% if @purchases.any? %>
        <div class="table-responsive">
          <table class="table table-dark table-striped table-hover mb-0">
            <thead>
              <tr>
                <th>Date</th>
                <th>Description</th>
                <th class="text-end">Amount</th>
                <th class="text-end">Tokens</th>
                <th>Type</th>
                <th>Status</th>
                <th class="text-end">Actions</th>
              </tr>
            </thead>
            <tbody>
              <% @purchases.each do |purchase| %>
                <tr>
                  <td>
                    <div class="text-white"><%= purchase.created_at.strftime('%b %d, %Y') %></div>
                    <div class="small text-muted"><%= purchase.created_at.strftime('%I:%M %p') %></div>
                  </td>
                  <td>
                    <div class="text-white">AMOS Work Tokens</div>
                    <div class="small text-muted">
                      <% if purchase.stripe_payment_intent_id.present? %>
                        Ref: <%= purchase.stripe_payment_intent_id.last(8) %>
                      <% end %>
                    </div>
                  </td>
                  <td class="text-end">
                    <div class="text-white fw-medium">$<%= number_with_precision(purchase.amount_usd, precision: 2) %></div>
                  </td>
                  <td class="text-end">
                    <div class="text-white"><%= number_with_delimiter(purchase.tokens_purchased) %></div>
                    <% if purchase.bonus_tokens > 0 %>
                      <div class="small text-success">+<%= number_with_delimiter(purchase.bonus_tokens) %> bonus</div>
                    <% end %>
                  </td>
                  <td>
                    <% badge_class = purchase.auto_replenish? ? 'bg-info' : 'bg-secondary' %>
                    <span class="badge <%= badge_class %>">
                      <%= purchase.trigger.titleize %>
                    </span>
                  </td>
                  <td>
                    <% status_badge = case purchase.status
                         when 'completed' then 'bg-success'
                         when 'pending' then 'bg-warning'
                         when 'failed' then 'bg-danger'
                         else 'bg-secondary'
                       end %>
                    <span class="badge <%= status_badge %>"><%= purchase.status.titleize %></span>
                  </td>
                  <td class="text-end">
                    <%= link_to receipt_billing_path(purchase), class: "btn btn-sm btn-outline-primary" do %>
                      <i data-lucide="file-text" style="width: 14px; height: 14px;"></i>
                      Receipt
                    <% end %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
        
        <!-- Pagination -->
        <% if @purchases.respond_to?(:total_pages) && @purchases.total_pages > 1 %>
          <div class="card-footer bg-dark border-secondary">
            <nav>
              <ul class="pagination justify-content-center mb-0">
                <% if @purchases.first_page? %>
                  <li class="page-item disabled"><span class="page-link">Previous</span></li>
                <% else %>
                  <li class="page-item"><%= link_to "Previous", invoices_billing_path(page: @purchases.prev_page), class: "page-link" %></li>
                <% end %>
                
                <li class="page-item disabled">
                  <span class="page-link">Page <%= @purchases.current_page %> of <%= @purchases.total_pages %></span>
                </li>
                
                <% if @purchases.last_page? %>
                  <li class="page-item disabled"><span class="page-link">Next</span></li>
                <% else %>
                  <li class="page-item"><%= link_to "Next", invoices_billing_path(page: @purchases.next_page), class: "page-link" %></li>
                <% end %>
              </ul>
            </nav>
          </div>
        <% end %>
      <% else %>
        <div class="text-center py-5">
          <i data-lucide="receipt" style="width: 48px; height: 48px; color: #64748B;" class="mb-3"></i>
          <h5 class="text-muted">No Purchases Yet</h5>
          <p class="text-muted mb-3">Your purchase history will appear here after you buy tokens.</p>
          <%= link_to purchase_billing_path, class: "btn btn-primary" do %>
            <i data-lucide="plus" style="width: 14px; height: 14px;"></i>
            Buy Tokens
          <% end %>
        </div>
      <% end %>
    </div>
  </div>

  <!-- Summary Stats -->
  <div class="row mt-4">
    <div class="col-md-4">
      <div class="card bg-dark border-secondary">
        <div class="card-body">
          <div class="d-flex align-items-center gap-3">
            <div style="width: 3rem; height: 3rem; border-radius: 0.75rem; background: rgba(34, 197, 94, 0.1); display: flex; align-items: center; justify-content: center; border: 1px solid rgba(34, 197, 94, 0.2);">
              <i data-lucide="dollar-sign" style="width: 1.5rem; height: 1.5rem; color: #22C55E;"></i>
            </div>
            <div>
              <p class="text-muted mb-0 small">Total Spent</p>
              <h4 class="text-white mb-0">$<%= number_with_precision(@billing_account.lifetime_spending_usd, precision: 2) %></h4>
            </div>
          </div>
        </div>
      </div>
    </div>
    <div class="col-md-4">
      <div class="card bg-dark border-secondary">
        <div class="card-body">
          <div class="d-flex align-items-center gap-3">
            <div style="width: 3rem; height: 3rem; border-radius: 0.75rem; background: rgba(234, 179, 8, 0.1); display: flex; align-items: center; justify-content: center; border: 1px solid rgba(234, 179, 8, 0.2);">
              <i data-lucide="coins" style="width: 1.5rem; height: 1.5rem; color: #EAB308;"></i>
            </div>
            <div>
              <p class="text-muted mb-0 small">Total Tokens Purchased</p>
              <h4 class="text-white mb-0"><%= number_with_delimiter(@billing_account.lifetime_tokens_purchased) %></h4>
            </div>
          </div>
        </div>
      </div>
    </div>
    <div class="col-md-4">
      <div class="card bg-dark border-secondary">
        <div class="card-body">
          <div class="d-flex align-items-center gap-3">
            <div style="width: 3rem; height: 3rem; border-radius: 0.75rem; background: rgba(124, 58, 237, 0.1); display: flex; align-items: center; justify-content: center; border: 1px solid rgba(124, 58, 237, 0.2);">
              <i data-lucide="shopping-cart" style="width: 1.5rem; height: 1.5rem; color: #A78BFA;"></i>
            </div>
            <div>
              <p class="text-muted mb-0 small">Total Purchases</p>
              <h4 class="text-white mb-0"><%= @billing_account.work_token_purchases.completed.count %></h4>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    if (typeof lucide !== 'undefined') lucide.createIcons();
  });
</script>

