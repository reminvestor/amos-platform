<div class="container-fluid">
  <!-- Mobile Back to Chat Button -->
  <div class="d-md-none mb-3">
    <%= link_to scout_path, class: "btn btn-outline-secondary d-flex align-items-center gap-2" do %>
      <i data-lucide="x" style="width: 18px; height: 18px;"></i>
      <span>Back to Chat</span>
    <% end %>
  </div>

  <div class="d-flex justify-content-between align-items-center mb-4">
    <div>
      <nav aria-label="breadcrumb">
        <ol class="breadcrumb mb-2">
          <li class="breadcrumb-item"><%= link_to "Billing", billing_path %></li>
          <li class="breadcrumb-item active">Settings</li>
        </ol>
      </nav>
      <h1 class="h3 mb-0 text-white">
        <i data-lucide="settings" class="me-2 text-primary"></i>
        Billing Settings
      </h1>
      <p class="text-muted">Manage your payment method and auto-replenishment preferences</p>
    </div>
  </div>

  <div class="row g-4">
    <!-- Payment Method -->
    <div class="col-lg-6">
      <div class="card bg-dark border-secondary">
        <div class="card-header bg-dark border-secondary">
          <h5 class="mb-0 text-white">
            <i data-lucide="credit-card" class="me-2 text-primary"></i>
            Payment Method
          </h5>
        </div>
        <div class="card-body">
          <% if @payment_method %>
            <div class="d-flex align-items-center justify-content-between p-3 bg-secondary bg-opacity-25 rounded mb-3">
              <div class="d-flex align-items-center gap-3">
                <div class="fs-3">
                  <%= case @payment_method[:brand]
                      when 'visa' then '💳'
                      when 'mastercard' then '💳'
                      when 'amex' then '💳'
                      else '💳'
                      end %>
                </div>
                <div>
                  <div class="text-white fw-medium">
                    <%= @payment_method[:brand].titleize %> •••• <%= @payment_method[:last4] %>
                  </div>
                  <div class="small text-muted">
                    Expires <%= @payment_method[:exp_month] %>/<%= @payment_method[:exp_year] %>
                  </div>
                </div>
              </div>
              <div class="badge bg-success">Active</div>
            </div>
            
            <div class="d-flex gap-2">
              <%= link_to setup_payment_billing_path, class: "btn btn-outline-primary" do %>
                <i data-lucide="refresh-cw" style="width: 14px; height: 14px;"></i>
                Update Card
              <% end %>
              <%= button_to remove_payment_method_billing_path, method: :delete, 
                  class: "btn btn-outline-danger",
                  data: { turbo_confirm: "Remove your payment method? Auto-replenishment will be disabled." } do %>
                <i data-lucide="trash-2" style="width: 14px; height: 14px;"></i>
                Remove
              <% end %>
            </div>
          <% else %>
            <div class="text-center py-4">
              <i data-lucide="credit-card" style="width: 48px; height: 48px; color: #64748B;" class="mb-3"></i>
              <h5 class="text-muted">No Payment Method</h5>
              <p class="text-muted mb-3">Add a card to enable auto-replenishment and purchase tokens.</p>
              <%= link_to setup_payment_billing_path, class: "btn btn-primary" do %>
                <i data-lucide="plus" style="width: 14px; height: 14px;"></i>
                Add Payment Method
              <% end %>
            </div>
          <% end %>
        </div>
      </div>
    </div>

    <!-- Auto-Replenishment Settings -->
    <div class="col-lg-6">
      <div class="card bg-dark border-secondary">
        <div class="card-header bg-dark border-secondary">
          <h5 class="mb-0 text-white">
            <i data-lucide="refresh-cw" class="me-2 text-primary"></i>
            Auto-Replenishment
          </h5>
        </div>
        <div class="card-body">
          <%= form_with model: @billing_account, url: settings_billing_path, method: :patch, local: true do |f| %>
            <div class="mb-4">
              <div class="form-check form-switch">
                <%= f.check_box :auto_replenish_enabled, class: "form-check-input", role: "switch", 
                    disabled: !@billing_account.has_payment_method? %>
                <%= f.label :auto_replenish_enabled, "Enable Auto-Replenishment", class: "form-check-label text-white" %>
              </div>
              <div class="form-text text-muted">
                Automatically purchase tokens when your balance is low.
                <% unless @billing_account.has_payment_method? %>
                  <br><span class="text-warning">Add a payment method to enable this feature.</span>
                <% end %>
              </div>
            </div>

            <div class="mb-3">
              <%= f.label :auto_replenish_amount_usd, "Replenishment Amount", class: "form-label text-white" %>
              <div class="input-group">
                <span class="input-group-text bg-dark text-white border-secondary">$</span>
                <%= f.select :auto_replenish_amount_usd, 
                    @config.purchase_tiers.map { |t| ["$#{t['amount_usd']} (#{number_with_delimiter(t['tokens'] + (t['bonus_tokens'] || 0))} tokens)", t['amount_usd']] },
                    {}, class: "form-select bg-dark text-white border-secondary" %>
              </div>
              <div class="form-text text-muted">Amount charged when auto-replenishing</div>
            </div>

            <div class="mb-3">
              <%= f.label :auto_replenish_threshold, "Low Balance Threshold", class: "form-label text-white" %>
              <div class="input-group">
                <%= f.number_field :auto_replenish_threshold, class: "form-control bg-dark text-white border-secondary",
                    min: 1000, step: 1000 %>
                <span class="input-group-text bg-dark text-white border-secondary">tokens</span>
              </div>
              <div class="form-text text-muted">Trigger replenishment when balance drops below this</div>
            </div>

            <div class="mb-4">
              <%= f.label :monthly_limit_usd, "Monthly Spending Limit", class: "form-label text-white" %>
              <div class="input-group">
                <span class="input-group-text bg-dark text-white border-secondary">$</span>
                <%= f.number_field :monthly_limit_usd, class: "form-control bg-dark text-white border-secondary",
                    min: 0 %>
              </div>
              <div class="form-text text-muted">Maximum to spend per month (0 = no limit)</div>
            </div>

            <div class="d-flex justify-content-end">
              <%= f.submit "Save Settings", class: "btn btn-primary" %>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <!-- Current Plan Info -->
  <div class="row g-4 mt-0">
    <div class="col-12">
      <div class="card bg-dark border-secondary">
        <div class="card-header bg-dark border-secondary">
          <h5 class="mb-0 text-white">
            <i data-lucide="info" class="me-2 text-primary"></i>
            How AMOS Work Tokens Work
          </h5>
        </div>
        <div class="card-body">
          <div class="row g-4">
            <div class="col-md-3">
              <div class="d-flex align-items-center gap-2 mb-2">
                <span class="fs-4">🤖</span>
                <strong class="text-white">AI Usage</strong>
              </div>
              <p class="text-muted small mb-0">
                Tokens are charged based on AI model usage. More powerful models cost more tokens.
              </p>
            </div>
            <div class="col-md-3">
              <div class="d-flex align-items-center gap-2 mb-2">
                <span class="fs-4">📧</span>
                <strong class="text-white">Email Sending</strong>
              </div>
              <p class="text-muted small mb-0">
                Each email sent through the platform uses tokens based on the current rate.
              </p>
            </div>
            <div class="col-md-3">
              <div class="d-flex align-items-center gap-2 mb-2">
                <span class="fs-4">💾</span>
                <strong class="text-white">Storage</strong>
              </div>
              <p class="text-muted small mb-0">
                File storage and document processing are charged based on size and duration.
              </p>
            </div>
            <div class="col-md-3">
              <div class="d-flex align-items-center gap-2 mb-2">
                <span class="fs-4">☁️</span>
                <strong class="text-white">Other Compute</strong>
              </div>
              <p class="text-muted small mb-0">
                OCR, transcription, and other AI services are charged based on usage.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    if (typeof lucide !== 'undefined') lucide.createIcons();
  });
</script>

