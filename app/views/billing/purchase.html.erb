<div class="container-fluid">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <div>
      <nav aria-label="breadcrumb">
        <ol class="breadcrumb mb-2">
          <li class="breadcrumb-item"><%= link_to "Billing", billing_path %></li>
          <li class="breadcrumb-item active">Purchase Tokens</li>
        </ol>
      </nav>
      <h1 class="h3 mb-0 text-white">
        <i data-lucide="shopping-cart" class="me-2 text-primary"></i>
        Purchase AMOS Work Tokens
      </h1>
      <p class="text-muted">Select a package to add tokens to your account</p>
    </div>
    <div>
      <div class="text-end">
        <div class="text-muted small">Current Balance</div>
        <div class="h4 text-warning mb-0"><%= number_with_delimiter(@billing_account.work_token_balance) %></div>
      </div>
    </div>
  </div>

  <% unless @billing_account.has_payment_method? %>
    <div class="alert alert-warning mb-4">
      <i data-lucide="alert-triangle" style="width: 16px; height: 16px;"></i>
      <strong>Payment method required.</strong>
      <%= link_to "Add a payment method", billing_setup_payment_path %> to purchase tokens.
    </div>
  <% end %>

  <div class="row g-4 justify-content-center">
    <% @tiers.each_with_index do |tier, index| %>
      <div class="col-md-6 col-lg-3">
        <div class="card bg-dark border-<%= index == 1 ? 'primary' : 'secondary' %> h-100 <%= 'border-2' if index == 1 %>">
          <% if index == 1 %>
            <div class="card-header bg-primary text-center py-1">
              <small class="fw-bold">MOST POPULAR</small>
            </div>
          <% end %>
          <div class="card-body text-center">
            <div class="h2 text-white mb-0">$<%= tier['amount_usd'] %></div>
            <div class="text-muted mb-4">one-time purchase</div>
            
            <div class="mb-4">
              <div class="h3 text-warning mb-0"><%= number_with_delimiter(tier['tokens']) %></div>
              <div class="text-muted">Work Tokens</div>
            </div>
            
            <% if tier['bonus_tokens'] && tier['bonus_tokens'] > 0 %>
              <div class="badge bg-success fs-6 mb-3">
                +<%= number_with_delimiter(tier['bonus_tokens']) %> BONUS
              </div>
              <div class="text-muted small mb-3">
                Total: <strong><%= number_with_delimiter(tier['tokens'] + tier['bonus_tokens']) %></strong> tokens
              </div>
            <% end %>
            
            <div class="text-muted small mb-4">
              ~$<%= number_with_precision(tier['amount_usd'].to_f / (tier['tokens'] + (tier['bonus_tokens'] || 0)) * 100000, precision: 2) %> per 100k tokens
            </div>
            
            <%= form_with url: billing_purchase_path, method: :post, local: true do |f| %>
              <%= hidden_field_tag :amount, tier['amount_usd'] %>
              <%= submit_tag "Buy Now", 
                  class: "btn btn-#{index == 1 ? 'primary' : 'outline-primary'} w-100",
                  disabled: !@billing_account.has_payment_method? %>
            <% end %>
          </div>
        </div>
      </div>
    <% end %>
  </div>

  <div class="mt-5 text-center">
    <p class="text-muted">
      <i data-lucide="shield-check" style="width: 16px; height: 16px;"></i>
      Secure payment powered by Stripe. Your card details are never stored on our servers.
    </p>
    <p class="text-muted small">
      Need a custom amount or enterprise pricing? 
      <a href="mailto:support@example.com">Contact us</a>
    </p>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    if (typeof lucide !== 'undefined') lucide.createIcons();
  });
</script>

