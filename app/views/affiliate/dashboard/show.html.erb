<% content_for :title, "Affiliate Dashboard - AMOS" %>

<div class="container-fluid py-4">
  <!-- Page Header -->
  <div class="row mb-4">
    <div class="col-12">
      <h1 class="display-5 mb-2">
        <i data-lucide="gauge" text-primary"></i>
        Affiliate Dashboard
      </h1>
      <p class="text-muted">Welcome back, <%= current_user.full_name %>!</p>
    </div>
  </div>

  <!-- Status Alert -->
  <% if @affiliate.pending? %>
    <div class="alert alert-warning" role="alert">
      <i data-lucide="hourglass" me-2"></i>
      <strong>Application Pending:</strong> Your affiliate application is under review. We'll notify you once it's approved.
    </div>
  <% elsif @affiliate.suspended? %>
    <div class="alert alert-danger" role="alert">
      <i data-lucide="alert-triangle" me-2"></i>
      <strong>Account Suspended:</strong> Your affiliate account is currently suspended. Please contact support for more information.
    </div>
  <% end %>

  <!-- Stats Cards -->
  <div class="row g-4 mb-4">
    <!-- Total Clicks -->
    <div class="col-md-3">
      <div class="card border-0 shadow-sm h-100">
        <div class="card-body">
          <div class="d-flex justify-content-between align-items-start">
            <div>
              <p class="text-muted mb-1 small">Total Clicks</p>
              <h3 class="mb-0"><%= number_with_delimiter(@stats[:total_clicks]) %></h3>
              <small class="text-muted">
                <%= number_with_delimiter(@stats[:clicks_this_month]) %> this month
              </small>
            </div>
            <div class="bg-primary bg-opacity-10 p-3 rounded">
              <i data-lucide="mouse-pointer-2" text-primary fs-4"></i>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Total Conversions -->
    <div class="col-md-3">
      <div class="card border-0 shadow-sm h-100">
        <div class="card-body">
          <div class="d-flex justify-content-between align-items-start">
            <div>
              <p class="text-muted mb-1 small">Conversions</p>
              <h3 class="mb-0"><%= number_with_delimiter(@stats[:converted_referrals]) %></h3>
              <small class="text-muted">
                <%= @stats[:total_referrals] %> total referrals
              </small>
            </div>
            <div class="bg-success bg-opacity-10 p-3 rounded">
              <i data-lucide="check-circle" text-success fs-4"></i>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Pending Commissions -->
    <div class="col-md-3">
      <div class="card border-0 shadow-sm h-100">
        <div class="card-body">
          <div class="d-flex justify-content-between align-items-start">
            <div>
              <p class="text-muted mb-1 small">Pending</p>
              <h3 class="mb-0">$<%= number_with_precision(@stats[:pending_commissions], precision: 2) %></h3>
              <small class="text-muted">Awaiting payout</small>
            </div>
            <div class="bg-warning bg-opacity-10 p-3 rounded">
              <i data-lucide="hourglass" text-warning fs-4"></i>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Total Paid -->
    <div class="col-md-3">
      <div class="card border-0 shadow-sm h-100">
        <div class="card-body">
          <div class="d-flex justify-content-between align-items-start">
            <div>
              <p class="text-muted mb-1 small">Total Earned</p>
              <h3 class="mb-0">$<%= number_with_precision(@stats[:total_earnings], precision: 2) %></h3>
              <small class="text-muted">
                $<%= number_with_precision(@stats[:paid_commissions], precision: 2) %> paid out
              </small>
            </div>
            <div class="bg-info bg-opacity-10 p-3 rounded">
              <i data-lucide="coins" text-info fs-4"></i>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="row g-4">
    <!-- Left Column -->
    <div class="col-lg-8">
      <!-- Referral Link Section -->
      <div class="card border-0 shadow-sm mb-4">
        <div class="card-header bg-white">
          <h5 class="mb-0">
            <i data-lucide="link" me-2"></i>
            Your Referral Link
          </h5>
        </div>
        <div class="card-body">
          <div class="alert alert-info mb-3">
            <i data-lucide="trophy" me-2"></i>
            <strong>Current Tier:</strong>
            <span class="badge <%= @stats[:tier] == 'gold' ? 'bg-warning text-dark' : @stats[:tier] == 'silver' ? 'bg-info' : 'bg-secondary' %>">
              <%= @stats[:tier]&.titleize || 'Bronze' %>
            </span>
            <span class="ms-2">Commission Rate: <strong><%= @stats[:commission_rate] %>%</strong></span>
          </div>

          <!-- Copy to Clipboard Controller -->
          <div data-controller="copy-to-clipboard">
            <div class="input-group input-group-lg">
              <input type="text" class="form-control"
                     data-copy-to-clipboard-target="source"
                     value="<%= request.base_url %>?ref=<%= @affiliate.affiliate_code %>"
                     readonly>
              <button class="btn btn-primary" type="button"
                      data-action="copy-to-clipboard#copy">
                <i data-lucide="clipboard" me-2"></i>
                Copy Link
              </button>
            </div>
          </div>

          <div class="mt-3 d-flex justify-content-between align-items-center">
            <div>
              <p class="mb-2 small text-muted">Share on social media:</p>
              <div class="btn-group" role="group">
                <a href="https://twitter.com/intent/tweet?text=Check%20out%20AMOS%20-%20AI-powered%20marketing%20automation!&url=<%= ERB::Util.url_encode("#{request.base_url}?ref=#{@affiliate.affiliate_code}") %>"
                   target="_blank" class="btn btn-sm btn-outline-primary">
                  <i data-lucide="twitter" me-1"></i> Twitter
                </a>
                <a href="https://www.linkedin.com/sharing/share-offsite/?url=<%= ERB::Util.url_encode("#{request.base_url}?ref=#{@affiliate.affiliate_code}") %>"
                   target="_blank" class="btn btn-sm btn-outline-primary">
                  <i data-lucide="linkedin" me-1"></i> LinkedIn
                </a>
                <a href="https://www.facebook.com/sharer/sharer.php?u=<%= ERB::Util.url_encode("#{request.base_url}?ref=#{@affiliate.affiliate_code}") %>"
                   target="_blank" class="btn btn-sm btn-outline-primary">
                  <i data-lucide="facebook" me-1"></i> Facebook
                </a>
              </div>
            </div>

            <!-- QR Code Generator -->
            <div data-controller="qr-code"
                 data-qr-code-text-value="<%= request.base_url %>?ref=<%= @affiliate.affiliate_code %>"
                 data-qr-code-size-value="200">
              <button class="btn btn-sm btn-outline-secondary"
                      data-action="qr-code#toggle">
                <i data-lucide="qr-code" me-1"></i> QR Code
              </button>
              <div class="d-none mt-3 text-center" data-qr-code-target="container">
                <canvas data-qr-code-target="canvas"></canvas>
                <div class="mt-2">
                  <button class="btn btn-sm btn-primary"
                          data-action="qr-code#download"
                          data-filename="amos-referral-qr.png">
                    <i data-lucide="download" me-1"></i> Download QR Code
                  </button>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Performance Chart -->
      <div class="card border-0 shadow-sm mb-4">
        <div class="card-header bg-white">
          <h5 class="mb-0">
            <i data-lucide="trending-up" me-2"></i>
            Click Performance (Last 30 Days)
          </h5>
        </div>
        <div class="card-body">
          <canvas data-controller="affiliate-chart"
                  data-affiliate-chart-type-value="line"
                  data-affiliate-chart-labels-value='<%= @chart_data[:clicks_labels].to_json %>'
                  data-affiliate-chart-data-value='<%= @chart_data[:clicks_data].to_json %>'
                  data-affiliate-chart-label-value="Clicks"
                  height="80"></canvas>
        </div>
      </div>

      <!-- Recent Referrals -->
      <div class="card border-0 shadow-sm">
        <div class="card-header bg-white d-flex justify-content-between align-items-center">
          <h5 class="mb-0">
            <i data-lucide="users" me-2"></i>
            Recent Referrals
          </h5>
        </div>
        <div class="card-body p-0">
          <% if @recent_referrals.any? %>
            <div class="table-responsive">
              <table class="table table-hover mb-0">
                <thead>
                  <tr>
                    <th>Date</th>
                    <th>User</th>
                    <th>Entity</th>
                    <th>Status</th>
                  </tr>
                </thead>
                <tbody>
                  <% @recent_referrals.each do |referral| %>
                    <tr>
                      <td><%= referral.created_at.strftime("%b %d, %Y") %></td>
                      <td>
                        <% if referral.referred_user %>
                          <%= referral.referred_user.email %>
                        <% else %>
                          <em class="text-muted">Anonymous</em>
                        <% end %>
                      </td>
                      <td>
                        <% if referral.referred_entity %>
                          <%= referral.referred_entity.name %>
                        <% else %>
                          <em class="text-muted">-</em>
                        <% end %>
                      </td>
                      <td>
                        <% if referral.converted? %>
                          <span class="badge bg-success">
                            <i data-lucide="check-circle" me-1"></i>Converted
                          </span>
                        <% elsif referral.cancelled? %>
                          <span class="badge bg-danger">
                            <i data-lucide="x-circle" me-1"></i>Cancelled
                          </span>
                        <% else %>
                          <span class="badge bg-warning text-dark">
                            <i data-lucide="clock" me-1"></i>Pending
                          </span>
                        <% end %>
                      </td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            </div>
          <% else %>
            <div class="text-center py-5 text-muted">
              <i data-lucide="inbox" display-1"></i>
              <p class="mt-3">No referrals yet. Start sharing your link!</p>
            </div>
          <% end %>
        </div>
      </div>
    </div>

    <!-- Right Column - Quick Actions & Recent Activity -->
    <div class="col-lg-4">
      <!-- Quick Actions -->
      <div class="card border-0 shadow-sm mb-4">
        <div class="card-header bg-white">
          <h5 class="mb-0">
            <i data-lucide="zap" me-2"></i>
            Quick Actions
          </h5>
        </div>
        <div class="card-body">
          <div class="d-grid gap-2">
            <%= link_to affiliate_resources_path, class: "btn btn-outline-primary" do %>
              <i data-lucide="download" me-2"></i>Marketing Resources
            <% end %>
            <%= link_to affiliate_payouts_path, class: "btn btn-outline-primary" do %>
              <i data-lucide="wallet" me-2"></i>Payout History
            <% end %>
          </div>
        </div>
      </div>

      <!-- Recent Clicks -->
      <div class="card border-0 shadow-sm">
        <div class="card-header bg-white">
          <h5 class="mb-0">
            <i data-lucide="clock"-history me-2"></i>
            Recent Clicks
          </h5>
        </div>
        <div class="card-body p-0">
          <% if @recent_clicks.any? %>
            <div class="list-group list-group-flush">
              <% @recent_clicks.each do |click| %>
                <div class="list-group-item">
                  <div class="d-flex justify-content-between align-items-start">
                    <div>
                      <small class="text-muted">
                        <%= time_ago_in_words(click.landed_at) %> ago
                      </small>
                      <% if click.referrer.present? %>
                        <br>
                        <small class="text-muted">
                          <i data-lucide="link""></i>
                          <%= URI.parse(click.referrer).host rescue 'Direct' %>
                        </small>
                      <% end %>
                    </div>
                    <span class="badge bg-light text-dark">
                      <i data-lucide="map-pin""></i>
                    </span>
                  </div>
                </div>
              <% end %>
            </div>
          <% else %>
            <div class="text-center py-4 text-muted">
              <i data-lucide="inbox""></i>
              <p class="mb-0 small">No clicks yet</p>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>


<!-- Lazy-load Chart.js for affiliate dashboard charts -->
<%= javascript_include_tag "chart_loader", type: "module", defer: true %>

<!-- Lazy-load QRCode for referral link QR codes -->
<%= javascript_include_tag "qrcode_loader", type: "module", defer: true %>
