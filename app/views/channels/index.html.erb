<% content_for :title, "Team Channels" %>

<div class="container-fluid py-4">
  <div class="row mb-4">
    <div class="col-12">
      <div class="d-flex justify-content-between align-items-center">
        <div>
          <h2 class="mb-1">
            <i data-lucide="users" class="me-2" style="color: var(--accent-primary);"></i>
            Team Channels
          </h2>
          <p class="text-muted mb-0">Collaborate with your team in real-time</p>
        </div>
        <div class="d-flex gap-2">
          <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#newChannelModal">
            <i data-lucide="plus" style="width: 16px; height: 16px;" class="me-1"></i>
            New Channel
          </button>
        </div>
      </div>
    </div>
  </div>

  <%# Stats Row %>
  <div class="row mb-4">
    <div class="col-md-3 col-sm-6 mb-3">
      <div class="card h-100">
        <div class="card-body d-flex align-items-center">
          <div class="rounded-circle bg-primary bg-opacity-10 p-3 me-3">
            <i data-lucide="hash" class="text-primary" style="width: 24px; height: 24px;"></i>
          </div>
          <div>
            <h3 class="mb-0"><%= @channels.count %></h3>
            <small class="text-muted">Active Channels</small>
          </div>
        </div>
      </div>
    </div>
    <div class="col-md-3 col-sm-6 mb-3">
      <div class="card h-100">
        <div class="card-body d-flex align-items-center">
          <div class="rounded-circle bg-success bg-opacity-10 p-3 me-3">
            <i data-lucide="message-circle" class="text-success" style="width: 24px; height: 24px;"></i>
          </div>
          <div>
            <h3 class="mb-0"><%= @channels.where(channel_type: 'general').count %></h3>
            <small class="text-muted">General</small>
          </div>
        </div>
      </div>
    </div>
    <div class="col-md-3 col-sm-6 mb-3">
      <div class="card h-100">
        <div class="card-body d-flex align-items-center">
          <div class="rounded-circle bg-info bg-opacity-10 p-3 me-3">
            <i data-lucide="folder" class="text-info" style="width: 24px; height: 24px;"></i>
          </div>
          <div>
            <h3 class="mb-0"><%= @channels.where(channel_type: 'project').count %></h3>
            <small class="text-muted">Project</small>
          </div>
        </div>
      </div>
    </div>
    <div class="col-md-3 col-sm-6 mb-3">
      <div class="card h-100">
        <div class="card-body d-flex align-items-center">
          <div class="rounded-circle bg-warning bg-opacity-10 p-3 me-3">
            <i data-lucide="archive" class="text-warning" style="width: 24px; height: 24px;"></i>
          </div>
          <div>
            <h3 class="mb-0"><%= @archived_channels.count %></h3>
            <small class="text-muted">Archived</small>
          </div>
        </div>
      </div>
    </div>
  </div>

  <%# Channels List %>
  <div class="row">
    <div class="col-12">
      <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center">
          <h5 class="mb-0">
            <i data-lucide="hash" class="me-2" style="width: 18px; height: 18px;"></i>
            Channels
          </h5>
        </div>
        <div class="card-body p-0">
          <% if @channels.any? %>
            <div class="list-group list-group-flush">
              <% @channels.each do |channel| %>
                <div class="list-group-item d-flex justify-content-between align-items-center py-3">
                  <div class="d-flex align-items-center">
                    <div class="channel-icon me-3">
                      <i data-lucide="<%= channel.icon %>" style="width: 20px; height: 20px;"></i>
                    </div>
                    <div>
                      <h6 class="mb-0">
                        <%= channel.name %>
                        <% if channel.is_default? %>
                          <span class="badge bg-primary ms-1">Default</span>
                        <% end %>
                      </h6>
                      <% if channel.description.present? %>
                        <small class="text-muted"><%= truncate(channel.description, length: 60) %></small>
                      <% end %>
                    </div>
                  </div>
                  <div class="d-flex align-items-center gap-2">
                    <span class="badge bg-secondary"><%= channel.channel_type.titleize %></span>
                    <div class="dropdown">
                      <button class="btn btn-sm btn-link text-muted" data-bs-toggle="dropdown">
                        <i data-lucide="more-vertical" style="width: 16px; height: 16px;"></i>
                      </button>
                      <ul class="dropdown-menu dropdown-menu-end">
                        <li>
                          <%= link_to channel_path(channel), class: "dropdown-item" do %>
                            <i data-lucide="eye" style="width: 14px; height: 14px;" class="me-2"></i>
                            View Channel
                          <% end %>
                        </li>
                        <li>
                          <%= link_to edit_channel_path(channel), class: "dropdown-item" do %>
                            <i data-lucide="pencil" style="width: 14px; height: 14px;" class="me-2"></i>
                            Edit
                          <% end %>
                        </li>
                        <% unless channel.is_default? %>
                          <li><hr class="dropdown-divider"></li>
                          <li>
                            <%= link_to archive_channel_path(channel), method: :patch, class: "dropdown-item text-warning", data: { confirm: "Archive this channel?" } do %>
                              <i data-lucide="archive" style="width: 14px; height: 14px;" class="me-2"></i>
                              Archive
                            <% end %>
                          </li>
                        <% end %>
                      </ul>
                    </div>
                  </div>
                </div>
              <% end %>
            </div>
          <% else %>
            <div class="text-center py-5">
              <i data-lucide="hash" class="mb-3" style="width: 48px; height: 48px; opacity: 0.3;"></i>
              <h5 class="mb-2">No Channels Yet</h5>
              <p class="text-muted mb-3">Create channels to start collaborating with your team</p>
              <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#newChannelModal">
                <i data-lucide="plus" style="width: 16px; height: 16px;" class="me-1"></i>
                Create First Channel
              </button>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <%# Archived Channels %>
  <% if @archived_channels.any? %>
    <div class="row mt-4">
      <div class="col-12">
        <div class="card">
          <div class="card-header">
            <h5 class="mb-0">
              <i data-lucide="archive" class="me-2" style="width: 18px; height: 18px;"></i>
              Archived Channels
            </h5>
          </div>
          <div class="card-body p-0">
            <div class="list-group list-group-flush">
              <% @archived_channels.each do |channel| %>
                <div class="list-group-item d-flex justify-content-between align-items-center py-3 opacity-75">
                  <div class="d-flex align-items-center">
                    <div class="channel-icon me-3">
                      <i data-lucide="<%= channel.icon %>" style="width: 20px; height: 20px;"></i>
                    </div>
                    <div>
                      <h6 class="mb-0"><%= channel.name %></h6>
                      <% if channel.description.present? %>
                        <small class="text-muted"><%= truncate(channel.description, length: 60) %></small>
                      <% end %>
                    </div>
                  </div>
                  <div>
                    <%= link_to unarchive_channel_path(channel), method: :patch, class: "btn btn-sm btn-outline-success" do %>
                      <i data-lucide="rotate-ccw" style="width: 14px; height: 14px;" class="me-1"></i>
                      Restore
                    <% end %>
                  </div>
                </div>
              <% end %>
            </div>
          </div>
        </div>
      </div>
    </div>
  <% end %>
</div>

<%# New Channel Modal %>
<div class="modal fade" id="newChannelModal" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">
          <i data-lucide="hash" class="me-2" style="width: 18px; height: 18px;"></i>
          New Channel
        </h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <%= form_with model: TeamChannel.new, url: channels_path, class: "needs-validation" do |f| %>
        <div class="modal-body">
          <div class="mb-3">
            <%= f.label :name, class: "form-label" %>
            <%= f.text_field :name, class: "form-control", placeholder: "e.g., marketing-team", required: true %>
          </div>
          <div class="mb-3">
            <%= f.label :description, class: "form-label" %>
            <%= f.text_area :description, class: "form-control", rows: 2, placeholder: "What's this channel about?" %>
          </div>
          <div class="mb-3">
            <%= f.label :channel_type, "Channel Type", class: "form-label" %>
            <%= f.select :channel_type, [['General', 'general'], ['Project', 'project'], ['Integration', 'integration']], {}, class: "form-select" %>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
          <%= f.submit "Create Channel", class: "btn btn-primary" %>
        </div>
      <% end %>
    </div>
  </div>
</div>

<style>
  .channel-icon {
    width: 40px;
    height: 40px;
    background: var(--bg-tertiary);
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--accent-primary);
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    if (typeof lucide !== 'undefined') lucide.createIcons();
  });
</script>
