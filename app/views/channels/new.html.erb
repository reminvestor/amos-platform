<% content_for :title, "New Channel" %>

<div class="container-fluid py-4">
  <div class="row mb-4">
    <div class="col-12">
      <div class="d-flex align-items-center">
        <%= link_to channels_path, class: "btn btn-link text-muted me-2" do %>
          <i data-lucide="arrow-left" style="width: 20px; height: 20px;"></i>
        <% end %>
        <div>
          <h2 class="mb-0">
            <i data-lucide="plus" class="me-2" style="color: var(--accent-primary);"></i>
            New Channel
          </h2>
          <p class="text-muted mb-0">Create a new channel for team collaboration</p>
        </div>
      </div>
    </div>
  </div>

  <div class="row">
    <div class="col-lg-6">
      <div class="card">
        <div class="card-body">
          <%= render 'form', channel: @channel %>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    if (typeof lucide !== 'undefined') lucide.createIcons();
  });
</script>
