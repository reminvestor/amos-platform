<div class="container-fluid py-4">
  <div class="admin-page-header">
    <div class="header-left">
      <div class="header-icon">
        <i data-lucide="wrench"></i>
      </div>
      <div class="header-text">
        <h1>Tools</h1>
        <p>Manage your custom tools</p>
      </div>
    </div>
    <div class="header-actions">
      <%= link_to new_tool_path, class: "admin-btn admin-btn-primary" do %>
        <i data-lucide="plus" aria-hidden="true"></i>
        <span>Create Tool</span>
      <% end %>
    </div>
  </div>

  <div class="admin-card">
    <h3 class="card-title">
      <i data-lucide="list" class="icon-lg icon-with-spacing"></i>
      All Tools
    </h3>
    
    <div class="table-responsive">
      <table class="admin-table">
        <thead>
          <tr>
            <th>Name</th>
            <th>Type</th>
            <th>Security</th>
            <th>Description</th>
            <th class="text-end">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% @my_tools.each do |tool| %>
            <tr>
              <td class="tool-name"><%= tool.name %></td>
              <td><span class="admin-badge admin-badge-info"><%= tool.execution_type %></span></td>
              <td>
                <% case tool.security_rating %>
                <% when 'pass' %>
                  <span class="admin-badge admin-badge-online" title="<%= tool.security_reason %>">Pass</span>
                <% when 'review' %>
                  <span class="admin-badge admin-badge-warning" title="<%= tool.security_reason %>">Review</span>
                <% when 'fail' %>
                  <span class="admin-badge admin-badge-offline" title="<%= tool.security_reason %>">Fail</span>
                <% else %>
                  <span class="admin-badge admin-badge-default">Pending</span>
                <% end %>
              </td>
              <td class="tool-desc"><%= tool.description&.truncate(50) %></td>
              <td class="text-end">
                <div class="d-inline-flex gap-2">
                  <%= link_to "View", tool_path(tool), class: "admin-btn admin-btn-sm admin-btn-outline" %>
                  <%= link_to "Edit", edit_tool_path(tool), class: "admin-btn admin-btn-sm admin-btn-outline" %>
                </div>
              </td>
            </tr>
          <% end %>
          <% if @my_tools.empty? %>
            <tr>
              <td colspan="5">
                <div class="admin-empty-state">
                  <div class="empty-icon">
                    <i data-lucide="wrench"></i>
                  </div>
                  <h3>No Custom Tools Yet</h3>
                  <p>Create your first tool to extend Amos's capabilities</p>
                  <%= link_to new_tool_path, class: "admin-btn admin-btn-primary mt-3" do %>
                    <i data-lucide="plus" aria-hidden="true"></i>
                    <span>Create Tool</span>
                  <% end %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<style>
  .tool-name {
    color: var(--text-primary);
    font-weight: 500;
  }
  
  .tool-desc {
    color: var(--text-secondary);
  }
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
  if (typeof lucide !== 'undefined') {
    lucide.createIcons();
  }
});
</script>

