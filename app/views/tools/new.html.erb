<div class="container-fluid py-4">
  <div class="admin-page-header">
    <div class="header-left">
      <%= link_to tools_path, class: "admin-btn admin-btn-secondary me-3" do %>
        <i data-lucide="arrow-left"></i>
      <% end %>
      <div class="header-icon">
        <i data-lucide="wrench"></i>
      </div>
      <div class="header-text">
        <h1>Create New Tool</h1>
        <p>Define a new custom tool for Scout to use</p>
      </div>
    </div>
  </div>

  <div class="row justify-content-center">
    <div class="col-lg-8">
      <div class="admin-card">
        <div class="admin-card-body">
          <%= form_with model: @tool, local: true do |f| %>
            <div class="mb-3">
              <%= f.label :name, class: "form-label" %>
              <%= f.text_field :name, class: "form-control", placeholder: "e.g. search_github" %>
            </div>

            <div class="mb-3">
              <%= f.label :execution_type, class: "form-label" %>
              <%= f.select :execution_type, ['ruby_code', 'http_request'], {}, class: "form-select", id: "tool_execution_type" %>
            </div>

            <div class="mb-3">
              <%= f.label :description, class: "form-label" %>
              <%= f.text_area :description, rows: 3, class: "form-control", placeholder: "What does this tool do?" %>
            </div>
            
            <div id="ruby_code_section">
              <div class="mb-3">
                <%= f.label :code, "Ruby Code", class: "form-label" %>
                <%= f.text_area :code, rows: 10, class: "form-control font-monospace", placeholder: "def execute(args)\n  # Your code here\nend" %>
              </div>
            </div>
            
            <div id="http_request_section" style="display: none;">
              <div class="alert alert-info">
                <i data-lucide="info" class="icon-sm me-2"></i>
                Configure API settings in the next step or use the JSON editor.
              </div>
            </div>

            <div class="d-flex justify-content-end gap-2">
              <%= link_to "Cancel", tools_path, class: "admin-btn admin-btn-outline" %>
              <%= f.submit "Create Tool", class: "admin-btn admin-btn-primary" %>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
  if (typeof lucide !== 'undefined') {
    lucide.createIcons();
  }
  
  const typeSelect = document.getElementById('tool_execution_type');
  const rubySection = document.getElementById('ruby_code_section');
  const httpSection = document.getElementById('http_request_section');
  
  if(typeSelect) {
    typeSelect.addEventListener('change', function() {
      if(this.value === 'ruby_code') {
        rubySection.style.display = 'block';
        httpSection.style.display = 'none';
      } else {
        rubySection.style.display = 'none';
        httpSection.style.display = 'block';
      }
    });
  }
});
</script>

