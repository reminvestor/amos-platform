<div class="container-fluid">
  <div class="row mb-4">
    <div class="col-12">
      <div class="d-sm-flex align-items-center justify-content-between">
        <h1 class="h3 mb-0 text-gray-800">Welcome, <%= current_user.full_name %></h1>
        <div>
          <%= link_to new_campaign_path, class: "btn btn-primary me-2" do %>
            <i class="fas fa-bullhorn me-1"></i> New Campaign
          <% end %>
          <%= link_to new_contact_group_path, class: "btn btn-outline-primary" do %>
            <i class="fas fa-users me-1"></i> Create Group
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <!-- Key Metrics -->
  <div class="row mb-4">
    <!-- Contacts Card -->
    <div class="col-xl-3 col-md-6 mb-4">
      <div class="card border-left-primary h-100 py-2">
        <div class="card-body">
          <div class="row no-gutters align-items-center">
            <div class="col mr-2">
              <div class="text-xs font-weight-bold text-primary text-uppercase mb-1">
                Contacts</div>
              <div class="h5 mb-0 font-weight-bold text-gray-800"><%= number_with_delimiter(@contact_count) %></div>
              <div class="small mt-2">In <%= pluralize(@contact_group_count, 'group') %></div>
            </div>
            <div class="col-auto">
              <i class="fas fa-address-book fa-2x text-gray-300"></i>
            </div>
          </div>
        </div>
        <div class="card-footer py-1 text-center">
          <%= link_to "View Contacts", contacts_path, class: "small text-primary" %>
        </div>
      </div>
    </div>

    <!-- Email Campaigns Card -->
    <div class="col-xl-3 col-md-6 mb-4">
      <div class="card border-left-success h-100 py-2">
        <div class="card-body">
          <div class="row no-gutters align-items-center">
            <div class="col mr-2">
              <div class="text-xs font-weight-bold text-success text-uppercase mb-1">
                Email Campaigns</div>
              <div class="h5 mb-0 font-weight-bold text-gray-800"><%= @campaign_count %></div>
              <div class="small mt-2"><%= @active_campaign_count %> currently active</div>
            </div>
            <div class="col-auto">
              <i class="fas fa-bullhorn fa-2x text-gray-300"></i>
            </div>
          </div>
        </div>
        <div class="card-footer py-1 text-center">
          <%= link_to "View Campaigns", campaigns_path, class: "small text-success" %>
        </div>
      </div>
    </div>

    <!-- Email Metrics Card -->
    <div class="col-xl-3 col-md-6 mb-4">
      <div class="card border-left-info h-100 py-2">
        <div class="card-body">
          <div class="row no-gutters align-items-center">
            <div class="col mr-2">
              <div class="text-xs font-weight-bold text-info text-uppercase mb-1">
                Email Performance</div>
              <div class="text-center mb-1">
                <div class="h5 mb-0 font-weight-bold text-gray-800"><%= @open_rate %>%</div>
                <div class="small">Open Rate</div>
              </div>
              <div class="progress mb-1" style="height: 6px;">
                <div class="progress-bar bg-info" role="progressbar" style="width: <%= @open_rate %>%"
                    aria-valuenow="<%= @open_rate %>" aria-valuemin="0" aria-valuemax="100"></div>
              </div>
              <div class="d-flex justify-content-between small mt-2">
                <span><%= number_with_delimiter(@email_sent_count) %> Sent</span>
                <span><%= number_with_delimiter(@email_clicked_count) %> Clicked</span>
              </div>
            </div>
            <div class="col-auto">
              <i class="fas fa-envelope fa-2x text-gray-300"></i>
            </div>
          </div>
        </div>
        <div class="card-footer py-1 text-center">
          <a href="#" class="small text-info">View Analytics</a>
        </div>
      </div>
    </div>

    <!-- Social Media Card -->
    <div class="col-xl-3 col-md-6 mb-4">
      <div class="card border-left-warning h-100 py-2">
        <div class="card-body">
          <div class="row no-gutters align-items-center">
            <div class="col mr-2">
              <div class="text-xs font-weight-bold text-warning text-uppercase mb-1">
                Social Media</div>
              <div class="h5 mb-0 font-weight-bold text-gray-800"><%= @social_post_count %></div>
              <div class="small mt-2">Across multiple platforms</div>
            </div>
            <div class="col-auto">
              <i class="fas fa-share-alt fa-2x text-gray-300"></i>
            </div>
          </div>
        </div>
        <div class="card-footer py-1 text-center">
          <%= link_to "View Posts", social_posts_path, class: "small text-warning" %>
        </div>
      </div>
    </div>
  </div>

  <div class="row">
    <!-- Recent Campaigns & Activity -->
    <div class="col-lg-8">
      <div class="card mb-4">
        <div class="card-header d-flex justify-content-between align-items-center">
          <h6 class="m-0 font-weight-bold">Recent Campaigns</h6>
          <%= link_to "View All", campaigns_path, class: "btn btn-sm btn-primary" %>
        </div>
        <div class="card-body">
          <% if @campaigns.any? %>
            <div class="table-responsive">
              <table class="table table-hover">
                <thead>
                  <tr>
                    <th>Name</th>
                    <th>Status</th>
                    <th>Sent</th>
                    <th>Opens</th>
                    <th>Actions</th>
                  </tr>
                </thead>
                <tbody>
                  <% @campaigns.each do |campaign| %>
                    <tr>
                      <td><%= link_to campaign.name, campaign_path(campaign) %></td>
                      <td>
                        <% case campaign.status %>
                        <% when 'draft' %>
                          <span class="badge bg-secondary">Draft</span>
                        <% when 'scheduled' %>
                          <span class="badge bg-info">Scheduled</span>
                        <% when 'active' %>
                          <span class="badge bg-success">Active</span>
                        <% when 'completed' %>
                          <span class="badge bg-primary">Completed</span>
                        <% when 'paused' %>
                          <span class="badge bg-warning">Paused</span>
                        <% else %>
                          <span class="badge bg-light"><%= campaign.status.titleize %></span>
                        <% end %>
                      </td>
                      <td><%= campaign.email_deliveries.count %></td>
                      <td><%= campaign.email_deliveries.where.not(opened_at: nil).count %></td>
                      <td>
                        <div class="btn-group btn-group-sm">
                          <%= link_to campaign_path(campaign), class: "btn btn-outline-primary" do %>
                            <i class="fas fa-eye"></i>
                          <% end %>
                          <%= link_to edit_campaign_path(campaign), class: "btn btn-outline-secondary" do %>
                            <i class="fas fa-edit"></i>
                          <% end %>
                        </div>
                      </td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            </div>
          <% else %>
            <div class="text-center py-5">
              <i class="fas fa-bullhorn fa-4x text-muted mb-3"></i>
              <h5>No campaigns yet</h5>
              <p class="mb-0">Create your first email campaign to reach your audience</p>
              <%= link_to "Create Campaign", new_campaign_path, class: "btn btn-primary mt-3" %>
            </div>
          <% end %>
        </div>
      </div>
    </div>

    <!-- Quick Actions & Upcoming Features -->
    <div class="col-lg-4">
      <!-- Quick Actions -->
      <div class="card mb-4">
        <div class="card-header">
          <h6 class="m-0 font-weight-bold">Quick Actions</h6>
        </div>
        <div class="card-body">
          <div class="row">
            <div class="col-6 mb-3">
              <%= link_to new_contact_path, class: "btn btn-light btn-block h-100 d-flex flex-column align-items-center justify-content-center p-3" do %>
                <i class="fas fa-user-plus fa-2x mb-2"></i>
                <span>Add Contact</span>
              <% end %>
            </div>
            <div class="col-6 mb-3">
              <%= link_to new_email_template_path, class: "btn btn-light btn-block h-100 d-flex flex-column align-items-center justify-content-center p-3" do %>
                <i class="fas fa-envelope fa-2x mb-2"></i>
                <span>New Template</span>
              <% end %>
            </div>
            <div class="col-6 mb-3">
              <%= link_to new_campaign_path, class: "btn btn-light btn-block h-100 d-flex flex-column align-items-center justify-content-center p-3" do %>
                <i class="fas fa-paper-plane fa-2x mb-2"></i>
                <span>Send Campaign</span>
              <% end %>
            </div>
            <div class="col-6 mb-3">
              <%= link_to new_social_post_path, class: "btn btn-light btn-block h-100 d-flex flex-column align-items-center justify-content-center p-3" do %>
                <i class="fas fa-share-alt fa-2x mb-2"></i>
                <span>Social Post</span>
              <% end %>
            </div>
          </div>
        </div>
      </div>

      <!-- Upcoming Features -->
      <div class="card">
        <div class="card-header bg-primary text-white">
          <h6 class="m-0 font-weight-bold">Coming Soon</h6>
        </div>
        <div class="card-body">
          <div class="d-flex mb-3">
            <div class="feature-icon bg-light rounded-circle p-3 me-3">
              <i class="fas fa-ad text-primary"></i>
            </div>
            <div>
              <h6 class="font-weight-bold">Digital Ad Campaigns</h6>
              <p class="small mb-0">Create and manage digital ad campaigns across multiple platforms.</p>
            </div>
          </div>
          <div class="d-flex mb-3">
            <div class="feature-icon bg-light rounded-circle p-3 me-3">
              <i class="fas fa-spider text-primary"></i>
            </div>
            <div>
              <h6 class="font-weight-bold">Web Scraper</h6>
              <p class="small mb-0">Find and add new contacts to your lists with our intelligent web scraper.</p>
            </div>
          </div>
          <div class="d-flex">
            <div class="feature-icon bg-light rounded-circle p-3 me-3">
              <i class="fas fa-chart-line text-primary"></i>
            </div>
            <div>
              <h6 class="font-weight-bold">Advanced Analytics</h6>
              <p class="small mb-0">Gain deeper insights into your marketing performance.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .border-left-primary {
    border-left: 4px solid #4e73df !important;
  }
  .border-left-success {
    border-left: 4px solid #1cc88a !important;
  }
  .border-left-info {
    border-left: 4px solid #36b9cc !important;
  }
  .border-left-warning {
    border-left: 4px solid #f6c23e !important;
  }
  .feature-icon {
    width: 50px;
    height: 50px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
</style>
