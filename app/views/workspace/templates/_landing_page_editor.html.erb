<div class="template-workspace landing-page-editor">
  <div class="workspace-header">
    <h4>Edit Landing Page: <%= landing_page.title.presence || "Untitled Page" %></h4>
    <div class="header-actions">
      <button class="btn btn-sm btn-outline-primary" onclick="previewPage()">
        <i class="fas fa-eye"></i> Preview
      </button>
      <button class="btn btn-sm btn-success" onclick="publishPage()">
        <i class="fas fa-rocket"></i> Publish
      </button>
    </div>
  </div>
  
  <div class="workspace-content">
    <div class="editor-layout">
      <!-- Page Settings -->
      <div class="settings-panel">
        <div class="setting-group">
          <label>Page Title</label>
          <input type="text" class="form-control" value="<%= landing_page.title %>" onchange="updatePageTitle(this.value)">
        </div>
        
        <div class="setting-group">
          <label>URL Slug</label>
          <input type="text" class="form-control" value="<%= landing_page.slug %>" onchange="updatePageSlug(this.value)">
        </div>
        
        <div class="setting-group">
          <label>Status</label>
          <select class="form-select" onchange="updatePageStatus(this.value)">
            <option value="draft" <%= 'selected' if landing_page.status == 'draft' %>>Draft</option>
            <option value="published" <%= 'selected' if landing_page.status == 'published' %>>Published</option>
          </select>
        </div>
      </div>
      
      <!-- Content Editor -->
      <div class="content-editor">
        <div class="editor-tabs">
          <button class="tab-btn active" onclick="switchTab('visual')">Visual</button>
          <button class="tab-btn" onclick="switchTab('html')">HTML</button>
        </div>
        
        <div class="editor-content">
          <div id="visual-editor" class="editor-panel active">
            <div class="content-preview" id="content-preview">
              <%= landing_page.html_content.presence || "<p>Start editing your landing page content...</p>" %>
            </div>
            
            <div class="editor-toolbar">
              <button class="toolbar-btn" onclick="askAI('Make this more compelling')">
                <i class="fas fa-magic"></i> Improve Content
              </button>
              <button class="toolbar-btn" onclick="askAI('Add a call-to-action section')">
                <i class="fas fa-bullhorn"></i> Add CTA
              </button>
              <button class="toolbar-btn" onclick="askAI('Change the color scheme')">
                <i class="fas fa-palette"></i> Change Colors
              </button>
            </div>
          </div>
          
          <div id="html-editor" class="editor-panel">
            <textarea class="html-textarea" onchange="updateHTML(this.value)"><%= landing_page.html_content %></textarea>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  let currentPageId = <%= landing_page.id %>;
  
  function switchTab(tab) {
    document.querySelectorAll('.tab-btn').forEach(btn => btn.classList.remove('active'));
    document.querySelectorAll('.editor-panel').forEach(panel => panel.classList.remove('active'));
    
    document.querySelector(`[onclick="switchTab('${tab}')"]`).classList.add('active');
    document.getElementById(`${tab}-editor`).classList.add('active');
  }
  
  function updatePageTitle(title) {
    // Update via AJAX
    fetch(`/landing_pages/${currentPageId}`, {
      method: 'PATCH',
      headers: {
        'Content-Type': 'application/json',
        'X-CSRF-Token': document.querySelector('[name="csrf-token"]').content
      },
      body: JSON.stringify({ landing_page: { title: title } })
    });
  }
  
  function updatePageSlug(slug) {
    // Update via AJAX
    fetch(`/landing_pages/${currentPageId}`, {
      method: 'PATCH',
      headers: {
        'Content-Type': 'application/json',
        'X-CSRF-Token': document.querySelector('[name="csrf-token"]').content
      },
      body: JSON.stringify({ landing_page: { slug: slug } })
    });
  }
  
  function updateHTML(html) {
    // Update preview
    document.getElementById('content-preview').innerHTML = html;
    
    // Update via AJAX
    fetch(`/landing_pages/${currentPageId}`, {
      method: 'PATCH',
      headers: {
        'Content-Type': 'application/json',
        'X-CSRF-Token': document.querySelector('[name="csrf-token"]').content
      },
      body: JSON.stringify({ landing_page: { html_content: html } })
    });
  }
  
  function askAI(request) {
    const workspace = document.querySelector('[data-controller="workspace"]');
    const controller = workspace.stimulus;
    
    if (controller) {
      controller.addMessage(`${request} for this landing page`, "user");
      controller.processMessage(`${request} for landing page ${currentPageId}`);
    }
  }
  
  function previewPage() {
    window.open(`/landing_pages/${currentPageId}/preview`, '_blank');
  }
  
  function publishPage() {
    if (confirm('Are you sure you want to publish this landing page?')) {
      fetch(`/landing_pages/${currentPageId}/publish`, {
        method: 'POST',
        headers: {
          'X-CSRF-Token': document.querySelector('[name="csrf-token"]').content
        }
      }).then(response => {
        if (response.ok) {
          alert('Landing page published successfully!');
        }
      });
    }
  }
</script>

<style>
  .landing-page-editor {
    height: 100%;
    display: flex;
    flex-direction: column;
  }
  
  .editor-layout {
    display: grid;
    grid-template-columns: 250px 1fr;
    gap: 1rem;
    height: 100%;
  }
  
  .settings-panel {
    background: var(--workspace-secondary);
    border: 1px solid var(--workspace-border);
    border-radius: 8px;
    padding: 1rem;
    overflow-y: auto;
  }
  
  .setting-group {
    margin-bottom: 1rem;
  }
  
  .setting-group label {
    display: block;
    margin-bottom: 0.5rem;
    color: var(--workspace-text);
    font-weight: 500;
  }
  
  .content-editor {
    display: flex;
    flex-direction: column;
    background: var(--workspace-secondary);
    border: 1px solid var(--workspace-border);
    border-radius: 8px;
    overflow: hidden;
  }
  
  .editor-tabs {
    display: flex;
    border-bottom: 1px solid var(--workspace-border);
  }
  
  .tab-btn {
    background: none;
    border: none;
    padding: 0.75rem 1rem;
    color: var(--workspace-text-muted);
    cursor: pointer;
    transition: all 0.2s ease;
  }
  
  .tab-btn.active {
    color: var(--workspace-primary);
    background: var(--workspace-bg);
  }
  
  .editor-content {
    flex: 1;
    position: relative;
    overflow: hidden;
  }
  
  .editor-panel {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    display: none;
    flex-direction: column;
  }
  
  .editor-panel.active {
    display: flex;
  }
  
  .content-preview {
    flex: 1;
    padding: 1rem;
    background: white;
    color: #333;
    overflow-y: auto;
  }
  
  .editor-toolbar {
    display: flex;
    gap: 0.5rem;
    padding: 1rem;
    background: var(--workspace-bg);
    border-top: 1px solid var(--workspace-border);
  }
  
  .toolbar-btn {
    background: var(--workspace-primary);
    border: none;
    color: white;
    padding: 0.5rem 1rem;
    border-radius: 6px;
    cursor: pointer;
    font-size: 0.875rem;
    transition: background-color 0.2s ease;
  }
  
  .toolbar-btn:hover {
    background: var(--workspace-primary-hover);
  }
  
  .html-textarea {
    width: 100%;
    height: 100%;
    background: var(--workspace-bg);
    color: var(--workspace-text);
    border: none;
    padding: 1rem;
    font-family: 'Monaco', 'Menlo', 'Courier New', monospace;
    font-size: 0.875rem;
    resize: none;
    outline: none;
  }
</style> 