<div class="template-workspace landing-page-workspace">
  <div class="workspace-header">
    <h4>Landing Page Builder</h4>
    <button class="btn btn-primary btn-sm" onclick="createNewLandingPage()">
      <i class="fas fa-plus"></i> Create New Landing Page
    </button>
  </div>
  
  <div class="workspace-content">
    <% if landing_pages.any? %>
      <div class="template-grid">
        <% landing_pages.each do |page| %>
          <div class="template-card">
            <div class="template-preview">
              <div class="preview-image">
                <i class="fas fa-globe"></i>
              </div>
            </div>
            <div class="template-info">
              <h5><%= page.title.presence || "Untitled Landing Page" %></h5>
              <p class="template-meta">
                <small class="text-muted">
                  Updated <%= time_ago_in_words(page.updated_at) %> ago
                </small>
              </p>
              <div class="template-actions">
                <button class="btn btn-sm btn-outline-primary" onclick="editLandingPage(<%= page.id %>)">
                  <i class="fas fa-edit"></i> Edit
                </button>
                <button class="btn btn-sm btn-outline-success" onclick="previewLandingPage(<%= page.id %>)">
                  <i class="fas fa-eye"></i> Preview
                </button>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="empty-state">
        <div class="empty-icon">
          <i class="fas fa-globe"></i>
        </div>
        <h5>No landing pages yet</h5>
        <p>Create your first landing page to get started with converting visitors into customers.</p>
        <button class="btn btn-primary" onclick="createNewLandingPage()">
          <i class="fas fa-plus"></i> Create Your First Landing Page
        </button>
      </div>
    <% end %>
  </div>
</div>

<script>
  function createNewLandingPage() {
    // Send message to AI to create a new landing page
    const workspace = document.querySelector('[data-controller="workspace"]');
    const controller = workspace.stimulus;
    
    if (controller) {
      controller.addMessage("I'd like to create a new landing page", "user");
      controller.processMessage("Create a new landing page");
    }
  }
  
  function editLandingPage(pageId) {
    // Load specific landing page for editing
    const workspace = document.querySelector('[data-controller="workspace"]');
    const controller = workspace.stimulus;
    
    if (controller) {
      controller.loadTemplate(`landing_page_${pageId}`, `Landing Page ${pageId}`);
    }
  }
  
  function previewLandingPage(pageId) {
    // Open preview in new tab
    window.open(`/landing_pages/${pageId}/preview`, '_blank');
  }
</script>

<style>
  .template-workspace {
    height: 100%;
    display: flex;
    flex-direction: column;
  }
  
  .workspace-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1rem;
    border-bottom: 1px solid var(--workspace-border);
  }
  
  .workspace-header h4 {
    margin: 0;
    color: var(--workspace-text);
  }
  
  .workspace-content {
    flex: 1;
    padding: 1rem;
    overflow-y: auto;
  }
  
  .template-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1rem;
  }
  
  .template-card {
    background: var(--workspace-secondary);
    border: 1px solid var(--workspace-border);
    border-radius: 8px;
    overflow: hidden;
    transition: transform 0.2s ease;
  }
  
  .template-card:hover {
    transform: translateY(-2px);
  }
  
  .template-preview {
    height: 120px;
    background: var(--workspace-bg);
    display: flex;
    align-items: center;
    justify-content: center;
    border-bottom: 1px solid var(--workspace-border);
  }
  
  .preview-image {
    font-size: 2rem;
    color: var(--workspace-text-muted);
  }
  
  .template-info {
    padding: 1rem;
  }
  
  .template-info h5 {
    margin: 0 0 0.5rem 0;
    color: var(--workspace-text);
  }
  
  .template-meta {
    margin-bottom: 1rem;
  }
  
  .template-actions {
    display: flex;
    gap: 0.5rem;
  }
  
  .empty-state {
    text-align: center;
    padding: 3rem 1rem;
    color: var(--workspace-text-muted);
  }
  
  .empty-icon {
    font-size: 3rem;
    margin-bottom: 1rem;
    opacity: 0.5;
  }
  
  .empty-state h5 {
    color: var(--workspace-text);
    margin-bottom: 0.5rem;
  }
</style> 