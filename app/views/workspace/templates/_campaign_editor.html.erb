<div class="template-workspace campaign-editor">
  <div class="workspace-header">
    <h4>Edit Campaign: <%= campaign.name.presence || "Untitled Campaign" %></h4>
    <div class="header-actions">
      <button class="btn btn-sm btn-outline-primary" onclick="testCampaign()">
        <i class="fas fa-flask"></i> Test Send
      </button>
      <% if campaign.status == 'draft' %>
        <button class="btn btn-sm btn-success" onclick="sendCampaign()">
          <i class="fas fa-paper-plane"></i> Send Now
        </button>
      <% end %>
    </div>
  </div>
  
  <div class="workspace-content">
    <div class="editor-layout">
      <!-- Campaign Settings -->
      <div class="settings-panel">
        <div class="setting-group">
          <label>Campaign Name</label>
          <input type="text" class="form-control" value="<%= campaign.name %>" onchange="updateCampaignName(this.value)">
        </div>
        
        <div class="setting-group">
          <label>Subject Line</label>
          <input type="text" class="form-control" value="<%= campaign.subject %>" onchange="updateCampaignSubject(this.value)">
        </div>
        
        <div class="setting-group">
          <label>From Name</label>
          <input type="text" class="form-control" value="<%= campaign.from_name %>" onchange="updateCampaignFromName(this.value)">
        </div>
        
        <div class="setting-group">
          <label>From Email</label>
          <input type="email" class="form-control" value="<%= campaign.from_email %>" onchange="updateCampaignFromEmail(this.value)">
        </div>
        
        <div class="setting-group">
          <label>Recipients</label>
                     <select class="form-select" onchange="updateCampaignGroup(this.value)">
             <option value="">Select Contact Group</option>
             <% if defined?(current_user) && current_user.present? %>
               <% current_user.contact_groups.each do |group| %>
                 <option value="<%= group.id %>" <%= 'selected' if campaign.contact_group_id == group.id %>>
                   <%= group.name %> (<%= group.contacts.count %> contacts)
                 </option>
               <% end %>
             <% end %>
           </select>
        </div>
        
        <div class="setting-group">
          <label>Status</label>
          <div class="status-display">
            <span class="badge badge-<%= campaign.status %>">
              <%= campaign.status.humanize %>
            </span>
          </div>
        </div>
        
        <% if campaign.status != 'draft' %>
          <div class="setting-group">
            <label>Performance</label>
            <div class="performance-stats">
              <div class="stat">
                <strong><%= campaign.sent_count || 0 %></strong>
                <span>Sent</span>
              </div>
              <div class="stat">
                <strong><%= campaign.opened_count || 0 %></strong>
                <span>Opens</span>
              </div>
              <div class="stat">
                <strong><%= campaign.clicked_count || 0 %></strong>
                <span>Clicks</span>
              </div>
            </div>
          </div>
        <% end %>
      </div>
      
      <!-- Email Content Editor -->
      <div class="content-editor">
        <div class="editor-tabs">
          <button class="tab-btn active" onclick="switchTab('visual')">Visual</button>
          <button class="tab-btn" onclick="switchTab('html')">HTML</button>
        </div>
        
        <div class="editor-content">
          <div id="visual-editor" class="editor-panel active">
            <div class="content-preview" id="content-preview">
              <%= campaign.content.presence || "<p>Start creating your email content...</p>" %>
            </div>
            
            <div class="editor-toolbar">
              <button class="toolbar-btn" onclick="askAI('Make this email more engaging')">
                <i class="fas fa-magic"></i> Improve Content
              </button>
              <button class="toolbar-btn" onclick="askAI('Add a compelling call-to-action')">
                <i class="fas fa-bullhorn"></i> Add CTA
              </button>
              <button class="toolbar-btn" onclick="askAI('Make it more personalized')">
                <i class="fas fa-user"></i> Personalize
              </button>
              <button class="toolbar-btn" onclick="askAI('Optimize for mobile')">
                <i class="fas fa-mobile-alt"></i> Mobile
              </button>
            </div>
          </div>
          
          <div id="html-editor" class="editor-panel">
            <textarea class="html-textarea" onchange="updateHTML(this.value)"><%= campaign.content %></textarea>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  let currentCampaignId = <%= campaign.id %>;
  
  function switchTab(tab) {
    document.querySelectorAll('.tab-btn').forEach(btn => btn.classList.remove('active'));
    document.querySelectorAll('.editor-panel').forEach(panel => panel.classList.remove('active'));
    
    document.querySelector(`[onclick="switchTab('${tab}')"]`).classList.add('active');
    document.getElementById(`${tab}-editor`).classList.add('active');
  }
  
  function updateCampaignName(name) {
    updateCampaignField('name', name);
  }
  
  function updateCampaignSubject(subject) {
    updateCampaignField('subject', subject);
  }
  
  function updateCampaignFromName(fromName) {
    updateCampaignField('from_name', fromName);
  }
  
  function updateCampaignFromEmail(fromEmail) {
    updateCampaignField('from_email', fromEmail);
  }
  
  function updateCampaignGroup(groupId) {
    updateCampaignField('contact_group_id', groupId);
  }
  
  function updateCampaignField(field, value) {
    const payload = {};
    payload[field] = value;
    
    fetch(`/campaigns/${currentCampaignId}`, {
      method: 'PATCH',
      headers: {
        'Content-Type': 'application/json',
        'X-CSRF-Token': document.querySelector('[name="csrf-token"]').content
      },
      body: JSON.stringify({ campaign: payload })
    });
  }
  
  function updateHTML(html) {
    // Update preview
    document.getElementById('content-preview').innerHTML = html;
    
    // Update via AJAX
    updateCampaignField('content', html);
  }
  
  function askAI(request) {
    const workspace = document.querySelector('[data-controller="workspace"]');
    const controller = workspace.stimulus;
    
    if (controller) {
      controller.addMessage(`${request} for this campaign`, "user");
      controller.processMessage(`${request} for campaign ${currentCampaignId}`);
    }
  }
  
  function testCampaign() {
    fetch(`/campaigns/${currentCampaignId}/send_test`, {
      method: 'POST',
      headers: {
        'X-CSRF-Token': document.querySelector('[name="csrf-token"]').content
      }
    }).then(response => {
      if (response.ok) {
        alert('Test email sent successfully!');
      }
    });
  }
  
  function sendCampaign() {
    if (confirm('Are you sure you want to send this campaign? This cannot be undone.')) {
      fetch(`/campaigns/${currentCampaignId}/send_now`, {
        method: 'POST',
        headers: {
          'X-CSRF-Token': document.querySelector('[name="csrf-token"]').content
        }
      }).then(response => {
        if (response.ok) {
          alert('Campaign sent successfully!');
          location.reload();
        }
      });
    }
  }
</script>

<style>
  .campaign-editor {
    height: 100%;
    display: flex;
    flex-direction: column;
  }
  
  .editor-layout {
    display: grid;
    grid-template-columns: 280px 1fr;
    gap: 1rem;
    height: 100%;
  }
  
  .settings-panel {
    background: var(--workspace-secondary);
    border: 1px solid var(--workspace-border);
    border-radius: 8px;
    padding: 1rem;
    overflow-y: auto;
  }
  
  .setting-group {
    margin-bottom: 1rem;
  }
  
  .setting-group label {
    display: block;
    margin-bottom: 0.5rem;
    color: var(--workspace-text);
    font-weight: 500;
  }
  
  .status-display {
    display: flex;
    align-items: center;
  }
  
  .badge {
    padding: 0.25rem 0.75rem;
    border-radius: 12px;
    font-size: 0.75rem;
    font-weight: 500;
    text-transform: uppercase;
  }
  
  .badge-draft {
    background: #374151;
    color: white;
  }
  
  .badge-sent {
    background: #10b981;
    color: white;
  }
  
  .badge-scheduled {
    background: #f59e0b;
    color: white;
  }
  
  .performance-stats {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: 0.5rem;
    margin-top: 0.5rem;
  }
  
  .stat {
    text-align: center;
    padding: 0.5rem;
    background: var(--workspace-bg);
    border-radius: 6px;
  }
  
  .stat strong {
    display: block;
    color: var(--workspace-primary);
    font-size: 1.1rem;
  }
  
  .stat span {
    color: var(--workspace-text-muted);
    font-size: 0.8rem;
  }
  
  .content-editor {
    display: flex;
    flex-direction: column;
    background: var(--workspace-secondary);
    border: 1px solid var(--workspace-border);
    border-radius: 8px;
    overflow: hidden;
  }
  
  .editor-tabs {
    display: flex;
    border-bottom: 1px solid var(--workspace-border);
  }
  
  .tab-btn {
    background: none;
    border: none;
    padding: 0.75rem 1rem;
    color: var(--workspace-text-muted);
    cursor: pointer;
    transition: all 0.2s ease;
  }
  
  .tab-btn.active {
    color: var(--workspace-primary);
    background: var(--workspace-bg);
  }
  
  .editor-content {
    flex: 1;
    position: relative;
    overflow: hidden;
  }
  
  .editor-panel {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    display: none;
    flex-direction: column;
  }
  
  .editor-panel.active {
    display: flex;
  }
  
  .content-preview {
    flex: 1;
    padding: 1rem;
    background: white;
    color: #333;
    overflow-y: auto;
  }
  
  .editor-toolbar {
    display: flex;
    gap: 0.5rem;
    padding: 1rem;
    background: var(--workspace-bg);
    border-top: 1px solid var(--workspace-border);
    flex-wrap: wrap;
  }
  
  .toolbar-btn {
    background: var(--workspace-primary);
    border: none;
    color: white;
    padding: 0.5rem 1rem;
    border-radius: 6px;
    cursor: pointer;
    font-size: 0.875rem;
    transition: background-color 0.2s ease;
  }
  
  .toolbar-btn:hover {
    background: var(--workspace-primary-hover);
  }
  
  .html-textarea {
    width: 100%;
    height: 100%;
    background: var(--workspace-bg);
    color: var(--workspace-text);
    border: none;
    padding: 1rem;
    font-family: 'Monaco', 'Menlo', 'Courier New', monospace;
    font-size: 0.875rem;
    resize: none;
    outline: none;
  }
</style> 