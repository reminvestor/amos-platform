<div class="template-workspace campaign-workspace">
  <div class="workspace-header">
    <h4>Email Campaign Builder</h4>
    <button class="btn btn-primary btn-sm" onclick="createNewCampaign()">
      <i class="fas fa-plus"></i> Create New Campaign
    </button>
  </div>
  
  <div class="workspace-content">
    <% if campaigns.any? %>
      <div class="template-grid">
        <% campaigns.each do |campaign| %>
          <div class="template-card">
            <div class="template-preview">
              <div class="preview-image">
                <i class="fas fa-envelope"></i>
              </div>
            </div>
            <div class="template-info">
              <h5><%= campaign.name.presence || "Untitled Campaign" %></h5>
              <p class="template-meta">
                <small class="text-muted">
                  <%= campaign.status.humanize %> •
                  Updated <%= time_ago_in_words(campaign.updated_at) %> ago
                </small>
              </p>
              <div class="campaign-stats">
                <div class="stat-item">
                  <strong><%= campaign.sent_count || 0 %></strong>
                  <span>Sent</span>
                </div>
                <div class="stat-item">
                  <strong><%= campaign.opened_count || 0 %></strong>
                  <span>Opens</span>
                </div>
                <div class="stat-item">
                  <strong><%= campaign.clicked_count || 0 %></strong>
                  <span>Clicks</span>
                </div>
              </div>
              <div class="template-actions">
                <button class="btn btn-sm btn-outline-primary" onclick="editCampaign(<%= campaign.id %>)">
                  <i class="fas fa-edit"></i> Edit
                </button>
                <% if campaign.status == 'draft' %>
                  <button class="btn btn-sm btn-outline-success" onclick="sendCampaign(<%= campaign.id %>)">
                    <i class="fas fa-paper-plane"></i> Send
                  </button>
                <% end %>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="empty-state">
        <div class="empty-icon">
          <i class="fas fa-envelope"></i>
        </div>
        <h5>No campaigns yet</h5>
        <p>Create your first email campaign to start reaching your audience.</p>
        <button class="btn btn-primary" onclick="createNewCampaign()">
          <i class="fas fa-plus"></i> Create Your First Campaign
        </button>
      </div>
    <% end %>
  </div>
</div>

<script>
  function createNewCampaign() {
    // Send message to AI to create a new campaign
    const workspace = document.querySelector('[data-controller="workspace"]');
    const controller = workspace.stimulus;
    
    if (controller) {
      controller.addMessage("I'd like to create a new email campaign", "user");
      controller.processMessage("Create a new email campaign");
    }
  }
  
  function editCampaign(campaignId) {
    // Load specific campaign for editing
    const workspace = document.querySelector('[data-controller="workspace"]');
    const controller = workspace.stimulus;
    
    if (controller) {
      controller.loadTemplate(`campaign_${campaignId}`, `Campaign ${campaignId}`);
    }
  }
  
  function sendCampaign(campaignId) {
    // Send campaign
    if (confirm('Are you sure you want to send this campaign?')) {
      window.location.href = `/campaigns/${campaignId}/send_now`;
    }
  }
</script>

<style>
  .campaign-workspace .template-card {
    background: var(--workspace-secondary);
    border: 1px solid var(--workspace-border);
    border-radius: 8px;
    overflow: hidden;
    transition: transform 0.2s ease;
  }
  
  .campaign-workspace .template-card:hover {
    transform: translateY(-2px);
  }
  
  .campaign-stats {
    display: flex;
    gap: 1rem;
    margin-bottom: 1rem;
    padding: 0.5rem;
    background: var(--workspace-bg);
    border-radius: 6px;
  }
  
  .stat-item {
    text-align: center;
    flex: 1;
  }
  
  .stat-item strong {
    display: block;
    color: var(--workspace-primary);
    font-size: 1.2rem;
  }
  
  .stat-item span {
    color: var(--workspace-text-muted);
    font-size: 0.8rem;
  }
</style> 