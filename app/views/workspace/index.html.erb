<div id="workspace" class="workspace conversation-mode" data-controller="workspace">
  <!-- Collapsed Side Navigation -->
  <nav class="side-nav collapsed" data-workspace-target="sideNav">
    <div class="side-nav-header">
      <div class="brand">
        <i class="fas fa-cube text-primary"></i>
        <span class="brand-text">Crux</span>
      </div>
      <button class="nav-toggle" data-action="click->workspace#toggleSideNav" data-workspace-target="navToggle">
        <i class="fas fa-bars"></i>
      </button>
    </div>
    
    <div class="nav-items">
      <div class="nav-section">
        <div class="nav-item active" data-action="click->workspace#goToConversation">
          <i class="fas fa-home"></i>
          <span class="nav-text">Dashboard</span>
        </div>
        <div class="nav-item" data-template-type="landing_page">
          <i class="fas fa-globe"></i>
          <span class="nav-text">Landing Pages</span>
        </div>
        <div class="nav-item" data-template-type="campaign">
          <i class="fas fa-envelope"></i>
          <span class="nav-text">Campaigns</span>
        </div>
        <div class="nav-item" data-template-type="analytics">
          <i class="fas fa-chart-bar"></i>
          <span class="nav-text">Analytics</span>
        </div>
      </div>
      
      <div class="nav-section">
        <div class="nav-section-title">Templates</div>
        <div id="template-list" data-workspace-target="templateList">
          <!-- Templates will be loaded here -->
        </div>
      </div>
    </div>
    
    <div class="nav-footer">
      <div class="nav-item">
        <i class="fas fa-cog"></i>
        <span class="nav-text">Settings</span>
      </div>
      <div class="nav-item">
        <i class="fas fa-user"></i>
        <span class="nav-text">Profile</span>
      </div>
    </div>
  </nav>

  <!-- Main Content Area -->
  <main class="main-content">
    <!-- Chat Area (Full screen in conversation mode, sidebar in work mode) -->
    <section class="chat-area" data-workspace-target="chatArea">
      <div class="chat-header">
        <div class="chat-title">
          <h2>What can I help you with today?</h2>
          <p class="chat-subtitle">I'm Scout, your AI marketing assistant. I can help with campaigns, landing pages, analytics, and more.</p>
        </div>
      </div>
      
      <div class="chat-messages" data-workspace-target="chatMessages">
        <div class="message ai-message welcome-message">
          <div class="message-avatar">
            <i class="fas fa-robot"></i>
          </div>
          <div class="message-content">
            <p>Hi! I'm Scout, your AI marketing assistant. What would you like to work on today?</p>
            <div class="message-suggestions">
              <button class="suggestion-btn" data-action="click->workspace#sendSuggestion" data-suggestion="Create a landing page for my product">
                Create a landing page
              </button>
              <button class="suggestion-btn" data-action="click->workspace#sendSuggestion" data-suggestion="Show me my email campaigns">
                View campaigns
              </button>
              <button class="suggestion-btn" data-action="click->workspace#sendSuggestion" data-suggestion="Analyze my marketing performance">
                Analytics dashboard
              </button>
            </div>
          </div>
        </div>
      </div>
      
      <div class="chat-input-area">
        <form data-action="submit->workspace#sendMessage" data-workspace-target="chatForm">
          <div class="input-group">
            <input 
              type="text" 
              class="chat-input" 
              placeholder="Type your message..." 
              data-workspace-target="chatInput"
              autocomplete="off"
            >
            <button type="submit" class="send-btn">
              <i class="fas fa-paper-plane"></i>
            </button>
          </div>
        </form>
      </div>
    </section>

    <!-- Resize Handle (only visible in work mode) -->
    <div class="resize-handle" data-workspace-target="resizeHandle" data-action="mousedown->workspace#startResize">
      <div class="resize-line"></div>
    </div>

    <!-- Template View Area (Hidden in conversation mode, visible in work mode) -->
    <section class="template-area" data-workspace-target="templateArea">
      <div class="template-header">
        <div class="template-title">
          <h3 data-workspace-target="templateTitle">Template</h3>
          <div class="layout-controls">
            <div class="layout-presets">
              <button class="preset-btn" data-action="click->workspace#setLayoutPreset" data-width="15" title="Compact Scout">
                <i class="fas fa-compress-alt"></i>
              </button>
              <button class="preset-btn" data-action="click->workspace#setLayoutPreset" data-width="25" title="Balanced">
                <i class="fas fa-columns"></i>
              </button>
              <button class="preset-btn" data-action="click->workspace#setLayoutPreset" data-width="35" title="Wide Scout">
                <i class="fas fa-expand-alt"></i>
              </button>
            </div>
            <button class="close-template" data-action="click->workspace#closeTemplate">
              <i class="fas fa-times"></i>
            </button>
          </div>
        </div>
      </div>
      
      <div class="template-content" data-workspace-target="templateContent">
        <div class="template-placeholder">
          <div class="placeholder-icon">
            <i class="fas fa-cube"></i>
          </div>
          <p>No template loaded</p>
        </div>
      </div>
    </section>
  </main>

  <!-- Loading Overlay -->
  <div class="loading-overlay" data-workspace-target="loadingOverlay">
    <div class="loading-spinner">
      <div class="spinner"></div>
      <p>Scout is thinking...</p>
    </div>
  </div>
</div>

<!-- CSRF Token for AJAX requests -->
<%= csrf_meta_tags %>
