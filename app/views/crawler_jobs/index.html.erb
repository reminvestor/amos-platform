<div class="container mt-4">
  <div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
      <h1 class="card-title h5 mb-0">Web Crawlers</h1>
      <%= link_to new_crawler_job_path, class: "btn btn-primary btn-sm" do %>
        <i data-lucide="plus-circle" class="me-1"></i> Create New Crawler
      <% end %>
    </div>
    <div class="card-body">
      <% if @crawler_jobs.any? %>
        <div class="table-responsive">
          <table class="table table-hover">
            <thead>
              <tr>
                <th>ID</th>
                <th>Description</th>
                <th>Status</th>
                <th>Stage</th>
                <th>Created</th>
                <th>Actions</th>
              </tr>
            </thead>
            <tbody>
              <% @crawler_jobs.each do |job| %>
                <tr>
                  <td><%= job.id %></td>
                  <td>
                    <%= link_to truncate(job.description, length: 60), crawler_job_path(job), class: "text-decoration-none" %>
                  </td>
                  <td>
                    <span class="badge <%= status_badge_class(job.status) %>">
                      <%= job.status&.humanize %>
                    </span>
                  </td>
                  <td>
                    <% if job.conversation_stage.present? %>
                      <% stage_text = case job.conversation_stage
                        when 'analyzing' then 'Discussing requirements'
                        when 'url_finding' then 'Finding target URLs' 
                        when 'ready_for_generation' then 'Ready to generate code'
                        else job.conversation_stage.humanize
                        end %>
                      <span class="badge bg-info text-dark"><%= stage_text %></span>
                    <% elsif job.target_urls.present? %>
                      <span class="badge bg-success">URLs found</span>
                    <% end %>
                  </td>
                  <td><%= time_ago_in_words(job.created_at) %> ago</td>
                  <td>
                    <div class="btn-group btn-group-sm">
                      <%= link_to crawler_job_path(job), class: "btn btn-outline-primary", title: "Continue conversation" do %>
                        <i data-lucide="message-circle"></i>
                      <% end %>
                      <% if job.status == 'ready' %>
                        <%= button_to execute_crawler_job_path(job), method: :post, class: "btn btn-outline-success", title: "Run crawler", form: { class: "d-inline" } do %>
                          <i data-lucide="play"></i>
                        <% end %>
                      <% end %>
                    </div>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% else %>
        <div class="text-center py-5">
          <div class="mb-3">
            <i data-lucide="bug" class="icon-4x text-muted"></i>
          </div>
          <h3 class="h5 mb-3">No crawlers yet</h3>
          <p class="text-muted mb-4">Create your first web crawler to start collecting contact information automatically.</p>
          <%= link_to new_crawler_job_path, class: "btn btn-primary" do %>
            <i data-lucide="plus-circle" class="me-1"></i> Create Your First Crawler
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
  
  <div class="card mt-4">
    <div class="card-header">
      <h5 class="mb-0">How It Works</h5>
    </div>
    <div class="card-body">
      <div class="row">
        <div class="col-md-4 text-center mb-3">
          <div class="mb-2">
            <i data-lucide="message-circle" class="icon-3x text-primary"></i>
          </div>
          <h5>1. Chat with AI</h5>
          <p class="small">Describe what contacts you need and from which websites in a natural conversation.</p>
        </div>
        <div class="col-md-4 text-center mb-3">
          <div class="mb-2">
            <i data-lucide="code" class="icon-3x text-success"></i>
          </div>
          <h5>2. Generate & Test</h5>
          <p class="small">The AI creates a custom crawler and automatically tests it to ensure it works.</p>
        </div>
        <div class="col-md-4 text-center mb-3">
          <div class="mb-2">
            <i data-lucide="database" class="icon-3x text-info"></i>
          </div>
          <h5>3. Collect Contacts</h5>
          <p class="small">Run your crawler to collect contact information directly into your database.</p>
        </div>
      </div>
    </div>
  </div>
</div>
