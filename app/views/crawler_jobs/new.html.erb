<div class="container mt-4">
  <div class="card">
    <div class="card-header">
      <h1 class="card-title h5">Create a New Web Crawler</h1>
    </div>
    <div class="card-body">
      <div class="mb-4">
        <div class="alert alert-info">
          <p><i class="fas fa-info-circle me-2"></i> Our AI assistant will guide you through creating a custom web crawler.</p>
          <p class="mb-0">You'll be able to chat with the AI to describe exactly what websites you want to crawl and what contact information to collect.</p>
        </div>
      </div>
      
      <%= form_with(model: @crawler_job, url: crawler_jobs_path, method: :post, local: true) do |form| %>
        <% if @crawler_job.errors.any? %>
          <div class="alert alert-danger" role="alert">
            <h5 class="alert-heading">
              <%= pluralize(@crawler_job.errors.count, "error") %> prohibited this request from being saved:
            </h5>
            <ul>
              <% @crawler_job.errors.full_messages.each do |message| %>
                <li><%= message %></li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <div class="mb-3">
          <%= form.label :description, "Brief description of what you need:", class: "form-label fw-bold" %>
          <%= form.text_area :description, rows: 3, class: "form-control", 
                           placeholder: "Example: I need to find real estate agents in Austin, TX" %>
          <div class="form-text">
            This is just a short summary. You'll be able to provide more details in the conversation.
          </div>
        </div>

        <div class="d-flex justify-content-between mt-4">
          <%= link_to 'Cancel', crawler_jobs_path, class: "btn btn-outline-secondary" %>
          <%= form.submit "Start Conversation", class: "btn btn-primary" %>
        </div>
      <% end %>
    </div>
  </div>
</div>
