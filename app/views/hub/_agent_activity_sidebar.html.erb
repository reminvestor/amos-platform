<% if presence_summary[:agents][:working].positive? || presence_summary[:active_work].any? %>
  <% presence_summary[:active_work].each do |agent_work| %>
    <div class="agent-activity-item">
      <div class="d-flex align-items-center justify-content-between mb-1">
        <span class="small fw-semibold text-white">🤖 <%= agent_work[:agent_name] %></span>
        <span class="badge bg-success" style="font-size: 0.6rem;">Working</span>
      </div>
      <p class="small text-white-50 mb-1 text-truncate"><%= agent_work[:activity] %></p>
      <% if agent_work[:progress].present? %>
        <div class="progress">
          <div class="progress-bar" style="width: <%= (agent_work[:progress] * 100).round %>%"></div>
        </div>
      <% end %>
    </div>
  <% end %>
<% end %>

<% if presence_summary[:agents][:waiting].positive? %>
  <div class="agent-activity-item border-start border-warning border-3">
    <div class="d-flex align-items-center">
      <span class="text-warning me-2">⏳</span>
      <span class="small text-white"><%= presence_summary[:agents][:waiting] %> agent<%= presence_summary[:agents][:waiting] > 1 ? 's' : '' %> waiting on you</span>
    </div>
  </div>
<% end %>

<% if presence_summary[:agents][:online].positive? && presence_summary[:active_work].empty? %>
  <div class="px-3 py-2">
    <span class="small text-white-50">
      <i class="bi bi-check-circle text-success me-1"></i>
      <%= presence_summary[:agents][:online] %> agent<%= presence_summary[:agents][:online] > 1 ? 's' : '' %> ready
    </span>
  </div>
<% end %>

<% if presence_summary[:agents][:total].zero? %>
  <div class="px-3 py-2">
    <span class="small text-white-50">No agents configured</span>
  </div>
<% end %>
