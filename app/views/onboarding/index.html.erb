<!-- Onboarding Interface - Guided AI Experience -->
<div class="auth-workspace">
  <!-- Left Panel - AI Guidance & Tips -->
  <div class="auth-sidebar">
    <div class="auth-brand">
      <div style="display: flex; flex-direction: column; align-items: center; justify-content: center; margin-bottom: 1rem;">
        <%= image_tag "Primary_logo.png", style: "height: 5.5rem; width: auto; margin-bottom: 0.75rem;", alt: "AMOS" %>
        <h2 style="color: white; margin: 0; font-weight: 700; font-size: 1.25rem;">Getting Started</h2>
      </div>
      <p style="color: #94A3B8; margin: 0; font-size: 0.875rem;">Getting Scout acquainted with your business</p>
    </div>

    <div class="auth-features">
      <div style="margin-bottom: 1.5rem;">
        <h3 style="color: white; font-weight: 600; margin: 0 0 0.5rem 0; display: flex; align-items: center; gap: 0.5rem;">
          <i data-lucide="target" style="width: 1rem; height: 1rem; color: #7C3AED;" aria-hidden="true"></i>
          Meet Scout
        </h3>
        <p style="color: #94A3B8; margin: 0; font-size: 0.875rem;">Your AI Business Automation Assistant</p>
      </div>

      <div class="feature-list">
        <div class="feature-item">
          <div style="width: 32px; height: 32px; border-radius: 0.5rem; background: rgba(34, 197, 245, 0.1); display: flex; align-items: center; justify-content: center; flex-shrink: 0;" aria-hidden="true">
            <i data-lucide="message-circle" style="width: 1.25rem; height: 1.25rem; color: #06B6D4;"></i>
          </div>
          <div>
            <strong style="color: white; display: block; margin-bottom: 0.25rem; font-size: 0.95rem;">Conversational Learning</strong>
            <p style="color: #94A3B8; margin: 0; line-height: 1.4; font-size: 0.8rem;">Scout learns about your business through natural conversation. Just chat!</p>
          </div>
        </div>
        <div class="feature-item">
          <div style="width: 32px; height: 32px; border-radius: 0.5rem; background: rgba(168, 85, 247, 0.1); display: flex; align-items: center; justify-content: center; flex-shrink: 0;" aria-hidden="true">
            <i data-lucide="zap" style="width: 1.25rem; height: 1.25rem; color: #A855F7;"></i>
          </div>
          <div>
            <strong style="color: white; display: block; margin-bottom: 0.25rem; font-size: 0.95rem;">Intelligent Adaptation</strong>
            <p style="color: #94A3B8; margin: 0; line-height: 1.4; font-size: 0.8rem;">The more Scout knows, the better recommendations he can create.</p>
          </div>
        </div>
        <div class="feature-item">
          <div style="width: 32px; height: 32px; border-radius: 0.5rem; background: rgba(34, 197, 94, 0.1); display: flex; align-items: center; justify-content: center; flex-shrink: 0;" aria-hidden="true">
            <i data-lucide="file-text" style="width: 1.25rem; height: 1.25rem; color: #10B981;"></i>
          </div>
          <div>
            <strong style="color: white; display: block; margin-bottom: 0.25rem; font-size: 0.95rem;">Instant Content & Automation</strong>
            <p style="color: #94A3B8; margin: 0; line-height: 1.4; font-size: 0.8rem;">Creates content, automates workflows, and manages integrations.</p>
          </div>
        </div>
        <div class="feature-item">
          <div style="width: 32px; height: 32px; border-radius: 0.5rem; background: rgba(245, 158, 11, 0.1); display: flex; align-items: center; justify-content: center; flex-shrink: 0;" aria-hidden="true">
            <i data-lucide="trending-up" style="width: 1.25rem; height: 1.25rem; color: #F59E0B;"></i>
          </div>
          <div>
            <strong style="color: white; display: block; margin-bottom: 0.25rem; font-size: 0.95rem;">Continuous Optimization</strong>
            <p style="color: #94A3B8; margin: 0; line-height: 1.4; font-size: 0.8rem;">Analyzes performance and suggests improvements.</p>
          </div>
        </div>
      </div>

      <div class="guidance-tips" style="background: #1A1F35; border: 1px solid #1E293B; border-radius: 0.5rem; padding: 1rem; margin-top: 1.5rem;">
        <div style="display: flex; align-items: flex-start; gap: 0.75rem;">
          <div style="width: 32px; height: 32px; border-radius: 0.5rem; background: rgba(59, 130, 246, 0.1); display: flex; align-items: center; justify-content: center; flex-shrink: 0;" aria-hidden="true">
            <i data-lucide="lightbulb" style="width: 1rem; height: 1rem; color: #3B82F6;"></i>
          </div>
          <div>
            <h4 style="color: white; font-weight: 600; margin: 0 0 0.5rem 0; font-size: 0.95rem;">Pro Tips</h4>
            <p style="color: #94A3B8; margin: 0; line-height: 1.5; font-size: 0.8rem;">Share your industry, target audience, and what makes your business unique.</p>
          </div>
        </div>
      </div>
    </div>
  </div>
  
  <!-- Right Panel - Chat Interface -->
  <div class="auth-content">
    <div class="onboarding-chat-container">
      <!-- Header with User Info -->
      <div class="onboarding-header">
        <div class="header-title">
          <h2 style="margin: 0; color: white;">Welcome to AMOS! 🚀</h2>
          <p style="color: #94A3B8; margin-bottom: 0; font-size: 0.875rem;">Let Scout get acquainted with your business</p>
        </div>
        <div class="header-user">
          <div class="dropdown">
            <button class="btn btn-link text-decoration-none dropdown-toggle" type="button" id="userMenuDropdown" data-bs-toggle="dropdown" aria-expanded="false" aria-label="User menu options" style="color: #9ca3af; display: flex; align-items: center; gap: 0.5rem;">
              <i data-lucide="user-circle" style="width: 1.25rem; height: 1.25rem;"></i>
              <%= current_user.full_name %>
            </button>
            <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="userMenuDropdown">
              <li>
                <%= link_to destroy_user_session_path, method: :delete, class: "dropdown-item" do %>
                  <i data-lucide="log-out" style="width: 1rem; height: 1rem; vertical-align: middle; margin-right: 0.5rem;" aria-hidden="true"></i> Sign Out
                <% end %>
              </li>
            </ul>
          </div>
        </div>
      </div>
      
      <!-- Chat Messages -->
      <div class="chat-messages" id="chat-messages" role="log" aria-live="polite" aria-atomic="false">
        <% @conversation_history.each do |message| %>
          <div class="message <%= message[:role] %>-message" data-message-id="<%= message[:id] || "msg-#{Time.current.to_i}" %>">
            <div class="message-avatar">
              <% if message[:role] == 'assistant' %>
                <div class="avatar-circle bg-gradient-primary" aria-hidden="true">
                  <i data-lucide="bot" style="width: 1.25rem; height: 1.25rem; color: white;"></i>
                </div>
              <% else %>
                <div class="avatar-circle bg-secondary" aria-hidden="true">
                  <i data-lucide="user" style="width: 1.25rem; height: 1.25rem; color: white;"></i>
                </div>
              <% end %>
            </div>
            <div class="message-content">
              <div class="message-bubble">
                <% if message[:role] == 'assistant' %>
                  <div class="message-header">
                    <strong class="text-primary">Scout</strong>
                    <small class="text-muted ms-2">
                      <%= Time.parse(message[:timestamp]).strftime("%I:%M %p") rescue Time.current.strftime("%I:%M %p") %>
                    </small>
                  </div>
                <% end %>
                <div class="message-text">
                  <%= simple_format(h(message[:content])) %>
                </div>
                <% if message[:role] == 'user' %>
                  <div class="message-time">
                    <small class="text-muted">
                      <%= Time.parse(message[:timestamp]).strftime("%I:%M %p") rescue Time.current.strftime("%I:%M %p") %>
                    </small>
                  </div>
                <% end %>
              </div>
            </div>
          </div>
        <% end %>
        
        <!-- Typing Indicator -->
        <div id="typing-indicator" class="message assistant-message" style="display: none;">
          <div class="message-avatar">
            <div class="avatar-circle bg-gradient-primary" aria-hidden="true">
              <i data-lucide="bot" style="width: 1.25rem; height: 1.25rem; color: white;"></i>
            </div>
          </div>
          <div class="message-content">
            <div class="message-bubble">
              <div class="message-header">
                <strong class="text-primary">Scout</strong>
              </div>
              <div class="typing-dots">
                <span class="dot"></span>
                <span class="dot"></span>
                <span class="dot"></span>
              </div>
            </div>
          </div>
        </div>
      </div>
      
      <!-- Chat Input -->
      <div class="chat-input-area">
        <form id="message-form" data-turbo="false">
          <div class="input-group">
            <textarea
              class="chat-input"
              id="message-input"
              placeholder="Tell Scout about your business - industry, goals, challenges..."
              rows="1"
              maxlength="1000"
              aria-label="Message input for onboarding chat"></textarea>
            <button type="submit" class="send-btn" id="send-button" aria-label="Send message">
              <i data-lucide="send" style="width: 24px; height: 24px;"></i>
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>

<!-- Completion Modal -->
<div class="modal fade" id="completion-modal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content bg-dark text-white">
      <div class="modal-body p-5 text-center">
        <div class="mb-4">
          <div class="mx-auto mb-3 rounded-circle d-flex align-items-center justify-content-center"
               style="width: 80px; height: 80px; background: linear-gradient(45deg, #28a745, #20c997);">
            <i data-lucide="check" style="width: 2rem; height: 2rem; color: white;"></i>
          </div>
          <h4 class="fw-bold mb-2">🎉 Perfect! You're all set!</h4>
          <p class="text-muted">AMOS now knows about your business and is ready to help you automate workflows, manage integrations, and grow your business.</p>
        </div>
        <button type="button" 
                class="btn btn-primary btn-lg" 
                onclick="completeOnboarding()">
          Let's Get Started
        </button>
      </div>
    </div>
  </div>
</div>

<style>
/* Onboarding-Specific Styles - Using Auth Layout Pattern */
