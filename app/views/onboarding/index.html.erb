<!-- Onboarding Interface - Guided AI Experience -->
<div class="auth-workspace">
  <!-- Left Panel - AI Guidance & Tips -->
  <div class="auth-sidebar">
    <div class="auth-brand">
      <div class="brand-logo">
        <i data-lucide="box" class="text-primary"></i>
        <span class="brand-text">Amos</span>
      </div>
      <p class="brand-tagline">Getting AMOS acquainted with your business</p>
    </div>
    
    <div class="auth-features">
      <h4 class="mb-4">🤖 Meet AMOS, Your AI Business Automation Assistant</h4>
      <div class="feature-list">
        <div class="feature-item">
          <i data-lucide="message-circle" class="text-primary"></i>
          <div>
            <strong>Conversational Learning</strong>
            <p>AMOS learns about your business through natural conversation. Just chat like you would with a colleague!</p>
          </div>
        </div>
        <div class="feature-item">
          <i data-lucide="brain" class="text-success"></i>
          <div>
            <strong>Intelligent Adaptation</strong>
            <p>The more AMOS knows about your business, the better recommendations and content it can create.</p>
          </div>
        </div>
        <div class="feature-item">
          <i data-lucide="sparkles" class="text-warning"></i>
          <div>
            <strong>Instant Marketing Materials</strong>
            <p>Once AMOS understands your business, it can create landing pages, emails, and campaigns in seconds.</p>
          </div>
        </div>
        <div class="feature-item">
          <i data-lucide="trending-up" class="text-info"></i>
          <div>
            <strong>Continuous Optimization</strong>
            <p>AMOS analyzes performance and suggests improvements to help your marketing efforts succeed.</p>
          </div>
        </div>
      </div>
      
      <div class="guidance-tips mt-4 p-3" style="background: rgba(99, 102, 241, 0.1); border-radius: 0.5rem; border-left: 4px solid var(--scout-primary);">
        <h6 class="text-primary mb-2">💡 Pro Tips</h6>
        <ul class="mb-0 small" style="list-style: none; padding: 0; color: var(--scout-text-muted, #9ca3af);">
          <li class="mb-2">• Share your industry, target audience, and what makes your business unique</li>
          <li class="mb-2">• Mention your goals - lead generation, sales, brand awareness, etc.</li>
          <li class="mb-2">• Tell AMOS about your current marketing challenges</li>
          <li>• Don't worry about being perfect - AMOS will ask follow-up questions!</li>
        </ul>
      </div>
    </div>
  </div>
  
  <!-- Right Panel - Chat Interface -->
  <div class="auth-content">
    <div class="onboarding-chat-container">
      <!-- Header with User Info -->
      <div class="onboarding-header">
        <div class="header-title">
          <h2>Welcome to Amos! 🚀</h2>
          <p class="text-muted mb-0">Let's get AMOS acquainted with your business</p>
        </div>
        <div class="header-user">
          <div class="dropdown">
            <button class="btn btn-link text-decoration-none dropdown-toggle" type="button" id="userMenuDropdown" data-bs-toggle="dropdown" aria-expanded="false" style="color: var(--scout-text-muted, #9ca3af);">
              <i data-lucide="user-circle" me-2"></i>
              <%= current_user.full_name %>
            </button>
            <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="userMenuDropdown">
              <li>
                <%= link_to destroy_user_session_path, method: :delete, class: "dropdown-item" do %>
                  <i data-lucide="log-out" me-2"></i> Sign Out
                <% end %>
              </li>
            </ul>
          </div>
        </div>
      </div>
      
      <!-- Chat Messages -->
      <div class="chat-messages" id="chat-messages">
        <% @conversation_history.each do |message| %>
          <div class="message <%= message[:role] %>-message" data-message-id="<%= message[:id] || "msg-#{Time.current.to_i}" %>">
            <div class="message-avatar">
              <% if message[:role] == 'assistant' %>
                <div class="avatar-circle bg-gradient-primary">
                  <i data-lucide="bot" class="text-white"></i>
                </div>
              <% else %>
                <div class="avatar-circle bg-secondary">
                  <i data-lucide="user" text-white"></i>
                </div>
              <% end %>
            </div>
            <div class="message-content">
              <div class="message-bubble">
                <% if message[:role] == 'assistant' %>
                  <div class="message-header">
                    <strong class="text-primary">AMOS</strong>
                    <small class="text-muted ms-2">
                      <%= Time.parse(message[:timestamp]).strftime("%I:%M %p") rescue Time.current.strftime("%I:%M %p") %>
                    </small>
                  </div>
                <% end %>
                <div class="message-text">
                  <%= simple_format(h(message[:content])) %>
                </div>
                <% if message[:role] == 'user' %>
                  <div class="message-time">
                    <small class="text-muted">
                      <%= Time.parse(message[:timestamp]).strftime("%I:%M %p") rescue Time.current.strftime("%I:%M %p") %>
                    </small>
                  </div>
                <% end %>
              </div>
            </div>
          </div>
        <% end %>
        
        <!-- Typing Indicator -->
        <div id="typing-indicator" class="message assistant-message" style="display: none;">
          <div class="message-avatar">
            <div class="avatar-circle bg-gradient-primary">
              <i data-lucide="bot" class="text-white"></i>
            </div>
          </div>
          <div class="message-content">
            <div class="message-bubble">
              <div class="message-header">
                <strong class="text-primary">AMOS</strong>
              </div>
              <div class="typing-dots">
                <span class="dot"></span>
                <span class="dot"></span>
                <span class="dot"></span>
              </div>
            </div>
          </div>
        </div>
      </div>
      
      <!-- Chat Input -->
      <div class="chat-input-area">
        <form id="message-form" data-turbo="false">
          <div class="input-group">
            <textarea 
              class="chat-input" 
              id="message-input"
              placeholder="Tell AMOS about your business - industry, goals, challenges..." 
              rows="1"
              maxlength="1000"></textarea>
            <button type="submit" class="send-btn" id="send-button">
              <i data-lucide="send"></i>
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>

<!-- Completion Modal -->
<div class="modal fade" id="completion-modal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content bg-dark text-white">
      <div class="modal-body p-5 text-center">
        <div class="mb-4">
          <div class="mx-auto mb-3 rounded-circle d-flex align-items-center justify-content-center" 
               style="width: 80px; height: 80px; background: linear-gradient(45deg, #28a745, #20c997);">
            <i data-lucide="check" text-white" style="font-size: 2rem;"></i>
          </div>
          <h4 class="fw-bold mb-2">🎉 Perfect! You're all set!</h4>
          <p class="text-muted">AMOS now knows about your business and is ready to help you succeed with comprehensive marketing strategies.</p>
        </div>
        <button type="button" 
                class="btn btn-primary btn-lg" 
                onclick="completeOnboarding()">
          Let's Get Started
        </button>
      </div>
    </div>
  </div>
</div>

<style>
/* Onboarding-Specific Styles - Using Auth Layout Pattern */
.auth-workspace {
  height: 100vh;
  display: flex;
  background: var(--scout-bg, #1a1d23);
  color: var(--scout-text, #e9ecef);
  overflow: hidden;
}

.auth-sidebar {
  width: 450px;
  background: var(--scout-secondary, #2c3034);
  padding: 3rem 2rem;
  display: flex;
  flex-direction: column;
  justify-content: flex-start;
  border-right: 1px solid var(--scout-border, #404448);
  overflow-y: auto;
}

.auth-brand {
  text-align: center;
  margin-bottom: 3rem;
}

.brand-logo {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 0.75rem;
  font-size: 1.75rem;
  font-weight: 700;
  color: white;
  margin-bottom: 0.5rem;
}

.brand-logo i {
  font-size: 2.5rem;
  color: var(--scout-primary, #6366f1);
}

.brand-tagline {
  color: var(--scout-text-muted, #9ca3af);
  margin: 0;
  font-size: 1rem;
}

.auth-features h4 {
  color: white;
  font-weight: 600;
}

.feature-list {
  display: flex;
  flex-direction: column;
  gap: 2rem;
  margin-bottom: 2rem;
}

.feature-item {
  display: flex;
  align-items: flex-start;
  gap: 1rem;
}

.feature-item i {
  font-size: 1.5rem;
  margin-top: 0.25rem;
}

.feature-item strong {
  color: white;
  display: block;
  margin-bottom: 0.5rem;
  font-size: 1.1rem;
}

.feature-item p {
  color: var(--scout-text-muted, #9ca3af);
  margin: 0;
  line-height: 1.4;
}

.guidance-tips h6 {
  font-weight: 600;
}

.auth-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  background: var(--scout-bg, #1a1d23);
  height: 100vh;
  position: relative;
}

.onboarding-chat-container {
  flex: 1;
  display: flex;
  flex-direction: column;
  height: 100%;
  position: relative;
}

.onboarding-header {
  padding: 1.5rem 2rem;
  border-bottom: 1px solid var(--scout-border, #404448);
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: var(--scout-secondary, #2c3034);
}

.header-title h2 {
  color: white;
  font-weight: 700;
  margin: 0;
  font-size: 1.5rem;
}

.header-user {
  color: var(--scout-text-muted, #9ca3af);
  display: flex;
  align-items: center;
  font-weight: 500;
}

.chat-messages {
  flex: 1;
  overflow-y: auto;
  padding: 2rem;
  padding-bottom: 120px; /* Space for fixed input area */
  background: var(--scout-bg, #1a1d23);
  min-height: 0;
}

.message {
  display: flex;
  margin-bottom: 1.5rem;
  align-items: flex-start;
  gap: 1rem;
}

.user-message {
  flex-direction: row-reverse;
  justify-content: flex-start;
}

.message-avatar {
  flex-shrink: 0;
}

.avatar-circle {
  width: 40px;
  height: 40px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.bg-gradient-primary {
  background: linear-gradient(45deg, var(--scout-primary, #6366f1), #8b5cf6);
}

.message-content {
  max-width: 70%;
}

.message-bubble {
  background: var(--scout-secondary, #2c3034);
  border-radius: 1rem;
  padding: 1rem 1.25rem;
  border: 1px solid var(--scout-border, #404448);
}

.user-message .message-bubble {
  background: var(--scout-primary, #6366f1);
  color: white;
}

.message-header {
  margin-bottom: 0.5rem;
}

.message-text p {
  margin: 0 0 0.5rem 0;
  line-height: 1.5;
}

.message-text p:last-child {
  margin-bottom: 0;
}

.message-time {
  margin-top: 0.5rem;
  text-align: right;
}

.typing-dots {
  display: flex;
  gap: 0.25rem;
  align-items: center;
}

.typing-dots .dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: var(--scout-primary, #6366f1);
  opacity: 0;
  animation: typingDots 1.4s infinite;
}

.typing-dots .dot:nth-child(2) {
  animation-delay: 0.2s;
}

.typing-dots .dot:nth-child(3) {
  animation-delay: 0.4s;
}

@keyframes typingDots {
  0%, 60%, 100% { opacity: 0.3; }
  30% { opacity: 1; }
}

.chat-input-area {
  padding: 1.5rem 2rem;
  border-top: 1px solid var(--scout-border, #404448);
  background: var(--scout-secondary, #2c3034);
  flex-shrink: 0;
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
}

.input-group {
  display: flex;
  gap: 0.5rem;
}

.chat-input {
  flex: 1;
  background: var(--scout-bg, #1a1d23);
  border: 1px solid var(--scout-border, #404448);
  color: var(--scout-text, #e9ecef);
  border-radius: 0.5rem;
  padding: 0.75rem 1rem;
  font-size: 1rem;
  resize: none;
  min-height: 42px;
  max-height: 150px;
  overflow-y: hidden;
  transition: all 0.2s ease;
}

.chat-input:focus {
  outline: none;
  border-color: var(--scout-primary, #6366f1);
  box-shadow: 0 0 0 0.2rem rgba(99, 102, 241, 0.25);
}

.chat-input::placeholder {
  color: var(--scout-text-muted, #9ca3af);
}

.send-btn {
  background: var(--scout-primary, #6366f1);
  border: none;
  color: white;
  border-radius: 0.5rem;
  padding: 0.75rem 1.25rem;
  cursor: pointer;
  transition: all 0.2s ease;
}

.send-btn:hover {
  background: #5855eb;
  transform: translateY(-1px);
  box-shadow: 0 4px 12px rgba(99, 102, 241, 0.3);
}

.send-btn:disabled {
  background: var(--scout-text-muted, #9ca3af);
  cursor: not-allowed;
  transform: none;
  box-shadow: none;
}

/* Responsive Design */
@media (max-width: 768px) {
  .auth-workspace {
    flex-direction: column;
  }
  
  .auth-sidebar {
    width: 100%;
    padding: 1.5rem;
    max-height: 40vh;
  }
  
  .auth-features .feature-list {
    gap: 1rem;
  }
  
  .feature-item {
    gap: 0.75rem;
  }
  
  .guidance-tips {
    display: none;
  }
  
  .onboarding-header {
    padding: 1rem 1.5rem;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.5rem;
  }
  
  .chat-messages {
    padding: 1.5rem;
    max-height: calc(100vh - 300px);
  }
  
  .chat-input-area {
    padding: 1rem 1.5rem;
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
  }
  
  .message-content {
    max-width: 85%;
  }
}
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
  console.log('🚀 Onboarding: DOMContentLoaded event fired');
  
  const messageForm = document.getElementById('message-form');
  const messageInput = document.getElementById('message-input');
  const sendButton = document.getElementById('send-button');
  const chatMessages = document.getElementById('chat-messages');
  const typingIndicator = document.getElementById('typing-indicator');
  
  console.log('📋 Onboarding elements found:', {
    messageForm: !!messageForm,
    messageInput: !!messageInput,
    sendButton: !!sendButton,
    chatMessages: !!chatMessages,
    typingIndicator: !!typingIndicator
  });
  
  // Check if all required elements exist
  if (!messageForm || !messageInput || !sendButton || !chatMessages) {
    console.error('❌ Onboarding: Missing required elements');
    return;
  }
  
  // Auto-focus input
  try {
    messageInput.focus();
  } catch (e) {
    console.warn('⚠️ Could not focus input:', e);
  }
  
  // Scroll to bottom initially
  scrollToBottom();
  
  // Auto-resize textarea (same as main AMOS interface)
  function autoResizeTextarea() {
    try {
      if (!messageInput) return;
      
      messageInput.style.height = 'auto';
      const scrollHeight = messageInput.scrollHeight;
      const newHeight = Math.min(Math.max(scrollHeight, 42), 150);
      messageInput.style.height = newHeight + 'px';
      
      if (scrollHeight > 150) {
        messageInput.style.overflowY = 'auto';
      } else {
        messageInput.style.overflowY = 'hidden';
      }
    } catch (e) {
      console.warn('⚠️ Error in autoResizeTextarea:', e);
    }
  }
  
  // Add auto-resize event listeners
  if (messageInput) {
    messageInput.addEventListener('input', autoResizeTextarea);
    messageInput.addEventListener('paste', () => setTimeout(autoResizeTextarea, 10));
    setTimeout(autoResizeTextarea, 100);
  }
  
  // Handle form submission
  if (messageForm) {
    messageForm.addEventListener('submit', function(e) {
      e.preventDefault();
      sendMessage();
    });
  }
  
  // Handle Enter key (send on Enter, new line on Shift+Enter)
  if (messageInput) {
    messageInput.addEventListener('keydown', function(e) {
      if (e.key === 'Enter' && !e.shiftKey) {
        e.preventDefault();
        sendMessage();
      }
    });
  }
  
  function sendMessage() {
    try {
      const message = messageInput.value.trim();
      if (!message) return;
      
      console.log('🚀 Sending message:', message);
      
      // Add user message to chat
      addMessage(message, 'user');
      
      // Clear input and disable form
      messageInput.value = '';
      messageInput.style.height = '42px';
      setFormState(false);
      
      // Show typing indicator
      showTypingIndicator();
      
      // Send message to server
      const csrfToken = document.querySelector('meta[name="csrf-token"]');
      
      fetch('/onboarding/chat', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'X-CSRF-Token': csrfToken ? csrfToken.content : ''
        },
        body: JSON.stringify({ message: message })
      })
      .then(response => {
        console.log('📡 Response status:', response.status);
        return response.json();
      })
      .then(data => {
        console.log('📊 Response data:', data);
        hideTypingIndicator();
        
        if (data.error) {
          addMessage('Sorry, I had trouble processing that. Could you try again?', 'assistant');
        } else {
          addMessage(data.message, 'assistant');
          
          // Check if onboarding is complete
          if (data.completed) {
            setTimeout(() => {
              showCompletionModal();
            }, 1000);
          }
        }
        
        setFormState(true);
        messageInput.focus();
      })
      .catch(error => {
        console.error('❌ Fetch error:', error);
        hideTypingIndicator();
        addMessage("I'm having trouble connecting. Please try again.", 'assistant');
        setFormState(true);
        messageInput.focus();
      });
    } catch (e) {
      console.error('❌ Error in sendMessage:', e);
      setFormState(true);
    }
  }
  
  // Use the same addMessage function as main AMOS interface
  function addMessage(content, role, timestamp = null) {
    try {
      const messageId = 'msg-' + Date.now() + '-' + Math.random().toString(36).substr(2, 9);
      const time = timestamp ? new Date(timestamp) : new Date();
      const timeString = time.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
      
      const messageElement = document.createElement('div');
      messageElement.className = `message ${role}-message`;
      messageElement.setAttribute('data-message-id', messageId);
      
      const isAssistant = role === 'assistant';
      
      messageElement.innerHTML = `
        <div class="message-avatar">
          <div class="avatar-circle ${isAssistant ? 'bg-gradient-primary' : 'bg-secondary'}">
            <i class="text-white" data-lucide="${isAssistant ? 'bot' : 'user'}"></i>
          </div>
        </div>
        <div class="message-content">
          <div class="message-bubble">
            ${isAssistant ? `
              <div class="message-header">
                <strong class="text-primary">AMOS</strong>
                <small class="text-muted ms-2">${timeString}</small>
              </div>
            ` : ''}
            <div class="message-text">${content.replace(/\n/g, '<br>')}</div>
            ${!isAssistant ? `
              <div class="message-time">
                <small class="text-muted">${timeString}</small>
              </div>
            ` : ''}
          </div>
        </div>
      `;
      
      chatMessages.appendChild(messageElement);
      scrollToBottom();
    } catch (e) {
      console.error('❌ Error adding message:', e);
    }
  }
  
  function showTypingIndicator() {
    try {
      if (typingIndicator) {
        typingIndicator.style.display = 'flex';
        scrollToBottom();
      }
    } catch (e) {
      console.warn('⚠️ Error showing typing indicator:', e);
    }
  }
  
  function hideTypingIndicator() {
    try {
      if (typingIndicator) {
        typingIndicator.style.display = 'none';
      }
    } catch (e) {
      console.warn('⚠️ Error hiding typing indicator:', e);
    }
  }
  
  function setFormState(enabled) {
    try {
      if (messageInput) messageInput.disabled = !enabled;
      if (sendButton) sendButton.disabled = !enabled;
      
      if (sendButton) {
        if (enabled) {
          sendButton.innerHTML = '<i data-lucide="send"></i>';
          sendButton.className = 'send-btn';
        } else {
          sendButton.innerHTML = '<i data-lucide="loader-2" class="icon-spin"></i>';
          sendButton.className = 'send-btn';
        }
      }
    } catch (e) {
      console.warn('⚠️ Error setting form state:', e);
    }
  }
  
  function scrollToBottom() {
    try {
      if (chatMessages) {
        setTimeout(() => {
          chatMessages.scrollTop = chatMessages.scrollHeight;
        }, 100);
      }
    } catch (e) {
      console.warn('⚠️ Error scrolling to bottom:', e);
    }
  }
  
  function showCompletionModal() {
    try {
      const modal = new bootstrap.Modal(document.getElementById('completion-modal'));
      modal.show();
    } catch (e) {
      console.error('❌ Error showing completion modal:', e);
      // Fallback - redirect directly
      completeOnboarding();
    }
  }
  
  // Complete onboarding function
  window.completeOnboarding = function() {
    try {
      const csrfToken = document.querySelector('meta[name="csrf-token"]');
      
      const form = document.createElement('form');
      form.method = 'POST';
      form.action = '/onboarding/complete';
      
      const csrfInput = document.createElement('input');
      csrfInput.type = 'hidden';
      csrfInput.name = 'authenticity_token';
      csrfInput.value = csrfToken ? csrfToken.content : '';
      form.appendChild(csrfInput);
      
      const methodInput = document.createElement('input');
      methodInput.type = 'hidden';
      methodInput.name = '_method';
      methodInput.value = 'PATCH';
      form.appendChild(methodInput);
      
      document.body.appendChild(form);
      form.submit();
    } catch (e) {
      console.error('❌ Error completing onboarding:', e);
      window.location.href = '/scout';
    }
  };
});
</script>