  height: 100vh;
  display: flex;
  background: #0A0E1A;
  color: #e9ecef;
  overflow: hidden;
}

.auth-sidebar {
  width: 380px;
  background: #0F172A;
  padding: 2rem 1.5rem;
  display: flex;
  flex-direction: column;
  justify-content: flex-start;
  border-right: 1px solid #1E293B;
  overflow-y: auto;
}

.auth-brand {
  text-align: center;
  margin-bottom: 3rem;
}

.brand-logo {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 0.75rem;
  font-size: 1.75rem;
  font-weight: 700;
  color: white;
  margin-bottom: 0.5rem;
}

.brand-logo i {
  font-size: 2.5rem;
  color: var(--scout-primary, #6366f1);
}

.brand-tagline {
  color: var(--scout-text-muted, #9ca3af);
  margin: 0;
  font-size: 1rem;
}

.auth-features h4 {
  color: white;
  font-weight: 600;
}

.feature-list {
  display: flex;
  flex-direction: column;
  gap: 2rem;
  margin-bottom: 2rem;
}

.feature-item {
  display: flex;
  align-items: flex-start;
  gap: 1rem;
}

.feature-item i {
  font-size: 1.5rem;
  margin-top: 0.25rem;
}

.feature-item strong {
  color: white;
  display: block;
  margin-bottom: 0.5rem;
  font-size: 1.1rem;
}

.feature-item p {
  color: var(--scout-text-muted, #9ca3af);
  margin: 0;
  line-height: 1.4;
}

.guidance-tips h6 {
  font-weight: 600;
}

.auth-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  background: #0A0E1A;
  height: 100vh;
  position: relative;
}

.onboarding-chat-container {
  flex: 1;
  display: flex;
  flex-direction: column;
  height: 100%;
  position: relative;
}

.onboarding-header {
  padding: 1.5rem 2rem;
  border-bottom: 1px solid #1E293B;
  display: flex;
  justify-content: space-between;
  align-items: center;
