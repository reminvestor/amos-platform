    flex-direction: column;
  }
  
  .auth-sidebar {
    width: 100%;
    padding: 1.5rem;
    max-height: 40vh;
  }
  
  .auth-features .feature-list {
    gap: 1rem;
  }
  
  .feature-item {
    gap: 0.75rem;
  }
  
  .guidance-tips {
