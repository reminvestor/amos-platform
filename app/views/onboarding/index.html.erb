<!-- Onboarding Chat Interface - Consistent with Main App -->
<div class="container-fluid h-100">
  <div class="row h-100">
    <!-- Main Content Area -->
    <div class="col-12">
      <!-- Header with Branding -->
      <div class="d-flex justify-content-between align-items-center py-3 border-bottom bg-light">
        <div class="d-flex align-items-center">
          <h4 class="mb-0 text-primary fw-bold">
            <i class="fas fa-rocket me-2"></i>
            Welcome to Crux Marketing!
          </h4>
          <span class="badge bg-primary ms-2">Onboarding</span>
        </div>
        <div class="text-muted">
          <i class="fas fa-user-circle me-2"></i>
          <%= current_user.full_name %>
        </div>
      </div>
      
      <!-- Welcome Banner -->
      <div class="alert alert-primary border-0 rounded-0 mb-0" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 50%, #8b5cf6 100%);">
        <div class="text-center text-white py-3">
          <h5 class="mb-2">🚀 Let's Get Started!</h5>
          <p class="mb-0">Scout is your AI marketing agent who will learn about your business and help you succeed across all marketing channels. This will only take a few minutes!</p>
        </div>
      </div>
      
      <!-- Chat Interface -->
      <div class="d-flex flex-column" style="height: calc(100vh - 200px);">
        <!-- Messages Area -->
        <div id="onboarding-messages" class="flex-grow-1 overflow-auto p-3" style="background: #f8f9fa;">
          <% @conversation_history.each do |message| %>
            <div class="d-flex mb-3 <%= message[:role] == 'user' ? 'justify-content-end' : 'justify-content-start' %>">
              <div class="d-flex align-items-start gap-2 <%= message[:role] == 'user' ? 'flex-row-reverse' : '' %>" style="max-width: 75%;">
                <!-- Avatar -->
                <div class="rounded-circle d-flex align-items-center justify-content-center text-white" 
                     style="width: 40px; height: 40px; background: <%= message[:role] == 'user' ? '#6c757d' : 'linear-gradient(45deg, #ff6b6b, #ff8e8e)' %>; flex-shrink: 0;">
                  <i class="fas fa-<%= message[:role] == 'user' ? 'user' : 'robot' %>"></i>
                </div>
                
                <!-- Message Bubble -->
                <div class="card border-0 shadow-sm">
                  <div class="card-body p-3" style="background: <%= message[:role] == 'user' ? '#e3f2fd' : 'white' %>;">
                    <% if message[:role] == 'assistant' %>
                      <div class="mb-2">
                        <small class="text-primary fw-bold">
                          <i class="fas fa-robot me-1"></i>Scout
                        </small>
                      </div>
                    <% end %>
                    <div class="message-text">
                      <%= simple_format(h(message[:content])) %>
                    </div>
                    <div class="mt-2">
                      <small class="text-muted">
                        <%= Time.parse(message[:timestamp]).strftime("%I:%M %p") rescue Time.current.strftime("%I:%M %p") %>
                      </small>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          <% end %>
          
          <!-- Typing Indicator -->
          <div id="onboarding-typing" class="d-flex justify-content-start mb-3" style="display: none !important;">
            <div class="d-flex align-items-start gap-2" style="max-width: 75%;">
              <div class="rounded-circle d-flex align-items-center justify-content-center text-white" 
                   style="width: 40px; height: 40px; background: linear-gradient(45deg, #ff6b6b, #ff8e8e); flex-shrink: 0;">
                <i class="fas fa-robot"></i>
              </div>
              <div class="card border-0 shadow-sm">
                <div class="card-body p-3">
                  <div class="mb-2">
                    <small class="text-primary fw-bold">
                      <i class="fas fa-robot me-1"></i>Scout
                    </small>
                  </div>
                  <div class="text-muted">
                    <span>Scout is thinking</span>
                    <span class="typing-dots ms-2">
                      <span class="dot">.</span><span class="dot">.</span><span class="dot">.</span>
                    </span>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
        
        <!-- Input Area -->
        <div class="border-top bg-white p-3">
          <form id="onboarding-form">
            <div class="input-group">
              <textarea 
                id="onboarding-message-input" 
                class="form-control"
                placeholder="Tell Scout about your business..." 
                maxlength="1000"
                rows="1"
                style="resize: none; min-height: 42px; max-height: 150px;"></textarea>
              <button type="submit" 
                      id="onboarding-send-button"
                      class="btn btn-primary">
                <i class="fas fa-paper-plane"></i>
              </button>
            </div>
          </form>
          
          <!-- Security Notice -->
          <div class="text-center mt-2">
            <small class="text-muted">
              <i class="fas fa-shield-alt me-1"></i>
              Your information is secure and will only be used to personalize your experience
            </small>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Completion Modal -->
<div class="modal fade" id="completion-modal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-body p-5 text-center">
        <div class="mb-4">
          <div class="mx-auto mb-3 rounded-circle d-flex align-items-center justify-content-center text-white" 
               style="width: 80px; height: 80px; background: linear-gradient(45deg, #28a745, #20c997);">
            <i class="fas fa-check" style="font-size: 2rem;"></i>
          </div>
          <h4 class="fw-bold mb-2">🎉 Perfect! You're all set!</h4>
          <p class="text-muted">Scout now knows about your business and is ready to help you succeed with comprehensive marketing strategies.</p>
        </div>
        <button type="button" 
                class="btn btn-primary btn-lg" 
                onclick="completeOnboarding()">
          Let's Get Started
        </button>
      </div>
    </div>
  </div>
</div>

<style>
/* Minimal inline styles for typing animation only */
.typing-dots .dot {
  opacity: 0;
  animation: typingDots 1.4s infinite;
}

.typing-dots .dot:nth-child(2) {
  animation-delay: 0.2s;
}

.typing-dots .dot:nth-child(3) {
  animation-delay: 0.4s;
}

@keyframes typingDots {
  0%, 60%, 100% { opacity: 0; }
  30% { opacity: 1; }
}

/* Auto-resize textarea styles */
.onboarding-textarea {
  transition: height 0.1s ease;
}
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
  console.log('🚀 Onboarding: DOMContentLoaded event fired');
  
  const chatForm = document.getElementById('onboarding-form');
  const messageInput = document.getElementById('onboarding-message-input');
  const sendButton = document.getElementById('onboarding-send-button');
  const chatMessages = document.getElementById('onboarding-messages');
  const typingIndicator = document.getElementById('onboarding-typing');
  
  console.log('📋 Onboarding elements found:', {
    chatForm: !!chatForm,
    messageInput: !!messageInput,
    sendButton: !!sendButton,
    chatMessages: !!chatMessages,
    typingIndicator: !!typingIndicator
  });
  
  // Check if all required elements exist
  if (!chatForm || !messageInput || !sendButton || !chatMessages) {
    console.error('❌ Onboarding: Missing required elements');
    return;
  }
  
  // Auto-focus input
  try {
    messageInput.focus();
  } catch (e) {
    console.warn('⚠️ Could not focus input:', e);
  }
  
  // Scroll to bottom initially
  scrollToBottom();
  
  // Auto-resize textarea
  function autoResizeTextarea() {
    try {
      messageInput.style.height = 'auto';
      const scrollHeight = messageInput.scrollHeight;
      const newHeight = Math.min(Math.max(scrollHeight, 42), 150);
      messageInput.style.height = newHeight + 'px';
      
      if (scrollHeight > 150) {
        messageInput.style.overflowY = 'auto';
      } else {
        messageInput.style.overflowY = 'hidden';
      }
    } catch (e) {
      console.warn('⚠️ Error in autoResizeTextarea:', e);
    }
  }
  
  // Add auto-resize event listeners
  messageInput.addEventListener('input', autoResizeTextarea);
  messageInput.addEventListener('paste', () => setTimeout(autoResizeTextarea, 10));
  
  // Handle form submission
  chatForm.addEventListener('submit', function(e) {
    e.preventDefault();
    sendMessage();
  });
  
  // Handle Enter key (send on Enter, new line on Shift+Enter)
  messageInput.addEventListener('keydown', function(e) {
    if (e.key === 'Enter' && !e.shiftKey) {
      e.preventDefault();
      sendMessage();
    }
  });
  
  function sendMessage() {
    try {
      const message = messageInput.value.trim();
      if (!message) return;
      
      console.log('🚀 Sending message:', message);
      
      // Add user message to chat
      addMessageToChat('user', message);
      
      // Clear input and disable form
      messageInput.value = '';
      messageInput.style.height = '42px';
      setFormState(false);
      
      // Show typing indicator
      showTypingIndicator();
      
      // Send message to server
      const csrfToken = document.querySelector('meta[name="csrf-token"]');
      
      fetch('/onboarding/chat', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'X-CSRF-Token': csrfToken ? csrfToken.content : ''
        },
        body: JSON.stringify({ message: message })
      })
      .then(response => {
        console.log('📡 Response status:', response.status);
        return response.json();
      })
      .then(data => {
        console.log('📊 Response data:', data);
        hideTypingIndicator();
        
        if (data.error) {
          addMessageToChat('assistant', 'Sorry, I had trouble processing that. Could you try again?');
        } else {
          addMessageToChat('assistant', data.message);
          
          // Check if onboarding is complete
          if (data.completed) {
            setTimeout(() => {
              showCompletionModal();
            }, 1000);
          }
        }
        
        setFormState(true);
        messageInput.focus();
      })
      .catch(error => {
        console.error('❌ Fetch error:', error);
        hideTypingIndicator();
        addMessageToChat('assistant', "I'm having trouble connecting. Please try again.");
        setFormState(true);
        messageInput.focus();
      });
    } catch (e) {
      console.error('❌ Error in sendMessage:', e);
      setFormState(true);
    }
  }
  
  function addMessageToChat(role, content) {
    try {
      const isUser = role === 'user';
      const now = new Date();
      const timeString = now.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
      
      const messageHTML = `
        <div class="d-flex mb-3 ${isUser ? 'justify-content-end' : 'justify-content-start'}">
          <div class="d-flex align-items-start gap-2 ${isUser ? 'flex-row-reverse' : ''}" style="max-width: 75%;">
            <div class="rounded-circle d-flex align-items-center justify-content-center text-white" 
                 style="width: 40px; height: 40px; background: ${isUser ? '#6c757d' : 'linear-gradient(45deg, #ff6b6b, #ff8e8e)'}; flex-shrink: 0;">
              <i class="fas fa-${isUser ? 'user' : 'robot'}"></i>
            </div>
            <div class="card border-0 shadow-sm">
              <div class="card-body p-3" style="background: ${isUser ? '#e3f2fd' : 'white'};">
                ${!isUser ? '<div class="mb-2"><small class="text-primary fw-bold"><i class="fas fa-robot me-1"></i>Scout</small></div>' : ''}
                <div class="message-text">${content.replace(/\n/g, '<br>')}</div>
                <div class="mt-2">
                  <small class="text-muted">${timeString}</small>
                </div>
              </div>
            </div>
          </div>
        </div>
      `;
      
      chatMessages.insertAdjacentHTML('beforeend', messageHTML);
      scrollToBottom();
    } catch (e) {
      console.error('❌ Error adding message to chat:', e);
    }
  }
  
  function showTypingIndicator() {
    try {
      if (typingIndicator) {
        typingIndicator.style.display = 'flex';
        scrollToBottom();
      }
    } catch (e) {
      console.warn('⚠️ Error showing typing indicator:', e);
    }
  }
  
  function hideTypingIndicator() {
    try {
      if (typingIndicator) {
        typingIndicator.style.display = 'none';
      }
    } catch (e) {
      console.warn('⚠️ Error hiding typing indicator:', e);
    }
  }
  
  function setFormState(enabled) {
    try {
      if (messageInput) messageInput.disabled = !enabled;
      if (sendButton) sendButton.disabled = !enabled;
      
      if (sendButton) {
        if (enabled) {
          sendButton.innerHTML = '<i class="fas fa-paper-plane"></i>';
          sendButton.className = 'btn btn-primary';
        } else {
          sendButton.innerHTML = '<i class="fas fa-spinner fa-spin"></i>';
          sendButton.className = 'btn btn-secondary';
        }
      }
    } catch (e) {
      console.warn('⚠️ Error setting form state:', e);
    }
  }
  
  function scrollToBottom() {
    try {
      if (chatMessages) {
        setTimeout(() => {
          chatMessages.scrollTop = chatMessages.scrollHeight;
        }, 100);
      }
    } catch (e) {
      console.warn('⚠️ Error scrolling to bottom:', e);
    }
  }
  
  function showCompletionModal() {
    try {
      const modal = new bootstrap.Modal(document.getElementById('completion-modal'));
      modal.show();
    } catch (e) {
      console.error('❌ Error showing completion modal:', e);
      // Fallback - redirect directly
      window.location.href = '/onboarding/complete';
    }
  }
  
  // Make completeOnboarding globally available
  window.completeOnboarding = function() {
    try {
      const csrfToken = document.querySelector('meta[name="csrf-token"]');
      
      const form = document.createElement('form');
      form.method = 'POST';
      form.action = '/onboarding/complete';
      
      // Add CSRF token
      const csrfInput = document.createElement('input');
      csrfInput.type = 'hidden';
      csrfInput.name = 'authenticity_token';
      csrfInput.value = csrfToken ? csrfToken.content : '';
      form.appendChild(csrfInput);
      
      // Add _method input for PATCH
      const methodInput = document.createElement('input');
      methodInput.type = 'hidden';
      methodInput.name = '_method';
      methodInput.value = 'PATCH';
      form.appendChild(methodInput);
      
      document.body.appendChild(form);
      form.submit();
    } catch (e) {
      console.error('❌ Error completing onboarding:', e);
      // Fallback
      window.location.href = '/scout';
    }
  };
});
</script>