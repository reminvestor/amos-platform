<div class="container-fluid py-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h1><i class="fas fa-flask me-2"></i>A/B Testing</h1>
    <%= link_to new_ab_test_path, class: "btn btn-primary" do %>
      <i class="fas fa-plus me-2"></i>New A/B Test
    <% end %>
  </div>

  <% if @ab_tests.empty? %>
    <div class="card">
      <div class="card-body text-center py-5">
        <i class="fas fa-flask fa-3x text-muted mb-3"></i>
        <h3>No A/B Tests Yet</h3>
        <p class="text-muted">Create your first A/B test to optimize your campaigns with data-driven decisions.</p>
        <%= link_to new_ab_test_path, class: "btn btn-primary mt-3" do %>
          <i class="fas fa-plus me-2"></i>Create Your First Test
        <% end %>
      </div>
    </div>
  <% else %>
    <!-- Active Tests -->
    <% if @active_tests.any? %>
      <div class="mb-4">
        <h3 class="mb-3"><i class="fas fa-play-circle text-success me-2"></i>Active Tests</h3>
        <div class="row">
          <% @active_tests.each do |test| %>
            <div class="col-md-6 mb-3">
              <%= render partial: 'ab_test_card', locals: { test: test } %>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>

    <!-- All Tests Table -->
    <div class="card">
      <div class="card-header">
        <h5 class="mb-0"><i class="fas fa-list me-2"></i>All Tests</h5>
      </div>
      <div class="card-body p-0">
        <div class="table-responsive">
          <table class="table table-hover mb-0">
            <thead>
              <tr>
                <th>Name</th>
                <th>Type</th>
                <th>Status</th>
                <th>Variants</th>
                <th>Impressions</th>
                <th>Conversion Rate</th>
                <th>Confidence</th>
                <th>Created</th>
                <th>Actions</th>
              </tr>
            </thead>
            <tbody>
              <% @ab_tests.each do |test| %>
                <tr>
                  <td>
                    <%= link_to test.name, ab_test_path(test) %>
                  </td>
                  <td>
                    <span class="badge bg-secondary"><%= test.testable_type %></span>
                  </td>
                  <td>
                    <%= render partial: 'status_badge', locals: { status: test.status } %>
                  </td>
                  <td><%= test.variants.count %></td>
                  <td><%= number_with_delimiter(test.variants.sum(:impressions)) %></td>
                  <td>
                    <% total_conv = test.variants.sum(:conversions) %>
                    <% total_imp = test.variants.sum(:impressions) %>
                    <%= total_imp > 0 ? number_to_percentage((total_conv.to_f / total_imp * 100), precision: 2) : 'N/A' %>
                  </td>
                  <td>
                    <% if test.winner %>
                      <span class="badge bg-success"><i class="fas fa-trophy"></i> Winner Found</span>
                    <% elsif test.status == 'running' %>
                      <%= number_to_percentage(test.confidence_level * 100, precision: 0) %> required
                    <% else %>
                      <span class="text-muted">-</span>
                    <% end %>
                  </td>
                  <td><%= time_ago_in_words(test.created_at) %> ago</td>
                  <td>
                    <%= link_to ab_test_path(test), class: "btn btn-sm btn-outline-primary" do %>
                      <i class="fas fa-eye"></i>
                    <% end %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  <% end %>
</div>
