<% case status %>
<% when 'draft' %>
  <span class="badge bg-secondary"><i class="fas fa-pencil-alt"></i> Draft</span>
<% when 'running' %>
  <span class="badge bg-success"><i class="fas fa-play"></i> Running</span>
<% when 'paused' %>
  <span class="badge bg-warning"><i class="fas fa-pause"></i> Paused</span>
<% when 'stopped' %>
  <span class="badge bg-danger"><i class="fas fa-stop"></i> Stopped</span>
<% when 'completed' %>
  <span class="badge bg-info"><i class="fas fa-check"></i> Completed</span>
<% else %>
  <span class="badge bg-secondary"><%= status %></span>
<% end %>
