<% case status %>
<% when 'draft' %>
  <span class="badge bg-secondary"><i data-lucide="pencil"></i> Draft</span>
<% when 'running' %>
  <span class="badge bg-success"><i data-lucide="play"></i> Running</span>
<% when 'paused' %>
  <span class="badge bg-warning"><i data-lucide="pause"></i> Paused</span>
<% when 'stopped' %>
  <span class="badge bg-danger"><i data-lucide="square"></i> Stopped</span>
<% when 'completed' %>
  <span class="badge bg-info"><i data-lucide="check"></i> Completed</span>
<% else %>
  <span class="badge bg-secondary"><%= status %></span>
<% end %>
