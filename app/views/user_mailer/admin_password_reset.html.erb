<!DOCTYPE html>
<html>
  <head>
    <meta content='text/html; charset=UTF-8' http-equiv='Content-Type' />
  </head>
  <body style="font-family: Arial, sans-serif; line-height: 1.6; color: #333; max-width: 600px; margin: 0 auto; padding: 20px;">
    <div style="background-color: #f4f4f4; padding: 20px; border-radius: 8px;">
      <h1 style="color: #7C3AED; margin-top: 0;">Password Reset</h1>
      
      <p>Hello <%= @user.full_name %>,</p>
      
      <p>An administrator has reset your password. Your account details are:</p>
      
      <div style="background-color: white; padding: 15px; border-radius: 5px; margin: 20px 0;">
        <p style="margin: 5px 0;"><strong>Email:</strong> <%= @user.email %></p>
        <p style="margin: 5px 0;"><strong>Temporary Password:</strong> <code style="background-color: #f0f0f0; padding: 3px 8px; border-radius: 3px; font-size: 14px;"><%= @temporary_password %></code></p>
      </div>
      
      <p><strong>Important:</strong> This is a temporary password. Please log in and change it to something secure as soon as possible.</p>
      
      <p style="margin: 25px 0;">
        <%= link_to "Log In Now", @login_url, style: "display: inline-block; background-color: #7C3AED; color: white; padding: 12px 30px; text-decoration: none; border-radius: 5px; font-weight: bold;" %>
      </p>
      
      <p style="color: #666; font-size: 14px;">
        If you did not request this password reset, please contact your administrator immediately.
      </p>
      
      <hr style="border: none; border-top: 1px solid #ddd; margin: 30px 0;">
      
      <p style="color: #999; font-size: 12px;">
        This email was sent from Agent Marketing. Please do not reply to this email.
      </p>
    </div>
  </body>
</html>
