<div class="container-fluid py-4">
  <div class="admin-page-header">
    <div class="header-left">
      <div class="header-icon">
        <i data-lucide="brain"></i>
      </div>
      <div class="header-text">
        <h1>Agent Loadouts</h1>
        <p>Configure AMOS's capabilities with loadouts and skills</p>
      </div>
    </div>
    <div class="header-actions d-flex gap-2">
      <%= link_to import_agent_plugins_path, class: "admin-btn admin-btn-outline" do %>
        <i data-lucide="file-code" aria-hidden="true"></i>
        <span>Import Skill</span>
      <% end %>
      <%= link_to new_agent_plugin_path, class: "admin-btn admin-btn-primary" do %>
        <i data-lucide="plus" aria-hidden="true"></i>
        <span>Create Loadout</span>
      <% end %>
    </div>
  </div>

  <!-- Explanation Card -->
  <div class="admin-card mb-4">
    <div class="admin-card-body">
      <div class="row align-items-center">
        <div class="col-md-8">
          <h5 class="mb-2" style="color: var(--text-primary);">
            <i data-lucide="info" class="me-2" style="width: 18px; height: 18px;"></i>
            How Loadouts & Skills Work
          </h5>
          <p class="text-muted small mb-0">
            <strong>Loadouts</strong> define specialized capabilities and tool permissions for AMOS. 
            <strong>Skills</strong> provide expertise and best practices that get injected into AMOS's context when relevant.
            Together, they help AMOS handle specialized tasks correctly without needing separate agents.
          </p>
        </div>
        <div class="col-md-4 text-end">
          <div class="d-flex gap-3 justify-content-end">
            <div class="text-center">
              <div class="h4 mb-0" style="color: var(--primary);"><%= @my_agents.count %></div>
              <small class="text-muted">Loadouts</small>
            </div>
            <div class="text-center">
              <div class="h4 mb-0" style="color: var(--success);"><%= @skills_count || 0 %></div>
              <small class="text-muted">Custom Skills</small>
            </div>
            <div class="text-center">
              <div class="h4 mb-0" style="color: var(--info);"><%= @builtin_skills_count || 0 %></div>
              <small class="text-muted">Built-in Skills</small>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Tabs -->
  <ul class="nav nav-tabs mb-4" id="loadoutTabs" role="tablist">
    <li class="nav-item" role="presentation">
      <button class="nav-link active" id="loadouts-tab" data-bs-toggle="tab" data-bs-target="#loadouts-panel" type="button" role="tab">
        <i data-lucide="layers" class="me-2" style="width: 16px; height: 16px;"></i>
        Loadouts
        <span class="badge bg-secondary ms-2"><%= @my_agents.count %></span>
      </button>
    </li>
    <li class="nav-item" role="presentation">
      <button class="nav-link" id="skills-tab" data-bs-toggle="tab" data-bs-target="#skills-panel" type="button" role="tab">
        <i data-lucide="book-open" class="me-2" style="width: 16px; height: 16px;"></i>
        Skills
        <span class="badge bg-secondary ms-2"><%= (@skills_count || 0) + (@builtin_skills_count || 0) %></span>
      </button>
    </li>
  </ul>

  <div class="tab-content">
    <!-- Loadouts Tab -->
    <div class="tab-pane fade show active" id="loadouts-panel" role="tabpanel">
      <div class="row">
        <% @my_agents.each do |agent| %>
          <% is_skill = agent.configuration&.dig('skill_format') == 'claude_skill_md' %>
          <div class="col-md-4 mb-4">
            <div class="admin-card h-100 <%= 'skill-card' if is_skill %>">
              <div class="admin-card-body">
                <div class="d-flex justify-content-between align-items-start mb-2">
                  <h5 class="agent-title">
                    <% if is_skill %>
                      <i data-lucide="book-open" class="me-1" style="width: 16px; height: 16px; color: var(--success);"></i>
                    <% else %>
                      <i data-lucide="layers" class="me-1" style="width: 16px; height: 16px; color: var(--primary);"></i>
                    <% end %>
                    <%= agent.name %>
                  </h5>
                  <span class="admin-badge <%= agent.status == 'active' ? 'admin-badge-success' : 'admin-badge-default' %>"><%= agent.status %></span>
                </div>
                <p class="agent-desc small"><%= truncate(agent.description, length: 100) %></p>
                <% if is_skill %>
                  <div class="mb-2">
                    <span class="badge bg-success bg-opacity-10 text-success">
                      <i data-lucide="file-code" style="width: 12px; height: 12px;"></i>
                      Imported Skill
                    </span>
                  </div>
                <% end %>
                <div class="mt-3 d-flex gap-2">
                  <%= link_to "View", agent_plugin_path(agent), class: "admin-btn admin-btn-sm admin-btn-outline" %>
                  <%= link_to "Edit", edit_agent_plugin_path(agent), class: "admin-btn admin-btn-sm admin-btn-outline" %>
                </div>
              </div>
            </div>
          </div>
        <% end %>
        <% if @my_agents.empty? %>
          <div class="col-12">
            <div class="admin-card">
              <div class="admin-empty-state">
                <div class="empty-icon">
                  <i data-lucide="layers"></i>
                </div>
                <h3>No Custom Loadouts Yet</h3>
                <p>Create a loadout to give AMOS specialized capabilities for specific tasks</p>
                <div class="d-flex gap-2 justify-content-center mt-3">
                  <%= link_to new_agent_plugin_path, class: "admin-btn admin-btn-primary" do %>
                    <i data-lucide="plus" aria-hidden="true"></i>
                    <span>Create Loadout</span>
                  <% end %>
                  <%= link_to import_agent_plugins_path, class: "admin-btn admin-btn-outline" do %>
                    <i data-lucide="file-code" aria-hidden="true"></i>
                    <span>Import Skill</span>
                  <% end %>
                </div>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    </div>

    <!-- Skills Tab -->
    <div class="tab-pane fade" id="skills-panel" role="tabpanel">
      <!-- Built-in Skills -->
      <h5 class="mb-3" style="color: var(--text-primary);">
        <i data-lucide="sparkles" class="me-2" style="width: 18px; height: 18px; color: var(--info);"></i>
        Built-in Integration Skills
      </h5>
      <p class="text-muted small mb-3">These skills are automatically injected when AMOS detects relevant integrations in your request.</p>
      
      <div class="row mb-4">
        <% @builtin_skills.each do |slug, skill| %>
          <div class="col-md-4 mb-3">
            <div class="admin-card h-100">
              <div class="admin-card-body">
                <div class="d-flex align-items-center mb-2">
                  <div class="skill-icon me-2" style="width: 32px; height: 32px; background: linear-gradient(135deg, rgba(59, 130, 246, 0.1), rgba(139, 92, 246, 0.1)); border-radius: 8px; display: flex; align-items: center; justify-content: center;">
                    <i data-lucide="zap" style="width: 16px; height: 16px; color: var(--info);"></i>
                  </div>
                  <div>
                    <h6 class="mb-0" style="color: var(--text-primary);"><%= skill[:name] %></h6>
                    <small class="text-muted"><%= slug.to_s.capitalize %></small>
                  </div>
                </div>
                <p class="small text-muted mb-0" style="font-size: 0.8rem;">
                  <%= skill[:content].to_s.lines.first(2).join.truncate(120) %>
                </p>
              </div>
            </div>
          </div>
        <% end %>
        <% if @builtin_skills.empty? %>
          <div class="col-12">
            <div class="alert alert-info small">
              <i data-lucide="info" class="me-2" style="width: 14px; height: 14px;"></i>
              Built-in skills will load after server restart.
            </div>
          </div>
        <% end %>
      </div>

      <!-- Custom Skills -->
      <h5 class="mb-3" style="color: var(--text-primary);">
        <i data-lucide="upload" class="me-2" style="width: 18px; height: 18px; color: var(--success);"></i>
        Custom Imported Skills
      </h5>
      <p class="text-muted small mb-3">Skills you've imported from Claude SKILL.md files.</p>
      
      <% custom_skills = @my_agents.select { |a| a.configuration&.dig('skill_format') == 'claude_skill_md' } %>
      <% if custom_skills.any? %>
        <div class="row">
          <% custom_skills.each do |skill| %>
            <div class="col-md-4 mb-3">
              <div class="admin-card h-100">
                <div class="admin-card-body">
                  <div class="d-flex justify-content-between align-items-start mb-2">
                    <h6 class="mb-0" style="color: var(--text-primary);"><%= skill.name %></h6>
                    <span class="admin-badge <%= skill.status == 'active' ? 'admin-badge-success' : 'admin-badge-default' %>"><%= skill.status %></span>
                  </div>
                  <p class="small text-muted mb-2"><%= truncate(skill.description, length: 80) %></p>
                  <% if skill.configuration&.dig('use_when').present? %>
                    <div class="small">
                      <strong class="text-muted">Use when:</strong>
                      <ul class="mb-0 ps-3" style="font-size: 0.75rem;">
                        <% skill.configuration['use_when'].first(2).each do |use_case| %>
                          <li class="text-muted"><%= use_case %></li>
                        <% end %>
                      </ul>
                    </div>
                  <% end %>
                  <div class="mt-2">
                    <%= link_to "Edit", edit_agent_plugin_path(skill), class: "admin-btn admin-btn-sm admin-btn-outline" %>
                  </div>
                </div>
              </div>
            </div>
          <% end %>
        </div>
      <% else %>
        <div class="admin-card">
          <div class="admin-empty-state py-4">
            <div class="empty-icon">
              <i data-lucide="file-code"></i>
            </div>
            <h5>No Custom Skills Yet</h5>
            <p class="text-muted small">Import Claude SKILL.md files to add custom expertise for AMOS</p>
            <%= link_to import_agent_plugins_path, class: "admin-btn admin-btn-outline mt-2" do %>
              <i data-lucide="upload" aria-hidden="true"></i>
              <span>Import Skill</span>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>

<style>
  .agent-title {
    color: var(--text-primary);
    font-weight: 600;
    margin: 0;
    font-size: 0.95rem;
  }
  
  .agent-desc {
    color: var(--text-secondary);
  }
  
  .skill-card {
    border-left: 3px solid var(--success);
  }
  
  .nav-tabs .nav-link {
    color: var(--text-secondary);
    border: none;
    border-bottom: 2px solid transparent;
    padding: 0.75rem 1rem;
  }
  
  .nav-tabs .nav-link:hover {
    border-color: transparent;
    color: var(--text-primary);
  }
  
  .nav-tabs .nav-link.active {
    color: var(--primary);
    border-color: transparent;
    border-bottom-color: var(--primary);
    background: transparent;
  }
  
  .admin-empty-state .empty-icon {
    width: 64px;
    height: 64px;
    margin: 0 auto 1rem;
    background: var(--bg-tertiary);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  
  .admin-empty-state .empty-icon i {
    width: 32px;
    height: 32px;
    color: var(--text-muted);
  }
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
  if (typeof lucide !== 'undefined') {
    lucide.createIcons();
  }
  
  // Refresh icons when tabs are shown
  document.querySelectorAll('[data-bs-toggle="tab"]').forEach(function(tab) {
    tab.addEventListener('shown.bs.tab', function() {
      if (typeof lucide !== 'undefined') {
        lucide.createIcons();
      }
    });
  });
});
</script>

