<div class="container-fluid py-4">
  <div class="admin-page-header">
    <div class="header-left">
      <div class="header-icon">
        <i data-lucide="bot"></i>
      </div>
      <div class="header-text">
        <h1>Agents</h1>
        <p>Manage your AI agents</p>
      </div>
    </div>
    <div class="header-actions">
      <%= link_to new_agent_plugin_path, class: "admin-btn admin-btn-primary" do %>
        <i data-lucide="plus" aria-hidden="true"></i>
        <span>Create Agent</span>
      <% end %>
    </div>
  </div>

  <div class="row">
    <% @my_agents.each do |agent| %>
      <div class="col-md-4 mb-4">
        <div class="admin-card h-100">
          <div class="admin-card-body">
            <div class="d-flex justify-content-between align-items-start mb-2">
              <h5 class="agent-title"><%= agent.name %></h5>
              <span class="admin-badge admin-badge-default"><%= agent.status %></span>
            </div>
            <p class="agent-desc small"><%= agent.description %></p>
            <div class="mt-3 d-flex gap-2">
              <%= link_to "View", agent_plugin_path(agent), class: "admin-btn admin-btn-sm admin-btn-outline" %>
              <%= link_to "Edit", edit_agent_plugin_path(agent), class: "admin-btn admin-btn-sm admin-btn-outline" %>
            </div>
          </div>
        </div>
      </div>
    <% end %>
    <% if @my_agents.empty? %>
      <div class="col-12">
        <div class="admin-card">
          <div class="admin-empty-state">
            <div class="empty-icon">
              <i data-lucide="bot"></i>
            </div>
            <h3>No Custom Agents Yet</h3>
            <p>Create your first AI agent to extend Amos's capabilities</p>
            <%= link_to new_agent_plugin_path, class: "admin-btn admin-btn-primary mt-3" do %>
              <i data-lucide="plus" aria-hidden="true"></i>
              <span>Create Agent</span>
            <% end %>
          </div>
        </div>
      </div>
    <% end %>
  </div>
</div>

<style>
  .agent-title {
    color: var(--text-primary);
    font-weight: 600;
    margin: 0;
  }
  
  .agent-desc {
    color: var(--text-secondary);
  }
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
  if (typeof lucide !== 'undefined') {
    lucide.createIcons();
  }
});
</script>

