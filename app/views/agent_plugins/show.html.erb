<div class="container-fluid">
  <div class="d-flex justify-content-between align-items-start mb-4">
    <div>
      <div class="d-flex align-items-center gap-2 mb-1">
        <%= link_to agent_plugins_path, class: "text-muted" do %>
          <i data-lucide="arrow-left" class="icon-sm"></i>
        <% end %>
        <h1 class="h3 mb-0 text-white"><%= @agent.name %></h1>
        <span class="badge bg-secondary"><%= @agent.status %></span>
      </div>
      <p class="text-muted mb-0"><%= @agent.role %></p>
    </div>
    <%= link_to edit_agent_plugin_path(@agent), class: "btn btn-outline-secondary" do %>
      <i data-lucide="edit-2"></i> Edit Agent
    <% end %>
  </div>

  <div class="row">
    <div class="col-md-8">
      <div class="card bg-dark border-secondary mb-4">
        <div class="card-header border-secondary">
          <h5 class="mb-0 text-white">Description</h5>
        </div>
        <div class="card-body">
          <p><%= @agent.description %></p>
        </div>
      </div>

      <div class="card bg-dark border-secondary mb-4">
        <div class="card-header border-secondary">
          <h5 class="mb-0 text-white">System Prompt</h5>
        </div>
        <div class="card-body">
          <pre class="bg-black p-3 rounded text-light mb-0" style="white-space: pre-wrap; font-size: 0.85rem;"><%= @agent.system_prompt['prompt'] rescue '' %></pre>
        </div>
      </div>
    </div>
    
    <div class="col-md-4">
      <div class="card bg-dark border-secondary mb-4">
        <div class="card-header border-secondary">
          <h5 class="mb-0 text-white">Details</h5>
        </div>
        <div class="card-body">
          <dl class="mb-0">
            <dt class="text-muted small">Created</dt>
            <dd><%= time_ago_in_words(@agent.created_at) %> ago</dd>
            
            <dt class="text-muted small mt-3">Version</dt>
            <dd><%= @agent.version %></dd>
            
            <dt class="text-muted small mt-3">Entity</dt>
            <dd><%= @agent.entity&.name || 'System' %></dd>
          </dl>
        </div>
      </div>
    </div>
  </div>
</div>

