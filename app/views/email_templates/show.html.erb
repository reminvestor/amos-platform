<div class="container mt-4">
  <div class="row">
    <div class="col-md-12">
      <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center">
          <h2><%= @email_template.name %></h2>
          <div>
            <%= link_to "Back", email_templates_path, class: "btn btn-outline-secondary me-2" %>
            <%= link_to "Edit", edit_email_template_path(@email_template), class: "btn btn-outline-primary me-2" %>
            <div class="dropdown d-inline-block">
              <button class="btn btn-primary dropdown-toggle" type="button" id="templateActions" data-bs-toggle="dropdown" aria-expanded="false">
                Actions
              </button>
              <ul class="dropdown-menu" aria-labelledby="templateActions">
                <li>
                  <a href="#" class="dropdown-item" data-bs-toggle="modal" data-bs-target="#testEmailModal">Send Test Email</a>
                </li>
                <li>
                  <%= link_to "Improve with AI", improve_ai_content_path(@email_template), class: "dropdown-item" %>
                </li>
              </ul>
            </div>
          </div>
        </div>
        <div class="card-body">
          <div class="row mb-4">
            <div class="col-md-3">
              <p><strong>Subject:</strong></p>
            </div>
            <div class="col-md-9">
              <p><%= @email_template.subject %></p>
            </div>
          </div>
          
          <div class="row mb-4">
            <div class="col-md-12">
              <h4 class="d-flex justify-content-between align-items-center">
                <span>Preview</span>
                <%= link_to improve_ai_content_path(@email_template), class: "btn btn-sm btn-info" do %>
                  <i data-lucide="bot" class="me-1"></i> Improve with AI
                <% end %>
              </h4>
              <div class="card">
                <div class="card-body">
                  <%= raw @email_template.body %>
                </div>
              </div>
            </div>
          </div>
          
          <div class="row">
            <div class="col-md-12">
              <h4>Test Email</h4>
              <div class="card">
                <div class="card-body">
                  <%= form_tag test_email_email_template_path(@email_template), method: :post, class: "row g-3" do %>
                    <div class="col-md-6">
                      <label for="test_email" class="form-label">Email address</label>
                      <input type="email" class="form-control" id="test_email" name="email" placeholder="recipient@example.com" required>
                    </div>
                    <div class="col-md-6 d-flex align-items-end">
                      <button type="submit" class="btn btn-primary">Send Test Email</button>
                    </div>
                  <% end %>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Test Email Modal -->
<div class="modal fade" id="testEmailModal" tabindex="-1" aria-labelledby="testEmailModalLabel" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="testEmailModalLabel">Send Test Email</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <%= form_tag test_email_email_template_path(@email_template), method: :post do %>
        <div class="modal-body">
          <div class="mb-3">
            <label for="test_email" class="form-label">Email address</label>
            <input type="email" class="form-control" id="test_email" name="email" placeholder="recipient@example.com" required>
          </div>
          <div class="form-text mb-3">
            This will send a test email using this template to the specified address.
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-primary">Send Test Email</button>
        </div>
      <% end %>
    </div>
  </div>
</div>
