<div class="admin-content" style="padding: 2rem;">
  <div class="container-fluid">
    <%# Page Header %>
    <div class="admin-page-header" style="margin-bottom: 2rem;">
      <div class="header-left">
        <div class="header-icon" style="background: linear-gradient(135deg, #22D3EE 0%, #06B6D4 100%);">
          <i data-lucide="mail"></i>
        </div>
        <div class="header-text">
          <h1>New Email Template</h1>
          <p>Create a reusable email template for your campaigns</p>
        </div>
      </div>
      <div class="header-actions">
        <%= link_to email_templates_path, class: "admin-btn admin-btn-outline" do %>
          <i data-lucide="arrow-left"></i>
          <span>Back</span>
        <% end %>
      </div>
    </div>

    <div class="row">
      <%# Main Form Column %>
      <div class="col-lg-8 col-xl-9">
        <div class="admin-card">
          <%= render "form", email_template: @email_template %>
        </div>
      </div>

      <%# Tips Sidebar %>
      <div class="col-lg-4 col-xl-3">
        <div class="admin-card">
          <h5 style="color: white; font-weight: 600; margin-bottom: 1.5rem; display: flex; align-items: center; gap: 0.5rem;">
            <i data-lucide="lightbulb" style="width: 1.25rem; height: 1.25rem; color: #FACC15;"></i>
            <span>Tips</span>
          </h5>

          <div style="margin-bottom: 1.5rem;">
            <p style="color: white; font-weight: 600; margin-bottom: 0.5rem;">Available Variables:</p>
            <ul style="color: #94A3B8; font-size: 0.875rem; line-height: 1.8; padding-left: 1.25rem;">
              <li><code style="background-color: rgba(34, 211, 238, 0.1); padding: 0.125rem 0.375rem; border-radius: 0.25rem; color: #22D3EE;">{{first_name}}</code> - First name</li>
              <li><code style="background-color: rgba(34, 211, 238, 0.1); padding: 0.125rem 0.375rem; border-radius: 0.25rem; color: #22D3EE;">{{last_name}}</code> - Last name</li>
              <li><code style="background-color: rgba(34, 211, 238, 0.1); padding: 0.125rem 0.375rem; border-radius: 0.25rem; color: #22D3EE;">{{email}}</code> - Email address</li>
            </ul>
          </div>

          <div style="margin-bottom: 1.5rem;">
            <p style="color: white; font-weight: 600; margin-bottom: 0.5rem;">Best Practices:</p>
            <ul style="color: #94A3B8; font-size: 0.875rem; line-height: 1.8; padding-left: 1.25rem;">
              <li>Keep subject lines under 60 characters</li>
              <li>Personalize with variables</li>
              <li>Include a clear call-to-action</li>
              <li>Test on multiple devices</li>
            </ul>
          </div>

          <div style="padding: 1rem; background-color: rgba(34, 211, 238, 0.1); border: 1px solid rgba(34, 211, 238, 0.2); border-radius: 0.5rem;">
            <div style="display: flex; align-items-start; gap: 0.75rem;">
              <i data-lucide="info" style="width: 1.25rem; height: 1.25rem; color: #22D3EE; flex-shrink: 0; margin-top: 0.125rem;"></i>
              <p style="color: #94A3B8; font-size: 0.875rem; line-height: 1.6; margin: 0;">
                Templates can be used across multiple campaigns. Variables will be automatically replaced with contact data.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  document.addEventListener('turbo:load', () => {
    if (typeof lucide !== 'undefined') {
      lucide.createIcons();
    }
  });

  document.addEventListener('DOMContentLoaded', () => {
    if (typeof lucide !== 'undefined') {
      lucide.createIcons();
    }
  });
</script>
