<%= turbo_stream_from "entity_#{current_entity.id}_email_templates" %>


<div class="container-fluid py-4">
  <%# Page Header %>
  <div class="admin-page-header">
    <div class="header-left">
      <div class="header-icon">
        <i data-lucide="file-text"></i>
      </div>
      <div class="header-text">
        <h1>Email Templates</h1>
        <p>Create and manage reusable email templates</p>
      </div>
    </div>

    <div class="header-actions d-flex gap-2">
      <%= link_to new_ai_content_path, class: "admin-btn admin-btn-outline" do %>
        <i data-lucide="sparkles" aria-hidden="true"></i>
        <span>Generate with AI</span>
      <% end %>
      <%= link_to new_email_template_path, class: "admin-btn admin-btn-primary" do %>
        <i data-lucide="plus" aria-hidden="true"></i>
        <span>New Template</span>
      <% end %>
    </div>
  </div>

  <% if @email_templates.any? %>
    <%# Templates Table %>
    <div class="admin-card">
      <h3 class="card-title">
        <i data-lucide="list" class="icon-lg icon-with-spacing"></i>
        All Templates
      </h3>

      <%= turbo_frame_tag "email_templates_list", data: { turbo_action: "advance" } do %>
        <div style="overflow-x: auto;">
          <table class="admin-table">
            <thead>
              <tr>
                <th>Name</th>
                <th>Subject</th>
                <th>Created</th>
                <th style="width: 300px; text-align: right;">Actions</th>
              </tr>
            </thead>
            <tbody id="email-templates-tbody">
              <% @email_templates.each do |template| %>
                <tr id="email_template_<%= template.id %>" class="<%= 'highlight-row' if template.created_at > 10.seconds.ago %>">
                  <td class="text-white fw-semibold"><%= template.name %></td>
                  <td class="text-secondary"><%= template.subject %></td>
                  <td class="text-muted small"><%= template.created_at.strftime("%b %d, %Y") %></td>
                  <td class="text-end">
                    <div class="d-inline-flex gap-2">
                      <%= link_to email_template_path(template), class: "admin-btn admin-btn-sm admin-btn-outline", "aria-label": "View #{template.name}" do %>
                        <i data-lucide="eye" aria-hidden="true"></i>
                        <span>View</span>
                      <% end %>
                      <%= link_to improve_ai_content_path(template), class: "admin-btn admin-btn-sm admin-btn-outline", "aria-label": "Improve #{template.name} with AI" do %>
                        <i data-lucide="sparkles" aria-hidden="true"></i>
                        <span>Improve</span>
                      <% end %>
                      <%= link_to edit_email_template_path(template), class: "admin-btn admin-btn-sm admin-btn-outline", "aria-label": "Edit #{template.name}" do %>
                        <i data-lucide="pencil" aria-hidden="true"></i>
                        <span>Edit</span>
                      <% end %>
                      <%= button_to email_template_path(template), method: :delete,
                          class: "admin-btn admin-btn-sm admin-btn-outline text-danger border-danger",
                          "aria-label": "Delete #{template.name}",
                          data: { turbo_confirm: "Are you sure?" }, form_class: "d-inline" do %>
                        <i data-lucide="trash-2" aria-hidden="true"></i>
                      <% end %>
                    </div>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% end %>
    </div>

    <%# AI Content Generation Callout %>
    <div class="admin-card mt-4" style="background: linear-gradient(135deg, rgba(124, 58, 237, 0.1) 0%, rgba(167, 139, 250, 0.1) 100%); border-color: rgba(124, 58, 237, 0.2);">
      <div class="d-flex align-items-start gap-4">
        <div class="stat-icon stat-icon-gradient flex-shrink-0">
          <i data-lucide="sparkles" class="icon-xl text-white" aria-hidden="true"></i>
        </div>
        <div class="flex-fill">
          <h5 class="text-white fs-5 fw-semibold mb-2">AI Content Generation</h5>
          <p class="text-secondary mb-3">
            Use our AI content generator to create professional, engaging email templates in seconds.
            Simply specify your audience, purpose, and tone, and our AI will craft compelling content
            tailored to your needs.
          </p>
          <%= link_to new_ai_content_path, class: "admin-btn admin-btn-primary" do %>
            <i data-lucide="sparkles" aria-hidden="true"></i>
            <span>Try AI Content Generator</span>
          <% end %>
        </div>
      </div>
    </div>
  <% else %>
    <%# Empty State %>
    <div class="admin-card">
      <div class="admin-empty-state">
        <div class="empty-icon">
          <i data-lucide="file-text"></i>
        </div>
        <h3>No Email Templates Yet</h3>
        <p>Create your first email template manually or generate one with AI</p>
        <div class="d-flex gap-3 justify-content-center mt-4">
          <%= link_to new_email_template_path, class: "admin-btn admin-btn-outline" do %>
            <i data-lucide="plus" aria-hidden="true"></i>
            <span>Create Template</span>
          <% end %>
          <%= link_to new_ai_content_path, class: "admin-btn admin-btn-primary" do %>
            <i data-lucide="sparkles" aria-hidden="true"></i>
            <span>Generate with AI</span>
          <% end %>
        </div>
      </div>
    </div>
  <% end %>
</div>

<style>
  /* Highlight newly created templates */
  .highlight-row {
    background-color: rgba(34, 211, 238, 0.1) !important;
    animation: fadeHighlight 3s ease-out forwards;
  }

  @keyframes fadeHighlight {
    from {
      background-color: rgba(34, 211, 238, 0.1);
    }
    to {
      background-color: transparent;
    }
  }
</style>

<script>
  document.addEventListener('turbo:load', () => {
    if (typeof lucide !== 'undefined') {
      lucide.createIcons();
    }
  });

  document.addEventListener('DOMContentLoaded', () => {
    if (typeof lucide !== 'undefined') {
      lucide.createIcons();
    }
  });
</script>
