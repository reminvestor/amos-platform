<div class="container mt-4">
  <div class="row">
    <div class="col-md-12">
      <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center">
          <h2>Email Templates</h2>
          <div>
            <%= link_to new_ai_content_path, class: "btn btn-info me-2" do %>
              <i class="fas fa-robot me-1"></i> Generate with AI
            <% end %>
            <%= link_to "New Template", new_email_template_path, class: "btn btn-primary" %>
          </div>
        </div>
        <div class="card-body">
          <% if @email_templates.any? %>
            <div class="table-responsive">
              <table class="table table-striped">
                <thead>
                  <tr>
                    <th>Name</th>
                    <th>Subject</th>
                    <th>Created</th>
                    <th width="250">Actions</th>
                  </tr>
                </thead>
                <tbody>
                  <% @email_templates.each do |template| %>
                    <tr>
                      <td><%= template.name %></td>
                      <td><%= template.subject %></td>
                      <td><%= template.created_at.strftime("%b %d, %Y") %></td>
                      <td>
                        <%= link_to "View", email_template_path(template), class: "btn btn-sm btn-outline-primary" %>
                        <%= link_to improve_ai_content_path(template), class: "btn btn-sm btn-outline-info" do %>
                          <i class="fas fa-robot"></i> Improve
                        <% end %>
                        <%= link_to "Edit", edit_email_template_path(template), class: "btn btn-sm btn-outline-secondary" %>
                        <%= button_to "Delete", email_template_path(template), method: :delete, data: { turbo_confirm: "Are you sure?" }, class: "btn btn-sm btn-outline-danger", form_class: "d-inline" %>
                      </td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            </div>
          <% else %>
            <div class="alert alert-info">
              <p class="mb-0">You don't have any email templates yet. You can <%= link_to "create a template manually", new_email_template_path %> or <%= link_to "generate one with AI", new_ai_content_path %>.</p>
            </div>
          <% end %>
          
          <div class="card mt-4 bg-light">
            <div class="card-body">
              <h5><i class="fas fa-lightbulb me-2 text-warning"></i> AI Content Generation</h5>
              <p class="mb-0">
                Use our AI content generator to create professional, engaging email templates in seconds. 
                Simply specify your audience, purpose, and tone, and our AI will craft compelling content 
                tailored to your needs.
              </p>
              <div class="mt-3">
                <%= link_to new_ai_content_path, class: "btn btn-info" do %>
                  <i class="fas fa-robot me-1"></i> Try AI Content Generator
                <% end %>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
