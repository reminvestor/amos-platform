<div class="container-fluid py-4">
  <%# Page Header %>
  <div class="admin-page-header">
    <div class="header-left">
      <div class="header-icon">
        <i data-lucide="bookmark"></i>
      </div>
      <div class="header-text">
        <h1>Bookmarks</h1>
        <p>Your saved conversations, insights, and context</p>
      </div>
    </div>

    <div class="header-actions">
      <%= link_to new_bookmark_path, class: "admin-btn admin-btn-primary" do %>
        <i data-lucide="plus" aria-hidden="true"></i>
        <span>New Bookmark</span>
      <% end %>
    </div>
  </div>

  <%# Filter Tabs %>
  <div class="admin-card mb-4">
    <div class="d-flex gap-2 flex-wrap">
      <%= link_to bookmarks_path, class: "admin-btn #{@filter.blank? ? 'admin-btn-primary' : 'admin-btn-outline'}" do %>
        <i data-lucide="layers" class="me-1" style="width: 16px; height: 16px;"></i>
        All (<%= current_entity.memory_bookmarks.where(user: current_user).count %>)
      <% end %>
      <%= link_to bookmarks_path(filter: 'conversations'), class: "admin-btn #{@filter == 'conversations' ? 'admin-btn-primary' : 'admin-btn-outline'}" do %>
        <i data-lucide="message-square" class="me-1" style="width: 16px; height: 16px;"></i>
        Conversations (<%= @conversations.count %>)
      <% end %>
      <%= link_to bookmarks_path(filter: 'visualizations'), class: "admin-btn #{@filter == 'visualizations' ? 'admin-btn-primary' : 'admin-btn-outline'}" do %>
        <i data-lucide="bar-chart-2" class="me-1" style="width: 16px; height: 16px;"></i>
        Visualizations (<%= @visualizations.count %>)
      <% end %>
      <%= link_to bookmarks_path(filter: 'context'), class: "admin-btn #{@filter == 'context' ? 'admin-btn-primary' : 'admin-btn-outline'}" do %>
        <i data-lucide="box" class="me-1" style="width: 16px; height: 16px;"></i>
        Context (<%= @context_blocks.count %>)
      <% end %>
      <%= link_to bookmarks_path(filter: 'insights'), class: "admin-btn #{@filter == 'insights' ? 'admin-btn-primary' : 'admin-btn-outline'}" do %>
        <i data-lucide="lightbulb" class="me-1" style="width: 16px; height: 16px;"></i>
        Insights (<%= @insights.count %>)
      <% end %>
    </div>
  </div>

  <% if @bookmarks.any? %>
    <%# Bookmarks Grid %>
    <div class="bookmarks-grid">
      <% @bookmarks.each do |bookmark| %>
        <div class="bookmark-card">
          <div class="bookmark-header">
            <div class="bookmark-icon" style="color: var(--accent-primary);">
              <i data-lucide="<%= bookmark.icon %>" style="width: 20px; height: 20px;"></i>
            </div>
            <div class="bookmark-type">
              <span class="badge bg-secondary"><%= bookmark.content_type&.titleize || 'Saved' %></span>
              <% if bookmark.shareable? %>
                <span class="badge bg-info">Shared</span>
              <% end %>
            </div>
          </div>

          <h5 class="bookmark-title"><%= bookmark.title %></h5>

          <% if bookmark.description.present? %>
            <p class="bookmark-description"><%= truncate(bookmark.description, length: 120) %></p>
          <% end %>

          <% if bookmark.tags.present? && bookmark.tags.any? %>
            <div class="bookmark-tags">
              <% bookmark.tags.first(3).each do |tag| %>
                <span class="tag"><%= tag %></span>
              <% end %>
              <% if bookmark.tags.length > 3 %>
                <span class="tag">+<%= bookmark.tags.length - 3 %></span>
              <% end %>
            </div>
          <% end %>

          <div class="bookmark-meta">
            <span>
              <i data-lucide="clock" style="width: 12px; height: 12px;" class="me-1"></i>
              <%= time_ago_in_words(bookmark.created_at) %> ago
            </span>
            <% if bookmark.view_count > 0 %>
              <span>
                <i data-lucide="eye" style="width: 12px; height: 12px;" class="me-1"></i>
                <%= bookmark.view_count %> views
              </span>
            <% end %>
          </div>

          <div class="bookmark-actions">
            <%= link_to bookmark_path(bookmark), class: "btn btn-sm btn-link text-primary", title: "View" do %>
              <i data-lucide="eye" style="width: 14px; height: 14px;"></i>
            <% end %>
            <% if bookmark.shareable? %>
              <%= link_to unshare_bookmark_path(bookmark), method: :patch, class: "btn btn-sm btn-link text-warning", title: "Make Private" do %>
                <i data-lucide="lock" style="width: 14px; height: 14px;"></i>
              <% end %>
            <% else %>
              <%= link_to share_bookmark_path(bookmark), method: :patch, class: "btn btn-sm btn-link text-muted", title: "Share" do %>
                <i data-lucide="share-2" style="width: 14px; height: 14px;"></i>
              <% end %>
            <% end %>
            <%= link_to edit_bookmark_path(bookmark), class: "btn btn-sm btn-link text-muted", title: "Edit" do %>
              <i data-lucide="pencil" style="width: 14px; height: 14px;"></i>
            <% end %>
            <%= link_to bookmark_path(bookmark), method: :delete, class: "btn btn-sm btn-link text-danger", title: "Delete", data: { confirm: "Delete this bookmark?" } do %>
              <i data-lucide="trash-2" style="width: 14px; height: 14px;"></i>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <%# Empty State %>
    <div class="admin-card">
      <div class="admin-empty-state">
        <div class="empty-icon">
          <i data-lucide="bookmark"></i>
        </div>
        <h3>No Bookmarks Yet</h3>
        <p>Save important conversations, insights, and context from your Amos sessions</p>
        <div class="mt-3">
          <%= link_to chat_mode_path, class: "admin-btn admin-btn-primary" do %>
            <i data-lucide="message-circle" aria-hidden="true"></i>
            <span>Start a Conversation</span>
          <% end %>
        </div>
      </div>
    </div>
  <% end %>
</div>

<style>
  .bookmarks-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 1.25rem;
  }

  .bookmark-card {
    background: var(--bg-secondary);
    border: 1px solid var(--border-primary);
    border-radius: 12px;
    padding: 1.25rem;
    transition: all 0.2s ease;
    display: flex;
    flex-direction: column;
  }

  .bookmark-card:hover {
    border-color: var(--accent-primary);
    transform: translateY(-2px);
  }

  .bookmark-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 0.75rem;
  }

  .bookmark-icon {
    width: 40px;
    height: 40px;
    border-radius: 10px;
    background: var(--bg-tertiary);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .bookmark-type {
    display: flex;
    gap: 0.5rem;
  }

  .bookmark-title {
    color: var(--text-primary);
    font-weight: 600;
    margin-bottom: 0.5rem;
    font-size: 1rem;
  }

  .bookmark-description {
    color: var(--text-secondary);
    font-size: 0.875rem;
    line-height: 1.5;
    margin-bottom: 0.75rem;
    flex: 1;
  }

  .bookmark-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    margin-bottom: 0.75rem;
  }

  .bookmark-tags .tag {
    background: var(--bg-tertiary);
    color: var(--text-secondary);
    padding: 0.125rem 0.5rem;
    border-radius: 4px;
    font-size: 0.75rem;
  }

  .bookmark-meta {
    display: flex;
    gap: 1rem;
    font-size: 0.75rem;
    color: var(--text-muted);
    padding-top: 0.75rem;
    border-top: 1px solid var(--border-primary);
    margin-bottom: 0.5rem;
  }

  .bookmark-actions {
    display: flex;
    gap: 0.25rem;
    justify-content: flex-end;
    opacity: 0;
    transition: opacity 0.2s ease;
  }

  .bookmark-card:hover .bookmark-actions {
    opacity: 1;
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    if (typeof lucide !== 'undefined') lucide.createIcons();
  });
  document.addEventListener('turbo:load', () => {
    if (typeof lucide !== 'undefined') lucide.createIcons();
  });
</script>
