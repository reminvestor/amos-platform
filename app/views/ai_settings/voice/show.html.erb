<div class="container-fluid py-4">
  <div class="row">
    <div class="col-12">
      <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
          <h1 class="admin-title mb-1">
            <i data-lucide="mic" class="me-2" style="color: #A78BFA;"></i>
            Voice Settings
          </h1>
          <p class="text-muted mb-0">Configure text-to-speech and voice input preferences</p>
        </div>
      </div>
    </div>
  </div>

  <% if flash[:notice] %>
    <div class="alert alert-success alert-dismissible fade show" role="alert">
      <i data-lucide="check-circle" class="me-2"></i>
      <%= flash[:notice] %>
      <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
  <% end %>

  <div class="row">
    <div class="col-lg-8">
      <div class="admin-card mb-4">
        <h4 style="color: white; margin-bottom: 1.5rem; display: flex; align-items: center; gap: 0.5rem;">
          <i data-lucide="volume-2" style="color: #A78BFA;"></i>
          Text-to-Speech Settings
        </h4>
        
        <div data-controller="voice-settings">
          <%= form_with url: api_tts_preferences_path, method: :patch, local: false, data: { action: "submit->voice-settings#saveSettings" } do |f| %>
            
            <div style="display: flex; align-items: center; gap: 0.75rem; margin-bottom: 2rem;">
              <%= check_box_tag :enabled, "true", @tts_preferences['enabled'] != false, 
                  class: "form-check-input", 
                  id: "tts_enabled",
                  style: "width: 1.25rem; height: 1.25rem; cursor: pointer;",
                  data: { action: "change->voice-settings#togglePreview" } %>
              <label for="tts_enabled" style="color: white; cursor: pointer; user-select: none; margin: 0;">
                Enable text-to-speech for AI responses
              </label>
            </div>

            <div class="row" data-voice-settings-target="settings">
              
              <%# Provider Selection %>
              <div class="col-12 mb-4">
                <div class="admin-form-group">
                  <label for="provider" class="admin-label">Voice Provider</label>
                  <% 
                    current_provider = @tts_preferences['provider']
                    if current_provider.blank?
                      current_voice = @tts_preferences['voice_id']
                      is_polly = ['Matthew', 'Joanna', 'Ivy', 'Kendra', 'Kimberly', 'Salli', 'Joey', 'Justin', 'Kevin', 'Ruth', 'Stephen', 'Olivia'].include?(current_voice)
                      current_provider = is_polly ? 'polly' : 'eleven_labs'
                    end
                  %>
                  <%= select_tag :provider,
                      options_for_select([
                        ['Eleven Labs (High Quality - Recommended)', 'eleven_labs'],
                        ['Amazon Polly (Standard)', 'polly']
                      ], current_provider),
                      class: "admin-input",
                      id: "provider",
                      data: { action: "change->voice-settings#switchProvider" } %>
                </div>
              </div>

              <%# Eleven Labs Voices %>
              <div class="col-12 mb-4" id="eleven_labs_voices_container" style="<%= current_provider == 'eleven_labs' ? 'display: block;' : 'display: none;' %>">
                <div class="admin-form-group">
                  <label for="eleven_labs_voice_id" class="admin-label">AI Voice (Eleven Labs)</label>
                  <% eleven_labs_voice_groups = {
                    'American' => [
                      ['Rachel (Female - Calm)', 'Rachel'],
                      ['Drew (Male - News)', 'Drew'],
                      ['Clyde (Male - Deep)', 'Clyde'],
                      ['Nicole (Female - Whisper)', 'Nicole'],
                      ['Emily (Female - Calm)', 'Emily']
                    ],
                    'British' => [
                      ['George (Male - Warm)', 'George']
                    ],
                    'Australian' => [
                      ['Mimi (Female - Child)', 'Mimi'],
                      ['Charlie (Male - Casual)', 'Charlie']
                    ],
                    'Irish' => [
                      ['Fin (Male - Energetic)', 'Fin']
                    ]
                  } %>
                  <%= select_tag :eleven_labs_voice_id,
                      grouped_options_for_select(eleven_labs_voice_groups, @tts_preferences['eleven_labs_voice_id'] || 'George'),
                      class: "admin-input",
                      id: "eleven_labs_voice_id",
                      data: { action: "change->voice-settings#updatePreview" } %>
                  <small style="color: #64748B; display: block; margin-top: 0.25rem;">High-quality AI voices powered by Eleven Labs</small>
                </div>
              </div>

              <%# Polly Voices %>
              <div class="col-12 mb-4" id="polly_voices_container" style="<%= current_provider == 'polly' ? 'display: block;' : 'display: none;' %>">
                <div class="admin-form-group">
                  <label for="voice_id" class="admin-label">AI Voice (Polly)</label>
                  <% voice_groups = {
                    'US English Voices' => [
                      ['Aria (Female - Conversational)', 'Aria'],
                      ['Joanna (Female - Expressive)', 'Joanna'],
                      ['Kendra (Female - Professional)', 'Kendra'],
                      ['Kimberly (Female - Soothing)', 'Kimberly'],
                      ['Salli (Female - Youthful)', 'Salli'],
                      ['Ivy (Female - Clear)', 'Ivy'],
                      ['Ruth (Female - Pleasant)', 'Ruth'],
                      ['Joey (Male - Natural)', 'Joey'],
                      ['Justin (Male - Friendly)', 'Justin'],
                      ['Kevin (Male - Youthful)', 'Kevin'],
                      ['Matthew (Male - Professional)', 'Matthew']
                    ],
                    'UK English Voices' => [
                      ['Amy (British Female - Neural)', 'Amy'],
                      ['Emma (British Female - Classic)', 'Emma'],
                      ['Brian (British Male - Neural)', 'Brian'],
                      ['Arthur (British Male - Distinguished)', 'Arthur']
                    ],
                    'Australian English Voice' => [
                      ['Olivia (Australian Female - Neural)', 'Olivia']
                    ]
                  } %>
                  <%= select_tag :voice_id,
                      grouped_options_for_select(voice_groups, @tts_preferences['voice_id'] || 'Matthew'),
                      class: "admin-input",
                      id: "voice_id",
                      data: { action: "change->voice-settings#updatePreview" } %>
                  <small style="color: #64748B; display: block; margin-top: 0.25rem;">Standard AI voices powered by AWS Polly</small>
                </div>
              </div>

              <div class="col-md-6 mb-4">
                <div class="admin-form-group">
                  <label for="engine" class="admin-label">Voice Quality</label>
                  <%= select_tag :engine,
                      options_for_select([
                        ['Neural (Best quality)', 'neural'],
                        ['Standard (Faster)', 'standard']
                      ], @tts_preferences['engine'] || 'neural'),
                      class: "admin-input",
                      id: "engine" %>
                  <small style="color: #64748B; display: block; margin-top: 0.25rem;">Neural voices sound more natural but cost more</small>
                </div>
              </div>

              <div class="col-md-6 mb-4">
                <div class="admin-form-group">
                  <label for="speed" class="admin-label">Speaking Speed</label>
                  <div style="display: flex; align-items: center; gap: 1rem;">
                    <%= range_field_tag :speed, 
                        @tts_preferences['speed'] || 1.0,
                        min: 0.5, max: 2.0, step: 0.1,
                        class: "form-range",
                        style: "flex: 1;",
                        id: "speed",
                        data: { action: "input->voice-settings#updateSpeedLabel" } %>
                    <span class="admin-badge admin-badge-default" data-voice-settings-target="speedLabel" style="min-width: 3rem; text-align: center;">
                      <%= @tts_preferences['speed'] || '1.0' %>x
                    </span>
                  </div>
                  <small style="color: #64748B; display: block; margin-top: 0.25rem;">Adjust how fast the AI speaks</small>
                </div>
              </div>

              <div class="col-md-6 mb-4">
                <div class="admin-form-group">
                  <label for="volume" class="admin-label">Volume</label>
                  <div style="display: flex; align-items: center; gap: 1rem;">
                    <%= range_field_tag :volume,
                        @tts_preferences['volume'] || 1.0,
                        min: 0, max: 1, step: 0.1,
                        class: "form-range",
                        style: "flex: 1;",
                        id: "volume",
                        data: { action: "input->voice-settings#updateVolumeLabel" } %>
                    <span class="admin-badge admin-badge-default" data-voice-settings-target="volumeLabel" style="min-width: 3rem; text-align: center;">
                      <%= ((@tts_preferences['volume'] || 1.0) * 100).to_i %>%
                    </span>
                  </div>
                  <small style="color: #64748B; display: block; margin-top: 0.25rem;">Set the playback volume</small>
                </div>
              </div>
            </div>

            <div style="margin-top: 2rem; display: flex; justify-content: space-between; align-items: center;">
              <button type="button" class="admin-btn admin-btn-outline" data-action="click->voice-settings#testVoice">
                <i data-lucide="play"></i>
                <span>Test Voice</span>
              </button>
              <%= f.submit "Save Settings", class: "admin-btn admin-btn-primary" %>
            </div>
          <% end %>

          <div class="alert alert-info mt-3 d-none" data-voice-settings-target="successMessage" 
               style="background: rgba(124, 58, 237, 0.1); border: 1px solid rgba(124, 58, 237, 0.2); color: #A78BFA; padding: 1rem; border-radius: 0.5rem;">
            <i data-lucide="check-circle" style="width: 1.25rem; height: 1.25rem; display: inline-block; margin-right: 0.5rem;"></i>
            Voice settings saved successfully!
          </div>
        </div>
      </div>
    </div>

    <div class="col-lg-4">
      <div class="admin-card mb-4" style="background: linear-gradient(135deg, rgba(124, 58, 237, 0.1) 0%, rgba(59, 130, 246, 0.1) 100%); border: 1px solid rgba(124, 58, 237, 0.3);">
        <h5 style="color: white; margin-bottom: 1rem;">
          <i data-lucide="info" class="me-2" style="color: #A78BFA;"></i>
          Voice Mode Tips
        </h5>
        <ul class="text-muted mb-0" style="padding-left: 1.25rem; font-size: 0.875rem;">
          <li class="mb-2">Click the speaker icon in chat to enable voice mode</li>
          <li class="mb-2">Say "Hey Amos" to activate voice commands</li>
          <li class="mb-2">Eleven Labs voices sound more natural but use more credits</li>
          <li>Neural quality is recommended for the best experience</li>
        </ul>
      </div>

      <div class="admin-card">
        <h5 style="color: white; margin-bottom: 1rem;">
          <i data-lucide="keyboard" class="me-2" style="color: #A78BFA;"></i>
          Keyboard Shortcuts
        </h5>
        <div class="text-muted" style="font-size: 0.875rem;">
          <div class="d-flex justify-content-between mb-2">
            <span>Toggle Voice Mode</span>
            <kbd style="background: rgba(15, 23, 42, 0.8); padding: 0.25rem 0.5rem; border-radius: 0.25rem; font-size: 0.75rem;">V</kbd>
          </div>
          <div class="d-flex justify-content-between mb-2">
            <span>Start/Stop Recording</span>
            <kbd style="background: rgba(15, 23, 42, 0.8); padding: 0.25rem 0.5rem; border-radius: 0.25rem; font-size: 0.75rem;">Space</kbd>
          </div>
          <div class="d-flex justify-content-between">
            <span>Stop Speaking</span>
            <kbd style="background: rgba(15, 23, 42, 0.8); padding: 0.25rem 0.5rem; border-radius: 0.25rem; font-size: 0.75rem;">Esc</kbd>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .form-range {
    height: 0.5rem;
    background: #0F172A;
    border-radius: 0.25rem;
    outline: none;
    -webkit-appearance: none;
  }
  
  .form-range::-webkit-slider-thumb {
    -webkit-appearance: none;
    appearance: none;
    width: 1.25rem;
    height: 1.25rem;
    background: #A78BFA;
    cursor: pointer;
    border-radius: 50%;
    border: 2px solid #1F2937;
  }
  
  .form-range::-moz-range-thumb {
    width: 1.25rem;
    height: 1.25rem;
    background: #A78BFA;
    cursor: pointer;
    border-radius: 50%;
    border: 2px solid #1F2937;
    border: none;
  }
  
  .form-check-input:checked {
    background-color: #A78BFA;
    border-color: #A78BFA;
  }
  
  .form-check-input:focus {
    border-color: #A78BFA;
    box-shadow: 0 0 0 0.25rem rgba(167, 139, 250, 0.25);
  }
  
  kbd {
    font-family: monospace;
    color: #A78BFA;
  }
</style>

