<div class="container-fluid py-4">
  <div class="row">
    <div class="col-12">
      <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
          <h1 class="admin-title mb-1">
            <i data-lucide="settings" class="me-2" style="color: #A78BFA;"></i>
            Platform Settings
          </h1>
          <p class="text-muted mb-0">Configure Amos, communications, and customize your experience</p>
        </div>
      </div>
    </div>
  </div>

  <% if flash[:notice] %>
    <div class="alert alert-success alert-dismissible fade show" role="alert">
      <i data-lucide="check-circle" class="me-2"></i>
      <%= flash[:notice] %>
      <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
  <% end %>

  <% if flash[:alert] %>
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
      <i data-lucide="alert-circle" class="me-2"></i>
      <%= flash[:alert] %>
      <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
  <% end %>

  <div class="row">
    <div class="col-lg-8">
      <!-- Communications Settings -->
      <div class="admin-card mb-4">
        <div class="d-flex justify-content-between align-items-center mb-3">
          <h4 class="card-title mb-0">
            <i data-lucide="bell" class="me-2 icon-purple"></i>
            Communications
          </h4>
        </div>
        <p class="text-muted mb-4">Configure how Amos communicates with you outside the platform</p>
        
        <%= form_with url: update_platform_settings_ai_settings_menu_path, method: :post, local: true, class: "platform-settings-form" do |f| %>
          <div class="settings-section">
            <!-- Slack Integration -->
            <div class="setting-item d-flex justify-content-between align-items-start p-3 rounded mb-3" style="background: var(--bg-tertiary, rgba(255,255,255,0.05));">
              <div class="d-flex gap-3">
                <div class="setting-icon" style="background: linear-gradient(135deg, #4A154B 0%, #611f69 100%); padding: 10px; border-radius: 8px;">
                  <i data-lucide="slack" style="width: 20px; height: 20px; color: white;"></i>
                </div>
                <div>
                  <h6 class="mb-1">Slack Notifications</h6>
                  <p class="text-muted mb-0" style="font-size: 0.85rem;">
                    Receive notifications about task completions, errors, and important updates in Slack
                  </p>
                  <% if @entity&.slack_notifications_enabled? %>
                  <span class="badge bg-success mt-2">
                    <i data-lucide="check" style="width: 12px; height: 12px;" class="me-1"></i>
                    Connected
                  </span>
                  <% end %>
                </div>
              </div>
              <div class="form-check form-switch">
                <%= check_box_tag :slack_notifications_enabled, 
                    true, 
                    @entity&.slack_notifications_enabled?,
                    class: "form-check-input", 
                    role: "switch",
                    style: "width: 3rem; height: 1.5rem;",
                    id: "slack_notifications_enabled" %>
              </div>
            </div>
            
            <!-- Slack Webhook URL (shown when enabled) -->
            <div class="slack-config mb-3" id="slack-config" style="<%= 'display: none;' unless @entity&.slack_notifications_enabled? %>">
              <div class="p-3 rounded" style="background: var(--bg-tertiary, rgba(255,255,255,0.05)); margin-left: 52px;">
                <label for="slack_webhook_url" class="form-label small text-muted">Slack Webhook URL</label>
                <%= text_field_tag :slack_webhook_url, 
                    @entity&.slack_webhook_url,
                    class: "form-control form-control-sm",
                    placeholder: "https://hooks.slack.com/services/...",
                    style: "font-family: monospace;" %>
                <small class="text-muted d-block mt-2">
                  <a href="https://api.slack.com/messaging/webhooks" target="_blank" class="text-primary">
                    How to create a Slack webhook →
                  </a>
                </small>
              </div>
            </div>

            <!-- Email Notifications -->
            <div class="setting-item d-flex justify-content-between align-items-start p-3 rounded mb-3" style="background: var(--bg-tertiary, rgba(255,255,255,0.05));">
              <div class="d-flex gap-3">
                <div class="setting-icon" style="background: linear-gradient(135deg, #4f46e5 0%, #6366f1 100%); padding: 10px; border-radius: 8px;">
                  <i data-lucide="mail" style="width: 20px; height: 20px; color: white;"></i>
                </div>
                <div>
                  <h6 class="mb-1">Email Notifications</h6>
                  <p class="text-muted mb-0" style="font-size: 0.85rem;">
                    Receive important notifications via email (task failures, security alerts)
                  </p>
                </div>
              </div>
              <div class="form-check form-switch">
                <%= check_box_tag :email_notifications_enabled, 
                    true, 
                    @entity&.email_notifications_enabled?,
                    class: "form-check-input", 
                    role: "switch",
                    style: "width: 3rem; height: 1.5rem;",
                    id: "email_notifications_enabled" %>
              </div>
            </div>
          </div>

          <div class="mt-4">
            <%= submit_tag "Save Communication Settings", class: "admin-btn admin-btn-primary" %>
          </div>
        <% end %>
      </div>

      <!-- Menu Customization -->
      <div class="admin-card">
        <div class="d-flex justify-content-between align-items-center mb-3">
          <h4 class="card-title mb-0">
            <i data-lucide="layout-grid" class="me-2 icon-purple"></i>
            Sidebar Menu
          </h4>
          <%= link_to reset_ai_settings_menu_path, 
              method: :post, 
              class: "btn btn-sm btn-outline-secondary",
              data: { confirm: "Reset menu to defaults?" } do %>
            <i data-lucide="rotate-ccw" class="me-1" style="width: 14px; height: 14px;"></i>
            Reset
          <% end %>
        </div>
        <p class="text-muted mb-4">Customize which features appear in your sidebar</p>

        <%= form_with url: ai_settings_menu_path, method: :patch, local: true do |f| %>
          <% grouped_items = @all_menu_items.group_by { |item| item[:category] } %>
          
          <% ['Apps', 'Marketing', 'Insights', 'Content', 'Productivity', 'System', 'Custom Modules'].each do |category| %>
            <% items = grouped_items[category] %>
            <% next if items.blank? %>
            
            <div class="menu-category mb-4">
              <h5 style="color: #A78BFA; font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 0.75rem;">
                <%= category %>
              </h5>
              
              <div class="row">
                <% items.uniq { |i| i[:slug] }.first(8).each do |item| %>
                  <div class="col-md-6 mb-2">
                    <div class="menu-item d-flex align-items-center gap-3 p-3 rounded" 
                         style="background: var(--bg-tertiary, rgba(255,255,255,0.05));">
                      <div class="form-check">
                        <%= check_box_tag "visible_items[]", 
                            item[:slug], 
                            @config.item_visible?(item[:slug]),
                            class: "form-check-input",
                            id: "menu_#{item[:slug]}" %>
                      </div>
                      <div class="menu-item-icon" style="color: #A78BFA;">
                        <i data-lucide="<%= item[:icon] %>" style="width: 18px; height: 18px;"></i>
                      </div>
                      <label class="menu-item-label flex-grow-1" for="menu_<%= item[:slug] %>">
                        <%= item[:name] %>
                      </label>
                    </div>
                  </div>
                <% end %>
              </div>
            </div>
          <% end %>

          <div class="mt-4">
            <%= f.submit "Save Menu Configuration", class: "admin-btn admin-btn-primary" %>
          </div>
        <% end %>
      </div>
    </div>

    <div class="col-lg-4">
      <!-- Quick Info Card -->
      <div class="admin-card mb-4">
        <h5 class="card-title">
          <i data-lucide="sparkles" class="me-2 icon-purple"></i>
          About Amos
        </h5>
        <p class="text-muted mb-3" style="font-size: 0.875rem;">
          Amos is your AI operations assistant. He handles tools, integrations, and workflows directly - 
          no need to switch between specialized agents.
        </p>
        <ul class="text-muted mb-0" style="padding-left: 1.25rem; font-size: 0.85rem;">
          <li class="mb-2">Create landing pages and websites</li>
          <li class="mb-2">Build and run automations</li>
          <li class="mb-2">Manage integrations and data</li>
          <li class="mb-2">Analyze and visualize information</li>
        </ul>
      </div>

      <!-- Communication Tips -->
      <div class="admin-card" style="background: linear-gradient(135deg, rgba(124, 58, 237, 0.1) 0%, rgba(59, 130, 246, 0.1) 100%); border: 1px solid rgba(124, 58, 237, 0.3);">
        <h5 class="card-title">
          <i data-lucide="lightbulb" class="me-2 icon-purple"></i>
          Tips
        </h5>
        <ul class="text-muted mb-0" style="padding-left: 1.25rem; font-size: 0.85rem;">
          <li class="mb-2">
            <strong>Slack:</strong> Use webhooks to get notified when automations complete or fail
          </li>
          <li class="mb-2">
            <strong>Sidebar:</strong> Hide features you don't use to keep things clean
          </li>
          <li class="mb-2">
            <strong>Canvases:</strong> Ask Amos to "open [feature]" to quickly navigate
          </li>
        </ul>
      </div>
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    // Toggle Slack config visibility
    const slackToggle = document.getElementById('slack_notifications_enabled');
    const slackConfig = document.getElementById('slack-config');
    
    if (slackToggle && slackConfig) {
      slackToggle.addEventListener('change', function() {
        slackConfig.style.display = this.checked ? 'block' : 'none';
      });
    }
    
    // Initialize Lucide icons
    if (typeof lucide !== 'undefined') {
      lucide.createIcons();
    }
  });
</script>
