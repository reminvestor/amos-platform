<div class="container-fluid d-flex align-items-center justify-content-center" style="min-height: 85vh;">
  <div class="row justify-content-center w-100">
    <div class="col-12 col-lg-6 col-xl-5">
      
      <%= form_with(model: @landing_page, local: true, class: "text-center") do |form| %>
        <% if @landing_page.errors.any? %>
          <div class="alert alert-danger mb-4">
            <h6><%= pluralize(@landing_page.errors.count, "error") %> prohibited this landing page from being saved:</h6>
            <ul class="mb-0 text-start">
              <% @landing_page.errors.full_messages.each do |message| %>
                <li><%= message %></li>
              <% end %>
            </ul>
          </div>
        <% end %>
        
        <!-- Main Description Box -->
        <div class="mb-4">
          <%= form.text_area :description, 
              class: "form-control form-control-lg", 
              rows: 4, 
              style: "font-size: 1.2rem; border-radius: 25px; padding: 20px 25px; border: 2px solid #e9ecef; box-shadow: 0 4px 6px rgba(0,0,0,0.1);",
              placeholder: "Describe your landing page...",
              autofocus: true %>
        </div>
        
        <!-- Action Button -->
        <div class="mb-4">
          <button type="submit" name="action" value="generate_with_ai" class="btn btn-primary btn-lg px-5 py-3" style="border-radius: 25px; font-size: 1.1rem; font-weight: 600;">
            Create Landing Page
          </button>
        </div>
        
        <!-- Campaign Selection (Optional) -->
        <% if current_user.campaigns.where(entity_id: current_entity.id).any? %>
          <div class="mb-3">
            <details class="text-start">
              <summary class="btn btn-link btn-sm text-muted p-0">
                <i class="fas fa-link me-1"></i>
                Link to campaign
              </summary>
              <div class="mt-2">
                <%= form.collection_select :campaign_id, 
                    current_user.campaigns.where(entity_id: current_entity.id).order(created_at: :desc), 
                    :id, :name, 
                    { include_blank: "Select a campaign" }, 
                    { class: "form-select form-select-sm" } %>
              </div>
            </details>
          </div>
        <% end %>
        
        <!-- Cancel Link -->
        <div>
          <%= link_to "Cancel", landing_pages_path, class: "text-muted small" %>
        </div>
        
        <!-- Hidden fields for AI generation -->
        <%= form.hidden_field :title, value: "" %>
        <%= form.hidden_field :slug, value: "" %>
      <% end %>
      
    </div>
  </div>
</div>

<style>
  /* Ultra-minimal Google-style */
  body {
    background: #fff;
  }
  
  .form-control-lg:focus {
    border-color: #4285f4 !important;
    box-shadow: 0 2px 8px rgba(66, 133, 244, 0.2) !important;
    outline: none;
  }
  
  .btn-primary {
    background: #4285f4;
    border: none;
    transition: all 0.2s ease;
  }
  
  .btn-primary:hover {
    background: #3367d6;
    transform: translateY(-1px);
    box-shadow: 0 4px 12px rgba(66, 133, 244, 0.3);
  }
  
  details summary {
    cursor: pointer;
    list-style: none;
  }
  
  details summary::-webkit-details-marker {
    display: none;
  }
</style> 