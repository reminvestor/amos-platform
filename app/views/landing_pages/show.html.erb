<div class="container-fluid py-4">
  <div class="admin-page-header">
    <div class="header-left">
      <h1><%= @landing_page.title %></h1>
      <p class="text-muted">
        Status: <span class="badge bg-<%= @landing_page.status == 'published' ? 'success' : 'secondary' %>"><%= @landing_page.status %></span>
        <% if @landing_page.slug.present? %>
          &middot; Slug: <code><%= @landing_page.slug %></code>
        <% end %>
      </p>
    </div>
    <div class="header-actions">
      <%= link_to "Edit", edit_landing_page_path(@landing_page), class: "btn btn-primary" %>
      <%= link_to "Preview", preview_landing_page_path(@landing_page), class: "btn btn-outline-secondary", target: "_blank" %>
      <%= link_to "Back to Landing Pages", landing_pages_path, class: "btn btn-outline-secondary" %>
    </div>
  </div>

  <div class="card mt-4">
    <div class="card-body">
      <% if @landing_page.html_content.present? %>
        <div class="landing-page-preview-frame" style="border: 1px solid #dee2e6; border-radius: 4px; overflow: hidden; min-height: 400px;">
          <%= sanitize @landing_page.html_content, tags: %w[h1 h2 h3 h4 h5 h6 p div span a img ul ol li br hr section header footer nav main article aside figure figcaption blockquote pre code em strong b i u s sub sup table thead tbody tfoot tr th td caption form input button label select option textarea video source svg path circle rect line polyline polygon g defs use text], attributes: %w[class id style href src alt title target rel width height type name value placeholder for action method colspan rowspan data-action data-controller data-target viewBox fill stroke stroke-width d cx cy r x y x1 y1 x2 y2 points transform xmlns] %>
        </div>
      <% else %>
        <div class="text-center py-5 text-muted">
          <p>No content yet. <strong><%= link_to "Edit this page", edit_landing_page_path(@landing_page) %></strong> to add content.</p>
        </div>
      <% end %>
    </div>
  </div>
</div>
