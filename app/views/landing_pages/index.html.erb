<div class="container-fluid">
  <div class="row mb-4">
    <div class="col">
      <h1>
        <i class="fas fa-globe text-primary"></i>
        Landing Pages
      </h1>
      <p class="text-muted">Manage your marketing landing pages</p>
    </div>
    <div class="col-auto">
      <%= link_to new_landing_page_path, class: "btn btn-primary" do %>
        <i class="fas fa-plus me-1"></i> Create New Page
      <% end %>
    </div>
  </div>

  <% if @landing_pages.any? %>
    <!-- Quick Stats -->
    <div class="row mb-4">
      <div class="col-md-3">
        <div class="card bg-light border-0">
          <div class="card-body">
            <div class="d-flex align-items-center">
              <div class="rounded-circle bg-primary bg-opacity-10 p-3 me-3">
                <i class="fas fa-globe text-primary fa-lg"></i>
              </div>
              <div>
                <div class="h4 mb-0"><%= @landing_pages.count %></div>
                <div class="text-muted small">Total Pages</div>
              </div>
            </div>
          </div>
        </div>
      </div>
      <div class="col-md-3">
        <div class="card bg-light border-0">
          <div class="card-body">
            <div class="d-flex align-items-center">
              <div class="rounded-circle bg-success bg-opacity-10 p-3 me-3">
                <i class="fas fa-check-circle text-success fa-lg"></i>
              </div>
              <div>
                <div class="h4 mb-0"><%= @landing_pages.where(status: 'published').count %></div>
                <div class="text-muted small">Published</div>
              </div>
            </div>
          </div>
        </div>
      </div>
      <div class="col-md-3">
        <div class="card bg-light border-0">
          <div class="card-body">
            <div class="d-flex align-items-center">
              <div class="rounded-circle bg-warning bg-opacity-10 p-3 me-3">
                <i class="fas fa-edit text-warning fa-lg"></i>
              </div>
              <div>
                <div class="h4 mb-0"><%= @landing_pages.where(status: 'draft').count %></div>
                <div class="text-muted small">Drafts</div>
              </div>
            </div>
          </div>
        </div>
      </div>
      <div class="col-md-3">
        <div class="card bg-light border-0">
          <div class="card-body">
            <div class="d-flex align-items-center">
              <div class="rounded-circle bg-info bg-opacity-10 p-3 me-3">
                <i class="fas fa-clock text-info fa-lg"></i>
              </div>
              <div>
                <div class="h4 mb-0"><%= @landing_pages.where('created_at > ?', 7.days.ago).count %></div>
                <div class="text-muted small">This Week</div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Landing Pages Grid -->
    <div class="row">
      <% @landing_pages.each do |page| %>
        <div class="col-lg-6 col-xl-4 mb-4">
          <div class="card h-100 border-0 shadow-sm">
            <div class="card-header bg-white d-flex justify-content-between align-items-center">
              <span class="badge <%= page.status == 'published' ? 'bg-success' : page.status == 'draft' ? 'bg-warning' : 'bg-secondary' %>">
                <%= page.status.titleize %>
              </span>
              <% if page.metadata&.dig('generated_from') == 'workflow' || page.metadata&.dig('ai_generated') %>
                <span class="badge bg-info">
                  <i class="fas fa-robot"></i> AI Generated
                </span>
              <% end %>
            </div>
            
            <div class="card-body">
              <h5 class="card-title mb-2">
                <%= link_to page.title, preview_landing_page_path(page), target: "_blank", class: "text-decoration-none" %>
              </h5>
              
              <% if page.description.present? %>
                <p class="card-text text-muted small mb-3">
                  <%= truncate(page.description, length: 100) %>
                </p>
              <% end %>
              
              <div class="mb-3">
                <small class="text-muted">
                  <i class="fas fa-link"></i> 
                  <code class="small"><%= page.slug %></code>
                </small>
              </div>
              
              <% if page.campaign %>
                <div class="mb-2">
                  <small class="text-muted">
                    <i class="fas fa-envelope"></i> 
                    Campaign: <%= page.campaign.name %>
                  </small>
                </div>
              <% end %>
              
              <div class="small text-muted">
                <i class="fas fa-calendar"></i>
                Created <%= time_ago_in_words(page.created_at) %> ago
              </div>
            </div>
            
            <div class="card-footer bg-white border-top">
              <div class="d-flex gap-2 justify-content-between">
                <%= link_to preview_landing_page_path(page), class: "btn btn-sm btn-outline-primary", target: "_blank" do %>
                  <i class="fas fa-eye"></i> Preview
                <% end %>
                
                <%= link_to edit_landing_page_path(page), class: "btn btn-sm btn-outline-secondary" do %>
                  <i class="fas fa-edit"></i> Edit
                <% end %>
                
                <% if page.status == 'published' %>
                  <%= button_to unpublish_landing_page_path(page), method: :patch, class: "btn btn-sm btn-outline-warning", 
                      data: { confirm: "Unpublish this page?" } do %>
                    <i class="fas fa-eye-slash"></i> Unpublish
                  <% end %>
                <% else %>
                  <%= button_to publish_landing_page_path(page), method: :patch, class: "btn btn-sm btn-success" do %>
                    <i class="fas fa-paper-plane"></i> Publish
                  <% end %>
                <% end %>
              </div>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <!-- Empty State -->
    <div class="row">
      <div class="col-12">
        <div class="card border-0 shadow-sm">
          <div class="card-body text-center py-5">
            <i class="fas fa-globe fa-4x text-muted mb-3"></i>
            <h3>No Landing Pages Yet</h3>
            <p class="text-muted mb-4">Create your first AI-powered landing page to start converting visitors into customers</p>
            <%= link_to new_landing_page_path, class: "btn btn-primary btn-lg" do %>
              <i class="fas fa-plus me-2"></i> Create Your First Landing Page
            <% end %>
          </div>
        </div>
      </div>
    </div>
  <% end %>
</div>
