
<div class="container-fluid py-4">
  <%# Page Header %>
  <div class="admin-page-header">
    <div class="header-left">
      <div class="header-icon">
        <i data-lucide="layout"></i>
      </div>
      <div class="header-text">
        <h1>Landing Pages</h1>
        <p>Manage your marketing landing pages</p>
      </div>
    </div>

    <div class="header-actions">
      <%= link_to new_landing_page_path, class: "admin-btn admin-btn-primary" do %>
        <i data-lucide="plus" aria-hidden="true"></i>
        <span>Create New Page</span>
      <% end %>
    </div>
  </div>

  <% if @landing_pages.any? %>
    <%# Stats Cards %>
    <div class="row row-cols-1 row-cols-md-2 row-cols-xl-4 g-4 mb-4">
      <%# Total Pages - Purple Gradient %>
      <div class="col">
        <div class="admin-card">
          <div class="stat-card">
            <div class="stat-icon stat-icon-gradient">
              <i data-lucide="layout" class="icon-xl text-white" aria-hidden="true"></i>
            </div>
            <div class="stat-content">
              <p class="stat-label">Total Pages</p>
              <h3 class="stat-value"><%= @landing_pages.count %></h3>
            </div>
          </div>
        </div>
      </div>

      <%# Published - Green %>
      <div class="col">
        <div class="admin-card">
          <div class="stat-card">
            <div class="stat-icon stat-icon-success">
              <i data-lucide="check-circle" class="icon-xl text-success" aria-hidden="true"></i>
            </div>
            <div class="stat-content">
              <p class="stat-label">Published</p>
              <h3 class="stat-value"><%= @landing_pages.where(status: 'published').count %></h3>
            </div>
          </div>
        </div>
      </div>

      <%# Drafts - Yellow %>
      <div class="col">
        <div class="admin-card">
          <div class="stat-card">
            <div class="stat-icon stat-icon-warning">
              <i data-lucide="file-edit" class="icon-xl text-warning" aria-hidden="true"></i>
            </div>
            <div class="stat-content">
              <p class="stat-label">Drafts</p>
              <h3 class="stat-value"><%= @landing_pages.where(status: 'draft').count %></h3>
            </div>
          </div>
        </div>
      </div>

      <%# This Week - Cyan %>
      <div class="col">
        <div class="admin-card">
          <div class="stat-card">
            <div class="stat-icon stat-icon-info">
              <i data-lucide="calendar" class="icon-xl text-info" aria-hidden="true"></i>
            </div>
            <div class="stat-content">
              <p class="stat-label">This Week</p>
              <h3 class="stat-value"><%= @landing_pages.where('created_at > ?', 7.days.ago).count %></h3>
            </div>
          </div>
        </div>
      </div>
    </div>

    <%# Landing Pages Grid %>
    <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(360px, 1fr)); gap: 1.5rem;">
      <% @landing_pages.each do |page| %>
        <div class="admin-card" style="display: flex; flex-direction: column; height: 100%;">
          <%# Card Header %>
          <div style="display: flex; justify-content: space-between; align-items: center; padding-bottom: 1rem; border-bottom: 1px solid #1E293B;">
            <% if page.status == 'published' %>
              <span class="admin-badge admin-badge-online">Published</span>
            <% elsif page.status == 'draft' %>
              <span class="admin-badge admin-badge-warning">Draft</span>
            <% else %>
              <span class="admin-badge admin-badge-default"><%= page.status.titleize %></span>
            <% end %>

            <% if page.metadata&.dig('generated_from') == 'workflow' || page.metadata&.dig('ai_generated') %>
              <span class="admin-badge admin-badge-cyan">
                <i data-lucide="bot" class="icon-xs" aria-hidden="true"></i> AI Generated
              </span>
            <% end %>
          </div>

          <%# Card Body %>
          <div style="flex: 1; padding: 1rem 0;">
            <h5 style="color: white; font-size: 1.125rem; font-weight: 600; margin: 0 0 0.5rem 0;">
              <%= link_to page.title, preview_landing_page_path(page), target: "_blank", style: 'color: #22D3EE; text-decoration: none;' %>
            </h5>

            <% if page.description.present? %>
              <p style="color: #94A3B8; font-size: 0.875rem; margin: 0 0 1rem 0;">
                <%= truncate(page.description, length: 100) %>
              </p>
            <% end %>

            <div class="mb-3">
              <div class="d-flex align-items-center gap-2 text-muted small">
                <i data-lucide="link" class="icon-md" aria-hidden="true"></i>
                <code class="text-info" style="background: var(--bg-input); padding: 0.125rem 0.5rem; border-radius: 0.25rem; font-size: 0.75rem;"><%= page.slug %></code>
              </div>
            </div>

            <% if page.campaign %>
              <div class="mb-3">
                <div class="d-flex align-items-center gap-2 text-secondary small">
                  <i data-lucide="mail" class="icon-md" aria-hidden="true"></i>
                  Campaign: <%= page.campaign.name %>
                </div>
              </div>
            <% end %>

            <div class="d-flex align-items-center gap-2 text-muted small">
              <i data-lucide="calendar" class="icon-md" aria-hidden="true"></i>
              Created <%= time_ago_in_words(page.created_at) %> ago
            </div>
          </div>

          <%# Card Footer %>
          <div class="d-flex gap-2 pt-3" style="border-top: 1px solid var(--border-primary);">
            <%= link_to preview_landing_page_path(page), class: "admin-btn admin-btn-sm admin-btn-outline flex-fill", target: "_blank", "aria-label": "Preview #{page.title}" do %>
              <i data-lucide="eye" aria-hidden="true"></i>
              <span>Preview</span>
            <% end %>

            <%= link_to edit_landing_page_path(page), class: "admin-btn admin-btn-sm admin-btn-outline flex-fill", "aria-label": "Edit #{page.title}" do %>
              <i data-lucide="pencil" aria-hidden="true"></i>
              <span>Edit</span>
            <% end %>

            <% if page.status == 'published' %>
              <%= button_to unpublish_landing_page_path(page), method: :patch, class: "admin-btn admin-btn-sm admin-btn-outline flex-fill",
                  "aria-label": "Unpublish #{page.title}",
                  data: { turbo_confirm: "Unpublish this page?" } do %>
                <i data-lucide="eye-off" aria-hidden="true"></i>
                <span>Unpublish</span>
              <% end %>
            <% else %>
              <%= button_to publish_landing_page_path(page), method: :patch, class: "admin-btn admin-btn-sm admin-btn-primary flex-fill",
                  "aria-label": "Publish #{page.title}" do %>
                <i data-lucide="send" aria-hidden="true"></i>
                <span>Publish</span>
              <% end %>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <%# Empty State %>
    <div class="admin-card">
      <div class="admin-empty-state">
        <div class="empty-icon">
          <i data-lucide="layout"></i>
        </div>
        <h3>No Landing Pages Yet</h3>
        <p>Create your first AI-powered landing page to start converting visitors into customers</p>
        <%= link_to new_landing_page_path, class: "admin-btn admin-btn-primary mt-3" do %>
          <i data-lucide="plus" aria-hidden="true"></i>
          <span>Create Your First Landing Page</span>
        <% end %>
      </div>
    </div>
  <% end %>
</div>

<script>
  document.addEventListener('turbo:load', () => {
    if (typeof lucide !== 'undefined') {
      lucide.createIcons();
    }
  });

  document.addEventListener('DOMContentLoaded', () => {
    if (typeof lucide !== 'undefined') {
      lucide.createIcons();
    }
  });
</script>
