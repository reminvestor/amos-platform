<script src="https://unpkg.com/lucide@latest"></script>
<link rel="stylesheet" href="/assets/admin_dark.css">

<div class="container-fluid py-4">
  <%# Page Header %>
  <div class="admin-page-header">
    <div class="header-left">
      <div class="header-icon">
        <i data-lucide="layout"></i>
      </div>
      <div class="header-text">
        <h1>Landing Pages</h1>
        <p>Manage your marketing landing pages</p>
      </div>
    </div>

    <div class="header-actions">
      <%= link_to new_landing_page_path, class: "admin-btn admin-btn-primary" do %>
        <i data-lucide="plus"></i>
        <span>Create New Page</span>
      <% end %>
    </div>
  </div>

  <% if @landing_pages.any? %>
    <%# Stats Cards %>
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1.5rem; margin-bottom: 2rem;">
      <%# Total Pages - Purple Gradient %>
      <div class="admin-card">
        <div style="display: flex; align-items: center; gap: 1rem;">
          <div style="width: 3rem; height: 3rem; border-radius: 0.75rem; background: linear-gradient(135deg, #7C3AED 0%, #A78BFA 100%); display: flex; align-items: center; justify-content: center;">
            <i data-lucide="layout" style="width: 1.5rem; height: 1.5rem; color: white;"></i>
          </div>
          <div>
            <p style="color: #94A3B8; font-size: 0.875rem; margin: 0;">Total Pages</p>
            <h3 style="color: white; font-size: 1.875rem; font-weight: 600; margin: 0;"><%= @landing_pages.count %></h3>
          </div>
        </div>
      </div>

      <%# Published - Green %>
      <div class="admin-card">
        <div style="display: flex; align-items: center; gap: 1rem;">
          <div style="width: 3rem; height: 3rem; border-radius: 0.75rem; background: rgba(34, 197, 94, 0.1); display: flex; align-items: center; justify-content: center; border: 1px solid rgba(34, 197, 94, 0.2);">
            <i data-lucide="check-circle" style="width: 1.5rem; height: 1.5rem; color: rgb(74, 222, 128);"></i>
          </div>
          <div>
            <p style="color: #94A3B8; font-size: 0.875rem; margin: 0;">Published</p>
            <h3 style="color: white; font-size: 1.875rem; font-weight: 600; margin: 0;"><%= @landing_pages.where(status: 'published').count %></h3>
          </div>
        </div>
      </div>

      <%# Drafts - Yellow %>
      <div class="admin-card">
        <div style="display: flex; align-items: center; gap: 1rem;">
          <div style="width: 3rem; height: 3rem; border-radius: 0.75rem; background: rgba(234, 179, 8, 0.1); display: flex; align-items: center; justify-content: center; border: 1px solid rgba(234, 179, 8, 0.2);">
            <i data-lucide="file-edit" style="width: 1.5rem; height: 1.5rem; color: rgb(250, 204, 21);"></i>
          </div>
          <div>
            <p style="color: #94A3B8; font-size: 0.875rem; margin: 0;">Drafts</p>
            <h3 style="color: white; font-size: 1.875rem; font-weight: 600; margin: 0;"><%= @landing_pages.where(status: 'draft').count %></h3>
          </div>
        </div>
      </div>

      <%# This Week - Cyan %>
      <div class="admin-card">
        <div style="display: flex; align-items: center; gap: 1rem;">
          <div style="width: 3rem; height: 3rem; border-radius: 0.75rem; background: rgba(34, 211, 238, 0.1); display: flex; align-items: center; justify-content: center; border: 1px solid rgba(34, 211, 238, 0.2);">
            <i data-lucide="calendar" style="width: 1.5rem; height: 1.5rem; color: #22D3EE;"></i>
          </div>
          <div>
            <p style="color: #94A3B8; font-size: 0.875rem; margin: 0;">This Week</p>
            <h3 style="color: white; font-size: 1.875rem; font-weight: 600; margin: 0;"><%= @landing_pages.where('created_at > ?', 7.days.ago).count %></h3>
          </div>
        </div>
      </div>
    </div>

    <%# Landing Pages Grid %>
    <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(360px, 1fr)); gap: 1.5rem;">
      <% @landing_pages.each do |page| %>
        <div class="admin-card" style="display: flex; flex-direction: column; height: 100%;">
          <%# Card Header %>
          <div style="display: flex; justify-content: space-between; align-items: center; padding-bottom: 1rem; border-bottom: 1px solid #1E293B;">
            <% if page.status == 'published' %>
              <span class="admin-badge admin-badge-online">Published</span>
            <% elsif page.status == 'draft' %>
              <span class="admin-badge admin-badge-warning">Draft</span>
            <% else %>
              <span class="admin-badge admin-badge-default"><%= page.status.titleize %></span>
            <% end %>

            <% if page.metadata&.dig('generated_from') == 'workflow' || page.metadata&.dig('ai_generated') %>
              <span class="admin-badge admin-badge-cyan">
                <i data-lucide="bot" style="width: 0.75rem; height: 0.75rem; display: inline-block; vertical-align: middle;"></i> AI Generated
              </span>
            <% end %>
          </div>

          <%# Card Body %>
          <div style="flex: 1; padding: 1rem 0;">
            <h5 style="color: white; font-size: 1.125rem; font-weight: 600; margin: 0 0 0.5rem 0;">
              <%= link_to page.title, preview_landing_page_path(page), target: "_blank", style: 'color: #22D3EE; text-decoration: none;' %>
            </h5>

            <% if page.description.present? %>
              <p style="color: #94A3B8; font-size: 0.875rem; margin: 0 0 1rem 0;">
                <%= truncate(page.description, length: 100) %>
              </p>
            <% end %>

            <div style="margin-bottom: 0.75rem;">
              <div style="display: flex; align-items: center; gap: 0.5rem; color: #64748B; font-size: 0.875rem;">
                <i data-lucide="link" style="width: 1rem; height: 1rem;"></i>
                <code style="background: #0F172A; padding: 0.125rem 0.5rem; border-radius: 0.25rem; color: #22D3EE; font-size: 0.75rem;"><%= page.slug %></code>
              </div>
            </div>

            <% if page.campaign %>
              <div style="margin-bottom: 0.75rem;">
                <div style="display: flex; align-items: center; gap: 0.5rem; color: #94A3B8; font-size: 0.875rem;">
                  <i data-lucide="mail" style="width: 1rem; height: 1rem;"></i>
                  Campaign: <%= page.campaign.name %>
                </div>
              </div>
            <% end %>

            <div style="display: flex; align-items: center; gap: 0.5rem; color: #64748B; font-size: 0.875rem;">
              <i data-lucide="calendar" style="width: 1rem; height: 1rem;"></i>
              Created <%= time_ago_in_words(page.created_at) %> ago
            </div>
          </div>

          <%# Card Footer %>
          <div style="display: flex; gap: 0.5rem; padding-top: 1rem; border-top: 1px solid #1E293B;">
            <%= link_to preview_landing_page_path(page), class: "admin-btn admin-btn-sm admin-btn-outline", target: "_blank", style: "flex: 1;" do %>
              <i data-lucide="eye"></i>
              <span>Preview</span>
            <% end %>

            <%= link_to edit_landing_page_path(page), class: "admin-btn admin-btn-sm admin-btn-outline", style: "flex: 1;" do %>
              <i data-lucide="pencil"></i>
              <span>Edit</span>
            <% end %>

            <% if page.status == 'published' %>
              <%= button_to unpublish_landing_page_path(page), method: :patch, class: "admin-btn admin-btn-sm admin-btn-outline", style: "flex: 1;",
                  data: { turbo_confirm: "Unpublish this page?" } do %>
                <i data-lucide="eye-off"></i>
                <span>Unpublish</span>
              <% end %>
            <% else %>
              <%= button_to publish_landing_page_path(page), method: :patch, class: "admin-btn admin-btn-sm admin-btn-primary", style: "flex: 1;" do %>
                <i data-lucide="send"></i>
                <span>Publish</span>
              <% end %>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <%# Empty State %>
    <div class="admin-card">
      <div class="admin-empty-state">
        <div class="empty-icon">
          <i data-lucide="layout"></i>
        </div>
        <h3>No Landing Pages Yet</h3>
        <p>Create your first AI-powered landing page to start converting visitors into customers</p>
        <%= link_to new_landing_page_path, class: "admin-btn admin-btn-primary", style: "margin-top: 1rem;" do %>
          <i data-lucide="plus"></i>
          <span>Create Your First Landing Page</span>
        <% end %>
      </div>
    </div>
  <% end %>
</div>

<script>
  document.addEventListener('turbo:load', () => {
    if (typeof lucide !== 'undefined') {
      lucide.createIcons();
    }
  });

  document.addEventListener('DOMContentLoaded', () => {
    if (typeof lucide !== 'undefined') {
      lucide.createIcons();
    }
  });
</script>
