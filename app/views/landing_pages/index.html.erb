<div class="container mt-4">
  <div class="row">
    <div class="col-md-12">
      <div class="card shadow">
        <div class="card-header d-flex justify-content-between align-items-center bg-primary text-white">
          <h2><i class="fas fa-globe me-2"></i> Landing Pages</h2>
          <%= link_to new_landing_page_path, class: "btn btn-light" do %>
            <i class="fas fa-plus me-1"></i> New Landing Page
          <% end %>
        </div>
        <div class="card-body">
          <% if @landing_pages.any? %>
            <div class="table-responsive">
              <table class="table table-hover">
                <thead>
                  <tr>
                    <th>Title</th>
                    <th>URL</th>
                    <th>Status</th>
                    <th>Campaign</th>
                    <th>Created</th>
                    <th class="text-end">Actions</th>
                  </tr>
                </thead>
                <tbody>
                  <% @landing_pages.each do |landing_page| %>
                    <tr>
                      <td>
                        <%= link_to landing_page.title, chat_landing_page_path(landing_page) %>
                      </td>
                      <td>
                        <% if landing_page.published? %>
                          <%= link_to landing_page.full_url, landing_page_public_path(landing_page.slug), target: "_blank" %>
                        <% else %>
                          <span class="text-muted"><%= landing_page.slug %></span>
                        <% end %>
                      </td>
                      <td>
                        <% if landing_page.published? %>
                          <span class="badge bg-success">Published</span>
                        <% else %>
                          <span class="badge bg-secondary">Draft</span>
                        <% end %>
                      </td>
                      <td>
                        <% if landing_page.campaign %>
                          <%= link_to landing_page.campaign.name, campaign_path(landing_page.campaign) %>
                        <% else %>
                          <span class="text-muted">None</span>
                        <% end %>
                      </td>
                      <td><%= landing_page.created_at.strftime("%b %d, %Y") %></td>
                      <td class="text-end">
                        <div class="btn-group">
                          <%= link_to preview_landing_page_path(landing_page), class: "btn btn-sm btn-outline-primary", target: "_blank", title: "Preview" do %>
                            <i class="fas fa-eye"></i>
                          <% end %>
                          
                          <%= link_to chat_landing_page_path(landing_page), class: "btn btn-sm btn-outline-info", title: "Edit with AI Chat" do %>
                            <i class="fas fa-comments"></i>
                          <% end %>
                          
                          <% if landing_page.published? %>
                            <%= button_to unpublish_landing_page_path(landing_page), method: :post, class: "btn btn-sm btn-outline-warning", data: { confirm: "Are you sure you want to unpublish this page?" } do %>
                              <i class="fas fa-ban"></i>
                            <% end %>
                          <% else %>
                            <%= button_to publish_landing_page_path(landing_page), method: :post, class: "btn btn-sm btn-outline-success" do %>
                              <i class="fas fa-check"></i>
                            <% end %>
                          <% end %>
                          
                          <%= button_to landing_page_path(landing_page), method: :delete, class: "btn btn-sm btn-outline-danger", data: { confirm: "Are you sure? This cannot be undone." } do %>
                            <i class="fas fa-trash"></i>
                          <% end %>
                        </div>
                      </td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            </div>
          <% else %>
            <div class="text-center p-5">
              <div class="mb-4">
                <i class="fas fa-globe fa-3x text-muted"></i>
              </div>
              <h4>No landing pages yet</h4>
              <p class="text-muted">Create your first landing page to start converting visitors into leads.</p>
              <%= link_to new_landing_page_path, class: "btn btn-primary" do %>
                <i class="fas fa-plus me-1"></i> Create Landing Page
              <% end %>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div> 