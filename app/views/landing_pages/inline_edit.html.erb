<div class="container-fluid mt-4">
  <div class="row">
    <div class="col-12">
      <!-- Header with controls -->
      <div class="card shadow mb-3">
        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
          <h3><i data-lucide="edit" class="me-2"></i> Inline Editor: <%= @landing_page.title %></h3>
          <div class="btn-group">
            <button class="btn btn-outline-light" id="toggleEditMode">
              <i data-lucide="toggle-right" me-1"></i> Edit Mode: <span id="editModeStatus">ON</span>
            </button>
            <button class="btn btn-success" id="saveChanges" onclick="saveInlineChanges()">
              <i data-lucide="save" class="me-1"></i> Save Changes
            </button>
            <%= link_to edit_landing_page_path(@landing_page), class: "btn btn-outline-light" do %>
              <i data-lucide="code" class="me-1"></i> HTML Editor
            <% end %>
            <%= link_to preview_landing_page_path(@landing_page), class: "btn btn-outline-light", target: "_blank" do %>
              <i data-lucide="eye" class="me-1"></i> Preview
            <% end %>
          </div>
        </div>
      </div>

      <!-- Instructions -->
      <div class="alert alert-info alert-dismissible fade show" role="alert">
        <strong>Quick Editing Mode:</strong>
        <ul class="mb-0 mt-2">
          <li>Click on any text to edit it directly</li>
          <li>Click the <i data-lucide="image"></i> icon on images to replace them from your library</li>
          <li>Changes are highlighted in yellow until saved</li>
          <li>Press <kbd>Escape</kbd> to cancel editing a text element</li>
        </ul>
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
      </div>

      <!-- Preview iframe with editing capabilities -->
      <div class="card shadow">
        <div class="card-body p-0">
          <div id="editablePreview" style="min-height: 600px; background: white;">
            <!-- Landing page content will be injected here -->
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Image Picker Modal -->
<div class="modal fade" id="inlineImagePickerModal" tabindex="-1">
  <div class="modal-dialog modal-lg">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">Select Image from Library</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <div id="imageLibraryGrid" class="row g-3">
          <!-- Images will be loaded here -->
        </div>
        <div class="text-center mt-3">
          <button class="btn btn-sm btn-outline-secondary" id="loadMoreImages">Load More</button>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="button" class="btn btn-primary" id="selectImageBtn" disabled>Select Image</button>
      </div>
    </div>
  </div>
</div>

<style>
  /* Inline editing styles */
  .editable-text {
    cursor: text;
    transition: background-color 0.2s;
  }
  
  .editable-text:hover {
    background-color: rgba(0, 123, 255, 0.1);
    outline: 2px dashed rgba(0, 123, 255, 0.3);
  }
  
  .editable-text.editing {
    background-color: rgba(255, 193, 7, 0.2);
    outline: 2px solid #ffc107;
  }
  
  .editable-text.changed {
    background-color: rgba(255, 193, 7, 0.1);
  }
  
  /* Image editing styles */
  .editable-image-container {
    position: relative;
    display: inline-block;
  }
  
  .editable-image-container .image-edit-btn {
    position: absolute;
    top: 10px;
    right: 10px;
    background: rgba(0, 0, 0, 0.7);
    color: white;
    border: none;
    border-radius: 50%;
    width: 40px;
    height: 40px;
    display: none;
    cursor: pointer;
    z-index: 10;
  }
  
  .editable-image-container:hover .image-edit-btn {
    display: flex;
    align-items: center;
    justify-content: center;
  }
  
  .image-edit-btn:hover {
    background: rgba(0, 123, 255, 0.8);
  }

  /* Image picker styles */
  .image-picker-item {
    cursor: pointer;
    border: 2px solid transparent;
    transition: all 0.2s;
  }
  
  .image-picker-item:hover {
    border-color: #0d6efd;
    transform: scale(1.02);
  }
  
  .image-picker-item.selected {
    border-color: #0d6efd;
    box-shadow: 0 0 0 4px rgba(13, 110, 253, 0.25);
  }
</style>

<script>
  let editMode = true;
  let changes = {};
  let currentImageElement = null;
  let selectedImageUrl = null;
  let imageLibraryPage = 1;
  
  document.addEventListener('DOMContentLoaded', function() {
    // Load the landing page content into the editor
    loadContentForEditing();
    
    // Toggle edit mode button
    document.getElementById('toggleEditMode').addEventListener('click', function() {
      editMode = !editMode;
      document.getElementById('editModeStatus').textContent = editMode ? 'ON' : 'OFF';
      this.classList.toggle('btn-outline-light');
      this.classList.toggle('btn-secondary');
      
      if (!editMode) {
        // Remove all editing capabilities when edit mode is off
        document.querySelectorAll('.editable-text').forEach(el => {
          el.contentEditable = false;
          el.classList.remove('editable-text');
        });
        document.querySelectorAll('.image-edit-btn').forEach(btn => {
          btn.style.display = 'none';
        });
      } else {
        // Re-enable editing
        makeContentEditable();
      }
    });
    
    // Load more images button
    document.getElementById('loadMoreImages').addEventListener('click', function() {
      loadImageLibrary(++imageLibraryPage, true);
    });
    
    // Select image button
    document.getElementById('selectImageBtn').addEventListener('click', function() {
      if (currentImageElement && selectedImageUrl) {
        // Store the change
        const oldSrc = currentImageElement.src;
        currentImageElement.src = selectedImageUrl;
        currentImageElement.dataset.changed = 'true';
        
        // Track the change
        if (!changes.images) changes.images = [];
        changes.images.push({
          element: currentImageElement,
          oldSrc: oldSrc,
          newSrc: selectedImageUrl
        });
        
        // Close modal
        bootstrap.Modal.getInstance(document.getElementById('inlineImagePickerModal')).hide();
      }
    });
  });
  
  function loadContentForEditing() {
    const preview = document.getElementById('editablePreview');
    const htmlContent = <%= raw @landing_page.html_content.to_json %>;
    
    // Create an iframe to isolate the landing page styles
    const iframe = document.createElement('iframe');
    iframe.style.width = '100%';
    iframe.style.border = 'none';
    iframe.style.minHeight = '800px';
    preview.appendChild(iframe);
    
    // Write content to iframe
    const iframeDoc = iframe.contentDocument || iframe.contentWindow.document;
    iframeDoc.open();
    iframeDoc.write(htmlContent);
    iframeDoc.close();
    
    // Wait for iframe to load, then make content editable
    iframe.onload = function() {
      makeContentEditable(iframeDoc);
      
      // Adjust iframe height to content
      iframe.style.height = iframeDoc.body.scrollHeight + 'px';
    };
  }
  
  function makeContentEditable(doc = document) {
    // Make text elements editable
    const textElements = doc.querySelectorAll('h1, h2, h3, h4, h5, h6, p, span, a, button, li, td, th, label');
    textElements.forEach(el => {
      // Skip elements with nested block-level children
      if (el.querySelector('div, p, h1, h2, h3, h4, h5, h6')) return;
      
      el.classList.add('editable-text');
      el.contentEditable = true;
      el.spellcheck = false;
      
      // Track original content
      el.dataset.originalContent = el.innerHTML;
      
      // Add event listeners
      el.addEventListener('focus', handleTextFocus);
      el.addEventListener('blur', handleTextBlur);
      el.addEventListener('input', handleTextInput);
      el.addEventListener('keydown', handleTextKeydown);
    });
    
    // Make images replaceable
    const images = doc.querySelectorAll('img');
    images.forEach(img => {
      // Skip icons and small images
      if (img.width < 50 || img.height < 50) return;
      
      // Wrap image in container if not already wrapped
      let container = img.parentElement;
      if (!container.classList.contains('editable-image-container')) {
        container = doc.createElement('div');
        container.className = 'editable-image-container';
        img.parentNode.insertBefore(container, img);
        container.appendChild(img);
      }
      
      // Add edit button
      const editBtn = doc.createElement('button');
      editBtn.className = 'image-edit-btn';
      editBtn.innerHTML = '<i data-lucide="image"></i>';
      editBtn.onclick = function(e) {
        e.preventDefault();
        openImagePicker(img);
      };
      container.appendChild(editBtn);
    });
    
    // Inject editing styles into iframe
    const style = doc.createElement('style');
    style.textContent = `
      .editable-text {
        cursor: text;
        transition: background-color 0.2s;
      }
      .editable-text:hover {
        background-color: rgba(0, 123, 255, 0.1);
        outline: 2px dashed rgba(0, 123, 255, 0.3);
      }
      .editable-text.editing {
        background-color: rgba(255, 193, 7, 0.2);
        outline: 2px solid #ffc107;
      }
      .editable-text.changed {
        background-color: rgba(255, 193, 7, 0.1);
      }
      .editable-image-container {
        position: relative;
        display: inline-block;
      }
      .editable-image-container .image-edit-btn {
        position: absolute;
        top: 10px;
        right: 10px;
        background: rgba(0, 0, 0, 0.7);
        color: white;
        border: none;
        border-radius: 50%;
        width: 40px;
        height: 40px;
        display: none;
        cursor: pointer;
        z-index: 10;
        align-items: center;
        justify-content: center;
      }
      .editable-image-container:hover .image-edit-btn {
        display: flex;
      }
      .image-edit-btn:hover {
        background: rgba(0, 123, 255, 0.8);
      }
    `;
    doc.head.appendChild(style);
  }
  
  function handleTextFocus(e) {
    e.target.classList.add('editing');
  }
  
  function handleTextBlur(e) {
    e.target.classList.remove('editing');
  }
  
  function handleTextInput(e) {
    const el = e.target;
    if (el.innerHTML !== el.dataset.originalContent) {
      el.classList.add('changed');
      
      // Track the change
      if (!changes.text) changes.text = [];
      const existingChange = changes.text.find(c => c.element === el);
      if (existingChange) {
        existingChange.newContent = el.innerHTML;
      } else {
        changes.text.push({
          element: el,
          selector: getElementSelector(el),
          originalContent: el.dataset.originalContent,
          newContent: el.innerHTML
        });
      }
    } else {
      el.classList.remove('changed');
    }
  }
  
  function handleTextKeydown(e) {
    if (e.key === 'Escape') {
      e.preventDefault();
      e.target.innerHTML = e.target.dataset.originalContent;
      e.target.classList.remove('changed');
      e.target.blur();
    }
  }
  
  function openImagePicker(imgElement) {
    currentImageElement = imgElement;
    selectedImageUrl = null;
    
    // Reset and load image library
    document.getElementById('imageLibraryGrid').innerHTML = '';
    imageLibraryPage = 1;
    loadImageLibrary(1);
    
    // Show modal
    const modal = new bootstrap.Modal(document.getElementById('inlineImagePickerModal'));
    modal.show();
  }
  
  function loadImageLibrary(page = 1, append = false) {
    fetch(`/image_assets.json?page=${page}`)
      .then(response => response.json())
      .then(data => {
        const grid = document.getElementById('imageLibraryGrid');
        if (!append) grid.innerHTML = '';
        
        data.images.forEach(image => {
          const col = document.createElement('div');
          col.className = 'col-md-4';
          col.innerHTML = `
            <div class="image-picker-item card" data-url="${image.url}">
              <img src="${image.thumb_url || image.url}" class="card-img-top" alt="${image.title}">
              <div class="card-body p-2">
                <small class="text-muted">${image.title}</small>
              </div>
            </div>
          `;
          
          col.querySelector('.image-picker-item').addEventListener('click', function() {
            // Remove previous selection
            document.querySelectorAll('.image-picker-item').forEach(item => {
              item.classList.remove('selected');
            });
            
            // Select this image
            this.classList.add('selected');
            selectedImageUrl = this.dataset.url;
            document.getElementById('selectImageBtn').disabled = false;
          });
          
          grid.appendChild(col);
        });
        
        // Hide load more if no more images
        if (data.images.length < 12) {
          document.getElementById('loadMoreImages').style.display = 'none';
        }
      })
      .catch(error => {
        console.error('Error loading image library:', error);
      });
  }
  
  function getElementSelector(element) {
    // Generate a CSS selector for the element
    const path = [];
    while (element && element.nodeType === Node.ELEMENT_NODE) {
      let selector = element.nodeName.toLowerCase();
      if (element.id) {
        selector += '#' + element.id;
        path.unshift(selector);
        break;
      } else if (element.className && typeof element.className === 'string') {
        selector += '.' + element.className.split(' ').filter(c => c && !c.startsWith('editable')).join('.');
      }
      
      // Add index if needed
      let sibling = element;
      let index = 1;
      while (sibling = sibling.previousElementSibling) {
        if (sibling.nodeName.toLowerCase() === element.nodeName.toLowerCase()) {
          index++;
        }
      }
      if (index > 1) {
        selector += ':nth-of-type(' + index + ')';
      }
      
      path.unshift(selector);
      element = element.parentNode;
    }
    return path.join(' > ');
  }
  
  function saveInlineChanges() {
    if ((!changes.text || changes.text.length === 0) && (!changes.images || changes.images.length === 0)) {
      showInfo('No changes to save');
      return;
    }
    
    // Get the iframe document
    const iframe = document.querySelector('#editablePreview iframe');
    const iframeDoc = iframe.contentDocument || iframe.contentWindow.document;
    
    // Get the full HTML with changes
    const updatedHtml = iframeDoc.documentElement.outerHTML;
    
    // Send to server
    fetch('<%= landing_page_path(@landing_page) %>', {
      method: 'PATCH',
      headers: {
        'Content-Type': 'application/json',
        'X-CSRF-Token': document.querySelector('[name="csrf-token"]').getAttribute('content')
      },
      body: JSON.stringify({
        landing_page: {
          html_content: updatedHtml
        }
      })
    })
    .then(response => response.json())
    .then(data => {
      if (data.success) {
        // Clear changes and update visual indicators
        changes = {};
        document.querySelectorAll('.changed').forEach(el => {
          el.classList.remove('changed');
          el.dataset.originalContent = el.innerHTML;
        });
        
        // Show success message
        const alert = document.createElement('div');
        alert.className = 'alert alert-success alert-dismissible fade show position-fixed top-0 start-50 translate-middle-x mt-3';
        alert.style.zIndex = '1050';
        alert.innerHTML = `
          <i data-lucide="check-circle" class="me-2"></i>
          Changes saved successfully!
          <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        `;
        document.body.appendChild(alert);
        
        setTimeout(() => {
          alert.remove();
        }, 3000);
      } else {
        showError('Error saving changes: ' + (data.error || 'Unknown error'));
      }
    })
    .catch(error => {
      showError('Error saving changes: ' + error.message);
    });
  }
</script>
