<div class="container-fluid mt-4">
  <div class="row">
    <div class="col-md-12 mb-3">
      <div class="card shadow">
        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
          <h3><i class="fas fa-globe me-2"></i> Edit Landing Page: <%= @landing_page.title %></h3>
          <div>
            <%= link_to preview_landing_page_path(@landing_page), class: "btn btn-outline-light me-2", target: "_blank" do %>
              <i class="fas fa-eye me-1"></i> Preview
            <% end %>
            
            <% if @landing_page.published? %>
              <%= button_to unpublish_landing_page_path(@landing_page), method: :post, class: "btn btn-warning" do %>
                <i class="fas fa-ban me-1"></i> Unpublish
              <% end %>
            <% else %>
              <%= button_to publish_landing_page_path(@landing_page), method: :post, class: "btn btn-success" do %>
                <i class="fas fa-check me-1"></i> Publish
              <% end %>
            <% end %>
          </div>
        </div>
      </div>
    </div>
  </div>
  
  <div class="row">
    <!-- Main content editing area -->
    <div class="col-md-8">
      <div class="card shadow mb-4">
        <div class="card-header">
          <h5 class="mb-0">
            <i class="fas fa-code me-2"></i>
            Landing Page Content
          </h5>
        </div>
        
        <%= form_with(model: @landing_page, local: true) do |form| %>
          <div class="card-body">
            <% if @landing_page.errors.any? %>
              <div class="alert alert-danger">
                <h4><%= pluralize(@landing_page.errors.count, "error") %> prohibited this landing page from being saved:</h4>
                <ul>
                  <% @landing_page.errors.full_messages.each do |message| %>
                    <li><%= message %></li>
                  <% end %>
                </ul>
              </div>
            <% end %>
            
            <!-- Basic Settings -->
            <div class="row mb-4">
              <div class="col-md-6">
                <%= form.label :title, "Page Title", class: "form-label fw-bold" %>
                <%= form.text_field :title, class: "form-control", placeholder: "Enter page title" %>
              </div>
              <div class="col-md-6">
                <%= form.label :slug, "URL Slug", class: "form-label fw-bold" %>
                <div class="input-group">
                  <span class="input-group-text">/landing/</span>
                  <%= form.text_field :slug, class: "form-control", placeholder: "my-landing-page" %>
                </div>
              </div>
            </div>
            
            <!-- HTML Content Editor -->
            <div class="mb-4">
              <div class="d-flex justify-content-between align-items-center mb-2">
                <label class="form-label fw-bold mb-0">HTML Content</label>
                <div>
                  <button type="button" class="btn btn-sm btn-outline-secondary" onclick="requestAIEdit()">
                    <i class="fas fa-wand-magic-sparkles me-1"></i>
                    Request AI Edit
                  </button>
                  <button type="button" class="btn btn-sm btn-outline-info" onclick="formatHTML()">
                    <i class="fas fa-indent me-1"></i>
                    Format HTML
                  </button>
                </div>
              </div>
              
              <% if @landing_page.html_content.present? %>
                <%= form.text_area :html_content, 
                    class: "form-control", 
                    rows: 30, 
                    style: "font-family: 'Courier New', monospace; font-size: 12px;",
                    placeholder: "Your landing page HTML will appear here after AI generation..." %>
              <% else %>
                <div class="text-center p-5 bg-light rounded">
                  <i class="fas fa-magic fa-3x text-muted mb-3"></i>
                  <h5 class="text-muted">No HTML content generated yet</h5>
                  <p class="text-muted">
                    This landing page doesn't have HTML content yet. 
                    You can regenerate it or add your own HTML content.
                  </p>
                  <button type="button" class="btn btn-primary" onclick="regenerateContent()">
                    <i class="fas fa-magic me-1"></i>
                    Generate HTML Content
                  </button>
                </div>
                <%= form.hidden_field :html_content %>
              <% end %>
            </div>
            
            <!-- SEO Settings -->
            <div class="row">
              <div class="col-md-6">
                <%= form.label :meta_description, "Meta Description", class: "form-label fw-bold" %>
                <%= form.text_area :meta_description, class: "form-control", rows: 3, placeholder: "Enter a description for search engines" %>
              </div>
              <div class="col-md-6">
                <%= form.label :meta_keywords, "Meta Keywords", class: "form-label fw-bold" %>
                <%= form.text_field :meta_keywords, class: "form-control", placeholder: "keyword1, keyword2, keyword3" %>
              </div>
            </div>
          </div>
          
          <div class="card-footer">
            <div class="d-flex justify-content-between">
              <%= link_to "Cancel", landing_pages_path, class: "btn btn-light" %>
              <%= form.submit "Save Changes", class: "btn btn-primary" %>
            </div>
          </div>
        <% end %>
      </div>
    </div>
    
    <!-- Sidebar with AI tools -->
    <div class="col-md-4">
      <div class="card shadow mb-4">
        <div class="card-header bg-secondary text-white">
          <h5 class="mb-0"><i class="fas fa-robot me-2"></i> AI Assistant</h5>
        </div>
        <div class="card-body">
          <div class="mb-3">
            <label class="form-label fw-bold">Ask AI to modify your landing page:</label>
            <textarea id="ai-instruction" class="form-control" rows="4" placeholder="E.g., Make the headline more compelling, add a testimonial section, change the color scheme to blue and white, etc."></textarea>
          </div>
          
          <div class="d-grid mb-3">
            <button type="button" class="btn btn-primary" onclick="sendAIInstruction()">
              <i class="fas fa-magic me-1"></i>
              Apply AI Changes
            </button>
          </div>
          
          <div class="alert alert-info">
            <small>
              <i class="fas fa-info-circle me-1"></i>
              Describe what you want to change and AI will modify the entire HTML for you.
            </small>
          </div>
        </div>
      </div>
      
      <div class="card shadow mb-4">
        <div class="card-header bg-info text-white">
          <h5 class="mb-0"><i class="fas fa-info-circle me-2"></i> Page Info</h5>
        </div>
        <div class="card-body">
          <p><strong>Status:</strong> 
            <span class="badge <%= @landing_page.published? ? 'bg-success' : 'bg-secondary' %>">
              <%= @landing_page.published? ? 'Published' : 'Draft' %>
            </span>
          </p>
          
          <% if @landing_page.published? %>
            <p><strong>Public URL:</strong><br>
              <a href="<%= @landing_page.full_url %>" target="_blank" class="text-break">
                <%= @landing_page.full_url %>
              </a>
            </p>
          <% end %>
          
          <p><strong>Last Updated:</strong><br>
            <%= @landing_page.updated_at.strftime("%B %d, %Y at %I:%M %p") %>
          </p>
          
          <% if @landing_page.campaign %>
            <p><strong>Campaign:</strong><br>
              <%= @landing_page.campaign.name %>
            </p>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- AI Processing Modal -->
<div class="modal fade" id="aiProcessingModal" tabindex="-1" aria-labelledby="aiProcessingModalLabel" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="aiProcessingModalLabel">AI is Processing Your Request</h5>
      </div>
      <div class="modal-body text-center">
        <div class="spinner-border text-primary mb-3" role="status">
          <span class="visually-hidden">Loading...</span>
        </div>
        <p>AI is modifying your landing page. This may take a moment...</p>
      </div>
    </div>
  </div>
</div>

<script>
  let aiProcessingModal;
  
  document.addEventListener('DOMContentLoaded', function() {
    aiProcessingModal = new bootstrap.Modal(document.getElementById('aiProcessingModal'));
  });
  
  function sendAIInstruction() {
    const instruction = document.getElementById('ai-instruction').value.trim();
    
    if (!instruction) {
      alert('Please enter an instruction for the AI.');
      return;
    }
    
    // Show processing modal
    aiProcessingModal.show();
    
    // Send the instruction to the AI
    fetch('<%= apply_change_landing_page_path(@landing_page) %>', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'X-CSRF-Token': document.querySelector('[name="csrf-token"]').getAttribute('content')
      },
      body: JSON.stringify({
        instruction: instruction
      })
    })
    .then(response => response.json())
    .then(data => {
      if (data.status === 'processing') {
        // Poll for updates
        checkForUpdates();
      } else {
        aiProcessingModal.hide();
        alert('Error: ' + (data.message || 'Unknown error'));
      }
    })
    .catch(error => {
      aiProcessingModal.hide();
      alert('Error sending request: ' + error.message);
    });
  }
  
  function checkForUpdates() {
    setTimeout(() => {
      // Reload the page to get the updated HTML
      window.location.reload();
    }, 5000);
  }
  
  function formatHTML() {
    const htmlContent = document.getElementById('landing_page_html_content');
    if (htmlContent && htmlContent.value) {
      // Simple HTML formatting (basic indentation)
      let formatted = htmlContent.value;
      formatted = formatted.replace(/></g, '>\n<');
      formatted = formatted.replace(/\n\s*\n/g, '\n');
      htmlContent.value = formatted;
    }
  }
  
  function regenerateContent() {
    if (confirm('This will regenerate the entire HTML content. Are you sure?')) {
      // Redirect to the clarification flow
      window.location.href = '<%= clarify_landing_page_path(@landing_page) %>';
    }
  }
  
  function requestAIEdit() {
    const instruction = prompt('What would you like to change about your landing page?');
    if (instruction) {
      document.getElementById('ai-instruction').value = instruction;
      sendAIInstruction();
    }
  }
</script> 