<div class="admin-content" style="padding: 2rem;">
  <div class="container-fluid">
    <%# Page Header %>
    <div class="admin-page-header" style="margin-bottom: 2rem;">
      <div class="header-left">
        <div class="header-icon" style="background: linear-gradient(135deg, #7C3AED 0%, #A78BFA 100%);">
          <i data-lucide="file-text"></i>
        </div>
        <div class="header-text">
          <h1>Edit Landing Page</h1>
          <p><%= @landing_page.title.presence || "Untitled Landing Page" %></p>
        </div>
      </div>
      <div class="header-actions" style="display: flex; gap: 0.75rem;">
        <%= link_to landing_pages_path, class: "admin-btn admin-btn-outline" do %>
          <i data-lucide="arrow-left"></i>
          <span>Back</span>
        <% end %>
        <%= link_to versions_landing_page_path(@landing_page), class: "admin-btn admin-btn-outline" do %>
          <i data-lucide="history"></i>
          <span>History</span>
        <% end %>
        <%= link_to inline_edit_landing_page_path(@landing_page), class: "admin-btn admin-btn-outline" do %>
          <i data-lucide="edit"></i>
          <span>Quick Edit</span>
        <% end %>
        <%= link_to preview_landing_page_path(@landing_page), class: "admin-btn admin-btn-outline", target: "_blank" do %>
          <i data-lucide="eye"></i>
          <span>Preview</span>
        <% end %>
        <% if @landing_page.status == 'published' %>
          <%= button_to unpublish_landing_page_path(@landing_page), method: :post, class: "admin-btn", style: "background: linear-gradient(135deg, #FBBf24 0%, #F59E0B 100%); border: none;" do %>
            <i data-lucide="x-circle"></i>
            <span>Unpublish</span>
          <% end %>
        <% else %>
          <%= button_to publish_landing_page_path(@landing_page), method: :post, class: "admin-btn admin-btn-primary" do %>
            <i data-lucide="check-circle"></i>
            <span>Publish</span>
          <% end %>
        <% end %>
      </div>
    </div>

    <div class="row">
      <%# Main Content Column %>
      <div class="col-lg-8">
        <div class="admin-card">
          <%= form_with(model: @landing_page, local: true) do |form| %>
            <%# Error Messages %>
            <% if @landing_page.errors.any? %>
              <div class="alert alert-danger" style="background-color: var(--status-error-bg); border-color: var(--status-error-border); color: var(--status-error-text); margin-bottom: 1.5rem;">
                <h5 style="margin-bottom: 0.5rem;">
                  <i data-lucide="alert-circle" class="icon-md"></i>
                  <%= pluralize(@landing_page.errors.count, "error") %> prohibited this landing page from being saved:
                </h5>
                <ul style="margin-bottom: 0;">
                  <% @landing_page.errors.full_messages.each do |message| %>
                    <li><%= message %></li>
                  <% end %>
                </ul>
              </div>
            <% end %>

            <%# Basic Settings %>
            <div class="row" style="margin-bottom: 1.5rem;">
              <div class="col-md-6">
                <%= form.label :title, "Page Title", style: "display: block; color: white; font-weight: 600; margin-bottom: 0.5rem;" %>
                <%= form.text_field :title, class: "form-control", placeholder: "Enter page title",
                    style: "background-color: #1E293B; border: 1px solid #334155; color: white; padding: 0.75rem; border-radius: 0.5rem;" %>
              </div>
              <div class="col-md-6">
                <%= form.label :slug, "URL Slug", style: "display: block; color: white; font-weight: 600; margin-bottom: 0.5rem;" %>
                <div class="input-group">
                  <span class="input-group-text" style="background-color: #1E293B; border: 1px solid #334155; color: #64748B;">/landing/</span>
                  <%= form.text_field :slug, class: "form-control", placeholder: "my-landing-page",
                      style: "background-color: #1E293B; border: 1px solid #334155; color: white; padding: 0.75rem; border-radius: 0 0.5rem 0.5rem 0;" %>
                </div>
              </div>
            </div>

            <%# HTML Content Editor %>
            <div style="margin-bottom: 1.5rem;">
              <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.75rem;">
                <label style="color: white; font-weight: 600; margin: 0;">HTML Content</label>
                <div style="display: flex; gap: 0.5rem;">
                  <button type="button" class="admin-btn admin-btn-outline" onclick="requestAIEdit()" style="padding: 0.5rem 0.75rem; font-size: 0.875rem;">
                    <i data-lucide="wand-2"></i>
                    <span>Request AI Edit</span>
                  </button>
                  <button type="button" class="admin-btn admin-btn-outline" onclick="formatHTML()" style="padding: 0.5rem 0.75rem; font-size: 0.875rem;">
                    <i data-lucide="code"></i>
                    <span>Format HTML</span>
                  </button>
                </div>
              </div>

              <% if @landing_page.html_content.present? %>
                <%= form.text_area :html_content,
                    class: "form-control",
                    rows: 30,
                    placeholder: "Your landing page HTML will appear here after AI generation...",
                    style: "background-color: #1E293B; border: 1px solid #334155; color: #22D3EE; padding: 1rem; border-radius: 0.5rem; font-family: 'Courier New', monospace; font-size: 12px; resize: vertical;" %>
              <% else %>
                <div style="text-align: center; padding: 3rem 2rem; background-color: rgba(30, 41, 59, 0.5); border: 1px solid #334155; border-radius: 0.5rem;">
                  <i data-lucide="wand-2" style="width: 3rem; height: 3rem; color: #64748B; margin-bottom: 1rem;"></i>
                  <h5 style="color: white; margin-bottom: 0.5rem;">No HTML content generated yet</h5>
                  <p style="color: #94A3B8; margin-bottom: 1.5rem;">
                    This landing page doesn't have HTML content yet. You can regenerate it or add your own HTML content.
                  </p>
                  <button type="button" class="admin-btn admin-btn-primary" onclick="regenerateContent()">
                    <i data-lucide="sparkles"></i>
                    <span>Generate HTML Content</span>
                  </button>
                </div>
                <%= form.hidden_field :html_content %>
              <% end %>
            </div>

            <%# SEO Settings %>
            <div style="margin-bottom: 1.5rem;">
              <h5 style="color: white; font-weight: 600; margin-bottom: 1rem; padding-bottom: 0.5rem; border-bottom: 1px solid #334155;">
                <i data-lucide="search" style="width: 1.25rem; height: 1.25rem; display: inline-block; vertical-align: middle;"></i>
                SEO Settings
              </h5>
              <div class="row">
                <div class="col-md-6" style="margin-bottom: 1rem;">
                  <%= form.label :meta_description, "Meta Description", style: "display: block; color: white; font-weight: 600; margin-bottom: 0.5rem;" %>
                  <%= form.text_area :meta_description, class: "form-control", rows: 3, placeholder: "Enter a description for search engines",
                      style: "background-color: #1E293B; border: 1px solid #334155; color: white; padding: 0.75rem; border-radius: 0.5rem;" %>
                </div>
                <div class="col-md-6" style="margin-bottom: 1rem;">
                  <%= form.label :meta_keywords, "Meta Keywords", style: "display: block; color: white; font-weight: 600; margin-bottom: 0.5rem;" %>
                  <%= form.text_field :meta_keywords, class: "form-control", placeholder: "keyword1, keyword2, keyword3",
                      style: "background-color: #1E293B; border: 1px solid #334155; color: white; padding: 0.75rem; border-radius: 0.5rem;" %>
                </div>
              </div>
            </div>

            <%# Action Buttons %>
            <div style="display: flex; gap: 0.75rem; padding-top: 1rem; border-top: 1px solid #334155;">
              <%= form.submit "Save Changes", class: "admin-btn admin-btn-primary" %>
              <%= link_to landing_pages_path, class: "admin-btn admin-btn-outline" do %>
                <i data-lucide="x"></i>
                <span>Cancel</span>
              <% end %>
            </div>
          <% end %>
        </div>

        <%# Current Images Gallery %>
        <% image_urls = @landing_page.html_content.to_s.scan(/(?:src|background-image:\s*url\()=?["']?([^"'\s\)]+(?:\.jpg|\.jpeg|\.png|\.gif|\.webp|\.svg)[^"'\s\)]*)["']?\)?/i).flatten.uniq %>
        <% if image_urls.any? %>
          <div class="admin-card" style="margin-top: 1.5rem;">
            <h5 style="color: white; font-weight: 600; margin-bottom: 1rem; display: flex; align-items: center; gap: 0.5rem;">
              <i data-lucide="images" style="width: 1.25rem; height: 1.25rem; color: #A78BFA;"></i>
              <span>Images in Landing Page (<%= image_urls.count %>)</span>
            </h5>
            <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 1rem;">
              <% image_urls.each_with_index do |url, index| %>
                <div style="position: relative; border-radius: 0.5rem; overflow: hidden; background: #1E293B; border: 1px solid #334155;">
                  <img src="<%= url %>"
                       alt="Image <%= index + 1 %>"
                       style="width: 100%; height: 100px; object-fit: cover; display: block;"
                       onerror="this.parentElement.style.display='none'">
                  <div style="padding: 0.5rem; font-size: 0.75rem; color: #94A3B8; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                    <% if url.include?('unsplash') %>
                      <span class="admin-badge" style="background: #22C55E; color: white; font-size: 0.625rem; padding: 0.125rem 0.375rem;">Unsplash</span>
                    <% elsif url.include?('placehold') %>
                      <span class="admin-badge" style="background: #F59E0B; color: white; font-size: 0.625rem; padding: 0.125rem 0.375rem;">Placeholder</span>
                    <% elsif url.include?('localhost') || url.include?('rails/active_storage') %>
                      <span class="admin-badge" style="background: #A78BFA; color: white; font-size: 0.625rem; padding: 0.125rem 0.375rem;">AI Generated</span>
                    <% else %>
                      <span class="admin-badge" style="background: #64748B; color: white; font-size: 0.625rem; padding: 0.125rem 0.375rem;">External</span>
                    <% end %>
                  </div>
                </div>
              <% end %>
            </div>
          </div>
        <% end %>

        <%# Generate Images Alert %>
        <div style="margin-top: 1.5rem; padding: 1rem; background-color: rgba(34, 211, 238, 0.1); border: 1px solid rgba(34, 211, 238, 0.2); border-radius: 0.5rem;">
          <div style="display: flex; justify-content: space-between; align-items: center; gap: 1rem;">
            <div style="flex: 1;">
              <div style="display: flex; align-items-start; gap: 0.75rem;">
                <i data-lucide="image" style="width: 1.25rem; height: 1.25rem; color: #22D3EE; flex-shrink: 0; margin-top: 0.125rem;"></i>
                <div>
                  <strong style="color: white;">Replace images with AI-generated ones</strong>
                  <p style="color: #94A3B8; font-size: 0.875rem; margin: 0.25rem 0 0 0;">
                    Generate custom AI images to replace stock photos or placeholders in your landing page.
                  </p>
                </div>
              </div>
            </div>
            <%= button_to generate_images_landing_page_path(@landing_page), method: :post, class: "admin-btn", style: "background: linear-gradient(135deg, #FBBf24 0%, #F59E0B 100%); border: none; white-space: nowrap;" do %>
              <i data-lucide="sparkles"></i>
              <span>Generate Images</span>
            <% end %>
          </div>
        </div>
      </div>

      <%# Sidebar %>
      <div class="col-lg-4">
        <%# AI Assistant Card %>
        <div class="admin-card">
          <h5 style="color: white; font-weight: 600; margin-bottom: 1rem; display: flex; align-items: center; gap: 0.5rem;">
            <i data-lucide="bot" style="width: 1.25rem; height: 1.25rem; color: #A78BFA;"></i>
            <span>AI Assistant</span>
          </h5>

          <div style="margin-bottom: 1rem;">
            <label style="display: block; color: white; font-weight: 600; margin-bottom: 0.5rem;">Ask AI to modify your landing page:</label>
            <textarea id="ai-instruction" class="form-control" rows="4" placeholder="E.g., Make the headline more compelling, add a testimonial section, change the color scheme to blue and white, etc."
                style="background-color: #1E293B; border: 1px solid #334155; color: white; padding: 0.75rem; border-radius: 0.5rem;"></textarea>
          </div>

          <button type="button" class="admin-btn admin-btn-primary" onclick="sendAIInstruction()" style="width: 100%; margin-bottom: 1rem;">
            <i data-lucide="wand-2"></i>
            <span>Apply AI Changes</span>
          </button>

          <div style="padding: 0.75rem; background-color: rgba(34, 211, 238, 0.1); border: 1px solid rgba(34, 211, 238, 0.2); border-radius: 0.5rem;">
            <div style="display: flex; align-items-start; gap: 0.5rem;">
              <i data-lucide="info" style="width: 1rem; height: 1rem; color: #22D3EE; flex-shrink: 0; margin-top: 0.125rem;"></i>
              <small style="color: #94A3B8; line-height: 1.5;">
                Describe what you want to change and AI will modify the entire HTML for you.
              </small>
            </div>
          </div>
        </div>

        <%# Page Info Card %>
        <div class="admin-card" style="margin-top: 1.5rem;">
          <h5 style="color: white; font-weight: 600; margin-bottom: 1rem; display: flex; align-items: center; gap: 0.5rem;">
            <i data-lucide="info" style="width: 1.25rem; height: 1.25rem; color: #22D3EE;"></i>
            <span>Page Info</span>
          </h5>

          <div style="margin-bottom: 1rem;">
            <p style="color: #94A3B8; font-size: 0.875rem; margin-bottom: 0.25rem;">Status</p>
            <% if @landing_page.status == 'published' %>
              <span class="admin-badge admin-badge-online">Published</span>
            <% else %>
              <span class="admin-badge admin-badge-default">Draft</span>
            <% end %>
          </div>

          <% if @landing_page.status == 'published' %>
            <div style="margin-bottom: 1rem; padding-bottom: 1rem; border-bottom: 1px solid #334155;">
              <p style="color: #94A3B8; font-size: 0.875rem; margin-bottom: 0.25rem;">Public URL</p>
              <a href="<%= @landing_page.full_url %>" target="_blank" style="color: #22D3EE; font-size: 0.875rem; word-break: break-all; text-decoration: none;">
                <%= @landing_page.full_url %>
                <i data-lucide="external-link" style="width: 0.875rem; height: 0.875rem; display: inline-block; vertical-align: middle; margin-left: 0.25rem;"></i>
              </a>
            </div>
          <% end %>

          <div style="margin-bottom: 1rem;">
            <p style="color: #94A3B8; font-size: 0.875rem; margin-bottom: 0.25rem;">Last Updated</p>
            <p style="color: white; font-size: 0.875rem; margin: 0;">
              <%= @landing_page.updated_at.strftime("%B %d, %Y at %I:%M %p") %>
            </p>
          </div>

          <% if @landing_page.campaign %>
            <div style="margin-bottom: 0;">
              <p style="color: #94A3B8; font-size: 0.875rem; margin-bottom: 0.25rem;">Campaign</p>
              <p style="color: white; font-size: 0.875rem; margin: 0;">
                <%= @landing_page.campaign.name %>
              </p>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>

<%# AI Processing Modal %>
<div class="modal fade" id="aiProcessingModal" tabindex="-1" aria-labelledby="aiProcessingModalLabel" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content" style="background-color: #1E293B; border: 1px solid #334155;">
      <div class="modal-header" style="border-bottom: 1px solid #334155;">
        <h5 class="modal-title" id="aiProcessingModalLabel" style="color: white;">
          <i data-lucide="loader-circle" style="width: 1.25rem; height: 1.25rem; display: inline-block; vertical-align: middle; margin-right: 0.5rem;"></i>
          AI is Processing Your Request
        </h5>
      </div>
      <div class="modal-body" style="text-align: center;">
        <div class="spinner-border text-primary mb-3" role="status" style="color: #A78BFA !important;">
          <span class="visually-hidden">Loading...</span>
        </div>
        <p style="color: #94A3B8;">AI is modifying your landing page. This may take a moment...</p>
      </div>
    </div>
  </div>
</div>

<script>
  let aiProcessingModal;

  document.addEventListener('turbo:load', () => {
    if (typeof lucide !== 'undefined') {
      lucide.createIcons();
    }
    initializeModal();
  });

  document.addEventListener('DOMContentLoaded', () => {
    if (typeof lucide !== 'undefined') {
      lucide.createIcons();
    }
    initializeModal();
  });

  function initializeModal() {
    const modalElement = document.getElementById('aiProcessingModal');
    if (modalElement && typeof bootstrap !== 'undefined') {
      aiProcessingModal = new bootstrap.Modal(modalElement);
    }
  }

  function sendAIInstruction() {
    const instruction = document.getElementById('ai-instruction').value.trim();

    if (!instruction) {
      showWarning('Please enter an instruction for the AI.');
      return;
    }

    // Show processing modal
    if (aiProcessingModal) {
      aiProcessingModal.show();
    }

    // Send the instruction to the AI
    fetch('<%= apply_change_landing_page_path(@landing_page) %>', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'X-CSRF-Token': document.querySelector('[name="csrf-token"]').getAttribute('content')
      },
      body: JSON.stringify({
        instruction: instruction
      })
    })
    .then(response => response.json())
    .then(data => {
      if (data.status === 'processing') {
        // Poll for updates
        checkForUpdates();
      } else {
        if (aiProcessingModal) {
          aiProcessingModal.hide();
        }
        showError(data.message || 'Unknown error');
      }
    })
    .catch(error => {
      if (aiProcessingModal) {
        aiProcessingModal.hide();
      }
      showError('Error sending request: ' + error.message);
    });
  }

  function checkForUpdates() {
    setTimeout(() => {
      // Reload the page to get the updated HTML
      window.location.reload();
    }, 5000);
  }

  function formatHTML() {
    const htmlContent = document.getElementById('landing_page_html_content');
    if (htmlContent && htmlContent.value) {
      // Simple HTML formatting (basic indentation)
      let formatted = htmlContent.value;
      formatted = formatted.replace(/></g, '>\n<');
      formatted = formatted.replace(/\n\s*\n/g, '\n');
      htmlContent.value = formatted;
    }
  }

  async function regenerateContent() {
    if (await showConfirm('This will regenerate the entire HTML content. Are you sure?', { title: 'Regenerate', dangerous: true })) {
      // Redirect to the clarification flow
      window.location.href = '<%= clarify_landing_page_path(@landing_page) %>';
    }
  }

  function requestAIEdit() {
    const instruction = prompt('What would you like to change about your landing page?');
    if (instruction) {
      document.getElementById('ai-instruction').value = instruction;
      sendAIInstruction();
    }
  }
</script>
