<div class="container-fluid py-4">
  <div class="admin-page-header">
    <div class="header-left">
      <div class="header-icon" style="background: linear-gradient(135deg, #F59E0B 0%, #FBBF24 100%);">
        <i data-lucide="check-square"></i>
      </div>
      <div class="header-text">
        <h1>Tasks</h1>
        <p>Manage your to-do items and follow-ups</p>
      </div>
    </div>
    <div class="header-actions">
      <%= link_to activities_path, class: "admin-btn admin-btn-secondary" do %>
        <i data-lucide="activity"></i>
        <span>All Activities</span>
      <% end %>
      <%= link_to new_activity_path(type: 'task'), class: "admin-btn admin-btn-primary" do %>
        <i data-lucide="plus"></i>
        <span>New Task</span>
      <% end %>
    </div>
  </div>

  <!-- Overdue Tasks -->
<% if @overdue.any? %>
  <div class="admin-card" style="margin-bottom: 1rem; border-left: 4px solid #EF4444;">
    <div class="admin-card-header">
      <h3 style="color: #EF4444;">
        <i data-lucide="alert-circle"></i>
        Overdue (<%= @overdue.count %>)
      </h3>
    </div>
    <div class="admin-card-body" style="padding: 0;">
      <div class="task-list">
        <% @overdue.each do |task| %>
          <%= render partial: 'task_item', locals: { task: task, overdue: true } %>
        <% end %>
      </div>
    </div>
  </div>
<% end %>

<!-- Due Today -->
<div class="admin-card" style="margin-bottom: 1rem;">
  <div class="admin-card-header">
    <h3>
      <i data-lucide="calendar"></i>
      Due Today (<%= @due_today.count %>)
    </h3>
  </div>
  <div class="admin-card-body" style="padding: 0;">
    <% if @due_today.any? %>
      <div class="task-list">
        <% @due_today.each do |task| %>
          <%= render partial: 'task_item', locals: { task: task, overdue: false } %>
        <% end %>
      </div>
    <% else %>
      <div class="admin-empty-state" style="padding: 2rem;">
        <p>No tasks due today 🎉</p>
      </div>
    <% end %>
  </div>
</div>

<!-- Upcoming -->
<div class="admin-card" style="margin-bottom: 1rem;">
  <div class="admin-card-header">
    <h3>
      <i data-lucide="clock"></i>
      Upcoming (<%= @upcoming.count %>)
    </h3>
  </div>
  <div class="admin-card-body" style="padding: 0;">
    <% if @upcoming.any? %>
      <div class="task-list">
        <% @upcoming.each do |task| %>
          <%= render partial: 'task_item', locals: { task: task, overdue: false } %>
        <% end %>
      </div>
    <% else %>
      <div class="admin-empty-state" style="padding: 2rem;">
        <p>No upcoming tasks</p>
      </div>
    <% end %>
  </div>
</div>

<!-- Recently Completed -->
<% if @completed.any? %>
  <div class="admin-card">
    <div class="admin-card-header">
      <h3 style="color: #10B981;">
        <i data-lucide="check-circle"></i>
        Recently Completed (<%= @completed.count %>)
      </h3>
    </div>
    <div class="admin-card-body" style="padding: 0;">
      <div class="task-list">
        <% @completed.each do |task| %>
          <div class="task-item completed">
            <div class="task-check completed">
              <i data-lucide="check" style="width: 14px; height: 14px;"></i>
            </div>
            <div class="task-content">
              <span class="task-subject" style="text-decoration: line-through;"><%= task.subject %></span>
              <div class="task-meta">
                <% if task.contact.present? %>
                  <span><i data-lucide="user" style="width: 12px; height: 12px;"></i> <%= task.contact.full_name %></span>
                <% end %>
                <span>Completed <%= time_ago_in_words(task.completed_at) %> ago</span>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  </div>
<% end %>

<style>
.task-list {
  display: flex;
  flex-direction: column;
}

.task-item {
  display: flex;
  align-items: flex-start;
  gap: 1rem;
  padding: 1rem 1.5rem;
  border-bottom: 1px solid var(--border-color);
}

.task-item:last-child {
  border-bottom: none;
}

.task-item:hover {
  background: var(--bg-hover);
}

.task-item.completed {
  opacity: 0.6;
}

.task-check {
  width: 24px;
  height: 24px;
  border-radius: 50%;
  border: 2px solid var(--border-color);
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  transition: all 0.2s;
  flex-shrink: 0;
  margin-top: 2px;
}

.task-check:hover {
  border-color: #10B981;
  background: rgba(16, 185, 129, 0.1);
}

.task-check.completed {
  border-color: #10B981;
  background: #10B981;
  color: white;
}

.task-content {
  flex: 1;
  min-width: 0;
}

.task-subject {
  font-weight: 500;
  color: var(--text-primary);
}

.task-description {
  font-size: 0.875rem;
  color: var(--text-secondary);
  margin-top: 0.25rem;
}

.task-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 1rem;
  font-size: 0.75rem;
  color: var(--text-muted);
  margin-top: 0.5rem;
}

.task-meta span {
  display: flex;
  align-items: center;
  gap: 0.25rem;
}

.task-due {
  padding: 0.125rem 0.5rem;
  border-radius: 0.25rem;
  font-size: 0.75rem;
}

.task-due.overdue {
  background: rgba(239, 68, 68, 0.1);
  color: #EF4444;
}

.task-due.today {
  background: rgba(245, 158, 11, 0.1);
  color: #F59E0B;
}

.task-priority {
  padding: 0.125rem 0.5rem;
  border-radius: 0.25rem;
  font-size: 0.7rem;
  text-transform: uppercase;
}

.task-priority.high, .task-priority.urgent {
  background: rgba(239, 68, 68, 0.1);
  color: #EF4444;
}

.task-actions {
  display: flex;
  gap: 0.5rem;
}
</style>

</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
  if (typeof lucide !== 'undefined') {
    lucide.createIcons();
  }
});
</script>
