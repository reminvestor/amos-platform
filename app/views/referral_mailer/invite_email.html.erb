<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>You're Invited to AMOS!</title>
  <style>
    body {
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
      line-height: 1.6;
      color: #333;
      max-width: 600px;
      margin: 0 auto;
      padding: 20px;
      background-color: #f5f5f5;
    }
    .container {
      background-color: #ffffff;
      border-radius: 12px;
      padding: 40px;
      box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
    }
    .header {
      text-align: center;
      margin-bottom: 30px;
    }
    .logo {
      width: 60px;
      height: 60px;
      background: linear-gradient(135deg, #7C3AED 0%, #A78BFA 100%);
      border-radius: 12px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      margin-bottom: 20px;
    }
    .logo-text {
      color: white;
      font-size: 24px;
      font-weight: bold;
    }
    h1 {
      color: #1a1a2e;
      font-size: 28px;
      margin: 0 0 10px;
    }
    .subtitle {
      color: #666;
      font-size: 16px;
      margin: 0;
    }
    .highlight-box {
      background: linear-gradient(135deg, rgba(59, 130, 246, 0.1) 0%, rgba(139, 92, 246, 0.1) 100%);
      border: 1px solid rgba(99, 102, 241, 0.3);
      border-radius: 8px;
      padding: 20px;
      text-align: center;
      margin: 30px 0;
    }
    .token-amount {
      font-size: 36px;
      font-weight: bold;
      color: #7C3AED;
      margin: 0;
    }
    .token-label {
      color: #666;
      font-size: 14px;
      margin: 5px 0 0;
    }
    .benefits {
      margin: 30px 0;
    }
    .benefit {
      display: flex;
      align-items: flex-start;
      margin-bottom: 15px;
    }
    .benefit-icon {
      width: 24px;
      height: 24px;
      background: #22C55E;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      margin-right: 12px;
      flex-shrink: 0;
      color: white;
      font-size: 14px;
    }
    .benefit-text {
      color: #333;
    }
    .cta-button {
      display: block;
      width: 100%;
      padding: 16px 32px;
      background: linear-gradient(135deg, #7C3AED 0%, #A78BFA 100%);
      color: white !important;
      text-decoration: none;
      text-align: center;
      border-radius: 8px;
      font-size: 18px;
      font-weight: 600;
      margin: 30px 0;
    }
    .cta-button:hover {
      opacity: 0.9;
    }
    .footer {
      text-align: center;
      color: #999;
      font-size: 12px;
      margin-top: 30px;
      padding-top: 20px;
      border-top: 1px solid #eee;
    }
    .referrer-note {
      background: #f8f9fa;
      border-radius: 8px;
      padding: 15px;
      margin-bottom: 20px;
      color: #666;
    }
  </style>
</head>
<body>
  <div class="container">
    <div class="header">
      <div class="logo">
        <span class="logo-text">A</span>
      </div>
      <h1>You're Invited to AMOS!</h1>
      <p class="subtitle">Your AI-Powered Marketing Assistant</p>
    </div>

    <div class="referrer-note">
      <strong><%= @referrer.full_name || @referrer.email.split('@').first %></strong> thinks you'd love AMOS and invited you to join!
    </div>

    <div class="highlight-box">
      <p class="token-amount"><%= number_with_delimiter(@free_tokens) %></p>
      <p class="token-label">FREE AI TOKENS ON SIGNUP</p>
      <p style="color: #22C55E; margin: 10px 0 0; font-weight: 600;">Worth ~$2.00 in compute!</p>
    </div>

    <div class="benefits">
      <h3 style="margin-bottom: 15px;">What you can do with AMOS:</h3>
      
      <div class="benefit">
        <div class="benefit-icon">✓</div>
        <div class="benefit-text">
          <strong>AI Marketing Assistant</strong> - Create campaigns, landing pages, and content with AI
        </div>
      </div>
      
      <div class="benefit">
        <div class="benefit-icon">✓</div>
        <div class="benefit-text">
          <strong>Smart CRM</strong> - Manage contacts and leads with AI-powered insights
        </div>
      </div>
      
      <div class="benefit">
        <div class="benefit-icon">✓</div>
        <div class="benefit-text">
          <strong>Workflow Automation</strong> - Automate repetitive tasks with AI agents
        </div>
      </div>
      
      <div class="benefit">
        <div class="benefit-icon">✓</div>
        <div class="benefit-text">
          <strong>Pay-as-you-go</strong> - No monthly fees, only pay for what you use
        </div>
      </div>
    </div>

    <a href="<%= @signup_url %>" class="cta-button">
      Claim Your Free Tokens →
    </a>

    <div class="footer">
      <p>This invitation expires in 30 days.</p>
      <p>Questions? Reply to this email or visit <a href="https://amos.io">amos.io</a></p>
      <p style="margin-top: 20px;">© <%= Date.current.year %> AMOS Labs. All rights reserved.</p>
    </div>
  </div>
</body>
</html>
