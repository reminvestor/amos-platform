<% content_for :title do %><%= @page&.title || @website.name %><% end %>

<!-- Website Header -->
<% if @website.settings['header'].present? %>
  <%= raw @website.settings['header'] %>
<% else %>
  <nav class="navbar navbar-expand-lg navbar-light bg-light sticky-top">
    <div class="container">
      <a class="navbar-brand fw-bold" href="/">
        <%= @website.name %>
      </a>
      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
        <span class="navbar-toggler-icon"></span>
      </button>
      <div class="collapse navbar-collapse" id="navbarNav">
        <ul class="navbar-nav ms-auto">
          <% @website.website_pages.each do |page| %>
            <li class="nav-item">
              <a class="nav-link <%= @page&.id == page.id ? 'active' : '' %>" 
                 href="?page=<%= page.slug %>">
                <%= page.title %>
              </a>
            </li>
          <% end %>
        </ul>
      </div>
    </div>
  </nav>
<% end %>

<!-- Page Content -->
<main>
  <% if @page&.content_html.present? %>
    <%= raw @page.content_html %>
  <% else %>
    <div class="container py-5">
      <div class="text-center text-muted">
        <i data-lucide="file-text" style="width: 48px; height: 48px;" class="mb-3"></i>
        <h4>No content yet</h4>
        <p>This page hasn't been designed yet.</p>
      </div>
    </div>
  <% end %>
</main>

<!-- Website Footer -->
<% if @website.settings['footer'].present? %>
  <%= raw @website.settings['footer'] %>
<% else %>
  <footer class="bg-dark text-white py-4 mt-auto">
    <div class="container text-center">
      <p class="mb-0">&copy; <%= Date.current.year %> <%= @website.name %>. All rights reserved.</p>
    </div>
  </footer>
<% end %>

