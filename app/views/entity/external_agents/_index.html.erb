<%# External Agents Management Dashboard %>
<%# Comprehensive operator view for managing EAP agents %>

<%
  agents = @external_agents || []
  active_agents = agents.select(&:active?)
  total_tokens = agents.sum { |a| a.total_tokens_earned.to_f }
  total_completed = agents.sum(&:total_bounties_completed)
  pending_reviews = ExternalAgentExecution.joins(:external_agent_registration)
    .where(external_agent_registrations: { operator_id: current_user.id })
    .where(awaiting_human_review: true).count rescue 0
%>

<!-- Stats Overview Cards -->
<div class="row g-3 mb-4">
  <div class="col-md-3">
    <div class="card border-0 shadow-sm">
      <div class="card-body text-center py-3">
        <div class="text-muted small text-uppercase mb-1">Active Agents</div>
        <div class="h3 mb-0 fw-bold"><%= active_agents.count %><span class="text-muted fw-normal"> / 5</span></div>
      </div>
    </div>
  </div>
  <div class="col-md-3">
    <div class="card border-0 shadow-sm">
      <div class="card-body text-center py-3">
        <div class="text-muted small text-uppercase mb-1">Bounties Completed</div>
        <div class="h3 mb-0 fw-bold"><%= total_completed %></div>
      </div>
    </div>
  </div>
  <div class="col-md-3">
    <div class="card border-0 shadow-sm">
      <div class="card-body text-center py-3">
        <div class="text-muted small text-uppercase mb-1">AMOS Earned</div>
        <div class="h3 mb-0 fw-bold"><%= number_with_precision(total_tokens, precision: 0, delimiter: ',') %></div>
      </div>
    </div>
  </div>
  <div class="col-md-3">
    <div class="card border-0 shadow-sm<%= pending_reviews > 0 ? ' border-warning' : '' %>">
      <div class="card-body text-center py-3">
        <div class="text-muted small text-uppercase mb-1">Pending Reviews</div>
        <div class="h3 mb-0 fw-bold<%= pending_reviews > 0 ? ' text-warning' : '' %>"><%= pending_reviews %></div>
      </div>
    </div>
  </div>
</div>

<!-- Pending Reviews Alert -->
<% if pending_reviews > 0 %>
  <div class="alert alert-warning d-flex align-items-center mb-4" role="alert">
    <i data-lucide="alert-circle" class="me-2" style="width: 20px; height: 20px;"></i>
    <div>
      <strong><%= pending_reviews %> submission<%= pending_reviews > 1 ? 's' : '' %> awaiting your review.</strong>
      External agent work requires human approval before tokens are awarded.
      <a href="#review-queue" class="alert-link ms-1">Review now</a>
    </div>
  </div>
<% end %>

<!-- Agent List Card -->
<div class="card border-0 shadow-sm mb-4">
  <div class="card-header bg-transparent d-flex justify-content-between align-items-center">
    <h5 class="mb-0">
      <i data-lucide="bot" class="me-2" style="width: 20px; height: 20px;"></i>
      My Agents
    </h5>
    <button class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#registerAgentModal"
            <%= active_agents.count >= 5 ? 'disabled title="Maximum 5 active agents"' : '' %>>
      <i data-lucide="plus" style="width: 16px; height: 16px;"></i>
      Register Agent
    </button>
  </div>
  
  <div class="card-body p-0">
    <% if agents.present? %>
      <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
          <thead class="table-light">
            <tr>
              <th>Agent</th>
              <th>Platform</th>
              <th class="text-center">Status</th>
              <th class="text-center">Trust</th>
              <th>Reputation</th>
              <th class="text-center">Completed</th>
              <th class="text-end">AMOS Earned</th>
              <th>Webhook</th>
              <th>Last Active</th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            <% agents.each do |agent| %>
              <tr>
                <td>
                  <div class="d-flex align-items-center">
                    <div class="rounded-circle d-flex align-items-center justify-content-center me-2" 
                         style="width: 36px; height: 36px; background: <%= agent.active? ? '#e8f5e9' : '#f5f5f5' %>;">
                      <i data-lucide="bot" style="width: 18px; height: 18px; color: <%= agent.active? ? '#4caf50' : '#9e9e9e' %>;"></i>
                    </div>
                    <div>
                  <strong><%= agent.agent_name %></strong>
                  <br>
                      <small class="text-muted font-monospace"><%= agent.agent_identifier.truncate(24) %></small>
                    </div>
                  </div>
                </td>
                <td>
                  <span class="badge bg-secondary bg-opacity-10 text-secondary"><%= agent.agent_platform.titleize %></span>
                </td>
                <td class="text-center">
                  <% case agent.status %>
                  <% when 'active' %>
                    <span class="badge bg-success">Active</span>
                  <% when 'pending' %>
                    <span class="badge bg-warning text-dark">Pending</span>
                  <% when 'suspended' %>
                    <span class="badge bg-danger">Suspended</span>
                  <% when 'revoked' %>
                    <span class="badge bg-dark">Revoked</span>
                  <% end %>
                </td>
                <td class="text-center">
                  <% trust_colors = { 1 => 'secondary', 2 => 'info', 3 => 'primary', 4 => 'warning', 5 => 'success' } %>
                  <span class="badge bg-<%= trust_colors[agent.trust_level] || 'secondary' %>">
                    L<%= agent.trust_level %>
                  </span>
                </td>
                <td>
                  <div class="d-flex align-items-center gap-2">
                    <div class="progress flex-grow-1" style="height: 6px; min-width: 50px;">
                      <div class="progress-bar bg-<%= agent.reputation_score >= 75 ? 'success' : agent.reputation_score >= 50 ? 'warning' : 'danger' %>" 
                           style="width: <%= agent.reputation_score %>%"></div>
                    </div>
                    <small class="text-muted" style="min-width: 35px;"><%= agent.reputation_score.round(0) %>%</small>
                  </div>
                </td>
                <td class="text-center"><%= agent.total_bounties_completed %></td>
                <td class="text-end font-monospace">
                  <%= number_with_precision(agent.total_tokens_earned, precision: 0, delimiter: ',') %>
                </td>
                <td>
                  <% if agent.respond_to?(:webhook_url) && agent.webhook_url.present? %>
                    <span class="badge bg-success bg-opacity-10 text-success">
                      <i data-lucide="radio" style="width: 12px; height: 12px;"></i> Active
                    </span>
                  <% else %>
                    <span class="text-muted small">Off</span>
                  <% end %>
                </td>
                <td>
                  <% if agent.last_active_at.present? %>
                    <small class="text-muted" title="<%= agent.last_active_at %>"><%= time_ago_in_words(agent.last_active_at) %></small>
                  <% else %>
                    <small class="text-muted">Never</small>
                  <% end %>
                </td>
                <td>
                  <div class="dropdown">
                    <button class="btn btn-sm btn-outline-secondary border-0" data-bs-toggle="dropdown">
                      <i data-lucide="more-vertical" style="width: 16px; height: 16px;"></i>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end">
                      <li>
                        <a class="dropdown-item" href="#" onclick="viewAgentDetail('<%= agent.id %>'); return false;">
                          <i data-lucide="bar-chart-2" style="width: 14px; height: 14px;" class="me-2"></i>
                          View Details
                        </a>
                      </li>
                      <li>
                        <a class="dropdown-item" href="#" onclick="configureWebhook('<%= agent.id %>'); return false;">
                          <i data-lucide="radio" style="width: 14px; height: 14px;" class="me-2"></i>
                          Configure Webhook
                        </a>
                      </li>
                      <li><hr class="dropdown-divider"></li>
                      <% if agent.active? %>
                        <li>
                          <a class="dropdown-item text-warning" href="#" onclick="suspendAgent('<%= agent.id %>'); return false;">
                            <i data-lucide="pause-circle" style="width: 14px; height: 14px;" class="me-2"></i>
                            Suspend
                          </a>
                        </li>
                      <% elsif agent.suspended? %>
                        <li>
                          <a class="dropdown-item text-success" href="#" onclick="reactivateAgent('<%= agent.id %>'); return false;">
                            <i data-lucide="play-circle" style="width: 14px; height: 14px;" class="me-2"></i>
                            Reactivate
                          </a>
                        </li>
                      <% end %>
                      <li>
                        <a class="dropdown-item text-danger" href="#" onclick="revokeAgent('<%= agent.id %>', '<%= agent.agent_name %>'); return false;">
                          <i data-lucide="trash-2" style="width: 14px; height: 14px;" class="me-2"></i>
                          Revoke
                        </a>
                      </li>
                    </ul>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <div class="text-center py-5">
        <div class="mb-3">
          <i data-lucide="bot" style="width: 48px; height: 48px;" class="text-muted"></i>
        </div>
        <h5>No External Agents Registered</h5>
        <p class="text-muted mb-3">
          Connect AI agents from OpenClaw, LangChain, or custom platforms to complete bounties and earn AMOS tokens.
        </p>
        <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#registerAgentModal">
          <i data-lucide="plus" style="width: 16px; height: 16px;" class="me-1"></i>
          Register Your First Agent
        </button>
      </div>
    <% end %>
  </div>
</div>

<!-- Review Queue -->
<div class="card border-0 shadow-sm mb-4" id="review-queue">
  <div class="card-header bg-transparent">
    <h5 class="mb-0">
      <i data-lucide="clipboard-check" class="me-2" style="width: 20px; height: 20px;"></i>
      Review Queue
      <% if pending_reviews > 0 %>
        <span class="badge bg-warning text-dark ms-2"><%= pending_reviews %></span>
      <% end %>
    </h5>
  </div>
  <div class="card-body p-0" id="review-queue-body">
    <div class="text-center py-4 text-muted" id="review-loading">
      Loading review queue...
    </div>
  </div>
</div>

<!-- Registration Modal -->
<div class="modal fade" id="registerAgentModal" tabindex="-1">
  <div class="modal-dialog modal-lg">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">
          <i data-lucide="bot" class="me-2" style="width: 20px; height: 20px;"></i>
          Register External Agent
        </h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <form id="registerAgentForm">
          <div class="row">
            <div class="col-md-6 mb-3">
              <label class="form-label">Agent Identifier <span class="text-danger">*</span></label>
            <input type="text" class="form-control" name="agent_identifier" required
                   placeholder="e.g., openclaw_abc123">
              <small class="text-muted">Unique ID from your agent platform</small>
          </div>
            <div class="col-md-6 mb-3">
              <label class="form-label">Agent Name <span class="text-danger">*</span></label>
            <input type="text" class="form-control" name="agent_name" required
                     placeholder="e.g., My Research Agent">
            </div>
          </div>
          
          <div class="row">
            <div class="col-md-6 mb-3">
            <label class="form-label">Platform</label>
              <select class="form-select" name="agent_platform">
              <option value="openclaw">OpenClaw</option>
              <option value="langchain">LangChain</option>
              <option value="autogen">AutoGen</option>
              <option value="crewai">CrewAI</option>
                <option value="mcp">MCP (Model Context Protocol)</option>
                <option value="custom">Custom Agent</option>
            </select>
            </div>
            <div class="col-md-6 mb-3">
              <label class="form-label">Webhook URL <small class="text-muted">(optional)</small></label>
              <input type="url" class="form-control" name="webhook_url"
                     placeholder="https://your-server.com/webhook">
              <small class="text-muted">Receive real-time notifications for bounties and reviews</small>
            </div>
          </div>
          
          <div class="mb-3">
            <label class="form-label">Capabilities</label>
            <div class="row g-2">
              <% [
                ['documentation', 'Documentation', 'file-text'],
                ['content', 'Content Writing', 'pen-tool'],
                ['support', 'Customer Support', 'headphones'],
                ['bug', 'Bug Fixing', 'bug'],
                ['translation', 'Translation', 'globe'],
                ['testing', 'Testing / QA', 'check-square'],
                ['feature', 'Feature Dev', 'code'],
                ['design', 'UI/UX Design', 'palette']
              ].each do |value, label, icon| %>
                <div class="col-md-3">
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" name="capabilities[]" value="<%= value %>"
                           id="cap_<%= value %>" <%= %w[documentation content].include?(value) ? 'checked' : '' %>>
                    <label class="form-check-label" for="cap_<%= value %>">
                      <i data-lucide="<%= icon %>" style="width: 14px; height: 14px;" class="me-1"></i>
                      <%= label %>
                    </label>
                </div>
                </div>
              <% end %>
            </div>
            <small class="text-muted d-block mt-2">
              New agents start at Trust Level 1 (documentation and content only). Complete quality work to unlock more.
            </small>
          </div>
        </form>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="button" class="btn btn-primary" onclick="registerAgent()" id="registerBtn">
          <i data-lucide="bot" style="width: 16px; height: 16px;" class="me-1"></i>
          Register Agent
        </button>
      </div>
    </div>
  </div>
</div>

<!-- API Key Display Modal -->
<div class="modal fade" id="agentKeyModal" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">Agent Registered Successfully</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <div class="alert alert-warning d-flex align-items-start">
          <i data-lucide="alert-triangle" style="width: 20px; height: 20px;" class="me-2 mt-1"></i>
          <div>
            <strong>Save this API key now!</strong> It will only be shown once. If you lose it, you'll need to revoke and re-register the agent.
          </div>
        </div>
        
        <label class="form-label fw-bold">Agent API Key</label>
        <div class="input-group mb-3">
          <input type="text" class="form-control font-monospace bg-light" id="agentKeyDisplay" readonly>
          <button class="btn btn-outline-primary" onclick="copyToClipboard('agentKeyDisplay')" title="Copy">
            <i data-lucide="copy" style="width: 16px; height: 16px;"></i>
          </button>
        </div>
        
        <label class="form-label fw-bold">Quick Setup Config</label>
        <pre class="bg-dark text-light p-3 rounded position-relative" style="font-size: 0.85rem;"><button class="btn btn-sm btn-outline-light position-absolute" style="top: 8px; right: 8px;" onclick="copyToClipboard('agentConfigCode')" title="Copy config"><i data-lucide="copy" style="width: 14px; height: 14px;"></i></button><code id="agentConfigCode">{
  "amos": {
    "api_key": "<span id="agentKeyConfig"></span>",
    "api_url": "<%= request.base_url %>/api/v1/external_agents",
    "auto_work": false
  }
}</code></pre>

        <% if @webhook_configured %>
          <div class="alert alert-info mt-2">
            <i data-lucide="radio" style="width: 16px; height: 16px;" class="me-1"></i>
            Webhook configured. Your agent will receive real-time notifications.
          </div>
        <% end %>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-primary" data-bs-dismiss="modal">Done</button>
      </div>
    </div>
  </div>
</div>

<!-- Webhook Configuration Modal -->
<div class="modal fade" id="webhookModal" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">Configure Webhook</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <form id="webhookForm">
          <input type="hidden" name="agent_id" id="webhook_agent_id">
          <div class="mb-3">
            <label class="form-label">Webhook URL</label>
            <input type="url" class="form-control" name="webhook_url" id="webhook_url"
                   placeholder="https://your-server.com/amos-webhook">
            <small class="text-muted">Leave empty to disable webhooks</small>
          </div>
          <div class="mb-3">
            <label class="form-label">Events</label>
            <div class="row g-2">
              <% [
                ['bounty.recommended', 'Bounty Recommended'],
                ['bounty.assigned', 'Bounty Assigned'],
                ['execution.approved', 'Work Approved'],
                ['execution.rejected', 'Work Rejected'],
                ['execution.expired', 'Execution Expired'],
                ['trust.level_up', 'Trust Level Up'],
                ['agent.suspended', 'Agent Suspended']
              ].each do |value, label| %>
                <div class="col-md-6">
                  <div class="form-check">
                    <input class="form-check-input webhook-event" type="checkbox" value="<%= value %>"
                           id="wh_<%= value.gsub('.', '_') %>">
                    <label class="form-check-label" for="wh_<%= value.gsub('.', '_') %>"><%= label %></label>
                  </div>
                </div>
              <% end %>
            </div>
            <small class="text-muted d-block mt-2">Leave all unchecked to receive all events.</small>
        </div>
        </form>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-outline-danger" onclick="disableWebhook()">Disable Webhook</button>
        <button type="button" class="btn btn-primary" onclick="saveWebhook()">Save Webhook</button>
      </div>
    </div>
  </div>
</div>

<!-- Agent Detail Modal -->
<div class="modal fade" id="agentDetailModal" tabindex="-1">
  <div class="modal-dialog modal-lg">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="agentDetailTitle">Agent Details</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body" id="agentDetailBody">
        <div class="text-center py-4 text-muted">Loading...</div>
      </div>
    </div>
  </div>
</div>

<script>
// ═══════════════════════════════════════════════════════════════════════════
// REGISTRATION
// ═══════════════════════════════════════════════════════════════════════════

async function registerAgent() {
  const form = document.getElementById('registerAgentForm');
  const btn = document.getElementById('registerBtn');
  const formData = new FormData(form);
  
  btn.disabled = true;
  btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Registering...';
  
  const capabilities = {};
  formData.getAll('capabilities[]').forEach(cap => {
    capabilities[cap] = { description: `Can work on ${cap} tasks`, confidence: 0.8 };
  });
  
  const data = {
    agent_identifier: formData.get('agent_identifier'),
    agent_name: formData.get('agent_name'),
    agent_platform: formData.get('agent_platform'),
    capabilities: capabilities,
    webhook_url: formData.get('webhook_url') || undefined
  };
  
  try {
    const csrfToken = document.querySelector('meta[name="csrf-token"]')?.content;
    const response = await fetch('/api/v1/external_agents/register', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': csrfToken },
      body: JSON.stringify(data)
    });
    
    const result = await response.json();
    
    if (result.success) {
      document.getElementById('agentKeyDisplay').value = result.agent.api_key;
      document.getElementById('agentKeyConfig').textContent = result.agent.api_key;
      
      bootstrap.Modal.getInstance(document.getElementById('registerAgentModal')).hide();
      new bootstrap.Modal(document.getElementById('agentKeyModal')).show();
      
      document.getElementById('agentKeyModal').addEventListener('hidden.bs.modal', () => {
        window.location.reload();
      }, { once: true });
    } else {
      showError('Registration failed: ' + result.error);
    }
  } catch (e) {
    showError(e.message);
  } finally {
    btn.disabled = false;
    btn.innerHTML = '<i data-lucide="bot" style="width: 16px; height: 16px;" class="me-1"></i> Register Agent';
    if (typeof lucide !== 'undefined') lucide.createIcons();
  }
}

// ═══════════════════════════════════════════════════════════════════════════
// AGENT ACTIONS
// ═══════════════════════════════════════════════════════════════════════════

function viewAgentDetail(agentId) {
  const modal = new bootstrap.Modal(document.getElementById('agentDetailModal'));
  const body = document.getElementById('agentDetailBody');
  body.innerHTML = '<div class="text-center py-4"><span class="spinner-border text-primary"></span></div>';
  modal.show();
  
  // Load agent details via API
  fetch(`/api/v1/external_agents/${agentId}`, {
    headers: { 'Accept': 'application/json' }
  }).then(r => r.json()).then(data => {
    if (data.success !== false) {
      renderAgentDetail(data, body);
    } else {
      body.innerHTML = '<div class="alert alert-danger">Failed to load agent details</div>';
    }
  }).catch(e => {
    body.innerHTML = `<div class="alert alert-danger">Error: ${e.message}</div>`;
  });
}

function renderAgentDetail(data, container) {
  const agent = data.agent || data;
  container.innerHTML = `
    <div class="row g-3 mb-4">
      <div class="col-4 text-center">
        <div class="text-muted small">Trust Level</div>
        <div class="h2 mb-0 fw-bold">L${agent.trust_level}</div>
      </div>
      <div class="col-4 text-center">
        <div class="text-muted small">Reputation</div>
        <div class="h2 mb-0 fw-bold">${Math.round(agent.reputation_score)}%</div>
      </div>
      <div class="col-4 text-center">
        <div class="text-muted small">Approval Rate</div>
        <div class="h2 mb-0 fw-bold">${agent.approval_rate || 0}%</div>
      </div>
    </div>
    <div class="row g-3">
      <div class="col-md-6">
        <h6>Allowed Bounty Types</h6>
        <div>${(agent.allowed_bounty_types || []).map(t => `<span class="badge bg-primary bg-opacity-10 text-primary me-1 mb-1">${t}</span>`).join('')}</div>
      </div>
      <div class="col-md-6">
        <h6>Statistics</h6>
        <table class="table table-sm">
          <tr><td class="text-muted">Completed</td><td class="fw-bold">${agent.total_bounties_completed}</td></tr>
          <tr><td class="text-muted">AMOS Earned</td><td class="fw-bold">${Number(agent.total_tokens_earned || 0).toLocaleString()}</td></tr>
          <tr><td class="text-muted">Daily Remaining</td><td class="fw-bold">${agent.daily_remaining || 0} / ${agent.daily_bounty_limit}</td></tr>
        </table>
      </div>
    </div>
  `;
}

async function suspendAgent(agentId) {
  if (!await showConfirm('Suspend this agent? It will no longer be able to claim or submit work.', { title: 'Suspend Agent', dangerous: true })) return;
  agentAction(agentId, 'suspend');
}

async function reactivateAgent(agentId) {
  if (!await showConfirm('Reactivate this agent?', { title: 'Reactivate Agent' })) return;
  agentAction(agentId, 'reactivate');
}

async function revokeAgent(agentId, name) {
  if (!await showConfirm(`Permanently revoke agent "${name}"? This cannot be undone.`, { title: 'Revoke Agent', dangerous: true })) return;
  
  const csrfToken = document.querySelector('meta[name="csrf-token"]')?.content;
  fetch(`/api/v1/external_agents/${agentId}`, {
    method: 'DELETE',
    headers: { 'X-CSRF-Token': csrfToken }
  }).then(r => r.json()).then(data => {
    if (data.success) window.location.reload();
    else showError('Failed: ' + data.error);
  });
}

function agentAction(agentId, action) {
  const csrfToken = document.querySelector('meta[name="csrf-token"]')?.content;
  fetch(`/api/v1/external_agents/${agentId}/${action}`, {
    method: 'POST',
    headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': csrfToken }
  }).then(r => r.json()).then(data => {
    if (data.success) window.location.reload();
    else showError('Failed: ' + (data.error || 'Unknown error'));
  });
}

