<script src="https://unpkg.com/lucide@latest"></script>
<link rel="stylesheet" href="/assets/admin_dark.css">

<div class="container-fluid py-4">
  <%# Page Header %>
  <div class="admin-page-header">
    <div class="header-left">
      <div class="header-icon" style="background: linear-gradient(135deg, #22C55E 0%, #4ADE80 100%);">
        <i data-lucide="activity"></i>
      </div>
      <div class="header-text">
        <h1>Observability & Analytics</h1>
        <p>Track your entity's AI usage, workflows, and performance</p>
      </div>
    </div>

    <div class="header-actions" style="display: flex; gap: 0.5rem;">
      <%= link_to entity_observability_path(timeframe: 'today'),
          class: "admin-btn admin-btn-sm #{@timeframe == 'today' ? 'admin-btn-primary' : 'admin-btn-outline'}" do %>
        <i data-lucide="calendar-days"></i>
        <span>Today</span>
      <% end %>
      <%= link_to entity_observability_path(timeframe: '7d'),
          class: "admin-btn admin-btn-sm #{@timeframe == '7d' ? 'admin-btn-primary' : 'admin-btn-outline'}" do %>
        <i data-lucide="calendar-range"></i>
        <span>7 Days</span>
      <% end %>
      <%= link_to entity_observability_path(timeframe: '30d'),
          class: "admin-btn admin-btn-sm #{@timeframe == '30d' ? 'admin-btn-primary' : 'admin-btn-outline'}" do %>
        <i data-lucide="calendar"></i>
        <span>30 Days</span>
      <% end %>
    </div>
  </div>

  <%# AI Usage Stats %>
  <div style="margin-bottom: 2rem;">
    <h3 style="color: white; font-size: 1.25rem; font-weight: 600; margin-bottom: 1rem; display: flex; align-items: center; gap: 0.5rem;">
      <i data-lucide="bot" style="width: 1.25rem; height: 1.25rem; color: #22D3EE;"></i>
      AI Usage
    </h3>
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1.5rem;">
      <%# Conversations - Purple Gradient %>
      <div class="admin-card">
        <div style="display: flex; align-items: center; gap: 1rem;">
          <div style="width: 3rem; height: 3rem; border-radius: 0.75rem; background: linear-gradient(135deg, #7C3AED 0%, #A78BFA 100%); display: flex; align-items: center; justify-content: center;">
            <i data-lucide="message-square" style="width: 1.5rem; height: 1.5rem; color: white;"></i>
          </div>
          <div>
            <p style="color: #94A3B8; font-size: 0.875rem; margin: 0;">Conversations</p>
            <h3 style="color: white; font-size: 1.875rem; font-weight: 600; margin: 0;"><%= @ai_stats[:conversations] %></h3>
          </div>
        </div>
      </div>

      <%# Messages - Cyan %>
      <div class="admin-card">
        <div style="display: flex; align-items: center; gap: 1rem;">
          <div style="width: 3rem; height: 3rem; border-radius: 0.75rem; background: rgba(34, 211, 238, 0.1); display: flex; align-items: center; justify-content: center; border: 1px solid rgba(34, 211, 238, 0.2);">
            <i data-lucide="messages-square" style="width: 1.5rem; height: 1.5rem; color: #22D3EE;"></i>
          </div>
          <div>
            <p style="color: #94A3B8; font-size: 0.875rem; margin: 0;">Messages</p>
            <h3 style="color: white; font-size: 1.875rem; font-weight: 600; margin: 0;"><%= @ai_stats[:messages] %></h3>
          </div>
        </div>
      </div>

      <%# Estimated Tokens - Yellow %>
      <div class="admin-card">
        <div style="display: flex; align-items: center; gap: 1rem;">
          <div style="width: 3rem; height: 3rem; border-radius: 0.75rem; background: rgba(234, 179, 8, 0.1); display: flex; align-items: center; justify-content: center; border: 1px solid rgba(234, 179, 8, 0.2);">
            <i data-lucide="zap" style="width: 1.5rem; height: 1.5rem; color: rgb(250, 204, 21);"></i>
          </div>
          <div>
            <p style="color: #94A3B8; font-size: 0.875rem; margin: 0;">Est. Tokens</p>
            <h3 style="color: white; font-size: 1.875rem; font-weight: 600; margin: 0;"><%= number_with_delimiter(@ai_stats[:estimated_tokens]) %></h3>
          </div>
        </div>
      </div>

      <%# Estimated Cost - Green %>
      <div class="admin-card">
        <div style="display: flex; align-items: center; gap: 1rem;">
          <div style="width: 3rem; height: 3rem; border-radius: 0.75rem; background: rgba(34, 197, 94, 0.1); display: flex; align-items: center; justify-content: center; border: 1px solid rgba(34, 197, 94, 0.2);">
            <i data-lucide="dollar-sign" style="width: 1.5rem; height: 1.5rem; color: rgb(74, 222, 128);"></i>
          </div>
          <div>
            <p style="color: #94A3B8; font-size: 0.875rem; margin: 0;">Est. Cost</p>
            <h3 style="color: white; font-size: 1.875rem; font-weight: 600; margin: 0;">$<%= @ai_stats[:estimated_cost] %></h3>
          </div>
        </div>
      </div>
    </div>
  </div>

  <%# Workflow Stats %>
  <div style="margin-bottom: 2rem;">
    <h3 style="color: white; font-size: 1.25rem; font-weight: 600; margin-bottom: 1rem; display: flex; align-items: center; gap: 0.5rem;">
      <i data-lucide="git-branch" style="width: 1.25rem; height: 1.25rem; color: #A78BFA;"></i>
      Workflows
    </h3>
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1.5rem;">
      <%# Started %>
      <div class="admin-card">
        <div style="display: flex; align-items: center; gap: 1rem;">
          <div style="width: 3rem; height: 3rem; border-radius: 0.75rem; background: rgba(148, 163, 184, 0.1); display: flex; align-items: center; justify-content: center; border: 1px solid rgba(148, 163, 184, 0.2);">
            <i data-lucide="play-circle" style="width: 1.5rem; height: 1.5rem; color: #94A3B8;"></i>
          </div>
          <div>
            <p style="color: #94A3B8; font-size: 0.875rem; margin: 0;">Started</p>
            <h3 style="color: white; font-size: 1.875rem; font-weight: 600; margin: 0;"><%= @ai_stats[:workflows_started] %></h3>
          </div>
        </div>
      </div>

      <%# Completed - Green %>
      <div class="admin-card">
        <div style="display: flex; align-items: center; gap: 1rem;">
          <div style="width: 3rem; height: 3rem; border-radius: 0.75rem; background: rgba(34, 197, 94, 0.1); display: flex; align-items: center; justify-content: center; border: 1px solid rgba(34, 197, 94, 0.2);">
            <i data-lucide="check-circle" style="width: 1.5rem; height: 1.5rem; color: rgb(74, 222, 128);"></i>
          </div>
          <div>
            <p style="color: #94A3B8; font-size: 0.875rem; margin: 0;">Completed</p>
            <h3 style="color: white; font-size: 1.875rem; font-weight: 600; margin: 0;"><%= @ai_stats[:workflows_completed] %></h3>
          </div>
        </div>
      </div>

      <%# Failed - Red %>
      <div class="admin-card">
        <div style="display: flex; align-items: center; gap: 1rem;">
          <div style="width: 3rem; height: 3rem; border-radius: 0.75rem; background: rgba(239, 68, 68, 0.1); display: flex; align-items: center; justify-content: center; border: 1px solid rgba(239, 68, 68, 0.2);">
            <i data-lucide="x-circle" style="width: 1.5rem; height: 1.5rem; color: rgb(248, 113, 113);"></i>
          </div>
          <div>
            <p style="color: #94A3B8; font-size: 0.875rem; margin: 0;">Failed</p>
            <h3 style="color: white; font-size: 1.875rem; font-weight: 600; margin: 0;"><%= @ai_stats[:workflows_failed] %></h3>
          </div>
        </div>
      </div>
    </div>
  </div>

  <%# Integration Stats %>
  <div style="margin-bottom: 2rem;">
    <h3 style="color: white; font-size: 1.25rem; font-weight: 600; margin-bottom: 1rem; display: flex; align-items: center; gap: 0.5rem;">
      <i data-lucide="plug" style="width: 1.25rem; height: 1.25rem; color: rgb(250, 204, 21);"></i>
      Integrations
    </h3>
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1.5rem;">
      <%# Active Connections %>
      <div class="admin-card">
        <div style="display: flex; align-items: center; gap: 1rem;">
          <div style="width: 3rem; height: 3rem; border-radius: 0.75rem; background: rgba(148, 163, 184, 0.1); display: flex; align-items: center; justify-content: center; border: 1px solid rgba(148, 163, 184, 0.2);">
            <i data-lucide="link" style="width: 1.5rem; height: 1.5rem; color: #94A3B8;"></i>
          </div>
          <div>
            <p style="color: #94A3B8; font-size: 0.875rem; margin: 0;">Active Connections</p>
            <h3 style="color: white; font-size: 1.875rem; font-weight: 600; margin: 0;"><%= @integration_stats[:active_connections] %></h3>
          </div>
        </div>
      </div>

      <%# API Calls - Green %>
      <div class="admin-card">
        <div style="display: flex; align-items: center; gap: 1rem;">
          <div style="width: 3rem; height: 3rem; border-radius: 0.75rem; background: rgba(34, 197, 94, 0.1); display: flex; align-items: center; justify-content: center; border: 1px solid rgba(34, 197, 94, 0.2);">
            <i data-lucide="arrow-right-left" style="width: 1.5rem; height: 1.5rem; color: rgb(74, 222, 128);"></i>
          </div>
          <div>
            <p style="color: #94A3B8; font-size: 0.875rem; margin: 0;">API Calls</p>
            <h3 style="color: white; font-size: 1.875rem; font-weight: 600; margin: 0;"><%= @integration_stats[:api_calls] %></h3>
          </div>
        </div>
      </div>

      <%# Failed Calls - Red %>
      <div class="admin-card">
        <div style="display: flex; align-items: center; gap: 1rem;">
          <div style="width: 3rem; height: 3rem; border-radius: 0.75rem; background: rgba(239, 68, 68, 0.1); display: flex; align-items: center; justify-content: center; border: 1px solid rgba(239, 68, 68, 0.2);">
            <i data-lucide="alert-octagon" style="width: 1.5rem; height: 1.5rem; color: rgb(248, 113, 113);"></i>
          </div>
          <div>
            <p style="color: #94A3B8; font-size: 0.875rem; margin: 0;">Failed Calls</p>
            <h3 style="color: white; font-size: 1.875rem; font-weight: 600; margin: 0;"><%= @integration_stats[:failed_calls] %></h3>
          </div>
        </div>
      </div>
    </div>
  </div>

  <%# Campaign Stats %>
  <div>
    <h3 style="color: white; font-size: 1.25rem; font-weight: 600; margin-bottom: 1rem; display: flex; align-items: center; gap: 0.5rem;">
      <i data-lucide="mail" style="width: 1.25rem; height: 1.25rem; color: #22D3EE;"></i>
      Campaigns
    </h3>
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1.5rem;">
      <%# Total %>
      <div class="admin-card">
        <div style="display: flex; align-items: center; gap: 1rem;">
          <div style="width: 3rem; height: 3rem; border-radius: 0.75rem; background: rgba(148, 163, 184, 0.1); display: flex; align-items: center; justify-content: center; border: 1px solid rgba(148, 163, 184, 0.2);">
            <i data-lucide="list" style="width: 1.5rem; height: 1.5rem; color: #94A3B8;"></i>
          </div>
          <div>
            <p style="color: #94A3B8; font-size: 0.875rem; margin: 0;">Total</p>
            <h3 style="color: white; font-size: 1.875rem; font-weight: 600; margin: 0;"><%= @campaign_stats[:total] %></h3>
          </div>
        </div>
      </div>

      <%# Sent - Green %>
      <div class="admin-card">
        <div style="display: flex; align-items: center; gap: 1rem;">
          <div style="width: 3rem; height: 3rem; border-radius: 0.75rem; background: rgba(34, 197, 94, 0.1); display: flex; align-items: center; justify-content: center; border: 1px solid rgba(34, 197, 94, 0.2);">
            <i data-lucide="send" style="width: 1.5rem; height: 1.5rem; color: rgb(74, 222, 128);"></i>
          </div>
          <div>
            <p style="color: #94A3B8; font-size: 0.875rem; margin: 0;">Sent</p>
            <h3 style="color: white; font-size: 1.875rem; font-weight: 600; margin: 0;"><%= @campaign_stats[:sent] %></h3>
          </div>
        </div>
      </div>

      <%# Drafts - Yellow %>
      <div class="admin-card">
        <div style="display: flex; align-items: center; gap: 1rem;">
          <div style="width: 3rem; height: 3rem; border-radius: 0.75rem; background: rgba(234, 179, 8, 0.1); display: flex; align-items: center; justify-content: center; border: 1px solid rgba(234, 179, 8, 0.2);">
            <i data-lucide="file-edit" style="width: 1.5rem; height: 1.5rem; color: rgb(250, 204, 21);"></i>
          </div>
          <div>
            <p style="color: #94A3B8; font-size: 0.875rem; margin: 0;">Drafts</p>
            <h3 style="color: white; font-size: 1.875rem; font-weight: 600; margin: 0;"><%= @campaign_stats[:draft] %></h3>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  document.addEventListener('turbo:load', () => {
    if (typeof lucide !== 'undefined') {
      lucide.createIcons();
    }
  });

  document.addEventListener('DOMContentLoaded', () => {
    if (typeof lucide !== 'undefined') {
      lucide.createIcons();
    }
  });
</script>
