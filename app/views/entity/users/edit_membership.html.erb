<div class="container-fluid py-4">
  <div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
      <%# Page Header %>
      <div class="admin-page-header mb-4">
        <div class="header-left">
          <div class="header-icon" style="background: linear-gradient(135deg, #8B5CF6 0%, #A78BFA 100%);">
            <i data-lucide="user-cog"></i>
          </div>
          <div class="header-text">
            <h1>Edit Team Member</h1>
            <p>Update <%= @entity_user.user.full_name %>'s role</p>
          </div>
        </div>
      </div>

      <div class="admin-card">
        <div class="card-body">
          <div class="d-flex align-items-center gap-3 mb-4 p-3 rounded" style="background: rgba(139, 92, 246, 0.1);">
            <div style="width: 48px; height: 48px; border-radius: 50%; background: linear-gradient(135deg, #8B5CF6 0%, #A78BFA 100%); display: flex; align-items: center; justify-content: center; color: white; font-weight: 600; font-size: 1.25rem;">
              <%= @entity_user.user.first_name[0].upcase %><%= @entity_user.user.last_name[0].upcase rescue '' %>
            </div>
            <div>
              <h5 class="mb-0"><%= @entity_user.user.full_name %></h5>
              <p class="mb-0" style="color: var(--text-secondary);"><%= @entity_user.user.email %></p>
            </div>
          </div>

          <%= form_with model: @entity_user, url: update_membership_entity_user_path(@entity_user), method: :patch, local: true do |f| %>
            <% if @entity_user.errors.any? %>
              <div class="alert alert-danger mb-4">
                <ul class="mb-0">
                  <% @entity_user.errors.full_messages.each do |message| %>
                    <li><%= message %></li>
                  <% end %>
                </ul>
              </div>
            <% end %>

            <div class="mb-4">
              <%= f.label :role, class: "form-label" %>
              <%= f.select :role, [
                ['Owner - Full control of the organization', 'owner'],
                ['Admin - Can manage team members and settings', 'admin'],
                ['Member - Can use the platform and access shared resources', 'member']
              ], {}, class: "form-select" %>
              <div class="form-text">
                <strong>Owner:</strong> Full control, can't be removed<br>
                <strong>Admin:</strong> Can manage team and settings<br>
                <strong>Member:</strong> Standard access
              </div>
            </div>

            <div class="d-flex gap-2">
              <%= f.submit "Update Role", class: "admin-btn admin-btn-primary" %>
              <%= link_to "Cancel", entity_users_path, class: "admin-btn admin-btn-outline" %>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  if (typeof lucide !== 'undefined') {
    lucide.createIcons();
  }
</script>
