<div class="container-fluid">
  <div class="row mb-4">
    <div class="col">
      <h1><i class="fas fa-user-friends text-primary"></i> Team Members</h1>
      <p class="text-muted">Manage users in your entity</p>
    </div>
  </div>

  <!-- Stats -->
  <div class="row mb-4">
    <div class="col-md-4">
      <div class="card border-0 shadow-sm">
        <div class="card-body text-center">
          <div class="h3 mb-0"><%= @stats[:total_users] %></div>
          <div class="text-muted small">Total Users</div>
        </div>
      </div>
    </div>
    <div class="col-md-4">
      <div class="card border-0 shadow-sm">
        <div class="card-body text-center">
          <div class="h3 mb-0 text-success"><%= @stats[:onboarded] %></div>
          <div class="text-muted small">Onboarded</div>
        </div>
      </div>
    </div>
    <div class="col-md-4">
      <div class="card border-0 shadow-sm">
        <div class="card-body text-center">
          <div class="h3 mb-0 text-info"><%= @stats[:active_this_week] %></div>
          <div class="text-muted small">Active This Week</div>
        </div>
      </div>
    </div>
  </div>

  <!-- Users Table -->
  <div class="row">
    <div class="col-12">
      <div class="card border-0 shadow-sm">
        <div class="card-header bg-white">
          <h5 class="mb-0">Team Members</h5>
        </div>
        <div class="card-body">
          <div class="table-responsive">
            <table class="table table-hover">
              <thead>
                <tr>
                  <th>Name</th>
                  <th>Email</th>
                  <th>Role</th>
                  <th>Onboarded</th>
                  <th>Last Sign In</th>
                  <th>Actions</th>
                </tr>
              </thead>
              <tbody>
                <% @users.each do |user| %>
                  <tr>
                    <td><%= user.full_name %></td>
                    <td><%= user.email %></td>
                    <td>
                      <span class="badge bg-<%= user.role == 'admin' ? 'danger' : 'secondary' %>">
                        <%= user.role.titleize %>
                      </span>
                    </td>
                    <td>
                      <% if user.onboarded? %>
                        <i class="fas fa-check text-success"></i>
                      <% else %>
                        <i class="fas fa-times text-muted"></i>
                      <% end %>
                    </td>
                    <td>
                      <%= user.current_sign_in_at ? time_ago_in_words(user.current_sign_in_at) + ' ago' : 'Never' %>
                    </td>
                    <td>
                      <%= link_to "View", entity_user_path(user), class: "btn btn-outline-primary btn-sm" %>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

