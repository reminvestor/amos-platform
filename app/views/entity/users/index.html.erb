
<div class="container-fluid py-4">
  <%# Page Header %>
  <div class="admin-page-header">
    <div class="header-left">
      <div class="header-icon">
        <i data-lucide="users"></i>
      </div>
      <div class="header-text">
        <h1>Team Members</h1>
        <p>Manage users in your entity</p>
      </div>
    </div>
  </div>

  <%# Stats Cards %>
  <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1.5rem; margin-bottom: 2rem;">
    <%# Total Users - Purple Gradient %>
    <div class="admin-card">
      <div style="display: flex; align-items: center; gap: 1rem;">
        <div style="width: 3rem; height: 3rem; border-radius: 0.75rem; background: linear-gradient(135deg, #7C3AED 0%, #A78BFA 100%); display: flex; align-items: center; justify-content: center;">
          <i data-lucide="users" class="icon-xl text-white"></i>
        </div>
        <div>
          <p style="color: #94A3B8; font-size: 0.875rem; margin: 0;">Total Users</p>
          <h3 style="color: white; font-size: 1.875rem; font-weight: 600; margin: 0;"><%= @stats[:total_users] %></h3>
        </div>
      </div>
    </div>

    <%# Onboarded - Green %>
    <div class="admin-card">
      <div style="display: flex; align-items: center; gap: 1rem;">
        <div style="width: 3rem; height: 3rem; border-radius: 0.75rem; background: rgba(34, 197, 94, 0.1); display: flex; align-items: center; justify-content: center; border: 1px solid rgba(34, 197, 94, 0.2);">
          <i data-lucide="user-check" class="icon-xl text-success"></i>
        </div>
        <div>
          <p style="color: #94A3B8; font-size: 0.875rem; margin: 0;">Onboarded</p>
          <h3 style="color: white; font-size: 1.875rem; font-weight: 600; margin: 0;"><%= @stats[:onboarded] %></h3>
        </div>
      </div>
    </div>

    <%# Active This Week - Cyan %>
    <div class="admin-card">
      <div style="display: flex; align-items: center; gap: 1rem;">
        <div style="width: 3rem; height: 3rem; border-radius: 0.75rem; background: rgba(34, 211, 238, 0.1); display: flex; align-items: center; justify-content: center; border: 1px solid rgba(34, 211, 238, 0.2);">
          <i data-lucide="activity" class="icon-xl text-info"></i>
        </div>
        <div>
          <p style="color: #94A3B8; font-size: 0.875rem; margin: 0;">Active This Week</p>
          <h3 style="color: white; font-size: 1.875rem; font-weight: 600; margin: 0;"><%= @stats[:active_this_week] %></h3>
        </div>
      </div>
    </div>
  </div>

  <%# Users Table %>
  <div class="admin-card">
    <h3 class="card-title">
      <i data-lucide="list" class="icon-lg icon-with-spacing"></i>
      Team Members
    </h3>

    <div style="overflow-x: auto;">
      <table class="admin-table">
        <thead>
          <tr>
            <th>Name</th>
            <th>Email</th>
            <th>Role</th>
            <th>Onboarded</th>
            <th>Last Sign In</th>
            <th style="text-align: right;">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% @users.each do |user| %>
            <tr>
              <td style="color: white; font-weight: 600;"><%= user.full_name %></td>
              <td style="color: #94A3B8;"><%= user.email %></td>
              <td>
                <% if user.role == 'admin' || user.role == 'super_admin' %>
                  <span class="admin-badge admin-badge-offline" style="background: rgba(239, 68, 68, 0.1); border-color: rgba(239, 68, 68, 0.2); color: rgb(248, 113, 113);">
                    <%= user.role.titleize %>
                  </span>
                <% else %>
                  <span class="admin-badge admin-badge-default">
                    <%= user.role.titleize %>
                  </span>
                <% end %>
              </td>
              <td>
                <% if user.onboarded? %>
                  <span style="color: rgb(74, 222, 128); display: inline-flex; align-items: center; gap: 0.25rem;">
                    <i data-lucide="check-circle" class="icon-md"></i>
                    <span>Yes</span>
                  </span>
                <% else %>
                  <span style="color: #64748B; display: inline-flex; align-items: center; gap: 0.25rem;">
                    <i data-lucide="x-circle" class="icon-md"></i>
                    <span>No</span>
                  </span>
                <% end %>
              </td>
              <td style="color: #64748B; font-size: 0.875rem;">
                <% if user.current_sign_in_at %>
                  <span style="display: inline-flex; align-items: center; gap: 0.25rem;">
                    <i data-lucide="clock" class="icon-sm"></i>
                    <%= time_ago_in_words(user.current_sign_in_at) %> ago
                  </span>
                <% else %>
                  <span style="color: #64748B;">Never</span>
                <% end %>
              </td>
              <td style="text-align: right;">
                <%= link_to entity_user_path(user), class: "admin-btn admin-btn-sm admin-btn-outline" do %>
                  <i data-lucide="eye"></i>
                  <span>View</span>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<script>
  document.addEventListener('turbo:load', () => {
    if (typeof lucide !== 'undefined') {
      lucide.createIcons();
    }
  });

  document.addEventListener('DOMContentLoaded', () => {
    if (typeof lucide !== 'undefined') {
      lucide.createIcons();
    }
  });
</script>
