<div class="container-fluid">
  <div class="row mb-4">
    <div class="col">
      <h1><i class="fas fa-user"></i> <%= @user.full_name %></h1>
      <p class="text-muted"><%= @user.email %></p>
    </div>
    <div class="col-auto">
      <%= link_to entity_users_path, class: "btn btn-outline-secondary" do %>
        <i data-lucide="arrow-left" class="me-1"></i> Back to Team
      <% end %>
    </div>
  </div>

  <div class="row">
    <div class="col-lg-8">
      <div class="card border-0 shadow-sm">
        <div class="card-header bg-white">
          <h5 class="mb-0">User Information</h5>
        </div>
        <div class="card-body">
          <dl class="row mb-0">
            <dt class="col-sm-3">Name</dt>
            <dd class="col-sm-9"><%= @user.full_name %></dd>
            
            <dt class="col-sm-3">Email</dt>
            <dd class="col-sm-9"><%= @user.email %></dd>
            
            <dt class="col-sm-3">Role</dt>
            <dd class="col-sm-9">
              <span class="badge bg-<%= @user.role == 'admin' ? 'danger' : 'secondary' %>">
                <%= @user.role.titleize %>
              </span>
            </dd>
            
            <dt class="col-sm-3">Onboarded</dt>
            <dd class="col-sm-9">
              <% if @user.onboarded? %>
                <i data-lucide="check" class="text-success"></i> Yes
              <% else %>
                <i class="fas fa-times text-danger"></i> No
              <% end %>
            </dd>
            
            <dt class="col-sm-3">Member Since</dt>
            <dd class="col-sm-9"><%= @user.created_at.strftime("%B %d, %Y") %></dd>
            
            <dt class="col-sm-3">Last Sign In</dt>
            <dd class="col-sm-9">
              <%= @user.current_sign_in_at ? @user.current_sign_in_at.strftime("%B %d, %Y at %I:%M %p") : 'Never' %>
            </dd>
          </dl>
        </div>
      </div>
    </div>

    <div class="col-lg-4">
      <div class="card border-0 shadow-sm">
        <div class="card-header bg-white">
          <h5 class="mb-0"><i class="fas fa-tools"></i> Actions</h5>
        </div>
        <div class="card-body d-grid gap-2">
          <%= link_to edit_entity_user_path(@user), class: "btn btn-outline-primary" do %>
            <i class="fas fa-edit me-2"></i> Edit Details
          <% end %>
          
          <% if @user != current_user %>
            <%= button_to change_role_entity_user_path(@user, role: 'admin'), 
                method: :post,
                class: "btn btn-outline-warning" do %>
              <i class="fas fa-user-shield me-2"></i> Make Admin
            <% end %>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>

