<script src="https://unpkg.com/lucide@latest"></script>

<div class="container-fluid py-4">
  <%# Page Header %>
  <div class="admin-page-header">
    <div class="header-left">
      <div class="header-icon" style="background: linear-gradient(135deg, #ef4444 0%, #f87171 100%);">
        <i data-lucide="shield-alert"></i>
      </div>
      <div class="header-text">
        <h1>AI Usage Policies</h1>
        <p>Control how AI agents can access and use your data</p>
      </div>
    </div>

    <div class="header-actions">
      <%= link_to new_entity_policy_path, class: "admin-btn admin-btn-primary" do %>
        <i data-lucide="plus"></i>
        <span>New Policy</span>
      <% end %>
    </div>
  </div>

  <%# Stats Cards %>
  <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1.5rem; margin-bottom: 2rem;">
    <%# Total Policies %>
    <div class="admin-card">
      <div style="display: flex; align-items: center; gap: 1rem;">
        <div style="width: 3rem; height: 3rem; border-radius: 0.75rem; background: rgba(239, 68, 68, 0.1); display: flex; align-items: center; justify-content: center;">
          <i data-lucide="file-text" class="icon-xl text-danger"></i>
        </div>
        <div>
          <p style="color: #94A3B8; font-size: 0.875rem; margin: 0;">Total Policies</p>
          <h3 style="color: white; font-size: 1.875rem; font-weight: 600; margin: 0;"><%= @stats[:total] %></h3>
        </div>
      </div>
    </div>

    <%# Active Policies %>
    <div class="admin-card">
      <div style="display: flex; align-items: center; gap: 1rem;">
        <div style="width: 3rem; height: 3rem; border-radius: 0.75rem; background: rgba(34, 197, 94, 0.1); display: flex; align-items: center; justify-content: center;">
          <i data-lucide="check-circle" class="icon-xl text-success"></i>
        </div>
        <div>
          <p style="color: #94A3B8; font-size: 0.875rem; margin: 0;">Active</p>
          <h3 style="color: rgb(74, 222, 128); font-size: 1.875rem; font-weight: 600; margin: 0;"><%= @stats[:active] %></h3>
        </div>
      </div>
    </div>

    <%# With Budgets %>
    <div class="admin-card">
      <div style="display: flex; align-items: center; gap: 1rem;">
        <div style="width: 3rem; height: 3rem; border-radius: 0.75rem; background: rgba(34, 211, 238, 0.1); display: flex; align-items: center; justify-content: center;">
          <i data-lucide="dollar-sign" class="icon-xl text-info"></i>
        </div>
        <div>
          <p style="color: #94A3B8; font-size: 0.875rem; margin: 0;">With Budgets</p>
          <h3 style="color: #22D3EE; font-size: 1.875rem; font-weight: 600; margin: 0;"><%= @stats[:with_budgets] %></h3>
        </div>
      </div>
    </div>
  </div>

  <%# Policies Table %>
  <div class="admin-card">
    <div style="padding: 1.5rem 1.5rem 1rem 1.5rem; border-bottom: 1px solid #1E293B;">
      <h5 style="color: white; font-size: 1.125rem; font-weight: 600; margin: 0;">Your Policies</h5>
    </div>

    <% if @policies.any? %>
      <div style="overflow-x: auto;">
        <table class="admin-table">
          <thead>
            <tr>
              <th>Name</th>
              <th>Type</th>
              <th>Action</th>
              <th>Status</th>
              <th>Budgets</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            <% @policies.each do |policy| %>
              <tr>
                <td>
                  <div>
                    <strong style="color: white;"><%= policy.name %></strong>
                    <% if policy.agent_role %>
                      <div style="color: #64748B; font-size: 0.875rem; margin-top: 0.25rem;">
                        For: <%= policy.agent_role %> agents
                      </div>
                    <% end %>
                  </div>
                </td>
                <td>
                  <span class="admin-badge admin-badge-secondary">
                    <%= policy.resource_type %>
                  </span>
                </td>
                <td>
                  <span class="admin-badge admin-badge-info">
                    <%= policy.action.titleize %>
                  </span>
                </td>
                <td>
                  <% if policy.is_active %>
                    <span class="admin-badge admin-badge-success">
                      <i data-lucide="check-circle" class="icon-sm"></i>
                      <span>Active</span>
                    </span>
                  <% else %>
                    <span class="admin-badge admin-badge-secondary">
                      <i data-lucide="circle" class="icon-sm"></i>
                      <span>Inactive</span>
                    </span>
                  <% end %>
                </td>
                <td>
                  <% if policy.max_daily_calls || policy.max_write_calls %>
                    <div style="color: #94A3B8; font-size: 0.875rem;">
                      <%= "#{policy.max_daily_calls}/day" if policy.max_daily_calls %>
                      <%= "#{policy.max_write_calls} writes" if policy.max_write_calls %>
                    </div>
                  <% else %>
                    <span style="color: #64748B;">None</span>
                  <% end %>
                </td>
                <td>
                  <div style="display: flex; gap: 0.5rem;">
                    <%= link_to entity_policy_path(policy), class: "admin-btn admin-btn-sm admin-btn-outline" do %>
                      <i data-lucide="eye"></i>
                      <span>View</span>
                    <% end %>
                    <%= button_to toggle_entity_policy_path(policy), method: :post, class: "admin-btn admin-btn-sm admin-btn-outline", style: "border-color: #{policy.is_active ? 'rgb(234, 179, 8)' : 'rgb(74, 222, 128)'}; color: #{policy.is_active ? 'rgb(234, 179, 8)' : 'rgb(74, 222, 128)'};" do %>
                      <i data-lucide="<%= policy.is_active ? 'pause-circle' : 'play-circle' %>"></i>
                      <span><%= policy.is_active ? 'Disable' : 'Enable' %></span>
                    <% end %>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <%# Empty State %>
      <div class="admin-empty-state">
        <div class="empty-icon">
          <i data-lucide="shield-alert"></i>
        </div>
        <h3>No Policies Defined</h3>
        <p>Create policies to control how AI agents can access your data</p>
        <%= link_to new_entity_policy_path, class: "admin-btn admin-btn-primary", style: "margin-top: 1rem;" do %>
          <i data-lucide="plus"></i>
          <span>Create Your First Policy</span>
        <% end %>
      </div>
    <% end %>
  </div>
</div>

<script>
  document.addEventListener('turbo:load', () => {
    if (typeof lucide !== 'undefined') {
      lucide.createIcons();
    }
  });

  document.addEventListener('DOMContentLoaded', () => {
    if (typeof lucide !== 'undefined') {
      lucide.createIcons();
    }
  });
</script>
