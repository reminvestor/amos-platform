<div class="container-fluid">
  <div class="row mb-4">
    <div class="col">
      <h1><i class="fas fa-user-shield text-success"></i> Privacy & Data Controls</h1>
      <p class="text-muted">Control what data gets shared with AI and how it's used</p>
    </div>
  </div>

  <%= form_with(url: entity_privacy_path, method: :patch, local: true) do |f| %>
    <div class="row">
      <div class="col-lg-6">
        <!-- Data Sharing Settings -->
        <div class="card border-0 shadow-sm mb-3">
          <div class="card-header bg-white">
            <h5 class="mb-0"><i class="fas fa-share-alt"></i> Data Sharing with AI</h5>
          </div>
          <div class="card-body">
            <div class="form-check mb-3">
              <%= f.check_box 'privacy[share_business_profile]', checked: @privacy_settings['share_business_profile'], class: "form-check-input" %>
              <%= f.label 'privacy[share_business_profile]', "Share Business Profile", class: "form-check-label" %>
              <div class="form-text">Allow AI to access business name, industry, description</div>
            </div>
            
            <div class="form-check mb-3">
              <%= f.check_box 'privacy[share_contact_data]', checked: @privacy_settings['share_contact_data'], class: "form-check-input" %>
              <%= f.label 'privacy[share_contact_data]', "Share Contact Data", class: "form-check-label" %>
              <div class="form-text">Allow AI to access contact names, emails, etc.</div>
            </div>
            
            <div class="form-check mb-3">
              <%= f.check_box 'privacy[share_campaign_metrics]', checked: @privacy_settings['share_campaign_metrics'], class: "form-check-input" %>
              <%= f.label 'privacy[share_campaign_metrics]', "Share Campaign Metrics", class: "form-check-label" %>
              <div class="form-text">Allow AI to analyze campaign performance data</div>
            </div>
            
            <div class="form-check mb-3">
              <%= f.check_box 'privacy[share_file_contents]', checked: @privacy_settings['share_file_contents'], class: "form-check-input" %>
              <%= f.label 'privacy[share_file_contents]', "Share Uploaded File Contents", class: "form-check-label" %>
              <div class="form-text">Allow AI to read uploaded documents and images</div>
            </div>
          </div>
        </div>
      </div>

      <div class="col-lg-6">
        <!-- PII Masking -->
        <div class="card border-0 shadow-sm mb-3">
          <div class="card-header bg-white">
            <h5 class="mb-0"><i class="fas fa-eye-slash"></i> PII Masking</h5>
          </div>
          <div class="card-body">
            <div class="form-check mb-3">
              <%= f.check_box 'privacy[mask_pii]', checked: @privacy_settings['mask_pii'], class: "form-check-input" %>
              <%= f.label 'privacy[mask_pii]', "Auto-mask Personally Identifiable Information", class: "form-check-label" %>
              <div class="form-text">Automatically detect and mask PII before sending to AI</div>
            </div>
            
            <div class="form-check mb-3">
              <%= f.check_box 'privacy[mask_emails]', checked: @privacy_settings['mask_emails'], class: "form-check-input" %>
              <%= f.label 'privacy[mask_emails]', "Mask Email Addresses", class: "form-check-label" %>
            </div>
            
            <div class="form-check mb-3">
              <%= f.check_box 'privacy[mask_phone_numbers]', checked: @privacy_settings['mask_phone_numbers'], class: "form-check-input" %>
              <%= f.label 'privacy[mask_phone_numbers]', "Mask Phone Numbers", class: "form-check-label" %>
            </div>
            
            <div class="form-check mb-3">
              <%= f.check_box 'privacy[mask_addresses]', checked: @privacy_settings['mask_addresses'], class: "form-check-input" %>
              <%= f.label 'privacy[mask_addresses]', "Mask Physical Addresses", class: "form-check-label" %>
            </div>
          </div>
        </div>

        <!-- Data Retention -->
        <div class="card border-0 shadow-sm">
          <div class="card-header bg-white">
            <h5 class="mb-0"><i class="fas fa-clock"></i> Data Retention</h5>
          </div>
          <div class="card-body">
            <div class="mb-3">
              <%= f.label 'privacy[data_retention_days]', "Retain AI conversation data for:", class: "form-label" %>
              <%= f.select 'privacy[data_retention_days]',
                  options_for_select([[' 30 days', 30], ['60 days', 60], ['90 days', 90], ['180 days', 180], ['1 year', 365]], @privacy_settings['data_retention_days']),
                  {}, class: "form-select" %>
            </div>
            
            <div class="form-check">
              <%= f.check_box 'privacy[allow_data_export]', checked: @privacy_settings['allow_data_export'], class: "form-check-input" %>
              <%= f.label 'privacy[allow_data_export]', "Allow Data Export", class: "form-check-label" %>
              <div class="form-text">Users can download their AI conversation history</div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="row mt-3">
      <div class="col-12">
        <div class="d-flex gap-2">
          <%= f.submit "Save Privacy Settings", class: "btn btn-primary btn-lg" %>
          <div class="alert alert-info mb-0 flex-grow-1">
            <i class="fas fa-info-circle me-2"></i>
            These settings control what data is shared with AI models. Changes take effect immediately.
          </div>
        </div>
      </div>
    </div>
  <% end %>
</div>

