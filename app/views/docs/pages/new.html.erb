<% content_for :title, "New Page - AMOS Docs" %>

<div class="docs-content mx-auto" style="max-width: 900px;">
  <nav aria-label="breadcrumb" class="mb-4">
    <ol class="breadcrumb">
      <li class="breadcrumb-item"><%= link_to "Docs", docs_root_path %></li>
      <li class="breadcrumb-item active">New Page</li>
    </ol>
  </nav>
  
  <div class="docs-article">
    <h1 class="mb-4"><i class="bi bi-plus-circle me-2"></i>Create New Documentation Page</h1>
    
    <%= form_with model: @page, url: docs_pages_path, method: :post, local: true do |f| %>
      <div class="mb-4">
        <label class="form-label">Title</label>
        <%= f.text_field :title, class: "form-control form-control-lg", 
            placeholder: "e.g., Getting Started with AMOS",
            value: params[:title] %>
      </div>
      
      <div class="row mb-4">
        <div class="col-md-6">
          <label class="form-label">Slug (URL)</label>
          <%= f.text_field :slug, class: "form-control", 
              placeholder: "getting-started-with-amos" %>
          <div class="form-text">Leave blank to auto-generate from title</div>
        </div>
        <div class="col-md-6">
          <label class="form-label">Category</label>
          <%= f.collection_select :category_id, @categories, :id, :name, 
              { include_blank: "-- Uncategorized --" }, 
              { class: "form-select" } %>
        </div>
      </div>
      
      <div class="mb-4">
        <label class="form-label">Summary</label>
        <%= f.text_area :summary, class: "form-control", rows: 2,
            placeholder: "Brief description of what this page covers..." %>
      </div>
      
      <div class="mb-4">
        <label class="form-label">Content (Markdown)</label>
        <%= f.text_area :content, class: "form-control font-monospace", rows: 20,
            placeholder: "# Introduction\n\nWrite your documentation here using Markdown..." %>
        <div class="form-text">
          Supports Markdown: **bold**, *italic*, `code`, 
          <a href="https://www.markdownguide.org/basic-syntax/" target="_blank">full syntax guide</a>
        </div>
      </div>
      
      <div class="mb-4">
        <label class="form-label">Edit Summary</label>
        <%= text_field_tag :edit_summary, nil, class: "form-control",
            placeholder: "Briefly describe your changes (optional)" %>
      </div>
      
      <div class="form-check mb-4">
        <%= f.check_box :featured, class: "form-check-input" %>
        <label class="form-check-label">Feature on homepage</label>
      </div>
      
      <div class="d-flex justify-content-between">
        <%= link_to "Cancel", docs_root_path, class: "btn btn-outline-secondary" %>
        <button type="submit" class="btn btn-primary btn-lg">
          <i class="bi bi-check-circle me-2"></i>Create Page
        </button>
      </div>
    <% end %>
  </div>
</div>
