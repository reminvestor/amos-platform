<div class="container">
  <div class="row mb-4">
    <div class="col">
      <h1>Create New Entity</h1>
      <p class="text-muted">Set up a new entity to organize your content</p>
    </div>
    <div class="col-auto">
      <%= link_to 'Back to Entities', entities_path, class: 'btn btn-outline-secondary' %>
    </div>
  </div>

  <div class="row">
    <div class="col-md-8">
      <div class="card">
        <div class="card-body">
          <%= form_with(model: @entity, local: true) do |form| %>
            <% if @entity.errors.any? %>
              <div class="alert alert-danger">
                <h2><%= pluralize(@entity.errors.count, "error") %> prevented this entity from being saved:</h2>
                <ul>
                  <% @entity.errors.full_messages.each do |message| %>
                    <li><%= message %></li>
                  <% end %>
                </ul>
              </div>
            <% end %>

            <div class="mb-3">
              <%= form.label :name, class: 'form-label' %>
              <%= form.text_field :name, class: 'form-control', placeholder: 'Entity name' %>
              <div class="form-text">The display name for your entity</div>
            </div>

            <div class="mb-3">
              <%= form.label :subdomain, class: 'form-label' %>
              <%= form.text_field :subdomain, class: 'form-control', placeholder: 'subdomain' %>
              <div class="form-text">Used for accessing your entity (letters, numbers, and hyphens only)</div>
            </div>

            <div class="mb-3">
              <%= form.label :status, class: 'form-label' %>
              <%= form.select :status, 
                  options_for_select([['Active', 'active'], ['Inactive', 'inactive']]), 
                  {}, { class: 'form-select' } %>
            </div>

            <h4 class="mt-4 mb-3">Entity Settings</h4>

            <div class="mb-3">
              <%= form.label :timezone, class: 'form-label' %>
              <%= form.time_zone_select :timezone, 
                  ActiveSupport::TimeZone.all.sort, 
                  { default: Time.zone.name }, 
                  { class: 'form-select' } %>
            </div>

            <div class="mb-3">
              <%= form.label :primary_color, class: 'form-label' %>
              <%= form.color_field :primary_color, class: 'form-control form-control-color' %>
              <div class="form-text">Brand color for the entity</div>
            </div>

            <div class="d-grid gap-2 d-md-flex justify-content-md-end mt-4">
              <%= form.submit 'Create Entity', class: 'btn btn-primary' %>
            </div>
          <% end %>
        </div>
      </div>
    </div>
    <div class="col-md-4">
      <div class="card">
        <div class="card-body">
          <h5 class="card-title">About Entities</h5>
          <p class="card-text">
            Entities allow you to organize your marketing efforts into separate workspaces. 
            Each entity can have its own:
          </p>
          <ul>
            <li>Contacts and groups</li>
            <li>Email templates</li>
            <li>Campaigns</li>
            <li>Social media content</li>
            <li>Business profiles</li>
          </ul>
          <p class="card-text">
            You can invite team members to collaborate on specific entities.
          </p>
        </div>
      </div>
    </div>
  </div>
</div>
