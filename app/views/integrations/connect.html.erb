<% content_for :title, "Connect to #{@integration.name}" %>

<div class="container mt-4">
  <div class="row justify-content-center">
    <div class="col-lg-6">
      <div class="card">
        <div class="card-header bg-primary text-white">
          <div class="d-flex align-items-center">
            <% if @integration.icon_url.present? %>
              <img src="<%= @integration.icon_url %>" 
                   alt="<%= @integration.name %>" 
                   class="rounded me-2" class="icon-2x">
            <% else %>
              <i data-lucide="puzzle" class="me-2"></i>
            <% end %>
            <h5 class="mb-0">Connect to <%= @integration.name %></h5>
          </div>
        </div>
        
        <div class="card-body">
          <% if @integration.description.present? %>
            <p class="text-muted mb-4"><%= @integration.description %></p>
          <% end %>
          
          <%= form_with url: create_connection_integration_path(@integration.slug), method: :post, local: true, class: "needs-validation", novalidate: true do |form| %>
            
            <div class="mb-3">
              <label for="connection_name" class="form-label">Connection Name</label>
              <input type="text" 
                     class="form-control" 
                     id="connection_name" 
                     name="connection_name"
                     value="<%= @integration.name %> - <%= current_user.email %>"
                     required>
              <div class="form-text">A friendly name to identify this connection</div>
            </div>
            
            <% if @oauth_config && @oauth_config.auth_configs.any? %>
              <%# Database-configured dynamic auth fields %>
              <% @oauth_config.auth_configs.order(:position).each do |auth_config| %>
                <% 
                  # Extract placeholder names from auth_value like {api_key}, {token}, etc.
                  placeholders = auth_config.auth_value.scan(/\{(\w+)\}/).flatten
                  # Use first placeholder as field name, or fall back to auth_key
                  field_name = placeholders.first || auth_config.auth_key
                %>
                <div class="mb-3">
                  <label for="<%= field_name %>" class="form-label">
                    <%= field_name.gsub('_', ' ').titleize %>
                  </label>
                  <input type="password" 
                         class="form-control" 
                         id="<%= field_name %>" 
                         name="<%= field_name %>"
                         placeholder="Enter your <%= field_name.gsub('_', ' ').downcase %>"
                         required>
                  <div class="form-text">
                    <% if auth_config.auth_value.present? && auth_config.auth_value != "{#{field_name}}" %>
                      Will be sent as: <code><%= auth_config.auth_key %>: <%= auth_config.auth_value.gsub(/\{(\w+)\}/, '[your value]') %></code>
                      via <%= auth_config.auth_placement.humanize %>
                    <% else %>
                      Sent as <%= auth_config.auth_key %> via <%= auth_config.auth_placement.humanize %>
                    <% end %>
                  </div>
                </div>
              <% end %>
            <% else %>
              <%# No auth config found - needs admin setup %>
              <div class="alert alert-warning">
                <i data-lucide="alert-triangle"></i>
                <strong>Authentication not configured</strong><br>
                This integration hasn't been set up yet. Please contact an administrator to configure the authentication settings for <%= @integration.name %>.
              </div>
            <% end %>
            
            <div class="d-grid gap-2 d-md-flex justify-content-md-end">
              <a href="<%= integrations_path %>" class="btn btn-secondary me-md-2">Cancel</a>
              <button type="submit" class="btn btn-primary">
                <i data-lucide="link"></i> Connect to <%= @integration.name %>
              </button>
            </div>
            
          <% end %>
        </div>
      </div>
      
      <!-- Help Section -->
      <div class="card mt-3">
        <div class="card-body">
          <h6 class="card-title">
            <i data-lucide="help-circle" class="text-info"></i> Need Help?
          </h6>
          <p class="card-text small text-muted">
            Having trouble connecting? Check the 
            <% if @integration.documentation_url.present? %>
              <a href="<%= @integration.documentation_url %>" target="_blank"><%= @integration.name %> documentation</a>
            <% else %>
              <%= @integration.name %> documentation
            <% end %>
            for setup instructions, or contact our support team.
          </p>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
// Bootstrap form validation
(function() {
  'use strict';
  window.addEventListener('load', function() {
    var forms = document.getElementsByClassName('needs-validation');
    var validation = Array.prototype.filter.call(forms, function(form) {
      form.addEventListener('submit', function(event) {
        if (form.checkValidity() === false) {
          event.preventDefault();
          event.stopPropagation();
        }
        form.classList.add('was-validated');
      }, false);
    });
  }, false);
})();
</script>
