{
  "name": "app",
  "private": true,
  "devDependencies": {
    "@fullhuman/postcss-purgecss": "^7.0.2",
    "@playwright/test": "^1.58.2",
    "esbuild": "^0.25.1"
  },
  "scripts": {
    "build": "esbuild app/javascript/*.* --bundle --sourcemap --format=esm --outdir=app/assets/builds --public-path=/assets --minify",
    "build:css:compile": "sass ./app/assets/stylesheets/application.bootstrap.scss:./app/assets/builds/application.css --style=compressed --no-source-map --load-path=node_modules --quiet-deps",
    "build:css:prefix": "npx postcss ./app/assets/builds/application.css --output=./app/assets/builds/application.css",
    "build:css": "yarn build:css:compile && yarn build:css:prefix",
    "watch:css": "nodemon --watch ./app/assets/stylesheets/ --ext scss --exec \"yarn build:css\"",
    "e2e": "npx playwright test --config=e2e/playwright.config.js",
    "e2e:ui": "npx playwright test --config=e2e/playwright.config.js --ui",
    "e2e:headed": "npx playwright test --config=e2e/playwright.config.js --headed",
    "e2e:report": "npx playwright show-report e2e/playwright-report"
  },
  "dependencies": {
    "@aws-sdk/client-polly": "^3.709.0",
    "@deepgram/sdk": "^4.11.2",
    "@hotwired/stimulus": "^3.2.2",
    "@hotwired/turbo-rails": "^8.0.13",
    "@metaplex-foundation/js": "^0.20.1",
    "@metaplex-foundation/mpl-token-metadata": "^3.4.0",
    "@metaplex-foundation/umi": "^1.4.1",
    "@metaplex-foundation/umi-bundle-defaults": "^1.4.1",
    "@modelcontextprotocol/sdk": "^1.25.2",
    "@modelcontextprotocol/server-filesystem": "^0.6.2",
    "@modelcontextprotocol/server-github": "^0.6.2",
    "@popperjs/core": "^2.11.8",
    "@rails/actioncable": "^8.0.0",
    "@rails/actiontext": "^8.0.200",
    "@solana/spl-token": "^0.4.14",
    "@solana/web3.js": "^1.98.4",
    "autoprefixer": "^10.4.21",
    "bootstrap": "^5.3.3",
    "bootstrap-icons": "^1.11.3",
    "chart.js": "^4.5.1",
    "dompurify": "^3.2.3",
    "markdown-it": "^14.1.0",
    "nodemon": "^3.1.9",
    "postcss": "^8.5.3",
    "postcss-cli": "^11.0.0",
    "qrcode": "^1.5.4",
    "sass": "^1.85.1",
    "trix": "^2.1.13"
  },
  "browserslist": [
    "defaults"
  ]
}
