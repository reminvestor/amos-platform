# Podman Configuration (macOS)
# Set the container socket path for LocalStack.
# Find yours with: podman machine inspect --format '{{.ConnectionInfo.PodmanSocket.Path}}'
# CONTAINER_SOCK=/Users/you/.local/share/containers/podman/machine/podman.sock

# AWS Bedrock Configuration (REQUIRED)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_access_key_id
AWS_SECRET_ACCESS_KEY=your_secret_access_key

# AWS Bedrock Model Configuration
# Available models:
#   - claude-sonnet-4-5     (Latest, most capable - recommended for complex tasks)
#   - claude-opus-4-1       (Most powerful, expensive - for critical tasks)
#   - claude-3-5-sonnet     (Previous generation Sonnet - good balance)
#   - claude-3-haiku        (Fastest, cheapest - good for simple tasks)
BEDROCK_DEFAULT_MODEL=claude-sonnet-4-5
BEDROCK_VOICE_MODEL=claude-3-haiku
BEDROCK_CHAT_MODEL=claude-sonnet-4-5

# Prompt Caching: Enable 49% token cost savings by caching static prompt components
# When enabled: Uses regional endpoints (us.anthropic.*) with Sonnet 3.5 v2
# When disabled: Uses global endpoints (global.anthropic.*) with Sonnet 4.5
# Trade-off: Latest model (4.5) vs Cost savings (49% reduction)
# NOTE: Currently disabled due to AWS API limitations - will re-enable when supported
BEDROCK_PROMPT_CACHING_ENABLED=false

# AWS SES Configuration (Optional - for email sending)
AWS_SES_SENDER=your_verified_email@example.com

# AWS S3 Configuration (Required for RAG document storage)
RAG_BUCKET=agent-marketing-rag-storage
# S3 bucket structure: s3://your-rag-bucket/entities/{entity_id}/raw_documents/...
# Optional: Set S3 endpoint for testing with LocalStack
AWS_S3_ENDPOINT=http://localhost:4566

# OCR Configuration (Dual-Mode: Textract + Docling)
# OCR_PROVIDER options: textract, docling, auto (auto selects based on document type/size)
OCR_PROVIDER=auto
OCR_FALLBACK_ENABLED=true
# Use Docling for documents smaller than this size (in MB) to save costs
OCR_DOCLING_MAX_SIZE_MB=5
# Use Textract for better accuracy on these document types
OCR_TEXTRACT_PREFERRED_TYPES=invoice,receipt,form,id
# Enable parallel processing for comparison/testing
OCR_SHADOW_MODE=false

# AWS Textract Configuration (Required if OCR_PROVIDER includes textract)
TEXTRACT_ENABLED=true
TEXTRACT_SNS_TOPIC_ARN=
TEXTRACT_ROLE_ARN=

# AWS Comprehend Configuration (Optional - for NLP enhancement)
COMPREHEND_ENABLED=false
COMPREHEND_DETECT_PII=false
COMPREHEND_CLASSIFIER_ARN=
COMPREHEND_ROLE_ARN=

# AWS Bedrock Knowledge Base Configuration (Optional - for managed RAG)
BEDROCK_KB_ENABLED=false
BEDROCK_KB_ID=
BEDROCK_KB_ROLE_ARN=
OPENSEARCH_COLLECTION_ARN=
OPENSEARCH_ENDPOINT=

# Document Processing Pipeline Configuration
DOCUMENT_PROCESSING_MODE=async
DOCUMENT_WORKFLOW_ARN=
# For production, comment out AWS_S3_ENDPOINT to use real S3

# Docling Configuration (Optional - auto-detected if installed)
# No configuration needed - Docling is automatically used if Python dependencies are installed
# To verify: rails docling:check
# To disable: Set use_docling: false when initializing DocumentProcessorService

# RAG Configuration
# Chunking strategy: 'semantic' (Ottomator-style) or 'simple' (current paragraph-based)
RAG_CHUNKING_STRATEGY=semantic
# Chunk size (tokens for semantic, characters for simple)
RAG_CHUNK_SIZE=1000
# Chunk overlap (characters) - only for semantic strategy
RAG_CHUNK_OVERLAP=200
# Embedding cache enabled (requires Redis)
RAG_EMBEDDING_CACHE_ENABLED=true
# Embedding batch size (1-100, higher = faster but more memory)
RAG_EMBEDDING_BATCH_SIZE=100

# OpenAI Configuration (Required for RAG)
OPENAI_API_KEY=sk-your-key-here
OPENAI_EMBEDDING_MODEL=text-embedding-ada-002

# Google Gemini Configuration (Optional - for Nano Banana image generation)
# Get your API key from: https://aistudio.google.com/apikey
# Models available:
#   - gemini-2.5-flash-image (Nano Banana) - Fast, ~$0.039/image
#   - gemini-3-pro-image-preview (Nano Banana Pro) - High-fidelity, best text rendering
GEMINI_API_KEY=your-gemini-api-key-here
# Default image model: nano_banana or nano_banana_pro
GEMINI_IMAGE_MODEL=nano_banana

# ============================================================
# Gmail OAuth Configuration (for user email integration)
# ============================================================
# Setup instructions:
# 1. Go to https://console.cloud.google.com/
# 2. Create a project (or select existing)
# 3. Enable Gmail API: APIs & Services → Library → Gmail API → Enable
# 4. Create OAuth credentials: APIs & Services → Credentials → Create → OAuth client ID
# 5. Add redirect URI: http://localhost:3000/oauth/callback (or your production URL)
# 6. Copy Client ID and Client Secret below
#
# Once configured, users can connect Gmail with one click in the mobile app.
# The Gmail API is FREE - Google provides generous quotas at no cost.
GMAIL_CLIENT_ID=your-client-id.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=your-client-secret

# Microsoft Outlook OAuth (Optional - for Outlook/365 email integration)
# Setup: https://portal.azure.com/ → App registrations → New registration
# OUTLOOK_CLIENT_ID=your-azure-app-client-id
# OUTLOOK_CLIENT_SECRET=your-azure-app-client-secret

# Pinecone Configuration (OPTIONAL - only needed for massive scale)
#
# Vector Storage Strategy:
#   - PRIMARY: pgvector (PostgreSQL) - Used for local and AWS deployments
#   - OPTIONAL: Pinecone - Add later for extreme scale (millions of vectors)
#
# pgvector handles production workloads up to ~10M vectors efficiently
# AWS RDS PostgreSQL with pgvector extension provides excellent performance
#
# When to add Pinecone:
#   - You have >10 million document chunks across all entities
#   - You need sub-10ms query latency at extreme scale
#   - Your RDS database is hitting storage/performance limits
#
# Leave these commented out unless you need Pinecone:
# PINECONE_API_KEY=pcsk-your-key-here
# PINECONE_ENVIRONMENT=us-east-1-aws

# SolidQueue Configuration for RAG Processing (Rails 8 job processor)
# Queue priorities (configured in config/queue.yml):
#   - critical: 6 (real-time user operations, 5 threads)
#   - embeddings: 4 (API rate-limited, 3 threads)
#   - docling: 3 (memory-intensive, 2 threads)
#   - documents: 2 (general processing, 3 threads)
#   - default: 1 (everything else, 3 threads)
#   - maintenance: 0 (cleanup tasks, 1 thread)

# Number of worker processes per queue (multiply by threads for total concurrency)
JOB_CONCURRENCY=1
# Critical workers (real-time user operations)
CRITICAL_WORKERS=1
# Embedding workers (rate-limited for Bedrock API: 100 requests/60s)
EMBEDDING_WORKERS=1
# Docling workers (memory-intensive: limit to 3 concurrent jobs max)
DOCLING_WORKERS=1
# Document processing workers
DOCUMENT_WORKERS=1

# RAG Archival Configuration (Phase 4 Monitoring)
# Whether archiving removes vectors from Pinecone (saves costs but data not recoverable)
ARCHIVE_REMOVES_PINECONE=false

# Eleven Labs Configuration (for real-time transcription)
ELEVEN_LABS_API_KEY=your_elevenlabs_api_key_here

# Optional: Model and Language settings (defaults shown)
ELEVEN_LABS_MODEL=scribe-v3-realtime  # Model to use (scribe-v3-realtime, scribe-v2-realtime)
ELEVEN_LABS_LANGUAGE=en               # Default language code (en, es, fr, de, etc.)

# Optional: Audio format settings (defaults shown - recommended for most use cases)
ELEVEN_LABS_ENCODING=pcm_16000        # Audio encoding (pcm_8000, pcm_16000, pcm_22050, pcm_24000, pcm_44100, pcm_48000, ulaw_8000)
ELEVEN_LABS_SAMPLE_RATE=16000         # Sample rate in Hz (8000, 16000, 22050, 24000, 44100, 48000)
ELEVEN_LABS_CHANNELS=1                # Audio channels (1 for mono - only mono is supported)

# Optional: Transcription features (defaults shown)
ELEVEN_LABS_PUNCTUATE=true            # Enable automatic punctuation (true/false)
ELEVEN_LABS_PARTIAL_RESULTS=true     # Show interim transcripts (true/false)

# Optional: Advanced features (disabled by default)
ELEVEN_LABS_SPEAKER_DIARIZATION=false # Enable speaker identification (true/false)
ELEVEN_LABS_SENTIMENT_ANALYSIS=false  # Enable sentiment detection (true/false)

# Optional: Performance tuning (defaults shown)
ELEVEN_LABS_LATENCY_OPTIMIZED=true    # Optimize for low latency ~100ms (true/false)

# Optional: Timeout settings (defaults shown)
ELEVEN_LABS_MAX_DURATION=300          # Maximum session duration in seconds (5 minutes)
ELEVEN_LABS_SILENCE_TIMEOUT=20        # Auto-stop after N seconds of silence (20 seconds)

# Slack Notifications (for voice error alerts)
SLACK_MCP_ENABLED=false               # Set to true when Slack MCP is configured
SLACK_WEBHOOK_URL=                    # Fallback webhook if MCP not available
SLACK_ALERTS_CHANNEL=#voice-errors    # Slack channel for alerts
APP_URL=http://localhost:3000         # Base URL for dashboard links in Slack

# Active Record Encryption Keys (add to production environment)
ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=
ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=
ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=

# ============================================================
# ============================================================
# OpenRouter Configuration (for AI Council Deep Research)
# ============================================================
# Get API key from: https://openrouter.ai/keys
# Used by council_research tool to query multiple AI models (GPT-4.1, Claude, Gemini, etc.)
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Agent Lightning - RL-Based Agent Optimization
# ============================================================
# Python service URL
# Docker: http://agent_lightning:4747
# Local: http://localhost:4747
AGENT_LIGHTNING_SERVICE_URL=http://agent_lightning:4747
# Enable Agent Lightning training (set to 'true' to enable RL-based optimization)
AGENT_LIGHTNING_ENABLED=true
