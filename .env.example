# AWS Bedrock Configuration (REQUIRED)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_access_key_id
AWS_SECRET_ACCESS_KEY=your_secret_access_key

# AWS Bedrock Model Configuration
# Available models:
#   - claude-sonnet-4-5     (Latest, most capable - recommended for complex tasks)
#   - claude-opus-4-1       (Most powerful, expensive - for critical tasks)
#   - claude-3-5-sonnet     (Previous generation Sonnet - good balance)
#   - claude-3-haiku        (Fastest, cheapest - good for simple tasks)
BEDROCK_DEFAULT_MODEL=claude-sonnet-4-5
BEDROCK_VOICE_MODEL=claude-3-haiku
BEDROCK_CHAT_MODEL=claude-sonnet-4-5

# AWS SES Configuration (Optional - for email sending)
AWS_SES_SENDER=your_verified_email@example.com

# Docling Configuration (Optional - auto-detected if installed)
# No configuration needed - Docling is automatically used if Python dependencies are installed
# To verify: rails docling:check
# To disable: Set use_docling: false when initializing DocumentProcessorService

# RAG Configuration
# Chunking strategy: 'semantic' (Ottomator-style) or 'simple' (current paragraph-based)
RAG_CHUNKING_STRATEGY=semantic
# Chunk size (tokens for semantic, characters for simple)
RAG_CHUNK_SIZE=1000
# Chunk overlap (characters) - only for semantic strategy
RAG_CHUNK_OVERLAP=200
# Embedding cache enabled (requires Redis)
RAG_EMBEDDING_CACHE_ENABLED=true
# Embedding batch size (1-100, higher = faster but more memory)
RAG_EMBEDDING_BATCH_SIZE=100

# OpenAI Configuration (Required for RAG)
OPENAI_API_KEY=sk-your-key-here
OPENAI_EMBEDDING_MODEL=text-embedding-ada-002

# Pinecone Configuration (Required for RAG)
# Get your API key from https://app.pinecone.io
# Modern API keys start with 'pcsk_' or 'pc-'
PINECONE_API_KEY=pcsk-your-key-here
# Region for serverless indexes (aws: us-east-1, us-west-2, eu-west-1)
PINECONE_REGION=us-east-1 