# AMOS Mobile Environment Configuration
# Copy this file to .env and fill in your values
# Note: For Flutter, use --dart-define flags instead of .env files

# ===== API CONFIGURATION =====
# Production API URL (must be HTTPS for production builds)
API_BASE_URL=https://api.amoslabs.com

# Environment: development, staging, production
ENVIRONMENT=production

# ===== OPTIONAL OVERRIDES =====
# Privacy policy URL
PRIVACY_POLICY_URL=https://amoslabs.com/privacy

# Terms of service URL
TERMS_OF_SERVICE_URL=https://amoslabs.com/terms

# Support email
SUPPORT_EMAIL=support@amoslabs.com

# ===== DEBUG OPTIONS =====
# Enable debug logging (default: false in production)
DEBUG_MODE=false

# Enable analytics (default: true in production)
ANALYTICS_ENABLED=true

# ===== BUILD COMMANDS =====
#
# Development (with local API):
#   flutter run --dart-define=ENVIRONMENT=development --dart-define=API_BASE_URL=http://192.168.x.x:3000
#
# Staging:
#   flutter run --dart-define=ENVIRONMENT=staging --dart-define=API_BASE_URL=https://staging-api.amoslabs.com
#
# Production iOS:
#   flutter build ios --release --dart-define=ENVIRONMENT=production --dart-define=API_BASE_URL=https://api.amoslabs.com
#
# Production Android:
#   flutter build appbundle --release --dart-define=ENVIRONMENT=production --dart-define=API_BASE_URL=https://api.amoslabs.com
#
# Or use Fastlane (recommended):
#   cd ios && fastlane deploy_testflight
#   cd android && fastlane deploy_internal
