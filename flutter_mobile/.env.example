# API Configuration
API_BASE_URL=https://your-api-url.com

# iOS App Store Connect
ASC_KEY_ID=your_key_id
ASC_ISSUER_ID=your_issuer_id
ASC_KEY_CONTENT=base64_encoded_key_content
APPLE_ID=your_apple_id@email.com
APPLE_APP_ID=your_apple_app_id
TEAM_ID=your_team_id
ITC_TEAM_ID=your_itc_team_id
APP_IDENTIFIER=com.amoslabs.mobile

# iOS Match (Certificate Management)
MATCH_GIT_URL=git@github.com:your-org/certificates.git
MATCH_PASSWORD=your_match_password

# Android Google Play
ANDROID_PACKAGE_NAME=com.amoslabs.mobile
GOOGLE_PLAY_JSON_KEY_PATH=/path/to/google-play-key.json

# Firebase (optional)
FIREBASE_APP_ID_IOS=your_ios_app_id
FIREBASE_APP_ID_ANDROID=your_android_app_id
