# Customise this file, documentation can be found here:
# https://docs.fastlane.tools/actions
# All available actions: https://docs.fastlane.tools/actions

default_platform(:android)

platform :android do
  desc "Build Android app bundle"
  lane :build_android do
    # Build the Flutter app
    Dir.chdir("..") do
      sh("flutter build appbundle --release")
    end
  end

  desc "Build Android APK"
  lane :build_apk do
    # Build the Flutter APK
    Dir.chdir("..") do
      sh("flutter build apk --release")
    end
  end

  desc "Deploy to Google Play Internal Testing"
  lane :deploy_internal do
    build_android

    upload_to_play_store(
      track: "internal",
      aab: "../build/app/outputs/bundle/release/app-release.aab",
      json_key: ENV["GOOGLE_PLAY_JSON_KEY_PATH"],
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true
    )
  end

  desc "Deploy to Google Play Alpha"
  lane :deploy_alpha do
    build_android

    upload_to_play_store(
      track: "alpha",
      aab: "../build/app/outputs/bundle/release/app-release.aab",
      json_key: ENV["GOOGLE_PLAY_JSON_KEY_PATH"],
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true
    )
  end

  desc "Deploy to Google Play Beta"
  lane :deploy_beta do
    build_android

    upload_to_play_store(
      track: "beta",
      aab: "../build/app/outputs/bundle/release/app-release.aab",
      json_key: ENV["GOOGLE_PLAY_JSON_KEY_PATH"],
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true
    )
  end

  desc "Deploy to Google Play Production"
  lane :deploy_production do
    build_android

    upload_to_play_store(
      track: "production",
      aab: "../build/app/outputs/bundle/release/app-release.aab",
      json_key: ENV["GOOGLE_PLAY_JSON_KEY_PATH"],
      skip_upload_metadata: false,
      skip_upload_images: false,
      skip_upload_screenshots: false
    )
  end

  desc "Promote Internal to Beta"
  lane :promote_internal_to_beta do
    upload_to_play_store(
      track: "internal",
      track_promote_to: "beta",
      json_key: ENV["GOOGLE_PLAY_JSON_KEY_PATH"],
      skip_upload_aab: true,
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true
    )
  end

  desc "Promote Beta to Production"
  lane :promote_beta_to_production do
    upload_to_play_store(
      track: "beta",
      track_promote_to: "production",
      json_key: ENV["GOOGLE_PLAY_JSON_KEY_PATH"],
      skip_upload_aab: true,
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      rollout: "0.1"  # Start with 10% rollout
    )
  end

  desc "Increment version code"
  lane :increment_version_code do
    path = "../app/build.gradle"
    re = /versionCode\s+(\d+)/

    s = File.read(path)
    versionCode = s[re, 1].to_i
    s[re, 1] = (versionCode + 1).to_s

    f = File.new(path, "w")
    f.write(s)
    f.close
  end

  # ============================================
  # FLUTTER SCREENSHOTS
  # ============================================

  desc "Take screenshots for Play Store using Flutter"
  lane :screenshots do
    # Devices for Play Store (phone + tablet)
    devices = [
      "Pixel 8 Pro",       # Phone
      "Pixel Tablet"       # Tablet (10")
    ]

    devices.each do |device|
      UI.message("Capturing screenshots on #{device}...")

      Dir.chdir("..") do
        sh("flutter drive " \
           "--driver=test_driver/integration_test.dart " \
           "--target=integration_test/screenshot_test.dart " \
           "-d '#{device}' " \
           "|| true")
      end
    end

    UI.success("Screenshots captured! Check flutter_mobile/screenshots/")
  end

  desc "Take screenshots on a single device"
  lane :screenshot_device do |options|
    device = options[:device] || "Pixel 8 Pro"

    Dir.chdir("..") do
      sh("flutter drive " \
         "--driver=test_driver/integration_test.dart " \
         "--target=integration_test/screenshot_test.dart " \
         "-d '#{device}'")
    end
  end

  desc "Take screenshots using native screengrab (requires UI tests)"
  lane :screenshots_native do
    capture_android_screenshots(
      locales: ["en-US"],
      clear_previous_screenshots: true,
      app_package_name: "com.amoslabs.mobile",
      use_adb_root: false
    )
  end

  desc "Upload screenshots to Play Store"
  lane :upload_screenshots do
    upload_to_play_store(
      track: "internal",
      skip_upload_aab: true,
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: false,
      screenshots_path: "./screenshots"
    )
  end

  desc "Validate bundle before upload"
  lane :validate_bundle do
    validate_play_store_json_key(
      json_key: ENV["GOOGLE_PLAY_JSON_KEY_PATH"]
    )
  end
end
