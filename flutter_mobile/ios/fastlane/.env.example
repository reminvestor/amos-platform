# ============================================
# App Store Connect API Key (Recommended for CI/CD)
# Generate at: https://appstoreconnect.apple.com/access/api
# ============================================
ASC_KEY_ID=XXXXXXXXXX
ASC_ISSUER_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
ASC_KEY_CONTENT=LS0tLS1CRUdJTi... # Base64 encoded .p8 key content

# ============================================
# Apple Developer Account
# ============================================
APPLE_ID=ryan@amoslabs.com
TEAM_ID=65M4R87855              # From developer.apple.com > Membership
ITC_TEAM_ID=65M4R87855          # From App Store Connect (usually same as TEAM_ID)

# ============================================
# App Configuration
# ============================================
APP_IDENTIFIER=com.amoslabs.mobile
APPLE_APP_ID=1234567890          # Numeric ID from App Store Connect > App Information

# ============================================
# Match (Code Signing)
# ============================================
MATCH_GIT_URL=https://github.com/NuvolaNetworks/amos-ios-certificates.git
MATCH_PASSWORD=your_match_encryption_password

# ============================================
# Production API (for Flutter build)
# ============================================
API_BASE_URL=https://api.amoslabs.com

# ============================================
# Screenshots (optional)
# ============================================
SCREENSHOT_TOKEN=your_test_auth_token
# SCREENSHOT_MODE=true  # Set by Fastlane automatically

# ============================================
# Notifications (optional)
# ============================================
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...

# ============================================
# TestFlight (optional)
# ============================================
# TESTFLIGHT_CHANGELOG=Bug fixes and improvements
