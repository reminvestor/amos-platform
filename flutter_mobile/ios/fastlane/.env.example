# App Store Connect API Key
# Generate at: https://appstoreconnect.apple.com/access/api
ASC_KEY_ID=XXXXXXXXXX
ASC_ISSUER_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
ASC_KEY_CONTENT=LS0tLS1CRUdJTi... # Base64 encoded .p8 key content

# Apple Developer Account
APPLE_ID=your@email.com
TEAM_ID=XXXXXXXXXX           # From developer.apple.com > Membership
ITC_TEAM_ID=XXXXXXXXXX       # From App Store Connect (usually same as TEAM_ID)

# App Store Connect App ID (numeric)
# Created when you register the app, or find in App Store Connect > App Information
APPLE_APP_ID=1234567890

# Bundle Identifier
APP_IDENTIFIER=com.amoslabs.mobile
