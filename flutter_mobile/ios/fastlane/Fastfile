# iOS Fastlane Configuration for AMOS Mobile
# https://docs.fastlane.tools

default_platform(:ios)

platform :ios do
  # ============================================
  # SETUP & CERTIFICATES
  # ============================================

  desc "Sync certificates and profiles from git repo"
  lane :sync_certificates do
    match(type: "appstore", readonly: true)
  end

  desc "Generate new certificates (run once for new team members)"
  lane :certificates_new do
    match(type: "development")
    match(type: "appstore")
  end

  # ============================================
  # BUILD
  # ============================================

  desc "Install CocoaPods dependencies"
  lane :install_pods do
    cocoapods(
      clean_install: true,
      podfile: "Podfile"
    )
  end

  desc "Bump build number based on latest TestFlight build"
  lane :bump_build_number do
    app_identifier = CredentialsManager::AppfileConfig.try_fetch_value(:app_identifier)

    current_version = get_version_number(
      xcodeproj: "Runner.xcodeproj",
      target: "Runner"
    )

    latest_build_number = latest_testflight_build_number(
      version: current_version,
      app_identifier: app_identifier
    )

    increment_build_number(
      build_number: (latest_build_number + 1),
      xcodeproj: "Runner.xcodeproj"
    )
  end

  desc "Build iOS app for TestFlight"
  lane :build_ios do
    install_pods

    # Ensure we have certificates
    match(type: "appstore", readonly: true)

    # Update Xcode project to use manual signing with Match
    update_code_signing_settings(
      use_automatic_signing: false,
      path: "Runner.xcodeproj",
      team_id: ENV["TEAM_ID"] || "65M4R87855",
      profile_name: "match AppStore com.amoslabs.mobile",
      code_sign_identity: "Apple Distribution"
    )

    build_app(
      workspace: "Runner.xcworkspace",
      scheme: "Runner",
      export_method: "app-store",
      output_directory: "./build",
      output_name: "amos_mobile.ipa",
      clean: true,
      export_options: {
        provisioningProfiles: {
          "com.amoslabs.mobile" => "match AppStore com.amoslabs.mobile"
        }
      }
    )
  end

  # ============================================
  # BETA (TestFlight)
  # ============================================

  desc "Upload to TestFlight"
  lane :upload_testflight do
    changelog = ENV["TESTFLIGHT_CHANGELOG"] || "Bug fixes and improvements"

    upload_to_testflight(
      skip_waiting_for_build_processing: true,
      changelog: changelog,
      distribute_external: true,
      notify_external_testers: false
    )
  end

  desc "Deploy to TestFlight (full pipeline)"
  lane :deploy_testflight do
    bump_build_number
    build_ios
    upload_testflight
  end

  # ============================================
  # RELEASE (App Store)
  # ============================================

  desc "Deploy to App Store (production)"
  lane :deploy_production do
    bump_build_number
    build_ios

    upload_to_app_store(
      submit_for_review: false,
      automatic_release: false,
      skip_screenshots: true,
      skip_metadata: false,
      precheck_include_in_app_purchases: false
    )
  end

  # ============================================
  # UTILITIES
  # ============================================

  desc "Add new device and refresh provisioning profiles"
  lane :add_device do |options|
    device_name = options[:name] || prompt(text: "Enter device name: ")
    device_udid = options[:udid] || prompt(text: "Enter device UDID: ")

    register_devices(
      devices: {
        device_name => device_udid
      }
    )

    # Regenerate profiles
    match(
      type: "development",
      force_for_new_devices: true
    )
  end

  desc "Take screenshots for App Store (native Xcode UI tests)"
  lane :screenshots_native do
    capture_screenshots(
      workspace: "Runner.xcworkspace",
      scheme: "Runner"
    )
  end

  # ============================================
  # FLUTTER SCREENSHOTS
  # ============================================

  desc "Take screenshots using Flutter integration tests"
  lane :screenshots do
    # Devices for App Store (run sequentially for stability)
    devices = [
      "iPhone 16 Pro Max",    # 6.9" - Required
      "iPhone 16 Pro",        # 6.3" - Required
      "iPad Pro 13-inch (M4)" # Required for iPad
    ]

    # Build dart-define args for authenticated screenshots
    api_arg = ENV["API_BASE_URL"] ? "--dart-define=API_BASE_URL=#{ENV["API_BASE_URL"]} " : ""
    token_arg = ENV["SCREENSHOT_TOKEN"] ? "--dart-define=SCREENSHOT_TOKEN=#{ENV["SCREENSHOT_TOKEN"]} " : ""
    screenshot_mode = "--dart-define=SCREENSHOT_MODE=true "

    devices.each do |device|
      UI.message("Capturing screenshots on #{device}...")

      # Run Flutter screenshot tests on this device
      Dir.chdir("..") do
        sh("flutter drive " \
           "--driver=test_driver/integration_test.dart " \
           "--target=integration_test/screenshot_test.dart " \
           "-d '#{device}' " \
           "#{api_arg}" \
           "#{token_arg}" \
           "#{screenshot_mode}" \
           "|| true")  # Continue even if one device fails
      end
    end

    UI.success("Screenshots captured! Check flutter_mobile/screenshots/")
  end

  desc "Take screenshots on a single device"
  lane :screenshot_device do |options|
    device = options[:device] || "iPhone 16 Pro Max"
    api_arg = ENV["API_BASE_URL"] ? "--dart-define=API_BASE_URL=#{ENV["API_BASE_URL"]} " : ""
    token_arg = ENV["SCREENSHOT_TOKEN"] ? "--dart-define=SCREENSHOT_TOKEN=#{ENV["SCREENSHOT_TOKEN"]} " : ""
    screenshot_mode = "--dart-define=SCREENSHOT_MODE=true "

    Dir.chdir("..") do
      sh("flutter drive " \
         "--driver=test_driver/integration_test.dart " \
         "--target=integration_test/screenshot_test.dart " \
         "-d '#{device}' " \
         "#{api_arg}" \
         "#{token_arg}" \
         "#{screenshot_mode}")
    end
  end

  desc "Add device frames to screenshots"
  lane :frame_app_screenshots do
    frameit(
      path: "../screenshots",
      white: false,
      use_platform: "IOS"
    )
  end

  desc "Upload screenshots to App Store Connect"
  lane :upload_screenshots do
    deliver(
      skip_binary_upload: true,
      skip_metadata: true,
      skip_screenshots: false,
      screenshots_path: "../screenshots",
      overwrite_screenshots: true
    )
  end

  desc "Full screenshot pipeline: capture, frame, and upload"
  lane :screenshots_full do
    screenshots
    frame_app_screenshots
    upload_screenshots
  end

  desc "Create app on App Store Connect"
  lane :create_app do
    create_app_online(
      username: ENV["APPLE_ID"],
      app_identifier: CredentialsManager::AppfileConfig.try_fetch_value(:app_identifier),
      app_name: "AMOS Mobile",
      language: "English",
      app_version: "1.0.0",
      sku: "com.amoslabs.mobile"
    )
  end

  # ============================================
  # METADATA
  # ============================================

  desc "Upload only metadata (description, keywords, etc.) to App Store"
  lane :upload_metadata do
    deliver(
      skip_binary_upload: true,
      skip_screenshots: true,
      skip_metadata: false,
      force: true
    )
  end

  desc "Download current metadata from App Store Connect"
  lane :download_metadata do
    deliver(
      download_metadata: true,
      skip_binary_upload: true,
      skip_screenshots: true
    )
  end

  # ============================================
  # NOTIFICATIONS
  # ============================================

  desc "Send Slack notification"
  private_lane :notify_slack do |options|
    return unless ENV["SLACK_WEBHOOK_URL"]

    message = options[:message] || "Build completed"
    success = options[:success].nil? ? true : options[:success]

    slack(
      message: message,
      success: success,
      slack_url: ENV["SLACK_WEBHOOK_URL"],
      default_payloads: [:git_branch, :git_author],
      attachment_properties: {
        fields: [
          {
            title: "App",
            value: "AMOS Mobile",
            short: true
          },
          {
            title: "Version",
            value: get_version_number(xcodeproj: "Runner.xcodeproj", target: "Runner"),
            short: true
          },
          {
            title: "Build",
            value: get_build_number(xcodeproj: "Runner.xcodeproj"),
            short: true
          }
        ]
      }
    )
  end

  desc "Deploy to TestFlight with Slack notification"
  lane :deploy_testflight_notify do
    begin
      deploy_testflight
      notify_slack(message: "New TestFlight build uploaded successfully!")
    rescue => exception
      notify_slack(message: "TestFlight build failed: #{exception.message}", success: false)
      raise exception
    end
  end

  desc "Deploy to App Store with Slack notification"
  lane :deploy_production_notify do
    begin
      deploy_production
      notify_slack(message: "New App Store build uploaded successfully!")
    rescue => exception
      notify_slack(message: "App Store build failed: #{exception.message}", success: false)
      raise exception
    end
  end

  # ============================================
  # BETA BADGE
  # ============================================

  desc "Add BETA badge to app icon"
  lane :add_beta_badge do
    add_badge(
      shield: "BETA-#{get_version_number(xcodeproj: 'Runner.xcodeproj', target: 'Runner')}-orange",
      no_badge: true,
      shield_io_timeout: 10,
      glob: "/Runner/Assets.xcassets/AppIcon.appiconset/*.png"
    )
  end

  desc "Add version badge to app icon"
  lane :add_version_badge do
    version = get_version_number(xcodeproj: "Runner.xcodeproj", target: "Runner")
    build = get_build_number(xcodeproj: "Runner.xcodeproj")

    add_badge(
      shield: "#{version}-#{build}-blue",
      no_badge: true,
      shield_io_timeout: 10,
      glob: "/Runner/Assets.xcassets/AppIcon.appiconset/*.png"
    )
  end

  desc "Remove badges from app icon (restore originals)"
  lane :remove_badge do
    # Reset icons from git
    sh("cd .. && git checkout Runner/Assets.xcassets/AppIcon.appiconset/")
    UI.success("App icons restored to original state")
  end

  desc "Deploy beta with badge and notification"
  lane :deploy_beta_full do
    add_beta_badge
    begin
      deploy_testflight_notify
    ensure
      remove_badge  # Always restore icons after build
    end
  end
end
