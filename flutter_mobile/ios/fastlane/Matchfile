# Git repository for storing certificates
git_url(ENV["MATCH_GIT_URL"] || "https://github.com/NuvolaNetworks/amos-ios-certificates.git")

# Storage mode (git, google_cloud, s3)
storage_mode("git")

# App identifier(s)
app_identifier([ENV["APP_IDENTIFIER"] || "com.amoslabs.mobile"])

# Default type
type("appstore")

# For CI/CD, use readonly mode
readonly(ENV["CI"] == "true")

# Git branch
git_branch("main")

# Team ID
team_id(ENV["TEAM_ID"] || "65M4R87855")

# Apple ID
username(ENV["APPLE_ID"] || "ryan@amoslabs.com")
