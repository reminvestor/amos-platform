FROM ruby:3.4.1-slim

# Install dependencies including Python for Docling and Chromium for system tests
RUN apt-get update -qq && apt-get install -y \
    build-essential \
    libpq-dev \
    nodejs \
    npm \
    curl \
    git \
    python3 \
    python3-pip \
    python3-venv \
    libmagic1 \
    chromium \
    chromium-driver \
    libnss3 \
    libatk1.0-0 \
    libatk-bridge2.0-0 \
    libcups2 \
    libxkbcommon0 \
    libxdamage1 \
    libxrandr2 \
    libgbm1 \
    libpango-1.0-0 \
    libpangocairo-1.0-0 \
    && rm -rf /var/lib/apt/lists/*

# Install Yarn
RUN npm install -g yarn

# Set working directory
WORKDIR /rails

# Install bundler
RUN gem install bundler:2.6.3

# Copy dependency files
COPY Gemfile Gemfile.lock ./
RUN bundle install

# Copy package files
COPY package.json yarn.lock ./
RUN yarn install

# Install Python dependencies for Docling (optional)
COPY requirements.txt ./
RUN pip3 install --break-system-packages -r requirements.txt || echo "⚠️  Docling installation failed - RAG will use standard processing"

# Copy the rest of the application
COPY . .

# Expose port
EXPOSE 3000

# Default command
CMD ["bin/dev"]
