FROM ruby:3.4.1-slim

# Remove any pre-installed Node.js and install Node.js 20.x from NodeSource
RUN apt-get update -qq && apt-get remove -y nodejs npm || true \
    && apt-get install -y curl ca-certificates gnupg \
    && mkdir -p /etc/apt/keyrings \
    && curl -fsSL https://deb.nodesource.com/gpgkey/nodesource-repo.gpg.key | gpg --dearmor -o /etc/apt/keyrings/nodesource.gpg \
    && echo "deb [signed-by=/etc/apt/keyrings/nodesource.gpg] https://deb.nodesource.com/node_20.x nodistro main" | tee /etc/apt/sources.list.d/nodesource.list \
    && apt-get update -qq \
    && apt-get install -y nodejs \
    && node --version

# Install other dependencies including Python for Docling and Chromium for system tests
RUN apt-get install -y \
    build-essential \
    libpq-dev \
    git \
    python3 \
    python3-pip \
    python3-venv \
    libmagic1 \
    libvips \
    imagemagick \
    ghostscript \
    poppler-utils \
    chromium \
    chromium-driver \
    libnss3 \
    libatk1.0-0 \
    libatk-bridge2.0-0 \
    libcups2 \
    libxkbcommon0 \
    libxdamage1 \
    libxrandr2 \
    libgbm1 \
    libpango-1.0-0 \
    libpangocairo-1.0-0 \
    && rm -rf /var/lib/apt/lists/*

# Install Yarn using corepack (built into Node 20)
RUN corepack enable && corepack prepare yarn@stable --activate

# Set working directory
WORKDIR /rails

# Install bundler
RUN gem install bundler:2.6.3

# Copy dependency files
COPY Gemfile Gemfile.lock ./
RUN bundle install

# Copy package files
COPY package.json yarn.lock .yarnrc ./
RUN yarn install

# Install Python dependencies for Docling (optional)
COPY requirements.txt ./
RUN pip3 install --break-system-packages -r requirements.txt || echo "⚠️  Docling installation failed - RAG will use standard processing"

# Copy the rest of the application
COPY . .

# Expose port
EXPOSE 3000

# Default command
CMD ["bin/dev"]
