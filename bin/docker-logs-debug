#!/bin/bash

# Enhanced Docker Logs Viewer for Debugging
# Filters and highlights important messages

echo "🔍 Docker Debug Logs Viewer"
echo "================================"
echo "Highlighting: Scout, Amos, ActionCable, Errors, Warnings"
echo "Press Ctrl+C to exit"
echo ""

# Function to colorize output
colorize_logs() {
    # Use sed with extended regex for multiple patterns
    sed -E \
        -e 's/(ERROR|error|Error)/\x1b[31m\1\x1b[0m/g' \
        -e 's/(WARN|WARNING|warn|warning|Warning)/\x1b[33m\1\x1b[0m/g' \
        -e 's/(Scout|scout|SCOUT)/\x1b[36m\1\x1b[0m/g' \
        -e 's/(Amos|amos|AMOS)/\x1b[35m\1\x1b[0m/g' \
        -e 's/(ActionCable|WebSocket|Channel)/\x1b[32m\1\x1b[0m/g' \
        -e 's/(SolidQueue|Job|job)/\x1b[34m\1\x1b[0m/g' \
        -e 's/(Bedrock|bedrock|Claude|claude)/\x1b[95m\1\x1b[0m/g' \
        -e 's/(SUCCESS|success|Success|✅)/\x1b[92m\1\x1b[0m/g'
}

# Main log viewing with filtering
if [ "$1" == "chat" ]; then
    # Focus on chat-related logs
    echo "🗨️  Filtering for chat-related logs..."
    docker compose logs -f --tail=200 web worker | grep -E "(Scout|Amos|ActionCable|Channel|scout|chat|message|bedrock|claude)" | colorize_logs
elif [ "$1" == "errors" ]; then
    # Focus on errors only
    echo "❌ Filtering for errors..."
    docker compose logs -f --tail=200 | grep -E "(ERROR|error|Error|FAIL|fail|Fail|exception|Exception)" | colorize_logs
elif [ "$1" == "jobs" ]; then
    # Focus on job processing
    echo "⚡ Filtering for job processing..."
    docker compose logs -f --tail=200 worker | grep -E "(SolidQueue|Job|job|Perform|perform|enqueue)" | colorize_logs
else
    # Show all logs with colorization
    echo "📜 Showing all logs with highlighting..."
    docker compose logs -f --tail=100 | colorize_logs
fi
