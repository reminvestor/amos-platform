#!/bin/bash

# Unified Docker Logs Viewer
# Usage: bin/docker-logs [services...]
# Example: bin/docker-logs          # Shows all services
# Example: bin/docker-logs web worker  # Shows specific services

echo "🚀 Docker Unified Logs Viewer"
echo "================================"
echo "Press Ctrl+C to exit"
echo ""

# Color codes for different services
export DOCKER_COMPOSE_FLAGS="--no-color=false"

if [ $# -eq 0 ]; then
    # No arguments, show all services
    echo "Showing logs for all services..."
    docker compose logs -f --tail=100
else
    # Show specific services
    echo "Showing logs for: $@"
    docker compose logs -f --tail=100 "$@"
fi
