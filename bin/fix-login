#!/bin/bash
# Fix demo login after running tests
# Tests overwrite the demo user passwords, this resets them

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
source "$SCRIPT_DIR/detect-container-engine"

echo "Resetting demo user passwords..."
$COMPOSE_CMD exec web rails db:seed

echo ""
echo "Done! You can now login with any of these users:"
echo ""
echo "   All passwords: Password123!"
echo ""
echo "   admin@demo.com    - Full admin access"
echo "   marketer@demo.com - Marketing features"
echo "   viewer@demo.com   - Read-only access"
