#!/usr/bin/env bash
# Shannon Pentesting Environment Setup
# Usage: bin/shannon-setup
#
# This script sets up the Shannon AI pentester to test the AMOS platform.
# It handles cloning (if needed), repo symlinking, and credential checks.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
SHANNON_DIR="$PROJECT_ROOT/shannon"

echo "=== Shannon Pentesting Environment Setup ==="
echo ""

# Step 1: Clone Shannon if not present
if [ ! -d "$SHANNON_DIR" ]; then
  echo "[1/4] Cloning Shannon..."
  git clone https://github.com/KeygraphHQ/shannon.git "$SHANNON_DIR"
else
  echo "[1/4] Shannon already cloned at $SHANNON_DIR"
fi

# Step 2: Symlink amos-platform repo into Shannon's repos/ directory
echo "[2/4] Setting up repository link..."
mkdir -p "$SHANNON_DIR/repos"
if [ -L "$SHANNON_DIR/repos/amos-platform" ]; then
  echo "  Symlink already exists: shannon/repos/amos-platform -> $PROJECT_ROOT"
elif [ -d "$SHANNON_DIR/repos/amos-platform" ]; then
  echo "  WARNING: shannon/repos/amos-platform exists as a directory, skipping symlink"
else
  ln -s "$PROJECT_ROOT" "$SHANNON_DIR/repos/amos-platform"
  echo "  Created symlink: shannon/repos/amos-platform -> $PROJECT_ROOT"
fi

# Step 3: Check credentials
echo "[3/4] Checking credentials..."
CREDS_OK=true

if [ -f "$SHANNON_DIR/.env" ]; then
  if grep -q "your-api-key-here" "$SHANNON_DIR/.env" 2>/dev/null; then
    CREDS_OK=false
    echo "  WARNING: shannon/.env still has placeholder API key"
    echo "  Edit shannon/.env and set ANTHROPIC_API_KEY to your real key"
  else
    echo "  shannon/.env found with configured API key"
  fi
elif [ -n "${ANTHROPIC_API_KEY:-}" ]; then
  echo "  Using ANTHROPIC_API_KEY from environment"
else
  CREDS_OK=false
  echo "  WARNING: No credentials found"
  echo "  Either set ANTHROPIC_API_KEY env var or create shannon/.env"
  echo "  See shannon/.env.example for reference"
fi

# Step 4: Check Docker
echo "[4/4] Checking Docker..."
if command -v docker &>/dev/null; then
  if docker info &>/dev/null 2>&1; then
    echo "  Docker is running"
  else
    echo "  WARNING: Docker is installed but not running. Start Docker before running Shannon."
  fi
else
  echo "  WARNING: Docker is not installed. Shannon requires Docker."
  echo "  Install from: https://docs.docker.com/get-docker/"
fi

echo ""
echo "=== Setup Complete ==="
echo ""
echo "To run Shannon against the AMOS platform:"
echo ""
echo "  cd $SHANNON_DIR"
echo "  ./shannon start URL=http://host.docker.internal:3000 REPO=amos-platform"
echo ""
echo "To use a custom config (for authenticated testing):"
echo ""
echo "  ./shannon start URL=http://host.docker.internal:3000 REPO=amos-platform CONFIG=./configs/amos-platform.yaml"
echo ""
echo "To monitor progress:"
echo ""
echo "  ./shannon logs"
echo "  ./shannon query ID=<workflow-id>"
echo ""
if [ "$CREDS_OK" = false ]; then
  echo "NOTE: Fix credential warnings above before running."
fi
