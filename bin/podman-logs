#!/bin/bash

# Unified Container Logs Viewer
# Usage: bin/podman-logs [services...]
# Example: bin/podman-logs          # Shows all services
# Example: bin/podman-logs web worker  # Shows specific services

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
source "$SCRIPT_DIR/detect-container-engine"

echo "Container Logs Viewer ($CONTAINER_CMD)"
echo "================================"
echo "Press Ctrl+C to exit"
echo ""

if [ $# -eq 0 ]; then
    echo "Showing logs for all services..."
    $COMPOSE_CMD logs -f --tail=100
else
    echo "Showing logs for: $@"
    $COMPOSE_CMD logs -f --tail=100 "$@"
fi
