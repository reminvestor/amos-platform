#!/usr/bin/env ruby
require 'clockwork'
require_relative '../config/boot'
require_relative '../config/environment'

module Clockwork
  # Configure Clockwork
  configure do |config|
    config[:sleep_timeout] = 5      # seconds between checking for scheduled tasks
    config[:logger] = Logger.new(STDOUT)
    config[:tz] = 'UTC'             # Use UTC for consistency
  end

  # Run every hour
  every(1.hour, 'Sync active campaigns with Mailgun') do
    Rails.logger.info "Syncing active campaigns with Mailgun"
    SyncMailgunStatsJob.perform_later
  end

  # Run daily at midnight UTC
  every(1.day, 'Daily maintenance tasks', at: '00:00') do
    Rails.logger.info "Running daily maintenance tasks"
    # Add other daily tasks here
  end

  # Sync AWS costs daily at 6 AM UTC
  # (AWS Cost Explorer typically updates around 4-5 AM UTC)
  every(1.day, 'Sync AWS Costs from Cost Explorer', at: '06:00') do
    Rails.logger.info "Syncing AWS costs from Cost Explorer"
    SyncAwsCostsJob.perform_later
  end

  # Monthly reconciliation on the 2nd of each month
  # (Ensures previous month's data is fully available)
  every(1.month, 'Monthly AWS Cost Reconciliation', at: '07:00') do
    Rails.logger.info "Running monthly AWS cost reconciliation"
    prev_month = 1.month.ago
    SyncAwsCostsJob.perform_later(
      sync_monthly: true,
      year: prev_month.year,
      month: prev_month.month
    )
  end
end
