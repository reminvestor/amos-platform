#!/bin/bash
# Detect available container engine (Podman or Docker)
# Source this file in scripts: source bin/detect-container-engine
#
# Exports:
#   COMPOSE_CMD   - "podman compose" or "docker compose"
#   CONTAINER_CMD - "podman" or "docker"

if command -v podman &> /dev/null; then
    export COMPOSE_CMD="podman compose"
    export CONTAINER_CMD="podman"
elif command -v docker &> /dev/null; then
    export COMPOSE_CMD="docker compose"
    export CONTAINER_CMD="docker"
else
    echo "ERROR: Neither Podman nor Docker found. Install one first."
    echo "  brew install podman    # Recommended"
    echo "  brew install --cask docker"
    exit 1
fi
